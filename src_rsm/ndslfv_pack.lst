 External subroutine subprogram "fixend_cell_plm_intp"
  (inc)(line-no.)(nest)(optimize)
            1068                     !
            1069                     ! -------------------------------------------------------------------------
            1070                           subroutine fixend_cell_plm_intp(pp,qq,pn,qn,lons,nv)
            1071                     !
            1072                     ! linear quick version of the same two end points cell interpolation
            1073                     ! so pp(1) = pn(1) and pp(lonp+1) = pn(lonn+1)
            1074                     !
            1075                     ! pp    location at interfac point as input
            1076                     ! qq    quantity at averaged-cell as input
            1077                     ! pn    location at interface of new grid structure as input
            1078                     ! qn    quantity at averaged-cell as output
            1079                     ! lons  numer of cells for dimension
            1080                     !
            1081                     ! author : henry.juang@noaa.gov
            1082                     !
            1083                     !      use gfs_dyn_layout1
            1084                     !
            1085                           use index, only : col_rank
            1086                           use const, only : RTYPE
            1087                     
            1088                           implicit none
            1089                     !
            1090                           real(kind=RTYPE)      pp(lons+1)
            1091                           real(kind=RTYPE)      qq(lons  ,nv)
            1092                           real(kind=RTYPE)      pn(lons+1)
            1093                           real(kind=RTYPE)      qn(lons  ,nv)
            1094                           integer   lons,nv
            1095                     !
            1096                           real(kind=RTYPE)      hfdp(lons),rdsi(lons)
            1097                           real(kind=RTYPE)      locf(lons+lons),df(lons+lons-1),dt(lons+lons-1)
            1098                           real(kind=RTYPE)      qc(lons),dq(lons),qmi(lons),qpi(lons)
            1099                           real(kind=RTYPE)      valf(lons+lons-1)
            1100                           real(kind=RTYPE)      rdd(lons)
            1101                           real(kind=RTYPE)      dd,check,ss
            1102                           integer   js(lons+1),i4j(lons+lons)
            1103                           integer   i,j,n,ip,in
            1104                     !
            1105                     ! arrange input array cover output location with cyclic boundary
            1106                     ! condition
            1107                     !
            1108                           locf(1) = pp(1)
            1109                           i4j(1)=1
            1110                           js(1)=1
            1111                           ip=2
            1112                           in=2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pp, pn, i4j
                                   <<< Loop-information  End >>>
            1113     1       2s            do j=2,lons+lons-1
            1114     2       2m              if( pp(ip).le.pn(in) ) then
            1115     2       2s                locf(j) = pp(ip)
            1116     2       2m                ip = ip + 1
            1117     2       2s              else
            1118     2       2s                locf(j) = pn(in)
            1119     2       2s                js(in) = j
            1120     2       2m                in = in + 1
            1121     2       2v              endif
            1122     1       2s              i4j(j) = ip - 1
            1123     1       2v            enddo
            1124                           locf(lons+lons) = pp(lons+1)
            1125                           js(lons+1) = lons+lons
            1126                     !
            1127                     ! interpolation coefficient
            1128                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pp, hfdp
                                   <<< Loop-information  End >>>
            1129     1       2v            do i=1,lons
            1130     1       2v              hfdp(i) = 0.5*(pp(i+1)-pp(i))
            1131     1       2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hfdp, rdsi
                                   <<< Loop-information  End >>>
            1132     1       2v            do i=2,lons
            1133     1       2v              rdsi(i) = 1.0 / (hfdp(i)+hfdp(i-1))
            1134     1       2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locf, df
                                   <<< Loop-information  End >>>
            1135     1                     do i=1,lons
            1136     1                       dd = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.04, ITR: 192, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locf, df
                                   <<< Loop-information  End >>>
            1137     2       8v              do j=js(i),js(i+1)-1
            1138     2       8v                df(j) = locf(j+1) - locf(j)
            1139     2       8v                dd    = dd    + df(j)
            1140     2       8v              enddo
            1141     1                       rdd(i) = 1.0 / dd
            1142     1                     enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.18, ITR: 128, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      df, locf, i4j, dt
                                   <<< Loop-information  End >>>
            1143     1       2v            do j=1,lons+lons-1
            1144     1       2v              i = i4j(j)
            1145     1       2v              dt(j) = (locf(j) + 0.5*df(j)) - (pp(i) + hfdp(i))
            1146     1       2v            enddo
            1147                     !
            1148                     ! start interpolation by integral of ppm
            1149                     !
            1150                           dq(1) = 0.0
            1151                           dq(lons) = 0.0
            1152                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, qc, rdsi, qmi, i4j, dt, dq, qpi
                                   <<<      valf
                                   <<< Loop-information  End >>>
            1153     1                     do n=1,nv
            1154     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, qc
                                   <<< Loop-information  End >>>
            1155     2       2v              do i=1,lons
            1156     2       2v                qc(i) = qq(i,n)
            1157     2       2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.57, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rdsi, qc, qmi
                                   <<< Loop-information  End >>>
            1158     2       2v              do i=2,lons
            1159     2       2v                qmi(i) = (qc(i)-qc(i-1))*rdsi(i)
            1160     2       2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1161,1164)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 160, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qmi, dq, qpi
                                   <<< Loop-information  End >>>
            1161     2       2v              do i=2,lons-1
            1162     2       2v                qpi(i) = qmi(i+1)
            1163     2       2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1164     2                       do i=2,lons-1
            1165     2                         check = qmi(i)*qpi(i)
            1166     3                         if( check.lt.0.0 ) then
            1167     3                           dq(i) = 0.0
            1168     3                         else
            1169     3                           dq(i)  = 0.5*(qmi(i)+qpi(i))
            1170     3                         endif
            1171     2                       enddo
            1172     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.42, ITR: 176, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      i4j, dt, valf
                                   <<< Loop-information  End >>>
            1173     2       2v              do j=1,lons+lons-1
            1174     2       2v                i = i4j(j)
            1175     2       2v                valf(j) = qc(i) + dq(i)*dt(j)
            1176     2       2v              enddo
            1177     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      df, valf
                                   <<< Loop-information  End >>>
            1178     2                       do i=1,lons
            1179     2                         ss = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.75, ITR: 192, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      df, valf
                                   <<< Loop-information  End >>>
            1180     3       8v                do j=js(i),js(i+1)-1
            1181     3       8v                  ss = ss + valf(j)*df(j)
            1182     3       8v                enddo
            1183     2                         qn(i,n) = ss * rdd(i)
            1184     2                       enddo
            1185     1               
            1186     1                     enddo
            1187                     !
            1188                           return
            1189                           end subroutine fixend_cell_plm_intp


                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fa2, var, fa3, fa4, fa1, dist
                                   <<< Loop-information  End >>>
             570     2        v              do j=3,jm-1
             571     2        v                dist(j)=fa1(j)*var(j-2)+fa2(j)*var(j-1)+fa3(j)*var(j)+fa4(j)*var(j+1)
             572     2        v              enddo
             573     1                       ! over pole
             574     1                       dist(2)=fa1(2)*var(jm)+fa2(2)*var(1)+fa3(2)*var(2)+fa4(2)*var(3)
             575     1                       dist(jm)=fa1(jm)*var(jm-2)+fa2(jm)*var(jm-1)+fa3(jm)*var(jm)+fa4(jm)*var(1)
             576     1               
             577     1                       dist(1)=fa1(1)*var(jm-1)+fa2(1)*var(jm)+fa3(1)*var(1)+fa4(1)*var(2)
             578     1                       dist(jm+1)=dist(1)
             579     1               ! for equal latitude
             580     1               !        do j=3,jm-1
             581     1               !          dist(j)=fa1*(var(j)+var(j-1))-fa2*(var(j+1)+var(j-2))
             582     1               !        enddo
             583     1               ! over pole
             584     1               !        dist(2)=fa1*(var(2)+var(1 ))-fa2*(var(3)+var(jm  ))
             585     1               !        dist(1)=fa1*(var(1)+var(jm))-fa2*(var(2)+var(jm-1))
             586     1               !        dist(jm+1)=dist(1)
             587     1               !        dist(jm  )=fa1*(var(jm)+var(jm-1))-fa2*(var(1)+var(jm-2))
             588     1               !cflx   call def_cfl_max (jm+1,dist,ds,nstep)
             589     1                       call def_cfl_step(jm+1,dist,ds,step,nstep,lev+1-k,'advy')
             590     1               

             526                           subroutine cyclic_cell_massadvyl(jm,lev,nvars,delt,vc,qq,mass)
             527                     !
             528                     ! compute local positive advection with mass conserving
             529                     ! qq will be advect by vc from past to next location with 2*delt
             530                     !
             531                     ! author: hann-ming henry juang 2007
             532                     !
             533                     !
             534                           use grid     , only : gglati,fa1,fa2,fa3,fa4
             535                     !
             536                           use const, only : RTYPE
             537                     
             538                           implicit none
             539                     !
             540                           integer   jm,lev,nvars,mass
             541                           real(kind=RTYPE)      delt
             542                           real(kind=RTYPE)      vc(jm,lev)
             543                           real(kind=RTYPE)      qq(jm,lev,nvars)
             544                     !
             545                           real(kind=RTYPE)      var(jm)
             546                           real(kind=RTYPE)      past(jm,nvars),da(jm,nvars),next(jm,nvars)
             547                           real(kind=RTYPE)      dyfact(jm)
             548                           real(kind=RTYPE)      ypast(jm+1),ynext(jm+1)
             549                           real(kind=RTYPE)      dist (jm+1), ds(jm), step(10), dist_step
             550                           real(kind=RTYPE)      sc
             551                     
             552                           integer   n,k,j,jmh,nv,nst,nstep
             553                     !
             554                     ! preparations ---------------------------
             555                     !
             556                           jmh  = jm / 2
             557                           sc = gglati(jm+1)-gglati(1)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gglati, ds
                                   <<< Loop-information  End >>>
             558     1       2v            do j=1,jm
             559     1       2v              ds(j) = gglati(j+1) - gglati(j)
             560     1       2v            enddo
             561                           nv   = nvars
             562                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vc, var, fa1, fa3, fa2, fa4, dist
                                   <<< Loop-information  End >>>
             563     1                     do k=1,lev
             564     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.83, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vc, var
                                   <<< Loop-information  End >>>
             565     2       2v              do j=1,jmh

             314                     !
             315                     !
             316                     ! -------------------------------------------------------------------------------
             317                           subroutine cyclic_cell_massadvxl(im,imf,levs,nvars,delt,uc,qq,mass)
             318                     !
             319                     ! compute local positive advection with mass conservation
             320                     ! qq is advected by uc from past to next position
             321                     !
             322                     ! author: hann-ming henry juang 2008
             323                     !
             324                     !      use grid
             325                     !      use gfs_dyn_layout1
             326                     !
             327                           use const, only : RTYPE
             328                     
             329                           implicit none
             330                     !
             331                           integer	im,imf,levs,nvars,mass
             332                           real(kind=RTYPE)	delt,pi
             333                           real(kind=RTYPE)	uc(imf,levs)
             334                           real(kind=RTYPE)	qq(imf,levs,nvars)
             335                     !
             336                           real(kind=RTYPE)	past(im,nvars),next(im,nvars),da(im,nvars)
             337                           real(kind=RTYPE)	dxfact(im)
             338                           real(kind=RTYPE)	xreg(im+1),xpast(im+1),xnext(im+1)
             339                           real(kind=RTYPE)	uint(im+1)
             340                           real(kind=RTYPE) 	dist(im+1),sc,ds(im+1),step(10),dist_step
             341                           real(kind=RTYPE), parameter :: fa1 = 9./16.
             342                           real(kind=RTYPE), parameter :: fa2 = 1./16.
             343                     
             344                           integer  	i,k,n,nn,nf,nv,nst,nstep
             345                     
             346                     !     sc = ggloni(im+1)-ggloni(1)
             347                           pi = 4.0 * atan(1.0)
             348                           sc = 2.0 * pi
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 349,352)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.85, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ds, xreg
                                   <<< Loop-information  End >>>
             349     1       2v            do i=1,im+1
             350     1       2v              ds(i) = sc / float(im)
             351     1       2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             352     1                     do i=1,im+1
             353     1                       xreg(i) = (i-1.5)*ds(i)
             354     1                     enddo
             355                           nv = nvars
             356                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uc, uint, dist
                                   <<< Loop-information  End >>>
             357     1                     do k=1,levs
             358     1               !
             359     1               ! 4th order interpolation from mid point to cell interfaces
             360     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uc, uint
                                   <<< Loop-information  End >>>
             361     2       2v              do i=3,im-1
             362     2       2v                uint(i)=fa1*(uc(i,k)+uc(i-1,k))-fa2*(uc(i+1,k)+uc(i-2,k))
             363     2       2v              enddo
             364     1                       uint(2)=fa1*(uc(2,k)+uc(1 ,k))-fa2*(uc(3,k)+uc(im  ,k))
             365     1                       uint(1)=fa1*(uc(1,k)+uc(im,k))-fa2*(uc(2,k)+uc(im-1,k))
             366     1                       uint(im+1)=uint(1)
             367     1                       uint(im  )=fa1*(uc(im,k)+uc(im-1,k))                            &
             368     1                                      -fa2*(uc(1,k)+uc(im-2,k))
             369     1               
             370     1               !
             371     1               ! compute past and next positions of cell interfaces
             372     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uint, dist
                                   <<< Loop-information  End >>>
             373     2       2v              do i=1,im+1
             374     2       2v                dist(i)  = uint(i) * delt
             375     2       2v              enddo
             376     1               !cflx   call def_cfl_max (im+1,dist,ds,nstep)
             377     1                       call def_cfl_step(im+1,dist,ds,step,nstep,levs+1-k,'advx')
             378     1               !
             379     1               !  mass positive advection
             380     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dist, xreg, xpast, xnext, dxfact
                                   <<< Loop-information  End >>>
             381     2                      do nst = 1, nstep
             382     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 128, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dist, xreg, xpast, xnext
                                   <<< Loop-information  End >>>
             383     3       2v              do i=1,im+1
             384     3       2v                dist_step = dist(i)*step(nst)
             385     3       2v                xpast(i) = xreg(i) - dist_step
             386     3       2v                xnext(i) = xreg(i) + dist_step
             387     3       2v              enddo
             388     3                       if( mass.eq.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.56, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xpast, xnext, dxfact
                                   <<< Loop-information  End >>>
             389     4       2v               do i=1,im
             390     4       2v                dxfact(i) = (xpast(i+1)-xpast(i)) / (xnext(i+1)-xnext(i))
             391     4       2v               enddo
             392     3                       endif
             393     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, past
                                   <<< Loop-information  End >>>
             394     3                       do n=1,nv
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, past
                                   <<< Loop-information  End >>>
             395     3       2v                past(1:im,n) = qq(1:im,k,n)
             396     3                       enddo
             397     2               !        call cyclic_cell_ppm_intp(xreg,past,xpast,da,im,nv,im,im,sc)
             398     2                       call cyclic_cell_plm_intp(xreg,past,xpast,da,im,nv,im,im,sc)
             399     3                       if( mass.eq.1) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dxfact, da
                                   <<< Loop-information  End >>>
             400     4                         do n=1,nv
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 192, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dxfact, da
                                   <<< Loop-information  End >>>
             401     4       2v                  da(1:im,n) = da(1:im,n) * dxfact(1:im)
             402     4                         enddo
             403     3                       endif
             404     2               !        call cyclic_cell_ppm_intp(xnext,da,xreg,next,im,nv,im,im,sc)
             405     2                       call cyclic_cell_plm_intp(xnext,da,xreg,next,im,nv,im,im,sc)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      next, qq
                                   <<< Loop-information  End >>>
             406     3                       do n=1,nv
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      next, qq
                                   <<< Loop-information  End >>>
             407     3       2v                qq(1:im,k,n) = next(1:im,n)
             408     3                       enddo
             409     2               !
             410     2                      enddo
             411     1               !
             412     1                     enddo
             413                     
             414                           return
             415                           end subroutine cyclic_cell_massadvxl


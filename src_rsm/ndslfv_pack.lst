            1319                           real(kind=RTYPE) mass  (3*lonp,nv)
            1320                           real(kind=RTYPE) hh    (3*lonp)
            1321                           real(kind=RTYPE) fm    (3*lonp)
            1322                           real(kind=RTYPE) fn    (3*lonp)
            1323                           real(kind=RTYPE) dqmono(3*lonp,nv)
            1324                           real(kind=RTYPE) qmi   (3*lonp,nv)
            1325                           real(kind=RTYPE) qpi   (3*lonp,nv)
            1326                           real(kind=RTYPE) cyclic_length
            1327                           real(kind=RTYPE) pnmin,pnmax,locbndmin,locbndmax
            1328                           real(kind=RTYPE) dqi,dqimax,dqimin
            1329                           real(kind=RTYPE) tl,tl2,tl3,qql,tlp,tlm,tlc

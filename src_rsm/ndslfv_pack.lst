 External subroutine subprogram "cyclic_cell_massadvx"
  (inc)(line-no.)(nest)(optimize)
             213                     
             214                     ! -------------------------------------------------------------------------------
             215                           subroutine cyclic_cell_massadvx(im,imf,levs,nvars,delt,uc,qq,mass)
             216                     !
             217                     ! compute local positive advection with mass conservation
             218                     ! qq is advected by uc from past to next position
             219                     !
             220                     ! author: hann-ming henry juang 2008
             221                     !
             222                     !      use grid
             223                     !      use gfs_dyn_layout1
             224                     !
             225                           use const, only : RTYPE
             226                     
             227                           implicit none
             228                     !
             229                           integer	im,imf,levs,nvars,mass
             230                           real(kind=RTYPE)	delt,pi
             231                           real(kind=RTYPE)	uc(imf,levs)
             232                           real(kind=RTYPE)	qq(imf,levs,nvars)
             233                     !
             234                           real(kind=RTYPE)	past(im,nvars),next(im,nvars),da(im,nvars)
             235                           real(kind=RTYPE)	dxfact(im)
             236                           real(kind=RTYPE)	xreg(im+1),xpast(im+1),xnext(im+1)
             237                           real(kind=RTYPE)	uint(im+1)
             238                           real(kind=RTYPE) 	dist(im+1),sc,ds(im+1),step(10),dist_step
             239                           real(kind=RTYPE), parameter :: fa1 = 9./16.
             240                           real(kind=RTYPE), parameter :: fa2 = 1./16.
             241                     
             242                           integer  	i,k,n,nn,nf,nv,nst,nstep
             243                     
             244                     !     sc = ggloni(im+1)-ggloni(1)
             245                           pi = 4.0 * atan(1.0)
             246                           sc = 2.0 * pi
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 247,250)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.85, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ds, xreg
                                   <<< Loop-information  End >>>
             247     1       2v            do i=1,im+1
             248     1       2v              ds(i) = sc / float(im)
             249     1       2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             250     1                     do i=1,im+1
             251     1                       xreg(i) = (i-1.5)*ds(i)
             252     1                     enddo
             253                           nv = nvars
             254                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uc, uint, dist
                                   <<< Loop-information  End >>>
             255     1                     do k=1,levs
             256     1               !
             257     1               ! 4th order interpolation from mid point to cell interfaces
             258     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uc, uint
                                   <<< Loop-information  End >>>
             259     2       2v              do i=3,im-1
             260     2       2v                uint(i)=fa1*(uc(i,k)+uc(i-1,k))-fa2*(uc(i+1,k)+uc(i-2,k))
             261     2       2v              enddo
             262     1                       uint(2)=fa1*(uc(2,k)+uc(1 ,k))-fa2*(uc(3,k)+uc(im  ,k))
             263     1                       uint(1)=fa1*(uc(1,k)+uc(im,k))-fa2*(uc(2,k)+uc(im-1,k))
             264     1                       uint(im+1)=uint(1)
             265     1                       uint(im  )=fa1*(uc(im,k)+uc(im-1,k))                            &
             266     1                                      -fa2*(uc(1,k)+uc(im-2,k))
             267     1               
             268     1               !
             269     1               ! compute past and next positions of cell interfaces
             270     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uint, dist
                                   <<< Loop-information  End >>>
             271     2       2v              do i=1,im+1
             272     2       2v                dist(i)  = uint(i) * delt
             273     2       2v              enddo
             274     1               !cflx   call def_cfl_max (im+1,dist,ds,nstep)
             275     1                       call def_cfl_step(im+1,dist,ds,step,nstep,levs+1-k,'advx')
             276     1               !
             277     1               !  mass positive advection
             278     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dist, xreg, xpast, xnext, dxfact
                                   <<< Loop-information  End >>>
             279     2                      do nst = 1, nstep
             280     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 128, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dist, xreg, xpast, xnext
                                   <<< Loop-information  End >>>
             281     3       2v              do i=1,im+1
             282     3       2v                dist_step = dist(i)*step(nst)
             283     3       2v                xpast(i) = xreg(i) - dist_step
             284     3       2v                xnext(i) = xreg(i) + dist_step
             285     3       2v              enddo
             286     3                       if( mass.eq.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.56, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xpast, xnext, dxfact
                                   <<< Loop-information  End >>>
             287     4       2v               do i=1,im
             288     4       2v                dxfact(i) = (xpast(i+1)-xpast(i)) / (xnext(i+1)-xnext(i))
             289     4       2v               enddo
             290     3                       endif
             291     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, past
                                   <<< Loop-information  End >>>
             292     3                       do n=1,nv
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, past
                                   <<< Loop-information  End >>>
             293     3       2v                past(1:im,n) = qq(1:im,k,n)
             294     3                       enddo
             295     2                       call cyclic_cell_ppm_intp(xreg,past,xpast,da,im,nv,im,im,sc)
             296     2               !        call cyclic_cell_plm_intp(xreg,past,xpast,da,im,nv,im,im,sc)
             297     3                       if( mass.eq.1) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dxfact, da
                                   <<< Loop-information  End >>>
             298     4                         do n=1,nv
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 192, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dxfact, da
                                   <<< Loop-information  End >>>
             299     4       2v                  da(1:im,n) = da(1:im,n) * dxfact(1:im)
             300     4                         enddo
             301     3                       endif
             302     2                       call cyclic_cell_ppm_intp(xnext,da,xreg,next,im,nv,im,im,sc)
             303     2               !        call cyclic_cell_plm_intp(xnext,da,xreg,next,im,nv,im,im,sc)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      next, qq
                                   <<< Loop-information  End >>>
             304     3                       do n=1,nv
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      next, qq
                                   <<< Loop-information  End >>>
             305     3       2v                qq(1:im,k,n) = next(1:im,n)
             306     3                       enddo
             307     2               !
             308     2                      enddo
             309     1               !
             310     1                     enddo
             311                     
             312                           return
             313                           end subroutine cyclic_cell_massadvx


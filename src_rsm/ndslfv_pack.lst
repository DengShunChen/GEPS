            1851                     !
            1852                           subroutine ndslfv_update (lonsperlat,vdzonl,vdmerd,vdzonlr,vdmerdr,deltim)
            1853                     
            1854                     !  update all horizontal components into momentum eqs
            1855                     !  for Semi-Lagrangian vertical advection
            1856                     
            1857                           use index
            1858                           use param, only : nx,my,lev,my_max
            1859                           use const, only : onocos,radsq,RTYPE
            1860                           use grid , only : dlphi,dtphi
            1861                     
            1862                           integer,intent(in):: lonsperlat(my)
            1863                           real(kind=RTYPE),   intent(in):: deltim
            1864                     
            1865                           real(kind=RTYPE)    vdmerd(nxp,lev,my_max),vdzonl(nxp,lev,my_max)
            1866                           real(kind=RTYPE)    vdmerdr(nxp,lev,my_max),vdzonlr(nxp,lev,my_max)
            1867                           integer i,ii,k,lan,lat,lons_lat
            1868                           integer dt2
            1869                     
            1870                           dt2 = 2. * deltim
            1871                     !
            1872                     !$omp parallel do                                                   &
            1873                     !$omp private(lan,lat,lons_lat,i,k)                                 &
            1874                     !$omp schedule(dynamic)
            1875     1   p                 do lan=1,jlistnum
            1876     1               !
            1877     1   p                   lat = jlist1(lan)
            1878     1   p                   lons_lat = lonsperlat(lat)
            1879     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdmerdr, vdmerd, vdzonlr, vdzonl
                                   <<< Loop-information  End >>>
            1880     2   p                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 96, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdmerd, vdmerdr, vdzonlr, vdzonl
                                   <<< Loop-information  End >>>
            1881     3   p    v               do i=1,lons_lat
            1882     3               !ttl           vdzonl(i,k,lan) = (vdzonlr(i,k,lan)-dlphi(i,k,lan)/radsq) &
            1883     3               !ttl                             * dt2 + vdzonl(i,k,lan)
            1884     3               !ttl           vdmerd(i,k,lan) = (vdmerdr(i,k,lan)-dtphi(i,k,lan)/radsq  &
            1885     3               !ttl                             / onocos(lat))*dt2 + vdmerd(i,k,lan)
            1886     3   p    v                 vdzonl(i,k,lan) = vdzonlr(i,k,lan) * dt2 + vdzonl(i,k,lan)
            1887     3   p    v                 vdmerd(i,k,lan) = vdmerdr(i,k,lan) * dt2 + vdmerd(i,k,lan)
            1888     3   p    v               enddo
            1889     2   p                   enddo
            1890     1   p                 enddo
            1891                     !$omp end parallel do
            1892                     !
            1893                     ! ===============================
            1894                     !
            1895                           return
            1896                           end subroutine ndslfv_update


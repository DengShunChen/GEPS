 External subroutine subprogram "def_cfl_step"
  (inc)(line-no.)(nest)(optimize)
            1763                     !!
            1764                     !!
            1765                           subroutine def_cfl_step (im,dist,del,step,nstep,k,job)
            1766                     !
            1767                     ! compute the deformation cfl condition
            1768                     ! select the maxima value of the deformation CFL and provide step to
            1769                     ! avoid it.
            1770                     !
            1771                     !
            1772                           use const, only : RTYPE
            1773                     
            1774                           implicit none
            1775                     !
            1776                           integer im,nstep
            1777                           real(kind=RTYPE) dist(im),del(im-1),step(10)
            1778                     ! local
            1779                           integer   n,k,nchk
            1780                           real(kind=RTYPE)      rstep,check,check_max,check_point
            1781                           real(kind=RTYPE)      safe_step,last_step
            1782                           character*4 job
            1783                     !
            1784                           check_point=1.00
            1785                           safe_step=0.99
            1786                           nstep = 1
            1787                           step(1) = 1.0
            1788                     
            1789                           check_max = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dist, del
                                   <<< Loop-information  End >>>
            1790     1       2s            check_loop: do n=1,im-1
            1791     1       2v              check = abs ( (dist(n+1)-dist(n))/del(n) )
            1792     2       2v              if( check.lt.check_point ) then
            1793     2       2v                cycle check_loop
            1794     2       2v              else
            1795     3       2s                if ( check .gt. check_max ) then
            1796     3       2v                   nchk=n
            1797     3       2s                   check_max=check
            1798     3       2v                endif
            1799     2               !!          check_max = max( check_max, check )
            1800     2       2v              endif
            1801     1       2v            enddo check_loop
            1802     1                     if(check_max.ge.check_point) then
            1803     1                       nstep = int(check_max/safe_step) + 1
            1804     2                       if ( job .eq. 'advv' ) then
            1805     2                         print *,' max def_cfl ',check_max,' needs ',nstep,    &
            1806     2                         'steps at level',im+1-nchk,'of',im,'in ',job,' processing'
            1807     2                       else if ( job .eq. 'advx' .and. im .gt. 25 ) then
            1808     2                         print *,' max def_cfl ',check_max,' needs ',nstep,    &
            1809     2                         'steps in',nchk,'of',im,'at level',k,'in ',job,' processing'
            1810     2                       else if ( job .eq. 'advy' ) then
            1811     2                         print *,' max def_cfl ',check_max,' needs ',nstep,    &
            1812     2                         'steps in',nchk,'of',im,'at level',k,'in ',job,' processing'
            1813     2                       endif
            1814     1                       rstep =  safe_step / check_max
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      step
                                   <<< Loop-information  End >>>
            1815     2        v              do n=1,nstep-1
            1816     2        v                step(n) = rstep
            1817     2        v              enddo
            1818     1                       last_step = 1. - ( nstep - 1 ) * rstep
            1819     1                       step(nstep) = last_step
            1820     1                     endif
            1821                     !
            1822                           return
            1823                           end subroutine def_cfl_step


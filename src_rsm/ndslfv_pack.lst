                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      next, qq
                                   <<< Loop-information  End >>>
             710     3       2v                qq(1:jmh,k,n) = next(1:jmh,n)
             711     3                       enddo
             712     2               
             713     2                       enddo   ! for nst
             714     1               !
             715     1               ! second hemisphere
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 176, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      var, vc
                                   <<< Loop-information  End >>>
             716     2       2v              do j=1,jmh

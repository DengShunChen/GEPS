                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              56     1       2s            do j=1,jmh
              57     1       2m              gglat(      j) = 0.5*pi - acos(coslat(j))
              58     1       2m              gglat(jm +1-j) = 0.5*pi + acos(coslat(j))
              59     1       2m              gglat(jm +  j) = 1.5*pi - acos(coslat(j))
              60     1       2m              gglat(jm2+1-j) = 1.5*pi + acos(coslat(j))
              61     1       2v            enddo
              62                     !
              63                           gslati(    1)=0.0
              64                           gslati(jm +1)=2.0
              65                           gslati(jm2+1)=4.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.20, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gslati, wgt
                                   <<< Loop-information  End >>>
              66     1       2s            do j=1,jmh
              67     1       2s              gslati(    j+1) = gslati(    j  ) + wgt(j)
              68     1       2s              gslati(jm -j+1) = gslati(jm -j+2) - wgt(j)
              69     1       2s              gslati(jm +j+1) = gslati(jm +j  ) + wgt(j)
              70     1       2s              gslati(jm2-j+1) = gslati(jm2-j+2) - wgt(j)
              71     1       2s            enddo
              72                     
              73                     !
              74                     ! real(kind=RTYPE) latitude values first at edge, use temporary ggfact
              75                           gglati(1) = hfpi
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wgt, gglati, ggfact
                                   <<< Loop-information  End >>>
              76     1        s            do j=1,jmh
              77     1        m              gglati(j+1) = asin( sin(gglati(j)) - wgt(j) )
              78     1        v              ggfact(j) = gglati(j) - gglati(j+1)
              79     1        v            enddo
              80                     !
              81                     ! then relative latitude from 0 to 2pi
              82                           gglati(    1)=0.0
              83                           gglati(jm +1)=pi
              84                           gglati(jm2+1)=twopi

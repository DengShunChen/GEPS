            1825                           subroutine mymaxmin(a,im,ix,kx,ch)
            1826                           use const, only : RTYPE
            1827                             implicit none
            1828                             real(kind=RTYPE) :: fmax
            1829                             real(kind=RTYPE) :: fmin
            1830                             integer :: i
            1831                             integer :: im
            1832                             integer :: ix

                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, past
                                   <<< Loop-information  End >>>
             608     3       2v                past(1:jm,n) = qq(1:jm,k,n)
             609     3                       enddo
             610     2               !        call cyclic_cell_ppm_intp(gglati,past,ypast,da,jm,nv,jm,jm,sc)
             611     2                       call cyclic_cell_plm_intp(gglati,past,ypast,da,jm,nv,jm,jm,sc)
             612     2               
             613     3                       if( mass.eq.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dyfact, da
                                   <<< Loop-information  End >>>
             614     4                         do n=1,nv
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 192, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dyfact, da
                                   <<< Loop-information  End >>>
             615     4       2v                  da(1:jm,n) = da(1:jm,n) * dyfact(1:jm)
             616     4                         enddo

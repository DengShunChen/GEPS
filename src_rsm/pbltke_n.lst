               1                           Subroutine pbltke_n ( nxj,nx,lev,ktpbl,dt,g,r,cp,xkapa,hltm,ptop,tice &
               2                                             , hice,tg,z0,land,topo,phi,pss,u,v,t,q,ut       &
               3                                             , vt,tt,qt,pk,pk2,ustar,tstar,qstar,e,eps,hflux &
               4                                             , qflux,gwclim,tgclim,ocean,ice,snr             &
               5                                             , totalp,ss,rs,alb,imx,xkmx,idg,xkmd,itype      &
               6                                             , t2,rh2,u10,v10                                &
               7                                             , rld,stbo                                      &
               8                                             , km,smc,stc,canopy,runoff,sigmaf,istyp,ivegtyp &
               9                                             , wlt,ref,tsat,dfkt,xktk,dfk,ncld,dsigma,j)
              10                     !
              11                     !#######################################################################
              12                     !                     subroutine description
              13                     !
              14                     ! 1. function description
              15                     !
              16                     !    this version is based on the Troen and Mahrt (1986) to deal with
              17                     !    the vertical diffusion with account of non-local flux.
              18                     !    the code is origially from ncepgfs
              19                     !
              20                     !
              21                     ! 2. parameter specification
              22                     !
              23                     !     nx : dimension of horizontal-direction
              24                     !    lev : dimension of z-direction
              25                     !  ktpbl : starting level to consider vertical mixing by pbl
              26                     !     dt : time step for ut, vt, tt, qt updates                (s)
              27                     !      g : gravity                                             (m/s2)
              28                     !      r : air gas constant                                    (j/kg)
              29                     !     cp : air specific heat constant                          (j/kg)
              30                     !  xkapa : r/cp
              31                     !   hltm : water vapor latent heat constant                    (j/kg)
              32                     !   ptop : model top pressure                                  (mb)
              33                     !   tice : temperature of melting point                        (k)
              34                     !   hice : latent heat of snow melting                         (j/kg)
              35                     !     tg : ground real temp. (sea or land)  (nx)               (k)
              36                     !     z0 : surface roughness length    (nx)                    (m)
              37                     !   gwet : ground wetness              (nx)
              38                     !   land : logic for bare soil land    (nx)  (=true for bare land)
              39                     !   topo : terrain geopotential   (nx)                         (m2/s2)
              40                     !    phi : odd level geopotential (nx)                         (m2/s2)
              41                     !    pss : (terrain pres -ptop)   (nx)     at current time lvl (mb)
              42                     !      u : x-direction velocity   (nx,lev) at current time lvl (m/s)
              43                     !      v : y-direction velocity   (nx,lev) at current time lvl (m/s)
              44                     !      t : potent temp on odd lvl (nx,lev) at current time lvl (k)
              45                     !      q : moisture    on odd lvl (nx,lev) at current time lvl (kg/kg)
              46                     !     ut : x-direction velocity   (nx,lev) at past/future  lvl (m/s)
              47                     !     vt : y-direction velocity   (nx,lev) at past/future  lvl (m/s)
              48                     !     tt : real temp.  on odd lvl (nx,lev) at past/future  lvl (k)
              49                     !     qt : moisture    on odd lvl (nx,lev) at past/future  lvl (kg/kg)
              50                     !     pk : p**capa on odd levels  (exner func)
              51                     !    pk2 : p**capa on even levels (exner func)
              52                     !   ustar: friction velocity         (nx)                      (m/s)
              53                     !   tstar: potential temp scale      (nx)                      (k)
              54                     !   qstar: moisture scale            (nx)                      (kg/kg)
              55                     !     e  : turbulence kinetic energy (nx,lev) at even lvls     (m2/s2)
              56                     !    eps : tke dissipation           (nx,lev)                  (m2/s2)
              57                     !   hflux: upward surface heat flux         (nx)               (w/m2)
              58                     !   qflux: upward surface moisture flux     (nx)               (w/m2)
              59                     !    gwr : soil water amount           (nx)                    (mm)
              60                     !  gwclim: soil water climate          (nx)                    (mm)
              61                     !  tgclim: climate ground temperature  (nx)                    (k)
              62                     !   ocean: logic for open water      (nx)  (=true for open water)
              63                     !     ice: logic for ice cover       (nx)  (=true for ice covered)
              64                     !     snr: snow depth in water state (nx)                      (mm)
              65                     !  totalp: total precipitation       (nx)                      (mm)
              66                     !      ss: net short wave radiat. flux down to ground (nx)     (wat/m2)
              67                     !      rs: net long  wave radiat. flux up from ground (nx)     (wat/m2)
              68                     !     alb: diffusion albedo           (nx)
              69                     !     imx: address of the two points with max xkm at the two lowest lvl
              70                     !    xkmx: max mixing coef xkm at two lowest levels            (m2/s)
              71                     !     idg: i-index address of selected point to print profile
              72                     !    xkmd: xkm profile at the selected idg point               (m2/s)
              73                     !   itype: surface layer update type, =0 use surface stress as b.c.
              74                     !                                     =1 directly update lowest levels
              75                     !      t2: 2m air temp derived by similarity theory (nx)     (K)
              76                     !     rh2: 2m air rh (nx)
              77                     !     u10: 10m air x-direction wind derived by simil. theory(nx)  (m/s)
              78                     !     v10: 10m air y-direction wind derived by simil. theory(nx)  (m/s)
              79                     !
              80                     !soil io
              81                     !
              82                     !     smc: volumetric soil moisture content (nx,km_soil)
              83                     !     stc: soil temperature                 (nx,km_soil)
              84                     !  canopy: canopy moisture content(<0.5mm)          (nx)
              85                     !  sigmaf: green vegetation fraction        (nx)
              86                     !   istyp: soil type(1-9)                   (nx)
              87                     ! ivegtyp: vegetation type(1-13)            (nx)
              88                     !  runoff: accumulate run off water(runof+drain) (nx)             (mm)
              89                     !     rld: long wave radiat. flux down to ground (nx)         (wat/m2)
              90                     !   wlt  : wiltling point of 9 soil types  (9)
              91                     !   ref  : field capacity of 9 soil types  (9)
              92                     ! tsat   : satuation point of 9 soil types (9)
              93                     ! dfkt   : soil thermal diffusivity     (22,9)     m2/s
              94                     ! xktk   : soil hydraulic conductivity  (22,9)     m/s
              95                     !  dfk   : soil hydraulic diffusivity   (22,9)     m2/s
              96                     !
              97                     ! 4. local variable
              98                     !
              99                     !    phi : geopential on odd lvl  (nx,lev) at current time lvl (m2/s2)
             100                     !    xkm : eddy mixing coef. for u,v (nx,lev)                  (m2/s)
             101                     !    xkh : eddy mixing coef. for t,q (nx,lev)                  (m2/s)
             102                     !      ts: surface air temperature    (nx)                     (k)
             103                     !    qsfc: surface moisture (specific humidity)      (nx)      (kg/kg)
             104                     !     zl : height(lev) over monin-obukhov scale height.
             105                     !          a stability indicator.                    (nx)
             106                     !     czh: ground thermal capacity                   (nx)      (j/kg.m2)
             107                     !    snow: logic for snow cover                      (nx)
             108                     !
             109                     !soil
             110                     !
             111                     !  rhscnpy: righ hand side terms of canopy prediction(nx)
             112                     !    rhsmc: righ hand side terms of smc prediction(nx,km)
             113                     !      aim: working array smc prediction           (nx,km)
             114                     !      bim: working array smc prediction           (nx,km)
             115                     !      cim: working array smc prediction           (nx,km)
             116                     !   drain: drainage water from bottom soil layer   (nx)        (mm/s)
             117                     !     snomt: snow melt rate                        (nx)        (mm/s)
             118                     !     zsoil: soil depth of soil layer(-0.1,-2.)    (nx,km)        (m)
             119                     !     runof: run off water from surface and soil   (nx)        (mm/s)
             120                     !      gfx: ground heat flx                        (nx)        (wat/m2)
             121                     !     t850: 850mb air temp                         (nx)         (K)
             122                     !     gesh: control number,control precipitation   (nx)
             123                     !           conver to snow(0) or not(1)
             124                     !
             125                     !
             126                     ! 5. calling modules
             127                     !
             128                     !     main program
             129                     !
             130                     !     created       november 1991
             131                     !     modified      july     1992,  april   1993
             132                     !     modified      jan      2005  by f. wang
             133                     !     modified      may      2009  by f. wang
             134                     !
             135                     !            ed., american meteorology socity, 67-98.
             136                     !  mixpbl:
             137                     !       troen, i., and l. mahrt, 1986: a simple model of the atmospheric
             138                     !          boundary layer: sensitivity to surface evaporation. bound.
             139                     !          layer meteor., 37, 129-148.
             140                     !
             141                     !  land process:
             142                     !       Mahrt, L., and H. -L. Pan,1984: Atwo-layer model of soil hydrology.
             143                     !             Boundary Layer Meteorol., 29, 1-20.
             144                     !       Pan, H.-L., and L.Mahrt, 1987: Interaction between soil hydrology
             145                     !             and boundary-layer development. Boundary Layer Meteorol.,
             146                     !             38,185-202.
             147                     !#####################################################################
             148                           use paramt
             149                           use const, only : RTYPE
             150                     
             151                           implicit none
             152                     
             153                     !
             154                     ! input & output variable
             155                     !
             156                           integer  nxj,nx,lev,ktpbl,idg,itype,km,ncld,j
             157                           real     dt,g,r,cp,xkapa,hltm,ptop,tice,hice,stbo
             158                     
             159                           integer  imx(2)
             160                     
             161                           real     tg(nx),z0(nx),                                             &
             162                                    u(nx,lev),v(nx,lev),t(nx,lev),                             &
             163                                    ustar(nx),                                                 &
             164                                    tstar(nx),qstar(nx),e(nx,lev),eps(nx,lev),hflux(nx),       &
             165                                    qflux(nx),pkd(nx),pk2d(nx),gwclim(nx),                     &
             166                                    tgclim(nx),snr(nx),totalp(nx),                             &
             167                                    ss(nx),rs(nx),alb(nx),xkmx(2),xkmd(lev),                   &
             168                                    t2(nx),rh2(nx),u10(nx),v10(nx)
             169                           real(kind=RTYPE) q(nx,lev*ncld),qt(nx,lev*ncld),phi(nx,lev),        &
             170                                            topo(nx),pss(nx),ut(nx,lev),vt(nx,lev),tt(nx,lev), &
             171                                            pk(nx,lev),pk2(nx,lev)
             172                     !soil
             173                           real     smc(nx,km),stc(nx,km),canopy(nx),sigmaf(nx),               &
             174                                    rld(nx),runoff(nx)
             175                     
             176                           integer  istyp(nx),ivegtyp(nx)
             177                     !
             178                           logical  land(nx),ocean(nx),ice(nx)
             179                     !
             180                     !  local work arrays
             181                     !
             182                           real     hgt(im,lm),xkm(im,lm),xkh(im,lm),ts(im),                &
             183                                    qsfc(im),zl(im),czh(im),ps(im),sfcw(im),                &
             184                                    dhgt(im,lm),ro2(im,lm),dhgtz(im,lm)
             185                     !soil
             186                           real     rhscnpy(nx),rhsmc(nx,km),aim(nx,km),bim(nx,km),         &
             187                                    cim(nx,km),drain(nx),snomt(nx),zsoil(nx,km),            &
             188                                    runof(nx),gfx(nx),t850(nx),gesh(nx)
             189                     !
             190                           integer, parameter :: ntype=9, ngrid=22
             191                     
             192                           real     wlt(ntype),ref(ntype),tsat(ntype),dfkt(ngrid,ntype),    &
             193                                    xktk(ngrid,ntype),dfk(ngrid,ntype)
             194                     !soil
             195                     !
             196                     ! ncep_pbl
             197                           integer   kpbl(im)
             198                           real      rb(im),fm(im),fh(im),hpbl(im),                         &
             199                                     heat(im),evap(im),stress(im),                          &
             200                                     prsl(im,lm),prslk(im,lm),phil(im,lm),del(im,lm),       &
             201                                     prsi(im,lm+1),phi2(im,lm+1),phii(im,lm+1),             &
             202                                     rcl(im),                                               &
             203                                     u1(nx,lev),v1(nx,lev),t1(nx,lev),q1(nx,lev,2)
             204                           real(kind=RTYPE) dsigma(lm,2)
             205                     !ibm---add
             206                           real      pk2x(nx,lev),pkx(nx,lev)
             207                     !ibm---
             208                     
             209                           logical   snow(im)
             210                     
             211                           integer   i,k,kc,ntrac
             212                           real      ppp,ttt,ppu,dth,p850,ddd,cc,ppd
             213                     
             214                     !
             215                     ! --- ensure ktpbl selection is greater than 2
             216                     !
             217                           if ( ktpbl .lt. 2 )  ktpbl = 2
             218                     !
             219                     ! --- compute surface pres and surface air temp at current time level
             220                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 500
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.37, ITR: 128, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ts, pk2, t, pss, ps
                                   <<< Loop-information  End >>>
             221     1  pp   2v            do 50 i = 1, nxj
             222     1   p   2v            ps(i) = pss(i) + ptop
             223     1   p   2v            ts(i) = t(i,lev)*pk2(i,lev)
             224     1   p   2v        50  continue
             225                     
             226                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, pk2, pk2x, pkx, pkd, pk2d
                                   <<< Loop-information  End >>>
             227     1                     do k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pkd, pk, pk2, pk2d
                                   <<< Loop-information  End >>>
             228     1  pp   2v            pkd(:) =pk(:,k)
             229     1   p   2v            pk2d(:)=pk2(:,k)
             230     1                     call vlog(pk2x(1,k),pk2d,nxj)
             231     1                     call vlog(pkx(1,k), pkd, nxj)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2x, pkx
                                   <<< Loop-information  End >>>
             232     2  pp   2v            do i = 1, nxj
             233     2   p   2v              pk2x(i,k)=pk2x(i,k)*(cp/r)
             234     2   p   2v              pkx(i,k) = pkx(i,k)*(cp/r)
             235     2   p   2v            enddo
             236     1                     call vexp(pk2x(1,k),pk2x(1,k),nxj)
             237     1                     call vexp(pkx(1,k), pkx(1,k), nxj)
             238     1                     enddo
             239                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      topo, phi, hgt
                                   <<< Loop-information  End >>>
             240     1  pp                 do 100 k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.71, ITR: 112, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      topo, phi, hgt
                                   <<< Loop-information  End >>>
             241     2   p   2v            do 100 i = 1, nxj
             242     2   p   2v            hgt(i,k) = (phi(i,k) - topo(i) ) / g
             243     1   p   2v        100 continue
             244                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 341
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.65, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2x, pkx, pk, t, q, dhgtz, dhgt
                                   <<< Loop-information  End >>>
             245     1  pp    v            do 105 i = 1, nxj
             246     1   p    v            ppd = pk2x(i,1) * 1000.
             247     1   p    v            dhgt(i,1) = ( ppd - ptop ) * 100. / g
             248     1   p    v            ppp = pkx(i,1) * 1000.
             249     1   p    v            ttt = t(i,1)*pk(i,1)*(1.+0.608*q(i,1))
             250     1   p    v            dhgtz(i,1)= dhgt(i,1) * r * ttt / (100.*ppp)
             251     1   p    v        105 continue
             252                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pkx, pk, pk2x, t, q, dhgt, dhgtz
                                   <<< Loop-information  End >>>
             253     1  pp                 do 110 k=2, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.73, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pkx, pk, pk2x, t, q, dhgtz, dhgt
                                   <<< Loop-information  End >>>
             254     2   p    v            do 110 i=1, nxj
             255     2   p    v            ppu=pk2x(i,k-1) * 1000.
             256     2   p    v            ppd=pk2x(i,k) * 1000.
             257     2   p    v            dhgt(i,k) = ( ppd - ppu ) * 100. / g

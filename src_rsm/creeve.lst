 External subroutine subprogram "creeve"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine creeve ( nxj,nx,lev,g,r,cp,hltm,pl,pl2,tl,ql,topo  &
               2                                             , pk,pk2,qls,sl,hl,hls,zl,phil,tl2,ql2      &
               3                                             , qls2,sl2,hl2,hls2,zl2,phil2 )
               4                     !
               5                     !***********************************************************************
               6                     !
               7                     !    1.   function description
               8                     !           interpolate variable from model level to even level
               9                     !           we define the local large-scale environment in
              10                     !           terms of temperature, water vapor mixing ratio,
              11                     !           saturation water vapor mixing ratio, dry static
              12                     !           energy, moist static energy, saturation moist
              13                     !           static energy and heights of pressure levels.
              14                     !
              15                     !    2.   common block specification
              16                     !            none
              17                     !
              18                     !    3.   parameter specification
              19                     !     input :
              20                     !       nx          :  dimension of horizontal direction
              21                     !       lev         :  position index in the latitudinal direction
              22                     !       g           :  gravity (9.806)
              23                     !       r           :  gas constant (287.0)
              24                     !       cp          :  heat specific constant of the air (=1004.)
              25                     !       hltm        :  latent heat constant of water vapor (2.52e+6)
              26                     !       pl(nx,lev)  :  pressure     on odd level  ( mb  )
              27                     !       pl2(nx,lev) :  pressure     on even level ( mb  )
              28                     !       tl(nx,lev)  :  temperature  on odd level  ( k   )
              29                     !       ql(nx,lev)  :  mixing ration on odd level (kg/kg)
              30                     !       topo(nx)    :  geopotential height for toporaphy
              31                     !     output:
              32                     !       qls(nx,lev)  : saturation mixing ration on odd level (kg/kg)
              33                     !       sl(nx,lev)   : dry static energy on model level
              34                     !       hl(nx,lev)   : moist static energy on model level
              35                     !       hls(nx,lev)  : saturation moist static energy on model level
              36                     !       zl(nx,lev)   : geopotential hight on model level
              37                     !       phil(nx,lev) : geopotential on model level
              38                     !       tl2(nx,lev)  : temperature  on even level  ( k   )
              39                     !       ql2(nx,lev)  : mixing ration on even level (kg/kg)
              40                     !       qls2(nx,lev) : saturation mixing ration on even level (kg/kg)
              41                     !       sl2(nx,lev)  : dry static energy on even level
              42                     !       hl2(nx,lev)  : moist static energy on even level
              43                     !       hls2(nx,lev) : saturation moist static energy on even level
              44                     !       zl2(nx,lev)  : geopotential hight on even level
              45                     !       phil2(nx,lev): geopotential on even level
              46                     !
              47                     !    4.  calling modules
              48                     !            cupcwb
              49                     !
              50                     !    5.  usage
              51                     !        call creeve ( nx,lev,g,r,cp,hltm,pl,pl2,tl,ql,topo,pk,pk2
              52                     !       1            , qls,sl,hl,hls,zl,phil,tl2,ql2,qls2,sl2,hl2,hls2
              53                     !       2            , zl2,phil2 )
              54                     !
              55                     !    6.  modules called
              56                     !            none
              57                     !
              58                     !    7.  date
              59                     !          created    1992           by      c-s chen  ( cwb  )
              60                     !          modified   1993           by      c-s liou
              61                     !          modify to f90 by C-H Lee and sort by River Chen in 2015
              62                     !
              63                     !***********************************************************************
              64                     !
              65                           use const, only: RTYPE
              66                     !
              67                           implicit  none
              68                           integer   nxj,nx,lev,levm1,nxlev,i,l,k,lk,lkp
              69                     
              70                           real      pl(nx,lev),ql(nx,lev),qls(nx,lev),sl(nx,lev)            &
              71                                   , hl(nx,lev),hls(nx,lev),zl(nx,lev)                       &
              72                                   , pl2(nx,lev)                                             &
              73                                   , tl2(nx,lev),ql2(nx,lev),qls2(nx,lev),sl2(nx,lev)        &
              74                                   , hl2(nx,lev),hls2(nx,lev),zl2(nx,lev),phil2(nx,lev)
              75                           real(kind=RTYPE) tl(nx,lev),phil(nx,lev),topo(nx),pk(nx,lev)      &
              76                                   , pk2(nx,lev)
              77                           real      tmp1(nx,lev)
              78                     !
              79                           real      ograv,g,hltm,cp,r,ratio,amean,bmean
              80                     
              81                           ograv = 1.0/g
              82                           levm1 = lev-1
              83                           nxlev = nx*lev
              84                     !
              85                     !     (2) even levels (phil2)
              86                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      topo, phil2
                                   <<< Loop-information  End >>>
              87     1  pp   2v            do 100 i = 1, nxj
              88     1   p   2v            phil2(i,lev) = topo(i)
              89     1   p   2v        100 continue
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tl, pk, pk2, ql, phil2
                                   <<< Loop-information  End >>>
              90     1                     do 200 l = 1, levm1
              91     1                     k = lev - l
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 411
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.51, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, ql, tl, pk, phil2
                                   <<< Loop-information  End >>>
              92     2  pp    v            do 200 i = 1, nxj
              93     2   p    v            phil2(i,k) = phil2(i,k+1) + cp*(pk2(i,k+1)-pk2(i,k)) &
              94     2                                         *tl(i,k+1)*(1.0+0.608*ql(i,k+1))/pk(i,k+1)
              95     1   p    v        200 continue
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phil2, topo, phil, zl2, zl
                                   <<< Loop-information  End >>>
              96     1  pp                 do 220 k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.88, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phil, zl2, phil2, zl, topo
                                   <<< Loop-information  End >>>
              97     2   p   2v            do 220 i = 1, nxj
              98     2   p   2v            zl(i,k)  = (phil(i,k)-topo(i)) *ograv
              99     2   p   2v            zl2(i,k) = (phil2(i,k)-topo(i))*ograv
             100     1   p   2v        220 continue
             101                     !
             102                     !     linear-z interpolation temp and log(q) to even levels
             103                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ql, ql2
                                   <<< Loop-information  End >>>
             104     1                     do l = 1, levm1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.31, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ql, ql2
                                   <<< Loop-information  End >>>
             105     2  pp   2v            do i = 1, nxj
             106     2   p   2v              ql2(i,l)=ql(i,l+1)/ql(i,l)
             107     2   p   2v            enddo
             108     1                      call vlog(ql2(1,l),ql2(1,l),nxj)
             109     1                     enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phil2, phil, ql2, tmp1
                                   <<< Loop-information  End >>>
             110     1                     do l = 1, levm1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 500
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.39, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phil, phil2, ql2, tmp1
                                   <<< Loop-information  End >>>
             111     2  pp    v            do i = 1, nxj
             112     2   p    v             tmp1(i,l)=(phil2(i,l)-phil(i,l))/(phil(i,l+1)-phil(i,l))
             113     2   p    v             ql2(i,l)=tmp1(i,l)*ql2(i,l)
             114     2   p    v            enddo
             115     1                      call vexp(ql2(1,l),ql2(1,l),nxj)
             116     1                     enddo
             117                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ql2, ql, tl, tmp1, tl2
                                   <<< Loop-information  End >>>
             118     1  pp                 do 300 l = 1, levm1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 80, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tl, ql2, ql, tmp1, tl2
                                   <<< Loop-information  End >>>
             119     2   p    v            do 300 i = 1, nxj
             120     2   p    v            ratio = tmp1(i,l)
             121     2   p    v            tl2(i,l) = tl(i,l) + ratio*(tl(i,l+1)-tl(i,l))
             122     2   p    v            ql2(i,l) = ql(i,l) * ql2(i,l)
             123     1   p    v        300 continue
             124                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.34, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ql2, ql
                                   <<< Loop-information  End >>>
             125     1  pp   2v            do i=1,nxj
             126     1   p   2v              ql2(i,lev) = ql(i,lev)/ql2(i,levm1)
             127     1   p   2v            enddo
             128                           call vlog(ql2(1,lev),ql2(1,lev),nxj)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.39, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phil, phil2, ql2, tmp1
                                   <<< Loop-information  End >>>
             129     1  pp    v            do i=1,nxj
             130     1   p    v             tmp1(i,lev)=(phil2(i,lev)-phil(i,lev))/(phil(i,lev)-phil2(i,levm1))
             131     1   p    v             ql2(i,lev)=tmp1(i,lev)*ql2(i,lev)
             132     1   p    v            enddo
             133                           call vexp(ql2(1,lev),ql2(1,lev),nxj)
             134                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 80, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tl2, tl, ql2, ql, tmp1
                                   <<< Loop-information  End >>>
             135     1  pp    v            do 320 i = 1, nxj
             136     1   p    v            ratio =tmp1(i,lev)
             137     1   p    v            tl2(i,lev) = tl(i,lev) + ratio*(tl(i,lev)-tl2(i,levm1))
             138     1   p    v            ql2(i,lev) = ql(i,lev)*ql2(i,lev)
             139     1   p    v        320 continue
             140                     !
             141                     !     compute qls2 and ensure ql2 is not supersatuated
             142                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qls2, ql2
                                   <<< Loop-information  End >>>
             143     1                     do 340 k = 1, lev
             144     1                     call qsatq ( nxj,tl2(1,k),pl2(1,k),qls2(1,k) )
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qls2, ql2
                                   <<< Loop-information  End >>>
             145     2  pp   2v            do 340 i = 1, nxj
             146     2   p   2v            ql2(i,k) = min(ql2(i,k),qls2(i,k))
             147     1   p   2v        340 continue
             148                     !
             149                     !     compute sl, sl2 and ensure no static instability
             150                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tl2, phil2, phil, tl, sl2, sl
                                   <<< Loop-information  End >>>
             151     1  pp                 do 400 k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 80, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phil, tl2, phil2, tl, sl, sl2
                                   <<< Loop-information  End >>>
             152     2   p    v            do 400 i = 1, nxj
             153     2   p    v            sl(i,k) = cp*tl(i,k)  + phil(i,k)
             154     2   p    v            sl2(i,k)= cp*tl2(i,k) + phil2(i,k)
             155     1   p    v        400 continue
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sl2, sl
                                   <<< Loop-information  End >>>
             156     1                     do 410 l = 2, lev
             157     1                     lk = lev - l + 1
             158     1                     lkp= lk + 1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 80, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sl2, sl
                                   <<< Loop-information  End >>>
             159     2  pp    v            do 415 i = 1, nxj
             160     3   p    v            if ( sl(i,lk) .lt. sl(i,lkp) )  then
             161     3   p    v              amean = 0.5*(sl(i,lk)+sl(i,lkp))
             162     3   p    v              sl(i,lk) = amean
             163     3   p    v              sl(i,lkp)= amean
             164     3   p    v            endif
             165     3   p    v            if ( sl2(i,lk) .lt. sl2(i,lkp) )  then
             166     3   p    v              bmean = 0.5*(sl2(i,lk)+sl2(i,lkp))
             167     3   p    v              sl2(i,lk) = bmean
             168     3   p    v              sl2(i,lkp)= bmean
             169     3   p    v            endif
             170     2   p    v        415 continue
             171     1                 410 continue
             172                     !
             173                     !     compute hl, hls, hl2 and hls2 at odd and even levels
             174                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qls2, sl2, ql2, ql, sl, qls, hls2, hl2
                                   <<<      hl, hls
                                   <<< Loop-information  End >>>
             175     1  pp                 do 420 k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.57, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sl2, qls, hls2, hl2, ql, ql2, sl, qls2
                                   <<<      hl, hls
                                   <<< Loop-information  End >>>
             176     2   p    v            do 420 i = 1, nxj
             177     2   p    v            hls(i,k) = sl(i,k)  + hltm*qls(i,k)
             178     2   p    v            hl(i,k)  = sl(i,k)  + hltm*ql(i,k)
             179     2   p    v            hl2(i,k) = sl2(i,k) + hltm*ql2(i,k)
             180     2   p    v            hls2(i,k)= sl2(i,k) + hltm*qls2(i,k)
             181     1   p    v        420 continue

            1116     2                       if (xland(i).lt.1.5) then
            1117     2                       fluxc = max(sflux(i),0.0)
            1118     2                       vconvc=1.
            1119     2                       VCONV = vconvc*(g/thvx(i,1)*pblh_ysu(i)*fluxc)**.33
            1120     2                       else
            1121     2               ! for water there is no topo effect so vconv not needed
            1122     2                       VCONV = 0.
            1123     2                       endif
            1124     1                       vconvfx(i) = vconv
            1125     1               !raquel
            1126     1               !ctopo stability correction
            1127     1                     fric(i,1)=ust(i)**2/wspd1(i)*rhox(i)*g/del(i,1)*dt2         &
            1128     1                       *(wspd1(i)/wspd(i))**2
            1129     2                     if(.true.) then
            1130     2               !      if(present(ctopo)) then
            1131     2                       vconvnew=0.9*vconvfx(i)+1.5*(max((pblh_ysu(i)-500)/1000.0,0.0))
            1132     2                       vconvlim = min(vconvnew,1.0)
            1133     2                       ad(i,1) = 1.+fric(i,1)*vconvlim+ctopo(i)*fric(i,1)*(1-vconvlim)
            1134     2                     else
            1135     2                      ad(i,1) = 1.+fric(i,1)
            1136     2                     endif
            1137     1                    f1(i,1) = ux(i,1)+uox(i)*ust(i)**2*rhox(i)*g/del(i,1)*dt2/wspd1(i)*(wspd1(i)/wspd(i))**2
            1138     1                    f2(i,1) = vx(i,1)+vox(i)*ust(i)**2*rhox(i)*g/del(i,1)*dt2/wspd1(i)*(wspd1(i)/wspd(i))**2
            1139     1                  enddo

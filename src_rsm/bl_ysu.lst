                                   <<<      SCALABLE  : SPILL 6  FILL 23
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             766     2   p    v           do i = 1,im
             767     3   p    v             if(k.lt.kpbl(i)) then
             768     3   p    v               zfac(i,k) = min(max((1.-(zq(i,k+1)-zl1(i))/(hpbl(i)-zl1(i))),zfmin),1.)
             769     3   p    v               zfacent(i,k) = (1.-zfac(i,k))**3.
             770     3               !         zfacent(i,k) = (1.-zfac(i,k))**4.
             771     3   p    v               wscalek(i,k) = (ust3(i)+phifac*karman*wstar3(i)*(1.-zfac(i,k)))**h1
             772     3   p    v               wscalek2(i,k) = (phifac*karman*wstar3_2(i)*(zfac(i,k)))**h1
             773     4   p    v               if(sfcflg(i)) then
             774     4   p    v                 prfac = conpr
             775     4   p    v                 prfac2 = 15.9*(wstar3(i)+wstar3_2(i))/ust3(i)/(1.+4.*karman*(wstar3(i)+wstar3_2(i))/ust3(i))
             776     4               !           prfac2 = 8.*(wstar3(i)+wstar3_2(i))/ust3(i)/(1.+4.*karman*(wstar3(i)+wstar3_2(i))/ust3(i)) !xb118
             777     4   p    v                 prnumfac = -3.*(max(zq(i,k+1)-sfcfrac*hpbl(i),0.))**2./hpbl(i)**2.
             778     4   p    v               else

                                   <<< Loop-information  End >>>
             765     1  pp              do k = 1,klpbl
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kpbl, zl1, hpbl, zq, zfac, zfacent
                                   <<<      wstar3_2, wscalek2, sfcflg, cloudflg, we
                                   <<<      zol1, ust, ust3, wstar3, wscalek
                                   <<<    PREFETCH(SOFT) : 14
                                   <<<     SEQUENTIAL : 14
                                   <<<      xkzm: 2, phih: 2, phim: 2, xkzoh: 2
                                   <<<      xkzom: 2, xkzh: 2, xkzq: 2
                                   <<<    SPILLS :

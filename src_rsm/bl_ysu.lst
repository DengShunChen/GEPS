 External subroutine subprogram "GET_PBLH"
  (inc)(line-no.)(nest)(optimize)
            1445                     !-------------------------------------------------------------------------------
            1446                     ! ==================================================================
            1447                     
            1448                           SUBROUTINE GET_PBLH(KTS,KTE,zi,thetav1D,qke1D,zw1D,dz1D,landsea)
            1449                     ! Copied from MYNN PBL
            1450                     
            1451                           !---------------------------------------------------------------
            1452                           !             NOTES ON THE PBLH FORMULATION
            1453                           !
            1454                           !The 1.5-theta-increase method defines PBL heights as the level at
            1455                           !which the potential temperature first exceeds the minimum potential
            1456                           !temperature within the boundary layer by 1.5 K. When applied to
            1457                           !observed temperatures, this method has been shown to produce PBL-
            1458                           !height estimates that are unbiased relative to profiler-based
            1459                           !estimates (Nielsen-Gammon et al. 2008). However, their study did not
            1460                           !include LLJs. Banta and Pichugina (2008) show that a TKE-based
            1461                           !threshold is a good estimate of the PBL height in LLJs. Therefore,
            1462                           !a hybrid definition is implemented that uses both methods, weighting
            1463                           !the TKE-method more during stable conditions (PBLH < 400 m).
            1464                           !A variable tke threshold (TKEeps) is used since no hard-wired
            1465                           !value could be found to work best in all conditions.
            1466                           !---------------------------------------------------------------
            1467                     
            1468                           INTEGER,INTENT(IN) :: KTS,KTE
            1469                           REAL, INTENT(OUT) :: zi
            1470                           REAL, INTENT(IN) :: landsea
            1471                           REAL, DIMENSION(KTS:KTE), INTENT(IN) :: thetav1D, qke1D, dz1D
            1472                           REAL, DIMENSION(KTS:KTE+1), INTENT(IN) :: zw1D
            1473                           !LOCAL VARS
            1474                           REAL ::  PBLH_TKE,qtke,qtkem1,wt,maxqke,TKEeps,minthv
            1475                           REAL :: delt_thv   !delta theta-v; dependent on land/sea point
            1476                           REAL, PARAMETER :: sbl_lim  = 200. !Theta-v PBL lower limit of trust (m).
            1477                           REAL, PARAMETER :: sbl_damp = 400. !Damping range for averaging with TKE-based PBLH (m).
            1478                           INTEGER :: I,J,K,kthv,ktke
            1479                     
            1480                           !FIND MAX TKE AND MIN THETAV IN THE LOWEST 500 M
            1481                           k = kts+1
            1482                           kthv = 1
            1483                           ktke = 1
            1484                           maxqke = 0.
            1485                           minthv = 9.E9
            1486                     
            1487     1                     DO WHILE (zw1D(k) .LE. 500.)
            1488     1                       qtke  =MAX(Qke1D(k),0.)   ! maximum QKE
            1489     2                        IF (maxqke < qtke) then
            1490     2                           maxqke = qtke
            1491     2                           ktke = k
            1492     2                        ENDIF
            1493     2                        IF (minthv > thetav1D(k)) then
            1494     2                            minthv = thetav1D(k)
            1495     2                            kthv = k
            1496     2                        ENDIF
            1497     1                        k = k+1
            1498     1                     ENDDO
            1499                           !TKEeps = maxtke/20. = maxqke/40.
            1500                           TKEeps = maxqke/40.
            1501                           TKEeps = MAX(TKEeps,0.025)
            1502                           TKEeps = MIN(TKEeps,0.25)
            1503                     
            1504                           !FIND THETAV-BASED PBLH (BEST FOR DAYTIME).
            1505                           zi=0.
            1506                           k = kthv+1
            1507     1                     IF((landsea-1.5).GE.0)THEN
            1508     1                     ! WATER
            1509     1                         delt_thv = 0.75
            1510     1                     ELSE
            1511     1                     ! LAND
            1512     1                         delt_thv = 1.5
            1513     1                     ENDIF
            1514                     
            1515                           zi=0.
            1516                           k = kthv+1
            1517     1                     DO WHILE (zi .EQ. 0.)
            1518     2                        IF (thetav1D(k) .GE. (minthv + delt_thv))THEN
            1519     2                           zi = zw1D(k) - dz1D(k-1)* &
            1520     2                             & MIN((thetav1D(k)-(minthv + delt_thv))/MAX(thetav1D(k)-thetav1D(k-1),1E-6),1.0)
            1521     2                       ENDIF
            1522     1                       k = k+1
            1523     1                        IF (k .EQ. kte-1) zi = zw1D(kts+1) !EXIT SAFEGUARD
            1524     1                     ENDDO
            1525                     
            1526                           !print*,"IN GET_PBLH:",thsfc,zi
            1527                           !FOR STABLE BOUNDARY LAYERS, USE TKE METHOD TO COMPLEMENT THE
            1528                           !THETAV-BASED DEFINITION (WHEN THE THETA-V BASED PBLH IS BELOW ~0.5 KM).
            1529                           !THE TANH WEIGHTING FUNCTION WILL MAKE THE TKE-BASED DEFINITION NEGLIGIBLE
            1530                           !WHEN THE THETA-V-BASED DEFINITION IS ABOVE ~1 KM.
            1531                           !FIND TKE-BASED PBLH (BEST FOR NOCTURNAL/STABLE CONDITIONS).
            1532                     
            1533                           PBLH_TKE=0.
            1534                           k = ktke+1
            1535     1                    DO WHILE (PBLH_TKE .EQ. 0.)
            1536     1                       !QKE CAN BE NEGATIVE (IF CKmod == 0)... MAKE TKE NON-NEGATIVE.
            1537     1                        qtke  =MAX(Qke1D(k)/2.,0.)      ! maximum TKE
            1538     1                        qtkem1=MAX(Qke1D(k-1)/2.,0.)
            1539     2                        IF (qtke .LE. TKEeps) THEN
            1540     2                              PBLH_TKE = zw1D(k) - dz1D(k-1)* &
            1541     2                              & MIN((TKEeps-qtke)/MAX(qtkem1-qtke, 1E-6), 1.0)
            1542     2                            !IN CASE OF NEAR ZERO TKE, SET PBLH = LOWEST LEVEL.
            1543     2                            PBLH_TKE = MAX(PBLH_TKE,zw1D(kts+1))
            1544     2                            !print *,"PBLH_TKE:",i,j,PBLH_TKE, Qke1D(k)/2., zw1D(kts+1)
            1545     2                        ENDIF
            1546     1                        k = k+1
            1547     1                        IF (k .EQ. kte-1) PBLH_TKE = zw1D(kts+1) !EXIT SAFEGUARD
            1548     1                     ENDDO
            1549                     
            1550                         !BLEND THE TWO PBLH TYPES HERE:
            1551                     
            1552                           wt=.5*TANH((zi - sbl_lim)/sbl_damp) + .5
            1553                           zi=PBLH_TKE*(1.-wt) + zi*wt
            1554                     
            1555                        END SUBROUTINE GET_PBLH

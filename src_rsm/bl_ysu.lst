             981     3   p    s               dsdzq = tem1*(-qfxpbl(i)*zfacent(i,k)/xkzq(i,k))
             982     3   p    s               f3(i,k,1) = f3(i,k,1)+dtodsd*dsdzq
             983     3   p    s               f3(i,k+1,1) = qx(i,k+1)-dtodsu*dsdzq
             984     3   p    s             elseif(pblflg(i).and.k.ge.kpbl(i).and.entfac(i,k).lt.4.6) then
             985     3   p    s               xkzq(i,k) = -we(i)*dza(i,kpbl(i))*exp(-entfac(i,k))
             986     3   p    s               xkzq(i,k) = sqrt(xkzq(i,k)*xkzhl(i,k))
             987     3   p    s               xkzq(i,k) = max(xkzq(i,k),xkzoh(i,k))
             988     3   p    s               xkzq(i,k) = min(xkzq(i,k),xkzmax)

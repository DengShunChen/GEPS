             813     2   p    v           do i = 1,im
             814     3   p    v             if(k.ge.kpbl(i)) then
             815     3   p    v               ss = ((ux(i,k+1)-ux(i,k))*(ux(i,k+1)-ux(i,k))                         &
             816     3                             +(vx(i,k+1)-vx(i,k))*(vx(i,k+1)-vx(i,k)))                        &
             817     3                             /(dza(i,k+1)*dza(i,k+1))+1.e-9
             818     3   p    v               govrthv = g/(0.5*(thvx(i,k+1)+thvx(i,k)))
             819     3   p    v               ri = govrthv*(thvx(i,k+1)-thvx(i,k))/(ss*dza(i,k+1))
             820     3               !         if(imvdif.eq.1.and.ndiff.ge.3)then
             821     4   p    v               if(imvdif.eq.1.and.ndiff.ge.2)then
             822     5   p    v                 if((qx(i,ktrace2+k)+qx(i,ktrace3+k)).gt.0.01e-3.and.(qx(i           &
             823     5                            ,ktrace2+k+1)+qx(i,ktrace3+k+1)).gt.0.01e-3)then
             824     5               !      in cloud
             825     5   p    v                   qmean = 0.5*(qx(i,k)+qx(i,k+1))
             826     5   p    v                   tmean = 0.5*(tx(i,k)+tx(i,k+1))

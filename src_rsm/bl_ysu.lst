             754     2   p    v           do i = 1,im
             755     3   p    v             if(pblflg(i).and.k.ge.kpbl(i))then
             756     3   p    v               entfac(i,k) = ((zq(i,k+1)-hpbl(i))/delta(i))**2.
             757     3   p    v             else
             758     3   p    v               entfac(i,k) = 1.e30
             759     3   p    v             endif

             828     5   p    v                   chi   = xlv*xlv*qmean/cp/rv/tmean/tmean
             829     5   p    v                   ri    = (1.+alph)*(ri-g*g/ss/tmean/cp*((chi-alph)/(1.+chi)))
             830     5   p    v                 endif
             831     4   p    v               endif
             832     3   p    v               zk = karman*zq(i,k+1)
             833     3   p    v               rlamdz = min(max(0.1*dza(i,k+1),rlam),300.)
             834     3   p    v               rlamdz = min(dza(i,k+1),rlamdz)
             835     3   p    v               rl2 = (zk*rlamdz/(rlamdz+zk))**2
             836     3   p    v               dk = rl2*sqrt(ss)

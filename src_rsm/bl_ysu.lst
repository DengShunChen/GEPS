            1157     3   p    v               xkzm(i,k) = prpbl(i)*xkzh(i,k)
            1158     3   p    v               xkzm(i,k) = sqrt(xkzm(i,k)*xkzml(i,k))
            1159     3   p    v               xkzm(i,k) = max(xkzm(i,k),xkzom(i,k))
            1160     3   p    v               xkzm(i,k) = min(xkzm(i,k),xkzmax)
            1161     3   p    v              f1(i,k+1) = ux(i,k+1)

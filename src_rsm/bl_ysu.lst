            1085     2  pp    v            do k= 1, km-1
            1086     2   p    v              shear_ysu(i,k)=xkzm(i,k)*((-hgamu(i)/hpbl(i)+(ux(i,k+1)-ux(i,k))/dza(i,k+1))*(ux(i,k+1)-ux(i,k))/dza(i,k+1) &
            1087     2                       + (-hgamv(i)/hpbl(i)+(vx(i,k+1)-vx(i,k))/dza(i,k+1))*(vx(i,k+1)-vx(i,k))/dza(i,k+1))
            1088     2   p    v               buoy_ysu(i,k)=xkzh(i,k)*g*(1.0/thx(i,k))*(-hgamt(i)/hpbl(i)+(thx(i,k+1)-thx(i,k))/dza(i,k+1))
            1089     2               
            1090     2   p    v             zk = karman*zq(i,k+1)
            1091     2                !over pbl
            1092     3   p    v             if (k.ge.kpbl(i)) then
            1093     3   p    v              rlamdz = min(max(0.1*dza(i,k+1),rlam),300.)
            1094     3   p    v              rlamdz = min(dza(i,k+1),rlamdz)
            1095     3   p    v             else
            1096     3                !in pbl
            1097     3   p    v              rlamdz = 150.0
            1098     3   p    v             endif
            1099     2   p    v             el_ysu(i,k) = zk*rlamdz/(rlamdz+zk)
            1100     2   p    v             tke_ysu(i,k)=16.6*el_ysu(i,k)*(shear_ysu(i,k)-buoy_ysu(i,k))
            1101     2                !q2 when q3 positive
            1102     3   p    v             if(tke_ysu(i,k).le.0) then
            1103     3   p    v              tke_ysu(i,k)=0.0
            1104     3   p    v             else
            1105     3   p    v              tke_ysu(i,k)=(tke_ysu(i,k))**0.66
            1106     3   p    v             endif
            1107     2   p    v            enddo
            1108     1                !Hybrid pblh of MYNN

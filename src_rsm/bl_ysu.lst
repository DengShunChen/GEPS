              21                     !-------------------------------------------------------------------------------
              22                         use rank
              23                         use const, only: RTYPE
              24                     
              25                        implicit none
              26                     !-------------------------------------------------------------------------------
              27                     !
              28                     !     this code is a revised vertical diffusion package ("ysupbl")
              29                     !     with a nonlocal turbulent mixing in the pbl after "mrfpbl".
              30                     !     the ysupbl (hong et al. 2006) is based on the study of noh
              31                     !     et al.(2003) and accumulated realism of the behavior of the
              32                     !     troen and mahrt (1986) concept implemented by hong and pan(1996).
              33                     !     the major ingredient of the ysupbl is the inclusion of an explicit
              34                     !     treatment of the entrainment processes at the entrainment layer.
              35                     !     this routine uses an implicit approach for vertical flux
              36                     !     divergence and does not require "miter" timesteps.
              37                     !     it includes vertical diffusion in the stable atmosphere
              38                     !     and moist vertical diffusion in clouds.
              39                     !
              40                     !     mrfpbl:
              41                     !     coded by song-you hong (ncep), implemented by jimy dudhia (ncar)
              42                     !              fall 1996
              43                     !
              44                     !     ysupbl:
              45                     !     coded by song-you hong (yonsei university) and implemented by
              46                     !              song-you hong (yonsei university) and jimy dudhia (ncar)
              47                     !              summer 2002
              48                     !
              49                     !     further modifications :
              50                     !              an enhanced stable layer mixing, april 2008
              51                     !              ==> increase pbl height when sfc is stable (hong 2010)
              52                     !              pressure-level diffusion, april 2009
              53                     !              ==> negligible differences
              54                     !              implicit forcing for momentum with clean up, july 2009
              55                     !              ==> prevents model blowup when sfc layer is too low
              56                     !              incresea of lamda, maximum (30, 0.1 x del z) feb 2010
              57                     !              ==> prevents model blowup when delz is extremely large
              58                     !              revised prandtl number at surface, peggy lemone, feb 2010
              59                     !              ==> increase kh, decrease mixing due to counter-gradient term
              60                     !              revised thermal, shin et al. mon. wea. rev. , songyou hong, aug 2011
              61                     !              ==> reduce the thermal strength when z1 < 0.1 h
              62                     !              revised prandtl number for free convection, dudhia, mar 2012
              63                     !              ==> pr0 = 1 + bke (=0.272) when neutral, kh is reduced
              64                     !              minimum kzo = 0.01, lo = min (30m,delz), hong, mar 2012
              65                     !              ==> weaker mixing when stable, and les resolution in vertical
              66                     !              gz1oz0 is removed, and psim psih are ln(z1/z0)-psim,h, hong, mar 2012
              67                     !              ==> consider thermal z0 when differs from mechanical z0
              68                     !              a bug fix in wscale computation in stable bl, sukanta basu, jun 2012
              69                     !              ==> wscale becomes small with height, and less mixing in stable bl
              70                     !              revision in background diffusion (kzo), jan 2016
              71                     !              ==> kzo = 0.1 for momentum and = 0.01 for mass to account for
              72                     !                  internal wave mixing of large et al. (1994), songyou hong, feb 2016
              73                     !              ==> alleviate superious excessive mixing when delz is large
              74                     !
              75                     !     references:
              76                     !
              77                     !        hong (2010) quart. j. roy. met. soc
              78                     !        hong, noh, and dudhia (2006), mon. wea. rev.
              79                     !        hong and pan (1996), mon. wea. rev.
              80                     !        noh, chun, hong, and raasch (2003), boundary layer met.
              81                     !        troen and mahrt (1986), boundary layer met.
              82                     !
              83                     !-------------------------------------------------------------------------------
              84                     !
              85                        real,parameter    ::  xkzminm = 0.1,xkzminh = 0.01
              86                        real,parameter    ::  xkzmin = 0.01,xkzmax = 1000.,rimin = -100.
              87                        real,parameter    ::  rlam = 30.,prmin = 0.25,prmax = 4.

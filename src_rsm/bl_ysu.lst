             800     3   p    v               xkzh(i,k) = xkzh(i,k)+xkzoh(i,k)
             801     3   p    v               xkzq(i,k) = xkzq(i,k)+xkzoh(i,k)
             802     3   p    v               xkzm(i,k) = min(xkzm(i,k),xkzmax)
             803     3   p    v               xkzh(i,k) = min(xkzh(i,k),xkzmax)
             804     3   p    v               xkzq(i,k) = min(xkzq(i,k),xkzmax)
             805     3   p    v             endif

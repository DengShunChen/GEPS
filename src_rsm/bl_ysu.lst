            1150     3   p    v               dsdzu     = tem1*(-hgamu(i)/hpbl(i)-ufxpbl(i)*zfacent(i,k)/xkzm(i,k))
            1151     3   p    v               dsdzv     = tem1*(-hgamv(i)/hpbl(i)-vfxpbl(i)*zfacent(i,k)/xkzm(i,k))
            1152     3   p    v               f1(i,k)   = f1(i,k)+dtodsd*dsdzu

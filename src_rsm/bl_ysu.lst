             780     4   p    v                 prfac2 = 0.
             781     4   p    v                 prnumfac = 0.
             782     4   p    v                 phim8z = 1.+aphi5*zol1(i)*zq(i,k+1)/zl1(i)
             783     4   p    v                 wscalek(i,k) = ust(i)/phim8z
             784     4   p    v                 wscalek(i,k) = max(wscalek(i,k),0.001)
             785     4   p    v               endif
             786     3   p    v               prnum0 = (phih(i)/phim(i)+prfac)
             787     3   p    v               prnum0 = max(min(prnum0,prmax),prmin)
             788     3   p    v                 xkzm(i,k) = wscalek(i,k) *karman*    zq(i,k+1)      *    zfac(i,k)**pfac+ &
             789     3                                      wscalek2(i,k)*karman*(hpbl(i)-zq(i,k+1))*(1-zfac(i,k))**pfac
             790     3                        !Do not include xkzm at kpbl-1 since it changes entrainment

 External subroutine subprogram "smth9"
  (inc)(line-no.)(nest)(optimize)
               1                     !-----------------------------------------------------------
               2                     ! 9-point smoother
               3                     !-----------------------------------------------------------
               4                           subroutine smth9(im,jm,data,sdata,ismth)
               5                           use const, only: RTYPE
               6                     !
               7                           implicit   none
               8                           integer                   :: im,jm,ismth
               9                           real(kind=RTYPE),dimension(im,jm) :: data,sdata
              10                     
              11                           integer                   ::i,j,ip1,im1,jp1,jm1
              12                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
              13     1  pp                 do j=1,jm
              14     1   p                   jp1=j+1
              15     1   p                   jm1=j-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sdata
                                   <<< Loop-information  End >>>
              16     2   p    s            do i=1,im
              17     2   p    v              ip1=i+1
              18     2   p    v              im1=i-1
              19     2   p    s              if(ip1 > im)ip1=ip1-im
              20     2   p    m              if(im1 < 1 )im1=im1+im
              21     2               
              22     3   p    m              if(j==1  .or. j==jm)then
              23     3               ! boundary by 3-point smoothing
              24     4   p    s                if(ismth==1)then
              25     4   p    s                 sdata(i,j)=data(i,j)+(data(ip1,j)-2.*data(i,j)+data(im1,j))/4.
              26     4   p    s                else
              27     4   p    s                 sdata(i,j)=data(i,j)
              28     4   p                     endif
              29     3   p    s              else
              30     3               ! by 9-point smoothing
              31     3   p    s               sdata(i,j)=data(i,j)+(data(i,jp1)+data(i,jm1)+data(ip1,j)      &
              32     3                                  +data(im1,j)-4.*data(i,j))/8.+(data(ip1,jp1)         &
              33     3                                  +data(ip1,jm1)+data(im1,jp1)+data(im1,jm1)           &
              34     3                                  -4.*data(i,j))/16.
              35     3   p    v              endif
              36     2   p    v            enddo
              37     1   p                 enddo
              38                           return
              39                           end


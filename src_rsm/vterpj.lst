  (inc)(line-no.)(nest)(optimize)
               1                           subroutine vterpj (nx,lmaxp,lev,yr,f,yout,dout,tensy)
               2                     !
               3                     !  a bicubic spline interpolator to interpolate from a grid
               4                     !  with constant i (first dimension) grid spacing and variable
               5                     !  j (second dimension) grid spacing t0 a grid with
               6                     !  variable grid spacing. all grids are assumed to have point
               7                     !  (i,1) in the lower left corner with i increasing to the right
               8                     !  and j increasing upward.
               9                     !
              10                     ! **** input ****
              11                     !
              12                     !  nx: no. of points in e-w direction of input arrays
              13                     !  lmaxp: no. of levels in input arrays
              14                     !  lev: no. of levels in output arrays
              15                     !  yr: independent interpolation variable for input grid
              16                     !  f: dependent variable for input grid
              17                     !  yout: independent interpolation variable for output grid
              18                     !  tensy: cubic spline tension factor.
              19                     !
              20                     ! **** output ****
              21                     !
              22                     !  dout: dependent variable on output grid
              23                     !
              24                           use const, only: RTYPE
              25                     !
              26                           implicit none
              27                     
              28                           integer   nx,lmaxp,lev
              29                     
              30                           real      tp1(nx*lev*4),tensy(lmaxp),yout(nx*lev),yr(nx,lmaxp)
              31                     !
              32                           real(kind=RTYPE) fxx(nx,lmaxp),fyy(nx,lmaxp),pjy(nx*lev*4)  &
              33                                   , f(nx,lmaxp),dout(nx*lev)
              34                     
              35                           integer   ipt(nx*lev)
              36                     
              37                           integer  jym2, nxjym2,ll,i,k,i1,i2,i3,mn
              38                     
              39                     !
              40                     !          compute ipt and pjy
              41                     !
              42                           jym2  = lmaxp-2
              43                           nxjym2= nx*jym2
              44                           mn    = nx*lev
              45                     !
              46                           call setupv (yr,yout,mn,nx,lmaxp,pjy,ipt,tp1)
              47                     !
              48                     !          compute fyy
              49                     !
              50                           ll= nxjym2+nx
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      yr, fxx
                                   <<< Loop-information  End >>>
              51     1  pp   2v            do 110 i=1,ll
              52     1   p   2v            fxx(i,2)= yr(i,2)-yr(i,1)
              53     1   p   2v        110 continue
              54                     !
              55                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 471
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      f, fxx, fyy
                                   <<< Loop-information  End >>>
              56     1  pp    v            do 210 i=1,nxjym2
              57     1   p    v            fyy(i,2)= (fxx(i,3)*(f(i,1)-f(i,2))+fxx(i,2)*(f(i,3) &
              58     1                               -f(i,2)))/(fxx(i,3)*fxx(i,3)*fxx(i,2))
              59     1   p    v        210 continue
              60                     
              61                     !ocl serial
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.29, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fxx
                                   <<< Loop-information  End >>>
              62     1       2v            do i=1,nxjym2
              63     1       2v               fxx(i,2)= fxx(i,2)/fxx(i,3)
              64     1       2v            enddo
              65                     !
              66                           call trdivv (nx,jym2,fxx(1,2),fyy(1,2))
              67                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fyy
                                   <<< Loop-information  End >>>
              68     1  pp   2v            do 100 i=1,nx
              69     1   p   2v            fyy(i,1)= 0.0
              70     1   p   2v            fyy(i,lmaxp)= 0.0
              71     1   p   2v        100 continue
              72                     !
              73                     !  apply tension
              74                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fyy
                                   <<< Loop-information  End >>>
              75     1  pp                 do 5 k=1,lmaxp
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 320, MVE: 11, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fyy
                                   <<< Loop-information  End >>>
              76     2   p   2v            do 5 i=1,nx
              77     2   p   2v            fyy(i,k)= fyy(i,k)*tensy(k)
              78     1   p   2v          5 continue
              79                     !
              80                           call gathv (mn,nx,lmaxp,ipt,fyy,f,tp1)
              81                     !
              82                           i1= mn
              83                           i2= mn*2
              84                           i3= mn*3
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 267
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.80, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tp1, pjy, dout
                                   <<< Loop-information  End >>>
              85     1  pp    v            do 130 i=1,mn
              86     1   p    v            dout(i)= tp1(i)*pjy(i)+tp1(i+i1)*pjy(i+i1)+tp1(i+i2)*pjy(i+i2) &
              87     1                            + tp1(i+i3)*pjy(i+i3)
              88     1   p    v        130 continue
              89                           return
              90                           end


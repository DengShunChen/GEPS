 External subroutine subprogram "srms"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine srms (im,lm,jm,jm_max,rmsx,x)
               2                     !
               3                     !  routine to compute global mean rms of a variable on each model
               4                     !  level.
               5                     !
               6                     ! **** input ****
               7                     !
               8                     !  im: no. of points in e-w direction of input grid x
               9                     !  lm: no. of vertical levels of x
              10                     !  jm: no. of points in n-s direction of input grid x
              11                     !  x: 3-d input grid
              12                     !
              13                     ! **** output ****
              14                     !
              15                     !  rmsx: array of rms values
              16                     !
              17                           use mpe
              18                           use index
              19                     
              20                           implicit  none
              21                           integer   im,lm,jm,jm_max
              22                           real      rmsx(lm),x(im,lm,jm_max)
              23                           integer   i,j,k,jj
              24                           real      tem
              25                     
              26                           tem= 1.0/(im*jm)
              27                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

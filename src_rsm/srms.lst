                                   <<<      rmsx
                                   <<< Loop-information  End >>>
              28     1  pp   4v            do 1 k=1,lm
              29     1   p   4v            rmsx(k)= 0.0
              30     1   p   4v          1 continue
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      x
                                   <<< Loop-information  End >>>
              31     1   p                 do 2 jj =1, jlistnum
              32     1   p                 j=jlist1(jj)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
              33     2  pp                 do 2 k=1,lm
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.71, ITR: 256, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      x
                                   <<< Loop-information  End >>>
              34     3   p   8v            do 2 i=1,im
              35     3   p   8v            rmsx(k)= rmsx(k)+x(i,k,jj)*x(i,k,jj)
              36     1   p   8v          2 continue
              37                     !
              38                           call mpe_global_sum(rmsx,lm,mpe_double)
              39                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

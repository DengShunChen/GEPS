                                   <<<      rmsx
                                   <<< Loop-information  End >>>
              40     1  pp   2v            do 3 k=1,lm
              41     1   p   2v            rmsx(k)= sqrt(rmsx(k)*tem)
              42     1   p   2v          3 continue
              43                     !
              44                           return

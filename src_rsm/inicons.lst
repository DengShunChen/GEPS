               1                           subroutine inicons(rad,omega,eigval,lev,jtrun,jtmax, &
               2                                              nw,a,b,c,h,nnmivm)
               3                     !
               4                     !  purpose:  define constants and calculate the coefficients for
               5                     !            initialization modual
               6                     !----------------------------------------------------------------------
               7                     !  **** input ****
               8                     !
               9                     !  rad          : radius of earth
              10                     !  omega        : angular velocity of earth
              11                     !  eigval       : vertical equivalent depth array
              12                     !  lev          : number of vertical levels
              13                     !  jtrun        : zonal wave number truncation limit
              14                     !
              15                     !  **** output ****
              16                     !
              17                     !  nw           : total wavenumber index array
              18                     !  a            : coefficient array of coefficient matrix
              19                     !  b            : coefficient array of coefficient matrix
              20                     !  c            : coefficient array of coefficient matrix
              21                     !  h            : coefficient array for (non)dimensionlize variables
              22                     !
              23                     !  modify to f90 bt C-H Lee and sort by River Chen in 2015
              24                     !------------------------------------------------------------------------
              25                     !
              26                           use index
              27                           use const, only : RTYPE
              28                     
              29                           implicit none
              30                           integer  lev,jtrun,jtmax,nw(jtrun,jtmax),nnmivm
              31                     !byl      real     a(jtrun,jtrun,lev),b(jtrun,jtrun,lev),c(jtrun,jtrun,lev)
              32                           real     a(jtrun,jtrun,nnmivm),b(jtrun,jtrun,nnmivm),c(jtrun,jtrun,nnmivm)
              33                     !byl      real     eigval(lev),h(jtrun,jtmax,lev)
              34                           real     h(jtrun,jtmax,nnmivm)
              35                           real(kind=RTYPE) eigval(lev)
              36                     
              37                           integer  k,l,m,n,m1,mf,mm,mn,nnp1
              38                           real     omega,omega2,omga2r2,rad,rad2,tem,epxn
              39                     
              40                           rad2=rad*rad
              41                           omega2=omega*omega
              42                           omga2r2=omega2*rad2
              43                     !
              44                     !  compute total wavenumber index array
              45                     !
              46                           mn=0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      nw
                                   <<< Loop-information  End >>>
              47     1  pp                 do m=1,mlistnum
              48     1   p                   mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 256, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      nw
                                   <<< Loop-information  End >>>
              49     2   p   2v              do n=mf,jtrun
              50     2   p   2v                nw(n,m)=n*(n-1)
              51     2   p   2v              enddo
              52     1   p                 enddo
              53                     !
              54                     !  compute (non)dimensionlize array
              55                     !
              56                     !CWB2014 fixed the undefined value h in vartran loop
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      h
                                   <<< Loop-information  End >>>
              57        pp   4v            h=0.
              58                     !byl      do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              59     1  pp                 do k=1,nnmivm
              60     1   p                   tem=eigval(k)/omga2r2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      nw, h
                                   <<< Loop-information  End >>>
              61     2   p                   do m=1,mlistnum
              62     2   p                     mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.28, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      nw, h
                                   <<< Loop-information  End >>>
              63     3   p   2v                do n=mf,jtrun
              64     3   p   2v                  if (n.ne.1) h(n,m,k)=(tem/nw(n,m))**0.5
              65     3   p   2v                enddo
              66     2   p                   enddo
              67     1   p                 enddo
              68                     !
              69                     !  compute coefficients array of coefficient matrix
              70                     !
              71                     !byl      do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              72     1  pp                 do k=1,nnmivm
              73     1   p                   a(1,1,k)=0.
              74     1   p                   b(1,1,k)=0.
              75     1   p                   c(1,1,k)=0.
              76     2   p                   do m=1,jtrun
              77     2   p                     m1=m-1
              78     2   p                     mm=m
              79     2   p                     if(m.eq.1)mm=2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
              80     3   p    v                do l=mm,jtrun
              81     3   p    v                  n=l-1
              82     3   p    v                  nnp1=n*(n+1)
              83     3   p    v                  epxn=((n*n-m1*m1)/(4.*n*n-1))**0.5
              84     3   p    v                  c(m,l,k)=2.*m1/nnp1
              85     3   p    v                  b(m,l,k)=(eigval(k)*nnp1/omga2r2)**0.5
              86     3   p    v                  a(m,l,k)=-2.*epxn/n*((n+1)*(n-1))**0.5
              87     3   p    v                enddo
              88     2   p                   enddo
              89     1   p                 enddo
              90                     !
              91                           return
              92                           end


            1099     4   p    v                  if(k.gt.kb(i).and.k.le.ktcon(i)) then
            1100     4   p    v                    shear= sqrt((uo(i,k)-uo(i,k-1)) ** 2  &
            1101     4                                       + (vo(i,k)-vo(i,k-1)) ** 2)
            1102     4   p    v                    vshear(i) = vshear(i) + shear
            1103     4   p    v                  endif

                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ktcon, cnvflg, qlko_ktcon
                                   <<< Loop-information  End >>>
            1071     2  pp    v            do i = 1, im
            1072     3   p    v              if(cnvflg(i)) then
            1073     3   p    v                k = ktcon(i) - 1
            1074     3   p    v                gamma = el2orc * qeso(i,k) / (to(i,k)**2)
            1075     3   p    v                qrch = qeso(i,k) &
            1076     3                              + gamma * dbyo(i,k) / (hvap * (1. + gamma))
            1077     3   p    v                dq = qcko(i,k) - qrch
            1078     3               !
            1079     3               !  check if there is excess moisture to release latent heat
            1080     3               !
            1081     4   p    v                if(dq.gt.0.) then
            1082     4   p    v                  qlko_ktcon(i) = dq
            1083     4   p    v                  qcko(i,k) = qrch
            1084     4   p    v                endif
            1085     3   p    v              endif
            1086     2   p    v            enddo
            1087     1                     endif
            1088                     !
            1089                     !--- compute precipitation efficiency in terms of windshear
            1090                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231

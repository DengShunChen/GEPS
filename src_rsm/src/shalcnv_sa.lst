            1180     1  pp    s            do i = 1, im
            1181     2   p    m              if(cnvflg(i)) then
            1182     2   p    s                indx = ktcon(i)
            1183     2   p    s                dp = 1000. * del(i,indx)
            1184     2   p    s                dv1h = heo(i,indx-1)
            1185     2   p    s                dellah(i,indx) = eta(i,indx-1) * (hcko(i,indx-1) - dv1h) * g / dp
            1186     2   p    s                dv1q = qo(i,indx-1)
            1187     2   p    s                dellaq(i,indx) = eta(i,indx-1) * (qcko(i,indx-1) - dv1q) * g / dp
            1188     2   p    s                dv1u = uo(i,indx-1)
            1189     2   p    s                dellau(i,indx) = eta(i,indx-1) * (ucko(i,indx-1) - dv1u) * g / dp
            1190     2   p    s                dv1v = vo(i,indx-1)
            1191     2   p    s                dellav(i,indx) = eta(i,indx-1) * (vcko(i,indx-1) - dv1v) * g / dp
            1192     2               !
            1193     2               !  cloud water
            1194     2               !
            1195     2   p    s                dellal(i,indx) = eta(i,indx-1) * qlko_ktcon(i) * g / dp
            1196     2   p    v              endif
            1197     1   p    v            enddo
            1198                     !
            1199                     !
            1200                     !  compute convective turn-over time
            1201                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 217
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
            1202     1  pp    s            do i= 1, im
            1203     2   p    m              if(cnvflg(i)) then
            1204     2   p    s                tem = zi(i,ktcon1(i)) - zi(i,kbcon1(i))
            1205     2   p    s                dtconv(i) = tem / wc(i)
            1206     2   p    s                tfac = 1. + gdx(i) / 75000.
            1207     2   p    s                dtconv(i) = tfac * dtconv(i)
            1208     2   p    s                dtconv(i) = max(dtconv(i),dtmin)
            1209     2   p    s                dtconv(i) = max(dtconv(i),dt2)
            1210     2   p    s                dtconv(i) = min(dtconv(i),dtmax)
            1211     2   p    v              endif
            1212     1   p    v            enddo

                                   <<< Loop-information  End >>>
            1223     2  pp    v              do i = 1, im
            1224     3   p    v                if(cnvflg(i)) then
            1225     4   p    v                  if(k .ge. kbcon1(i) .and. k .lt. ktcon1(i)) then
            1226     4   p    v                    dz = zi(i,k) - zi(i,k-1)
            1227     4   p    v                    tem = sqrt(u1(i,k)*u1(i,k)+v1(i,k)*v1(i,k))
            1228     4   p    v                    umean(i) = umean(i) + tem * dz
            1229     4   p    v                    sumx(i) = sumx(i) + dz
            1230     4   p    v                  endif
            1231     3   p    v                endif
            1232     2   p    v              enddo
            1233     1                     enddo

            1124     2   p    v              do i = 1, im
            1125     3   p    v                if(cnvflg(i) .and. k .le. kmax(i)) then
            1126     3   p    v                  dellah(i,k) = 0.
            1127     3   p    v                  dellaq(i,k) = 0.
            1128     3   p    v                  dellau(i,k) = 0.

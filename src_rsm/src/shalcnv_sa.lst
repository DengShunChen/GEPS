            1137     2   p    v              do i = 1, im
            1138     3   p    v                if (cnvflg(i)) then
            1139     4   p    v                  if(k.gt.kb(i).and.k.lt.ktcon(i)) then
            1140     4   p    v                    dp = 1000. * del(i,k)
            1141     4   p    v                    dz = zi(i,k) - zi(i,k-1)
            1142     4               !
            1143     4   p    v                    dv1h = heo(i,k)
            1144     4   p    v                    dv2h = .5 * (heo(i,k) + heo(i,k-1))
            1145     4   p    v                    dv3h = heo(i,k-1)
            1146     4   p    v                    dv1q = qo(i,k)
            1147     4   p    v                    dv2q = .5 * (qo(i,k) + qo(i,k-1))
            1148     4   p    v                    dv3q = qo(i,k-1)
            1149     4               !
            1150     4   p    v                    tem  = 0.5 * (xlamue(i,k)+xlamue(i,k-1))
            1151     4   p    v                    tem1 = xlamud(i)
            1152     4               !
            1153     4   p    v                    dellah(i,k) = dellah(i,k) +                               &
            1154     4                          ( eta(i,k)*dv1h - eta(i,k-1)*dv3h                            &
            1155     4                         -  tem*eta(i,k-1)*dv2h*dz                                     &
            1156     4                         +  tem1*eta(i,k-1)*.5*(hcko(i,k)+hcko(i,k-1))*dz              &
            1157     4                              ) *g/dp
            1158     4               !
            1159     4   p    v                    dellaq(i,k) = dellaq(i,k) +                               &
            1160     4                          ( eta(i,k)*dv1q - eta(i,k-1)*dv3q                            &
            1161     4                         -  tem*eta(i,k-1)*dv2q*dz                                     &
            1162     4                         +  tem1*eta(i,k-1)*.5*(qcko(i,k)+qcko(i,k-1))*dz              &
            1163     4                              ) *g/dp
            1164     4               !
            1165     4   p    v                    tem1=eta(i,k)*(uo(i,k)-ucko(i,k))
            1166     4   p    v                    tem2=eta(i,k-1)*(uo(i,k-1)-ucko(i,k-1))
            1167     4   p    v                    dellau(i,k) = dellau(i,k) + (tem1-tem2) * g/dp
            1168     4               !
            1169     4   p    v                    tem1=eta(i,k)*(vo(i,k)-vcko(i,k))
            1170     4   p    v                    tem2=eta(i,k-1)*(vo(i,k-1)-vcko(i,k-1))
            1171     4   p    v                    dellav(i,k) = dellav(i,k) + (tem1-tem2) * g/dp
            1172     4               !
            1173     4   p    v                  endif
            1174     3   p    v                endif
            1175     2   p    v              enddo
            1176     1   p                 enddo
            1177                     !
            1178                     !------- cloud top
            1179                     !

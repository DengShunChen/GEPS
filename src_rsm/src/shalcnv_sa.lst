                                   <<<      cnvflg, umean, sumx, gdx, tauadv
                                   <<< Loop-information  End >>>
            1234     1  pp    v            do i= 1, im
            1235     2   p    v              if(cnvflg(i)) then
            1236     2   p    v                 umean(i) = umean(i) / sumx(i)
            1237     2   p    v                 umean(i) = max(umean(i), 1.)
            1238     2   p    v                 tauadv(i) = gdx(i) / umean(i)
            1239     2   p    v              endif
            1240     1   p    v            enddo
            1241                     !
            1242                     !  compute cloud base mass flux as a function of the mean
            1243                     !     updraft velcoity
            1244                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 281
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
            1245     1  pp    s            do i= 1, im
            1246     2   p    m              if(cnvflg(i)) then
            1247     2   p    s                k = kbcon(i)
            1248     2   p    s                rho = po(i,k)*100. / (rd*to(i,k))
            1249     2   p    s                tfac = tauadv(i) / dtconv(i)
            1250     2   p    s                tfac = min(tfac, 1.)
            1251     2   p    s                xmb(i) = tfac*betaw*rho*wc(i)
            1252     2   p    v              endif
            1253     1   p    v            enddo
            1254                     !
            1255                     !  mass flux at cloud base for shallow convection
            1256                     !  (Grant, 2001)
            1257                     !
            1258                     !!      do i= 1, im
            1259                     !!        if(cnvflg(i)) then
            1260                     !!          k = kbcon(i)
            1261                     !!!         ptem = g*sflx(i)*zi(i,k)/t1(i,1)
            1262                     !!          ptem = g*sflx(i)*hpbl(i)/t1(i,1)
            1263                     !!          wstar(i) = ptem**h1
            1264                     !!          tem = po(i,k)*100. / (rd*t1(i,k))
            1265                     !!          xmb(i) = betaw*tem*wstar(i)
            1266                     !!          xmb(i) = min(xmb(i),xmbmax(i))
            1267                     !!        endif
            1268                     !!      enddo
            1269                     !
            1270                     !
            1271                     !> - For scale-aware parameterization, the updraft fraction (sigmagfm)
            1272                     !is first computed as a function of the lateral entrainment rate at
            1273                     !cloud base (see Han et al.'s (2017) \cite han_et_al_2017 equation 4 and
            1274                     !5), following the study by Grell and Freitas (2014) \cite
            1275                     !grell_and_freitus_2014.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 239
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
            1276     1  pp    s            do i = 1, im
            1277     2   p    m              if(cnvflg(i)) then
            1278     2   p    s                tem = min(max(xlamue(i,kbcon(i)), 2.e-4), 6.e-4)
            1279     2   p    s                tem = 0.2 / tem
            1280     2   p    s                tem1 = 3.14 * tem * tem
            1281     2   p    s                sigmagfm(i) = tem1 / garea
            1282     2   p    s                sigmagfm(i) = max(sigmagfm(i), 0.001)
            1283     2   p    s                sigmagfm(i) = min(sigmagfm(i), 0.999)
            1284     2   p    v              endif
            1285     1   p    v            enddo
            1286                     !
            1287                     !> - Then, calculate the reduction factor (scaldfunc) of the vertical
            1288                     !convective eddy transport of mass flux as a function of updraft
            1289                     !fraction from the studies by Arakawa and Wu (2013) \cite
            1290                     !arakawa_and_wu_2013 (also see Han et al.'s (2017) \cite han_et_al_2017
            1291                     !equation 1 and 2). The final cloud base mass flux with scale-aware
            1292                     !parameterization is obtained from the mass flux when sigmagfm << 1,
            1293                     !multiplied by the reduction factor (Han et al.'s (2017) \cite
            1294                     !han_et_al_2017 equation 2).
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 259
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.56, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gdx, scaldfunc, xmb, sigmagfm, xmbmax
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
            1295     1  pp    v            do i = 1, im
            1296     2   p    v              if(cnvflg(i)) then
            1297     3   p    v                if (gdx(i) < dxcrt) then
            1298     3   p    v                  scaldfunc(i) = (1.-sigmagfm(i)) * (1.-sigmagfm(i))
            1299     3   p    v                  scaldfunc(i) = max(min(scaldfunc(i), 1.0), 0.)
            1300     3   p    v                else

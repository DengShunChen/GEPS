                                   <<< Loop-information  End >>>
            1216     1  pp   2v            do i= 1, im
            1217     2   p   2v              if(cnvflg(i)) then
            1218     2   p   2v                sumx(i) = 0.
            1219     2   p   2v                umean(i) = 0.

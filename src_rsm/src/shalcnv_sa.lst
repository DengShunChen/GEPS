            1107     1  pp    s            do i = 1, im
            1108     2   p    m              if(cnvflg(i)) then
            1109     2   p    s                vshear(i) = 1.e3 * vshear(i) / (zi(i,ktcon(i))-zi(i,kb(i)))
            1110     2   p    s                e1=1.591-.639*vshear(i) &
            1111     2                            +.0953*(vshear(i)**2)-.00496*(vshear(i)**3)
            1112     2   p    s                edt(i)=1.-e1

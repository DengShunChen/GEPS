             810                           subroutine mpe_global_maxloc_i(a,n,i1,i2,i3,i4,type)
             811                     
             812                           use rank, only : MPI_COMM_gfs
             813                           use mpi
             814                           integer swork(2), rwork(2)
             815                           integer a,n,i1,i2,i3,i4,i,iroot,IERR
             816                           integer ibuf(n)
             817                           integer, optional  :: type
             818                     
             819                           swork(1)=a
             820                           swork(2)=myrank
             821                           if(n.ge.1) ibuf(1)=i1
             822                           if(n.ge.2) ibuf(2)=i2
             823                           if(n.ge.3) ibuf(3)=i3
             824                           if(n.ge.4) ibuf(4)=i4
             825                     
             826                           call MPI_ALLREDUCE( SWORK, RWORK, 1, MPI_2INTEGER,    &
             827                                            MPI_MAXLOC, MPI_COMM_gfs, IERR )
             828                     
             829                           iroot=rwork(2)
             830                     
             831                           call MPI_BCAST( IBUF, N, MPI_INTEGER, IROOT,          &
             832                                           MPI_COMM_gfs, IERR )
             833                     
             834                           a =rwork(1)
             835                           if(n.ge.1) i1=ibuf(1)
             836                           if(n.ge.2) i2=ibuf(2)
             837                           if(n.ge.3) i3=ibuf(3)
             838                           if(n.ge.4) i4=ibuf(4)
             839                     
             840                           return
             841                     
             842                           end subroutine mpe_global_maxloc_i

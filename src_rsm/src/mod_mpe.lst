             106                           subroutine mpe_broadcast_i_scalar(buf,n,flag,type)
             107                     
             108                           use rank, only : myrank,MPI_COMM_gfs
             109                           use mpi
             110                     
             111                           integer  buf,n,iroot_in,iroot,IERR
             112                           logical  flag
             113                           integer, optional :: type
             114                     
             115                           iroot_in=0
             116                           if (flag) iroot_in = myrank+1
             117                     
             118                           call MPI_ALLREDUCE( iroot_in, iroot, 1, MPI_INTEGER,    &
             119                                               MPI_SUM, MPI_COMM_gfs, IERR )
             120                     
             121                           call MPI_BCAST( BUF, N, MPI_INTEGER, IROOT-1,           &
             122                                           MPI_COMM_gfs, IERR )
             123                     
             124                           return
             125                     
             126                           end subroutine mpe_broadcast_i_scalar

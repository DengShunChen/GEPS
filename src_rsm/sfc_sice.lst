              52                     !  ====================  defination of variables  ====================  !
              53                     !                                                                       !
              54                     !  inputs:                                                       size   !
              55                     !     im, km   - integer, horiz dimension and num of soil layers   1    !
              56                     !     ps       - real, surface pressure                            im   !
              57                     !     u1, v1   - real, u/v component of surface layer wind         im   !
              58                     !     t1       - real, surface layer mean temperature ( k )        im   !
              59                     !     q1       - real, surface layer mean specific humidity        im   !
              60                     !     delt     - real, time interval (second)                      1    !
              61                     !     sfcemis  - real, sfc lw emissivity ( fraction )              im   !
              62                     !     dlwflx   - real, total sky sfc downward lw flux ( w/m**2 )   im   !
              63                     !     sfcnsw   - real, total sky sfc netsw flx into ground(w/m**2) im   !
              64                     !     sfcdsw   - real, total sky sfc downward sw flux ( w/m**2 )   im   !
              65                     !     srflag   - real, snow/rain flag for precipitation            im   !
              66                     !     cm       - real, surface exchange coeff for momentum (m/s)   im   !
              67                     !     ch       - real, surface exchange coeff heat & moisture(m/s) im   !
              68                     !     prsl1    - real, surface layer mean pressure                 im   !
              69                     !     prslki   - real,                                             im   !
              70                     !     islimsk  - integer, sea/land/ice mask (=0/1/2)               im   !
              71                     !     ddvel    - real,                                             im   !
              72                     !     flag_iter- logical,                                          im   !
              73                     !     mom4ice  - logical,                                          im   !
              74                     !     lsm      - integer, flag for land surface model scheme       1    !
              75                     !                =0: use osu scheme; =1: use noah scheme                !
              76                     !                                                                       !
              77                     !  input/outputs:                                                       !
              78                     !     hice     - real, sea-ice thickness                           im   !
              79                     !     fice     - real, sea-ice concentration                       im   !
              80                     !     tice     - real, sea-ice surface temperature                 im   !
              81                     !     weasd    - real, water equivalent accumulated snow depth (mm)im   !
              82                     !     tskin    - real, ground surface skin temperature ( k )       im   !
              83                     !     tprcp    - real, total precipitation                         im   !
              84                     !     stc      - real, soil temp (k)                              im,km !
              85                     !     ep       - real, potential evaporation                       im   !
              86                     !                                                                       !
              87                     !  outputs:                                                             !
              88                     !     snwdph   - real, water equivalent snow depth (mm)            im   !
              89                     !     qsurf    - real, specific humidity at sfc                    im   !
              90                     !     snowmt   - real, snow melt (m)                               im   !
              91                     !     gflux    - real, soil heat flux (w/m**2)                     im   !
              92                     !     cmm      - real,                                             im   !
              93                     !     chh      - real,                                             im   !
              94                     !     evap     - real, evaperation from latent heat flux           im   !
              95                     !     hflx     - real, sensible heat flux                          im   !
              96                     !                                                                       !
              97                     ! ===================================================================== !
              98                     !
              99                           use machine , only : kind_phys
             100                     !     use funcphys, only : fpvs
             101                           use physcons, only : sbc => con_sbc, hvap => con_hvap,            &
             102                                                tgice => con_tice, cp => con_cp,             &
             103                                                eps => con_eps, epsm1 => con_epsm1,          &
             104                                                grav => con_g, rvrdm1 => con_fvirt,          &
             105                                                t0c => con_t0c, rd => con_rd
             106                           use const,    only : RTYPE
             107                     !
             108                           implicit none
             109                     !
             110                     !  ---  constant parameters:
             111                           integer,              parameter :: kmi   = 2        ! 2-layer of ice
             112                           real(kind=kind_phys), parameter :: cpinv = 1.0/cp
             113                           real(kind=kind_phys), parameter :: hvapi = 1.0/hvap
             114                           real(kind=kind_phys), parameter :: elocp = hvap/cp
             115                           real(kind=kind_phys), parameter :: himax = 8.0      ! maximum ice thickness allowed
             116                           real(kind=kind_phys), parameter :: himin = 0.1      ! minimum ice thickness required
             117                           real(kind=kind_phys), parameter :: hsmax = 2.0      ! maximum snow depth allowed
             118                           real(kind=kind_phys), parameter :: timin = 173.0    ! minimum temperature allowed for snow/ice
             119                           real(kind=kind_phys), parameter :: albfw = 0.06     ! albedo for lead
             120                           real(kind=kind_phys), parameter :: dsi   = 1.0/0.33
             121                           real(kind=kind_phys), parameter :: cimin = 0.15     !  --- minimum ice concentration
             122                     
             123                     !  ---  inputs:
             124                           integer, intent(in) :: im, km, lsm, imj
             125                     !     logical, intent(in) :: lprnt
             126                     
             127                           real (kind=RTYPE), dimension(im), intent(in) :: u1, v1, t1, q1
             128                           real (kind=kind_phys), dimension(im), intent(in) :: ps,           &
             129                                  sfcemis, dlwflx, sfcnsw, sfcdsw, srflag, cm, ch,           &
             130                                  prsl1, prslki, ddvel
             131                     
             132                           integer, dimension(im), intent(in) :: islimsk
             133                           real (kind=kind_phys), intent(in)  :: delt
             134                     
             135                           logical, intent(in) :: flag_iter(im), mom4ice
             136                     
             137                     !  ---  input/outputs:
             138                           real (kind=kind_phys), dimension(im), intent(inout) :: hice,      &
             139                                  fice, tice, weasd, tskin, tprcp, ep
             140                     
             141                           real (kind=kind_phys), dimension(im,km), intent(inout) :: stc
             142                     
             143                     !  ---  outputs:
             144                     !     real (kind=kind_phys), dimension(im), intent(out) :: snwdph,      &
             145                           real (kind=kind_phys), dimension(im) :: snwdph,      &
             146                                  qsurf, snowmt, gflux, cmm, chh, evap, hflx
             147                     
             148                     !  ---  locals:
             149                           real (kind=kind_phys), dimension(im) :: ffw, evapi, evapw,        &
             150                                  sneti, snetw, hfd, hfi,                                    &
             151                     !    &       hflxi, hflxw, sneti, snetw, qssi, qssw, hfd, hfi, hfw,     &
             152                                  focn, snof, hi_save, hs_save,                 rch, rho,    &
             153                                  snowd, theta1, ttmp
             154                     
             155                           real (kind=kind_phys) :: t12, t14, tem, stsice(im,kmi) &
             156                           ,                   hflxi, hflxw, q0, qs1, wind, qssi, qssw,fpvs
             157                     
             158                           integer :: i, k, ipr
             159                     
             160                           logical :: flag(im), lprnt
             161                     !
             162                     !===> ...  begin here
             163                     !
             164                     !  --- ...  set flag for sea-ice
             165                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 552
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.60, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      islimsk, flag_iter, flag, fice, hice
                                   <<< Loop-information  End >>>
             166     1  pp    v            do i = 1, imj
             167     1   p    v              flag(i) = (islimsk(i) >= 2) .and. flag_iter(i)
             168     2   p    v              if (flag_iter(i) .and. islimsk(i) < 2) then
             169     2   p    v                hice(i) = 0.0
             170     2   p    v                fice(i) = 0.0
             171     2   p    v              endif
             172     1   p    v            enddo
             173                     
             174                     !  --- ...  update sea ice temperature
             175                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flag, stc, stsice
                                   <<< Loop-information  End >>>
             176     1  pp                 do k = 1, kmi
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      stc, flag, stsice
                                   <<< Loop-information  End >>>
             177     2   p   2v              do i = 1, imj
             178     3   p   2v                if (flag(i)) then
             179     3   p   2v                  stsice(i,k) = stc(i,k)
             180     3   p   2v                endif
             181     2   p   2v              enddo
             182     1   p                 enddo
             183                     !
             184     1                     if (mom4ice) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.33, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hice, flag, weasd, hi_save, hs_save
                                   <<< Loop-information  End >>>
             185     2  pp   2v              do i = 1, imj
             186     3   p   2v                if (flag(i)) then
             187     3   p   2v                  hi_save(i) = hice(i)
             188     3   p   2v                  hs_save(i) = weasd(i) * 0.001
             189     3   p   2v                endif
             190     2   p   2v              enddo
             191     1                     elseif (lsm > 0) then           !  --- ...  snow-rain detection
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 500
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.77, ITR: 64, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      srflag, flag, ep, tprcp, weasd
                                   <<< Loop-information  End >>>
             192     2  pp    v              do i = 1, imj
             193     3   p    v                if (flag(i)) then
             194     4   p    v                  if (srflag(i) == 1.0) then
             195     4   p    v                    ep(i) = 0.0
             196     4   p    v                    weasd(i) = weasd(i) + 1.e3*tprcp(i)
             197     4   p    v                    tprcp(i)  = 0.0
             198     4   p    v                  endif
             199     3   p    v                endif
             200     2   p    v              enddo
             201     1                     endif
             202                     
             203                     !  --- ...  initialize variables. all units are supposedly m.k.s. unless specifie
             204                     !           psurf is in pascals, wind is wind speed, theta1 is adiabatic surface
             205                     !           temp from level 1, rho is density, qs1 is sat. hum. at level1 and qss
             206                     !           is sat. hum. at surface
             207                     !           convert slrad to the civilized unit from langley minute-1 k-4
             208                     
             209     1                     do i = 1, imj
             210     2                       if (flag(i)) then
             211     2               !         psurf(i) = 1000.0 * ps(i)
             212     2               !         ps1(i)   = 1000.0 * prsl1(i)
             213     2               
             214     2               !         dlwflx has been given a negative sign for downward longwave
             215     2               !         sfcnsw is the net shortwave flux (direction: dn-up)
             216     2               
             217     2                         wind      = max(sqrt(u1(i)*u1(i) + v1(i)*v1(i))               &
             218     2                                       + max(0.0, min(ddvel(i), 30.0)), 1.0)
             219     2               
             220     2                         q0        = max(q1(i), 1.0e-8)
             221     2               !         tsurf(i)  = tskin(i)
             222     2                         theta1(i) = t1(i) * prslki(i)
             223     2                         rho(i)    = prsl1(i) / (rd*t1(i)*(1.0+rvrdm1*q0))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ttmp
                                   <<< Loop-information  End >>>
             224     2  pp   4v                ttmp      = t1(i)
             225     2                         qs1       = fpvs(ttmp)
             226     2                         qs1       = max(eps*qs1 / (prsl1(i) + epsm1*qs1), 1.e-8)
             227     2                         q0        = min(qs1, q0)
             228     2               
             229     2                         ffw(i)    = 1.0 - fice(i)
             230     3                         if (fice(i) < cimin) then
             231     3                           print *,'warning: ice fraction is low:', fice(i)
             232     3                           fice(i) = cimin
             233     3                           ffw (i) = 1.0 - fice(i)
             234     3                           tice(i) = tgice
             235     3                           tskin(i)= tgice
             236     3                           print *,'fix ice fraction: reset it to:', fice(i)
             237     3                         endif
             238     2               
             239     2                         qssi = fpvs(tice(i))
             240     2                         qssi = eps*qssi / (ps(i) + epsm1*qssi)
             241     2                         qssw = fpvs(tgice)
             242     2                         qssw = eps*qssw / (ps(i) + epsm1*qssw)
             243     2               
             244     2               !  --- ...  snow depth in water equivalent is converted from mm to m unit
             245     2               
             246     3                         if (mom4ice) then
             247     3                           snowd(i) = weasd(i) * 0.001 / fice(i)
             248     3                         else
             249     3                           snowd(i) = weasd(i) * 0.001
             250     3                         endif
             251     2               !         flagsnw(i) = .false.
             252     2               
             253     2               !  --- ...  when snow depth is less than 1 mm, a patchy snow is assumed and
             254     2               !           soil is allowed to interact with the atmosphere.
             255     2               !           we should eventually move to a linear combination of soil and
             256     2               !           snow under the condition of patchy snow.
             257     2               
             258     2               !  --- ...  rcp = rho cp ch v
             259     2               
             260     2                         cmm(i) = cm(i)  * wind
             261     2                         chh(i) = rho(i) * ch(i) * wind
             262     2                         rch(i) = chh(i) * cp
             263     2               
             264     2               !  --- ...  sensible and latent heat flux over open water & sea ice
             265     2               
             266     2                         evapi(i) = elocp * rch(i) * (qssi - q0)
             267     2                         evapw(i) = elocp * rch(i) * (qssw - q0)
             268     2               !         evap(i)  = fice(i)*evapi(i) + ffw(i)*evapw(i)
             269     2               
             270     2               !     if (lprnt) write(0,*)' tice=',tice(ipr)
             271     2               
             272     2                         snetw(i) = sfcdsw(i) * (1.0 - albfw)
             273     2                         snetw(i) = min(3.0*sfcnsw(i)/(1.0+2.0*ffw(i)), snetw(i))
             274     2                         sneti(i) = (sfcnsw(i) - ffw(i)*snetw(i)) / fice(i)
             275     2               
             276     2                         t12 = tice(i) * tice(i)
             277     2                         t14 = t12 * t12
             278     2               
             279     2               !  --- ...  hfi = net non-solar and upir heat flux @ ice surface
             280     2               
             281     2                         hfi(i) = -dlwflx(i) + sfcemis(i)*sbc*t14 + evapi(i)           &
             282     2                                + rch(i)*(tice(i) - theta1(i))
             283     2                         hfd(i) = 4.0*sfcemis(i)*sbc*tice(i)*t12                       &
             284     2                                + (1.0 + elocp*eps*hvap*qs1/(rd*t12)) * rch(i)
             285     2               
             286     2                         t12 = tgice * tgice
             287     2                         t14 = t12 * t12
             288     2               
             289     2               !  --- ...  hfw = net heat flux @ water surface (within ice)
             290     2               
             291     2               !         hfw(i) = -dlwflx(i) + sfcemis(i)*sbc*t14 + evapw(i)           &
             292     2               !    &           + rch(i)*(tgice - theta1(i)) - snetw(i)
             293     2               
             294     2                         focn(i) = 2.0     ! heat flux from ocean - should be from ocn model
             295     2                         snof(i) = 0.0     ! snowfall rate - snow accumulates in gbphys
             296     2               
             297     2                         hice(i) = max( min( hice(i), himax ), himin )
             298     2                         snowd(i) = min( snowd(i), hsmax )
             299     2               
             300     3                         if (snowd(i) > (2.0*hice(i))) then
             301     3                           print *, 'warning: too much snow :',snowd(i)
             302     3                           snowd(i) = hice(i) + hice(i)
             303     3                           print *,'fix: decrease snow depth to:',snowd(i)
             304     3                         endif
             305     2                       endif
             306     1                     enddo
             307                     
             308                     !     if (lprnt) write(0,*)' tice2=',tice(ipr)
             309                           call ice3lay
             310                     !  ---  inputs:                                                         !
             311                     !    &     ( imj, im, kmi, fice, flag, hfi, hfd, sneti, focn, delt,     !
             312                     !  ---  outputs:                                                        !
             313                     !    &       snowd, hice, stsice, tice, snof, snowmt, gflux )           !
             314                     
             315                     !     if (lprnt) write(0,*)' tice3=',tice(ipr)
             316     1                     if (mom4ice) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 128, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hice, snowd, flag, hi_save, hs_save
                                   <<< Loop-information  End >>>
             317     2  pp   2v              do i = 1, imj
             318     3   p   2v                if (flag(i)) then
             319     3   p   2v                  hice(i)  = hi_save(i)
             320     3   p   2v                  snowd(i) = hs_save(i)
             321     3   p   2v                endif
             322     2   p   2v              enddo
             323     1                     endif
             324                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flag
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 3  FILL 6
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             325     1   s    s            do i = 1, imj
             326     2   p    m              if (flag(i)) then
             327     3   p    s                if (tice(i) < timin) then
             328     3   m    s                  print *,'warning: snow/ice temperature is too low:',tice(i) &
             329     3                     ,' i=',i
             330     3   s    s                  tice(i) = timin
             331     3   s    s                  print *,'fix snow/ice temperature: reset it to:',tice(i)
             332     3   p    s                endif
             333     2               
             334     3   p    s                if (stsice(i,1) < timin) then
             335     3   m    s                  print *,'warning: layer 1 ice temp is too low:',stsice(i,1) &
             336     3                     ,' i=',i
             337     3   s    s                  stsice(i,1) = timin
             338     3   s    s                  print *,'fix layer 1 ice temp: reset it to:',stsice(i,1)
             339     3   p    s                endif
             340     2               
             341     3   p    s                if (stsice(i,2) < timin) then
             342     3   m    s                  print *,'warning: layer 2 ice temp is too low:',stsice(i,2)
             343     3   s    s                  stsice(i,2) = timin
             344     3   s    s                  print *,'fix layer 2 ice temp: reset it to:',stsice(i,2)
             345     3   p    s                endif
             346     2               
             347     2   p    s                tskin(i) = tice(i)*fice(i) + tgice*ffw(i)
             348     2   p    v              endif
             349     1   p    v            enddo
             350                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flag, stsice, stc
                                   <<< Loop-information  End >>>
             351     1  pp                 do k = 1, kmi
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      stsice, flag, stc
                                   <<< Loop-information  End >>>
             352     2   p   2v              do i = 1, imj
             353     3   p   2v                if (flag(i)) then
             354     3   p   2v                  stc(i,k) = min(stsice(i,k), t0c)
             355     3   p   2v                endif
             356     2   p   2v              enddo
             357     1   p                 enddo
             358                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 191
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.41, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rch, evapw, ffw, q1, snowd, rho, theta1
                                   <<<      tice, flag, evapi, fice, qsurf, weasd
                                   <<<      snwdph, hflx, evap
                                   <<< Loop-information  End >>>
             359     1  pp    v            do i = 1, imj
             360     2   p    v              if (flag(i)) then
             361     2               !  --- ...  calculate sensible heat flux (& evap over sea ice)
             362     2               
             363     2   p    v                hflxi    = rch(i) * (tice(i) - theta1(i))
             364     2   p    v                hflxw    = rch(i) * (tgice - theta1(i))
             365     2   p    v                hflx(i)  = fice(i)*hflxi    + ffw(i)*hflxw
             366     2   p    v                evap(i)  = fice(i)*evapi(i) + ffw(i)*evapw(i)
             367     2               !
             368     2               !  --- ...  the rest of the output
             369     2               
             370     2   p    v                qsurf(i) = q1(i) + evap(i) / (elocp*rch(i))
             371     2               
             372     2               !  --- ...  convert snow depth back to mm of water equivalent
             373     2               
             374     2   p    v                weasd(i)  = snowd(i) * 1000.0
             375     2   p    v                snwdph(i) = weasd(i) * dsi             ! snow depth in mm
             376     2               
             377     2   p    v                tem     = 1.0 / rho(i)
             378     2   p    v                hflx(i) = hflx(i) * tem * cpinv
             379     2   p    v                evap(i) = evap(i) * tem * hvapi
             380     2   p    v              endif
             381     1   p    v            enddo
             382                     !
             383                           return
             384                     
             385                     ! =================
             386                           contains
             387                     ! =================
             388                     
             389                     
             390                     !-----------------------------------
             391                           subroutine ice3lay
             392                     !...................................
             393                     !  ---  inputs:
             394                     !    &     ( imj, im, kmi, fice, flag, hfi, hfd, sneti, focn, delt,          &
             395                     !  ---  input/outputs:
             396                     !    &       snowd, hice, stsice, tice, snof,                           &
             397                     !  ---  outputs:
             398                     !    &       snowmt, gflux                                              &
             399                     !    &     )
             400                     
             401                     !**************************************************************************
             402                     !                                                                         *
             403                     !            three-layer sea ice vertical thermodynamics                  *
             404                     !                                                                         *
             405                     ! based on:  m. winton, "a reformulated three-layer sea ice model",       *
             406                     ! journal of atmospheric and oceanic technology, 2000                     *
             407                     !                                                                         *
             408                     !                                                                         *
             409                     !        -> +---------+ <- tice - diagnostic surface temperature ( <= 0c )*
             410                     !       /   |         |                                                   *
             411                     !   snowd   |  snow   | <- 0-heat capacity snow layer                     *
             412                     !       \   |         |                                                   *
             413                     !        => +---------+                                                   *
             414                     !       /   |         |                                                   *
             415                     !      /    |         | <- t1 - upper 1/2 ice temperature; this layer has *
             416                     !     /     |         |         a variable (t/s dependent) heat capacity  *
             417                     !   hice    |...ice...|                                                   *
             418                     !     \     |         |                                                   *
             419                     !      \    |         | <- t2 - lower 1/2 ice temp. (fixed heat capacity) *
             420                     !       \   |         |                                                   *
             421                     !        -> +---------+ <- base of ice fixed at seawater freezing temp.   *
             422                     !                                                                         *
             423                     !  =====================  defination of variables  =====================  !
             424                     !                                                                         !
             425                     !  inputs:                                                         size   !
             426                     !     im, kmi  - integer, horiz dimension and num of ice layers      1    !
             427                     !     fice     - real, sea-ice concentration                         im   !
             428                     !     flag     - logical, ice mask flag                              1    !
             429                     !     hfi      - real, net non-solar and heat flux @ surface(w/m^2)  im   !
             430                     !     hfd      - real, heat flux derivatice @ sfc (w/m^2/deg-c)      im   !
             431                     !     sneti    - real, net solar incoming at top  (w/m^2)            im   !
             432                     !     focn     - real, heat flux from ocean    (w/m^2)               im   !
             433                     !     delt     - real, timestep                (sec)                 1    !
             434                     !                                                                         !
             435                     !  input/outputs:                                                         !
             436                     !     snowd    - real, surface pressure                              im   !
             437                     !     hice     - real, sea-ice thickness                             im   !
             438                     !     stsice   - real, temp @ midpt of ice levels  (deg c)          im,kmi!
             439                     !     tice     - real, surface temperature     (deg c)               im   !
             440                     !     snof     - real, snowfall rate           (m/sec)               im   !
             441                     !                                                                         !
             442                     !  outputs:                                                               !
             443                     !     snowmt   - real, snow melt during delt   (m)                   im   !
             444                     !     gflux    - real, conductive heat flux    (w/m^2)               im   !
             445                     !                                                                         !
             446                     !  locals:                                                                !
             447                     !     hdi      - real, ice-water interface     (m)                        !
             448                     !     hsni     - real, snow-ice                (m)                        !
             449                     !                                                                         !
             450                     ! ======================================================================= !
             451                     !
             452                     
             453                     !  ---  constant parameters: (properties of ice, snow, and seawater)
             454                           real (kind=kind_phys), parameter :: ds   = 330.0    ! snow (ov sea ice) density (kg/m^3)
             455                           real (kind=kind_phys), parameter :: dw   =1000.0    ! fresh water density  (kg/m^3)
             456                           real (kind=kind_phys), parameter :: dsdw = ds/dw
             457                           real (kind=kind_phys), parameter :: dwds = dw/ds
             458                           real (kind=kind_phys), parameter :: t0c  =273.15    ! freezing temp of fresh ice (k)
             459                           real (kind=kind_phys), parameter :: ks   = 0.31     ! conductivity of snow   (w/mk)
             460                           real (kind=kind_phys), parameter :: i0   = 0.3      ! ice surface penetrating solar fraction
             461                           real (kind=kind_phys), parameter :: ki   = 2.03     ! conductivity of ice  (w/mk)
             462                           real (kind=kind_phys), parameter :: di   = 917.0    ! density of ice   (kg/m^3)
             463                           real (kind=kind_phys), parameter :: didw = di/dw
             464                           real (kind=kind_phys), parameter :: dsdi = ds/di
             465                           real (kind=kind_phys), parameter :: ci   = 2054.0   ! heat capacity of fresh ice (j/kg/k)
             466                           real (kind=kind_phys), parameter :: li   = 3.34e5   ! latent heat of fusion (j/kg-ice)
             467                           real (kind=kind_phys), parameter :: si   = 1.0      ! salinity of sea ice
             468                           real (kind=kind_phys), parameter :: mu   = 0.054    ! relates freezing temp to salinity
             469                           real (kind=kind_phys), parameter :: tfi  = -mu*si   ! sea ice freezing temp = -mu*salinity
             470                           real (kind=kind_phys), parameter :: tfw  = -1.8     ! tfw - seawater freezing temp (c)
             471                           real (kind=kind_phys), parameter :: tfi0 = tfi-0.0001
             472                           real (kind=kind_phys), parameter :: dici = di*ci
             473                           real (kind=kind_phys), parameter :: dili = di*li
             474                           real (kind=kind_phys), parameter :: dsli = ds*li
             475                           real (kind=kind_phys), parameter :: ki4  = ki*4.0
             476                     
             477                     !  ---  inputs:
             478                     !     integer, intent(in) :: im, kmi
             479                     
             480                     !     real (kind=kind_phys), dimension(im), intent(in) :: fice, hfi,    &
             481                     !    &       hfd, sneti, focn
             482                     
             483                     !     real (kind=kind_phys), intent(in) :: delt
             484                     
             485                     !     logical, dimension(im), intent(in) :: flag
             486                     
             487                     !  ---  input/outputs:
             488                     !     real (kind=kind_phys), dimension(im), intent(inout) :: snowd,     &
             489                     !    &       hice, tice, snof
             490                     
             491                     !     real (kind=kind_phys), dimension(im,kmi), intent(inout) :: stsice
             492                     
             493                     !  ---  outputs:
             494                     !     real (kind=kind_phys), dimension(im), intent(out) :: snowmt,      &
             495                     !    &       gflux
             496                     
             497                     !  ---  locals:
             498                     
             499                           real (kind=kind_phys) :: dt2, dt4, dt6, h1, h2, dh, wrk, wrk1,      &
             500                                                    dt2i, hdi, hsni, ai, bi, a1, b1, a10, b10  &
             501                           ,                        c1, ip, k12, k32, tsf, f1, tmelt, bmelt
             502                     
             503                           integer :: i
             504                     !
             505                     !===> ...  begin here
             506                     !
             507                           dt2  = 2.0 * delt
             508                           dt4  = 4.0 * delt
             509                           dt6  = 6.0 * delt
             510                           dt2i = 1.0 / dt2
             511                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 31
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flag, sneti, hfi, snowd, snof, hice
                                   <<<      stsice, tice, hfd, snowmt, focn, gflux
                                   <<<      fice
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 24
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             512     1  pp    v            do i = 1, imj
             513     2   p    v              if (flag(i)) then
             514     2   p    v                snowd(i) = snowd(i) * dwds
             515     2   p    v                hdi      = (dsdw*snowd(i) + didw*hice(i))
             516     2               
             517     3   p    v                if (hice(i) < hdi) then
             518     3   p    v                  snowd(i) = snowd(i) + hice(i) - hdi
             519     3   p    v                  hsni     = (hdi - hice(i)) * dsdi
             520     3   p    v                  hice (i) = hice(i) + hsni
             521     3   p    v                endif
             522     2               
             523     2   p    v                snof(i)     = snof(i) * dwds
             524     2   p    v                tice(i)     = tice(i) - t0c
             525     2   p    v                stsice(i,1) = min(stsice(i,1)-t0c, tfi0)     ! degc
             526     2   p    v                stsice(i,2) = min(stsice(i,2)-t0c, tfi0)     ! degc
             527     2               
             528     2   p    v                ip = i0 * sneti(i)         ! ip +v (in winton ip=-i0*sneti as sol -v)
             529     3   p    v                if (snowd(i) > 0.0) then
             530     3   p    v                  tsf = 0.0
             531     3   p    v                  ip  = 0.0
             532     3   p    v                else
             533     3   p    v                  tsf = tfi
             534     3   p    v                  ip  = i0 * sneti(i)      ! ip +v here (in winton ip=-i0*sneti)
             535     3   p    v                endif
             536     2   p    v                tice(i) = min(tice(i), tsf)
             537     2               
             538     2               !  --- ...  compute ice temperature
             539     2               
             540     2   p    v                bi   = hfd(i)
             541     2   p    v                ai   = hfi(i) - sneti(i) + ip - tice(i)*bi  ! +v sol input here
             542     2   p    v                k12  = ki4*ks / (ks*hice(i) + ki4*snowd(i))
             543     2   p    v                k32  = (ki+ki) / hice(i)
             544     2               
             545     2   p    v                wrk    = 1.0 / (dt6*k32 + dici*hice(i))
             546     2   p    v                a10    = dici*hice(i)*dt2i + k32*(dt4*k32 + dici*hice(i))*wrk
             547     2   p    v                b10    = -di*hice(i) * (ci*stsice(i,1) + li*tfi/stsice(i,1))    &
             548     2                                * dt2i - ip                                              &
             549     2                                - k32*(dt4*k32*tfw + dici*hice(i)*stsice(i,2)) * wrk
             550     2               
             551     2   p    v                wrk1  = k12 / (k12 + bi)
             552     2   p    v                a1    = a10 + bi * wrk1
             553     2   p    v                b1    = b10 + ai * wrk1
             554     2   p    v                c1    = dili * tfi * dt2i * hice(i)
             555     2               
             556     2   p    v                stsice(i,1) = -(sqrt(b1*b1 - 4.0*a1*c1) + b1)/(a1+a1)
             557     2   p    v                tice(i) = (k12*stsice(i,1) - ai) / (k12 + bi)
             558     2               
             559     2                         !!! top ice melt
             560     3   p    v                if (tice(i) > tsf) then
             561     3   p    v                  a1 = a10 + k12
             562     3   p    v                  b1 = b10 - k12*tsf
             563     3   p    v                  stsice(i,1) = -(sqrt(b1*b1 - 4.0*a1*c1) + b1)/(a1+a1)
             564     3   p    v                  tice(i) = tsf
             565     3   p    v                  tmelt   = (k12*(stsice(i,1)-tsf) - (ai+bi*tsf)) * delt
             566     3   p    v                else
             567     3   p    v                  tmelt    = 0.0
             568     3   p    v                  snowd(i) = snowd(i) + snof(i)*delt
             569     3   p    v                endif
             570     2               
             571     2   p    v                stsice(i,2) = (dt2*k32*(stsice(i,1) + tfw + tfw)                &
             572     2                                     +  dici*hice(i)*stsice(i,2)) * wrk
             573     2               
             574     2                         !!! bottom melt
             575     2   p    v                bmelt = (focn(i) + ki4*(stsice(i,2) - tfw)/hice(i)) * delt
             576     2               
             577     2               !  --- ...  resize the ice ...
             578     2               
             579     2   p    v                h1 = 0.5 * hice(i)
             580     2   p    v                h2 = 0.5 * hice(i)
             581     2               
             582     2               !  --- ...  top ...
             583     2               
             584     3   p    v                if (tmelt <= snowd(i)*dsli) then
             585     3   p    v                  snowmt(i) = tmelt / dsli
             586     3   p    v                  snowd (i) = snowd(i) - snowmt(i)
             587     3   p    v                else
             588     3   p    v                  snowmt(i) = snowd(i)
             589     3   p    v                  h1 = h1 - (tmelt - snowd(i)*dsli)                             &
             590     3                              / (di * (ci - li/stsice(i,1)) * (tfi - stsice(i,1)))
             591     3   p    v                  snowd(i) = 0.0
             592     3   p    v                endif
             593     2               
             594     2               !  --- ...  and bottom
             595     2               
             596     3   p    v                if (bmelt < 0.0) then
             597     3   p    v                  dh = -bmelt / (dili + dici*(tfi - tfw))
             598     3   p    v                  stsice(i,2) = (h2*stsice(i,2) + dh*tfw) / (h2 + dh)
             599     3   p    v                  h2 = h2 + dh
             600     3   p    v                else
             601     3   p    v                  h2 = h2 - bmelt / (dili + dici*(tfi - stsice(i,2)))
             602     3   p    v                endif
             603     2               
             604     2               !  --- ...  if ice remains, even up 2 layers, else, pass negative energy back in snow
             605     2               
             606     2   p    v                hice(i) = h1 + h2
             607     2               
             608     3   p    v                if (hice(i) > 0.0) then
             609     4   p    v                  if (h1 > 0.5*hice(i)) then
             610     4   p    v                    f1 = 1.0 - (h2+h2) / hice(i)
             611     4   p    v                    stsice(i,2) = f1 * (stsice(i,1) + li*tfi/(ci*stsice(i,1)))  &
             612     4                                         + (1.0 - f1)*stsice(i,2)
             613     4               
             614     5   p    v                    if (stsice(i,2) > tfi) then
             615     5   p    v                      hice(i) = hice(i) - h2*ci*(stsice(i,2) - tfi)/ (li*delt)
             616     5   p    v                      stsice(i,2) = tfi
             617     5   p    v                    endif
             618     4   p    v                  else
             619     4   p    v                    f1 = (h1+h1) / hice(i)
             620     4   p    v                    stsice(i,1) = f1 * (stsice(i,1) + li*tfi/(ci*stsice(i,1)))  &
             621     4                                         + (1.0 - f1)*stsice(i,2)
             622     4   p    v                    stsice(i,1) = (stsice(i,1) - sqrt(stsice(i,1)*stsice(i,1)   &
             623     4                                         - 4.0*tfi*li/ci)) * 0.5
             624     4   p    v                  endif
             625     3               
             626     3   p    v                  k12      = ki4*ks / (ks*hice(i) + ki4*snowd(i))
             627     3   p    v                  gflux(i) = k12 * (stsice(i,1) - tice(i))
             628     3   p    v                else
             629     3   p    v                  snowd(i) = snowd(i) + (h1*(ci*(stsice(i,1) - tfi)             &
             630     3                                    - li*(1.0 - tfi/stsice(i,1)))                        &
             631     3                                    + h2*(ci*(stsice(i,2) - tfi) - li)) / li
             632     3               
             633     3   p    v                  hice(i)     = max(0.0, snowd(i)*dsdi)
             634     3   p    v                  snowd(i)    = 0.0
             635     3   p    v                  stsice(i,1) = tfw
             636     3   p    v                  stsice(i,2) = tfw
             637     3   p    v                  gflux(i)    = 0.0
             638     3   p    v                endif   ! end if_hice_block
             639     2               
             640     2   p    v                gflux(i)    = fice(i) * gflux(i)
             641     2   p    v                snowmt(i)   = snowmt(i) * dsdw
             642     2   p    v                snowd(i)    = snowd(i) * dsdw
             643     2   p    v                tice(i)     = tice(i) + t0c
             644     2   p    v                stsice(i,1) = stsice(i,1) + t0c
             645     2   p    v                stsice(i,2) = stsice(i,2) + t0c
             646     2   p    v              endif   ! end if_flag_block
             647     1   p    v            enddo   ! end do_i_loop
             648                     
             649                           return
             650                     !...................................
             651                           end subroutine ice3lay

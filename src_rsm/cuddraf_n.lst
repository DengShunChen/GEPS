 External subroutine subprogram "cuddraf_n"
  (inc)(line-no.)(nest)(optimize)
               1                            subroutine cuddraf_n                                 &
               2                          &   ( nxj, klon,     klev,    lddraf                      &
               3                          &   , ptenh,    pqenh,    puen,     pven             &
               4                          &   , pgeo,     pgeoh,    paph,     prfl             &
               5                          &   , ptd,      pqd,      pud,      pvd,      pmfu   &
               6                          &   , pmfd,     pmfds,    pmfdq,    pdmfdp,   pmfdde_rate &
               7                          &   )
               8                     
               9                     !          this routine calculates cumulus downdraft descent
              10                     
              11                     !          m.tiedtke         e.c.m.w.f.    12/86 modif. 12/89
              12                     
              13                     !          purpose.
              14                     !          --------
              15                     !          to produce the vertical profiles for cumulus downdrafts
              16                     !          (i.e. t,q,u and v and fluxes)
              17                     
              18                     !          interface
              19                     !          ---------
              20                     
              21                     !          this routine is called from *cumastr*.
              22                     !          input is t,q,p,phi,u,v at half levels.
              23                     !          it returns fluxes of s,q and evaporation rate
              24                     !          and u,v at levels where downdraft occurs
              25                     
              26                     !          method.
              27                     !          --------
              28                     !          calculate moist descent for entraining/detraining plume by
              29                     !          a) moving air dry-adiabatically to next level below and
              30                     !          b) correcting for evaporation to obtain saturated state.
              31                     
              32                     !     parameter     description                                   units
              33                     !     ---------     -----------                                   -----
              34                     !     input parameters (integer):
              35                     
              36                     !    *klon*         number of grid points per packet
              37                     !    *klev*         number of levels
              38                     
              39                     !    input parameters (logical):
              40                     
              41                     !    *lddraf*       .true. if downdrafts exist
              42                     
              43                     !    input parameters (real):
              44                     
              45                     !    *ptenh*        env. temperature (t+1) on half levels          k
              46                     !    *pqenh*        env. spec. humidity (t+1) on half levels     kg/kg
              47                     !    *puen*         provisional environment u-velocity (t+1)      m/s
              48                     !    *pven*         provisional environment v-velocity (t+1)      m/s
              49                     !    *pgeo*         geopotential                                  m2/s2
              50                     !    *pgeoh*        geopotential on half levels                  m2/s2
              51                     !    *paph*         provisional pressure on half levels           pa
              52                     !    *pmfu*         massflux updrafts                           kg/(m2*s)
              53                     
              54                     !    updated parameters (real):
              55                     
              56                     !    *prfl*         precipitation rate                           kg/(m2*s)
              57                     
              58                     !    output parameters (real):
              59                     
              60                     !    *ptd*          temperature in downdrafts                      k
              61                     !    *pqd*          spec. humidity in downdrafts                 kg/kg
              62                     !    *pud*          u-velocity in downdrafts                      m/s
              63                     !    *pvd*          v-velocity in downdrafts                      m/s
              64                     !    *pmfd*         massflux in downdrafts                       kg/(m2*s)!    *pmfds*        flux of dry static energy in downdrafts       j/(m2*s)
              65                     !    *pmfdq*        flux of spec. humidity in downdrafts         kg/(m2*s)
              66                     !    *pdmfdp*       flux difference of precip. in downdrafts     kg/(m2*s)
              67                     
              68                     !          externals
              69                     !          ---------
              70                     !          *cuadjtq* for adjusting t and q due to evaporation in
              71                     !          saturated descent
              72                     !----------------------------------------------------------------------
              73                       USE mo_constants,    ONLY: rd,      &! gas constant for dry air
              74                                                  cpd,     &! specific heat at constant pressure
              75                                                  rcpd,    &! rcpd=1./cpd
              76                                                  vtmpc1,  &! vtmpc1=rv/rd-1
              77                                                  g,       &! gravity acceleration
              78                                                  zrg        ! 1.0/g
              79                       USE mo_cumulus_flux, ONLY: entrdd,  &! entrainment rate for cumulus downdrafts
              80                                                  cmfcmin, &! minimum massflux value (for safety)
              81                                                  lmfdudv   ! true if cumulus friction is switched on
              82                     
              83                     !----------------------------------------------------------------------
              84                           implicit none
              85                     
              86                           integer  klev,klon,nxj
              87                           real     ptenh(klon,klev),       pqenh(klon,klev),   &
              88                          &         puen(klon,klev),        pven(klon,klev),    &
              89                          &         pgeoh(klon,klev+1),     paph(klon,klev+1),  &
              90                          &         pgeo(klon,klev),        pmfu(klon,klev)
              91                     
              92                           real     ptd(klon,klev),         pqd(klon,klev),     &
              93                          &         pud(klon,klev),         pvd(klon,klev),     &
              94                          &         pmfd(klon,klev),        pmfds(klon,klev),   &
              95                          &         pmfdq(klon,klev),       pdmfdp(klon,klev),  &
              96                          &         prfl(klon)
              97                           real     pmfdde_rate(klon,klev)
              98                           logical  lddraf(klon)
              99                     
             100                           real     zdmfen(klon),           zdmfde(klon),       &
             101                          &         zcond(klon),            zoentr(klon),       &
             102                          &         zbuoy(klon)
             103                           real     zph(klon)
             104                           logical  llo2(klon)
             105                           logical  llo1
             106                     ! local variables
             107                           integer  jl,jk
             108                           integer  is,ik,icall,ike, itopde(klon)
             109                           real     zentr,zdz,zzentr,zseen,zqeen,zsdde,zqdde,zdmfdp
             110                           real     zmfdsk,zmfdqk,zbuo,zrain,zbuoyz,zmfduk,zmfdvk
             111                     
             112                     !----------------------------------------------------------------------
             113                     !     1.           calculate moist descent for cumulus downdraft by
             114                     !                     (a) calculating entrainment/detrainment rates,
             115                     !                         including organized entrainment dependent on
             116                     !                         negative buoyancy and assuming
             117                     !                         linear decrease of massflux in pbl
             118                     !                     (b) doing moist descent - evaporative cooling
             119                     !                         and moistening is calculated in *cuadjtq*
             120                     !                     (c) checking for negative buoyancy and
             121                     !                         specifying final t,q,u,v and downward fluxes
             122                     !                    -------------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zcond, itopde, zdmfde, zdmfen, zbuoy
                                   <<<      zoentr
                                   <<< Loop-information  End >>>
             123     1  pp   2v             do jl = 1, nxj
             124     1   p   2v              zoentr(jl)=0.
             125     1   p   2v              zbuoy(jl)=0.
             126     1   p   2v              zdmfen(jl)=0.
             127     1   p   2v              zdmfde(jl)=0.
             128     1               !xb110>
             129     1   p   2v              itopde(jl)=klev
             130     1   p   2v              zcond(jl) = 0.
             131     1               !xb110<
             132     1   p   2v            enddo
             133                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      paph, itopde, pmfdde_rate
                                   <<< Loop-information  End >>>
             134     1                     do jk=klev,1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pmfdde_rate, paph, itopde
                                   <<< Loop-information  End >>>
             135     2  pp   2v             do jl = 1, nxj
             136     2   p   2v               pmfdde_rate(jl,jk) = 0.
             137     2   p   2v               if((paph(jl,klev+1)-paph(jl,jk)).lt. 60.e2) itopde(jl)=jk
             138     2   p   2v             end do
             139     1                     end do
             140                     
             141     1                     do jk=3,klev
             142     1                     is=0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             143     2  pp    v             do jl = 1, nxj
             144     2   p    v            zph(jl)=paph(jl,jk)
             145     2   p    v            llo2(jl)=lddraf(jl).and.pmfd(jl,jk-1).lt.0.
             146     3   p    v            if(llo2(jl)) then
             147     3   p                    is=is+1
             148     3   p    v            endif
             149     2   p    v            end do
             150     1               
             151     1                     if(is.eq.0) cycle
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 70
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 152,160,171,185)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      llo2
                                   <<< Loop-information  End >>>
             152     2  pp    s             do jl = 1, nxj
             153     3   p    m            if(llo2(jl)) then
             154     3   p    s               zentr = entrdd*pmfd(jl,jk-1)*(pgeoh(jl,jk-1)-pgeoh(jl,jk))*zrg
             155     3   p    s               zdmfen(jl)=zentr
             156     3   p    s               zdmfde(jl)=zentr
             157     3   p    v            end if
             158     2   p    v            end do
             159     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             160     2                      do jl = 1, nxj
             161     3                        if(llo2(jl)) then
             162     4                        if(jk.gt.itopde(jl)) then
             163     4                           zdmfen(jl)=0.
             164     4                           zdmfde(jl)=pmfd(jl,itopde(jl))*      &
             165     4                           (paph(jl,jk)-paph(jl,jk-1))/     &
             166     4                           (paph(jl,klev+1)-paph(jl,itopde(jl)))
             167     4                        end if
             168     3                        end if
             169     2                       end do
             170     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             171     2                        do jl = 1,nxj
             172     3                         if(llo2(jl)) then
             173     4                         if(jk.le.itopde(jl)) then
             174     4                           zdz=-(pgeoh(jl,jk-1)-pgeoh(jl,jk))*zrg
             175     4                           zzentr=zoentr(jl)*zdz*pmfd(jl,jk-1)
             176     4                           zdmfen(jl)=zdmfen(jl)+zzentr
             177     4                           zdmfen(jl)=max(zdmfen(jl),0.3*pmfd(jl,jk-1))
             178     4                           zdmfen(jl)=max(zdmfen(jl),-0.75*pmfu(jl,jk)-   &
             179     4                  &         (pmfd(jl,jk-1)-zdmfde(jl)))
             180     4                           zdmfen(jl)=min(zdmfen(jl),0.)
             181     4                         endif
             182     3                        endif
             183     2                       enddo
             184     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             185     2                      do jl = 1, nxj
             186     3                        if(llo2(jl)) then
             187     3                           pmfd(jl,jk)=pmfd(jl,jk-1)+zdmfen(jl)-zdmfde(jl)
             188     3                           zseen=(cpd*ptenh(jl,jk-1)+pgeoh(jl,jk-1))*zdmfen(jl)
             189     3                           zqeen=pqenh(jl,jk-1)*zdmfen(jl)
             190     3                           zsdde=(cpd*ptd(jl,jk-1)+pgeoh(jl,jk-1))*zdmfde(jl)
             191     3                           zqdde=pqd(jl,jk-1)*zdmfde(jl)
             192     3                           zmfdsk=pmfds(jl,jk-1)+zseen-zsdde
             193     3                           zmfdqk=pmfdq(jl,jk-1)+zqeen-zqdde
             194     3                           pqd(jl,jk)=zmfdqk*(1./min(-cmfcmin,pmfd(jl,jk)))
             195     3                           ptd(jl,jk)=(zmfdsk*(1./min(-cmfcmin,pmfd(jl,jk)))- &
             196     3                                      pgeoh(jl,jk))*rcpd
             197     3                           ptd(jl,jk)=min(400.,ptd(jl,jk))
             198     3                           ptd(jl,jk)=max(100.,ptd(jl,jk))
             199     3                           zcond(jl)=pqd(jl,jk)
             200     3                        end if
             201     2                     end do
             202     1               
             203     1                     ik=jk
             204     1                     icall=2
             205     1                     call cuadjtq_n(nxj, klon,klev,ik,zph,ptd,pqd,llo2,icall)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 125
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      llo2, zdmfde, pqd, pmfdde_rate, zcond
                                   <<<      prfl, pmfu, ptd, ptenh, pqenh, pmfd
                                   <<<      pdmfdp, pmfdq, pgeoh, pmfds, pgeo
                                   <<<    PREFETCH(SOFT) : 6
                                   <<<     SEQUENTIAL : 6
                                   <<<      pgeo: 2, zbuoy: 2, zoentr: 2
                                   <<<    SPILLS :

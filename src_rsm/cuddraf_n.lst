                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             206     2  pp    v             do jl = 1, nxj
             207     3   p    v               if(llo2(jl)) then
             208     3   p    v                  zcond(jl)=zcond(jl)-pqd(jl,jk)
             209     3   p    v                  zbuo=ptd(jl,jk)*(1.+vtmpc1*pqd(jl,jk))- &
             210     3                                ptenh(jl,jk)*(1.+vtmpc1*pqenh(jl,jk))
             211     4   p    v                  if(prfl(jl).gt.0..and.pmfu(jl,jk).gt.0.) then
             212     4   p    v                    zrain=prfl(jl)/pmfu(jl,jk)
             213     4   p    v                    zbuo=zbuo-ptd(jl,jk)*zrain
             214     4   p    v                  endif
             215     4   p    v                  if(zbuo.ge.0..or.prfl(jl).le.(pmfd(jl,jk)*zcond(jl))) then
             216     4   p    v                     pmfd(jl,jk)=0.
             217     4   p    v                     zbuo=0.
             218     4   p    v                  end if
             219     3   p    v                  pmfds(jl,jk)=(cpd*ptd(jl,jk)+pgeoh(jl,jk))*pmfd(jl,jk)
             220     3   p    v                  pmfdq(jl,jk)=pqd(jl,jk)*pmfd(jl,jk)
             221     3   p    v                  zdmfdp=-pmfd(jl,jk)*zcond(jl)
             222     3   p    v                  pdmfdp(jl,jk-1)=zdmfdp
             223     3   p    v                  prfl(jl)=prfl(jl)+zdmfdp
             224     3               ! compute organized entrainment for use at next level
             225     3   p    v                  zbuoyz=zbuo/ptenh(jl,jk)
             226     3   p    v                  zbuoyz=min(zbuoyz,0.0)
             227     3   p    v                  zdz=-(pgeo(jl,jk-1)-pgeo(jl,jk))
             228     3   p    v                  zbuoy(jl)=zbuoy(jl)+zbuoyz*zdz
             229     3   p    v                  zoentr(jl)=g*zbuoyz*0.5/(1.+zbuoy(jl))
             230     3   p    v                  pmfdde_rate(jl,jk) = -zdmfde(jl)
             231     3   p    v                end if
             232     2   p    v              end do
             233     1               
             234     1                     end do

            1503                     
            1504                     ! =======================================================================
            1505                     ! ice cloud microphysics processes
            1506                     ! bulk cloud micro - physics; processes splitting
            1507                     ! with some un - split sub - grouping
            1508                     ! time implicit (when possible) accretion and autoconversion
            1509                     ! author: shian - jiann lin, gfdl
            1510                     ! =======================================================================
            1511                     
            1512                     subroutine icloud (ks, ke, tzk, p1, qvk, qlk, qrk, qik, qsk, qgk, dp1, den, &
            1513                             ccn, cin, denfac, vts, vtg, vtr, qak, rh_adj, rh_rain, dts, h_var, &
            1514                             gsize, cond, dep, reevap, sub, last_step)
            1515                     
            1516                         implicit none
            1517                     
            1518                         logical, intent (in) :: last_step
            1519                         integer, intent (in) :: ks, ke
            1520                         real, intent (in), dimension (ks:ke) :: p1, dp1, den, denfac, vts, vtg, vtr, ccn
            1521                         real (kind = r8), intent (inout), dimension (ks:ke) :: tzk
            1522                         real, intent (inout), dimension (ks:ke) :: qvk, qlk, qrk, qik, qsk, qgk, qak
            1523                         real, intent (inout), dimension (ks:ke) :: cin

            1047                     ! -----------------------------------------------------------------------
            1048                     ! sedimentation of heat
            1049                     ! -----------------------------------------------------------------------
            1050                     
            1051                     subroutine sedi_heat (ks, ke, dm, m1, dz, tz, qv, ql, qr, qi, qs, qg, cw)
            1052                         ! revised with a precise energy conserving form: s. - j. lin, jan 22, 2018
            1053                         ! input q fields are dry mixing ratios, and dm is dry air mass
            1054                         implicit none
            1055                         integer, intent (in) :: ks, ke
            1056                         real, intent (in), dimension (ks:ke) :: dm, m1, dz, qv, ql, qr, qi, qs, qg
            1057                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            1058                         real, intent (in) :: cw ! heat capacity
            1059                         ! local:
            1060                         real, dimension (ks:ke) :: dgz, cv0
            1061                         integer :: k
            1062                     
            1063                         ! this is the vectorized loop
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qlz, qrz, qiz, qsz, dz1, dp1, m1_sol
                                   <<<      cv0, qvz, qgz, dgz, ql, qr, qi, qs, dz
                                   <<<      dm, m1, qv, qg, dp, m1_rain
                                   <<< Loop-information  End >>>
            1064     1  pp    v          do k = ks + 1, ke
            1065     1   p    v              dgz (k) = - g2 * (dz (k - 1) + dz (k))
            1066     1   p    v              cv0 (k) = dm (k) * (cv_air + qv (k) * cv_vap + (qr (k) + ql (k)) * c_liq + &
            1067     1                            (qi (k) + qs (k) + qg (k)) * c_ice) + cw * (m1 (k) - m1 (k - 1))
            1068     1                       ! cvm_new + cw * m1 (k) = cvm_old + cw * m1 (k - 1)
            1069     1   p    v          enddo
            1070                         ! -----------------------------------------------------------------------
            1071                         ! implicit algorithm: can't be vectorized
            1072                         ! needs an inner i - loop for vectorization
            1073                         ! -----------------------------------------------------------------------
            1074                         ! top layer: cv0 = cvn + cw * m1 (k)
            1075                         ! tz (k) = cv0 (k) * tz (k) / (cvn (k) + cw * m1 (k)) = tz (k) -- > no change
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.21, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      m1_sol, tz, cv0, dgz, m1, m1_rain
                                   <<< Loop-information  End >>>
            1076     1   s   2s          do k = ks + 1, ke
            1077     1   m   2m              tz (k) = (cv0 (k) * tz (k) + m1 (k - 1) * (cw * tz (k - 1) + dgz (k))) / (cv0 (k) + cw * m1 (k - 1))
            1078     1   p   2v          enddo
            1079                     
            1080                     end subroutine sedi_heat

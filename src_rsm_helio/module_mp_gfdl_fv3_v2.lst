             229                     
             230                         ! -----------------------------------------------------------------------
             231                         ! wrf / wsm6 scheme: qi_gen = 4.92e-11 * (1.e3 * exp (0.1 * tmp)) ** 1.33
             232                         ! optimized: qi_gen = 4.92e-11 * exp (1.33 * log (1.e3 * exp (0.1 * tmp)))
             233                         ! qi_gen ~ 4.808e-7 at 0 c; 1.818e-6 at - 10 c, 9.82679e-5 at - 40c
             234                         ! the following value is constructed such that qc_crt = 0 at zero c and @ - 10c matches
             235                         ! wrf / wsm6 ice initiation scheme; qi_crt = qi_gen * min (qi_lim, 0.1 * tmp) / den
             236                         ! -----------------------------------------------------------------------
             237                     
             238                         real :: sat_adj0 = 0.90 ! adjustment factor (0: no, 1: full) during fast_sat_adj
             239                     
             240                         real :: qc_crt = 5.0e-8 ! mini condensate mixing ratio to allow partial cloudiness
             241                     
             242                         real :: qi_lim = 1. ! cloud ice limiter to prevent large ice build up
             243                     
             244                         real :: ql_mlt = 2.0e-3 ! max value of cloud water allowed from melted cloud ice
             245                         real :: qs_mlt = 1.0e-6 ! max cloud water due to snow melt
             246                     
             247                         real :: ql_gen = 1.0e-3 ! max cloud water generation during remapping step if do_sat_adj = .t.
             248                         real :: qi_gen = 1.82e-6 ! max cloud ice generation during remapping step
             249                     
             250                         ! cloud condensate upper bounds: "safety valves" for ql & qi
             251                     
             252                         real :: ql0_max = 2.0e-3 ! max cloud water value (auto converted to rain)
             253                         real :: qi0_max = 1.0e-4 ! max cloud ice value (by other sources)
             254                     

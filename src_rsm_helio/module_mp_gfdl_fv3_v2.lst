             354                             qi0_crt, do_sat_adj, rh_inc, rh_ins, rh_inr, const_vi, &
             355                             const_vs, const_vg, const_vr, use_ccn, rthresh, ccn_l, ccn_o, qc_crt, &
             356                             tau_g2v, tau_v2g, sat_adj0, tau_imlt, tau_v2l, tau_l2v, &
             357                             tau_i2s, tau_l2r, qi_lim, ql_gen, c_paut, c_psaci, c_pgacs, &
             358                             z_slope_liq, z_slope_ice, prog_ccn, c_cracw, alin, clin, tice, &
             359                             rad_snow, rad_graupel, rad_rain, cld_fac, cld_min, use_ppm, use_ppm_ice, mono_prof, &
             360                             do_sedi_heat, sedi_transport, do_sedi_w, icloud_f, irain_f, &
             361                             ntimes, disp_heat, do_hail, use_xr_cloud, xr_a, xr_b, xr_c, tau_revp, tice_mlt, hd_icefall, &
             362                             do_cond_timescale, mp_time, consv_checker, te_err, use_park_cloud, &
             363                             use_gi_cloud, use_rhc_cevap, use_rhc_revap, inflag, do_warm_rain_mp, &
             364                             rh_thres, f_dq_p, f_dq_m, do_cld_adj
             365                     
             366                     contains
             367                     
             368                     ! -----------------------------------------------------------------------
             369                     ! the driver of the gfdl cloud microphysics
             370                     ! -----------------------------------------------------------------------
             371                     
             372                     subroutine gfdl_cld_mp_driver                                              &
             373                                 ( qv, ql, qr, qi, qs, qg, qa, qnl, qni,                        &
             374                                   pt, w, ua, va, dz, delp, gsize, dts, hs,                     &
             375                                   rain, snow, ice, graupel, hydrostatic,                       &
             376                                   is, ie, ks, ke, q_con, cappa, consv_te, te,                  &
             377                                   prefluxr, prefluxi, prefluxs, prefluxg,                      &
             378                                   condensation, deposition, evaporation, sublimation,          &
             379                                   last_step, do_inline_mp )
             380                     
             381                         implicit none
             382                     
             383                         logical, intent (in) :: hydrostatic
             384                         logical, intent (in) :: last_step
             385                         logical, intent (in) :: consv_te
             386                         logical, intent (in) :: do_inline_mp
             387                     
             388                         integer, intent (in) :: is, ie ! physics window
             389                         integer, intent (in) :: ks, ke ! vertical dimension
             390                     
             391                         real, intent (in) :: dts ! physics time step
             392                     
             393                         real, intent (in), dimension (is:ie) :: hs, gsize
             394                     
             395                         real, intent (in), dimension (is:ie, ks:ke) :: dz
             396                         real, intent (in), dimension (is:ie, ks:ke) :: qnl, qni
             397                     
             398                         real, intent (inout), dimension (is:ie, ks:ke) :: delp
             399                         real, intent (inout), dimension (is:ie, ks:ke) :: qv, ql, qr, qi, qs, qg, qa
             400                         real, intent (inout), dimension (is:ie, ks:ke) :: pt, ua, va, w
             401                         real, intent (inout), dimension (is:ie, ks:ke) :: prefluxr, prefluxi, prefluxs, prefluxg
             402                         real, intent (inout), dimension (is:, ks:) :: q_con, cappa
             403                         real, intent (inout), dimension (is:ie) :: rain, snow, ice, graupel
             404                         real, intent (inout), dimension (is:ie) :: condensation, deposition
             405                         real, intent (inout), dimension (is:ie) :: evaporation, sublimation
             406                     
             407                         real, intent (inout), dimension (is:ie, ks:ke) :: te
             408                         ! logical :: used
             409                         real, dimension (is:ie) :: w_var
             410                         real, dimension (is:ie, ks:ke) :: vt_r, vt_s, vt_g, vt_i
             411                         real, dimension (is:ie, ks:ke) :: m2_rain, m2_sol
             412                     
             413     1                   if (last_step) then
             414     1                       p_min = p0_min ! final clean - up
             415     1                   else
             416     1                       p_min = 30.e2 ! time saving trick
             417     1                   endif
             418                     
             419                         ! -----------------------------------------------------------------------
             420                         ! define heat capacity of dry air and water vapor based on hydrostatical property
             421                         ! -----------------------------------------------------------------------
             422                     
             423     1                   if (hydrostatic) then
             424     1                       c_air = cp_air
             425     1                       c_vap = cp_vap
             426     1                       do_sedi_w = .false.
             427     1                   else
             428     1                       c_air = cv_air
             429     1                       c_vap = cv_vap
             430     1                   endif
             431                         d0_vap = c_vap - c_liq
             432                     
             433                         ! scaled constants (to reduce fp errors for 32 - bit) :
             434                         d1_vap = d0_vap / c_air
             435                         d1_ice = dc_ice / c_air
             436                     
             437                         ! lv0 = hlv0 - (c_vap - c_liq) * t_ice! 3.13905782e6, evaporation latent heat coefficient at 0 deg k
             438                         lv00 = (hlv0 - d0_vap * t_ice) / c_air
             439                         li00 = (hlf0 - dc_ice * t_ice) / c_air
             440                         li20 = lv00 + li00
             441                     
             442                         c1_vap = c_vap / c_air
             443                         c1_liq = c_liq / c_air
             444                         c1_ice = c_ice / c_air
             445                     
             446                         ! -----------------------------------------------------------------------
             447                         ! define latent heat coefficient used in wet bulb and bigg mechanism
             448                         ! -----------------------------------------------------------------------
             449                     
             450                         lat2 = (hlv + hlf) ** 2
             451                     
             452                         lcp = hlv / cp_air
             453                         icp = hlf / cp_air
             454                         tcp = (hlv + hlf) / cp_air
             455                     
             456                         ! tendency zero out for am moist processes should be done outside the driver
             457                     
             458                         ! -----------------------------------------------------------------------
             459                         ! major cloud microphysics
             460                         ! -----------------------------------------------------------------------
             461                     
             462                         call mpdrv (hydrostatic, ua, va, w, delp, pt, qv, ql, qr, qi, qs, qg, &
             463                             qa, qnl, qni, dz, is, ie, ks, ke, dts, &
             464                             rain, snow, graupel, ice, m2_rain, m2_sol, gsize, hs, &
             465                             w_var, vt_r, vt_s, vt_g, vt_i, q_con, cappa, consv_te, te, &
             466                             prefluxr, prefluxi, prefluxs, prefluxg, condensation, deposition, &
             467                             evaporation, sublimation, last_step, do_inline_mp)
             468                     
             469                     end subroutine gfdl_cld_mp_driver
             470                     
             471                     ! -----------------------------------------------------------------------
             472                     ! gfdl cloud microphysics, major program
             473                     ! lin et al., 1983, jam, 1065 - 1092, and
             474                     ! rutledge and hobbs, 1984, jas, 2949 - 2972
             475                     ! terminal fall is handled lagrangianly by conservative fv algorithm
             476                     ! pt: temperature (k)
             477                     ! 6 water species:
             478                     ! 1) qv: water vapor (kg / kg)
             479                     ! 2) ql: cloud water (kg / kg)
             480                     ! 3) qr: rain (kg / kg)
             481                     ! 4) qi: cloud ice (kg / kg)
             482                     ! 5) qs: snow (kg / kg)
             483                     ! 6) qg: graupel (kg / kg)
             484                     ! -----------------------------------------------------------------------
             485                     
             486                     subroutine mpdrv (hydrostatic, ua, va, w, delp, pt, qv, ql, qr, qi, qs, &
             487                             qg, qa, qnl, qni, dz, is, ie, ks, ke, dt_in, &
             488                             rain, snow, graupel, ice, m2_rain, m2_sol, gsize, hs, &
             489                             w_var, vt_r, vt_s, vt_g, vt_i, q_con, cappa, consv_te, te, &
             490                             prefluxr, prefluxi, prefluxs, prefluxg, condensation, deposition, &
             491                             evaporation, sublimation, last_step, do_inline_mp)
             492                     
             493                         implicit none
             494                     
             495                         logical, intent (in) :: hydrostatic
             496                         logical, intent (in) :: last_step
             497                         logical, intent (in) :: consv_te
             498                         logical, intent (in) :: do_inline_mp
             499                         integer, intent (in) :: is, ie, ks, ke
             500                         real, intent (in) :: dt_in
             501                         real, intent (in), dimension (is:ie) :: gsize
             502                         real, intent (in), dimension (is:ie) :: hs
             503                         real, intent (in), dimension (is:ie, ks:ke) :: dz
             504                         real, intent (in), dimension (is:ie, ks:ke) :: qnl, qni
             505                     
             506                         real, intent (inout), dimension (is:ie, ks:ke) :: delp
             507                         real, intent (inout), dimension (is:ie, ks:ke) :: qv, ql, qr, qi, qs, qg, qa
             508                         real, intent (inout), dimension (is:ie, ks:ke) :: pt, ua, va, w
             509                         real, intent (inout), dimension (is:ie, ks:ke) :: prefluxr, prefluxi, prefluxs, prefluxg
             510                         real, intent (inout), dimension (is:, ks:) :: q_con, cappa
             511                         real, intent (inout), dimension (is:ie) :: rain, snow, ice, graupel
             512                         real, intent (inout), dimension (is:ie) :: condensation, deposition
             513                         real, intent (inout), dimension (is:ie) :: evaporation, sublimation
             514                     
             515                         real, intent (out), dimension (is:ie) :: w_var
             516                         real, intent (out), dimension (is:ie, ks:ke) :: vt_r, vt_s, vt_g, vt_i
             517                         real, intent (out), dimension (is:ie, ks:ke) :: m2_rain, m2_sol
             518                         real, intent (out), dimension (is:ie, ks:ke) :: te
             519                         ! local:
             520                         real, dimension (ks:ke) :: q_liq, q_sol
             521                         real, dimension (ks:ke) :: qvz, qlz, qrz, qiz, qsz, qgz, qaz
             522                         real, dimension (ks:ke) :: vtiz, vtsz, vtgz, vtrz, pfr, pfi, pfs, pfg
             523                         real, dimension (ks:ke) :: dp1, dz1
             524                         real, dimension (ks:ke) :: den, p1, denfac
             525                         real, dimension (ks:ke) :: ccn, cin, c_praut, m1_rain, m1_sol, m1
             526                         real, dimension (ks:ke) :: u0, v0, u1, v1, w1
             527                     
             528                         real (kind = r8), dimension (is:ie, ks:ke) :: te_beg, te_end, tw_beg, tw_end
             529                         real (kind = r8), dimension (is:ie, ks:ke) :: te_beg_0, te_end_0, tw_beg_0, tw_end_0
             530                         real (kind = r8), dimension (is:ie) :: te_b_beg, te_b_end, tw_b_beg, tw_b_end, dte, te_loss
             531                         real (kind = r8), dimension (is:ie) :: te_b_beg_0, te_b_end_0, tw_b_beg_0, tw_b_end_0
             532                         real (kind = r8), dimension (ks:ke) :: te1, te2
             533                     
             534                         real :: cpaut, rh_adj, rh_rain
             535                         real :: r1, s1, i1, g1, rdt, ccn0
             536                         real :: dt_rain
             537                         real :: s_leng, t_land, t_ocean, h_var, tmp
             538                         real (kind = r8), dimension (ks:ke) :: dp0, tz, cvm
             539                         real (kind = r8) :: con_r8, c8
             540                         real :: convt
             541                         real :: dts, q_cond
             542                         real :: nl, ni
             543                         real :: cond, dep, reevap, sub
             544                     
             545                         integer :: i, k, n
             546                     
             547                         logical  :: last_step_cld=.false.
             548                     
             549                         ntimes = max (ntimes, int (dt_in / min (dt_in, mp_time)))
             550                         dts = dt_in / real (ntimes)
             551                     
             552                         dt_rain = dts * 0.5
             553                         rdt = one_r8 / dts
             554                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dte
                                   <<< Loop-information  End >>>
             555        pp   4v          dte = 0.0
             556                     
             557                         !! convert to mm / day (original)
             558                         ! convt = 86400. * rdt * rgrav
             559                     
             560                         !! convert to mm / s
             561                         ! convt = rdt * rgrav
             562                     
             563                         ! convert to mm
             564                         convt = rgrav
             565                     
             566                         ! -----------------------------------------------------------------------
             567                         ! use local variables
             568                         ! -----------------------------------------------------------------------
             569                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]

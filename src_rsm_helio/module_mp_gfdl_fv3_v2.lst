            4152                     
            4153                     real function d_sat (ta, den)
            4154                     
            4155                         implicit none
            4156                     
            4157                         real, intent (in) :: ta, den
            4158                     
            4159                         real :: es_w, es_i, ap1, tmin
            4160                     
            4161                         integer :: it
            4162                     
            4163                         tmin = table_ice - 160.
            4164                         ap1 = 10. * dim (ta, tmin) + 1.
            4165                         ap1 = min (2621., ap1)
            4166                         it = ap1
            4167                         es_w = tablew (it) + (ap1 - it) * desw (it)
            4168                         es_i = table2 (it) + (ap1 - it) * des2 (it)
            4169                         d_sat = dim (es_w, es_i) / (rvgas * ta * den) ! take positive difference
            4170                     
            4171                     end function d_sat

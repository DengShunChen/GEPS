            1834     4                                   ! * sink * terms to qr: psacr + pgfr
            1835     4                                   ! source terms to qs: psacr
            1836     4                                   ! source terms to qg: pgfr
            1837     4                                   ! -----------------------------------------------------------------------
            1838     4               
            1839     4                                   ! -----------------------------------------------------------------------
            1840     4                                   ! psacr accretion of rain by snow
            1841     4                                   ! -----------------------------------------------------------------------
            1842     4               
            1843     5   p    v                          if (qs > 1.e-7) then ! if snow exists
            1844     5   pi   v                              psacr = dts * acr3d (vts (k), vtr (k), qr, qs, csacr, acco (1, 2), den (k))
            1845     5   p    v                          else
            1846     5   p    v                              psacr = 0.
            1847     5   p    v                          endif
            1848     4               
            1849     4                                   ! -----------------------------------------------------------------------
            1850     4                                   ! pgfr: rain freezing -- > graupel
            1851     4                                   ! -----------------------------------------------------------------------
            1852     4               
            1853     4   p    v                          pgfr = dts * cgfr (1) / den (k) * (exp (- cgfr (2) * tc) - 1.) * &
            1854     4                                       exp (1.75 * log (qr * den (k)))
            1855     4               
            1856     4                                   ! -----------------------------------------------------------------------
            1857     4                                   ! total sink to qr
            1858     4                                   ! -----------------------------------------------------------------------
            1859     4               
            1860     4   p    v                          sink = psacr + pgfr
            1861     4   p    v                          factor = min (sink, qr, - tc / icpk (k)) / max (sink, qrmin)
            1862     4               
            1863     4   p    v                          psacr = factor * psacr
            1864     4   p    v                          pgfr = factor * pgfr
            1865     4               
            1866     4   p    v                          sink = psacr + pgfr
            1867     4   p    v                          qr = qr - sink
            1868     4   p    v                          qs = qs + psacr
            1869     4   p    v                          qg = qg + pgfr
            1870     4   p    v                          q_liq (k) = q_liq (k) - sink
            1871     4   p    v                          q_sol (k) = q_sol (k) + sink
            1872     4               
            1873     4   p    v                          cvm (k) = one_r8 + qv * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            1874     4   p    v                          tz = (te8 (k) - lv00 * qv + li00 * q_sol (k)) / cvm (k)
            1875     4   p    v                          icpk (k) = (li00 + d1_ice * tz) / cvm (k)
            1876     4   p    v                      endif
            1877     3               
            1878     3                               ! -----------------------------------------------------------------------
            1879     3                               ! graupel production terms:
            1880     3                               ! -----------------------------------------------------------------------
            1881     3               
            1882     4   p    v                      if (qs > 1.e-7) then
            1883     4               
            1884     4                                   ! -----------------------------------------------------------------------
            1885     4                                   ! accretion: snow -- > graupel
            1886     4                                   ! -----------------------------------------------------------------------
            1887     4               
            1888     5   p    v                          if (qg > qrmin) then
            1889     5   pi   v                              sink = dts * acr3d (vtg (k), vts (k), qs, qg, cgacs, acco (1, 4), den (k))
            1890     5   p    v                          else
            1891     5   p    v                              sink = 0.
            1892     5   p    v                          endif
            1893     4               
            1894     4                                   ! -----------------------------------------------------------------------
            1895     4                                   ! autoconversion snow -- > graupel
            1896     4                                   ! -----------------------------------------------------------------------
            1897     4               
            1898     4   p    v                          qsm = qs0_crt / den (k)
            1899     5   p    v                          if (qs > qsm) then
            1900     5   p    v                              factor = dts * 1.e-3 * exp (0.09 * (tz - tice))
            1901     5   p    v                              sink = sink + factor / (1. + factor) * (qs - qsm)
            1902     5   p    v                          endif
            1903     4   p    v                          sink = min (qs, sink)
            1904     4   p    v                          qs = qs - sink
            1905     4   p    v                          qg = qg + sink
            1906     4               
            1907     4   p    v                      endif ! snow existed
            1908     3               
            1909     4   p    v                      if (qg > 1.e-7 .and. tz < tice) then
            1910     4               
            1911     4                                   ! -----------------------------------------------------------------------
            1912     4                                   ! pgacw: accretion of cloud water by graupel
            1913     4                                   ! -----------------------------------------------------------------------
            1914     4               
            1915     5   p    v                          if (ql > 1.e-6) then
            1916     5   p    v                              qden = qg * den (k)
            1917     5   p    v                              factor = dts * cgacw * qden / sqrt (den (k) * sqrt (sqrt (qden)))
            1918     5   p    v                              pgacw = factor / (1. + factor) * ql
            1919     5   p    v                          else
            1920     5   p    v                              pgacw = 0.
            1921     5   p    v                          endif
            1922     4               
            1923     4                                   ! -----------------------------------------------------------------------
            1924     4                                   ! pgacr: accretion of rain by graupel
            1925     4                                   ! -----------------------------------------------------------------------
            1926     4               
            1927     5   p    v                          if (qr > 1.e-6) then
            1928     5   pi   v                              pgacr = min (dts * acr3d (vtg (k), vtr (k), qr, qg, cgacr, acco (1, 3), &
            1929     5                                           den (k)), qr)
            1930     5   p    v                          else
            1931     5   p    v                              pgacr = 0.
            1932     5   p    v                          endif
            1933     4               
            1934     4   p    v                          sink = pgacr + pgacw
            1935     4   p    v                          factor = min (sink, dim (tice, tz) / icpk (k)) / max (sink, qrmin)
            1936     4   p    v                          pgacr = factor * pgacr
            1937     4   p    v                          pgacw = factor * pgacw
            1938     4               
            1939     4   p    v                          sink = pgacr + pgacw
            1940     4   p    v                          qg = qg + sink
            1941     4   p    v                          qr = qr - pgacr
            1942     4   p    v                          ql = ql - pgacw
            1943     4               
            1944     4   p    v                          q_liq (k) = q_liq (k) - sink
            1945     4   p    v                          q_sol (k) = q_sol (k) + sink
            1946     4   p    v                          tz = (te8 (k) - lv00 * qv + li00 * q_sol (k)) / (one_r8 + qv * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice)
            1947     4   p    v                      endif
            1948     3               
            1949     3   p    v                  endif
            1950     2               
            1951     2   p    v                  tzk (k) = tz
            1952     2   p    v                  qvk (k) = qv
            1953     2   p    v                  qlk (k) = ql
            1954     2   p    v                  qik (k) = qi
            1955     2   p    v                  qrk (k) = qr
            1956     2   p    v                  qsk (k) = qs
            1957     2   p    v                  qgk (k) = qg
            1958     2               
            1959     2   p    v              enddo
            1960     1               
            1961     1                   endif
            1962                     
            1963                         call subgrid_z_proc (ks, ke, p1, den, denfac, dts, rh_adj, tzk, qvk, qlk, &
            1964                             qrk, qik, qsk, qgk, qak, dp1, h_var, rh_rain, te8, ccn, cin, gsize, &
            1965                             cond, dep, reevap, sub, last_step)
            1966                     
            1967                     end subroutine icloud
            1968                     
            1969                     ! =======================================================================
            1970                     ! temperature sentive high vertical resolution processes
            1971                     ! =======================================================================
            1972                     
            1973                     subroutine subgrid_z_proc (ks, ke, p1, den, denfac, dts, rh_adj, tz, qv, ql, qr, &
            1974                             qi, qs, qg, qa, dp1, h_var, rh_rain, te8, ccn, cin, gsize, cond, dep, reevap, sub, last_step)
            1975                     
            1976                         implicit none
            1977                     
            1978                         integer, intent (in) :: ks, ke
            1979                         real, intent (in) :: dts, rh_adj, h_var, rh_rain, gsize
            1980                         real, intent (in), dimension (ks:ke) :: p1, den, denfac, ccn, dp1
            1981                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            1982                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            1983                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg, qa
            1984                         real, intent (inout), dimension (ks:ke) :: cin
            1985                         logical, intent (in) :: last_step
            1986                         real, intent (out) :: cond, dep, reevap, sub
            1987                         ! local:
            1988                         real, dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            1989                         real, dimension (ks:ke) :: q_liq, q_sol, q_cond
            1990                         real (kind = r8), dimension (ks:ke) :: cvm
            1991                         real :: pidep, qi_crt
            1992                         real :: sigma, gam
            1993                         ! -----------------------------------------------------------------------
            1994                         ! qstar over water may be accurate only down to - 80 deg c with ~10% uncertainty
            1995                         ! must not be too large to allow psc
            1996                         ! -----------------------------------------------------------------------
            1997                         real :: rh, rqi, tin, qsw, qsi, qpz, qstar, rh_tem
            1998                         real :: dqsdt, dwsdt, dq, dq0, factor, tmp, liq, ice
            1999                         real :: q_plus, q_minus, dt_evap, dt_pisub
            2000                         real :: evap, sink, tc, dtmp, qa10, qa100
            2001                         real :: pssub, pgsub, tsq, qden
            2002                         real :: fac_l2v, fac_v2l, fac_g2v, fac_v2g
            2003                         integer :: k
            2004                     !    real, parameter :: qcldmin = 1.e-6   ! original
            2005                         real, parameter :: qcldmin = 1.e-8   ! GFDLMP_v1
            2006                     !    real, parameter :: qcldmin = 1.e-15  ! GFDLMP_v3
            2007                     
            2008     1                   if (do_sat_adj) then
            2009     1                       dt_evap = 0.5 * dts
            2010     1                   else
            2011     1                       dt_evap = dts
            2012     1                   endif
            2013                     
            2014                         ! -----------------------------------------------------------------------
            2015                         ! define conversion scalar / factor
            2016                         ! -----------------------------------------------------------------------
            2017                     
            2018                         fac_l2v = 1. - exp (- dt_evap / tau_l2v)
            2019                         fac_v2l = 1. - exp (- dt_evap / tau_v2l)
            2020                         fac_g2v = 1. - exp (- dts / tau_g2v)
            2021                         fac_v2g = 1. - exp (- dts / tau_v2g)
            2022                     
            2023                         ! -----------------------------------------------------------------------
            2024                         ! define heat capacity and latend heat coefficient
            2025                         ! -----------------------------------------------------------------------
            2026                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 191
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.75, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs, qi, qr, ql, qv, qg, tz, q_sol, icpk
                                   <<<      tcp3, lcpk, cvm, q_liq
                                   <<< Loop-information  End >>>
            2027     1  pp    v          do k = ks, ke
            2028     1   p    v              q_liq (k) = ql (k) + qr (k)
            2029     1   p    v              q_sol (k) = qi (k) + qs (k) + qg (k)
            2030     1   p    v              cvm (k) = one_r8 + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            2031     1   p    v              lcpk (k) = (lv00 + d1_vap * tz (k)) / cvm (k)
            2032     1   p    v              icpk (k) = (li00 + d1_ice * tz (k)) / cvm (k)
            2033     1   p    v              tcp3 (k) = lcpk (k) + icpk (k) * min (1., dim (tice, tz (k)) / (tice - t_wfr))
            2034     1   p    v          enddo
            2035                     
            2036                         cond = 0
            2037                         dep = 0
            2038                         reevap = 0
            2039                         sub = 0
            2040                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      p1
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 52
                                   <<<      SIMD&FP   : SPILL 5  FILL 21
                                   <<<      SCALABLE  : SPILL 0  FILL 8
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2041     1                   do k = ks, ke
            2042     1               
            2043     1                       if (p1 (k) < p_min) cycle
            2044     1               
            2045     2                       if (.not. do_warm_rain_mp) then
            2046     2               
            2047     2                           ! -----------------------------------------------------------------------
            2048     2                           ! instant deposit all water vapor to cloud ice when temperature is super low
            2049     2                           ! -----------------------------------------------------------------------
            2050     2               
            2051     3                           if (tz (k) < t_min) then
            2052     3                               sink = dim (qv (k), 1.e-7)
            2053     3                               dep = dep + sink * dp1 (k)
            2054     3                               qv (k) = qv (k) - sink
            2055     3                               qi (k) = qi (k) + sink
            2056     3                               q_sol (k) = q_sol (k) + sink
            2057     3                               tz (k) = (te8 (k) - lv00 * qv (k) + li00 * q_sol (k)) / &
            2058     3                                    (one_r8 + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice)
            2059     3                               if (do_qa) qa (k) = 1. ! air fully saturated; 100 % cloud cover
            2060     3                               cycle
            2061     3                           endif
            2062     2               
            2063     2                           ! -----------------------------------------------------------------------
            2064     2                           ! instant evaporation / sublimation of all clouds if rh < rh_adj -- > cloud free
            2065     2                           ! -----------------------------------------------------------------------
            2066     2                           ! rain water is handled in warm - rain process.
            2067     2                           qpz = qv (k) + ql (k) + qi (k)
            2068     2                           tin = (te8 (k) - lv00 * qpz + li00 * (qs (k) + qg (k))) / &
            2069     2                                (one_r8 + qpz * c1_vap + qr (k) * c1_liq + (qs (k) + qg (k)) * c1_ice)
            2070     3                           if (tin > t_sub + 6.) then
            2071     3    i                          rh = qpz / iqs1 (tin, den (k))
            2072     4                               if (rh < rh_adj) then ! qpz / rh_adj < qs
            2073     4                                   reevap = reevap + ql (k) * dp1 (k)
            2074     4                                   sub = sub + qi (k) * dp1 (k)
            2075     4                                   tz (k) = tin
            2076     4                                   qv (k) = qpz
            2077     4                                   ql (k) = 0.
            2078     4                                   qi (k) = 0.
            2079     4                                   cycle ! cloud free
            2080     4                               endif
            2081     3                           endif
            2082     2               
            2083     2                       endif
            2084     1               
            2085     1                       ! -----------------------------------------------------------------------
            2086     1                       ! cloud water < -- > vapor adjustment:
            2087     1                       ! -----------------------------------------------------------------------
            2088     1               
            2089     1                       tin = tz (k)
            2090     1    i                  rh_tem = qpz / iqs1 (tin, den (k))
            2091     1    i                  qsw = wqs2 (tin, den (k), dwsdt)
            2092     1                       dq0 = qsw - qv (k)
            2093     2                       if (use_rhc_cevap) then
            2094     2                           evap = 0.
            2095     3                           if (rh_tem .lt. rhc_cevap) then
            2096     4                               if (dq0 > 0.) then ! evaporation
            2097     4                                   factor = min (1., fac_l2v * (10. * dq0 / qsw)) ! the rh dependent factor = 1 at 90%
            2098     4                                   evap = min (ql (k), factor * dq0 / (1. + tcp3 (k) * dwsdt))
            2099     4                                   reevap = reevap + evap * dp1 (k)
            2100     4                               elseif (do_cond_timescale) then
            2101     4                                   factor = min (1., fac_v2l * (10. * (- dq0) / qsw))
            2102     4                                   evap = - min (qv (k), factor * (- dq0) / (1. + tcp3 (k) * dwsdt))
            2103     4                                   cond = cond - evap * dp1 (k)
            2104     4                               else ! condensate all excess vapor into cloud water
            2105     4                                   evap = dq0 / (1. + tcp3 (k) * dwsdt)
            2106     4                                   cond = cond - evap * dp1 (k)
            2107     4                               endif
            2108     3                           endif
            2109     2                       else
            2110     3                           if (dq0 > 0.) then ! evaporation
            2111     3                               factor = min (1., fac_l2v * (10. * dq0 / qsw)) ! the rh dependent factor = 1 at 90%
            2112     3                               evap = min (ql (k), factor * dq0 / (1. + tcp3 (k) * dwsdt))
            2113     3                               reevap = reevap + evap * dp1 (k)
            2114     3                           elseif (do_cond_timescale) then
            2115     3                               factor = min (1., fac_v2l * (10. * (- dq0) / qsw))
            2116     3                               evap = - min (qv (k), factor * (- dq0) / (1. + tcp3 (k) * dwsdt))
            2117     3                               cond = cond - evap * dp1 (k)
            2118     3                           else ! condensate all excess vapor into cloud water
            2119     3                               evap = dq0 / (1. + tcp3 (k) * dwsdt)
            2120     3                               cond = cond - evap * dp1 (k)
            2121     3                           endif
            2122     2                       endif
            2123     1                       ! sjl on jan 23 2018: reversible evap / condensation:
            2124     1                       qv (k) = qv (k) + evap
            2125     1                       ql (k) = ql (k) - evap
            2126     1                       q_liq (k) = q_liq (k) - evap
            2127     1               
            2128     1                       cvm (k) = one_r8 + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            2129     1                       tz (k) = (te8 (k) - lv00 * qv (k) + li00 * q_sol (k)) / cvm (k)
            2130     1               
            2131     1                       ! -----------------------------------------------------------------------
            2132     1                       ! update heat capacity and latend heat coefficient
            2133     1                       ! -----------------------------------------------------------------------
            2134     1               
            2135     1                       icpk (k) = (li00 + d1_ice * tz (k)) / cvm (k)
            2136     1               
            2137     2                       if (.not. do_warm_rain_mp) then
            2138     2               
            2139     2                           ! -----------------------------------------------------------------------
            2140     2                           ! enforce complete freezing below - 48 c
            2141     2                           ! -----------------------------------------------------------------------
            2142     2               
            2143     2                           dtmp = t_wfr - tz (k) ! [ - 40, - 48]
            2144     3                           if (dtmp > 0. .and. ql (k) > qcmin) then
            2145     3                               sink = min (ql (k), ql (k) * dtmp * 0.125, dtmp / icpk (k))
            2146     3                               ql (k) = ql (k) - sink
            2147     3                               qi (k) = qi (k) + sink
            2148     3                               q_liq (k) = q_liq (k) - sink
            2149     3                               q_sol (k) = q_sol (k) + sink
            2150     3                               cvm (k) = one_r8 + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            2151     3                               tz (k) = (te8 (k) - lv00 * qv (k) + li00 * q_sol (k)) / cvm (k)
            2152     3                               icpk (k) = (li00 + d1_ice * tz (k)) / cvm (k)
            2153     3                           endif
            2154     2               
            2155     2                           ! -----------------------------------------------------------------------
            2156     2                           ! bigg mechanism
            2157     2                           ! -----------------------------------------------------------------------
            2158     2               
            2159     3                           if (do_sat_adj) then
            2160     3                               dt_pisub = 0.5 * dts
            2161     3                           else
            2162     3                               dt_pisub = dts
            2163     3                               tc = tice - tz (k)
            2164     4                               if (ql (k) > qrmin .and. tc > 0.1) then
            2165     4                                   sink = 100. / (rhow * ccn (k)) * dts * (exp (0.66 * tc) - 1.) * ql (k) ** 2
            2166     4                                   sink = min (ql (k), tc / icpk (k), sink)
            2167     4                                   ql (k) = ql (k) - sink
            2168     4                                   qi (k) = qi (k) + sink
            2169     4                                   q_liq (k) = q_liq (k) - sink
            2170     4                                   q_sol (k) = q_sol (k) + sink
            2171     4                                   cvm (k) = one_r8 + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            2172     4                                   tz (k) = (te8 (k) - lv00 * qv (k) + li00 * q_sol (k)) / cvm (k)
            2173     4                               endif ! significant ql existed
            2174     3                           endif
            2175     2               
            2176     2                           ! -----------------------------------------------------------------------
            2177     2                           ! update capacity heat and latend heat coefficient
            2178     2                           ! -----------------------------------------------------------------------
            2179     2               
            2180     2                           tcpk (k) = (li20 + (d1_vap + d1_ice) * tz (k)) / cvm (k)
            2181     2               
            2182     2                           ! -----------------------------------------------------------------------
            2183     2                           ! sublimation / deposition of ice
            2184     2                           ! -----------------------------------------------------------------------
            2185     2               
            2186     3                           if (tz (k) < tice) then
            2187     3    i                          qsi = iqs2 (tz (k), den (k), dqsdt)
            2188     3                               dq = qv (k) - qsi
            2189     3                               sink = dq / (1. + tcpk (k) * dqsdt)
            2190     4                               if (qi (k) > qrmin) then
            2191     5                                   if (.not. prog_ccn) then
            2192     5                                       if (inflag .eq. 1) &
            2193     5                                           ! hong et al., 2004
            2194     5                                           cin (k) = 5.38e7 * exp (0.75 * log (qi (k) * den (k)))
            2195     5                                       if (inflag .eq. 2) &
            2196     5                                           ! meyers et al., 1992
            2197     5                                           cin (k) = exp (-2.80 + 0.262 * (tice - tz (k))) * 1000.0 ! convert from L^-1 to m^-3
            2198     5                                       if (inflag .eq. 3) &
            2199     5                                           ! meyers et al., 1992
            2200     5                                           cin (k) = exp (-0.639 + 12.96 * (qv (k) / qsi - 1.0)) * 1000.0 ! convert from L^-1 to m^-3
            2201     5                                       if (inflag .eq. 4) &
            2202     5                                           ! cooper, 1986
            2203     5                                           cin (k) = 5.e-3 * exp (0.304 * (tice - tz (k))) * 1000.0 ! convert from L^-1 to m^-3
            2204     5                                       if (inflag .eq. 5) &
            2205     5                                           ! flecther, 1962
            2206     5                                           cin (k) = 1.e-5 * exp (0.5 * (tice - tz (k))) * 1000.0 ! convert from L^-1 to m^-3
            2207     5                                   endif
            2208     4                                   pidep = dt_pisub * dq * 4.0 * 11.9 * exp (0.5 * log (qi (k) * den (k) * cin (k))) &
            2209     4                                        / (qsi * den (k) * lat2 / (0.0243 * rvgas * tz (k) ** 2) + 4.42478e4)
            2210     4                               else
            2211     4                                   pidep = 0.
            2212     4                               endif
            2213     4                               if (dq > 0.) then ! vapor - > ice
            2214     4                                   tmp = tice - tz (k)
            2215     4                                   ! 20160912: the following should produce more ice at higher altitude
            2216     4                                   ! qi_crt = 4.92e-11 * exp (1.33 * log (1.e3 * exp (0.1 * tmp))) / den (k)
            2217     4                                   qi_crt = qi_gen * min (qi_lim, 0.1 * tmp) / den (k)
            2218     4                                   sink = min (sink, max (qi_crt - qi (k), pidep), tmp / tcpk (k))
            2219     4                                   dep = dep + sink * dp1 (k)
            2220     4                               else ! ice -- > vapor
            2221     4                                   pidep = pidep * min (1., dim (tz (k), t_sub) * 0.2)
            2222     4                                   sink = max (pidep, sink, - qi (k))
            2223     4                                   sub = sub - sink * dp1 (k)
            2224     4                               endif
            2225     3                               qv (k) = qv (k) - sink
            2226     3                               qi (k) = qi (k) + sink
            2227     3                               q_sol (k) = q_sol (k) + sink
            2228     3                               cvm (k) = one_r8 + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            2229     3                               tz (k) = (te8 (k) - lv00 * qv (k) + li00 * q_sol (k)) / cvm (k)
            2230     3                           endif
            2231     2               
            2232     2                           ! -----------------------------------------------------------------------
            2233     2                           ! update capacity heat and latend heat coefficient
            2234     2                           ! -----------------------------------------------------------------------
            2235     2               
            2236     2                           tcpk (k) = (li20 + (d1_vap + d1_ice) * tz (k)) / cvm (k)
            2237     2               
            2238     2                           ! -----------------------------------------------------------------------
            2239     2                           ! sublimation / deposition of snow
            2240     2                           ! this process happens for all temp rage
            2241     2                           ! -----------------------------------------------------------------------
            2242     2               
            2243     3                           if (qs (k) > qrmin) then
            2244     3    i                          qsi = iqs2 (tz (k), den (k), dqsdt)
            2245     3                               qden = qs (k) * den (k)
            2246     3                               tmp = exp (0.65625 * log (qden))
            2247     3                               tsq = tz (k) * tz (k)
            2248     3                               dq = (qsi - qv (k)) / (1. + tcpk (k) * dqsdt)
            2249     3                               pssub = cssub (1) * tsq * (cssub (2) * sqrt (qden) + cssub (3) * tmp * &
            2250     3                                   sqrt (denfac (k))) / (cssub (4) * tsq + cssub (5) * qsi * den (k))
            2251     3                               pssub = (qsi - qv (k)) * dts * pssub
            2252     4                               if (pssub > 0.) then ! qs -- > qv, sublimation
            2253     4                                   pssub = min (pssub * min (1., dim (tz (k), t_sub) * 0.2), qs (k))
            2254     4                                   sub = sub + pssub * dp1 (k)
            2255     4                               else
            2256     5                                   if (tz (k) > tice) then
            2257     5                                       pssub = 0. ! no deposition
            2258     5                                   else
            2259     5                                       pssub = max (pssub, dq, (tz (k) - tice) / tcpk (k))
            2260     5                                   endif
            2261     4                                   dep = dep - pssub * dp1 (k)
            2262     4                               endif
            2263     3                               qs (k) = qs (k) - pssub
            2264     3                               qv (k) = qv (k) + pssub
            2265     3                               q_sol (k) = q_sol (k) - pssub
            2266     3                               cvm (k) = one_r8 + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            2267     3                               tz (k) = (te8 (k) - lv00 * qv (k) + li00 * q_sol (k)) / cvm (k)
            2268     3                               tcpk (k) = (li20 + (d1_vap + d1_ice) * tz (k)) / cvm (k)
            2269     3                           endif
            2270     2               
            2271     2                           ! -----------------------------------------------------------------------
            2272     2                           ! sublimation / deposition of graupel
            2273     2                           ! this process happens for all temp rage
            2274     2                           ! -----------------------------------------------------------------------
            2275     2               
            2276     3                           if (qg (k) > qrmin) then
            2277     3    i                          qsi = iqs2 (tz (k), den (k), dqsdt)
            2278     3                               qden = qg (k) * den (k)
            2279     3                               tmp = exp (0.6875 * log (qden))
            2280     3                               tsq = tz (k) * tz (k)
            2281     3                               dq = (qsi - qv (k)) / (1. + tcpk (k) * dqsdt)
            2282     3                               pgsub = cgsub (1) * tsq * (cgsub (2) * sqrt (qden) + cgsub (3) * tmp / &
            2283     3                                   sqrt (sqrt (den (k)))) / (cgsub (4) * tsq + cgsub (5) * qsi * den (k))
            2284     3                               pgsub = (qsi - qv (k)) * dts * pgsub
            2285     4                               if (pgsub > 0.) then ! qs -- > qv, sublimation
            2286     4                                   pgsub = min (pgsub * min (1., dim (tz (k), t_sub) * 0.2), qg (k))
            2287     4                                   sub = sub + pgsub * dp1 (k)
            2288     4                               else
            2289     5                                   if (tz (k) > tice) then
            2290     5                                       pgsub = 0. ! no deposition
            2291     5                                   else
            2292     5                                       pgsub = max (pgsub, dq, (tz (k) - tice) / tcpk (k))
            2293     5                                   endif
            2294     4                                   dep = dep - pgsub * dp1 (k)
            2295     4                               endif
            2296     3                               qg (k) = qg (k) - pgsub
            2297     3                               qv (k) = qv (k) + pgsub
            2298     3                               q_sol (k) = q_sol (k) - pgsub
            2299     3                               cvm (k) = one_r8 + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            2300     3                               tz (k) = (te8 (k) - lv00 * qv (k) + li00 * q_sol (k)) / cvm (k)
            2301     3                               tcpk (k) = (li20 + (d1_vap + d1_ice) * tz (k)) / cvm (k)
            2302     3                           endif
            2303     2               
            2304     2                       endif
            2305     1               
            2306     1                       ! -----------------------------------------------------------------------
            2307     1                       ! compute cloud fraction
            2308     1                       ! -----------------------------------------------------------------------
            2309     1               
            2310     1                       ! -----------------------------------------------------------------------
            2311     1                       ! combine water species
            2312     1                       ! -----------------------------------------------------------------------
            2313     1               
            2314     1               !        if (.not. (do_qa .and. last_step)) cycle
            2315     1               !        if(do_qa) cycle
            2316     1                       if(.not. last_step) cycle
            2317     1               
            2318     1                       ice = q_sol (k)
            2319     2                       if (rad_snow) then
            2320     3                           if (rad_graupel) then
            2321     3                               q_sol (k) = qi (k) + qs (k) + qg (k)
            2322     3                           else
            2323     3                               q_sol (k) = qi (k) + qs (k)
            2324     3                           endif
            2325     2                       else
            2326     2                           q_sol (k) = qi (k)
            2327     2                       endif
            2328     1                       liq = q_liq (k)
            2329     2                       if (rad_rain) then
            2330     2                           q_liq (k) = ql (k) + qr (k)
            2331     2                       else
            2332     2                           q_liq (k) = ql (k)
            2333     2                       endif
            2334     1               
            2335     1                       q_cond (k) = q_liq (k) + q_sol (k)
            2336     1                       qpz = qv (k) + q_cond (k)
            2337     1               
            2338     1                       ! -----------------------------------------------------------------------
            2339     1                       ! use the "liquid - frozen water temperature" (tin) to compute saturated specific humidity
            2340     1                       ! -----------------------------------------------------------------------
            2341     1                       ! tin = tz (k) - (lcpk (k) * q_cond (k) + icpk (k) * q_sol (k)) ! minimum temperature
            2342     1                       !! tin = (tz (k) * cvm (i) + li00 * q_sol (k) - lv00 * q_cond (k)) / &
            2343     1                       !! (one_r8 + (qv (k) + q_cond (k)) * c1_vap)
            2344     1                       ice = ice - q_sol (k)
            2345     1                       liq = liq - q_liq (k)
            2346     1                       tin = (te8 (k) - lv00 * qpz + li00 * ice) / (one_r8 + qpz * c1_vap + liq * c1_liq + ice * c1_ice)
            2347     1                       ! -----------------------------------------------------------------------
            2348     1                       ! determine saturated specific humidity
            2349     1                       ! -----------------------------------------------------------------------
            2350     1               
            2351     2                       if (tin <= t_wfr) then
            2352     2                           ! ice phase:
            2353     2    i                      qstar = iqs1 (tin, den (k))
            2354     2                       elseif (tin >= tice) then
            2355     2                           ! liquid phase:
            2356     2    i                      qstar = wqs1 (tin, den (k))
            2357     2                       else
            2358     2                           ! mixed phase:
            2359     2    i                      qsi = iqs1 (tin, den (k))
            2360     2    i                      qsw = wqs1 (tin, den (k))
            2361     3                           if (q_cond (k) > 3.e-6) then
            2362     3                               rqi = q_sol (k) / q_cond (k)
            2363     3                           else
            2364     3                               ! -----------------------------------------------------------------------
            2365     3                               ! mostly liquid water q_cond (k) at initial cloud development stage
            2366     3                               ! -----------------------------------------------------------------------
            2367     3                               rqi = (tice - tin) / (tice - t_wfr)
            2368     3                           endif
            2369     2                           qstar = rqi * qsi + (1. - rqi) * qsw
            2370     2                       endif
            2371     1               
            2372     1                       ! -----------------------------------------------------------------------
            2373     1                       ! assuming subgrid linear distribution in horizontal; this is effectively a smoother for the
            2374     1                       ! binary cloud scheme
            2375     1                       ! -----------------------------------------------------------------------
            2376     1               
            2377     1                       ! -----------------------------------------------------------------------
            2378     1                       ! partial cloudiness by pdf:
            2379     1                       ! assuming subgrid linear distribution in horizontal; this is effectively a smoother for the
            2380     1                       ! binary cloud scheme; qa = 0.5 if qstar == qpz
            2381     1                       ! -----------------------------------------------------------------------
            2382     1               
            2383     1                       qpz = cld_fac * qpz
            2384     1                       rh = qpz / qstar
            2385     1               
            2386     1                       ! -----------------------------------------------------------------------
            2387     1                       ! icloud_f = 0: bug - fixed
            2388     1                       ! icloud_f = 1: old fvgfs gfdl) mp implementation
            2389     1                       ! icloud_f = 2: binary cloud scheme (0 / 1)
            2390     1                       ! icloud_f = 3: revision of icloud = 0
            2391     1                       ! -----------------------------------------------------------------------
            2392     1               
            2393     2                       if (use_xr_cloud) then ! xu and randall cloud scheme (1996)
            2394     3                           if (rh >= 1.0) then
            2395     3                               qa (k) = 1.0
            2396     3                           elseif (rh > rh_thres .and. q_cond (k) > qcldmin) then
            2397     3                               qa (k) = rh ** xr_a * (1.0 - exp (- xr_b * max (0.0, q_cond (k)) / &
            2398     3                                   max (1.e-5, (max (1.e-10, 1.0 - rh) * qstar) ** xr_c)))
            2399     3                               qa (k) = max (0.0, min (1., qa (k)))
            2400     3                           else
            2401     3                               qa (k) = 0.0
            2402     3                           endif
            2403     2                       elseif (use_park_cloud) then ! park et al. 2016 (mon. wea. review)
            2404     3                           if (q_cond (k) > qcldmin) then
            2405     3                               qa (k) = 1. / 50. * (5.77 * (100. - gsize / 1000.) * max (0.0, q_cond (k) * 1000.) ** 1.07 + &
            2406     3                                   4.82 * (gsize / 1000. - 50.) * max (0.0, q_cond (k) * 1000.) ** 0.94)
            2407     3                               qa (k) = qa (k) * (0.92 / 0.96 * q_liq (k) / q_cond (k) + 1.0 / 0.96 * q_sol (k) / q_cond (k))
            2408     3                               qa (k) = max (0.0, min (1., qa (k)))
            2409     3                           else
            2410     3                               qa (k) = 0.0
            2411     3                           endif
            2412     2                       elseif (use_gi_cloud) then ! gultepe and isaac (2007)
            2413     2                           sigma = 0.28 + max (0.0, q_cond (k) * 1000.) ** 0.49
            2414     2                           gam = max (0.0, q_cond (k) * 1000.) / sigma
            2415     3                           if (gam < 0.18) then
            2416     3                               qa10 = 0.
            2417     3                           elseif (gam > 2.0) then
            2418     3                               qa10 = 1.0
            2419     3                           else
            2420     3                               qa10 = - 0.1754 + 0.9811 * gam - 0.2223 * gam ** 2 + 0.0104 * gam ** 3
            2421     3                               qa10 = max (0.0, min (1., qa10))
            2422     3                           endif
            2423     2                           sigma = 0.18 + max (0.0, q_cond (k) * 1000.) ** 0.48   !xb141
            2424     2                           gam = max (0.0, q_cond (k) * 1000.) / sigma            !xb141
            2425     3                           if (gam < 0.12) then
            2426     3                               qa100 = 0.
            2427     3                           elseif (gam > 1.85) then
            2428     3                               qa100 = 1.0
            2429     3                           else
            2430     3                               qa100 = - 0.0913 + 0.7213 * gam + 0.1060 * gam ** 2 - 0.0946 * gam ** 3
            2431     3                               qa100 = max (0.0, min (1., qa100))
            2432     3                           endif
            2433     2                           qa (k) = qa10 + (log10 (gsize / 1000.) - 1) * (qa100 - qa10)
            2434     2                           qa (k) = max (0.0, min (1., qa (k)))
            2435     2                       else
            2436     3                           if (rh > rh_thres .and. qpz > qcldmin) then
            2437     3               
            2438     3                               dq = h_var * qpz
            2439     4                               if (do_cld_adj) then
            2440     4                                   q_plus = qpz + dq * f_dq_p * min(1.0, max(0.0, (p1 (k) - 200.e2) / (1000.e2 - 200.e2)))
            2441     4                               else
            2442     4                                   q_plus = qpz + dq * f_dq_p
            2443     4                               endif
            2444     3                               q_minus = qpz - dq * f_dq_m
            2445     3               
            2446     4                               if (icloud_f .eq. 2) then
            2447     5                                   if (qstar < qpz) then
            2448     5                                       qa (k) = 1.
            2449     5                                   else
            2450     5                                       qa (k) = 0.
            2451     5                                   endif
            2452     4                               elseif (icloud_f .eq. 3) then
            2453     5                                   if (qstar < qpz) then
            2454     5                                       qa (k) = 1.
            2455     5                                   else
            2456     6                                       if (qstar < q_plus) then
            2457     6                                           qa (k) = (q_plus - qstar) / (dq * f_dq_p)
            2458     6                                       else
            2459     6                                           qa (k) = 0.
            2460     6                                       endif
            2461     5                                       ! impose minimum cloudiness if substantial q_cond (k) exist
            2462     6                                       if (q_cond (k) > qcldmin) then
            2463     6                                           qa (k) = max (cld_min, qa (k))
            2464     6                                       endif
            2465     5                                       qa (k) = min (1., qa (k))
            2466     5                                   endif
            2467     4                               else
            2468     5                                   if (qstar < q_minus) then
            2469     5                                       qa (k) = 1.
            2470     5                                   else
            2471     6                                       if (qstar < q_plus) then
            2472     7                                           if (icloud_f .eq. 0) then
            2473     7                                               qa (k) = (q_plus - qstar) / (dq * f_dq_p + dq * f_dq_m)
            2474     7                                           else
            2475     7                                               qa (k) = (q_plus - qstar) / ((dq * f_dq_p + dq * f_dq_m) * (1. - q_cond (k)))
            2476     7                                           endif
            2477     6                                       else
            2478     6                                           qa (k) = 0.
            2479     6                                       endif
            2480     5                                       ! impose minimum cloudiness if substantial q_cond (k) exist
            2481     6                                       if (q_cond (k) > qcldmin) then
            2482     6                                           qa (k) = max (cld_min, qa (k))
            2483     6                                       endif
            2484     5                                       qa (k) = min (1., qa (k))
            2485     5                                   endif
            2486     4                               endif
            2487     3                           else
            2488     3                               qa (k) = 0.
            2489     3                           endif
            2490     2                       endif
            2491     1               
            2492     1                   enddo
            2493                     
            2494                     end subroutine subgrid_z_proc
            2495                     
            2496                     ! =======================================================================
            2497                     ! rain evaporation
            2498                     ! =======================================================================
            2499                     
            2500                     subroutine revap_rac1 (hydrostatic, is, ie, dt, tz, qv, ql, qr, qi, qs, qg, den, hvar)
            2501                     
            2502                         implicit none
            2503                     
            2504                         logical, intent (in) :: hydrostatic
            2505                     
            2506                         integer, intent (in) :: is, ie
            2507                     
            2508                         real, intent (in) :: dt ! time step (s)
            2509                     
            2510                         real, intent (in), dimension (is:ie) :: den, hvar, qi, qs, qg
            2511                     
            2512                         real, intent (inout), dimension (is:ie) :: tz, qv, qr, ql
            2513                     
            2514                         real, dimension (is:ie) :: lcp2, denfac, q_liq, q_sol, cvm, lhl
            2515                     
            2516                         real :: dqv, qsat, dqsdt, evap, qden, q_plus, q_minus, sink
            2517                         real :: tin, t2, qpz, dq, dqh
            2518                     
            2519                         integer :: i
            2520                     
            2521                         ! -----------------------------------------------------------------------
            2522                         ! define latend heat coefficient
            2523                         ! -----------------------------------------------------------------------
            2524                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 281
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ql, qv, qg, tz, qs, q_sol, cvm, q_liq
                                   <<<      qi, qr, lcp2, lhl
                                   <<< Loop-information  End >>>
            2525     1  pp    v          do i = is, ie
            2526     1   p    v              lhl (i) = lv00 + d0_vap * tz (i)
            2527     1   p    v              q_liq (i) = ql (i) + qr (i)
            2528     1   p    v              q_sol (i) = qi (i) + qs (i) + qg (i)
            2529     1   p    v              cvm (i) = c_air + qv (i) * c_vap + q_liq (i) * c_liq + q_sol (i) * c_ice
            2530     1   p    v              lcp2 (i) = lhl (i) / cvm (i)
            2531     1                       ! denfac (i) = sqrt (sfcrho / den (i))
            2532     1   p    v          enddo
            2533                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qr
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 5
                                   <<<      SIMD&FP   : SPILL 1  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2534     1                   do i = is, ie
            2535     2                       if (qr (i) > qrmin .and. tz (i) > t_wfr) then
            2536     2                           qpz = qv (i) + ql (i)
            2537     2                           tin = tz (i) - lcp2 (i) * ql (i) ! presence of clouds suppresses the rain evap
            2538     2    i                      qsat = wqs2 (tin, den (i), dqsdt)
            2539     2                           dqh = max (ql (i), hvar (i) * max (qpz, qcmin))
            2540     2                           dqv = qsat - qv (i)
            2541     2                           q_minus = qpz - dqh
            2542     2                           q_plus = qpz + dqh
            2543     2               
            2544     2                           ! -----------------------------------------------------------------------
            2545     2                           ! qsat must be > q_minus to activate evaporation
            2546     2                           ! qsat must be < q_plus to activate accretion
            2547     2                           ! -----------------------------------------------------------------------
            2548     2               
            2549     2                           ! -----------------------------------------------------------------------
            2550     2                           ! rain evaporation
            2551     2                           ! -----------------------------------------------------------------------
            2552     2               
            2553     3                           if (dqv > qvmin .and. qsat > q_minus) then
            2554     4                               if (qsat > q_plus) then
            2555     4                                   dq = qsat - qpz
            2556     4                               else
            2557     4                                   ! q_minus < qsat < q_plus
            2558     4                                   ! dq == dqh if qsat == q_minus
            2559     4                                   dq = 0.25 * (q_minus - qsat) ** 2 / dqh
            2560     4                               endif
            2561     3                               qden = qr (i) * den (i)
            2562     3                               t2 = tin * tin
            2563     3                               evap = crevp (1) * t2 * dq * (crevp (2) * sqrt (qden) + crevp (3) * exp (0.725 * log (qden))) &
            2564     3                                    / (crevp (4) * t2 + crevp (5) * qsat * den (i))
            2565     3                               evap = min (qr (i), dt * evap, dqv / (1. + lcp2 (i) * dqsdt))
            2566     3                               qr (i) = qr (i) - evap
            2567     3                               qv (i) = qv (i) + evap
            2568     3                               q_liq (i) = q_liq (i) - evap
            2569     3                               cvm (i) = c_air + qv (i) * c_vap + q_liq (i) * c_liq + q_sol (i) * c_ice
            2570     3                               tz (i) = tz (i) - evap * lhl (i) / cvm (i)
            2571     3                           endif
            2572     2               
            2573     2                           ! -----------------------------------------------------------------------
            2574     2                           ! accretion: pracc
            2575     2                           ! -----------------------------------------------------------------------
            2576     2               
            2577     3                           if (qr (i) > qrmin .and. ql (i) > 1.e-8 .and. qsat < q_plus) then
            2578     3                               denfac (i) = sqrt (sfcrho / den (i))
            2579     3                               sink = dt * denfac (i) * cracw * exp (0.95 * log (qr (i) * den (i)))
            2580     3                               sink = sink / (1. + sink) * ql (i)
            2581     3                               ql (i) = ql (i) - sink
            2582     3                               qr (i) = qr (i) + sink
            2583     3                           endif
            2584     2                       endif
            2585     1                   enddo
            2586                     
            2587                     end subroutine revap_rac1
            2588                     
            2589                     ! =======================================================================
            2590                     ! compute terminal fall speed
            2591                     ! consider cloud ice, snow, and graupel's melting during fall
            2592                     ! =======================================================================
            2593                     
            2594                     subroutine terminal_fall (dtm, ks, ke, tz, qv, ql, qr, qg, qs, qi, dz, dp, &
            2595                             den, vtg, vts, vti, r1, g1, s1, i1, pfr, pfi, pfs, pfg, m1_sol, w1, dte)
            2596                     
            2597                         implicit none
            2598                     
            2599                         integer, intent (in) :: ks, ke
            2600                         real, intent (in) :: dtm ! time step (s)

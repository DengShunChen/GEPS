             639     2                           ! for sedi_momentum transport:
             640     2                           ! -----------------------------------------------------------------------
             641     2               
             642     2   p    v                  m1 (k) = 0.
             643     2   p    v                  u0 (k) = ua (i, k)
             644     2   p    v                  v0 (k) = va (i, k)
             645     3   p    v                  if (.not. hydrostatic) then
             646     3   p    v                      w1 (k) = w (i, k)
             647     3   p    v                  endif
             648     2   p    v                  u1 (k) = u0 (k)
             649     2   p    v                  v1 (k) = v0 (k)
             650     2   p    v                  denfac (k) = sqrt (sfcrho / den (k))
             651     2   p    v              enddo
             652     1               
             653     1                       ! -----------------------------------------------------------------------
             654     1                       ! fix energy conservation
             655     1                       ! -----------------------------------------------------------------------
             656     1               
             657     2                       if (consv_te) then
             658     3                           if (hydrostatic) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 176, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz

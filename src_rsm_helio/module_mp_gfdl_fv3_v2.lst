            4336                     ! =======================================================================
            4337                     ! saturation water vapor pressure table iii
            4338                     ! 2 - phase table
            4339                     ! =======================================================================
            4340                     
            4341                     subroutine qs_table2 (n)
            4342                     
            4343                         implicit none
            4344                     
            4345                         integer, intent (in) :: n
            4346                     
            4347                         real (kind = r8) :: delt = 0.1
            4348                         real (kind = r8) :: tmin, tem0, tem1, fac0, fac1, fac2
            4349                     
            4350                         integer :: i, i0, i1
            4351                     
            4352                         tmin = table_ice - 160.
            4353                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4354     1  pp    v          do i = 1, n
            4355     1   p    v              tem0 = tmin + delt * real (i - 1)
            4356     1   p    v              fac0 = (tem0 - t_ice) / (tem0 * t_ice)
            4357     2   p    v              if (i <= 1600) then
            4358     2                           ! -----------------------------------------------------------------------
            4359     2                           ! compute es over ice between - 160 deg c and 0 deg c.
            4360     2                           ! -----------------------------------------------------------------------
            4361     2   p    v                  fac1 = fac0 * li2
            4362     2   p    v                  fac2 = (d2ice * log (tem0 / t_ice) + fac1) / rvgas
            4363     2   p    v              else
            4364     2                           ! -----------------------------------------------------------------------
            4365     2                           ! compute es over water between 0 deg c and 102 deg c.
            4366     2                           ! -----------------------------------------------------------------------
            4367     2   p    v                  fac1 = fac0 * lv0
            4368     2   p    v                  fac2 = (dc_vap * log (tem0 / t_ice) + fac1) / rvgas
            4369     2   p    v              endif
            4370     1   p    v              table2 (i) = e00 * exp (fac2)
            4371     1   p    v          enddo
            4372                     
            4373                         ! -----------------------------------------------------------------------
            4374                         ! smoother around 0 deg c
            4375                         ! -----------------------------------------------------------------------
            4376                     
            4377                         i0 = 1600
            4378                         i1 = 1601
            4379                         tem0 = 0.25 * (table2 (i0 - 1) + 2. * table (i0) + table2 (i0 + 1))
            4380                         tem1 = 0.25 * (table2 (i1 - 1) + 2. * table (i1) + table2 (i1 + 1))
            4381                         table2 (i0) = tem0
            4382                         table2 (i1) = tem1
            4383                     
            4384                     end subroutine qs_table2
            4385                     
            4386                     ! =======================================================================
            4387                     ! saturation water vapor pressure table iv
            4388                     ! 2 - phase table with " - 2 c" as the transition point
            4389                     ! =======================================================================
            4390                     
            4391                     subroutine qs_table3 (n)
            4392                     
            4393                         implicit none
            4394                     
            4395                         integer, intent (in) :: n
            4396                     
            4397                         real (kind = r8) :: delt = 0.1
            4398                         real (kind = r8) :: esbasw, tbasw, esbasi, tmin, tem, aa, b, c, d, e
            4399                         real (kind = r8) :: tem0, tem1
            4400                     
            4401                         integer :: i, i0, i1
            4402                     
            4403                         esbasw = 1013246.0
            4404                         tbasw = table_ice + 100.
            4405                         esbasi = 6107.1
            4406                         tmin = table_ice - 160.
            4407                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 8
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table3
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 23  FILL 42
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4408     1  pp    v          do i = 1, n
            4409     1   p    v              tem = tmin + delt * real (i - 1)
            4410     1                       ! if (i <= 1600) then
            4411     2   p    v              if (i <= 1580) then ! change to - 2 c
            4412     2                           ! -----------------------------------------------------------------------
            4413     2                           ! compute es over ice between - 160 deg c and 0 deg c.
            4414     2                           ! see smithsonian meteorological tables page 350.
            4415     2                           ! -----------------------------------------------------------------------
            4416     2   p    v                  aa = - 9.09718 * (table_ice / tem - 1.)
            4417     2   p    v                  b = - 3.56654 * log10 (table_ice / tem)
            4418     2   p    v                  c = 0.876793 * (1. - tem / table_ice)
            4419     2   p    v                  e = log10 (esbasi)
            4420     2   p    v                  table3 (i) = 0.1 * 10 ** (aa + b + c + e)
            4421     2   p    v              else
            4422     2                           ! -----------------------------------------------------------------------
            4423     2                           ! compute es over water between - 2 deg c and 102 deg c.
            4424     2                           ! see smithsonian meteorological tables page 350.
            4425     2                           ! -----------------------------------------------------------------------
            4426     2   p    v                  aa = - 7.90298 * (tbasw / tem - 1.)
            4427     2   p    v                  b = 5.02808 * log10 (tbasw / tem)
            4428     2   p    v                  c = - 1.3816e-7 * (10 ** ((1. - tem / tbasw) * 11.344) - 1.)
            4429     2   p    v                  d = 8.1328e-3 * (10 ** ((tbasw / tem - 1.) * (- 3.49149)) - 1.)
            4430     2   p    v                  e = log10 (esbasw)
            4431     2   p    v                  table3 (i) = 0.1 * 10 ** (aa + b + c + d + e)
            4432     2   p    v              endif
            4433     1   p    v          enddo
            4434                     
            4435                         ! -----------------------------------------------------------------------
            4436                         ! smoother around - 2 deg c
            4437                         ! -----------------------------------------------------------------------
            4438                     
            4439                         i0 = 1580
            4440                         i1 = 1581
            4441                         tem0 = 0.25 * (table3 (i0 - 1) + 2. * table (i0) + table3 (i0 + 1))
            4442                         tem1 = 0.25 * (table3 (i1 - 1) + 2. * table (i1) + table3 (i1 + 1))
            4443                         table3 (i0) = tem0
            4444                         table3 (i1) = tem1
            4445                     
            4446                     end subroutine qs_table3
            4447                     
            4448                     ! =======================================================================
            4449                     ! compute the saturated specific humidity for table
            4450                     ! note: this routine is based on "moist" mixing ratio
            4451                     ! =======================================================================
            4452                     
            4453                     real function qs_blend (t, p, q)
            4454                     
            4455                         implicit none
            4456                     
            4457                         real, intent (in) :: t, p, q
            4458                     
            4459                         real :: es, ap1, tmin
            4460                     
            4461                         integer :: it
            4462                     
            4463                         tmin = table_ice - 160.
            4464                         ap1 = 10. * dim (t, tmin) + 1.
            4465                         ap1 = min (2621., ap1)
            4466                         it = ap1
            4467                         es = table (it) + (ap1 - it) * des (it)
            4468                         qs_blend = eps * es * (1. + zvir * q) / p
            4469                     
            4470                     end function qs_blend

            1335                     subroutine revap_racc (ks, ke, dt, tz, qv, ql, qr, qi, qs, qg, den, denfac, rh_rain, h_var, dp, reevap)
            1336                     
            1337                         implicit none
            1338                     
            1339                         integer, intent (in) :: ks, ke
            1340                         real, intent (in) :: dt ! time step (s)
            1341                         real, intent (in) :: rh_rain, h_var
            1342                         real, intent (in), dimension (ks:ke) :: den, denfac, dp
            1343                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            1344                         real, intent (inout), dimension (ks:ke) :: qv, qr, ql, qi, qs, qg
            1345                         real, intent (out) :: reevap
            1346                         ! local:
            1347                         real (kind = r8), dimension (ks:ke) :: cvm
            1348                         real, dimension (ks:ke) :: q_liq, q_sol, lcpk
            1349                         real :: dqv, qsat, dqsdt, evap, t2, qden, q_plus, q_minus, sink
            1350                         real :: qpz, dq, dqh, tin
            1351                         real :: fac_revp, rh_tem
            1352                     
            1353                         integer :: k
            1354                     
            1355     1                   if (tau_revp .gt. 1.e-6) then
            1356     1                       fac_revp = 1. - exp (- dt / tau_revp)
            1357     1                   else
            1358     1                       fac_revp = 1.
            1359     1                   endif
            1360                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 17
                                   <<<      SIMD&FP   : SPILL 1  FILL 5
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1361     1                   do k = ks, ke
            1362     1               
            1363     2                       if (tz (k) > t_wfr .and. qr (k) > qrmin) then
            1364     2               
            1365     2                           ! -----------------------------------------------------------------------
            1366     2                           ! define heat capacity and latent heat coefficient
            1367     2                           ! -----------------------------------------------------------------------
            1368     2               
            1369     2                           q_liq (k) = ql (k) + qr (k)
            1370     2                           q_sol (k) = qi (k) + qs (k) + qg (k)
            1371     2               
            1372     2                           cvm (k) = one_r8 + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            1373     2                           lcpk (k) = (lv00 + d1_vap * tz (k)) / cvm (k)
            1374     2                           tin = (tz (k) * cvm (k) - lv00 * ql (k)) / (1. + (qv (k) + ql (k)) * c1_vap + qr (k) * c1_liq + q_sol (k) * c1_ice)
            1375     2               
            1376     2                           qpz = qv (k) + ql (k)
            1377     2    i                      qsat = wqs2 (tin, den (k), dqsdt)
            1378     2                           dqh = max (ql (k), h_var * max (qpz, qcmin))
            1379     2                           dqh = min (dqh, 0.2 * qpz) ! new limiter
            1380     2                           dqv = qsat - qv (k) ! use this to prevent super - sat the gird box
            1381     2                           q_minus = qpz - dqh
            1382     2                           q_plus = qpz + dqh
            1383     2               
            1384     2                           ! -----------------------------------------------------------------------
            1385     2                           ! qsat must be > q_minus to activate evaporation
            1386     2                           ! qsat must be < q_plus to activate accretion
            1387     2                           ! -----------------------------------------------------------------------
            1388     2               
            1389     2                           ! -----------------------------------------------------------------------
            1390     2                           ! rain evaporation
            1391     2                           ! -----------------------------------------------------------------------
            1392     2               
            1393     2    i                      rh_tem = qpz / iqs1 (tin, den (k))
            1394     2               
            1395     3                           if (dqv > qvmin .and. qsat > q_minus) then
            1396     4                               if (qsat > q_plus) then
            1397     4                                   dq = qsat - qpz
            1398     4                               else
            1399     4                                   ! -----------------------------------------------------------------------
            1400     4                                   ! q_minus < qsat < q_plus
            1401     4                                   ! dq == dqh if qsat == q_minus
            1402     4                                   ! -----------------------------------------------------------------------
            1403     4                                   dq = 0.25 * (qsat - q_minus) ** 2 / dqh
            1404     4                               endif
            1405     3                               qden = qr (k) * den (k)
            1406     3                               t2 = tin * tin
            1407     4                               if (use_rhc_revap) then
            1408     4                                   evap = 0.0
            1409     5                                   if (rh_tem < rhc_revap) then
            1410     5                                       evap = crevp (1) * t2 * dq * (crevp (2) * sqrt (qden) + crevp (3) * &
            1411     5                                           exp (0.725 * log (qden)) * sqrt (denfac (k))) / (crevp (4) * t2 + crevp (5) * qsat * den (k))
            1412     5                                       evap = min (qr (k), dt * fac_revp * evap, dqv / (1. + lcpk (k) * dqsdt))
            1413     5                                   endif
            1414     4                               else
            1415     4                                   evap = crevp (1) * t2 * dq * (crevp (2) * sqrt (qden) + crevp (3) * &
            1416     4                                       exp (0.725 * log (qden))) / (crevp (4) * t2 + crevp (5) * qsat * den (k))
            1417     4                                   evap = min (qr (k), dt * fac_revp * evap, dqv / (1. + lcpk (k) * dqsdt))
            1418     4                               endif
            1419     3                               reevap = reevap + evap * dp (k)
            1420     3               
            1421     3                               ! -----------------------------------------------------------------------
            1422     3                               ! alternative minimum evap in dry environmental air
            1423     3                               ! sink = min (qr (k), dim (rh_rain * qsat, qv (k)) / (1. + lcpk (k) * dqsdt))
            1424     3                               ! evap = max (evap, sink)
            1425     3                               ! -----------------------------------------------------------------------
            1426     3                               qr (k) = qr (k) - evap
            1427     3                               qv (k) = qv (k) + evap
            1428     3                               q_liq (k) = q_liq (k) - evap
            1429     3                               tz (k) = (cvm (k) * tz (k) - lv00 * evap) / (one_r8 + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice)
            1430     3                           endif
            1431     2               
            1432     2                           ! -----------------------------------------------------------------------
            1433     2                           ! accretion: pracc
            1434     2                           ! -----------------------------------------------------------------------
            1435     2               
            1436     2                           ! if (qr (k) > qrmin .and. ql (k) > 1.e-7 .and. qsat < q_plus) then
            1437     3                           if (qr (k) > qrmin .and. ql (k) > 1.e-6 .and. qsat < q_minus) then
            1438     3                               sink = dt * denfac (k) * cracw * exp (0.95 * log (qr (k) * den (k)))
            1439     3                               sink = sink / (1. + sink) * ql (k)
            1440     3                               ql (k) = ql (k) - sink
            1441     3                               qr (k) = qr (k) + sink
            1442     3                           endif
            1443     2               
            1444     2                       endif ! warm - rain
            1445     1                   enddo
            1446                     
            1447                     end subroutine revap_racc

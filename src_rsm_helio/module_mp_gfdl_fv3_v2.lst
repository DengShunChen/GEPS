            3746                     ! =======================================================================
            3747                     ! qsmith table initialization
            3748                     ! =======================================================================
            3749                     
            3750                     subroutine setup_con
            3751                     
            3752                         implicit none
            3753                     
            3754                         ! master = (mpp_pe () .eq.mpp_root_pe ())
            3755                     
            3756                         if (.not. qsmith_tables_initialized) call qsmith_init
            3757                     
            3758                         qsmith_tables_initialized = .true.
            3759                     
            3760                     end subroutine setup_con
            3761                     
            3762                     ! =======================================================================
            3763                     ! accretion function (lin et al. 1983)
            3764                     ! =======================================================================
            3765                     
            3766                     real function acr3d (v1, v2, q1, q2, c, cac, rho)
            3767                     
            3768                         implicit none
            3769                     
            3770                         real, intent (in) :: v1, v2, c, rho
            3771                         real, intent (in) :: q1, q2 ! mixing ratio!!!
            3772                         real, intent (in) :: cac (3)
            3773                     
            3774                         real :: t1, s1, s2
            3775                     
            3776                         ! integer :: k
            3777                         !
            3778                         ! real :: a
            3779                         !
            3780                         ! a = 0.0
            3781                         ! do k = 1, 3
            3782                         ! a = a + cac (k) * ((q1 * rho) ** ((7 - k) * 0.25) * (q2 * rho) ** (k * 0.25))
            3783                         ! enddo
            3784                         ! acr3d = c * abs (v1 - v2) * a / rho
            3785                     
            3786                         ! optimized
            3787                     
            3788                         t1 = sqrt (q1 * rho)
            3789                         s1 = sqrt (q2 * rho)
            3790                         s2 = sqrt (s1) ! s1 = s2 ** 2
            3791                         acr3d = c * abs (v1 - v2) * q1 * s2 * (cac (1) * t1 + cac (2) * sqrt (t1) * s2 + cac (3) * s1)
            3792                     
            3793                     end function acr3d
            3794                     
            3795                     ! =======================================================================
            3796                     ! melting of snow function (lin et al. 1983)
            3797                     ! note: psacw and psacr must be calc before smlt is called
            3798                     ! =======================================================================
            3799                     
            3800                     real function smlt (tc, dqs, qsrho, psacw, psacr, c, rho, rhofac)
            3801                     
            3802                         implicit none
            3803                     
            3804                         real, intent (in) :: tc, dqs, qsrho, psacw, psacr, c (5), rho, rhofac
            3805                     
            3806                         smlt = (c (1) * tc / rho - c (2) * dqs) * (c (3) * sqrt (qsrho) + &
            3807                             c (4) * qsrho ** 0.65625 * sqrt (rhofac)) + c (5) * tc * (psacw + psacr)
            3808                     
            3809                     end function smlt
            3810                     
            3811                     ! =======================================================================
            3812                     ! melting of graupel function (lin et al. 1983)
            3813                     ! note: pgacw and pgacr must be calc before gmlt is called
            3814                     ! =======================================================================
            3815                     
            3816                     real function gmlt (tc, dqs, qgrho, pgacw, pgacr, c, rho)
            3817                     
            3818                         implicit none
            3819                     
            3820                         real, intent (in) :: tc, dqs, qgrho, pgacw, pgacr, c (5), rho
            3821                     
            3822                         gmlt = (c (1) * tc / rho - c (2) * dqs) * (c (3) * sqrt (qgrho) + &
            3823                             c (4) * qgrho ** 0.6875 / rho ** 0.25) + c (5) * tc * (pgacw + pgacr)
            3824                     
            3825                     end function gmlt
            3826                     
            3827                     ! =======================================================================
            3828                     ! initialization
            3829                     ! prepare saturation water vapor pressure tables
            3830                     ! =======================================================================
            3831                     
            3832                     subroutine qsmith_init
            3833                     
            3834                         implicit none
            3835                     
            3836                         integer, parameter :: length = 2621
            3837                     
            3838                         integer :: i
            3839                     
            3840     1                   if (.not. tables_are_initialized) then
            3841     1               
            3842     1                       allocate (table (length))
            3843     1                       allocate (table2 (length))
            3844     1                       allocate (table3 (length))
            3845     1                       allocate (tablew (length))
            3846     1                       allocate (des (length))
            3847     1                       allocate (des2 (length))
            3848     1                       allocate (des3 (length))
            3849     1                       allocate (desw (length))
            3850     1               
            3851     1                       call qs_table (length)
            3852     1                       call qs_table2 (length)
            3853     1                       call qs_table3 (length)
            3854     1    i                  call qs_tablew (length)
            3855     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 189
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.62, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table3, table2, table, tablew, des, des3
                                   <<<      desw, des2
                                   <<< Loop-information  End >>>
            3856     2  pp    v              do i = 1, length - 1
            3857     2   p    v                  des (i) = max (0., table (i + 1) - table (i))
            3858     2   p    v                  des2 (i) = max (0., table2 (i + 1) - table2 (i))
            3859     2   p    v                  des3 (i) = max (0., table3 (i + 1) - table3 (i))
            3860     2   p    v                  desw (i) = max (0., tablew (i + 1) - tablew (i))
            3861     2   p    v              enddo
            3862     1                       des (length) = des (length - 1)
            3863     1                       des2 (length) = des2 (length - 1)
            3864     1                       des3 (length) = des3 (length - 1)
            3865     1                       desw (length) = desw (length - 1)
            3866     1               
            3867     1                       tables_are_initialized = .true.
            3868     1               
            3869     1                   endif
            3870                     
            3871                     end subroutine qsmith_init
            3872                     
            3873                     ! =======================================================================
            3874                     ! compute the saturated specific humidity for table ii
            3875                     ! =======================================================================
            3876                     
            3877                     real function wqs1 (ta, den)
            3878                     
            3879                         implicit none
            3880                     
            3881                         ! pure water phase; universal dry / moist formular using air density
            3882                         ! input "den" can be either dry or moist air density
            3883                     
            3884                         real, intent (in) :: ta, den
            3885                     
            3886                         real :: es, ap1, tmin
            3887                     
            3888                         integer :: it
            3889                     
            3890                         tmin = table_ice - 160.
            3891                         ap1 = 10. * dim (ta, tmin) + 1.
            3892                         ap1 = min (2621., ap1)
            3893                         it = ap1
            3894                         es = tablew (it) + (ap1 - it) * desw (it)
            3895                         wqs1 = es / (rvgas * ta * den)
            3896                     
            3897                     end function wqs1
            3898                     
            3899                     ! =======================================================================
            3900                     ! compute the gradient of saturated specific humidity for table ii
            3901                     ! =======================================================================
            3902                     
            3903                     real function wqs2 (ta, den, dqdt)
            3904                     
            3905                         implicit none
            3906                     
            3907                         ! pure water phase; universal dry / moist formular using air density
            3908                         ! input "den" can be either dry or moist air density
            3909                     
            3910                         real, intent (in) :: ta, den
            3911                         real, intent (out) :: dqdt
            3912                         real :: es, ap1, tmin
            3913                         integer :: it
            3914                     
            3915                         tmin = table_ice - 160.
            3916                     
            3917                         if (.not. tables_are_initialized) call qsmith_init
            3918                     
            3919                         ap1 = 10. * dim (ta, tmin) + 1.
            3920                         ap1 = min (2621., ap1)
            3921                         it = ap1
            3922                         es = tablew (it) + (ap1 - it) * desw (it)
            3923                         wqs2 = es / (rvgas * ta * den)
            3924                         it = ap1 - 0.5
            3925                         ! finite diff, del_t = 0.1:
            3926                         dqdt = 10. * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) / (rvgas * ta * den)
            3927                     
            3928                     end function wqs2
            3929                     
            3930                     ! =======================================================================
            3931                     ! compute the gradient of saturated specific humidity for table ii
            3932                     ! it is the same as "wqs2", but written as vector function
            3933                     ! =======================================================================
            3934                     
            3935                     subroutine wqs2_vect (is, ie, ta, den, wqsat, dqdt)
            3936                     
            3937                         implicit none
            3938                     
            3939                         ! pure water phase; universal dry / moist formular using air density
            3940                         ! input "den" can be either dry or moist air density
            3941                     
            3942                         integer, intent (in) :: is, ie
            3943                     
            3944                         real, intent (in), dimension (is:ie) :: ta, den
            3945                     
            3946                         real, intent (out), dimension (is:ie) :: wqsat, dqdt
            3947                     
            3948                         real :: es, ap1, tmin
            3949                     
            3950                         integer :: i, it
            3951                     
            3952                         tmin = t_ice - 160.
            3953                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 154
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.90, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ta, den, wqsat, dqdt
                                   <<< Loop-information  End >>>
            3954     1  pp    v          do i = is, ie
            3955     1   p    v              ap1 = 10. * dim (ta (i), tmin) + 1.
            3956     1   p    v              ap1 = min (2621., ap1)
            3957     1   p    v              it = ap1
            3958     1   p    v              es = tablew (it) + (ap1 - it) * desw (it)
            3959     1   p    v              wqsat (i) = es / (rvgas * ta (i) * den (i))
            3960     1   p    v              it = ap1 - 0.5
            3961     1                       ! finite diff, del_t = 0.1:
            3962     1   p    v              dqdt (i) = 10. * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) / (rvgas * ta (i) * den (i))
            3963     1   p    v          enddo
            3964                     
            3965                     end subroutine wqs2_vect
            3966                     
            3967                     ! =======================================================================
            3968                     ! compute wet buld temperature
            3969                     ! =======================================================================
            3970                     
            3971                     real function wet_bulb (q, t, den)
            3972                     
            3973                         implicit none
            3974                     
            3975                         real, intent (in) :: t, q, den
            3976                     
            3977                         real :: qs, tp, dqdt
            3978                     
            3979                         wet_bulb = t
            3980          i              qs = wqs2 (wet_bulb, den, dqdt)
            3981                         tp = 0.5 * (qs - q) / (1. + lcp * dqdt) * lcp
            3982                         wet_bulb = wet_bulb - tp
            3983                     
            3984                         ! tp is negative if super - saturated
            3985     1                   if (tp > 0.01) then
            3986     1    i                  qs = wqs2 (wet_bulb, den, dqdt)
            3987     1                       tp = (qs - q) / (1. + lcp * dqdt) * lcp
            3988     1                       wet_bulb = wet_bulb - tp
            3989     1                   endif
            3990                     
            3991                     end function wet_bulb
            3992                     
            3993                     ! =======================================================================
            3994                     ! compute the saturated specific humidity for table iii
            3995                     ! =======================================================================
            3996                     
            3997                     real function iqs1 (ta, den)
            3998                     
            3999                         implicit none
            4000                     
            4001                         ! water - ice phase; universal dry / moist formular using air density
            4002                         ! input "den" can be either dry or moist air density
            4003                     
            4004                         real, intent (in) :: ta, den
            4005                     
            4006                         real :: es, ap1, tmin
            4007                     
            4008                         integer :: it
            4009                     
            4010                         tmin = table_ice - 160.
            4011                         ap1 = 10. * dim (ta, tmin) + 1.
            4012                         ap1 = min (2621., ap1)
            4013                         it = ap1
            4014                         es = table2 (it) + (ap1 - it) * des2 (it)
            4015                         iqs1 = es / (rvgas * ta * den)
            4016                     
            4017                     end function iqs1
            4018                     
            4019                     ! =======================================================================
            4020                     ! compute the gradient of saturated specific humidity for table iii
            4021                     ! =======================================================================
            4022                     
            4023                     real function iqs2 (ta, den, dqdt)
            4024                     
            4025                         implicit none
            4026                     
            4027                         ! water - ice phase; universal dry / moist formular using air density
            4028                         ! input "den" can be either dry or moist air density
            4029                     
            4030                         real (kind = r8), intent (in) :: ta
            4031                         real, intent (in) :: den
            4032                         real, intent (out) :: dqdt
            4033                         real (kind = r8) :: tmin, es, ap1
            4034                         integer :: it
            4035                     
            4036                         tmin = table_ice - 160.
            4037                         ap1 = 10. * dim (ta, tmin) + 1.
            4038                         ap1 = min (2621., ap1)
            4039                         it = ap1
            4040                         es = table2 (it) + (ap1 - it) * des2 (it)
            4041                         iqs2 = es / (rvgas * ta * den)
            4042                         it = ap1 - 0.5
            4043                         dqdt = 10. * (des2 (it) + (ap1 - it) * (des2 (it + 1) - des2 (it))) / (rvgas * ta * den)
            4044                     
            4045                     end function iqs2
            4046                     
            4047                     ! =======================================================================
            4048                     ! compute the gradient of saturated specific humidity for table iii
            4049                     ! =======================================================================
            4050                     
            4051                     real function qs1d_moist (ta, qv, pa, dqdt)
            4052                     
            4053                         implicit none
            4054                     
            4055                         real, intent (in) :: ta, pa, qv
            4056                     
            4057                         real, intent (out) :: dqdt
            4058                     
            4059                         real :: es, ap1, tmin, eps10
            4060                     
            4061                         integer :: it
            4062                     
            4063                         tmin = table_ice - 160.
            4064                         eps10 = 10. * eps
            4065                         ap1 = 10. * dim (ta, tmin) + 1.
            4066                         ap1 = min (2621., ap1)
            4067                         it = ap1
            4068                         es = table2 (it) + (ap1 - it) * des2 (it)
            4069                         qs1d_moist = eps * es * (1. + zvir * qv) / pa
            4070                         it = ap1 - 0.5
            4071                         dqdt = eps10 * (des2 (it) + (ap1 - it) * (des2 (it + 1) - des2 (it))) * (1. + zvir * qv) / pa
            4072                     
            4073                     end function qs1d_moist

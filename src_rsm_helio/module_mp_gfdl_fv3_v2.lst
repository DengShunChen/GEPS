            3071                     ! =======================================================================
            3072                     ! lagrangian scheme
            3073                     ! developed by sj lin, around 2006
            3074                     ! =======================================================================
            3075                     
            3076                     subroutine lagrangian_fall_ppm (ks, ke, zs, ze, zt, dp, q, precip, m1, mono)
            3077                     
            3078                         implicit none
            3079                     
            3080                         integer, intent (in) :: ks, ke
            3081                         real, intent (in) :: zs
            3082                         logical, intent (in) :: mono
            3083                         real, intent (in), dimension (ks:ke + 1) :: ze, zt
            3084                         real, intent (in), dimension (ks:ke) :: dp
            3085                     
            3086                         ! m1: flux
            3087                         real, intent (inout), dimension (ks:ke) :: q, m1
            3088                         real, intent (out) :: precip
            3089                         real, dimension (ks:ke) :: qm, dz
            3090                     
            3091                         real :: a4 (4, ks:ke)
            3092                         real :: pl, pr, delz, esl
            3093                         integer :: k, k0, n, m
            3094                         real, parameter :: r3 = 1. / 3., r23 = 2. / 3.
            3095                     
            3096                         ! -----------------------------------------------------------------------
            3097                         ! density:
            3098                         ! -----------------------------------------------------------------------
            3099                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, q, zt, qm, a4, dz
                                   <<< Loop-information  End >>>
            3100     1  pp    v          do k = ks, ke
            3101     1   p    v              dz (k) = zt (k) - zt (k + 1) ! note: dz is positive
            3102     1   p    v              q (k) = q (k) * dp (k)
            3103     1   p    v              a4 (1, k) = q (k) / dz (k)
            3104     1   p    v              qm (k) = 0.
            3105     1   p    v          enddo
            3106                     
            3107                         ! -----------------------------------------------------------------------
            3108                         ! construct vertical profile with zt as coordinate
            3109                         ! -----------------------------------------------------------------------
            3110                     
            3111                         call cs_profile (a4 (1, ks), dz (ks), ke - ks + 1, mono)
            3112                     
            3113                         k0 = ks
            3114     1                   do k = ks, ke
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            3115     2                       do n = k0, ke
            3116     3                           if (ze (k) <= zt (n) .and. ze (k) >= zt (n + 1)) then
            3117     3                               pl = (zt (n) - ze (k)) / dz (n)
            3118     4                               if (zt (n + 1) <= ze (k + 1)) then
            3119     4                                   ! entire new grid is within the original grid
            3120     4                                   pr = (zt (n) - ze (k + 1)) / dz (n)
            3121     4                                   qm (k) = a4 (2, n) + 0.5 * (a4 (4, n) + a4 (3, n) - a4 (2, n)) * (pr + pl) - &
            3122     4                                       a4 (4, n) * r3 * (pr * (pr + pl) + pl ** 2)
            3123     4                                   qm (k) = qm (k) * (ze (k) - ze (k + 1))
            3124     4                                   k0 = n
            3125     4                                   goto 555
            3126     4                               else
            3127     4                                   qm (k) = (ze (k) - zt (n + 1)) * (a4 (2, n) + 0.5 * (a4 (4, n) + &
            3128     4                                       a4 (3, n) - a4 (2, n)) * (1. + pl) - a4 (4, n) * (r3 * (1. + pl * (1. + pl))))
            3129     5                                   if (n < ke) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            3130     6                                       do m = n + 1, ke
            3131     6                                           ! locate the bottom edge: ze (k + 1)
            3132     7                                           if (ze (k + 1) < zt (m + 1)) then
            3133     7                                               qm (k) = qm (k) + q (m)
            3134     7                                           else
            3135     7                                               delz = zt (m) - ze (k + 1)
            3136     7                                               esl = delz / dz (m)
            3137     7                                               qm (k) = qm (k) + delz * (a4 (2, m) + 0.5 * esl * &
            3138     7                                                    (a4 (3, m) - a4 (2, m) + a4 (4, m) * (1. - r23 * esl)))
            3139     7                                               k0 = m
            3140     7                                               goto 555
            3141     7                                           endif
            3142     6                                       enddo
            3143     5                                   endif
            3144     4                                   goto 555
            3145     4                               endif
            3146     3                           endif
            3147     2                       enddo
            3148     1                       555 continue
            3149     1                   enddo
            3150                     
            3151                         m1 (ks) = q (ks) - qm (ks)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.83, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, qm, m1
                                   <<< Loop-information  End >>>
            3152     1   s   2s          do k = ks + 1, ke
            3153     1   m   2m              m1 (k) = m1 (k - 1) + q (k) - qm (k)
            3154     1   p   2v          enddo
            3155                         precip = m1 (ke)
            3156                     
            3157                         ! convert back to * dry * mixing ratio:
            3158                         ! dp must be dry air_mass (because moist air mass will be changed due to terminal fall) .
            3159                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.31, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, qm, q
                                   <<< Loop-information  End >>>
            3160     1  pp   2v          do k = ks, ke
            3161     1   p   2v              q (k) = qm (k) / dp (k)
            3162     1   p   2v          enddo
            3163                     
            3164                     end subroutine lagrangian_fall_ppm
            3165                     
            3166                     subroutine cs_profile (a4, del, km, do_mono)
            3167                     
            3168                         implicit none
            3169                     
            3170                         integer, intent (in) :: km ! vertical dimension
            3171                         real, intent (in) :: del (km)
            3172                         logical, intent (in) :: do_mono
            3173                         real, intent (inout) :: a4 (4, km)
            3174                         real, parameter :: qp_min = 1.e-6
            3175                         real :: gam (km)
            3176                         real :: q (km + 1)
            3177                         real :: d4, bet, a_bot, grat, pmp, lac
            3178                         real :: pmp_1, lac_1, pmp_2, lac_2

            1529                         real (kind = r8), dimension (ks:ke) :: cvm, te8
            1530                         real (kind = r8) :: tz
            1531                         real :: rdts, fac_g2v, fac_v2g, fac_i2s, fac_imlt
            1532                         real :: qv, ql, qr, qi, qs, qg, melt
            1533                         real :: pracs, psacw, pgacw, psacr, pgacr, pgaci, praci, psaci
            1534                         real :: pgmlt, psmlt, pgfr, psaut
            1535                         real :: tc, dqs0, qden, qsm
            1536                         real :: dt5, factor, sink, qi_crt
            1537                         real :: tmp, qsw, qsi, dqsdt, dq
            1538                         real :: dtmp, qc, q_plus, q_minus
            1539                         integer :: k
            1540                     
            1541                         dt5 = 0.5 * dts
            1542                         rdts = 1. / dts
            1543                     
            1544                         ! -----------------------------------------------------------------------
            1545                         ! define conversion scalar / factor
            1546                         ! -----------------------------------------------------------------------
            1547                     
            1548                         fac_i2s = 1. - exp (- dts / tau_i2s)
            1549                         fac_g2v = 1. - exp (- dts / tau_g2v)
            1550                         fac_v2g = 1. - exp (- dts / tau_v2g)
            1551                         fac_imlt = 1. - exp (- dt5 / tau_imlt)
            1552                     
            1553                         ! -----------------------------------------------------------------------
            1554                         ! define heat capacity and latend heat coefficient
            1555                         ! -----------------------------------------------------------------------
            1556                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 223
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1557,1570)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.68, ITR: 40, MVE: 3, POL: S)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qgk, tzk, den, qim, qsk, q_sol, qik, qrk
                                   <<<      qlk, qvk, icpk, te8, cvm, q_liq
                                   <<< Loop-information  End >>>
            1557     1  pp    v          do k = ks, ke
            1558     1   p    v              q_liq (k) = qlk (k) + qrk (k)
            1559     1   p    v              q_sol (k) = qik (k) + qsk (k) + qgk (k)
            1560     1   p    v              cvm (k) = one_r8 + qvk (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            1561     1   p    v              te8 (k) = cvm (k) * tzk (k) + lv00 * qvk (k) - li00 * q_sol (k)
            1562     1   p    v              icpk (k) = (li00 + d1_ice * tzk (k)) / cvm (k)
            1563     1   p    v          enddo
            1564                     
            1565                         ! -----------------------------------------------------------------------
            1566                         ! similar to lfo 1983: eq. 21 solved implicitly
            1567                         ! threshold from wsm6 scheme, hong et al 2004, eq (13) : qi0_crt ~0.8e-4
            1568                         ! -----------------------------------------------------------------------
            1569                     

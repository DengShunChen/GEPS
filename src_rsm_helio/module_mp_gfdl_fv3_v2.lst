                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<< Loop-information  End >>>
             572     2  pp   4v              do k = ks, ke
             573     3   p   4v                  if (do_inline_mp) then
             574     3               #ifdef MOIST_CAPPA
             575     3                               tz (k) = pt (i, k) / ((1. + zvir * qv (i, k)) * (1. - (ql (i, k) + qr (i, k) + qi (i, k) + qs (i, k) + qg (i, k))))
             576     3               #else
             577     3       4                       tz (k) = pt (i, k) / (1. + zvir * qv (i, k))
             578     3               #endif
             579     3   p   4v                  else
             580     3   p   4v                      tz (k) = pt (i, k)
             581     3   p   4v                  endif
             582     2   p   4v              enddo
             583     1               
             584     1                       ! -----------------------------------------------------------------------
             585     1                       ! total energy checker
             586     1                       ! -----------------------------------------------------------------------
             587     1               
             588     2                       if (consv_checker) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 184
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.42, ITR: 40, MVE: 3, POL: S)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, q_sol, cvm, q_liq
                                   <<< Loop-information  End >>>
             589     3  pp    v                  do k = ks, ke
             590     3   p    v                      q_liq (k) = ql (i, k) + qr (i, k)
             591     3   p    v                      q_sol (k) = qi (i, k) + qs (i, k) + qg (i, k)
             592     3   p    v                      cvm (k) = c_air * (1.0 - qv (i, k) - q_liq (k) - q_sol (k)) + &
             593     3                                   qv (i, k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
             594     3   p    v                      te_beg_0 (i, k) = cvm (k) * tz (k) + lv00 * c_air * qv (i, k) - li00 * c_air * q_sol (k)
             595     4   p    v                      if (hydrostatic) then
             596     4                                   te_beg_0 (i, k) = te_beg_0 (i, k) + 0.5 * (ua (i, k) ** 2 + va (i, k) ** 2)
             597     4   p    v                      else
             598     4   p    v                          te_beg_0 (i, k) = te_beg_0 (i, k) + 0.5 * (ua (i, k) ** 2 + va (i, k) ** 2 + w (i, k) ** 2)
             599     4   p    v                      endif
             600     3   p    v                      te_beg_0 (i, k) = rgrav * te_beg_0 (i, k) * delp (i, k) * gsize (i) ** 2.0
             601     3   p    v                      tw_beg_0 (i, k) = rgrav * (qv (i, k) + q_liq (k) + q_sol (k)) * delp (i, k) * gsize (i) ** 2.0
             602     3   p    v                  enddo
             603     2                           te_b_beg_0 (i) = (dte (i) - li00 * c_air * (ice (i) + snow (i) + graupel (i)) * dt_in / 86400) * gsize (i) ** 2.0
             604     2                           tw_b_beg_0 (i) = (rain (i) + ice (i) + snow (i) + graupel (i)) * dt_in / 86400 * gsize (i) ** 2.0
             605     2                       endif
             606     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 116
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      w1, v1, v0, u1, u0, m1, dz1, q_sol
                                   <<<      q_liq, qvz, qlz, qrz, qiz, qsz, qgz
                                   <<<      denfac
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      tz: 2, p1: 2, den: 2, dp1: 2, dp0: 2
                                   <<<      qaz: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 8
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             607     2  pp    v              do k = ks, ke
             608     2   p    v                  dp0 (k) = delp (i, k)
             609     2                           ! -----------------------------------------------------------------------
             610     2                           ! convert moist mixing ratios to dry mixing ratios
             611     2                           ! -----------------------------------------------------------------------
             612     2   p    v                  qvz (k) = qv (i, k)
             613     2   p    v                  qlz (k) = ql (i, k)
             614     2   p    v                  qrz (k) = qr (i, k)
             615     2   p    v                  qiz (k) = qi (i, k)
             616     2   p    v                  qsz (k) = qs (i, k)
             617     2   p    v                  qgz (k) = qg (i, k)
             618     2                           ! save moist ratios for te:
             619     2   p    v                  q_liq (k) = qlz (k) + qrz (k)
             620     2   p    v                  q_sol (k) = qiz (k) + qsz (k) + qgz (k)
             621     2   p    v                  q_cond = q_liq (k) + q_sol (k)
             622     2   p    v                  qaz (k) = 0.
             623     2   p    v                  dz1 (k) = dz (i, k)
             624     2   p    v                  con_r8 = one_r8 - (qvz (k) + q_cond)
             625     2                           ! dp1 is dry mass (no change during mp)
             626     2   p    v                  dp1 (k) = dp0 (k) * con_r8
             627     2   p    v                  con_r8 = one_r8 / con_r8
             628     2   p    v                  qvz (k) = qvz (k) * con_r8
             629     2   p    v                  qlz (k) = qlz (k) * con_r8
             630     2   p    v                  qrz (k) = qrz (k) * con_r8
             631     2   p    v                  qiz (k) = qiz (k) * con_r8
             632     2   p    v                  qsz (k) = qsz (k) * con_r8
             633     2   p    v                  qgz (k) = qgz (k) * con_r8
             634     2               
             635     2   p    v                  den (k) = - dp1 (k) / (grav * dz1 (k)) ! density of dry air
             636     2   p    v                  p1 (k) = den (k) * rdgas * tz (k) ! dry air pressure
             637     2               

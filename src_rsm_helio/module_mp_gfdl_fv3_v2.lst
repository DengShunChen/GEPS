            3012                     ! =======================================================================
            3013                     
            3014                     subroutine implicit_fall (dt, ks, ke, ze, vt, dp, q, precip, m1)
            3015                     
            3016                         implicit none
            3017                     
            3018                         integer, intent (in) :: ks, ke
            3019                         real, intent (in) :: dt
            3020                         real, intent (in), dimension (ks:ke + 1) :: ze
            3021                         real, intent (in), dimension (ks:ke) :: vt, dp
            3022                         real, intent (inout), dimension (ks:ke) :: q
            3023                         real, intent (out), dimension (ks:ke) :: m1
            3024                         real, intent (out) :: precip
            3025                         real, dimension (ks:ke) :: dz, qm, dd
            3026                         integer :: k
            3027                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.16, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, dp, vt, ze, dd, dz
                                   <<< Loop-information  End >>>
            3028     1  pp    v          do k = ks, ke
            3029     1   p    v              dz (k) = ze (k) - ze (k + 1)
            3030     1   p    v              dd (k) = dt * vt (k)
            3031     1   p    v              q (k) = q (k) * dp (k)
            3032     1   p    v          enddo
            3033                     
            3034                         ! -----------------------------------------------------------------------
            3035                         ! sedimentation: non - vectorizable loop
            3036                         ! -----------------------------------------------------------------------
            3037                     
            3038                         qm (ks) = q (ks) / (dz (ks) + dd (ks))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.19, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qm, dz, dd, q
                                   <<< Loop-information  End >>>
            3039     1   s   2s          do k = ks + 1, ke
            3040     1   m   2m              qm (k) = (q (k) + dd (k - 1) * qm (k - 1)) / (dz (k) + dd (k))
            3041     1   p   2v          enddo
            3042                     
            3043                         ! -----------------------------------------------------------------------
            3044                         ! qm is density at this stage
            3045                         ! -----------------------------------------------------------------------
            3046                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 192, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, qm
                                   <<< Loop-information  End >>>
            3047     1  pp   2v          do k = ks, ke
            3048     1   p   2v              qm (k) = qm (k) * dz (k)
            3049     1   p   2v          enddo
            3050                     
            3051                         ! -----------------------------------------------------------------------
            3052                         ! output mass fluxes: non - vectorizable loop
            3053                         ! -----------------------------------------------------------------------
            3054                     
            3055                         m1 (ks) = q (ks) - qm (ks)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.83, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, qm, m1
                                   <<< Loop-information  End >>>
            3056     1   s   2s          do k = ks + 1, ke
            3057     1   m   2m              m1 (k) = m1 (k - 1) + q (k) - qm (k)
            3058     1   p   2v          enddo
            3059                         precip = m1 (ke)
            3060                     
            3061                         ! -----------------------------------------------------------------------
            3062                         ! update:
            3063                         ! -----------------------------------------------------------------------
            3064                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.31, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, qm, q
                                   <<< Loop-information  End >>>
            3065     1  pp   2v          do k = ks, ke
            3066     1   p   2v              q (k) = qm (k) / dp (k) !dry dp used inside MP
            3067     1   p   2v          enddo
            3068                     
            3069                     end subroutine implicit_fall

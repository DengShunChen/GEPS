            1588     3   p    v                  if (tzk (k) > tice_mlt .and. qik (k) > qcmin) then
            1589     3               
            1590     3                               ! -----------------------------------------------------------------------
            1591     3                               ! pimlt: instant melting of cloud ice
            1592     3                               ! -----------------------------------------------------------------------
            1593     3               
            1594     3   p    v                      melt = min (qik (k), fac_imlt * (tzk (k) - tice_mlt) / icpk (k))
            1595     3   p    v                      tmp = min (melt, dim (ql_mlt, qlk (k))) ! max ql amount
            1596     3   p    v                      qlk (k) = qlk (k) + tmp
            1597     3   p    v                      qrk (k) = qrk (k) + melt - tmp
            1598     3   p    v                      qik (k) = qik (k) - melt
            1599     3   p    v                      q_liq (k) = q_liq (k) + melt
            1600     3   p    v                      q_sol (k) = q_sol (k) - melt
            1601     3   p    v                  elseif (tzk (k) < t_wfr .and. qlk (k) > qcmin) then
            1602     3               
            1603     3                               ! -----------------------------------------------------------------------
            1604     3                               ! pihom: homogeneous freezing of cloud water into cloud ice
            1605     3                               ! -----------------------------------------------------------------------
            1606     3               
            1607     3   p    v                      dtmp = t_wfr - tzk (k)
            1608     3   p    v                      factor = min (1., dtmp / dt_fr)
            1609     3   p    v                      sink = min (qlk (k) * factor, dtmp / icpk (k))
            1610     3   p    v                      tmp = min (sink, dim (qim (k), qik (k)))
            1611     3   p    v                      qlk (k) = qlk (k) - sink
            1612     3   p    v                      qsk (k) = qsk (k) + sink - tmp
            1613     3   p    v                      qik (k) = qik (k) + tmp
            1614     3   p    v                      q_liq (k) = q_liq (k) - sink
            1615     3   p    v                      q_sol (k) = q_sol (k) + sink
            1616     3   p    v                  endif
            1617     2   p    v              enddo
            1618     1               
            1619     1                       ! -----------------------------------------------------------------------
            1620     1                       ! vertical subgrid variability
            1621     1                       ! -----------------------------------------------------------------------
            1622     1               
            1623     1                       call linear_prof (ke - ks + 1, qik (ks), di (ks), z_slope_ice, h_var)
            1624     1               

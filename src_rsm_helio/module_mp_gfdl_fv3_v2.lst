            4307                     ! =======================================================================
            4308                     
            4309                     subroutine qs_tablew (n)
            4310                     
            4311                         implicit none
            4312                     
            4313                         integer, intent (in) :: n
            4314                     
            4315                         real (kind = r8) :: delt = 0.1
            4316                         real (kind = r8) :: tmin, tem, fac0, fac1, fac2
            4317                     
            4318                         integer :: i
            4319                     
            4320                         tmin = table_ice - 160.
            4321                     
            4322                         ! -----------------------------------------------------------------------
            4323                         ! compute es over water
            4324                         ! -----------------------------------------------------------------------
            4325                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tablew
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 96
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4326     1  pp    v          do i = 1, n
            4327     1   p    v              tem = tmin + delt * real (i - 1)
            4328     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4329     1   p    v              fac1 = fac0 * lv0
            4330     1   p    v              fac2 = (dc_vap * log (tem / t_ice) + fac1) / rvgas
            4331     1   p    v              tablew (i) = e00 * exp (fac2)
            4332     1   p    v          enddo
            4333                     
            4334                     end subroutine qs_tablew

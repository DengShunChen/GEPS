             331                         ! namelist
             332                         ! -----------------------------------------------------------------------
             333                     
             334                         namelist / gfdl_mp_nml / &
             335                             t_min, t_sub, tau_r2g, tau_smlt, tau_g2r, dw_land, dw_ocean, &
             336                             vi_fac, vr_fac, vs_fac, vg_fac, ql_mlt, do_qa, fix_negative, vi_max, &
             337                             vs_max, vg_max, vr_max, qs_mlt, qs0_crt, qi_gen, ql0_max, qi0_max, &
             338                             qi0_crt, do_sat_adj, rh_inc, rh_ins, rh_inr, const_vi, &
             339                             const_vs, const_vg, const_vr, use_ccn, rthresh, ccn_l, ccn_o, qc_crt, &
             340                             tau_g2v, tau_v2g, sat_adj0, tau_imlt, tau_v2l, tau_l2v, &
             341                             tau_i2s, tau_l2r, qi_lim, ql_gen, c_paut, c_psaci, c_pgacs, &

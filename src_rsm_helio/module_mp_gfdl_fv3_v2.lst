             316                         real :: rhc_cevap = 0.85 ! cloud water
             317                         real :: rhc_revap = 0.85 ! rain
             318                     
             319                         real :: f_dq_p = 1.0
             320                         real :: f_dq_m = 1.0
             321                         logical :: do_cld_adj = .false.
             322                     
             323                         integer :: inflag = 1 ! ice nucleation scheme
             324                         ! 1: hong et al., 2004
             325                         ! 2: meyers et al., 1992
             326                         ! 3: meyers et al., 1992
             327                         ! 4: cooper, 1986
             328                         ! 5: flecther, 1962
             329                     

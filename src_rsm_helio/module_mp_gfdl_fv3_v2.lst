            4587                     ! =======================================================================
            4588                     ! fix negative water species
            4589                     ! this is designed for 6 - class micro - physics schemes
            4590                     ! =======================================================================
            4591                     
            4592                     subroutine neg_adj (ks, ke, pt, dp, qv, ql, qr, qi, qs, qg, cond)
            4593                     
            4594                         implicit none
            4595                     
            4596                         integer, intent (in) :: ks, ke
            4597                         real, intent (in), dimension (ks:ke) :: dp
            4598                         real (kind = r8), intent (inout), dimension (ks:ke) :: pt
            4599                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            4600                         real, intent (out) :: cond
            4601                     
            4602                         real, dimension (ks:ke) :: lcpk, icpk
            4603                     
            4604                         real :: dq, cvm
            4605                     
            4606                         integer :: k
            4607                     
            4608                         ! -----------------------------------------------------------------------
            4609                         ! define heat capacity and latent heat coefficient
            4610                         ! -----------------------------------------------------------------------
            4611                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 297
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.51, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg, pt, qv, qr, ql, lcpk, qi, qs, icpk
                                   <<< Loop-information  End >>>
            4612     1  pp    v          do k = ks, ke
            4613     1   p    v              cvm = 1. + qv (k) * c1_vap + (qr (k) + ql (k)) * c1_liq + (qi (k) + qs (k) + qg (k)) * c1_ice
            4614     1   p    v              lcpk (k) = (lv00 + d1_vap * pt (k)) / cvm
            4615     1   p    v              icpk (k) = (li00 + d1_ice * pt (k)) / cvm
            4616     1   p    v          enddo
            4617                     
            4618                         cond = 0
            4619                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 121
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4620     1  pp    v          do k = ks, ke
            4621     1               
            4622     1                       ! -----------------------------------------------------------------------
            4623     1                       ! ice phase:
            4624     1                       ! -----------------------------------------------------------------------
            4625     1               
            4626     1                       ! if cloud ice < 0, borrow from snow
            4627     2   p    v              if (qi (k) < 0.) then
            4628     2   p    v                  qs (k) = qs (k) + qi (k)
            4629     2   p    v                  qi (k) = 0.
            4630     2   p    v              endif
            4631     1                       ! if snow < 0, borrow from graupel
            4632     2   p    v              if (qs (k) < 0.) then
            4633     2   p    v                  qg (k) = qg (k) + qs (k)
            4634     2   p    v                  qs (k) = 0.
            4635     2   p    v              endif
            4636     1                       ! if graupel < 0, borrow from rain
            4637     2   p    v              if (qg (k) < 0.) then
            4638     2   p    v                  qr (k) = qr (k) + qg (k)
            4639     2   p    v                  pt (k) = pt (k) - qg (k) * icpk (k) ! heating
            4640     2   p    v                  qg (k) = 0.
            4641     2   p    v              endif
            4642     1               
            4643     1                       ! -----------------------------------------------------------------------
            4644     1                       ! liquid phase:
            4645     1                       ! -----------------------------------------------------------------------
            4646     1               
            4647     1                       ! if rain < 0, borrow from cloud water
            4648     2   p    v              if (qr (k) < 0.) then
            4649     2   p    v                  ql (k) = ql (k) + qr (k)
            4650     2   p    v                  qr (k) = 0.
            4651     2   p    v              endif
            4652     1                       ! if cloud water < 0, borrow from water vapor
            4653     2   p    v              if (ql (k) < 0.) then
            4654     2   p    v                  cond = cond - ql (k) * dp (k)
            4655     2   p    v                  qv (k) = qv (k) + ql (k)
            4656     2   p    v                  pt (k) = pt (k) - ql (k) * lcpk (k) ! heating
            4657     2   p    v                  ql (k) = 0.
            4658     2   p    v              endif
            4659     1               
            4660     1   p    v          enddo
            4661                     
            4662                         ! -----------------------------------------------------------------------
            4663                         ! fix water vapor; borrow from below
            4664                         ! -----------------------------------------------------------------------
            4665                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv
                                   <<< Loop-information  End >>>
            4666     1   s   2s          do k = ks, ke - 1
            4667     2   s   2m              if (qv (k) < 0.) then
            4668     2   s   2s                  qv (k + 1) = qv (k + 1) + qv (k) * dp (k) / dp (k + 1)
            4669     2   s   2v                  qv (k) = 0.
            4670     2   s   2v              endif
            4671     1   s   2v          enddo
            4672                     
            4673                         ! -----------------------------------------------------------------------
            4674                         ! bottom layer; borrow from above
            4675                         ! -----------------------------------------------------------------------
            4676                     
            4677     1                   if (qv (ke) < 0. .and. qv (ke - 1) > 0.) then
            4678     1                       dq = min (- qv (ke) * dp (ke), qv (ke - 1) * dp (ke - 1))
            4679     1                       qv (ke - 1) = qv (ke - 1) - dq / dp (ke - 1)
            4680     1                       qv (ke) = qv (ke) + dq / dp (ke)
            4681     1                   endif
            4682                     
            4683                     end subroutine neg_adj

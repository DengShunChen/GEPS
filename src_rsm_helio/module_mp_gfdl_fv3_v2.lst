                                   <<< Loop-information  End >>>
            3491     3  pp    v                  do k = ks, ke
            3492     4   p    v                      if (qg (k) < thg) then
            3493     4   p    v                          vtg (k) = vf_min
            3494     4   p    v                      else
            3495     4   p    v                          vtg (k) = vg_fac * vcong * rhof (k) * sqrt (sqrt (sqrt (qg (k) * den (k) / normg)))
            3496     4   p    v                          vtg (k) = min (vg_max, max (vf_min, vtg (k)))
            3497     4   p    v                      endif
            3498     3   p    v                  enddo
            3499     2                       endif
            3500     1                   endif
            3501                     
            3502                     end subroutine fall_speed
            3503                     
            3504                     ! =======================================================================
            3505                     ! setup gfdl cloud microphysics parameters
            3506                     ! =======================================================================
            3507                     
            3508                     subroutine setupm
            3509                     
            3510                         implicit none
            3511                     
            3512                         real :: gcon, cd, scm3, pisq, act (8)
            3513                         real :: vdifu, tcond
            3514                         real :: visk
            3515                         real :: ch2o, hltf
            3516                         real :: hlts, hltc, ri50
            3517                     
            3518                         real, parameter :: gam263 = 1.456943, gam275 = 1.608355, gam290 = 1.827363, &
            3519                             gam325 = 2.54925, gam350 = 3.323363, gam380 = 4.694155, &
            3520                             gam425 = 8.285063, gam450 = 11.631769, gam480 = 17.837789, &
            3521                             gam625 = 184.860962, gam680 = 496.604067
            3522                     
            3523                         real, parameter :: acc (3) = (/ 5.0, 2.0, 0.5 /)
            3524                     
            3525                         real den_rc
            3526                     
            3527                         integer :: i, k
            3528                     
            3529                         pie = 4. * atan (1.0)
            3530                     
            3531                         ! s. klein's formular (eq 16) from am2
            3532                     
            3533                         fac_rc = (4. / 3.) * pie * rhor * rthresh ** 3
            3534                     
            3535     1                   if (prog_ccn) then
            3536     1                       ! if (master) write (*, *) 'prog_ccn option is .t.'
            3537     1                   else
            3538     1                       den_rc = fac_rc * ccn_o * 1.e6
            3539     1                       ! if (master) write (*, *) 'mp: for ccn_o = ', ccn_o, 'ql_rc = ', den_rc
            3540     1                       den_rc = fac_rc * ccn_l * 1.e6
            3541     1                       ! if (master) write (*, *) 'mp: for ccn_l = ', ccn_l, 'ql_rc = ', den_rc
            3542     1                   endif
            3543                     
            3544                         vdifu = 2.11e-5
            3545                         tcond = 2.36e-2
            3546                     
            3547                         visk = 1.259e-5
            3548                         hlts = hlv + hlf
            3549                         hltc = hlv
            3550                         hltf = hlf
            3551                     
            3552                         ch2o = c_liq
            3553                         ri50 = 1.e-4
            3554                     
            3555                         pisq = pie * pie
            3556                         scm3 = (visk / vdifu) ** (1. / 3.)
            3557                     
            3558                         cracs = pisq * rnzr * rnzs * rhos
            3559                         csacr = pisq * rnzr * rnzs * rhor
            3560     1                   if (do_hail) then
            3561     1                       cgacr = pisq * rnzr * rnzh * rhor
            3562     1                       cgacs = pisq * rnzh * rnzs * rhos
            3563     1                   else
            3564     1                       cgacr = pisq * rnzr * rnzg * rhor
            3565     1                       cgacs = pisq * rnzg * rnzs * rhos
            3566     1                   endif
            3567                         cgacs = cgacs * c_pgacs
            3568                     
            3569                         ! act: 1 - 2:racs (s - r) ; 3 - 4:sacr (r - s) ;
            3570                         ! 5 - 6:gacr (r - g) ; 7 - 8:gacs (s - g)
            3571                     
            3572                         act (1) = pie * rnzs * rhos
            3573                         act (2) = pie * rnzr * rhor
            3574     1                   if (do_hail) then
            3575     1                       act (6) = pie * rnzh * rhoh
            3576     1                   else
            3577     1                       act (6) = pie * rnzg * rhog
            3578     1                   endif
            3579                         act (3) = act (2)
            3580                         act (4) = act (1)
            3581                         act (5) = act (2)
            3582                         act (7) = act (1)
            3583                         act (8) = act (6)
            3584                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 4)
                                   <<< Loop-information  End >>>
            3585     1   s    v          do i = 1, 3
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3586     2   p   fv              do k = 1, 4
            3587     2   p   fv                  acco (i, k) = acc (i) / (act (2 * k - 1) ** ((7 - i) * 0.25) * act (2 * k) ** (i * 0.25))
            3588     2   p   fv              enddo
            3589     1   p    v          enddo
            3590                     
            3591                         gcon = 40.74 * sqrt (sfcrho) ! 44.628
            3592                     
            3593                         csacw = pie * rnzs * clin * gam325 / (4. * act (1) ** 0.8125)
            3594                         ! decreasing csacw to reduce cloud water --- > snow
            3595                     
            3596                         craci = pie * rnzr * alin * gam380 / (4. * act (2) ** 0.95)
            3597                         csaci = csacw * c_psaci
            3598                     
            3599     1                   if (do_hail) then
            3600     1                       cgacw = pie * rnzh * gam350 * gcon / (4. * act (6) ** 0.875)
            3601     1                   else
            3602     1                       cgacw = pie * rnzg * gam350 * gcon / (4. * act (6) ** 0.875)
            3603     1                   endif
            3604                         ! cgaci = cgacw * 0.1
            3605                     
            3606                         ! sjl, may 28, 2012
            3607                         cgaci = cgacw * 0.05
            3608                         ! sjl, may 28, 2012
            3609                     
            3610                         cracw = craci ! cracw = 3.27206196043822
            3611                         cracw = c_cracw * cracw
            3612                     
            3613                         ! subl and revp: five constants for three separate processes
            3614                     
            3615                         cssub (1) = 2. * pie * vdifu * tcond * rvgas * rnzs
            3616     1                   if (do_hail) then
            3617     1                       cgsub (1) = 2. * pie * vdifu * tcond * rvgas * rnzh
            3618     1                   else
            3619     1                       cgsub (1) = 2. * pie * vdifu * tcond * rvgas * rnzg
            3620     1                   endif
            3621                         crevp (1) = 2. * pie * vdifu * tcond * rvgas * rnzr
            3622                         cssub (2) = 0.78 / sqrt (act (1))
            3623                         cgsub (2) = 0.78 / sqrt (act (6))
            3624                         crevp (2) = 0.78 / sqrt (act (2))
            3625                         cssub (3) = 0.31 * scm3 * gam263 * sqrt (clin / visk) / act (1) ** 0.65625
            3626                         cgsub (3) = 0.31 * scm3 * gam275 * sqrt (gcon / visk) / act (6) ** 0.6875
            3627                         crevp (3) = 0.31 * scm3 * gam290 * sqrt (alin / visk) / act (2) ** 0.725
            3628                         cssub (4) = tcond * rvgas
            3629                         cssub (5) = hlts ** 2 * vdifu
            3630                         cgsub (4) = cssub (4)
            3631                         crevp (4) = cssub (4)
            3632                         cgsub (5) = cssub (5)
            3633                         crevp (5) = hltc ** 2 * vdifu
            3634                     
            3635                         cgfr (1) = 20.e2 * pisq * rnzr * rhor / act (2) ** 1.75
            3636                         cgfr (2) = 0.66
            3637                     
            3638                         ! smlt: five constants (lin et al. 1983)
            3639                     
            3640                         csmlt (1) = 2. * pie * tcond * rnzs / hltf
            3641                         csmlt (2) = 2. * pie * vdifu * rnzs * hltc / hltf
            3642                         csmlt (3) = cssub (2)
            3643                         csmlt (4) = cssub (3)
            3644                         csmlt (5) = ch2o / hltf
            3645                     
            3646                         ! gmlt: five constants
            3647                     
            3648     1                   if (do_hail) then
            3649     1                       cgmlt (1) = 2. * pie * tcond * rnzh / hltf
            3650     1                       cgmlt (2) = 2. * pie * vdifu * rnzh * hltc / hltf
            3651     1                   else
            3652     1                       cgmlt (1) = 2. * pie * tcond * rnzg / hltf
            3653     1                       cgmlt (2) = 2. * pie * vdifu * rnzg * hltc / hltf
            3654     1                   endif
            3655                         cgmlt (3) = cgsub (2)
            3656                         cgmlt (4) = cgsub (3)
            3657                         cgmlt (5) = ch2o / hltf
            3658                     
            3659                         es0 = e00
            3660                         ces0 = eps * es0
            3661                     
            3662                     end subroutine setupm
            3663                     

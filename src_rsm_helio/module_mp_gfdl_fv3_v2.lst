            4496     1  pp    v          do i = 1, 1600
            4497     1   p    v              tem = tmin + delt * real (i - 1)
            4498     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4499     1   p    v              fac1 = fac0 * li2
            4500     1   p    v              fac2 = (d2ice * log (tem / t_ice) + fac1) / rvgas
            4501     1   p    v              table (i) = e00 * exp (fac2)
            4502     1   p    v          enddo
            4503                     
            4504                         ! -----------------------------------------------------------------------
            4505                         ! compute es over water between - 20 deg c and 102 deg c.
            4506                         ! -----------------------------------------------------------------------
            4507                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      esupc, table
                                   <<< Loop-information  End >>>
            4508     1  pp    v          do i = 1, 1221
            4509     1   p    v              tem = 253.16 + delt * real (i - 1)
            4510     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4511     1   p    v              fac1 = fac0 * lv0
            4512     1   p    v              fac2 = (dc_vap * log (tem / t_ice) + fac1) / rvgas
            4513     1   p    v              esh20 = e00 * exp (fac2)
            4514     2   p    v              if (i <= 200) then
            4515     2   p    v                  esupc (i) = esh20
            4516     2   p    v              else
            4517     2   p    v                  table (i + 1400) = esh20
            4518     2   p    v              endif
            4519     1   p    v          enddo
            4520                     
            4521                         ! -----------------------------------------------------------------------
            4522                         ! derive blended es over ice and supercooled water between - 20 deg c and 0 deg c
            4523                         ! -----------------------------------------------------------------------
            4524                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table, (unknown)
                                   <<< Loop-information  End >>>
            4525     1   s   2v          do i = 1, 200
            4526     1   p   2v              tem = 253.16 + delt * real (i - 1)
            4527     1   p   2v              wice = 0.05 * (table_ice - tem)
            4528     1   p   2v              wh2o = 0.05 * (tem - 253.16)
            4529     1   p   2v              table (i + 1400) = wice * table (i + 1400) + wh2o * esupc (i)
            4530     1   p   2v          enddo
            4531                     
            4532                     end subroutine qs_table
            4533                     
            4534                     ! =======================================================================
            4535                     ! compute the saturated specific humidity and the gradient of saturated specific humidity
            4536                     ! input t in deg k, p in pa; p = rho rdry tv, moist pressure
            4537                     ! =======================================================================
            4538                     
            4539                     subroutine qsmith (im, km, ks, t, p, q, qs, dqdt)
            4540                     
            4541                         implicit none
            4542                     
            4543                         integer, intent (in) :: im, km, ks
            4544                     
            4545                         real, intent (in), dimension (im, km) :: t, p, q
            4546                     
            4547                         real, intent (out), dimension (im, km) :: qs
            4548                     
            4549                         real, intent (out), dimension (im, km), optional :: dqdt
            4550                     
            4551                         real :: eps10, ap1, tmin
            4552                     
            4553                         real, dimension (im, km) :: es
            4554                     
            4555                         integer :: i, k, it
            4556                     
            4557                         tmin = table_ice - 160.
            4558                         eps10 = 10. * eps
            4559                     
            4560     1                   if (.not. tables_are_initialized) then
            4561     1                       call qsmith_init
            4562     1                   endif
            4563                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, p, q, es, qs
                                   <<< Loop-information  End >>>
            4564     1  pp               do k = ks, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.70, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, p, t, qs, es
                                   <<< Loop-information  End >>>
            4565     2   p    v              do i = 1, im
            4566     2   p    v                  ap1 = 10. * dim (t (i, k), tmin) + 1.
            4567     2   p    v                  ap1 = min (2621., ap1)
            4568     2   p    v                  it = ap1
            4569     2   p    v                  es (i, k) = table (it) + (ap1 - it) * des (it)
            4570     2   p    v                  qs (i, k) = eps * es (i, k) * (1. + zvir * q (i, k)) / p (i, k)
            4571     2   p    v              enddo
            4572     1   p               enddo
            4573                     
            4574     1                   if (present (dqdt)) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, p, q, dqdt
                                   <<< Loop-information  End >>>
            4575     2  pp                   do k = ks, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.68, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, t, p, dqdt
                                   <<< Loop-information  End >>>
            4576     3   p    v                  do i = 1, im
            4577     3   p    v                      ap1 = 10. * dim (t (i, k), tmin) + 1.
            4578     3   p    v                      ap1 = min (2621., ap1) - 0.5
            4579     3   p    v                      it = ap1
            4580     3   p    v                      dqdt (i, k) = eps10 * (des (it) + (ap1 - it) * (des (it + 1) - des (it))) * (1. + zvir * q (i, k)) / p (i, k)
            4581     3   p    v                  enddo
            4582     2   p                   enddo
            4583     1                   endif
            4584                     
            4585                     end subroutine qsmith

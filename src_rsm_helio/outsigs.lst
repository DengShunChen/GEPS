                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tmp, stc
                                   <<< Loop-information  End >>>
             615     1  pp   2v            stc(:,k,:) = tmp(:,:)
             616     1               !
             617     1               !
             618     1                     enddo
             619                     !
             620                           return
             621                           end


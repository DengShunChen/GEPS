             552                     
             553                     !-----
             554                     !  following subroutine added for new soil model
             555                     !-----
             556                           subroutine rdsoil(nx,my,my_max,km,smc,stc,slc,canopy,ifilout &
             557                                            ,idtg,itau,ggdef,gmdef)
             558                     !
             559                           use index
             560                           use mpe
             561                     
             562                           implicit  none
             563                     
             564                           integer   nx,my,my_max,km,itau
             565                     
             566                           real        smc(nxp,km,my_max),stc(nxp,km,my_max),canopy(nxp,my_max), &
             567                                       slc(nxp,km,my_max)
             568                     
             569                           character*4 ggdef,gmdef
             570                     
             571                           character ifilout*80
             572                           real      work(nx,my),tmp(nxp,my_max)
             573                           integer*8 idtg
             574                           character typ*6,ihdg*26
             575                     !
             576                           integer   lenc,i,j,k,ii,jj,nxj,istat
             577                     
             578                           lenc=nx*my
             579                     !
             580                           call syslbl ('s005c0',idtg,itau,ggdef,ihdg)
             581                           call dmsread(nx,my,ihdg,lenc,'H',ifilout,work,istat)
             582                           call unify_reducepick(nx,my,my_max,work,canopy)
             583                     
             584                     !
             585                     ! for Noah 4-layer land model
             586                     ! dmskey(1:3) 1st layer :l01
             587                     ! dmskey(1:3) 2nd layer :l02
             588                     ! dmskey(1:3) 3rd layer :l03
             589                     ! dmskey(1:3) 4th layer :l04
             590                     
             591     1                     do k = 1,km
             592     1               !
             593     1               ! read smc  l015b0
             594     1               !
             595     1                     write(typ,'("l0",i1.1,"5b0")')k
             596     1                     call syslbl (typ,idtg,itau,gmdef,ihdg)
             597     1                     call dmsread(nx,my,ihdg,lenc,'H',ifilout,work,istat)
             598     1                     call unify_reducepick(nx,my,my_max,work,tmp)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tmp, smc
                                   <<< Loop-information  End >>>
             599     1  pp   2v            smc(:,k,:) = tmp(:,:)
             600     1               !
             601     1               ! read slc  l015b1
             602     1               !
             603     1                     write(typ,'("l0",i1.1,"5b1")')k
             604     1                     call syslbl (typ,idtg,itau,gmdef,ihdg)
             605     1                     call dmsread(nx,my,ihdg,lenc,'H',ifilout,work,istat)
             606     1                     call unify_reducepick(nx,my,my_max,work,tmp)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tmp, slc
                                   <<< Loop-information  End >>>
             607     1  pp   2v            slc(:,k,:) = tmp(:,:)
             608     1               !
             609     1               ! read stc  l01100
             610     1               !
             611     1                     write(typ,'("l0",i1.1,"100")')k
             612     1                     call syslbl (typ,idtg,itau,gmdef,ihdg)
             613     1                     call dmsread(nx,my,ihdg,lenc,'H',ifilout,work,istat)
             614     1                     call unify_reducepick(nx,my,my_max,work,tmp)
                                   <<< Loop-information Start >>>

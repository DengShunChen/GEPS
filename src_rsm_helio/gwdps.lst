             342     4   p    v                  a1=a1_coeff*var_temp**2
             343     4   p    v                  a2=a1*a2_coeff
             344     4                        ! Revise e-folding height based on PBL height and topographic std. dev. -- M. Toy 3/12/2018
             345     4   p    v                  H_efold = max(2*hprime(j),hpbl(j))
             346     4   p    v                  H_efold = min(H_efold,Hefold_nom)
             347     4   p    v                  za(j,k) = 0.5*(phii(j,k)+phii(j,k+1))/g

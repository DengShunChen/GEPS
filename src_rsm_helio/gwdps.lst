             516     3   p    v                  phiang   =  atan2(v1(j,k),u1(j,k))*rad_to_deg
             517     3   p    v                  ang(i,k) = ( theta(j) - phiang )
             518     3   p    s                  if ( ang(i,k) .gt.  90. ) ang(i,k) = ang(i,k) - 180.
             519     3   p    m                  if ( ang(i,k) .lt. -90. ) ang(i,k) = ang(i,k) + 180.
             520     3   p    v                  ang(i,k) = ang(i,k) * deg_to_rad
             521     3               !
             522     3   p    v                  uds(i,k) =                                                  &

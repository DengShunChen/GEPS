             351     4   p    v                  wsp=SQRT(utmp*utmp + vtmp*vtmp)
             352     4   p    v                  vtj(i,k)  = t1(j,k)  * (1.+fv*q1(j,k))
             353     4   p    v                  ro_tmp    = rdi * prsl(j,k) / vtj(i,k) ! density tons/m**3
             354     4                        ! Eqn. (16) of Beljaars et al. (2004)
             355     4   p    v                  utendform(j,k)=-TOFD_coeff*wsp*utmp* ro_tmp* &
             356     4                                          EXP(-(za(j,k)/H_efold)**1.5)*a2*za(j,k)**(-1.2)*ss_taper
             357     4   p    v                  vtendform(j,k)=-TOFD_coeff*wsp*vtmp* ro_tmp* &
             358     4                                          EXP(-(za(j,k)/H_efold)**1.5)*a2*za(j,k)**(-1.2)*ss_taper
             359     4   p    v                  a(j,k)  = vtendform(j,k) + a(j,k)
             360     4   p    v                  b(j,k)  = utendform(j,k) + b(j,k)

                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              52        pp    v            mfcout(:,:,1)=rain1(:,:)
              53         p    v            mfcout(:,:,2)=raintot(:,:)
              54         p    v            mfcout(:,:,3)=t2(:,:)
              55         p    v            mfcout(:,:,4)=q2(:,:)
              56         p    v            mfcout(:,:,5)=rh2(:,:)
              57         p    v            mfcout(:,:,6)=u10(:,:)
              58         p    v            mfcout(:,:,7)=v10(:,:)
              59         p    v            mfcout(:,:,8)=tmax(:,:)
              60         p    v            mfcout(:,:,9)=tmin(:,:)
              61         p    v            mfcout(:,:,10)=td(:,:)
              62         p    v            mfcout(:,:,11)=rld(:,:)
              63         p    v            mfcout(:,:,12)=sld(:,:)
              64         p    v            mfcout(:,:,13)=ctot(:,:)
              65                     !
              66                     !  hydrostatic equation
              67                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, pk2, tt, sgeo, phi
                                   <<< Loop-information  End >>>
              68     1  pp                 do jj =1,jlistnum
              69     1   p                   j=jlist1(jj)
              70     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.60, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pk, tt, sgeo, phi
                                   <<< Loop-information  End >>>
              71     2   p    v              do i=1,nxj
              72     2   p    v                phi(i,lev,jj)= cp*tt(i,lev,jj)*(pk2(i,lev,jj)-pk(i,lev,jj)) &
              73     2                                      + sgeo(i,jj)
              74     2   p    v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phi, pk, pk2, tt
                                   <<< Loop-information  End >>>
              75     2   p                   do k=lev-1,1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.83, ITR: 104, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk, phi, pk2
                                   <<< Loop-information  End >>>
              76     3   p    v                do i=1,nxj
              77     3   p    v                  phi(i,k,jj)=phi(i,k+1,jj)+cp*(tt(i,k,jj)*(pk2(i,k,jj)-pk(i,k,jj)) &
              78     3                                      + tt(i,k+1,jj)*(pk(i,k+1,jj)-pk2(i,k,jj)))
              79     3   p    v                enddo
              80     2   p                   enddo
              81     1   p                 enddo
              82                     !
              83                     ! Sea level pressure(hPa)
              84                     !
              85                     !  compute sea level pressure
              86                     !  The method is based on one used by ecmwf, reseach manual 2 (1988)
              87                     !
              88                     !  llts layer's temperature is used to derive an alternative
              89                     !  surface skin temperature
              90                     !
              91                           llts = lev-5
              92                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              93     1  pp                 do jj = 1, jlistnum
              94     1   p                   j=jlist1(jj)
              95     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, pk, tt, qt, plt, sgeo, phi, hld1
                                   <<<      hld2, mfcout
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 3
                                   <<<      PREDICATE : SPILL 1  FILL 1
                                   <<< Loop-information  End >>>
              96     2   p    v              do i=1,nxj
              97     2   p    v                ttb  = tt(i,lev,jj)*pk(i,lev,jj)/(1.0+0.608*qt(i,lev,jj))
              98     2   p    v                ttp  = tt(i,llts,jj)*pk(i,llts,jj)/(1.0+0.608*qt(i,llts,jj))
              99     2   p    v                ttt1 = ttb + alaps*rdg*ttb*   &
             100     2                             ((pt(i,jj)+ptop)/plt(i,lev,jj)-1.0)
             101     2   p    v                ttt2 = ttp + alaps*(phi(i,llts,jj)-sgeo(i,jj))/grav
             102     2   p    v                hld1(i,jj) = 0.25*ttt1 + 0.75*ttt2
             103     2   p    v                hld2(i,jj) = hld1(i,jj) + alaps*sgeo(i,jj)/grav
             104     3   p    v                if( sgeo(i,jj) .lt. 0.1 ) then
             105     3   p    v                  anlslp = pt(i,jj) + ptop
             106     3   p    v                else if( hld1(i,jj) .le. 290.5 .and. hld2(i,jj) .gt. 290.5 ) then
             107     3   p    v                  apha = rgas*(290.5-hld1(i,jj))/sgeo(i,jj)
             108     3   p    v                  ttt = sgeo(i,jj)/(rgas*hld1(i,jj))
             109     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp(ttt*(1.0-0.5*apha*ttt+0.333333*  &
             110     3                                    apha*ttt*apha*ttt) )
             111     3   p    v                else if( hld1(i,jj) .gt. 290.5 .and. hld2(i,jj) .gt. 290.5 ) then
             112     3   p    v                  hld1(i,jj) = (hld1(i,jj)+290.5)*0.5
             113     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,jj)) )
             114     3   p    v                else if( hld1(i,jj) .lt. 255.0 .and. hld2(i,jj) .lt. 255.0 ) then
             115     3   p    v                  hld1(i,jj) = (hld1(i,jj)+255.0)*0.5
             116     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,jj)) )
             117     3   p    v                else
             118     3   p    v                  apha = alaps * rdg
             119     3   p    v                  ttt = sgeo(i,jj)/(rgas*hld1(i,jj))
             120     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp(ttt*(1.0-0.5*apha*ttt+0.333333*  &
             121     3                                    apha*ttt*apha*ttt) )
             122     3   p    v                endif
             123     2   p    v                mfcout(i,jj,14) = anlslp
             124     2   p    v              enddo
             125     1   p                 enddo
             126                     !
             127                     ! Total Precp.
             128                     !byl      call mpe2d_unify(glob,raintot)
             129     1                     do n=1,num
             130     1                       call syslbl (dmskey(n),idtg,ntau,ggdef,ihdg)
             131     1                       call unify_reduceintp(nx,my,my_max,mfcout(1,1,n),glob)
             132     2                       if ( myrank .eq. n-1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      glob, mout
                                   <<< Loop-information  End >>>
             133     2  pp   4v                mout=glob
             134     2                         ihdg2=ihdg
             135     2                       endif
             136     1                     enddo
             137                     !
             138                           if (myrank .lt. num ) call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,mout,istat)
             139                     !
             140                     !! rh10
             141                     !!byl      call mpe2d_unify(glob,rh10)
             142                     !      call syslbl ('b10510',idtg,ntau,ggdef,ihdg)
             143                     !      call unify_reduceintp(nx,my,my_max,rh10,glob)
             144                     !!byl      if( lreduce.eq.1 ) call reduceintp (glob,nxdef,nx,my)
             145                     !!     call dmswrit(nx,my,ihdg,lenc,kflag,ifilout,glob,istat)
             146                     !      call dmswrit_mfc(nx,my,ihdg,lenc,kflag,ifilout,glob,istat)
             147                     

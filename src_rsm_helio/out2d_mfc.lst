               9                           use grid  ,only : tt,qt,plt,pk,pk2,sgeo
              10                     !
              11                           implicit  none
              12                     
              13                           integer   nx,lev,my,my_max,itau,ntau,num
              14                           parameter (num=14)
              15                     
              16                           real      raintot(nxp,my_max),t2(nxp,my_max),u10(nxp,my_max),   &
              17                                     v10(nxp,my_max),ctot(nxp,my_max)
              18                           real(kind=RTYPE) pt(nxp,my_max)
              19                     
              20                           real rain1(nxp,my_max),q2(nxp,my_max),rh2(nxp,my_max),          &
              21                                rh10(nxp,my_max),tmax(nxp,my_max),tmin(nxp,my_max),        &
              22                                td(nxp,my_max),rld(nxp,my_max),sld(nxp,my_max)
              23                     !
              24                           real(kind=RTYPE) mfcout(nxp,my_max,num)
              25                     !
              26                           character*4 ggdef
              27                           integer*8 idtg
              28                           character*6 dmskey(num)
              29                     !
              30                           real(kind=RTYPE) glob(nx,my),mout(nx,my)
              31                     !
              32                           character*80 ifilout
              33                           character*26 ihdg,ihdg2
              34                     !
              35                           integer   n,levz,lenc,lenc2,i,ia,kk,j,nxj,istat,jj,llts,k
              36                           real      tnshun,alaps,rdg,ttb,ttp,ttt,ttt1,ttt2,anlslp,apha
              37                           real      phi(nxp,lev,my_max),hld1(nxp,my_max),hld2(nxp,my_max)
              38                     
              39                     !
              40                           data dmskey/'b00621','b0062t','b02100','b02500','b02510', &
              41                                       'b10200','b10210','b02171','b02181','b02150', &
              42                                       's003x0','s003u0','x00770','ssl010'/
              43                     
              44                     
              45                     !
              46                           tnshun= 1.0
              47                           lenc= nx*my
              48                           lenc2= lev*my
              49                           alaps = 0.0065
              50                           rdg = rgas/grav
              51                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ctot, mfcout, sld, rld, td, tmin, tmax
                                   <<<      v10, u10

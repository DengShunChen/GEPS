            2224     4   p    v                  dtdtr = dtradc(i,k,jj) * dta / 86400.
            2225     4   p    v                  upert = ( ut(i,k,jj) - ut_save_sppt(i,k,jj) ) * ru
            2226     4   p    v                  vpert = ( vt(i,k,jj) - vt_save_sppt(i,k,jj) ) * ru
            2227     4   p    v                  tpert = ( tt(i,k,jj) - tt_save_sppt(i,k,jj) - dtdtr ) * ru

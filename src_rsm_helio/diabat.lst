            2209     5   p    v                     vru=1.0
            2210     5   p    v                  endif
            2211     5   p    v                  if (kc.le.zmtnblck(i)) then
            2212     5   p    v                     vru=0.0
            2213     5   p    v                  endif
            2214     5   p    v                  if (kc.eq.zmtnblck(i)+1) then
            2215     5   p    v                     vru=0.333333
            2216     5   p    v                  endif
            2217     5   p    v                  if (kc.eq.zmtnblck(i)+2) then

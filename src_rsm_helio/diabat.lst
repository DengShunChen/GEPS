             597     1                     if ( hours .gt. 24.0 )  then
             598     1                        hours = mod ( hours,24.0 )
             599     1                        julian= julian + 1
             600     1                        if ( julian .gt. yrd ) julian = julian - yrd
             601     1                        doozon = .true.
             602     1                        doclxu = .true.
             603     1                     endif
             604                           leap = mod ( year , 4 )
             605                           yrd = 365
             606                           if ( leap .eq. 0 ) yrd = 366
             607                     !
             608                           icrad = frad*3600.0/dt + 0.0001 ! frad =1.0 set in block.f
             609                           iter  = tau*3600.0/dt - 1. + 0.0001
             610                           uprad = .false.
             611                           if ( (mod(iter,icrad).eq.0) )  uprad = .true.
             612                           doozon = doozon .and. dorad

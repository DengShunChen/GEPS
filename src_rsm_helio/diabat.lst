             555                           nxmy = nx * my
             556                           nxlev= nx * lev
             557                           levmy= lev* my
             558                           radus = 6371000.
             559                           radsq = radus**2
             560                           tpi   = 4.0*atan(1.0)
             561                           d2r   = tpi / 180.0
             562                           tpr   = 2.*tpi*radus
             563                           ptrad = max(0.01,ptop)
             564                           xkapa = rgas/cp
             565                           xkapa1= 1.0 + xkapa
             566                           okapa = 1.0/xkapa
             567                           p0k   = 1000.0**xkapa
             568                           op0k  = 1.0/p0k
             569                           ptopk = ptop**xkapa

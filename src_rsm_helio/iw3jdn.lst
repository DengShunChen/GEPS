 External function subprogram "IW3JDN"
  (inc)(line-no.)(nest)(optimize)
               1                            FUNCTION IW3JDN(IYEAR,MONTH,IDAY)
               2                     !$$$   SUBPROGRAM  DOCUMENTATION  BLOCK
               3                     !
               4                     ! SUBPROGRAM: IW3JDN         COMPUTE JULIAN DAY NUMBER
               5                     !   AUTHOR: JONES,R.E.       ORG: W342       DATE: 87-03-29
               6                     !
               7                     ! ABSTRACT: COMPUTES JULIAN DAY NUMBER FROM YEAR (4 DIGITS), MONTH,
               8                     !   AND DAY. IW3JDN IS VALID FOR YEARS 1583 A.D. TO 3300 A.D.
               9                     !   JULIAN DAY NUMBER CAN BE USED TO COMPUTE DAY OF WEEK, DAY OF
              10                     !   YEAR, RECORD NUMBERS IN AN ARCHIVE, REPLACE DAY OF CENTURY,
              11                     !   FIND THE NUMBER OF DAYS BETWEEN TWO DATES.
              12                     !
              13                     ! PROGRAM HISTORY LOG:
              14                     !   87-03-29  R.E.JONES
              15                     !   89-10-25  R.E.JONES   CONVERT TO CRAY CFT77 FORTRAN
              16                     !
              17                     ! USAGE:   II = IW3JDN(IYEAR,MONTH,IDAY)
              18                     !
              19                     !   INPUT VARIABLES:
              20                     !     NAMES  INTERFACE DESCRIPTION OF VARIABLES AND TYPES
              21                     !     ------ --------- -----------------------------------------------
              22                     !     IYEAR  ARG LIST  INTEGER   YEAR           ( 4 DIGITS)
              23                     !     MONTH  ARG LIST  INTEGER   MONTH OF YEAR   (1 - 12)
              24                     !     IDAY   ARG LIST  INTEGER   DAY OF MONTH    (1 - 31)
              25                     !
              26                     !   OUTPUT VARIABLES:
              27                     !     NAMES  INTERFACE DESCRIPTION OF VARIABLES AND TYPES
              28                     !     ------ --------- -----------------------------------------------
              29                     !     IW3JDN FUNTION   INTEGER   JULIAN DAY NUMBER
              30                     !                      JAN. 1,1960 IS JULIAN DAY NUMBER 2436935
              31                     !                      JAN. 1,1987 IS JULIAN DAY NUMBER 2446797
              32                     !
              33                     !   REMARKS: JULIAN PERIOD WAS DEVISED BY JOSEPH SCALIGER IN 1582.
              34                     !     JULIAN DAY NUMBER #1 STARTED ON JAN. 1,4713 B.C. THREE MAJOR
              35                     !     CHRONOLOGICAL CYCLES BEGIN ON THE SAME DAY. A 28-YEAR SOLAR
              36                     !     CYCLE, A 19-YEAR LUNER CYCLE, A 15-YEAR INDICTION CYCLE, USED
              37                     !     IN ANCIENT ROME TO REGULATE TAXES. IT WILL TAKE 7980 YEARS
              38                     !     TO COMPLETE THE PERIOD, THE PRODUCT OF 28, 19, AND 15.
              39                     !     SCALIGER NAMED THE PERIOD, DATE, AND NUMBER AFTER HIS FATHER
              40                     !     JULIUS (NOT AFTER THE JULIAN CALENDAR). THIS SEEMS TO HAVE
              41                     !     CAUSED A LOT OF CONFUSION IN TEXT BOOKS. SCALIGER NAME IS
              42                     !     SPELLED THREE DIFFERENT WAYS. JULIAN DATE AND JULIAN DAY
              43                     !     NUMBER ARE INTERCHANGED. A JULIAN DATE IS USED BY ASTRONOMERS
              44                     !     TO COMPUTE ACCURATE TIME, IT HAS A FRACTION. WHEN TRUNCATED TO
              45                     !     AN INTEGER IT IS CALLED AN JULIAN DAY NUMBER. THIS FUNCTION
              46                     !     WAS IN A LETTER TO THE EDITOR OF THE COMMUNICATIONS OF THE ACM
              47                     !     VOLUME 11 / NUMBER 10 / OCTOBER 1968. THE JULIAN DAY NUMBER
              48                     !     CAN BE CONVERTED TO A YEAR, MONTH, DAY, DAY OF WEEK, DAY OF
              49                     !     YEAR BY CALLING SUBROUTINE W3FS26.
              50                     !
              51                     ! ATTRIBUTES:
              52                     !   LANGUAGE: CRAY CFT77 FORTRAN
              53                     !   MACHINE:  CRAY Y-MP8/864, CRAY Y-MP EL2/256
              54                     !
              55                     !$$$
              56                     !
              57                            implicit  none
              58                     
              59                            integer iw3jdn, iday, iyear, month
              60                     
              61                            IW3JDN  =    IDAY - 32075                                        &
              62                                       + 1461 * (IYEAR + 4800 + (MONTH - 14) / 12) / 4       &
              63                                       + 367 * (MONTH - 2 - (MONTH -14) / 12 * 12) / 12      &
              64                                       - 3 * ((IYEAR + 4900 + (MONTH - 14) / 12) / 100) / 4
              65                            RETURN
              66                            END


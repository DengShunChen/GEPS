                                   <<<      bki, aki, p
                                   <<< Loop-information  End >>>
             289     1  pp   2v            do i=1,layer
             290     1   p   2v            p(i)=aki(i)+(bki(i)*psfc)
             291     1   p   2v            enddo
             292                           return
             293                           end


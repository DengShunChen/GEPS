             280                           subroutine sigmap(layer,aki,bki,psfc,p)
             281                     !
             282                           use const, only: RTYPE
             283                     !
             284                           implicit none
             285                           integer i, layer
             286                           real p(layer)
             287                           real(kind=RTYPE) psfc,aki(layer), bki(layer)
             288                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]

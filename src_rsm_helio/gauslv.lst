 External subroutine subprogram "gauslv"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine gauslv ( n,y,z,cof )
               2                     !
               3                     !     gaussian elimination solver with grid-related constnats provided
               4                     !
               5                           use paramt
               6                     
               7                           implicit  none
               8                           integer   n
               9                           real      y(n),z(n),cof(n*3)
              10                     
              11                           integer   nm,nm2,nt2,j,k,nu,ne
              12                           real      v,yn
              13                     !
              14                           nm = n - 1
              15                           nm2 = n - 2
              16                           nt2 = n*2
              17                     !
              18                           v = 1.0
              19                           z(1) = y(1) * cof(n+1)
              20                           yn = y(n) - v*z(1)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.54, ITR: 32, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cof, z, y
                                   <<< Loop-information  End >>>
              21     1   s   8s            do 130 j = 2, nm2
              22     1   s   8s            v = -v*cof(j-1)
              23     1   s   8s            z(j) = (y(j) - z(j-1)) * cof(j+n)
              24     1   m   8m            yn = yn - v*z(j)
              25     1   p   8v        130 continue
              26                           v = 1.0 - v*cof(nm2)
              27                           ne = nt2
              28                           z(nm) = (y(nm) - z(nm2)) * cof(ne-1)
              29                           yn = yn - v*z(nm)
              30                     !
              31                     !     backward substitude
              32                     !
              33                           z(n) = yn * cof(ne)
              34                           z(nm) = z(nm) - cof(nm)*z(n)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.00, ITR: 10, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cof, z
                                   <<< Loop-information  End >>>
              35     1   s   2s            do 140 j = 2, nm
              36     1   p   2v               k = n - j
              37     1   s   2s               nu = k + nt2
              38     1   m   2m               z(k) = z(k) - cof(k)*z(k+1) - cof(nu)*z(n)
              39     1   p   2v        140 continue
              40                           return
              41                           end


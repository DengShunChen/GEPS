 External subroutine subprogram "GETFNAME"
  (inc)(line-no.)(nest)(optimize)
             203                     
             204                     
             205                           subroutine GETFNAME(pathname,logicfile,truefile,istat)
             206                           character pathname*80,logicfile*80,truefile*80,value*80,blank*80
             207                     !     integer getenv
             208                     
             209                           truefile(1:80)=' '
             210                           value(1:80)=' '
             211                           blank(1:80)=' '
             212                     !     i = getenv(pathname,value)
             213                     !     if (i .eq. 0) then
             214                           ix=index(pathname,' ')
             215                           call getenv(pathname(1:ix-1),value)
             216     1                     if (value(1:80) .eq. blank(1:80)) then
             217     1                	istat=-1
             218     1                     else
             219     1               	j=index(value,' ')
             220     1               	k=index(logicfile,' ')
             221     1               	truefile(1:j-1)=value(1:j-1)
             222     1               	truefile(j:j)='/'
             223     1               	truefile(j+1:j+k-1)=logicfile(1:k-1)
             224     1               	istat=0
             225     1                     endif
             226                           return
             227                           end


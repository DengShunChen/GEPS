                                   <<<      b2, aout
                                   <<< Loop-information  End >>>
             503     3   p   2v               aout(kk:kk+levp-1,1,j,jj)=b2(1:levp,1,j,jj,ii)
             504     3   p   2v               aout(kk:kk+levp-1,2,j,jj)=b2(1:levp,2,j,jj,ii)
             505     3   p                    kk=kk+levp
             506     3   p                 enddo
             507     2   p                 enddo

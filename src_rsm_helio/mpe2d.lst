             860                           subroutine mpe2d_transpose_siimpl(ain,aout, &
             861                                      levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist,nsizex,row_comm)
             862                     
             863                     ! transpose siimpl spec
             864                     
             865                           use mpi
             866                           use const, only: RTYPE,MPI_RTYPE
             867                     
             868                           implicit none
             869                     
             870                           integer levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist(jtrun),nsizex,row_comm
             871                           integer m,mf,nl,i,levp2,nlen,ierr,j,k
             872                     
             873                           real(kind=RTYPE) ain(levp,2,jtrun,jtmax)
             874                           real(kind=RTYPE) aout(lev,2,jtp)
             875                           real(kind=RTYPE) c1(levp,2,jtf)
             876                           real(kind=RTYPE) c2(levp,2,jtp,nsizex)
             877                     
             878                           levp2=levp*2
             879                           i=1
             880                     
             881     1                     do m=1,mlistnum
             882     1                        mf=mlist(m)
             883     1                        NL=jtrun-mf+1
                                   <<< Loop-information Start >>>

             884     1  pp   2v               c1(1:levp,1,i:i+nl-1)=ain(1:levp,1,mf:jtrun,m)
             885     1   p   2v               c1(1:levp,2,i:i+nl-1)=ain(1:levp,2,mf:jtrun,m)
             886     1                        i=i+NL
             887     1                     enddo
             888                     

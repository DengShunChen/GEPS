             554                     !----------------------------------------------------------------------------------------
             555                           subroutine mpe2d_unify_uzmean(a,my,lev)
             556                     
             557                     ! unify uzmean for 2dMPI
             558                     
             559                           use param, only : my_max
             560                           use rank,  only : nsize, MPI_COMM_gfs
             561                           use index
             562                           use mpi
             563                     
             564                           implicit none
             565                     
             566                           real a(my,lev)
             567                           real b1(levp,my_max)
             568                           real b2(levp,my_max*nsize)
             569                           integer i,j,ii,jj,j1,jf,kk,my,lev,ierr
             570                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b1
                                   <<< Loop-information  End >>>
             571     1  pp                 do jj=1,jlistnum
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b1
                                   <<< Loop-information  End >>>
             572     2   p   4v            do i=1,levp
             573     2   p   4v               b1(i,jj)=a(jj,i)
             574     2   p   4v            enddo
             575     1   p                 enddo
             576                     
             577                           call MPI_ALLGATHER( b1,levp*my_max, MPI_DOUBLE_PRECISION, &
             578                                               b2,levp*my_max, MPI_DOUBLE_PRECISION, &
             579                                               MPI_COMM_gfs, IERR )
             580                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             581     1  pp                 do j=1,my
             582     1   p                    kk=1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b2
                                   <<< Loop-information  End >>>
             583     2   p                 do ii=1,nsizex
             584     2   p                    jf=jlist2_2d(ii,j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b2
                                   <<< Loop-information  End >>>
             585     3   p   2v            do i=1,levp

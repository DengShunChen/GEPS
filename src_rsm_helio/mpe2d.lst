             480                           subroutine mpe2d_unify_spec_lev_sp(ain,aout,lev,levp,jtrun,jtmax,mlistnum,proc,comm)
             481                     
             482                     ! unify lev of spectrum
             483                     
             484                           use mpi
             485                     
             486                           implicit none
             487                     
             488                           integer lev,levp,jtrun,jtmax,mlistnum,proc,comm,ii,j,jj,k,kk,ierr

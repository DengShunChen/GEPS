             957                     !----------------------------------------------------------------------------------------
             958                           subroutine mpe2d_transpose_siimpl_back_multi(ain1,ain2,aout1,aout2,levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist,nsizex,row_comm)
             959                     
             960                     ! transpose siimpl spec back (2 arrays)
             961                     
             962                           use mpi
             963                           use index,only : jtlen_all
             964                           use const,only : RTYPE,MPI_RTYPE
             965                     
             966                           implicit none
             967                     
             968                           integer levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist(jtrun),nsizex,row_comm
             969                           integer m,n,mf,nl,i,nlen,ierr,j,k
             970                     
             971                           real(kind=RTYPE) ain1(lev,2,jtp),ain2(lev,2,jtp)
             972                           real(kind=RTYPE) aout1(levp,2,jtrun,jtmax),aout2(levp,2,jtrun,jtmax)
             973                     
             974                           real(kind=RTYPE) b1(jtp,4,lev)
             975                           real(kind=RTYPE) b2(jtp,4,levp,nsizex)
             976                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.12, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b1
                                   <<< Loop-information  End >>>
             977     1   p   2v            do j=1,jtp
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b1
                                   <<< Loop-information  End >>>
             978     2  pp   2             do k=1,lev
             979     2   p   2v               b1(j,1,k)=ain1(k,1,j)
             980     2   p   2v               b1(j,2,k)=ain1(k,2,j)
             981     2   p   2v               b1(j,3,k)=ain2(k,1,j)
             982     2   p   2v               b1(j,4,k)=ain2(k,2,j)
             983     2   p   2             enddo
             984     1   p                 enddo
             985                     
             986                           nlen=jtp*4*levp
             987                           call MPI_ALLTOALL( b1 ,nlen, MPI_RTYPE, &
             988                                              b2, nlen, MPI_RTYPE, &
             989                                              row_comm, IERR )
             990                     
             991                           i=1
             992                           j=1
             993                     
             994     1                     do m=1,mlistnum
             995     1                        mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      aout2, aout1
                                   <<< Loop-information  End >>>
             996     2                     do n=mf,jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.12, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      aout2, aout1
                                   <<< Loop-information  End >>>
             997     3  pp   2v            do k=1,levp
             998     3   p   2v               aout1(k,1,n,m)=b2(i,1,k,j)
             999     3   p   2v               aout1(k,2,n,m)=b2(i,2,k,j)
            1000     3   p   2v               aout2(k,1,n,m)=b2(i,3,k,j)
            1001     3   p   2v               aout2(k,2,n,m)=b2(i,4,k,j)
            1002     3   p   2v            enddo
            1003     2                        i=i+1
            1004     3                        if(i.gt.jtlen_all(j))then
            1005     3                           i=1
            1006     3                           j=j+1
            1007     3                        endif
            1008     2                     enddo
            1009     1                     enddo
            1010                     
            1011                           return
            1012                           end


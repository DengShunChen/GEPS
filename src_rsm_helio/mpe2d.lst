     8        20                     !
     8        21                     
     8        22                     !
     8        23                     !     All of these types were chosen with care to match the types of
     8        24                     !     their corresponding C variables.  Do not arbitrarily change
     8        25                     !     their types without also updating:
     8        26                     !
     8        27                     !     - the "mpi" module bindings
     8        28                     !     - the "mpi_f08" module bindings
     8        29                     !     - ompi/mpi/fortran/base/gen-mpi-mangling.pl
     8        30                     !
     8        31                     
     8        32                     !     MPI_BOTTOM is only used where choice buffers can be used (meaning
     8        33                     !     that we already have overloaded F90 bindings for all available
     8        34                     !     types), so any type is fine.
     8        35                           integer mpi_bottom
     8        36                     !     MPI_IN_PLACE has the same rationale as MPI_BOTTOM.
     8        37                           integer mpi_in_place
     8        38                     !     Making MPI_ARGV_NULL be the same type as the parameter that is
     8        39                     !     exepected in the F90 binding for MPI_COMM_SPAWN means that we
     8        40                     !     don't need another interface for MPI_COMM_SPAWN.
     8        41                           character mpi_argv_null(1)
     8        42                     !     Ditto for MPI_ARGVS_NULL / MPI_COMM_SPAWN_MULTIPLE.
     8        43                           character mpi_argvs_null(1, 1)
     8        44                     !     MPI_ERRCODES_IGNORE has similar rationale to MPI_ARGV_NULL.  The
     8        45                     !     F77 functions are all smart enough to check that the errcodes
     8        46                     !     parameter is not ERRCODES_IGNORE before assigning values into it
     8        47                     !     (hence, the fact that this is an array of only 1 element does not
     8        48                     !     matter -- we'll never overrun it because we never assign values
     8        49                     !     into it).
     8        50                           integer mpi_errcodes_ignore(1)
     8        51                     !     MPI_STATUS_IGNORE has similar rationale to MPI_ERRCODES_IGNORE.
     8        52                           integer mpi_status_ignore(mpi_status_size)
     8        53                     !     Ditto for MPI_STATUSES_IGNORE
     8        54                           integer mpi_statuses_ignore(mpi_status_size, 1)
     8        55                     !     Ditto for MPI_UNWEIGHTED
     8        56                           integer mpi_unweighted(1)
     8        57                     !     Ditto for MPI_WEIGHTS_EMPTY
     8        58                           integer mpi_weights_empty(1)
     8        59                     
     8        60                           common/mpi_fortran_bottom/mpi_bottom
     8        61                           common/mpi_fortran_in_place/mpi_in_place
     8        62                           common/mpi_fortran_argv_null/mpi_argv_null
     8        63                           common/mpi_fortran_argvs_null/mpi_argvs_null
     8        64                           common/mpi_fortran_errcodes_ignore/mpi_errcodes_ignore
     8        65                           common/mpi_fortran_status_ignore/mpi_status_ignore
     8        66                           common/mpi_fortran_statuses_ignore/mpi_statuses_ignore
     8        67                           common/mpi_fortran_unweighted/mpi_unweighted
     8        68                           common/mpi_fortran_weights_empty/mpi_weights_empty

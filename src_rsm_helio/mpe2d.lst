 External subroutine subprogram "mpe2d_reshape_pl_back"
  (inc)(line-no.)(nest)(optimize)
             676                     !----------------------------------------------------------------------------------------
             677                           subroutine mpe2d_reshape_pl_back(plin,plout)
             678                     
             679                     ! reshape spec coef back
             680                     
             681                           use mpi
             682                           use param
             683                           use index
             684                           use const,only : RTYPE,MPI_RTYPE
             685                     
             686                           implicit none
             687                     
             688                           integer n,i,j,m,mf,ierr
             689                     
             690                           real(kind=RTYPE) plin(jtp,2)
             691                           real(kind=RTYPE) plout(jtrun,jtmax,2)
             692                           real(kind=RTYPE) b2(jtp,2,nsizex)
             693                     
             694                           call MPI_ALLGATHER( plin, jtp*2, MPI_RTYPE, &
             695                                               b2,   jtp*2, MPI_RTYPE, &
             696                                               row_comm, IERR )
             697                     
             698                           i=1
             699                           j=1
             700                     
             701     1                     do m=1,mlistnum
             702     1                        mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jtlen_all, plout
                                   <<< Loop-information  End >>>
             703     2       2s            do n=mf,jtrun
             704     2       2m               plout(n,m,1)=b2(i,1,j)
             705     2       2v               plout(n,m,2)=b2(i,2,j)
             706     2       2s               i=i+1
             707     3       2s               if(i.gt.jtlen_all(j))then
             708     3       2s                  i=1
             709     3       2m                  j=j+1
             710     3       2v               endif
             711     2       2v            enddo
             712     1                     enddo
             713                     
             714                           return
             715                           end


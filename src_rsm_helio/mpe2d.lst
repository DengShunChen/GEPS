             492                           real*4 b1(levp,2,jtrun,jtmax)
             493                           real*4 b2(levp,2,jtrun,jtmax,proc)
             494                     
             495                           call MPI_ALLGATHER( ain, levp*2*jtrun*jtmax, MPI_REAL4, &
             496                                                b2, levp*2*jtrun*jtmax, MPI_REAL4, &
             497                                               comm,IERR )
             498                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             499     1  pp                 do jj=1,mlistnum
             500     2   p                 do j=1,jtrun
             501     2   p                    kk=1
                                   <<< Loop-information Start >>>

 External subroutine subprogram "nnmi"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine nnmi(no,x,epos,eval,evec,nn,c,d,bal,cutfreq)
               2                     !
               3                            use rank
               4                     !
               5                     !  purpose : to get delta x vector at each iteration
               6                     !-------------------------------------------------------------------
               7                     !  **** input ****
               8                     !  x    : vector matrix of variable array( tendency )
               9                     !  epos : inverse matrix array of eigenvector matrix
              10                     !  eval : eigenval array of coeffienent matrix
              11                     !  evec : eigenvector matrix array of coefficient matrix
              12                     !  nn   : dimension of array
              13                     !  c    : work array
              14                     !  d    : work array
              15                     !  cutfreq : cut of frequency
              16                     !  **** output ****
              17                     !  x    : vector matrix of variable array (correction)
              18                     !  bal  : convergence indicator
              19                     !
              20                     !  modify to f90 by C-H Lee and sort by River Chen in 2005
              21                     !
              22                     !--------------------------------------------------------------------
              23                           implicit  none
              24                           integer   no,nn
              25                           real      x(nn,2),epos(nn,nn),evec(nn,nn),eval(nn)
              26                           real      c(nn,2),d(nn,2),bal,cutfreq
              27                     
              28                           integer   i,j
              29                     !
              30                     ! set cut of frequency ( now , freq=1.0 means 24 hours )
              31                     !
              32                     !      data freq/1.0/
              33                     !
              34                     !   matrix multiplication to get alpha, (5.54)
              35                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      c
                                   <<< Loop-information  End >>>
              36        pp   4v             c=0.
              37                     !
              38                            call cplxmtl(epos,x,nn,c)
              39                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      d
                                   <<< Loop-information  End >>>
              40     1  pp   2v            do 110 i=1,nn
              41     1   p   2v              d(i,1)=0.
              42     1   p   2v              d(i,2)=0.
              43     1   p   2v       110  continue
              44                     !
              45                     !   compute BAL, by (5.64)
              46                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 348
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
              47     1  pp    v            do 120 j=1,nn
              48     2   p    v              if(abs(eval(j)).ge.cutfreq)then
              49     2               !        if(abs(eval(j)).le.cutfreq)then
              50     2   p    v                bal=bal+c(j,1)**2+c(j,2)**2
              51     2   p    v                d(j,1)=-c(j,2)/eval(j)
              52     2   p    v                d(j,2)= c(j,1)/eval(j)
              53     2   p    v              endif
              54     1   p    v       120  continue
              55                     !
              56                     !    transform alpha to get x, (5.55)
              57                     !
              58                            call cplxmtl(evec,d,nn,x)
              59                     !
              60                           return
              61                           end


                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pdpmel
                                   <<< Loop-information  End >>>
             133        pp   4v            pdpmel = 0.
             134                     !xb110<
             135                     
             136                           ktopm2= 2
             137     1                     do jk=ktopm2,klev
             138     1                       ikb = min(jk+1,klev)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 109
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum, kctop, ptenh, pgeoh, pmfu, pmfus

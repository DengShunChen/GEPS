             117     1  pp    v             do jl = 1, nxj
             118     1   p    v              prain(jl)=0.
             119     1   p    v              rhevap(jl)=0.          !xb110
             120     1   p    v              if(.not.ldcum(jl).or.kdtop(jl).lt.kctop(jl)) lddraf(jl)=.false.
             121     1   p    v              if(.not.ldcum(jl)) ktype(jl)=0
             122     1   p    v              idbas(jl) = klev
             123     2   p    v              if(lndj(jl) .eq. 1) then
             124     2   p    v                rhevap(jl) = 0.7
             125     2   p    v              else
             126     2   p    v                rhevap(jl) = 0.9
             127     2   p    v              end if
             128     1   p    v            enddo
             129                     
             130                     !xb110>
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pmflxs, pmflxr
                                   <<< Loop-information  End >>>
             131        pp   2v            pmflxr = 0.

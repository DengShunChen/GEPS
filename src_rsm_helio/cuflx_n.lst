                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pmflxr, pmflxs
                                   <<< Loop-information  End >>>
             181     1  pp   2v             do jl = 1, nxj
             182     1   p   2v              pmflxr(jl,klev+1) = 0.
             183     1   p   2v              pmflxs(jl,klev+1) = 0.
             184     1   p   2v            end do
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum
                                   <<<    SPILLS :

                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             185     1   s    s             do jl = 1, nxj
             186     2   p    v              if(ldcum(jl)) then
             187     2   m    m                ikb=kcbot(jl)
             188     2   p    v                ik=ikb+1
             189     2   m    m                zzp=((paph(jl,klev+1)-paph(jl,ik))/                  &
             190     2                    &     (paph(jl,klev+1)-paph(jl,ikb)))
             191     3   m    m                if(ktype(jl).eq.3) then
             192     3   p    v                  zzp=zzp**2
             193     3   p    v                endif
             194     2   p    v                pmfu(jl,ik)=pmfu(jl,ikb)*zzp
             195     2   m    m                pmfus(jl,ik)=(pmfus(jl,ikb)-                         &
             196     2                    &         foelhm(ptenh(jl,ikb))*pmful(jl,ikb))*zzp
             197     2   p    v                pmfuq(jl,ik)=(pmfuq(jl,ikb)+pmful(jl,ikb))*zzp
             198     2   p    v                pmful(jl,ik)=0.
             199     2   p    v              endif
             200     1   p    v            enddo
             201                     
             202     1                     do jk=ktopm2,klev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 95
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      idbas, lddraf, kcbot, pmfd, pmfdde_rate
                                   <<<      ldcum, pmful, ktype, paph, pmfu, pmfus
                                   <<<      pmfuq, pmfds
                                   <<<    PREFETCH(SOFT) : 2
                                   <<<     SEQUENTIAL : 2
                                   <<<      pmfdq: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             203     2  pp    v             do jl = 1, nxj
             204     3   p    v                if(ldcum(jl).and.jk.gt.kcbot(jl)+1) then
             205     3   p    v                  ikb=kcbot(jl)+1
             206     3   p    v                  zzp=((paph(jl,klev+1)-paph(jl,jk))/                &
             207     3                    &       (paph(jl,klev+1)-paph(jl,ikb)))
             208     4   p    v                  if(ktype(jl).eq.3) then
             209     4   p    v                    zzp=zzp**2
             210     4   p    v                  endif
             211     3   p    v                  pmfu(jl,jk)=pmfu(jl,ikb)*zzp
             212     3   p    v                  pmfus(jl,jk)=pmfus(jl,ikb)*zzp
             213     3   p    v                  pmfuq(jl,jk)=pmfuq(jl,ikb)*zzp
             214     3   p    v                  pmful(jl,jk)=0.
             215     3   p    v                endif
             216     2   p    v                ik = idbas(jl)
             217     2   p    v                llddraf = lddraf(jl) .and. jk > ik .and. ik < klev
             218     3   p    v                if ( llddraf .and. ik == kcbot(jl)+1 ) then
             219     3   p    v                 zzp = ((paph(jl,klev+1)-paph(jl,jk))/(paph(jl,klev+1)-paph(jl,ik)))
             220     3   p    v                 if ( ktype(jl) == 3 ) zzp = zzp*zzp
             221     3   p    v                  pmfd(jl,jk) = pmfd(jl,ik)*zzp
             222     3   p    v                  pmfds(jl,jk) = pmfds(jl,ik)*zzp
             223     3   p    v                  pmfdq(jl,jk) = pmfdq(jl,ik)*zzp
             224     3   p    v                  pmfdde_rate(jl,jk) = -(pmfd(jl,jk-1)-pmfd(jl,jk))
             225     3   p    v                 else if ( llddraf .and. ik /= kcbot(jl)+1 .and. jk == ik+1 ) then
             226     3   p    v                  pmfdde_rate(jl,jk) = -(pmfd(jl,jk-1)-pmfd(jl,jk))
             227     3   p    v                 end if

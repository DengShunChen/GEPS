              98                           integer  jl,jk
              99                           integer  is,ik,icall,ike,ikb
             100                           real     ztmst,ztaumel,zcons1a,zcons1,zcons2,zcucov,zcpecons
             101                           real     zalfaw,zrfl,zdrfl1,zrnew,zrmin,zrfln,zdrfl,zdenom

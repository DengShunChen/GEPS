              85                          &         pmfus(klon,klev),       pmfds(klon,klev),          &
              86                          &         pmfuq(klon,klev),       pmfdq(klon,klev),          &
              87                          &         pdmfup(klon,klev),      pdmfdp(klon,klev),         &
              88                          &         pdpmel(klon,klev),      prain(klon),               &
              89                          &         pmful(klon,klev),       plude(klon,klev),          &

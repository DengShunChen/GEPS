                                   <<< Loop-information  End >>>
             139     2  pp    v             do jl = 1, nxj
             140     2               !xb110>
             141     2               !          pmflxr(jl,jk) = 0.
             142     2               !          pmflxs(jl,jk) = 0.
             143     2               !          pdpmel(jl,jk) = 0.
             144     2               !xb110<
             145     3   p    v                if(ldcum(jl).and.jk.ge.kctop(jl)) then
             146     3   p    v                  pmfus(jl,jk)=pmfus(jl,jk)-pmfu(jl,jk)*           &
             147     3                    &       (cpd*ptenh(jl,jk)+pgeoh(jl,jk))
             148     3   p    v                  pmfuq(jl,jk)=pmfuq(jl,jk)-pmfu(jl,jk)*pqenh(jl,jk)
             149     3   p    v                  plglac(jl,jk)=pmfu(jl,jk)*plglac(jl,jk)
             150     3   p    v                  llddraf = lddraf(jl) .and. jk >= kdtop(jl)
             151     4   p    v                  if ( llddraf .and.jk.ge.kdtop(jl)) then
             152     4   p    v                    pmfds(jl,jk) = pmfds(jl,jk)-pmfd(jl,jk) * &
             153     4                                          (cpd*ptenh(jl,jk)+pgeoh(jl,jk))
             154     4   p    v                    pmfdq(jl,jk) = pmfdq(jl,jk)-pmfd(jl,jk)*pqenh(jl,jk)
             155     4   p    v                  else
             156     4   p    v                    pmfd(jl,jk) = 0.
             157     4   p    v                    pmfds(jl,jk) = 0.
             158     4   p    v                    pmfdq(jl,jk) = 0.
             159     4   p    v                    pdmfdp(jl,jk-1) = 0.
             160     4   p    v                  end if
             161     4   p    v                  if ( llddraf .and. pmfd(jl,jk) < 0. .and. &
             162     4                              abs(pmfd(jl,ikb)) < 1.e-20 ) then
             163     4   p    v                     idbas(jl) = jk
             164     4   p    v                  end if
             165     3   p    v                else
             166     3   p    v                  pmfu(jl,jk)=0.
             167     3   p    v                  pmfd(jl,jk)=0.
             168     3   p    v                  pmfus(jl,jk)=0.
             169     3   p    v                  pmfds(jl,jk)=0.
             170     3   p    v                  pmfuq(jl,jk)=0.
             171     3   p    v                  pmfdq(jl,jk)=0.
             172     3   p    v                  pmful(jl,jk)=0.
             173     3   p    v                  plglac(jl,jk)=0.
             174     3   p    v                  pdmfup(jl,jk-1)=0.
             175     3   p    v                  pdmfdp(jl,jk-1)=0.
             176     3   p    v                  plude(jl,jk-1)=0.
             177     3   p    v                endif
             178     2   p    v              enddo
             179     1                     enddo
             180                     
                                   <<< Loop-information Start >>>

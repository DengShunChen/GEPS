             239     4   s    s                  if(pmflxs(jl,jk).gt.0..and.pten(jl,jk).gt.tmelt) then
             240     4   s    s                    zcons1=zcons1a*(1.+0.5*(pten(jl,jk)-tmelt))
             241     4   s    s                    zfac=zcons1*(paph(jl,jk+1)-paph(jl,jk))
             242     4   s    s                    zsnmlt=min(pmflxs(jl,jk),zfac*(pten(jl,jk)-tmelt))
             243     4   s    s                    pdpmel(jl,jk)=zsnmlt
             244     4   m    m                    pqsen(jl,jk)=foeewm(pten(jl,jk)-zsnmlt/zfac)/pap(jl,jk)
             245     4   s    s                  endif
             246     3   s    s                  zalfaw=foealfa(pten(jl,jk))
             247     3                         !
             248     3                         ! No liquid precipitation above melting level
             249     3                         !
             250     4   s    s                  if ( pten(jl,jk) < tmelt .and. zalfaw > 0. ) then
             251     4   m    m                    plglac(jl,jk) = plglac(jl,jk)+zalfaw*(pdmfup(jl,jk)+pdmfdp(jl,jk))
             252     4   s    s                    zalfaw = 0.
             253     4   s    s                  end if
             254     3   m    m                  pmflxr(jl,jk+1)=pmflxr(jl,jk)+zalfaw*               &
             255     3                    &       (pdmfup(jl,jk)+pdmfdp(jl,jk))+pdpmel(jl,jk)
             256     3   m    m                  pmflxs(jl,jk+1)=pmflxs(jl,jk)+(1.-zalfaw)*          &
             257     3                    &       (pdmfup(jl,jk)+pdmfdp(jl,jk))-pdpmel(jl,jk)
             258     4   p    v                  if(pmflxr(jl,jk+1)+pmflxs(jl,jk+1).lt.0.0) then
             259     4   p    v                    pdmfdp(jl,jk)=-(pmflxr(jl,jk)+pmflxs(jl,jk)+pdmfup(jl,jk))
             260     4   p    v                    pmflxr(jl,jk+1)=0.0
             261     4   p    v                    pmflxs(jl,jk+1)=0.0
             262     4   p    v                    pdpmel(jl,jk)  =0.0
             263     4   p    v                  else if ( pmflxr(jl,jk+1) < 0. ) then
             264     4   p    v                    pmflxs(jl,jk+1) = pmflxs(jl,jk+1)+pmflxr(jl,jk+1)
             265     4   p    v                    pmflxr(jl,jk+1) = 0.
             266     4   p    v                  else if ( pmflxs(jl,jk+1) < 0. ) then
             267     4   p    v                    pmflxr(jl,jk+1) = pmflxr(jl,jk+1)+pmflxs(jl,jk+1)
             268     4   p    v                    pmflxs(jl,jk+1) = 0.
             269     4   p    v                  end if
             270     3   p    v                endif
             271     2   p    v              enddo
             272     1                     enddo
             273     1                     do jk=ktopm2,klev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 5  FILL 12
                                   <<<      SIMD&FP   : SPILL 0  FILL 2
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             274     2   s    s             do jl = 1, nxj
             275     3   m    m                if(ldcum(jl).and.jk.ge.kcbot(jl)) then
             276     3   s    s                  zrfl=pmflxr(jl,jk)+pmflxs(jl,jk)
             277     4   s    s                  if(zrfl.gt.1.e-20) then
             278     4   p    v                    zdrfl1=zcpecons*max(0.,pqsen(jl,jk)-pqen(jl,jk))*zcucov* &
             279     4                    &         (sqrt(paph(jl,jk)/paph(jl,klev+1))/5.09e-3*             &
             280     4                    &         zrfl/zcucov)**0.5777*                                   &
             281     4                    &         (paph(jl,jk+1)-paph(jl,jk))
             282     4   p    v                    zrnew=zrfl-zdrfl1
             283     4   p    v                    zrmin=zrfl-zcucov*max(0.,rhevap(jl)*pqsen(jl,jk) &
             284     4                    &              -pqen(jl,jk)) *zcons2*(paph(jl,jk+1)-paph(jl,jk))
             285     4   p    v                    zrnew=max(zrnew,zrmin)
             286     4   p    v                    zrfln=max(zrnew,0.)
             287     4   p    v                    zdrfl=min(0.,zrfln-zrfl)
             288     4   p    v                    zdenom=1./max(1.e-20,pmflxr(jl,jk)+pmflxs(jl,jk))
             289     4   s    s                    zalfaw=foealfa(pten(jl,jk))
             290     4   s    s                    if ( pten(jl,jk) < tmelt ) zalfaw = 0.
             291     4   s    s                    zpdr=zalfaw*pdmfdp(jl,jk)
             292     4   m    m                    zpds=(1.-zalfaw)*pdmfdp(jl,jk)
             293     4   m    m                    pmflxr(jl,jk+1)=pmflxr(jl,jk)+zpdr         &
             294     4                    &         +pdpmel(jl,jk)+zdrfl*pmflxr(jl,jk)*zdenom
             295     4   p    v                    pmflxs(jl,jk+1)=pmflxs(jl,jk)+zpds         &
             296     4                    &         -pdpmel(jl,jk)+zdrfl*pmflxs(jl,jk)*zdenom
             297     4   p    v                    pdmfup(jl,jk)=pdmfup(jl,jk)+zdrfl
             298     5   p    v                    if ( pmflxr(jl,jk+1)+pmflxs(jl,jk+1) < 0. ) then
             299     5   p    v                      pdmfup(jl,jk) = pdmfup(jl,jk)-(pmflxr(jl,jk+1)+pmflxs(jl,jk+1))
             300     5   p    v                      pmflxr(jl,jk+1) = 0.
             301     5   p    v                      pmflxs(jl,jk+1) = 0.
             302     5   p    v                      pdpmel(jl,jk)   = 0.
             303     5   p    v                    else if ( pmflxr(jl,jk+1) < 0. ) then
             304     5   p    v                      pmflxs(jl,jk+1) = pmflxs(jl,jk+1)+pmflxr(jl,jk+1)
             305     5   p    v                      pmflxr(jl,jk+1) = 0.
             306     5   p    v                    else if ( pmflxs(jl,jk+1) < 0. ) then
             307     5   p    v                      pmflxr(jl,jk+1) = pmflxr(jl,jk+1)+pmflxs(jl,jk+1)
             308     5   p    v                      pmflxs(jl,jk+1) = 0.
             309     5   p    v                    end if
             310     4   p    v                  else
             311     4   p    v                    pmflxr(jl,jk+1)=0.0
             312     4   p    v                    pmflxs(jl,jk+1)=0.0
             313     4   p    v                    pdmfdp(jl,jk)=0.0
             314     4   p    v                    pdpmel(jl,jk)=0.0
             315     4   p    v                  endif
             316     3   p    v                endif
             317     2   p    v              enddo
             318     1                     enddo
             319                     
             320                           return
             321                           end subroutine cuflx_n


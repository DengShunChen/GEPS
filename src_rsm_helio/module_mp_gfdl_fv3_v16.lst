            1061                     ! -----------------------------------------------------------------------
            1062                     !> sedimentation of heat
            1063                     ! -----------------------------------------------------------------------
            1064                     
            1065                     subroutine sedi_heat (ktop, kbot, dm, m1, dz, tz, qv, ql, qr, qi, qs, qg, cw)
            1066                     
            1067                         implicit none
            1068                     
            1069                         ! input q fields are dry mixing ratios, and dm is dry air mass
            1070                     
            1071                         integer, intent (in) :: ktop, kbot
            1072                     
            1073                         real, intent (in), dimension (ktop:kbot) :: dm, m1, dz, qv, ql, qr, qi, qs, qg
            1074                     
            1075                         real, intent (inout), dimension (ktop:kbot) :: tz
            1076                     
            1077                         real, intent (in) :: cw ! heat capacity
            1078                     
            1079                         real, dimension (ktop:kbot) :: dgz, cvn
            1080                     
            1081                         real :: tmp
            1082                     
            1083                         integer :: k
            1084                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 341
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.22, ITR: 88, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv, qr, ql, qi, qs, qg, dm, dz, cvn, dgz
                                   <<< Loop-information  End >>>
            1085     1  pp    v          do k = ktop, kbot
            1086     1   p    v              dgz (k) = - 0.5 * grav * dz (k) ! > 0
            1087     1   p    v              cvn (k) = dm (k) * (cv_air + qv (k) * cv_vap + (qr (k) + ql (k)) * &
            1088     1                           c_liq + (qi (k) + qs (k) + qg (k)) * c_ice)
            1089     1   p    v          enddo
            1090                     
            1091                         ! -----------------------------------------------------------------------
            1092                         ! sjl, july 2014
            1093                         ! assumption: the ke in the falling condensates is negligible compared to the potential energy
            1094                         ! that was unaccounted for. local thermal equilibrium is assumed, and the loss in pe is transformed
            1095                         ! into internal energy (to heat the whole grid box)
            1096                         ! backward time - implicit upwind transport scheme:
            1097                         ! dm here is dry air mass
            1098                         ! -----------------------------------------------------------------------
            1099                     
            1100                         k = ktop
            1101                         tmp = cvn (k) + m1 (k) * cw
            1102                         tz (k) = (tmp * tz (k) + m1 (k) * dgz (k)) / tmp
            1103                     
            1104                         ! -----------------------------------------------------------------------
            1105                         ! implicit algorithm: can't be vectorized
            1106                         ! needs an inner i - loop for vectorization
            1107                         ! -----------------------------------------------------------------------
            1108                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.27, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dgz, cvn, tz, m1
                                   <<< Loop-information  End >>>
            1109     1   s   2s          do k = ktop + 1, kbot
            1110     1   m   2m              tz (k) = ((cvn (k) + cw * (m1 (k) - m1 (k - 1))) * tz (k) + m1 (k - 1) * &
            1111     1                           cw * tz (k - 1) + dgz (k) * (m1 (k - 1) + m1 (k))) / (cvn (k) + cw * m1 (k))
            1112     1   p   2v          enddo
            1113                     
            1114                     end subroutine sedi_heat
            1115                     
            1116                     ! -----------------------------------------------------------------------
            1117                     !> warm rain cloud microphysics
            1118                     ! -----------------------------------------------------------------------

            1617     1  pp    v          do k = ktop, kbot
            1618     1               
            1619     1                       ! -----------------------------------------------------------------------
            1620     1                       ! do nothing above p_min
            1621     1                       ! -----------------------------------------------------------------------
            1622     1               
            1623     1   p    v              if (p1 (k) < p_min) cycle
            1624     1               
            1625     1   p    v              tz = tzk (k)
            1626     1   p    v              qv = qvk (k)
            1627     1   p    v              ql = qlk (k)
            1628     1   p    v              qi = qik (k)
            1629     1   p    v              qr = qrk (k)
            1630     1   p    v              qs = qsk (k)
            1631     1   p    v              qg = qgk (k)
            1632     1               
            1633     1   p    v              pgacr = 0.
            1634     1   p    v              pgacw = 0.
            1635     1   p    v              tc = tz - tice
            1636     1               
            1637     2   p    v              if (tc .ge. 0.) then
            1638     2               
            1639     2                           ! -----------------------------------------------------------------------
            1640     2                           ! melting of snow
            1641     2                           ! -----------------------------------------------------------------------
            1642     2               
            1643     2   p    v                  dqs0 = ces0 / p1 (k) - qv
            1644     2               
            1645     3   p    v                  if (qs > qcmin) then
            1646     3               
            1647     3                               ! -----------------------------------------------------------------------
            1648     3                               ! psacw: accretion of cloud water by snow
            1649     3                               ! only rate is used (for snow melt) since tc > 0.
            1650     3                               ! -----------------------------------------------------------------------
            1651     3               
            1652     4   p    v                      if (ql > qrmin) then
            1653     4   p    v                          factor = denfac (k) * csacw * exp (0.8125 * log (qs * den (k)))
            1654     4   p    v                          psacw = factor / (1. + dts * factor) * ql ! rate
            1655     4   p    v                      else
            1656     4   p    v                          psacw = 0.
            1657     4   p    v                      endif
            1658     3               
            1659     3                               ! -----------------------------------------------------------------------
            1660     3                               ! psacr: accretion of rain by melted snow
            1661     3                               ! pracs: accretion of snow by rain
            1662     3                               ! -----------------------------------------------------------------------
            1663     3               
            1664     4   p    v                      if (qr > qrmin) then
            1665     4   pi   v                          psacr = min (acr3d (vts (k), vtr (k), qr, qs, csacr, acco (1, 2), &
            1666     4                                       den (k)), qr * rdts)
            1667     4   pi   v                          pracs = acr3d (vtr (k), vts (k), qs, qr, cracs, acco (1, 1), den (k))
            1668     4   p    v                      else
            1669     4   p    v                          psacr = 0.
            1670     4   p    v                          pracs = 0.
            1671     4   p    v                      endif
            1672     3               
            1673     3                               ! -----------------------------------------------------------------------
            1674     3                               ! total snow sink:
            1675     3                               ! psmlt: snow melt (due to rain accretion)
            1676     3                               ! -----------------------------------------------------------------------
            1677     3               
            1678     3   pi   v                      psmlt = max (0., smlt (tc, dqs0, qs * den (k), psacw, psacr, csmlt, &
            1679     3                                   den (k), denfac (k)))
            1680     3   p    v                      sink = min (qs, dts * (psmlt + pracs), tc / icpk (k))
            1681     3   p    v                      qs = qs - sink
            1682     3                               ! sjl, 20170321:
            1683     3   p    v                      tmp = min (sink, dim (qs_mlt, ql)) ! max ql due to snow melt
            1684     3   p    v                      ql = ql + tmp
            1685     3   p    v                      qr = qr + sink - tmp
            1686     3                               ! qr = qr + sink
            1687     3                               ! sjl, 20170321:
            1688     3   p    v                      q_liq (k) = q_liq (k) + sink
            1689     3   p    v                      q_sol (k) = q_sol (k) - sink
            1690     3   p    v                      cvm (k) = c_air + qv * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1691     3   p    v                      tz = tz - sink * lhi (k) / cvm (k)
            1692     3   p    v                      tc = tz - tice
            1693     3               
            1694     3   p    v                  endif
            1695     2               
            1696     2                           ! -----------------------------------------------------------------------
            1697     2                           ! update capacity heat and latend heat coefficient
            1698     2                           ! -----------------------------------------------------------------------
            1699     2               
            1700     2   p    v                  lhi (k) = li00 + dc_ice * tz
            1701     2   p    v                  icpk (k) = lhi (k) / cvm (k)
            1702     2               
            1703     2                           ! -----------------------------------------------------------------------
            1704     2                           ! melting of graupel
            1705     2                           ! -----------------------------------------------------------------------
            1706     2               
            1707     3   p    v                  if (qg > qcmin .and. tc > 0.) then
            1708     3               
            1709     3                               ! -----------------------------------------------------------------------

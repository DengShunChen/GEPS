            4636                     ! ==========================================================================
            4637                     !>@brief The subroutine 'interpolate_z' interpolates to a prescribed height.
            4638                     ! ==========================================================================
            4639                     
            4640                     subroutine interpolate_z (is, ie, js, je, km, zl, hgt, a3, a2)
            4641                     
            4642                         implicit none
            4643                     
            4644                         integer, intent (in) :: is, ie, js, je, km
            4645                     
            4646                         real, intent (in), dimension (is:ie, js:je, km) :: a3
            4647                     
            4648                         real, intent (in), dimension (is:ie, js:je, km + 1) :: hgt !< hgt (k) > hgt (k + 1)
            4649                     
            4650                         real, intent (in) :: zl
            4651                     
            4652                         real, intent (out), dimension (is:ie, js:je) :: a2
            4653                     
            4654                         real, dimension (km) :: zm !< middle layer height
            4655                     
            4656                         integer :: i, j, k
            4657                     
            4658                         !$omp parallel do default (none) shared (is, ie, js, je, km, hgt, zl, a2, a3) private (zm)
            4659                     
            4660     1   p               do j = js, je
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
            4661     2   p                   do i = is, ie
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 160, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
            4662     3   p   2v                  do k = 1, km
            4663     3   p   2v                      zm (k) = 0.5 * (hgt (i, j, k) + hgt (i, j, k + 1))
            4664     3   p   2v                  enddo
            4665     3   p                       if (zl >= zm (1)) then
            4666     3   p                           a2 (i, j) = a3 (i, j, 1)
            4667     3   p                       elseif (zl <= zm (km)) then
            4668     3   p                           a2 (i, j) = a3 (i, j, km)
            4669     3   p                       else
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
            4670     4   p                           do k = 1, km - 1
            4671     5   p                               if (zl <= zm (k) .and. zl >= zm (k + 1)) then
            4672     5   p                                   a2 (i, j) = a3 (i, j, k) + (a3 (i, j, k + 1) - a3 (i, j, k)) * (zm (k) - zl) / (zm (k) - zm (k + 1))
            4673     5   p                                   exit
            4674     5   p                               endif
            4675     4   p                           enddo
            4676     3   p                       endif
            4677     2   p                   enddo
            4678     1   p               enddo
            4679                     
            4680                     end subroutine interpolate_z
            4681                     
            4682                     ! =======================================================================
            4683                     !>@brief The subroutine 'cloud_diagnosis' diagnoses the radius of cloud
            4684                     !! species.
            4685                     !>author Linjiong Zhoum, Shian-Jiann Lin
            4686                     ! =======================================================================
            4687                     
            4688                     subroutine cloud_diagnosis                                              &
            4689                     !   --- input  :
            4690                             ( is, ie, ks, ke, den, delp, lsm,                               &
            4691                               qmw, qmi, qmr, qms, qmg, t,                                   &
            4692                     !   --- output :
            4693                               rew, rei, rer, res, reg)
            4694                     !
            4695                         use const, only: RTYPE
            4696                     !
            4697                         implicit none
            4698                     
            4699                         integer, intent (in) :: is, ie, ks, ke
            4700                         integer, intent (in), dimension (is:ie) :: lsm ! land sea mask, 0: ocean, 1: land, 2: sea ice
            4701                     
            4702                         real(kind=RTYPE), intent (in), dimension (is:ie, ks:ke) :: t
            4703                         real, intent (in), dimension (is:ie, ks:ke) :: den, delp
            4704                         real, intent (in), dimension (is:ie, ks:ke) :: qmw, qmi, qmr, qms, qmg !< units: kg / kg
            4705                     
            4706                         real, intent (out), dimension (is:ie, ks:ke) :: rew, rei, rer, res, reg !< units: micron
            4707                     
            4708                         real, dimension (is:ie, ks:ke) :: qcw, qci, qcr, qcs, qcg !< units: g / m^2
            4709                     
            4710                         integer :: i, k
            4711                     
            4712                         real :: lambdar, lambdas, lambdag
            4713                         real :: dpg, rei_fac, mask, ccn, bw
            4714                         real, parameter :: rho_0 = 50.e-3
            4715                     
            4716                         real :: rhow = 1.0e3, rhor = 1.0e3, rhos = 1.0e2, rhog = 4.0e2
            4717                         real :: n0r = 8.0e6, n0s = 3.0e6, n0g = 4.0e6
            4718                         real :: alphar = 0.8, alphas = 0.25, alphag = 0.5
            4719                         real :: gammar = 17.837789, gammas = 8.2850630, gammag = 11.631769
            4720                         real :: qmin = 1.0e-12, beta = 1.22, qmin1 = 9.e-6
            4721                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            4722     1  pp               do k = ks, ke
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qmg, den, qms, reg, res, qmr, rer, qmi
                                   <<<      t, rei, qmw, lsm, rew, delp, qcw, qci
                                   <<<    PREFETCH(SOFT) : 6
                                   <<<     SEQUENTIAL : 6
                                   <<<      qcr: 2, qcs: 2, qcg: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 18  FILL 43
                                   <<<      PREDICATE : SPILL 5  FILL 13
                                   <<< Loop-information  End >>>
            4723     2   p    v              do i = is, ie
            4724     2               
            4725     2   p    v                  dpg = abs (delp (i, k)) / grav
            4726     2   p    v                  mask = min (max (real(lsm (i)), 0.0), 2.0)
            4727     2               
            4728     2                           ! -----------------------------------------------------------------------
            4729     2                           ! cloud water (Martin et al., 1994)
            4730     2                           ! -----------------------------------------------------------------------
            4731     2               
            4732     2   p    v                  ccn = 0.80 * (- 1.15e-3 * (ccn_o ** 2) + 0.963 * ccn_o + 5.30) * abs (mask - 1.0) + &
            4733     2                               0.67 * (- 2.10e-4 * (ccn_l ** 2) + 0.568 * ccn_l - 27.9) * (1.0 - abs (mask - 1.0))
            4734     2               
            4735     3   p    v                  if (qmw (i, k) .gt. qmin) then
            4736     3   p    v                      qcw (i, k) = dpg * qmw (i, k) * 1.0e3
            4737     3   p    v                      rew (i, k) = exp (1.0 / 3.0 * log ((3.0 * den (i, k) * qmw (i, k)) / (4.0 * pi * rhow * ccn))) * 1.0e4
            4738     3   p    v                      rew (i, k) = max (rewmin, min (rewmax, rew (i, k)))
            4739     3   p    v                  else
            4740     3   p    v                      qcw (i, k) = 0.0
            4741     3   p    v                      rew (i, k) = rewmin
            4742     3   p    v                  endif
            4743     2               
            4744     3   p    v                  if (reiflag .eq. 1) then
            4745     3               
            4746     3                               ! -----------------------------------------------------------------------
            4747     3                               ! cloud ice (Heymsfield and Mcfarquhar, 1996)
            4748     3                               ! -----------------------------------------------------------------------
            4749     3               
            4750     4   p    v                      if (qmi (i, k) .gt. qmin1) then
            4751     4   p    v                          qci (i, k) = dpg * qmi (i, k) * 1.0e3
            4752     4   p    v                          rei_fac = log (1.0e3 * qmi (i, k) * den (i, k))
            4753     5   p    v                          if (t (i, k) - tice .lt. - 50) then
            4754     5   p    v                              rei (i, k) = beta / 9.917 * exp (0.109 * rei_fac) * 1.0e3
            4755     5   p    v                          elseif (t (i, k) - tice .lt. - 40) then
            4756     5   p    v                              rei (i, k) = beta / 9.337 * exp (0.080 * rei_fac) * 1.0e3
            4757     5   p    v                          elseif (t (i, k) - tice .lt. - 30) then
            4758     5   p    v                              rei (i, k) = beta / 9.208 * exp (0.055 * rei_fac) * 1.0e3
            4759     5   p    v                          else
            4760     5   p    v                              rei (i, k) = beta / 9.387 * exp (0.031 * rei_fac) * 1.0e3
            4761     5   p    v                          endif
            4762     4   p    v                          rei (i, k) = max (reimin, min (reimax, rei (i, k)))
            4763     4   p    v                      else
            4764     4   p    v                          qci (i, k) = 0.0
            4765     4   p    v                          rei (i, k) = reimin
            4766     4   p    v                      endif
            4767     3               
            4768     3   p    v                  endif
            4769     2               
            4770     3   p    v                  if (reiflag .eq. 2) then
            4771     3               
            4772     3                               ! -----------------------------------------------------------------------
            4773     3                               ! cloud ice (Wyser, 1998)
            4774     3                               ! -----------------------------------------------------------------------
            4775     3               
            4776     4   p    v                      if (qmi (i, k) .gt. qmin1) then
            4777     4   p    v                          qci (i, k) = dpg * qmi (i, k) * 1.0e3
            4778     4   p    v                          bw = - 2. + 1.e-3 * log10 (den (i, k) * qmi (i, k) / rho_0) * max (0.0, tice - t (i, k)) ** 1.5
            4779     4   p    v                          rei (i, k) = 377.4 + bw * (203.3 + bw * (37.91 + 2.3696 * bw))
            4780     4   p    v                          rei (i, k) = max (reimin, min (reimax, rei (i, k)))
            4781     4   p    v                      else
            4782     4   p    v                          qci (i, k) = 0.0
            4783     4   p    v                          rei (i, k) = reimin
            4784     4   p    v                      endif
            4785     3               
            4786     3   p    v                  endif
            4787     2               
            4788     2                           ! -----------------------------------------------------------------------
            4789     2                           ! rain (Lin et al., 1983)
            4790     2                           ! -----------------------------------------------------------------------
            4791     2               
            4792     3   p    v                  if (qmr (i, k) .gt. qmin) then
            4793     3   p    v                      qcr (i, k) = dpg * qmr (i, k) * 1.0e3
            4794     3   p    v                      lambdar = exp (0.25 * log (pi * rhor * n0r / qmr (i, k) / den (i, k)))
            4795     3   p    v                      rer (i, k) = 0.5 * exp (log (gammar / 6) / alphar) / lambdar * 1.0e6
            4796     3   p    v                      rer (i, k) = max (rermin, min (rermax, rer (i, k)))
            4797     3   p    v                  else
            4798     3   p    v                      qcr (i, k) = 0.0
            4799     3   p    v                      rer (i, k) = rermin
            4800     3   p    v                  endif
            4801     2               
            4802     2                           ! -----------------------------------------------------------------------
            4803     2                           ! snow (Lin et al., 1983)
            4804     2                           ! -----------------------------------------------------------------------
            4805     2               
            4806     3   p    v                  if (qms (i, k) .gt. qmin1) then
            4807     3   p    v                      qcs (i, k) = dpg * qms (i, k) * 1.0e3
            4808     3   p    v                      lambdas = exp (0.25 * log (pi * rhos * n0s / qms (i, k) / den (i, k)))
            4809     3   p    v                      res (i, k) = 0.5 * exp (log (gammas / 6) / alphas) / lambdas * 1.0e6
            4810     3   p    v                      res (i, k) = max (resmin, min (resmax, res (i, k)))
            4811     3   p    v                  else
            4812     3   p    v                      qcs (i, k) = 0.0
            4813     3   p    v                      res (i, k) = resmin
            4814     3   p    v                  endif
            4815     2               
            4816     2                           ! -----------------------------------------------------------------------
            4817     2                           ! graupel (Lin et al., 1983)
            4818     2                           ! -----------------------------------------------------------------------
            4819     2               
            4820     3   p    v                  if (qmg (i, k) .gt. qmin) then
            4821     3   p    v                      qcg (i, k) = dpg * qmg (i, k) * 1.0e3
            4822     3   p    v                      lambdag = exp (0.25 * log (pi * rhog * n0g / qmg (i, k) / den (i, k)))
            4823     3   p    v                      reg (i, k) = 0.5 * exp (log (gammag / 6) / alphag) / lambdag * 1.0e6
            4824     3   p    v                      reg (i, k) = max (regmin, min (regmax, reg (i, k)))
            4825     3   p    v                  else
            4826     3   p    v                      qcg (i, k) = 0.0
            4827     3   p    v                      reg (i, k) = regmin
            4828     3   p    v                  endif
            4829     2               
            4830     2   p    v              enddo
            4831     1   p               enddo
            4832                     
            4833                     end subroutine cloud_diagnosis
            4834                     
            4835                     !+---+-----------------------------------------------------------------+
            4836                     
            4837                           subroutine refl10cm_gfdl (qv1d, qr1d, qs1d, qg1d,                 &
            4838                                            t1d, p1d, dBZ, kts, kte, ii,jj, melti)
            4839                     
            4840                           IMPLICIT NONE
            4841                     
            4842                     !..Sub arguments
            4843                           INTEGER, INTENT(IN):: kts, kte, ii,jj
            4844                           REAL, DIMENSION(kts:kte), INTENT(IN)::                            &
            4845                                           qv1d, qr1d, qs1d, qg1d, t1d, p1d
            4846                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: dBZ
            4847                     
            4848                     !..Local variables
            4849                           REAL, DIMENSION(kts:kte):: temp, pres, qv, rho
            4850                           REAL, DIMENSION(kts:kte):: rr, rs, rg
            4851                     !      REAL:: temp_C
            4852                     
            4853                           DOUBLE PRECISION, DIMENSION(kts:kte):: ilamr, ilams, ilamg
            4854                           DOUBLE PRECISION, DIMENSION(kts:kte):: N0_r, N0_s, N0_g
            4855                           DOUBLE PRECISION:: lamr, lams, lamg
            4856                           LOGICAL, DIMENSION(kts:kte):: L_qr, L_qs, L_qg
            4857                     
            4858                           REAL, DIMENSION(kts:kte):: ze_rain, ze_snow, ze_graupel
            4859                           DOUBLE PRECISION:: fmelt_s, fmelt_g
            4860                     
            4861                           INTEGER:: i, k, k_0, kbot, n
            4862                           LOGICAL, INTENT(IN):: melti
            4863                           DOUBLE PRECISION:: cback, x, eta, f_d
            4864                     !+---+
            4865                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dBZ
                                   <<< Loop-information  End >>>
            4866     1  pp   4v            do k = kts, kte
            4867     1   p   4v               dBZ(k) = -35.0
            4868     1   p   4v            enddo
            4869                     
            4870                     !+---+-----------------------------------------------------------------+
            4871                     !..Put column of data into local arrays.
            4872                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 14
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg1d, qs1d, qr1d, p1d, t1d, pres, N0_g
                                   <<<      L_qg, N0_s, L_qs, N0_r, L_qr, qv1d, qv
                                   <<<      rho, ilamr
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      rr: 2, ilams: 2, rs: 2, ilamg: 2, rg: 2
                                   <<<      temp: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 1  FILL 15
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4873     1  pp    v            do k = kts, kte
            4874     1   p    v               temp(k) = t1d(k)
            4875     1               !         temp_C = min(-0.001, temp(K)-273.15)
            4876     1   p    v               qv(k) = MAX(1.E-10, qv1d(k))
            4877     1   p    v               pres(k) = p1d(k)
            4878     1   p    v               rho(k) = 0.622*pres(k)/(rdgas*temp(k)*(qv(k)+0.622))
            4879     1               
            4880     2   p    v               if (qr1d(k) .gt. 1.E-9) then
            4881     2   p    v                  rr(k) = qr1d(k)*rho(k)
            4882     2   p    v                  N0_r(k) = n0r
            4883     2   p    v                  lamr = (xam_r*xcrg(3)*N0_r(k)/rr(k))**(1./xcre(1))
            4884     2   p    v                  ilamr(k) = 1./lamr
            4885     2   p    v                  L_qr(k) = .true.
            4886     2   p    v               else
            4887     2   p    v                  rr(k) = 1.E-12
            4888     2   p    v                  L_qr(k) = .false.
            4889     2   p    v               endif
            4890     1               
            4891     2   p    v               if (qs1d(k) .gt. 1.E-9) then
            4892     2   p    v                  rs(k) = qs1d(k)*rho(k)
            4893     2   p    v                  N0_s(k) = n0s
            4894     2   p    v                  lams = (xam_s*xcsg(3)*N0_s(k)/rs(k))**(1./xcse(1))
            4895     2   p    v                  ilams(k) = 1./lams
            4896     2   p    v                  L_qs(k) = .true.
            4897     2   p    v               else
            4898     2   p    v                  rs(k) = 1.E-12
            4899     2   p    v                  L_qs(k) = .false.
            4900     2   p    v               endif
            4901     1               
            4902     2   p    v               if (qg1d(k) .gt. 1.E-9) then
            4903     2   p    v                  rg(k) = qg1d(k)*rho(k)
            4904     2   p    v                  N0_g(k) = n0g
            4905     2   p    v                  lamg = (xam_g*xcgg(3)*N0_g(k)/rg(k))**(1./xcge(1))
            4906     2   p    v                  ilamg(k) = 1./lamg
            4907     2   p    v                  L_qg(k) = .true.
            4908     2   p    v               else
            4909     2   p    v                  rg(k) = 1.E-12
            4910     2   p    v                  L_qg(k) = .false.
            4911     2   p    v               endif
            4912     1   p    v            enddo
            4913                     
            4914                     !+---+-----------------------------------------------------------------+
            4915                     !..Locate K-level of start of melting (k_0 is level above).
            4916                     !+---+-----------------------------------------------------------------+
            4917                           k_0 = kts
            4918     1                    K_LOOP:do k = kte-1, kts, -1
            4919     2                        if ( melti .and. (temp(k).gt.273.15) .and. L_qr(k)          &
            4920     2                             .and. (L_qs(k+1).or.L_qg(k+1)) ) then
            4921     2                           k_0 = MAX(k+1, k_0)
            4922     2                           EXIT K_LOOP
            4923     2                        endif
            4924     1                     enddo K_LOOP
            4925                     !+---+-----------------------------------------------------------------+
            4926                     !..Assume Rayleigh approximation at 10 cm wavelength. Rain (all temps)
            4927                     !.. and non-water-coated snow and graupel when below freezing are
            4928                     !.. simple. Integrations of m(D)*m(D)*N(D)*dD.
            4929                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      L_qg, ze_graupel, ze_snow, ze_rain
                                   <<<      ilamg, N0_g, L_qs, ilams, L_qr, N0_s
                                   <<<      ilamr, N0_r
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 4
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4930     1  pp    v            do k = kts, kte
            4931     1   p    v               ze_rain(k) = 1.e-22
            4932     1   p    v               ze_snow(k) = 1.e-22
            4933     1   p    v               ze_graupel(k) = 1.e-22
            4934     1   p    v               if (L_qr(k)) ze_rain(k) = N0_r(k)*xcrg(4)*ilamr(k)**xcre(4)
            4935     1   p    v               if (L_qs(k)) ze_snow(k) = (0.176/0.93) * (6.0/PI)*(6.0/PI)     &
            4936     1                                                * (xam_s/900.0)*(xam_s/900.0)          &
            4937     1                                                * N0_s(k)*xcsg(4)*ilams(k)**xcse(4)
            4938     1   p    v               if (L_qg(k)) ze_graupel(k) = (0.176/0.93) * (6.0/PI)*(6.0/PI)  &
            4939     1                                                   * (xam_g/900.0)*(xam_g/900.0)       &
            4940     1                                                   * N0_g(k)*xcgg(4)*ilamg(k)**xcge(4)
            4941     1   p    v            enddo
            4942                     
            4943                     
            4944                     !+---+-----------------------------------------------------------------+
            4945                     !..Special case of melting ice (snow/graupel) particles.  Assume the
            4946                     !.. ice is surrounded by the liquid water.  Fraction of meltwater is
            4947                     !.. extremely simple based on amount found above the melting level.
            4948                     !.. Uses code from Uli Blahak (rayleigh_soak_wetgraupel and supporting
            4949                     !.. routines).
            4950                     !+---+-----------------------------------------------------------------+
            4951                     
            4952     1                     if (melti .and. k_0.ge.kts+1) then
            4953     2                      do k = k_0-1, kts, -1
            4954     2               
            4955     2               !..Reflectivity contributed by melting snow
            4956     3                         if (L_qs(k) .and. L_qs(k_0) ) then
            4957     3                          fmelt_s = MAX(0.005d0, MIN(1.0d0-rs(k)/rs(k_0), 0.99d0))
            4958     3                          eta = 0.d0
            4959     3                          lams = 1./ilams(k)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDs, simpson, xdts
                                   <<< Loop-information  End >>>
            4960     4                          do n = 1, nrbins
            4961     4                             x = xam_s * xxDs(n)**xbm_s
            4962     4                             call rayleigh_soak_wetgraupel (x,DBLE(xocms),DBLE(xobms), &
            4963     4                                   fmelt_s, melt_outside_s, m_w_0, m_i_0, lamda_radar, &
            4964     4                                   CBACK, mixingrulestring_s, matrixstring_s,          &
            4965     4                                   inclusionstring_s, hoststring_s,                    &
            4966     4                                   hostmatrixstring_s, hostinclusionstring_s)
            4967     4                             f_d = N0_s(k)*xxDs(n)**xmu_s * DEXP(-lams*xxDs(n))
            4968     4                             eta = eta + f_d * CBACK * simpson(n) * xdts(n)
            4969     4                          enddo
            4970     3                          ze_snow(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            4971     3                         endif
            4972     2               
            4973     2               
            4974     2               !..Reflectivity contributed by melting graupel
            4975     2               
            4976     3                         if (L_qg(k) .and. L_qg(k_0) ) then
            4977     3                          fmelt_g = MAX(0.005d0, MIN(1.0d0-rg(k)/rg(k_0), 0.99d0))
            4978     3                          eta = 0.d0
            4979     3                          lamg = 1./ilamg(k)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDg, simpson, xdtg
                                   <<< Loop-information  End >>>
            4980     4                          do n = 1, nrbins
            4981     4                             x = xam_g * xxDg(n)**xbm_g
            4982     4                             call rayleigh_soak_wetgraupel (x,DBLE(xocmg),DBLE(xobmg), &
            4983     4                                   fmelt_g, melt_outside_g, m_w_0, m_i_0, lamda_radar, &
            4984     4                                   CBACK, mixingrulestring_g, matrixstring_g,          &
            4985     4                                   inclusionstring_g, hoststring_g,                    &
            4986     4                                   hostmatrixstring_g, hostinclusionstring_g)
            4987     4                             f_d = N0_g(k)*xxDg(n)**xmu_g * DEXP(-lamg*xxDg(n))
            4988     4                             eta = eta + f_d * CBACK * simpson(n) * xdtg(n)
            4989     4                          enddo
            4990     3                          ze_graupel(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            4991     3                         endif
            4992     2               
            4993     2                      enddo
            4994     1                     endif
            4995                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.08, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ze_snow, ze_rain, ze_graupel, dBZ
                                   <<< Loop-information  End >>>
            4996     1  pp    v            do k = kte, kts, -1
            4997     1   p    v               dBZ(k) = 10.*log10((ze_rain(k)+ze_snow(k)+ze_graupel(k))*1.d18)
            4998     1   p    v            enddo
            4999                     
            5000                     
            5001                           end subroutine refl10cm_gfdl
            5002                     !+---+-----------------------------------------------------------------+
            5003                     
            5004                     end module module_mp_gfdl


                                   <<<      SCALABLE  : SPILL 0  FILL 28
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1297     2  pp    v              do k = ktop, kbot
            1298     2   p    v                  qc0 = fac_rc * ccn (k)
            1299     3   p    v                  if (tz (k) > t_wfr + dt_fr) then
            1300     3   p    v                      dl (k) = min (max (1.e-6, dl (k)), 0.5 * ql (k))
            1301     3                               ! --------------------------------------------------------------------
            1302     3                               ! as in klein's gfdl am2 stratiform scheme (with subgrid variations)
            1303     3                               ! --------------------------------------------------------------------
            1304     4   p    v                      if (use_ccn) then
            1305     4                                   ! --------------------------------------------------------------------
            1306     4                                   ! ccn is formulted as ccn = ccn_surface * (den / den_surface)

            3638                     
            3639                     end subroutine gfdl_cloud_microphys_end
            3640                     
            3641                     ! =======================================================================
            3642                     ! qsmith table initialization
            3643                     !>@brief The subroutine 'setup_con' sets up constants and calls 'qsmith_init'.
            3644                     ! =======================================================================
            3645                     
            3646                     subroutine setup_con
            3647                     
            3648                         implicit none

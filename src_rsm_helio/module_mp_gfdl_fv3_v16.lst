             328                             resmin, resmax, regmin, regmax, tintqs, do_melt
             329                     
             330                         public                                                                    &
             331                             mp_time, t_min, t_sub, tau_r2g, tau_smlt, tau_g2r, dw_land, dw_ocean, &
             332                             vi_fac, vr_fac, vs_fac, vg_fac, ql_mlt, do_qa, fix_negative, vi_max,  &
             333                             vs_max, vg_max, vr_max, qs_mlt, qs0_crt, qi_gen, ql0_max, qi0_max,    &
             334                             qi0_crt, qr0_crt, fast_sat_adj, rh_inc, rh_ins, rh_inr, const_vi,     &
             335                             const_vs, const_vg, const_vr, use_ccn, rthresh, ccn_l, ccn_o, qc_crt, &
             336                             tau_g2v, tau_v2g, sat_adj0, c_piacr, tau_imlt, tau_v2l, tau_l2v,      &
             337                             tau_i2s, tau_l2r, qi_lim, ql_gen, c_paut, c_psaci, c_pgacs,           &
             338                             z_slope_liq, z_slope_ice, prog_ccn, c_cracw, alin, clin, tice,        &
             339                             rad_snow, rad_graupel, rad_rain, cld_min, use_ppm, mono_prof,         &
             340                             do_sedi_heat, sedi_transport, do_sedi_w, de_ice, icloud_f, irain_f,   &
             341                             mp_print, reiflag, rewmin, rewmax, reimin, reimax, rermin, rermax,    &
             342                             resmin, resmax, regmin, regmax, tintqs, do_melt
             343                     
             344                     contains
             345                     
             346                     ! -----------------------------------------------------------------------
             347                     ! the driver of the gfdl cloud microphysics
             348                     ! -----------------------------------------------------------------------
             349                     
             350                     !>@brief The subroutine 'gfdl_cloud_microphys_driver' executes the full GFDL
             351                     !! cloud microphysics.
             352                     subroutine gfdl_cloud_microphys_driver                                    &
             353                                 ( qv, ql, qr, qi, qs, qg, qa, qn,                             &
             354                                   qv_dt, ql_dt, qr_dt, qi_dt, qs_dt, qg_dt, qa_dt,            &
             355                                   pt_dt, pt, w, uin, vin, udt, vdt,                           &
             356                                   dz, delp, area, dt_in, land,                                &
             357                                   rain, snow, ice, graupel,                                   &
             358                                   hydrostatic, phys_hydrostatic,                              &
             359                     !              iis, iie, jjs, jje, kks, kke, ktop, kbot, seconds,          &  !FV3 v16
             360                     !              p, lradar, refl_10cm, reset )
             361                                   iis, iie, jjs, jje, kks, kke, ktop, kbot )
             362                     
             363                         implicit none
             364                     
             365                         logical, intent (in) :: hydrostatic, phys_hydrostatic
             366                     !    logical, intent (in) :: lradar, reset  !FV3 v16
             367                         integer, intent (in) :: iis, iie, jjs, jje !< physics window
             368                         integer, intent (in) :: kks, kke !< vertical dimension
             369                         integer, intent (in) :: ktop, kbot !< vertical compute domain
             370                     !    integer, intent (in) :: seconds
             371                     
             372                         real, intent (in) :: dt_in !< physics time step
             373                     
             374                         real, intent (in), dimension (:, :) :: area !< cell area
             375                         real, intent (in), dimension (:, :) :: land !< land fraction
             376                     
             377                         real, intent (in), dimension (:, :, :) :: delp, dz, uin, vin
             378                     !    real, intent (in), dimension (:, :, :) :: p  !FV3 v16
             379                         real, intent (in), dimension (:, :, :) :: pt, qv, ql, qr, qg, qa, qn
             380                     
             381                         real, intent (inout), dimension (:, :, :) :: qi, qs
             382                         real, intent (inout), dimension (:, :, :) :: pt_dt, qa_dt, udt, vdt, w
             383                         real, intent (inout), dimension (:, :, :) :: qv_dt, ql_dt, qr_dt
             384                         real, intent (inout), dimension (:, :, :) :: qi_dt, qs_dt, qg_dt
             385                     
             386                     !    real, intent (out), dimension (:, :, :) :: refl_10cm  !FV3 v16
             387                         real, intent (out), dimension (:, :) :: rain, snow, ice, graupel
             388                     
             389                         logical :: melti = .false.
             390                         logical :: lradar = .false. , reset = .false. !FV3 v16
             391                         ! logical :: used
             392                     
             393                         real :: mpdt, rdt, dts, convt, tot_prec
             394                     
             395                         integer :: i, j, k
             396                         integer :: is, ie, js, je !< physics window
             397                         integer :: ks, ke !< vertical dimension
             398                         integer :: days, ntimes, kflip
             399                     
             400                         real, dimension (iie - iis + 1, jje - jjs + 1) :: prec_mp, prec1, cond, w_var, rh0
             401                     
             402                         real, dimension (iie - iis + 1, jje - jjs + 1, kke - kks + 1) :: vt_r, vt_s, vt_g, vt_i, qn2
             403                     
             404                         real, dimension (size (pt, 1), size (pt, 3)) :: m2_rain, m2_sol
             405                     
             406                         real :: allmax
             407                     !+---+-----------------------------------------------------------------+
             408                     !For 3D reflectivity calculations
             409                       REAL, DIMENSION(ktop:kbot):: qv1d, t1d, p1d, qr1d, qs1d, qg1d, dBZ
             410                     !+---+-----------------------------------------------------------------+
             411                     
             412                         is = 1
             413                         js = 1
             414                         ks = 1
             415                         ie = iie - iis + 1
             416                         je = jje - jjs + 1
             417                         ke = kke - kks + 1
             418                         ! call mpp_clock_begin (gfdl_mp_clock)
             419                     
             420                         ! -----------------------------------------------------------------------
             421                         ! define heat capacity of dry air and water vapor based on hydrostatical property
             422                         ! -----------------------------------------------------------------------
             423                     
             424     1                   if (phys_hydrostatic .or. hydrostatic) then
             425     1                       c_air = cp_air
             426     1                       c_vap = cp_vap
             427     1                       p_nonhydro = .false.
             428     1                   else
             429     1                       c_air = cv_air
             430     1                       c_vap = cv_vap
             431     1                       p_nonhydro = .true.
             432     1                   endif
             433                         d0_vap = c_vap - c_liq
             434                         lv00 = hlv0 - d0_vap * t_ice
             435                     
             436                         if (hydrostatic) do_sedi_w = .false.
             437                     
             438                         ! -----------------------------------------------------------------------
             439                         ! define latent heat coefficient used in wet bulb and bigg mechanism
             440                         ! -----------------------------------------------------------------------
             441                     
             442                         latv = hlv
             443                         lati = hlf
             444                         lats = latv + lati
             445                         lat2 = lats * lats
             446                     
             447                         lcp = latv / cp_air
             448                         icp = lati / cp_air
             449                         tcp = (latv + lati) / cp_air
             450                     
             451                         ! tendency zero out for am moist processes should be done outside the driver
             452                     
             453                         ! -----------------------------------------------------------------------
             454                         ! define cloud microphysics sub time step
             455                         ! -----------------------------------------------------------------------
             456                     
             457                         mpdt   = min (dt_in, mp_time)
             458                         rdt    = 1. / dt_in
             459                         ntimes = nint (dt_in / mpdt)
             460                     
             461                         ! small time step:
             462                         dts = dt_in / real (ntimes)
             463                     
             464                         ! call get_time (time, seconds, days)
             465                     
             466                         ! -----------------------------------------------------------------------
             467                         ! initialize precipitation
             468                         ! -----------------------------------------------------------------------
             469                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             470     1  pp               do j = js, je
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cond
                                   <<< Loop-information  End >>>
             471     2   p   2v              do i = is, ie
             472     2   p   2v                  graupel (i, j) = 0.
             473     2   p   2v                  rain (i, j) = 0.
             474     2   p   2v                  snow (i, j) = 0.
             475     2   p   2v                  ice (i, j) = 0.
             476     2   p   2v                  cond (i, j) = 0.
             477     2   p   2v              enddo
             478     1   p               enddo
             479                     
             480                         ! -----------------------------------------------------------------------
             481                         ! major cloud microphysics
             482                         ! -----------------------------------------------------------------------
             483                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 197
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             484     1                   do j = js, je
             485     1                       call mpdrv (hydrostatic, uin, vin, w, delp, pt, qv, ql, qr, qi, qs, qg,&
             486     1                           qa, qn, dz, is, ie, js, je, ks, ke, ktop, kbot, j, dt_in, ntimes,  &
             487     1                           rain (:, j), snow (:, j), graupel (:, j), ice (:, j), m2_rain,     &
             488     1                           m2_sol, cond (:, j), area (:, j), land (:, j), udt, vdt, pt_dt,    &
             489     1                           qv_dt, ql_dt, qr_dt, qi_dt, qs_dt, qg_dt, qa_dt, w_var, vt_r,      &
             490     1                           vt_s, vt_g, vt_i, qn2)
             491     1                   enddo
             492                     
             493                         ! -----------------------------------------------------------------------
             494                         ! no clouds allowed above ktop
             495                         ! -----------------------------------------------------------------------
             496                     
             497     1                   if (ks < ktop) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             498     2  pp                   do k = ks, ktop
             499     3   p                       if (do_qa) then
             500     4   p                           do j = js, je
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             501     5   p   4v                          do i = is, ie
             502     5   p   4v                              qa_dt (i, j, k) = 0.
             503     5   p   4v                          enddo
             504     4   p                           enddo
             505     3   p                       else
             506     4   p                           do j = js, je
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             507     5   p   4v                          do i = is, ie
             508     5                                       ! qa_dt (i, j, k) = - qa (i, j, k) * rdt
             509     5   p   4v                              qa_dt (i, j, k) = 0. ! gfs
             510     5   p   4v                          enddo
             511     4   p                           enddo
             512     3   p                       endif
             513     2   p                   enddo
             514     1                   endif
             515                     
             516                         ! -----------------------------------------------------------------------
             517                         ! diagnostic output
             518                         ! -----------------------------------------------------------------------
             519                     
             520                         ! if (id_vtr > 0) then
             521                         ! used = send_data (id_vtr, vt_r, time, is_in = iis, js_in = jjs)
             522                         ! endif
             523                     
             524                         ! if (id_vts > 0) then
             525                         ! used = send_data (id_vts, vt_s, time, is_in = iis, js_in = jjs)
             526                         ! endif
             527                     
             528                         ! if (id_vtg > 0) then
             529                         ! used = send_data (id_vtg, vt_g, time, is_in = iis, js_in = jjs)
             530                         ! endif
             531                     
             532                         ! if (id_vti > 0) then
             533                         ! used = send_data (id_vti, vt_i, time, is_in = iis, js_in = jjs)
             534                         ! endif
             535                     
             536                         ! if (id_droplets > 0) then
             537                         ! used = send_data (id_droplets, qn2, time, is_in = iis, js_in = jjs)
             538                         ! endif
             539                     
             540                         ! if (id_var > 0) then
             541                         ! used = send_data (id_var, w_var, time, is_in = iis, js_in = jjs)
             542                         ! endif
             543                     
             544                         !! convert to mm / day  (original)
             545                         ! convt = 86400. * rdt * rgrav
             546                     
             547                         !! convert to mm / s
             548                         ! convt = rdt * rgrav
             549                     
             550                         ! convert to mm
             551                          convt = rgrav
             552                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prec_mp
                                   <<< Loop-information  End >>>
             553     1  pp               do j = js, je
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.76, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prec_mp
                                   <<< Loop-information  End >>>
             554     2   p    v              do i = is, ie
             555     2   p    v                  rain (i, j) = rain (i, j) * convt
             556     2   p    v                  snow (i, j) = snow (i, j) * convt
             557     2   p    v                  ice (i, j) = ice (i, j) * convt
             558     2   p    v                  graupel (i, j) = graupel (i, j) * convt
             559     2   p    v                  prec_mp (i, j) = rain (i, j) + snow (i, j) + ice (i, j) + graupel (i, j)
             560     2   p    v              enddo
             561     1   p               enddo
             562                     
             563                         ! if (id_cond > 0) then
             564                         ! do j = js, je
             565                         ! do i = is, ie
             566                         ! cond (i, j) = cond (i, j) * rgrav
             567                         ! enddo
             568                         ! enddo
             569                         ! used = send_data (id_cond, cond, time, is_in = iis, js_in = jjs)
             570                         ! endif
             571                     
             572                         ! if (id_snow > 0) then
             573                         ! used = send_data (id_snow, snow, time, iis, jjs)
             574                         ! used = send_data (id_snow, snow, time, is_in = iis, js_in = jjs)
             575                         ! if (mp_print .and. seconds == 0) then
             576                         ! tot_prec = g_sum (snow, is, ie, js, je, area, 1)
             577                         ! if (master) write (*, *) 'mean snow = ', tot_prec
             578                         ! endif
             579                         ! endif
             580                         !
             581                         ! if (id_graupel > 0) then
             582                         ! used = send_data (id_graupel, graupel, time, iis, jjs)
             583                         ! used = send_data (id_graupel, graupel, time, is_in = iis, js_in = jjs)
             584                         ! if (mp_print .and. seconds == 0) then
             585                         ! tot_prec = g_sum (graupel, is, ie, js, je, area, 1)
             586                         ! if (master) write (*, *) 'mean graupel = ', tot_prec
             587                         ! endif
             588                         ! endif
             589                         !
             590                         ! if (id_ice > 0) then
             591                         ! used = send_data (id_ice, ice, time, iis, jjs)
             592                         ! used = send_data (id_ice, ice, time, is_in = iis, js_in = jjs)
             593                         ! if (mp_print .and. seconds == 0) then
             594                         ! tot_prec = g_sum (ice, is, ie, js, je, area, 1)
             595                         ! if (master) write (*, *) 'mean ice_mp = ', tot_prec
             596                         ! endif
             597                         ! endif
             598                         !
             599                         ! if (id_rain > 0) then
             600                         ! used = send_data (id_rain, rain, time, iis, jjs)
             601                         ! used = send_data (id_rain, rain, time, is_in = iis, js_in = jjs)
             602                         ! if (mp_print .and. seconds == 0) then
             603                         ! tot_prec = g_sum (rain, is, ie, js, je, area, 1)
             604                         ! if (master) write (*, *) 'mean rain = ', tot_prec
             605                         ! endif
             606                         ! endif
             607                         !
             608                         ! if (id_rh > 0) then !not used?
             609                         ! used = send_data (id_rh, rh0, time, iis, jjs)
             610                         ! used = send_data (id_rh, rh0, time, is_in = iis, js_in = jjs)
             611                         ! endif
             612                         !
             613                         !
             614                         ! if (id_prec > 0) then
             615                         ! used = send_data (id_prec, prec_mp, time, iis, jjs)
             616                         ! used = send_data (id_prec, prec_mp, time, is_in = iis, js_in = jjs)
             617                         ! endif
             618                     
             619                         ! if (mp_print) then
             620                         ! prec1 (:, :) = prec1 (:, :) + prec_mp (:, :)
             621                         ! if (seconds == 0) then
             622                         ! prec1 (:, :) = prec1 (:, :) * dt_in / 86400.
             623                         ! tot_prec = g_sum (prec1, is, ie, js, je, area, 1)
             624                         ! if (master) write (*, *) 'daily prec_mp = ', tot_prec
             625                         ! prec1 (:, :) = 0.
             626                         ! endif
             627                         ! endif
             628                     
             629                         ! call mpp_clock_end (gfdl_mp_clock)
             630                     
             631     1                   if ( lradar ) then
             632     1                      ! Only set melti to true at the output times
             633     2                      if ( reset ) then
             634     2                        melti = .true.
             635     2                      else
             636     2                        melti = .false.
             637     2                      endif
             638     1               !       do j = js, je
             639     1               !          do i = is, ie
             640     1               !             do k = ktop,kbot
             641     1               !               kflip = kbot - ktop + 1 - k + 1
             642     1               !               t1d(k)  = pt(i,j,kflip)
             643     1               !               p1d(k)  = p (i,j,kflip)
             644     1               !               qv1d(k) = qv(i,j,kflip)/(1.-qv(i,j,kflip))
             645     1               !               qr1d(k) = qr(i,j,kflip)
             646     1               !               qs1d(k) = qs(i,j,kflip)
             647     1               !               qg1d(k) = qg(i,j,kflip)
             648     1               !             enddo
             649     1               !             call refl10cm_gfdl (qv1d, qr1d, qs1d, qg1d,                 &
             650     1               !                       t1d, p1d, dBZ, ktop, kbot, i,j, melti)
             651     1               !             do k = ktop,kbot
             652     1               !                kflip = kbot - ktop + 1 - k + 1
             653     1               !                refl_10cm(i,j,kflip) = MAX(-35., dBZ(k))
             654     1               !             enddo
             655     1               !          enddo
             656     1               !       enddo
             657     1                   endif
             658                     
             659                     
             660                     end subroutine gfdl_cloud_microphys_driver
             661                     
             662                     ! -----------------------------------------------------------------------
             663                     !>@brief gfdl cloud microphysics, major program
             664                     !>@details lin et al., 1983, jam, 1065 - 1092, and
             665                     !! rutledge and hobbs, 1984, jas, 2949 - 2972
             666                     !! terminal fall is handled lagrangianly by conservative fv algorithm
             667                     !>@param pt: temperature (k)
             668                     !>@param 6 water species:
             669                     !>@param 1) qv: water vapor (kg / kg)
             670                     !>@param 2) ql: cloud water (kg / kg)
             671                     !>@param 3) qr: rain (kg / kg)
             672                     !>@param 4) qi: cloud ice (kg / kg)
             673                     !>@param 5) qs: snow (kg / kg)
             674                     !>@param 6) qg: graupel (kg / kg)
             675                     ! -----------------------------------------------------------------------
             676                     subroutine mpdrv (hydrostatic, uin, vin, w, delp, pt, qv, ql, qr, qi, qs,     &
             677                             qg, qa, qn, dz, is, ie, js, je, ks, ke, ktop, kbot, j, dt_in, ntimes, &
             678                             rain, snow, graupel, ice, m2_rain, m2_sol, cond, area1, land,         &
             679                             u_dt, v_dt, pt_dt, qv_dt, ql_dt, qr_dt, qi_dt, qs_dt, qg_dt, qa_dt,   &
             680                             w_var, vt_r, vt_s, vt_g, vt_i, qn2)
             681                     
             682                         implicit none
             683                     
             684                         logical, intent (in) :: hydrostatic
             685                     
             686                         integer, intent (in) :: j, is, ie, js, je, ks, ke
             687                         integer, intent (in) :: ntimes, ktop, kbot
             688                     
             689                         real, intent (in) :: dt_in
             690                     
             691                         real, intent (in), dimension (is:) :: area1, land
             692                     
             693                         real, intent (in), dimension (is:, js:, ks:) :: uin, vin, delp, pt, dz
             694                         real, intent (in), dimension (is:, js:, ks:) :: qv, ql, qr, qg, qa, qn
             695                     
             696                         real, intent (inout), dimension (is:, js:, ks:) :: qi, qs
             697                         real, intent (inout), dimension (is:, js:, ks:) :: u_dt, v_dt, w, pt_dt, qa_dt
             698                         real, intent (inout), dimension (is:, js:, ks:) :: qv_dt, ql_dt, qr_dt, qi_dt, qs_dt, qg_dt
             699                     
             700                         real, intent (inout), dimension (is:) :: rain, snow, ice, graupel, cond
             701                     
             702                         real, intent (out), dimension (is:, js:) :: w_var
             703                     
             704                         real, intent (out), dimension (is:, js:, ks:) :: vt_r, vt_s, vt_g, vt_i, qn2
             705                     
             706                         real, intent (out), dimension (is:, ks:) :: m2_rain, m2_sol
             707                     
             708                         real, dimension (ktop:kbot) :: qvz, qlz, qrz, qiz, qsz, qgz, qaz
             709                         real, dimension (ktop:kbot) :: vtiz, vtsz, vtgz, vtrz
             710                         real, dimension (ktop:kbot) :: dp0, dp1, dz0, dz1
             711                         real, dimension (ktop:kbot) :: qv0, ql0, qr0, qi0, qs0, qg0, qa0
             712                         real, dimension (ktop:kbot) :: t0, den, den0, tz, p1, denfac
             713                         real, dimension (ktop:kbot) :: ccn, c_praut, m1_rain, m1_sol, m1
             714                         real, dimension (ktop:kbot) :: u0, v0, u1, v1, w1
             715                     
             716                         real :: cpaut, rh_adj, rh_rain
             717                         real :: r1, s1, i1, g1, rdt, ccn0
             718                         real :: dt_rain, dts
             719                         real :: s_leng, t_land, t_ocean, h_var
             720                         real :: cvm, tmp, omq
             721                         real :: dqi, qio, qin
             722                     
             723                         integer :: i, k, n
             724                     
             725                         dts = dt_in / real (ntimes)
             726                         dt_rain = dts * 0.5
             727                         rdt = 1. / dt_in
             728                     
             729                         ! -----------------------------------------------------------------------
             730                         ! use local variables
             731                         ! -----------------------------------------------------------------------
             732                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qiz, qsz, ccn, c_praut, w1, dp0, m1, u1
                                   <<<      v1, u0, v0
                                   <<< Loop-information  End >>>
             733     1                   do i = is, ie
             734     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 128, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qsz, qiz

                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ql, qv, dp, qr, qi, qs, qg, dm
                                   <<< Loop-information  End >>>
            1206     3  pp    v                  do k = ktop, kbot
            1207     3   p    v                      dm (k) = dp (k) * (1. + qv (k) + ql (k) + qr (k) + qi (k) + qs (k) + qg (k))
            1208     3   p    v                  enddo
            1209     2                       endif
            1210     1               
            1211     1                       ! -----------------------------------------------------------------------
            1212     1                       ! mass flux induced by falling rain
            1213     1                       ! -----------------------------------------------------------------------
            1214     1               
            1215     2                       if (use_ppm) then
            1216     2                           zt (ktop) = ze (ktop)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]

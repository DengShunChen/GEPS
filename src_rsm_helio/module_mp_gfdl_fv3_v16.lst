                                   <<<      zt
                                   <<< Loop-information  End >>>
            1222     3   s   2s                  do k = ktop, kbot
            1223     3   s   2s                      if (zt (k + 1) >= zt (k)) zt (k + 1) = zt (k) - dz_min
            1224     3   s   2s                  enddo
            1225     2                           call lagrangian_fall_ppm (ktop, kbot, zs, ze, zt, dp, qr, r1, m1_rain, mono_prof)
            1226     2                       else
            1227     2                           call implicit_fall (dt, ktop, kbot, ze, vtr, dp, qr, r1, m1_rain)
            1228     2                       endif
            1229     1               
            1230     1                       ! -----------------------------------------------------------------------
            1231     1                       ! vertical velocity transportation during sedimentation
            1232     1                       ! -----------------------------------------------------------------------
            1233     1               
            1234     2                       if (do_sedi_w) then
            1235     2                           w1 (ktop) = (dm (ktop) * w1 (ktop) + m1_rain (ktop) * vtr (ktop)) / (dm (ktop) - m1_rain (ktop))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

            1236     3  pp    v                  do k = ktop + 1, kbot
            1237     3   p    v                      w1 (k) = (dm (k) * w1 (k) - m1_rain (k - 1) * vtr (k - 1) + m1_rain (k) * vtr (k)) &
            1238     3                                    / (dm (k) + m1_rain (k - 1) - m1_rain (k))
            1239     3   p    v                  enddo
            1240     2                       endif
            1241     1               

                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ze, vtr, zt
                                   <<< Loop-information  End >>>
            1217     3  pp   2v                  do k = ktop + 1, kbot
            1218     3   p   2v                      zt (k) = ze (k) - dt5 * (vtr (k - 1) + vtr (k))
            1219     3   p   2v                  enddo
            1220     2                           zt (kbot + 1) = zs - dt * vtr (kbot)
            1221     2               
                                   <<< Loop-information Start >>>

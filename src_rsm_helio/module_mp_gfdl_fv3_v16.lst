            1254     1               
            1255     1                   endif
            1256                     
            1257                         ! -----------------------------------------------------------------------
            1258                         ! auto - conversion
            1259                         ! assuming linear subgrid vertical distribution of cloud water
            1260                         ! following lin et al. 1994, mwr
            1261                         ! -----------------------------------------------------------------------
            1262                     
            1263     1                   if (irain_f /= 0) then
            1264     1               
            1265     1                       ! -----------------------------------------------------------------------
            1266     1                       ! no subgrid varaibility
            1267     1                       ! -----------------------------------------------------------------------
            1268     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

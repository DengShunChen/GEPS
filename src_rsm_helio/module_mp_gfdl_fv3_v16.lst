            3629                         deallocate (table2)
            3630                         deallocate (table3)
            3631                         deallocate (tablew)
            3632                         deallocate (des)
            3633                         deallocate (des2)
            3634                         deallocate (des3)
            3635                         deallocate (desw)
            3636                     

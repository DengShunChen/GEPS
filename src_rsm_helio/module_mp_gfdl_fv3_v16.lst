            2909                     
            2910                     subroutine lagrangian_fall_ppm (ktop, kbot, zs, ze, zt, dp, q, precip, m1, mono)
            2911                     
            2912                         implicit none
            2913                     
            2914                         integer, intent (in) :: ktop, kbot
            2915                     
            2916                         real, intent (in) :: zs
            2917                     
            2918                         logical, intent (in) :: mono
            2919                     
            2920                         real, intent (in), dimension (ktop:kbot + 1) :: ze, zt
            2921                     
            2922                         real, intent (in), dimension (ktop:kbot) :: dp
            2923                     
            2924                         ! m1: flux
            2925                         real, intent (inout), dimension (ktop:kbot) :: q, m1
            2926                     
            2927                         real, intent (out) :: precip
            2928                     
            2929                         real, dimension (ktop:kbot) :: qm, dz
            2930                     
            2931                         real :: a4 (4, ktop:kbot)
            2932                     
            2933                         real :: pl, pr, delz, esl
            2934                     
            2935                         integer :: k, k0, n, m
            2936                     
            2937                         real, parameter :: r3 = 1. / 3., r23 = 2. / 3.
            2938                     
            2939                         ! -----------------------------------------------------------------------
            2940                         ! density:
            2941                         ! -----------------------------------------------------------------------
            2942                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, q, zt, qm, a4, dz
                                   <<< Loop-information  End >>>
            2943     1  pp    v          do k = ktop, kbot
            2944     1   p    v              dz (k) = zt (k) - zt (k + 1) ! note: dz is positive
            2945     1   p    v              q (k) = q (k) * dp (k)
            2946     1   p    v              a4 (1, k) = q (k) / dz (k)
            2947     1   p    v              qm (k) = 0.
            2948     1   p    v          enddo
            2949                     
            2950                         ! -----------------------------------------------------------------------
            2951                         ! construct vertical profile with zt as coordinate
            2952                         ! -----------------------------------------------------------------------
            2953                     
            2954                         call cs_profile (a4 (1, ktop), dz (ktop), kbot - ktop + 1, mono)
            2955                     
            2956                         k0 = ktop
            2957     1                   do k = ktop, kbot
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            2958     2                       do n = k0, kbot
            2959     3                           if (ze (k) <= zt (n) .and. ze (k) >= zt (n + 1)) then
            2960     3                               pl = (zt (n) - ze (k)) / dz (n)
            2961     4                               if (zt (n + 1) <= ze (k + 1)) then
            2962     4                                   ! entire new grid is within the original grid
            2963     4                                   pr = (zt (n) - ze (k + 1)) / dz (n)
            2964     4                                   qm (k) = a4 (2, n) + 0.5 * (a4 (4, n) + a4 (3, n) - a4 (2, n)) * (pr + pl) - &
            2965     4                                       a4 (4, n) * r3 * (pr * (pr + pl) + pl ** 2)
            2966     4                                   qm (k) = qm (k) * (ze (k) - ze (k + 1))
            2967     4                                   k0 = n
            2968     4                                   goto 555
            2969     4                               else
            2970     4                                   qm (k) = (ze (k) - zt (n + 1)) * (a4 (2, n) + 0.5 * (a4 (4, n) + &
            2971     4                                       a4 (3, n) - a4 (2, n)) * (1. + pl) - a4 (4, n) * (r3 * (1. + pl * (1. + pl))))
            2972     5                                   if (n < kbot) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            2973     6                                       do m = n + 1, kbot
            2974     6                                           ! locate the bottom edge: ze (k + 1)
            2975     7                                           if (ze (k + 1) < zt (m + 1)) then
            2976     7                                               qm (k) = qm (k) + q (m)
            2977     7                                           else
            2978     7                                               delz = zt (m) - ze (k + 1)
            2979     7                                               esl = delz / dz (m)
            2980     7                                               qm (k) = qm (k) + delz * (a4 (2, m) + 0.5 * esl * &
            2981     7                                                    (a4 (3, m) - a4 (2, m) + a4 (4, m) * (1. - r23 * esl)))
            2982     7                                               k0 = m
            2983     7                                               goto 555
            2984     7                                           endif
            2985     6                                       enddo
            2986     5                                   endif
            2987     4                                   goto 555
            2988     4                               endif
            2989     3                           endif
            2990     2                       enddo
            2991     1                       555 continue
            2992     1                   enddo
            2993                     
            2994                         m1 (ktop) = q (ktop) - qm (ktop)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.83, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, qm, m1
                                   <<< Loop-information  End >>>
            2995     1   s   2s          do k = ktop + 1, kbot
            2996     1   m   2m              m1 (k) = m1 (k - 1) + q (k) - qm (k)
            2997     1   p   2v          enddo
            2998                         precip = m1 (kbot)
            2999                     
            3000                         ! convert back to * dry * mixing ratio:
            3001                         ! dp must be dry air_mass (because moist air mass will be changed due to terminal fall) .
            3002                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.31, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, qm, q
                                   <<< Loop-information  End >>>
            3003     1  pp   2v          do k = ktop, kbot
            3004     1   p   2v              q (k) = qm (k) / dp (k)
            3005     1   p   2v          enddo
            3006                     
            3007                     end subroutine lagrangian_fall_ppm
            3008                     
            3009                     subroutine cs_profile (a4, del, km, do_mono)
            3010                     
            3011                         implicit none
            3012                     
            3013                         integer, intent (in) :: km !< vertical dimension
            3014                     
            3015                         real, intent (in) :: del (km)
            3016                     
            3017                         logical, intent (in) :: do_mono
            3018                     
            3019                         real, intent (inout) :: a4 (4, km)
            3020                     
            3021                         real, parameter :: qp_min = 1.e-6
            3022                     
            3023                         real :: gam (km)
            3024                         real :: q (km + 1)
            3025                         real :: d4, bet, a_bot, grat, pmp, lac
            3026                         real :: pmp_1, lac_1, pmp_2, lac_2
            3027                         real :: da1, da2, a6da
            3028                     
            3029                         integer :: k
            3030                     
            3031                         logical extm (km)
            3032                     
            3033                         grat = del (2) / del (1) ! grid ratio
            3034                         bet = grat * (grat + 0.5)
            3035                         q (1) = (2. * grat * (grat + 1.) * a4 (1, 1) + a4 (1, 2)) / bet
            3036                         gam (1) = (1. + grat * (grat + 1.5)) / bet
            3037                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.27, ITR: 10, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, q, gam, del
                                   <<< Loop-information  End >>>
            3038     1   s   2s          do k = 2, km
            3039     1   p   2v              d4 = del (k - 1) / del (k)
            3040     1   m   2m              bet = 2. + 2. * d4 - gam (k - 1)
            3041     1   m   2m              q (k) = (3. * (a4 (1, k - 1) + d4 * a4 (1, k)) - q (k - 1)) / bet
            3042     1   s   2s              gam (k) = d4 / bet
            3043     1   p   2v          enddo
            3044                     
            3045                         a_bot = 1. + d4 * (d4 + 1.5)
            3046                         q (km + 1) = (2. * d4 * (d4 + 1.) * a4 (1, km) + a4 (1, km - 1) - a_bot * q (km)) &
            3047                              / (d4 * (d4 + 0.5) - a_bot * gam (km))
            3048                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.66, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gam, q
                                   <<< Loop-information  End >>>
            3049     1   s   2s          do k = km, 1, - 1
            3050     1   s   2s              q (k) = q (k) - gam (k) * q (k + 1)
            3051     1   s   2s          enddo
            3052                     
            3053                         ! -----------------------------------------------------------------------
            3054                         ! apply constraints
            3055                         ! -----------------------------------------------------------------------
            3056                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 160, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam
                                   <<< Loop-information  End >>>
            3057     1  pp   2v          do k = 2, km
            3058     1   p   2v              gam (k) = a4 (1, k) - a4 (1, k - 1)
            3059     1   p   2v          enddo
            3060                     
            3061                         ! -----------------------------------------------------------------------
            3062                         ! apply large - scale constraints to all fields if not local max / min
            3063                         ! -----------------------------------------------------------------------
            3064                     
            3065                         ! -----------------------------------------------------------------------
            3066                         ! top:
            3067                         ! -----------------------------------------------------------------------
            3068                     
            3069                         q (1) = max (q (1), 0.)
            3070                         q (2) = min (q (2), max (a4 (1, 1), a4 (1, 2)))
            3071                         q (2) = max (q (2), min (a4 (1, 1), a4 (1, 2)), 0.)
            3072                     
            3073                         ! -----------------------------------------------------------------------
            3074                         ! interior:
            3075                         ! -----------------------------------------------------------------------
            3076                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 127
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.62, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam, q
                                   <<< Loop-information  End >>>
            3077     1  pp    v          do k = 3, km - 1
            3078     2   p    v              if (gam (k - 1) * gam (k + 1) > 0.) then
            3079     2   p    v                  q (k) = min (q (k), max (a4 (1, k - 1), a4 (1, k)))
            3080     2   p    v                  q (k) = max (q (k), min (a4 (1, k - 1), a4 (1, k)))
            3081     2   p    v              else
            3082     3   p    v                  if (gam (k - 1) > 0.) then
            3083     3                               ! there exists a local max
            3084     3   p    v                      q (k) = max (q (k), min (a4 (1, k - 1), a4 (1, k)))
            3085     3   p    v                  else
            3086     3                               ! there exists a local min
            3087     3   p    v                      q (k) = min (q (k), max (a4 (1, k - 1), a4 (1, k)))
            3088     3   p    v                      q (k) = max (q (k), 0.0)
            3089     3   p    v                  endif
            3090     2   p    v              endif
            3091     1   p    v          enddo
            3092                     
            3093                         ! -----------------------------------------------------------------------
            3094                         ! bottom :
            3095                         ! -----------------------------------------------------------------------
            3096                     
            3097                         q (km) = min (q (km), max (a4 (1, km - 1), a4 (1, km)))
            3098                         q (km) = max (q (km), min (a4 (1, km - 1), a4 (1, km)), 0.)
            3099                         ! q (km + 1) = max (q (km + 1), 0.)
            3100                     
            3101                         ! -----------------------------------------------------------------------
            3102                         ! f (s) = al + s * [ (ar - al) + a6 * (1 - s) ] (0 <= s <= 1)
            3103                         ! -----------------------------------------------------------------------
            3104                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, a4
                                   <<< Loop-information  End >>>
            3105     1  pp   2v          do k = 1, km - 1
            3106     1   p   2v              a4 (2, k) = q (k)
            3107     1   p   2v              a4 (3, k) = q (k + 1)
            3108     1   p   2v          enddo
            3109                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gam, extm
                                   <<< Loop-information  End >>>
            3110     1  pp   2v          do k = 2, km - 1
            3111     2   p   2v              if (gam (k) * gam (k + 1) > 0.0) then
            3112     2   p   2v                  extm (k) = .false.
            3113     2   p   2v              else
            3114     2   p   2v                  extm (k) = .true.
            3115     2   p   2v              endif
            3116     1   p   2v          enddo
            3117                     
            3118     1                   if (do_mono) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 88
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.98, ITR: 32, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam, extm
                                   <<< Loop-information  End >>>
            3119     2  pp    v              do k = 3, km - 2
            3120     3   p    v                  if (extm (k)) then
            3121     3                               ! positive definite constraint only if true local extrema
            3122     4   p    v                      if (a4 (1, k) < qp_min .or. extm (k - 1) .or. extm (k + 1)) then
            3123     4   p    v                          a4 (2, k) = a4 (1, k)
            3124     4   p    v                          a4 (3, k) = a4 (1, k)
            3125     4   p    v                      endif
            3126     3   p    v                  else
            3127     3   p    v                      a4 (4, k) = 6. * a4 (1, k) - 3. * (a4 (2, k) + a4 (3, k))
            3128     4   p    v                      if (abs (a4 (4, k)) > abs (a4 (2, k) - a4 (3, k))) then
            3129     4                                   ! check within the smooth region if subgrid profile is non - monotonic
            3130     4   p    v                          pmp_1 = a4 (1, k) - 2.0 * gam (k + 1)
            3131     4   p    v                          lac_1 = pmp_1 + 1.5 * gam (k + 2)
            3132     4   p    v                          a4 (2, k) = min (max (a4 (2, k), min (a4 (1, k), pmp_1, lac_1)), &
            3133     4                                       max (a4 (1, k), pmp_1, lac_1))
            3134     4   p    v                          pmp_2 = a4 (1, k) + 2.0 * gam (k)
            3135     4   p    v                          lac_2 = pmp_2 - 1.5 * gam (k - 1)
            3136     4   p    v                          a4 (3, k) = min (max (a4 (3, k), min (a4 (1, k), pmp_2, lac_2)), &
            3137     4                                       max (a4 (1, k), pmp_2, lac_2))
            3138     4   p    v                      endif
            3139     3   p    v                  endif
            3140     2   p    v              enddo
            3141     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 500
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.34, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      extm, a4
                                   <<< Loop-information  End >>>
            3142     2  pp    v              do k = 3, km - 2
            3143     3   p    v                  if (extm (k)) then
            3144     4   p    v                      if (a4 (1, k) < qp_min .or. extm (k - 1) .or. extm (k + 1)) then
            3145     4   p    v                          a4 (2, k) = a4 (1, k)
            3146     4   p    v                          a4 (3, k) = a4 (1, k)
            3147     4   p    v                      endif
            3148     3   p    v                  endif
            3149     2   p    v              enddo
            3150     1                   endif
            3151                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 192, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4
                                   <<< Loop-information  End >>>
            3152     1  pp   2v          do k = 1, km - 1
            3153     1   p   2v              a4 (4, k) = 6. * a4 (1, k) - 3. * (a4 (2, k) + a4 (3, k))
            3154     1   p   2v          enddo
            3155                     
            3156                         k = km - 1
            3157     1                   if (extm (k)) then
            3158     1                       a4 (2, k) = a4 (1, k)
            3159     1                       a4 (3, k) = a4 (1, k)
            3160     1                       a4 (4, k) = 0.
            3161     1                   else
            3162     1                       da1 = a4 (3, k) - a4 (2, k)
            3163     1                       da2 = da1 ** 2
            3164     1                       a6da = a4 (4, k) * da1
            3165     2                       if (a6da < - da2) then
            3166     2                           a4 (4, k) = 3. * (a4 (2, k) - a4 (1, k))
            3167     2                           a4 (3, k) = a4 (2, k) - a4 (4, k)
            3168     2                       elseif (a6da > da2) then
            3169     2                           a4 (4, k) = 3. * (a4 (3, k) - a4 (1, k))
            3170     2                           a4 (2, k) = a4 (3, k) - a4 (4, k)
            3171     2                       endif
            3172     1                   endif
            3173                     
            3174                         call cs_limiters (km - 1, a4)
            3175                     
            3176                         ! -----------------------------------------------------------------------
            3177                         ! bottom layer:
            3178                         ! -----------------------------------------------------------------------
            3179                     
            3180                         a4 (2, km) = a4 (1, km)
            3181                         a4 (3, km) = a4 (1, km)
            3182                         a4 (4, km) = 0.
            3183                     
            3184                     end subroutine cs_profile
            3185                     
            3186                     subroutine cs_limiters (km, a4)
            3187                     
            3188                         implicit none
            3189                     
            3190                         integer, intent (in) :: km
            3191                     
            3192                         real, intent (inout) :: a4 (4, km) !< ppm array
            3193                     
            3194                         real, parameter :: r12 = 1. / 12.
            3195                     
            3196                         integer :: k
            3197                     
            3198                         ! -----------------------------------------------------------------------
            3199                         ! positive definite constraint
            3200                         ! -----------------------------------------------------------------------
            3201                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 259
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.59, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4
                                   <<< Loop-information  End >>>
            3202     1  pp    v          do k = 1, km
            3203     2   p    v              if (abs (a4 (3, k) - a4 (2, k)) < - a4 (4, k)) then
            3204     3   p    v                  if ((a4 (1, k) + 0.25 * (a4 (3, k) - a4 (2, k)) ** 2 / a4 (4, k) + a4 (4, k) * r12) < 0.) then
            3205     4   p    v                      if (a4 (1, k) < a4 (3, k) .and. a4 (1, k) < a4 (2, k)) then
            3206     4   p    v                          a4 (3, k) = a4 (1, k)
            3207     4   p    v                          a4 (2, k) = a4 (1, k)
            3208     4   p    v                          a4 (4, k) = 0.
            3209     4   p    v                      elseif (a4 (3, k) > a4 (2, k)) then
            3210     4   p    v                          a4 (4, k) = 3. * (a4 (2, k) - a4 (1, k))
            3211     4   p    v                          a4 (3, k) = a4 (2, k) - a4 (4, k)
            3212     4   p    v                      else
            3213     4   p    v                          a4 (4, k) = 3. * (a4 (3, k) - a4 (1, k))
            3214     4   p    v                          a4 (2, k) = a4 (3, k) - a4 (4, k)
            3215     4   p    v                      endif
            3216     3   p    v                  endif
            3217     2   p    v              endif
            3218     1   p    v          enddo
            3219                     
            3220                     end subroutine cs_limiters
            3221                     
            3222                     ! =======================================================================
            3223                     !>@brief The subroutine 'fall_speed' calculates vertical fall speed.
            3224                     ! =======================================================================
            3225                     
            3226                     subroutine fall_speed (ktop, kbot, den, qs, qi, qg, ql, tk, vts, vti, vtg)
            3227                     
            3228                         implicit none
            3229                     
            3230                         integer, intent (in) :: ktop, kbot
            3231                     
            3232                         real, intent (in), dimension (ktop:kbot) :: den, qs, qi, qg, ql, tk
            3233                         real, intent (out), dimension (ktop:kbot) :: vts, vti, vtg
            3234                     
            3235                         ! fall velocity constants:
            3236                     
            3237                         real, parameter :: thi = 1.0e-8 !< cloud ice threshold for terminal fall
            3238                         real, parameter :: thg = 1.0e-8
            3239                         real, parameter :: ths = 1.0e-8
            3240                     
            3241                         real, parameter :: aa = - 4.14122e-5
            3242                         real, parameter :: bb = - 0.00538922
            3243                         real, parameter :: cc = - 0.0516344
            3244                         real, parameter :: dd = 0.00216078
            3245                         real, parameter :: ee = 1.9714
            3246                     
            3247                         ! marshall - palmer constants
            3248                     
            3249                         real, parameter :: vcons = 6.6280504
            3250                         real, parameter :: vcong = 87.2382675
            3251                         real, parameter :: norms = 942477796.076938
            3252                         real, parameter :: normg = 5026548245.74367
            3253                     
            3254                         real, dimension (ktop:kbot) :: qden, tc, rhof
            3255                     
            3256                         real :: vi0
            3257                     
            3258                         integer :: k
            3259                     
            3260                         ! -----------------------------------------------------------------------
            3261                         ! marshall - palmer formula
            3262                         ! -----------------------------------------------------------------------
            3263                     
            3264                         ! -----------------------------------------------------------------------
            3265                         ! try the local air density -- for global model; the true value could be
            3266                         ! much smaller than sfcrho over high mountains
            3267                         ! -----------------------------------------------------------------------
            3268                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.17, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      den, rhof
                                   <<< Loop-information  End >>>
            3269     1  pp   2v          do k = ktop, kbot
            3270     1   p   2v              rhof (k) = sqrt (min (10., sfcrho / den (k)))
            3271     1   p   2v          enddo
            3272                     
            3273                         ! -----------------------------------------------------------------------
            3274                         ! ice:
            3275                         ! -----------------------------------------------------------------------
            3276                     
            3277     1                   if (const_vi) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vti
                                   <<< Loop-information  End >>>
            3278     1  pp   4v              vti (:) = vi_fac
            3279     1                   else
            3280     1                       ! -----------------------------------------------------------------------
            3281     1                       ! use deng and mace (2008, grl), which gives smaller fall speed than hd90 formula
            3282     1                       ! -----------------------------------------------------------------------
            3283     1                       vi0 = 0.01 * vi_fac
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qi, tk, den, tc, vti
                                   <<< Loop-information  End >>>
            3284     2  pp    v              do k = ktop, kbot
            3285     3   p    v                  if (qi (k) < thi) then ! this is needed as the fall - speed maybe problematic for small qi
            3286     3   p    v                      vti (k) = vf_min
            3287     3   p    v                  else
            3288     3   p    v                      tc (k) = tk (k) - tice
            3289     3   p    v                      vti (k) = (3. + log10 (qi (k) * den (k))) * (tc (k) * (aa * tc (k) + bb) + cc) + dd * tc (k) + ee
            3290     3   p    v                      vti (k) = vi0 * exp (log_10 * vti (k))
            3291     3   p    v                      vti (k) = min (vi_max, max (vf_min, vti (k)))
            3292     3   p    v                  endif
            3293     2   p    v              enddo
            3294     1                   endif
            3295                     
            3296                         ! -----------------------------------------------------------------------
            3297                         ! snow:
            3298                         ! -----------------------------------------------------------------------
            3299                     
            3300     1                   if (const_vs) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vts
                                   <<< Loop-information  End >>>
            3301     1  pp   4v              vts (:) = vs_fac ! 1. ifs_2016
            3302     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs, den, rhof, vts
                                   <<< Loop-information  End >>>
            3303     2  pp    v              do k = ktop, kbot
            3304     3   p    v                  if (qs (k) < ths) then
            3305     3   p    v                      vts (k) = vf_min
            3306     3   p    v                  else
            3307     3   p    v                      vts (k) = vs_fac * vcons * rhof (k) * exp (0.0625 * log (qs (k) * den (k) / norms))
            3308     3   p    v                      vts (k) = min (vs_max, max (vf_min, vts (k)))
            3309     3   p    v                  endif
            3310     2   p    v              enddo
            3311     1                   endif
            3312                     
            3313                         ! -----------------------------------------------------------------------
            3314                         ! graupel:
            3315                         ! -----------------------------------------------------------------------
            3316                     
            3317     1                   if (const_vg) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vtg
                                   <<< Loop-information  End >>>
            3318     1  pp   4v              vtg (:) = vg_fac ! 2.
            3319     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 320
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.21, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhof, qg, den, vtg
                                   <<< Loop-information  End >>>
            3320     2  pp    v              do k = ktop, kbot
            3321     3   p    v                  if (qg (k) < thg) then
            3322     3   p    v                      vtg (k) = vf_min
            3323     3   p    v                  else
            3324     3   p    v                      vtg (k) = vg_fac * vcong * rhof (k) * sqrt (sqrt (sqrt (qg (k) * den (k) / normg)))
            3325     3   p    v                      vtg (k) = min (vg_max, max (vf_min, vtg (k)))
            3326     3   p    v                  endif
            3327     2   p    v              enddo
            3328     1                   endif
            3329                     
            3330                     end subroutine fall_speed
            3331                     
            3332                     ! =======================================================================
            3333                     !>@brief The subroutine 'setup'm' sets up
            3334                     !! gfdl cloud microphysics parameters.
            3335                     ! =======================================================================
            3336                     
            3337                     subroutine setupm
            3338                     
            3339                         implicit none
            3340                     
            3341                         real :: gcon, cd, scm3, pisq, act (8)
            3342                         real :: vdifu, tcond
            3343                         real :: visk
            3344                         real :: ch2o, hltf
            3345                         real :: hlts, hltc, ri50
            3346                     
            3347                         real, parameter :: gam263 = 1.456943, gam275 = 1.608355, gam290 = 1.827363, &
            3348                             gam325 = 2.54925, gam350 = 3.323363, gam380 = 4.694155, &
            3349                             gam425 = 8.285063, gam450 = 11.631769, gam480 = 17.837789, &
            3350                             gam625 = 184.860962, gam680 = 496.604067
            3351                     
            3352                         ! intercept parameters
            3353                     
            3354                         real, parameter :: rnzr = 8.0e6 ! lin83
            3355                         real, parameter :: rnzs = 3.0e6 ! lin83
            3356                         real, parameter :: rnzg = 4.0e6 ! rh84
            3357                     
            3358                         ! density parameters
            3359                     
            3360                     !    real, parameter :: rhos = 0.1e3 !< lin83 (snow density; 1 / 10 of water)
            3361                     !    real, parameter :: rhog = 0.4e3 !< rh84 (graupel density)
            3362                         real, parameter :: acc (3) = (/ 5.0, 2.0, 0.5 /)
            3363                     
            3364                         real den_rc
            3365                     
            3366                         integer :: i, k
            3367                     
            3368                         pie = 4. * atan (1.0)
            3369                     
            3370                         ! s. klein's formular (eq 16) from am2
            3371                     
            3372                         fac_rc = (4. / 3.) * pie * rhor * rthresh ** 3
            3373                     
            3374     1                   if (prog_ccn) then
            3375     1                       ! if (master) write (*, *) 'prog_ccn option is .t.'
            3376     1                   else
            3377     1                       den_rc = fac_rc * ccn_o * 1.e6
            3378     1                       ! if (master) write (*, *) 'mp: for ccn_o = ', ccn_o, 'ql_rc = ', den_rc
            3379     1                       den_rc = fac_rc * ccn_l * 1.e6
            3380     1                       ! if (master) write (*, *) 'mp: for ccn_l = ', ccn_l, 'ql_rc = ', den_rc
            3381     1                   endif
            3382                     
            3383                         vdifu = 2.11e-5
            3384                         tcond = 2.36e-2
            3385                     
            3386                         visk = 1.259e-5
            3387                         hlts = 2.8336e6
            3388                         hltc = 2.5e6
            3389                         hltf = 3.336e5
            3390                     
            3391                         ch2o = 4.1855e3
            3392                         ri50 = 1.e-4
            3393                     
            3394                         pisq = pie * pie
            3395                         scm3 = (visk / vdifu) ** (1. / 3.)
            3396                     
            3397                         cracs = pisq * rnzr * rnzs * rhos
            3398                         csacr = pisq * rnzr * rnzs * rhor
            3399                         cgacr = pisq * rnzr * rnzg * rhor
            3400                         cgacs = pisq * rnzg * rnzs * rhos
            3401                         cgacs = cgacs * c_pgacs
            3402                     
            3403                         ! act: 1 - 2:racs (s - r) ; 3 - 4:sacr (r - s) ;
            3404                         ! 5 - 6:gacr (r - g) ; 7 - 8:gacs (s - g)
            3405                     
            3406                         act (1) = pie * rnzs * rhos
            3407                         act (2) = pie * rnzr * rhor
            3408                         act (6) = pie * rnzg * rhog
            3409                         act (3) = act (2)
            3410                         act (4) = act (1)
            3411                         act (5) = act (2)
            3412                         act (7) = act (1)
            3413                         act (8) = act (6)
            3414                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 4)
                                   <<< Loop-information  End >>>
            3415     1   s    v          do i = 1, 3
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3416     2   p   fv              do k = 1, 4
            3417     2   p   fv                  acco (i, k) = acc (i) / (act (2 * k - 1) ** ((7 - i) * 0.25) * act (2 * k) ** (i * 0.25))
            3418     2   p   fv              enddo
            3419     1   p    v          enddo
            3420                     
            3421                         gcon = 40.74 * sqrt (sfcrho) ! 44.628
            3422                     
            3423                         csacw = pie * rnzs * clin * gam325 / (4. * act (1) ** 0.8125)
            3424                         ! decreasing csacw to reduce cloud water --- > snow
            3425                     
            3426                         craci = pie * rnzr * alin * gam380 / (4. * act (2) ** 0.95)
            3427                         csaci = csacw * c_psaci
            3428                     
            3429                         cgacw = pie * rnzg * gam350 * gcon / (4. * act (6) ** 0.875)
            3430                         ! cgaci = cgacw * 0.1
            3431                     
            3432                         ! sjl, may 28, 2012
            3433                         cgaci = cgacw * 0.05
            3434                         ! sjl, may 28, 2012
            3435                     
            3436                         cracw = craci ! cracw = 3.27206196043822
            3437                         cracw = c_cracw * cracw
            3438                     
            3439                         ! subl and revp: five constants for three separate processes
            3440                     
            3441                         cssub (1) = 2. * pie * vdifu * tcond * rvgas * rnzs
            3442                         cgsub (1) = 2. * pie * vdifu * tcond * rvgas * rnzg
            3443                         crevp (1) = 2. * pie * vdifu * tcond * rvgas * rnzr
            3444                         cssub (2) = 0.78 / sqrt (act (1))
            3445                         cgsub (2) = 0.78 / sqrt (act (6))
            3446                         crevp (2) = 0.78 / sqrt (act (2))
            3447                         cssub (3) = 0.31 * scm3 * gam263 * sqrt (clin / visk) / act (1) ** 0.65625
            3448                         cgsub (3) = 0.31 * scm3 * gam275 * sqrt (gcon / visk) / act (6) ** 0.6875
            3449                         crevp (3) = 0.31 * scm3 * gam290 * sqrt (alin / visk) / act (2) ** 0.725
            3450                         cssub (4) = tcond * rvgas
            3451                         cssub (5) = hlts ** 2 * vdifu
            3452                         cgsub (4) = cssub (4)
            3453                         crevp (4) = cssub (4)
            3454                         cgsub (5) = cssub (5)
            3455                         crevp (5) = hltc ** 2 * vdifu
            3456                     
            3457                         cgfr (1) = 20.e2 * pisq * rnzr * rhor / act (2) ** 1.75
            3458                         cgfr (2) = 0.66
            3459                     
            3460                         ! smlt: five constants (lin et al. 1983)
            3461                     
            3462                         csmlt (1) = 2. * pie * tcond * rnzs / hltf
            3463                         csmlt (2) = 2. * pie * vdifu * rnzs * hltc / hltf
            3464                         csmlt (3) = cssub (2)
            3465                         csmlt (4) = cssub (3)
            3466                         csmlt (5) = ch2o / hltf
            3467                     
            3468                         ! gmlt: five constants
            3469                     
            3470                         cgmlt (1) = 2. * pie * tcond * rnzg / hltf
            3471                         cgmlt (2) = 2. * pie * vdifu * rnzg * hltc / hltf
            3472                         cgmlt (3) = cgsub (2)
            3473                         cgmlt (4) = cgsub (3)
            3474                         cgmlt (5) = ch2o / hltf
            3475                     
            3476                         es0 = 6.107799961e2 ! ~6.1 mb
            3477                         ces0 = eps * es0
            3478                     
            3479                     end subroutine setupm
            3480                     
            3481                     ! =======================================================================
            3482                     ! initialization of gfdl cloud microphysics
            3483                     !>@brief The subroutine 'gfdl_cloud_microphys_init' initializes the GFDL
            3484                     !! cloud microphysics.
            3485                     ! =======================================================================
            3486                     
            3487                     !subroutine gfdl_cloud_microphys_init (me, master, nlunit, input_nml_file, logunit, fn_nml)
            3488                     subroutine gfdl_cloud_microphys_init ()
            3489                     
            3490                         implicit none
            3491                     
            3492                     !    integer, intent (in) :: me
            3493                     !    integer, intent (in) :: master
            3494                     !    integer, intent (in) :: nlunit
            3495                     !    integer, intent (in) :: logunit
            3496                     
            3497                     !    character (len = 64), intent (in) :: fn_nml
            3498                     !    character (len = *),  intent (in) :: input_nml_file(:)
            3499                     
            3500                     !    integer :: ios
            3501                     !    logical :: exists
            3502                     
            3503                         ! integer, intent (in) :: id, jd, kd
            3504                         ! integer, intent (in) :: axes (4)
            3505                         ! type (time_type), intent (in) :: time
            3506                     
            3507                         ! integer :: unit, io, ierr, k, logunit
            3508                         ! logical :: flag
            3509                         ! real :: tmp, q1, q2
            3510                     
            3511                         ! master = (mpp_pe () .eq.mpp_root_pe ())
            3512                     
            3513                     !#ifdef INTERNAL_FILE_NML
            3514                     !    read (input_nml_file, nml = gfdl_cloud_microphysics_nml)
            3515                     !#else
            3516                     !    inquire (file = trim (fn_nml), exist = exists)
            3517                     !    if (.not. exists) then
            3518                     !        write (6, *) 'gfdl - mp :: namelist file: ', trim (fn_nml), ' does not exist'
            3519                     !        stop
            3520                     !    else
            3521                     !        open (unit = nlunit, file = fn_nml, readonly, status = 'old', iostat = ios)
            3522                     !    endif
            3523                     !    rewind (nlunit)
            3524                     !    read (nlunit, nml = gfdl_cloud_microphysics_nml)
            3525                     !    close (nlunit)
            3526                     !#endif
            3527                     
            3528                         ! write version number and namelist to log file
            3529                     !    if (me == master) then
            3530                     !        write (logunit, *) " ========================================================= "
            3531                     !        write (logunit, *) "gfdl_cloud_microphys_mod"
            3532                     !!        write (logunit, nml = gfdl_cloud_microphysics_nml)
            3533                     !    endif
            3534                     
            3535     1                   if (do_setup) then
            3536     1    i                  call setup_con
            3537     1                       call setupm
            3538     1                       do_setup = .false.
            3539     1                   endif
            3540                     
            3541                         log_10 = log (10.)
            3542                     
            3543                         tice0 = tice - 0.01
            3544                         t_wfr = tice - 40.0 ! supercooled water can exist down to - 48 c, which is the "absolute"
            3545                     
            3546                         ! if (master) write (logunit, nml = gfdl_cloud_microphys_nml)
            3547                         !
            3548                         ! id_vtr = register_diag_field (mod_name, 'vt_r', axes (1:3), time, &
            3549                         ! 'rain fall speed', 'm / s', missing_value = missing_value)
            3550                         ! id_vts = register_diag_field (mod_name, 'vt_s', axes (1:3), time, &
            3551                         ! 'snow fall speed', 'm / s', missing_value = missing_value)
            3552                         ! id_vtg = register_diag_field (mod_name, 'vt_g', axes (1:3), time, &
            3553                         ! 'graupel fall speed', 'm / s', missing_value = missing_value)
            3554                         ! id_vti = register_diag_field (mod_name, 'vt_i', axes (1:3), time, &
            3555                         ! 'ice fall speed', 'm / s', missing_value = missing_value)
            3556                     
            3557                         ! id_droplets = register_diag_field (mod_name, 'droplets', axes (1:3), time, &
            3558                         ! 'droplet number concentration', '# / m3', missing_value = missing_value)
            3559                         ! id_rh = register_diag_field (mod_name, 'rh_lin', axes (1:2), time, &
            3560                         ! 'relative humidity', 'n / a', missing_value = missing_value)
            3561                     
            3562                         ! id_rain = register_diag_field (mod_name, 'rain_lin', axes (1:2), time, &
            3563                         ! 'rain_lin', 'mm / day', missing_value = missing_value)
            3564                         ! id_snow = register_diag_field (mod_name, 'snow_lin', axes (1:2), time, &
            3565                         ! 'snow_lin', 'mm / day', missing_value = missing_value)
            3566                         ! id_graupel = register_diag_field (mod_name, 'graupel_lin', axes (1:2), time, &
            3567                         ! 'graupel_lin', 'mm / day', missing_value = missing_value)
            3568                         ! id_ice = register_diag_field (mod_name, 'ice_lin', axes (1:2), time, &
            3569                         ! 'ice_lin', 'mm / day', missing_value = missing_value)
            3570                         ! id_prec = register_diag_field (mod_name, 'prec_lin', axes (1:2), time, &
            3571                         ! 'prec_lin', 'mm / day', missing_value = missing_value)
            3572                     
            3573                         ! if (master) write (*, *) 'prec_lin diagnostics initialized.', id_prec
            3574                     
            3575                         ! id_cond = register_diag_field (mod_name, 'cond_lin', axes (1:2), time, &
            3576                         ! 'total condensate', 'kg / m ** 2', missing_value = missing_value)
            3577                         ! id_var = register_diag_field (mod_name, 'var_lin', axes (1:2), time, &
            3578                         ! 'subgrid variance', 'n / a', missing_value = missing_value)
            3579                     
            3580                         ! call qsmith_init
            3581                     
            3582                         ! testing the water vapor tables
            3583                     
            3584                         ! if (mp_debug .and. master) then
            3585                         ! write (*, *) 'testing water vapor tables in gfdl_cloud_microphys'
            3586                         ! tmp = tice - 90.
            3587                         ! do k = 1, 25
            3588                         ! q1 = wqsat_moist (tmp, 0., 1.e5)
            3589                         ! q2 = qs1d_m (tmp, 0., 1.e5)
            3590                         ! write (*, *) nint (tmp - tice), q1, q2, 'dq = ', q1 - q2
            3591                         ! tmp = tmp + 5.
            3592                         ! enddo
            3593                         ! endif
            3594                     
            3595                         ! if (master) write (*, *) 'gfdl_cloud_micrphys diagnostics initialized.'
            3596                     
            3597                         module_is_initialized = .true.
            3598                     
            3599                     !+---+-----------------------------------------------------------------+
            3600                     !..Set these variables needed for computing radar reflectivity.  These
            3601                     !.. get used within radar_init to create other variables used in the
            3602                     !.. radar module.
            3603                     
            3604                        xam_r = pi*rhor/6.
            3605                        xbm_r = 3.
            3606                        xmu_r = 0.
            3607                        xam_s = pi*rhos/6.
            3608                        xbm_s = 3.
            3609                        xmu_s = 0.
            3610                        xam_g = pi*rhog/6.
            3611                        xbm_g = 3.
            3612                        xmu_g = 0.
            3613                     
            3614                        call radar_init
            3615                     
            3616                     end subroutine gfdl_cloud_microphys_init
            3617                     
            3618                     ! =======================================================================
            3619                     ! end of gfdl cloud microphysics
            3620                     !>@brief The subroutine 'gfdl_cloud_microphys_init' terminates the GFDL

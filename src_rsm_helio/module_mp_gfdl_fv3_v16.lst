            1711     3                               ! -----------------------------------------------------------------------
            1712     3               
            1713     3   p    v                      if (qr > qrmin) &
            1714     3                                   pgacr = min (acr3d (vtg (k), vtr (k), qr, qg, cgacr, acco (1, 3), &
            1715     3                                       den (k)), rdts * qr)
            1716     3               
            1717     3                               ! -----------------------------------------------------------------------
            1718     3                               ! pgacw: accretion of cloud water by graupel

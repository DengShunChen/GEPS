            2854                         real, intent (out), dimension (ktop:kbot) :: m1
            2855                     
            2856                         real, intent (out) :: precip
            2857                     
            2858                         real, dimension (ktop:kbot) :: dz, qm, dd
            2859                     
            2860                         integer :: k
            2861                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.16, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, dp, vt, ze, dd, dz
                                   <<< Loop-information  End >>>
            2862     1  pp    v          do k = ktop, kbot
            2863     1   p    v              dz (k) = ze (k) - ze (k + 1)
            2864     1   p    v              dd (k) = dt * vt (k)
            2865     1   p    v              q (k) = q (k) * dp (k)
            2866     1   p    v          enddo
            2867                     
            2868                         ! -----------------------------------------------------------------------
            2869                         ! sedimentation: non - vectorizable loop
            2870                         ! -----------------------------------------------------------------------
            2871                     
            2872                         qm (ktop) = q (ktop) / (dz (ktop) + dd (ktop))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.19, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qm, dz, dd, q
                                   <<< Loop-information  End >>>
            2873     1   s   2s          do k = ktop + 1, kbot
            2874     1   m   2m              qm (k) = (q (k) + dd (k - 1) * qm (k - 1)) / (dz (k) + dd (k))
            2875     1   p   2v          enddo
            2876                     
            2877                         ! -----------------------------------------------------------------------
            2878                         ! qm is density at this stage
            2879                         ! -----------------------------------------------------------------------
            2880                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 192, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, qm
                                   <<< Loop-information  End >>>
            2881     1  pp   2v          do k = ktop, kbot
            2882     1   p   2v              qm (k) = qm (k) * dz (k)
            2883     1   p   2v          enddo
            2884                     
            2885                         ! -----------------------------------------------------------------------
            2886                         ! output mass fluxes: non - vectorizable loop
            2887                         ! -----------------------------------------------------------------------
            2888                     
            2889                         m1 (ktop) = q (ktop) - qm (ktop)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.83, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, qm, m1
                                   <<< Loop-information  End >>>
            2890     1   s   2s          do k = ktop + 1, kbot
            2891     1   m   2m              m1 (k) = m1 (k - 1) + q (k) - qm (k)
            2892     1   p   2v          enddo
            2893                         precip = m1 (kbot)
            2894                     
            2895                         ! -----------------------------------------------------------------------
            2896                         ! update:
            2897                         ! -----------------------------------------------------------------------
            2898                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.31, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, qm, q
                                   <<< Loop-information  End >>>
            2899     1  pp   2v          do k = ktop, kbot
            2900     1   p   2v              q (k) = qm (k) / dp (k)
            2901     1   p   2v          enddo
            2902                     
            2903                     end subroutine implicit_fall
            2904                     
            2905                     ! =======================================================================
            2906                     !> lagrangian scheme
            2907                     !  developed by sj lin, ????

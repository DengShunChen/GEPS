            1724     4   p    v                          pgacw = factor / (1. + dts * factor) * ql ! rate
            1725     4   p    v                      endif
            1726     3               
            1727     3                               ! -----------------------------------------------------------------------
            1728     3                               ! pgmlt: graupel melt
            1729     3                               ! -----------------------------------------------------------------------
            1730     3               
            1731     3   pi   v                      pgmlt = dts * gmlt (tc, dqs0, qden, pgacw, pgacr, cgmlt, den (k))
            1732     3   p    v                      pgmlt = min (max (0., pgmlt), qg, tc / icpk (k))
            1733     3   p    v                      qg = qg - pgmlt
            1734     3   p    v                      qr = qr + pgmlt
            1735     3   p    v                      q_liq (k) = q_liq (k) + pgmlt
            1736     3   p    v                      q_sol (k) = q_sol (k) - pgmlt
            1737     3   p    v                      cvm (k) = c_air + qv * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1738     3   p    v                      tz = tz - pgmlt * lhi (k) / cvm (k)
            1739     3               
            1740     3   p    v                  endif
            1741     2               
            1742     2   p    v              else
            1743     2               
            1744     2                           ! -----------------------------------------------------------------------
            1745     2                           ! cloud ice proc:
            1746     2                           ! -----------------------------------------------------------------------
            1747     2               
            1748     2                           ! -----------------------------------------------------------------------
            1749     2                           ! psaci: accretion of cloud ice by snow
            1750     2                           ! -----------------------------------------------------------------------
            1751     2               
            1752     3   p    v                  if (qi > 3.e-7) then ! cloud ice sink terms
            1753     3               
            1754     4   p    v                      if (qs > 1.e-7) then
            1755     4                                   ! -----------------------------------------------------------------------
            1756     4                                   ! sjl added (following lin eq. 23) the temperature dependency
            1757     4                                   ! to reduce accretion, use esi = exp (0.05 * tc) as in hong et al 2004
            1758     4                                   ! -----------------------------------------------------------------------
            1759     4   p    v                          factor = dts * denfac (k) * csaci * exp (0.05 * tc + 0.8125 * log (qs * den (k)))
            1760     4   p    v                          psaci = factor / (1. + factor) * qi
            1761     4   p    v                      else
            1762     4   p    v                          psaci = 0.
            1763     4   p    v                      endif
            1764     3               
            1765     3                               ! -----------------------------------------------------------------------
            1766     3                               ! pasut: autoconversion: cloud ice -- > snow
            1767     3                               ! -----------------------------------------------------------------------
            1768     3               
            1769     3                               ! -----------------------------------------------------------------------
            1770     3                               ! similar to lfo 1983: eq. 21 solved implicitly
            1771     3                               ! threshold from wsm6 scheme, hong et al 2004, eq (13) : qi0_crt ~0.8e-4
            1772     3                               ! -----------------------------------------------------------------------
            1773     3               
            1774     3   p    v                      qim = qi0_crt / den (k)
            1775     3               
            1776     3                               ! -----------------------------------------------------------------------
            1777     3                               ! assuming linear subgrid vertical distribution of cloud ice
            1778     3                               ! the mismatch computation following lin et al. 1994, mwr
            1779     3                               ! -----------------------------------------------------------------------
            1780     3               
            1781     4   p    v                      if (const_vi) then
            1782     4   p    v                          tmp = fac_i2s
            1783     4   p    v                      else
            1784     4   p    v                          tmp = fac_i2s * exp (0.025 * tc)
            1785     4   p    v                      endif
            1786     3               
            1787     3   p    v                      di (k) = max (di (k), qrmin)
            1788     3   p    v                      q_plus = qi + di (k)
            1789     4   p    v                      if (q_plus > (qim + qrmin)) then
            1790     5   p    v                          if (qim > (qi - di (k))) then
            1791     5   p    v                              dq = (0.25 * (q_plus - qim) ** 2) / di (k)
            1792     5   p    v                          else
            1793     5   p    v                              dq = qi - qim
            1794     5   p    v                          endif
            1795     4   p    v                          psaut = tmp * dq
            1796     4   p    v                      else
            1797     4   p    v                          psaut = 0.
            1798     4   p    v                      endif
            1799     3                               ! -----------------------------------------------------------------------
            1800     3                               ! sink is no greater than 75% of qi
            1801     3                               ! -----------------------------------------------------------------------
            1802     3   p    v                      sink = min (0.75 * qi, psaci + psaut)
            1803     3   p    v                      qi = qi - sink
            1804     3   p    v                      qs = qs + sink
            1805     3               
            1806     3                               ! -----------------------------------------------------------------------
            1807     3                               ! pgaci: accretion of cloud ice by graupel
            1808     3                               ! -----------------------------------------------------------------------
            1809     3               
            1810     4   p    v                      if (qg > 1.e-6) then
            1811     4                                   ! -----------------------------------------------------------------------
            1812     4                                   ! factor = dts * cgaci / sqrt (den (k)) * exp (0.05 * tc + 0.875 * log (qg * den (k)))
            1813     4                                   ! simplified form: remove temp dependency & set the exponent "0.875" -- > 1
            1814     4                                   ! -----------------------------------------------------------------------
            1815     4   p    v                          factor = dts * cgaci * sqrt (den (k)) * qg
            1816     4   p    v                          pgaci = factor / (1. + factor) * qi
            1817     4   p    v                          qi = qi - pgaci
            1818     4   p    v                          qg = qg + pgaci
            1819     4   p    v                      endif
            1820     3               
            1821     3   p    v                  endif
            1822     2               
            1823     2                           ! -----------------------------------------------------------------------
            1824     2                           ! cold - rain proc:
            1825     2                           ! -----------------------------------------------------------------------
            1826     2               
            1827     2                           ! -----------------------------------------------------------------------
            1828     2                           ! rain to ice, snow, graupel processes:
            1829     2                           ! -----------------------------------------------------------------------
            1830     2               
            1831     2   p    v                  tc = tz - tice
            1832     2               
            1833     3   p    v                  if (qr > 1.e-7 .and. tc < 0.) then
            1834     3               
            1835     3                               ! -----------------------------------------------------------------------
            1836     3                               ! * sink * terms to qr: psacr + pgfr
            1837     3                               ! source terms to qs: psacr
            1838     3                               ! source terms to qg: pgfr
            1839     3                               ! -----------------------------------------------------------------------
            1840     3               
            1841     3                               ! -----------------------------------------------------------------------
            1842     3                               ! psacr accretion of rain by snow
            1843     3                               ! -----------------------------------------------------------------------
            1844     3               
            1845     4   p    v                      if (qs > 1.e-7) then ! if snow exists
            1846     4   pi   v                          psacr = dts * acr3d (vts (k), vtr (k), qr, qs, csacr, acco (1, 2), den (k))
            1847     4   p    v                      else
            1848     4   p    v                          psacr = 0.
            1849     4   p    v                      endif
            1850     3               
            1851     3                               ! -----------------------------------------------------------------------
            1852     3                               ! pgfr: rain freezing -- > graupel
            1853     3                               ! -----------------------------------------------------------------------
            1854     3               
            1855     3   p    v                      pgfr = dts * cgfr (1) / den (k) * (exp (- cgfr (2) * tc) - 1.) * &
            1856     3                                   exp (1.75 * log (qr * den (k)))
            1857     3               
            1858     3                               ! -----------------------------------------------------------------------
            1859     3                               ! total sink to qr
            1860     3                               ! -----------------------------------------------------------------------
            1861     3               
            1862     3   p    v                      sink = psacr + pgfr
            1863     3   p    v                      factor = min (sink, qr, - tc / icpk (k)) / max (sink, qrmin)
            1864     3               
            1865     3   p    v                      psacr = factor * psacr
            1866     3   p    v                      pgfr = factor * pgfr
            1867     3               
            1868     3   p    v                      sink = psacr + pgfr
            1869     3   p    v                      qr = qr - sink
            1870     3   p    v                      qs = qs + psacr
            1871     3   p    v                      qg = qg + pgfr
            1872     3   p    v                      q_liq (k) = q_liq (k) - sink
            1873     3   p    v                      q_sol (k) = q_sol (k) + sink
            1874     3   p    v                      cvm (k) = c_air + qv * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1875     3   p    v                      tz = tz + sink * lhi (k) / cvm (k)
            1876     3               
            1877     3   p    v                  endif
            1878     2               
            1879     2                           ! -----------------------------------------------------------------------
            1880     2                           ! update capacity heat and latend heat coefficient
            1881     2                           ! -----------------------------------------------------------------------
            1882     2               
            1883     2   p    v                  lhi (k) = li00 + dc_ice * tz
            1884     2   p    v                  icpk (k) = lhi (k) / cvm (k)
            1885     2               
            1886     2                           ! -----------------------------------------------------------------------
            1887     2                           ! graupel production terms:
            1888     2                           ! -----------------------------------------------------------------------
            1889     2               
            1890     3   p    v                  if (qs > 1.e-7) then
            1891     3               
            1892     3                               ! -----------------------------------------------------------------------
            1893     3                               ! accretion: snow -- > graupel
            1894     3                               ! -----------------------------------------------------------------------
            1895     3               
            1896     4   p    v                      if (qg > qrmin) then
            1897     4   pi   v                          sink = dts * acr3d (vtg (k), vts (k), qs, qg, cgacs, acco (1, 4), den (k))
            1898     4   p    v                      else
            1899     4   p    v                          sink = 0.
            1900     4   p    v                      endif
            1901     3               
            1902     3                               ! -----------------------------------------------------------------------
            1903     3                               ! autoconversion snow -- > graupel
            1904     3                               ! -----------------------------------------------------------------------
            1905     3               
            1906     3   p    v                      qsm = qs0_crt / den (k)
            1907     4   p    v                      if (qs > qsm) then
            1908     4   p    v                          factor = dts * 1.e-3 * exp (0.09 * (tz - tice))
            1909     4   p    v                          sink = sink + factor / (1. + factor) * (qs - qsm)
            1910     4   p    v                      endif
            1911     3   p    v                      sink = min (qs, sink)
            1912     3   p    v                      qs = qs - sink
            1913     3   p    v                      qg = qg + sink
            1914     3               
            1915     3   p    v                  endif ! snow existed
            1916     2               
            1917     3   p    v                  if (qg > 1.e-7 .and. tz < tice0) then
            1918     3               
            1919     3                               ! -----------------------------------------------------------------------
            1920     3                               ! pgacw: accretion of cloud water by graupel
            1921     3                               ! -----------------------------------------------------------------------
            1922     3               
            1923     4   p    v                      if (ql > 1.e-6) then
            1924     4   p    v                          qden = qg * den (k)
            1925     4   p    v                          factor = dts * cgacw * qden / sqrt (den (k) * sqrt (sqrt (qden)))
            1926     4   p    v                          pgacw = factor / (1. + factor) * ql
            1927     4   p    v                      else
            1928     4   p    v                          pgacw = 0.
            1929     4   p    v                      endif
            1930     3               
            1931     3                               ! -----------------------------------------------------------------------
            1932     3                               ! pgacr: accretion of rain by graupel
            1933     3                               ! -----------------------------------------------------------------------
            1934     3               
            1935     4   p    v                      if (qr > 1.e-6) then
            1936     4   pi   v                          pgacr = min (dts * acr3d (vtg (k), vtr (k), qr, qg, cgacr, acco (1, 3), &
            1937     4                                       den (k)), qr)
            1938     4   p    v                      else
            1939     4   p    v                          pgacr = 0.
            1940     4   p    v                      endif
            1941     3               
            1942     3   p    v                      sink = pgacr + pgacw
            1943     3   p    v                      factor = min (sink, dim (tice, tz) / icpk (k)) / max (sink, qrmin)
            1944     3   p    v                      pgacr = factor * pgacr
            1945     3   p    v                      pgacw = factor * pgacw
            1946     3               
            1947     3   p    v                      sink = pgacr + pgacw
            1948     3   p    v                      qg = qg + sink
            1949     3   p    v                      qr = qr - pgacr
            1950     3   p    v                      ql = ql - pgacw
            1951     3   p    v                      q_liq (k) = q_liq (k) - sink
            1952     3   p    v                      q_sol (k) = q_sol (k) + sink
            1953     3   p    v                      cvm (k) = c_air + qv * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1954     3   p    v                      tz = tz + sink * lhi (k) / cvm (k)
            1955     3               
            1956     3   p    v                  endif
            1957     2               
            1958     2   p    v              endif
            1959     1               
            1960     1   p    v              tzk (k) = tz
            1961     1   p    v              qvk (k) = qv
            1962     1   p    v              qlk (k) = ql
            1963     1   p    v              qik (k) = qi
            1964     1   p    v              qrk (k) = qr
            1965     1   p    v              qsk (k) = qs
            1966     1   p    v              qgk (k) = qg
            1967     1               
            1968     1   p    v          enddo
            1969                     
            1970                         ! -----------------------------------------------------------------------
            1971                         ! subgrid cloud microphysics
            1972                         ! -----------------------------------------------------------------------
            1973                     
            1974                         call subgrid_z_proc (ktop, kbot, p1, den, denfac, dts, rh_adj, tzk, qvk, &
            1975                             qlk, qrk, qik, qsk, qgk, qak, h_var, rh_rain)
            1976                     
            1977                     end subroutine icloud
            1978                     
            1979                     ! =======================================================================
            1980                     !>temperature sentive high vertical resolution processes
            1981                     ! =======================================================================
            1982                     
            1983                     subroutine subgrid_z_proc (ktop, kbot, p1, den, denfac, dts, rh_adj, tz, qv, &
            1984                         ql, qr, qi, qs, qg, qa, h_var, rh_rain)
            1985                     
            1986                         implicit none
            1987                     
            1988                         integer, intent (in) :: ktop, kbot
            1989                     
            1990                         real, intent (in), dimension (ktop:kbot) :: p1, den, denfac
            1991                     
            1992                         real, intent (in) :: dts, rh_adj, h_var, rh_rain
            1993                     
            1994                         real, intent (inout), dimension (ktop:kbot) :: tz, qv, ql, qr, qi, qs, qg, qa
            1995                     
            1996                         real, dimension (ktop:kbot) :: lcpk, icpk, tcpk, tcp3, lhl, lhi
            1997                         real, dimension (ktop:kbot) :: cvm, q_liq, q_sol, q_cond
            1998                     
            1999                         real :: fac_v2l, fac_l2v
            2000                     
            2001                         real :: pidep, qi_crt
            2002                     
            2003                         ! -----------------------------------------------------------------------
            2004                         ! qstar over water may be accurate only down to - 80 deg c with ~10% uncertainty
            2005                         ! must not be too large to allow psc
            2006                         ! -----------------------------------------------------------------------
            2007                     
            2008                         real :: rh, rqi, tin, qsw, qsi, qpz, qstar
            2009                         real :: dqsdt, dwsdt, dq, dq0, factor, tmp
            2010                         real :: q_plus, q_minus, dt_evap, dt_pisub
            2011                         real :: evap, sink, tc, pisub, q_adj, dtmp
            2012                         real :: pssub, pgsub, tsq, qden, fac_g2v, fac_v2g
            2013                     
            2014                         integer :: k
            2015                     
            2016     1                   if (fast_sat_adj) then
            2017     1                       dt_evap = 0.5 * dts
            2018     1                   else
            2019     1                       dt_evap = dts
            2020     1                   endif
            2021                     
            2022                         ! -----------------------------------------------------------------------
            2023                         ! define conversion scalar / factor
            2024                         ! -----------------------------------------------------------------------
            2025                     
            2026                         fac_v2l = 1. - exp (- dt_evap / tau_v2l)
            2027                         fac_l2v = 1. - exp (- dt_evap / tau_l2v)
            2028                     
            2029                         fac_g2v = 1. - exp (- dts / tau_g2v)
            2030                         fac_v2g = 1. - exp (- dts / tau_v2g)
            2031                     
            2032                         ! -----------------------------------------------------------------------
            2033                         ! define heat capacity and latend heat coefficient
            2034                         ! -----------------------------------------------------------------------
            2035                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 171
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.81, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs, qi, qr, ql, qv, q_sol, cvm, q_liq
                                   <<<      qg, tz, icpk, lhi, tcp3, tcpk, lcpk, lhl
                                   <<< Loop-information  End >>>
            2036     1  pp    v          do k = ktop, kbot
            2037     1   p    v              lhl (k) = lv00 + d0_vap * tz (k)
            2038     1   p    v              lhi (k) = li00 + dc_ice * tz (k)
            2039     1   p    v              q_liq (k) = ql (k) + qr (k)
            2040     1   p    v              q_sol (k) = qi (k) + qs (k) + qg (k)
            2041     1   p    v              cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2042     1   p    v              lcpk (k) = lhl (k) / cvm (k)
            2043     1   p    v              icpk (k) = lhi (k) / cvm (k)
            2044     1   p    v              tcpk (k) = lcpk (k) + icpk (k)
            2045     1   p    v              tcp3 (k) = lcpk (k) + icpk (k) * min (1., dim (tice, tz (k)) / (tice - t_wfr))
            2046     1   p    v          enddo
            2047                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      p1
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 8
                                   <<<      SIMD&FP   : SPILL 7  FILL 17
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2048     1                   do k = ktop, kbot
            2049     1               
            2050     1                       if (p1 (k) < p_min) cycle
            2051     1               
            2052     1                       ! -----------------------------------------------------------------------
            2053     1                       ! instant deposit all water vapor to cloud ice when temperature is super low
            2054     1                       ! -----------------------------------------------------------------------
            2055     1               
            2056     2                       if (tz (k) < t_min) then
            2057     2                           sink = dim (qv (k), 1.e-7)
            2058     2                           qv (k) = qv (k) - sink
            2059     2                           qi (k) = qi (k) + sink
            2060     2                           q_sol (k) = q_sol (k) + sink
            2061     2                           cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2062     2                           tz (k) = tz (k) + sink * (lhl (k) + lhi (k)) / cvm (k)
            2063     2                           if (.not. do_qa) qa (k) = qa (k) + 1. ! air fully saturated; 100 % cloud cover
            2064     2                           cycle
            2065     2                       endif
            2066     1               
            2067     1                       ! -----------------------------------------------------------------------
            2068     1                       ! update heat capacity and latend heat coefficient
            2069     1                       ! -----------------------------------------------------------------------
            2070     1               
            2071     1                       lhl (k) = lv00 + d0_vap * tz (k)
            2072     1                       lhi (k) = li00 + dc_ice * tz (k)
            2073     1                       lcpk (k) = lhl (k) / cvm (k)
            2074     1                       icpk (k) = lhi (k) / cvm (k)
            2075     1                       tcpk (k) = lcpk (k) + icpk (k)
            2076     1                       tcp3 (k) = lcpk (k) + icpk (k) * min (1., dim (tice, tz (k)) / (tice - t_wfr))
            2077     1               
            2078     1                       ! -----------------------------------------------------------------------
            2079     1                       ! instant evaporation / sublimation of all clouds if rh < rh_adj -- > cloud free
            2080     1                       ! -----------------------------------------------------------------------
            2081     1               
            2082     1                       qpz = qv (k) + ql (k) + qi (k)
            2083     1                       tin = tz (k) - (lhl (k) * (ql (k) + qi (k)) + lhi (k) * qi (k)) / (c_air + &
            2084     1                           qpz * c_vap + qr (k) * c_liq + (qs (k) + qg (k)) * c_ice)
            2085     2                       if (tin > t_sub + 6.) then
            2086     2    i                      rh = qpz / iqs1 (tin, den (k))
            2087     3                           if (rh < rh_adj) then ! qpz / rh_adj < qs
            2088     3                               tz (k) = tin
            2089     3                               qv (k) = qpz
            2090     3                               ql (k) = 0.
            2091     3                               qi (k) = 0.
            2092     3                               cycle ! cloud free
            2093     3                           endif
            2094     2                       endif
            2095     1               
            2096     1                       ! -----------------------------------------------------------------------
            2097     1                       ! cloud water < -- > vapor adjustment:
            2098     1                       ! -----------------------------------------------------------------------
            2099     1               
            2100     1    i                  qsw = wqs2 (tz (k), den (k), dwsdt)
            2101     1                       dq0 = qsw - qv (k)
            2102     2                       if (dq0 > 0.) then
            2103     2                           ! SJL 20170703 added ql factor to prevent the situation of high ql and low RH
            2104     2                           ! factor = min (1., fac_l2v * sqrt (max (0., ql (k)) / 1.e-5) * 10. * dq0 / qsw)
            2105     2                           ! factor = fac_l2v
            2106     2                           ! factor = 1
            2107     2                           factor = min (1., fac_l2v * (10. * dq0 / qsw)) ! the rh dependent factor = 1 at 90%
            2108     2                           evap = min (ql (k), factor * dq0 / (1. + tcp3 (k) * dwsdt))
            2109     2                       else ! condensate all excess vapor into cloud water
            2110     2                           ! -----------------------------------------------------------------------
            2111     2                           ! evap = fac_v2l * dq0 / (1. + tcp3 (k) * dwsdt)
            2112     2                           ! sjl, 20161108
            2113     2                           ! -----------------------------------------------------------------------
            2114     2                           evap = dq0 / (1. + tcp3 (k) * dwsdt)
            2115     2                       endif
            2116     1                       qv (k) = qv (k) + evap
            2117     1                       ql (k) = ql (k) - evap
            2118     1                       q_liq (k) = q_liq (k) - evap
            2119     1                       cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2120     1                       tz (k) = tz (k) - evap * lhl (k) / cvm (k)
            2121     1               
            2122     1                       ! -----------------------------------------------------------------------
            2123     1                       ! update heat capacity and latend heat coefficient
            2124     1                       ! -----------------------------------------------------------------------
            2125     1               
            2126     1                       lhi (k) = li00 + dc_ice * tz (k)
            2127     1                       icpk (k) = lhi (k) / cvm (k)
            2128     1               
            2129     1                       ! -----------------------------------------------------------------------
            2130     1                       ! enforce complete freezing below - 48 c
            2131     1                       ! -----------------------------------------------------------------------
            2132     1               
            2133     1                       dtmp = t_wfr - tz (k) ! [ - 40, - 48]
            2134     2                       if (dtmp > 0. .and. ql (k) > qcmin) then
            2135     2                           sink = min (ql (k), ql (k) * dtmp * 0.125, dtmp / icpk (k))
            2136     2                           ql (k) = ql (k) - sink
            2137     2                           qi (k) = qi (k) + sink
            2138     2                           q_liq (k) = q_liq (k) - sink
            2139     2                           q_sol (k) = q_sol (k) + sink
            2140     2                           cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2141     2                           tz (k) = tz (k) + sink * lhi (k) / cvm (k)
            2142     2                       endif
            2143     1               
            2144     1                       ! -----------------------------------------------------------------------
            2145     1                       ! update heat capacity and latend heat coefficient
            2146     1                       ! -----------------------------------------------------------------------
            2147     1               
            2148     1                       lhi (k) = li00 + dc_ice * tz (k)
            2149     1                       icpk (k) = lhi (k) / cvm (k)
            2150     1               
            2151     1                       ! -----------------------------------------------------------------------
            2152     1                       ! bigg mechanism
            2153     1                       ! -----------------------------------------------------------------------
            2154     1               
            2155     2                       if (fast_sat_adj) then
            2156     2                           dt_pisub = 0.5 * dts
            2157     2                       else
            2158     2                           dt_pisub = dts
            2159     2                           tc = tice - tz (k)
            2160     3                           if (ql (k) > qrmin .and. tc > 0.) then
            2161     3                               sink = 3.3333e-10 * dts * (exp (0.66 * tc) - 1.) * den (k) * ql (k) * ql (k)
            2162     3                               sink = min (ql (k), tc / icpk (k), sink)
            2163     3                               ql (k) = ql (k) - sink
            2164     3                               qi (k) = qi (k) + sink
            2165     3                               q_liq (k) = q_liq (k) - sink
            2166     3                               q_sol (k) = q_sol (k) + sink
            2167     3                               cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2168     3                               tz (k) = tz (k) + sink * lhi (k) / cvm (k)
            2169     3                           endif ! significant ql existed
            2170     2                       endif
            2171     1               
            2172     1                       ! -----------------------------------------------------------------------
            2173     1                       ! update capacity heat and latend heat coefficient
            2174     1                       ! -----------------------------------------------------------------------
            2175     1               
            2176     1                       lhl (k) = lv00 + d0_vap * tz (k)
            2177     1                       lhi (k) = li00 + dc_ice * tz (k)
            2178     1                       lcpk (k) = lhl (k) / cvm (k)
            2179     1                       icpk (k) = lhi (k) / cvm (k)
            2180     1                       tcpk (k) = lcpk (k) + icpk (k)
            2181     1               
            2182     1                       ! -----------------------------------------------------------------------
            2183     1                       ! sublimation / deposition of ice
            2184     1                       ! -----------------------------------------------------------------------
            2185     1               
            2186     2                       if (tz (k) < tice) then
            2187     2    i                      qsi = iqs2 (tz (k), den (k), dqsdt)
            2188     2                           dq = qv (k) - qsi
            2189     2                           sink = dq / (1. + tcpk (k) * dqsdt)
            2190     3                           if (qi (k) > qrmin) then
            2191     3                               ! eq 9, hong et al. 2004, mwr
            2192     3                               ! for a and b, see dudhia 1989: page 3103 eq (b7) and (b8)
            2193     3                               pidep = dt_pisub * dq * 349138.78 * exp (0.875 * log (qi (k) * den (k))) &
            2194     3                                    / (qsi * den (k) * lat2 / (0.0243 * rvgas * tz (k) ** 2) + 4.42478e4)
            2195     3                           else
            2196     3                               pidep = 0.
            2197     3                           endif
            2198     3                           if (dq > 0.) then ! vapor - > ice
            2199     3                               tmp = tice - tz (k)
            2200     3                               ! 20160912: the following should produce more ice at higher altitude
            2201     3                               ! qi_crt = 4.92e-11 * exp (1.33 * log (1.e3 * exp (0.1 * tmp))) / den (k)
            2202     3                               qi_crt = qi_gen * min (qi_lim, 0.1 * tmp) / den (k)
            2203     3                               sink = min (sink, max (qi_crt - qi (k), pidep), tmp / tcpk (k))
            2204     3                           else ! ice -- > vapor
            2205     3                               pidep = pidep * min (1., dim (tz (k), t_sub) * 0.2)
            2206     3                               sink = max (pidep, sink, - qi (k))
            2207     3                           endif
            2208     2                           qv (k) = qv (k) - sink
            2209     2                           qi (k) = qi (k) + sink
            2210     2                           q_sol (k) = q_sol (k) + sink
            2211     2                           cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2212     2                           tz (k) = tz (k) + sink * (lhl (k) + lhi (k)) / cvm (k)
            2213     2                       endif
            2214     1               
            2215     1                       ! -----------------------------------------------------------------------
            2216     1                       ! update capacity heat and latend heat coefficient
            2217     1                       ! -----------------------------------------------------------------------
            2218     1               
            2219     1                       lhl (k) = lv00 + d0_vap * tz (k)
            2220     1                       lhi (k) = li00 + dc_ice * tz (k)
            2221     1                       lcpk (k) = lhl (k) / cvm (k)
            2222     1                       icpk (k) = lhi (k) / cvm (k)
            2223     1                       tcpk (k) = lcpk (k) + icpk (k)
            2224     1               
            2225     1                       ! -----------------------------------------------------------------------
            2226     1                       ! sublimation / deposition of snow
            2227     1                       ! this process happens for all temp rage
            2228     1                       ! -----------------------------------------------------------------------
            2229     1               
            2230     2                       if (qs (k) > qrmin) then
            2231     2    i                      qsi = iqs2 (tz (k), den (k), dqsdt)
            2232     2                           qden = qs (k) * den (k)
            2233     2                           tmp = exp (0.65625 * log (qden))
            2234     2                           tsq = tz (k) * tz (k)
            2235     2                           dq = (qsi - qv (k)) / (1. + tcpk (k) * dqsdt)
            2236     2                           pssub = cssub (1) * tsq * (cssub (2) * sqrt (qden) + cssub (3) * tmp * &
            2237     2                               sqrt (denfac (k))) / (cssub (4) * tsq + cssub (5) * qsi * den (k))
            2238     2                           pssub = (qsi - qv (k)) * dts * pssub
            2239     3                           if (pssub > 0.) then ! qs -- > qv, sublimation
            2240     3                               pssub = min (pssub * min (1., dim (tz (k), t_sub) * 0.2), qs (k))
            2241     3                           else
            2242     4                               if (tz (k) > tice) then
            2243     4                                   pssub = 0. ! no deposition
            2244     4                               else
            2245     4                                   pssub = max (pssub, dq, (tz (k) - tice) / tcpk (k))
            2246     4                               endif
            2247     3                           endif
            2248     2                           qs (k) = qs (k) - pssub
            2249     2                           qv (k) = qv (k) + pssub
            2250     2                           q_sol (k) = q_sol (k) - pssub
            2251     2                           cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2252     2                           tz (k) = tz (k) - pssub * (lhl (k) + lhi (k)) / cvm (k)
            2253     2                       endif
            2254     1               
            2255     1                       ! -----------------------------------------------------------------------
            2256     1                       ! update capacity heat and latend heat coefficient
            2257     1                       ! -----------------------------------------------------------------------
            2258     1               
            2259     1                       lhl (k) = lv00 + d0_vap * tz (k)
            2260     1                       lhi (k) = li00 + dc_ice * tz (k)
            2261     1                       lcpk (k) = lhl (k) / cvm (k)
            2262     1                       icpk (k) = lhi (k) / cvm (k)
            2263     1                       tcpk (k) = lcpk (k) + icpk (k)
            2264     1               
            2265     1                       ! -----------------------------------------------------------------------
            2266     1                       ! simplified 2 - way grapuel sublimation - deposition mechanism
            2267     1                       ! -----------------------------------------------------------------------
            2268     1               
            2269     2                       if (qg (k) > qrmin) then
            2270     2    i                      qsi = iqs2 (tz (k), den (k), dqsdt)
            2271     2                           dq = (qv (k) - qsi) / (1. + tcpk (k) * dqsdt)
            2272     2                           pgsub = (qv (k) / qsi - 1.) * qg (k)
            2273     3                           if (pgsub > 0.) then ! deposition
            2274     4                               if (tz (k) > tice) then
            2275     4                                   pgsub = 0. ! no deposition
            2276     4                               else
            2277     4                                   pgsub = min (fac_v2g * pgsub, 0.2 * dq, ql (k) + qr (k), &
            2278     4                                       (tice - tz (k)) / tcpk (k))
            2279     4                               endif
            2280     3                           else ! submilation
            2281     3                               pgsub = max (fac_g2v * pgsub, dq) * min (1., dim (tz (k), t_sub) * 0.1)
            2282     3                           endif
            2283     2                           qg (k) = qg (k) + pgsub
            2284     2                           qv (k) = qv (k) - pgsub
            2285     2                           q_sol (k) = q_sol (k) + pgsub
            2286     2                           cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2287     2                           tz (k) = tz (k) + pgsub * (lhl (k) + lhi (k)) / cvm (k)
            2288     2                       endif
            2289     1               
            2290     1               #ifdef USE_MIN_EVAP
            2291     1                       ! -----------------------------------------------------------------------
            2292     1                       ! update capacity heat and latend heat coefficient
            2293     1                       ! -----------------------------------------------------------------------
            2294     1               
            2295     1                       lhl (k) = lv00 + d0_vap * tz (k)
            2296     1                       lcpk (k) = lhl (k) / cvm (k)
            2297     1               
            2298     1                       ! -----------------------------------------------------------------------
            2299     1                       ! * minimum evap of rain in dry environmental air
            2300     1                       ! -----------------------------------------------------------------------
            2301     1               
            2302     1                       if (qr (k) > qcmin) then
            2303     1                           qsw = wqs2 (tz (k), den (k), dqsdt)
            2304     1                           sink = min (qr (k), dim (rh_rain * qsw, qv (k)) / (1. + lcpk (k) * dqsdt))
            2305     1                           qv (k) = qv (k) + sink
            2306     1                           qr (k) = qr (k) - sink
            2307     1                           q_liq (k) = q_liq (k) - sink
            2308     1                           cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2309     1                           tz (k) = tz (k) - sink * lhl (k) / cvm (k)
            2310     1                       endif
            2311     1               #endif
            2312     1               
            2313     1                       ! -----------------------------------------------------------------------
            2314     1                       ! update capacity heat and latend heat coefficient
            2315     1                       ! -----------------------------------------------------------------------
            2316     1               
            2317     1                       lhl (k) = lv00 + d0_vap * tz (k)
            2318     1                       cvm (k) = c_air + (qv (k) + q_liq (k) + q_sol (k)) * c_vap
            2319     1                       lcpk (k) = lhl (k) / cvm (k)
            2320     1               
            2321     1                       ! -----------------------------------------------------------------------
            2322     1                       ! compute cloud fraction
            2323     1                       ! -----------------------------------------------------------------------
            2324     1               
            2325     1                       ! -----------------------------------------------------------------------
            2326     1                       ! combine water species
            2327     1                       ! -----------------------------------------------------------------------
            2328     1               
            2329     1                       if (do_qa) cycle
            2330     1               
            2331     2                       if (rad_snow) then
            2332     2                           q_sol (k) = qi (k) + qs (k)
            2333     2                       else
            2334     2                           q_sol (k) = qi (k)
            2335     2                       endif
            2336     2                       if (rad_rain) then
            2337     2                           q_liq (k) = ql (k) + qr (k)
            2338     2                       else
            2339     2                           q_liq (k) = ql (k)
            2340     2                       endif
            2341     1                       q_cond (k) = q_liq (k) + q_sol (k)
            2342     1               
            2343     1                       qpz = qv (k) + q_cond (k) ! qpz is conserved
            2344     1               
            2345     1                       ! -----------------------------------------------------------------------
            2346     1                       ! use the "liquid - frozen water temperature" (tin) to compute saturated specific humidity
            2347     1                       ! -----------------------------------------------------------------------
            2348     1               
            2349     1                       tin = tz (k) - (lcpk (k) * q_cond (k) + icpk (k) * q_sol (k)) ! minimum temperature
            2350     1                       ! tin = tz (k) - ((lv00 + d0_vap * tz (k)) * q_cond (k) + &
            2351     1                       ! (li00 + dc_ice * tz (k)) * q_sol (k)) / (c_air + qpz * c_vap)
            2352     1               
            2353     1                       ! -----------------------------------------------------------------------
            2354     1                       ! determine saturated specific humidity
            2355     1                       ! -----------------------------------------------------------------------
            2356     1               
            2357     2                       if (tin <= t_wfr) then
            2358     2                           ! ice phase:
            2359     2    i                      qstar = iqs1 (tin, den (k))
            2360     2                       elseif (tin >= tice) then
            2361     2                           ! liquid phase:
            2362     2    i                      qstar = wqs1 (tin, den (k))
            2363     2                       else
            2364     2                           ! mixed phase:
            2365     2    i                      qsi = iqs1 (tin, den (k))
            2366     2    i                      qsw = wqs1 (tin, den (k))
            2367     3                           if (q_cond (k) > 3.e-6) then
            2368     3                               rqi = q_sol (k) / q_cond (k)
            2369     3                           else
            2370     3                               ! -----------------------------------------------------------------------
            2371     3                               ! mostly liquid water q_cond (k) at initial cloud development stage
            2372     3                               ! -----------------------------------------------------------------------
            2373     3                               rqi = (tice - tin) / (tice - t_wfr)
            2374     3                           endif
            2375     2                           qstar = rqi * qsi + (1. - rqi) * qsw
            2376     2                       endif
            2377     1               
            2378     1                       ! -----------------------------------------------------------------------
            2379     1                       ! assuming subgrid linear distribution in horizontal; this is effectively a smoother for the
            2380     1                       ! binary cloud scheme
            2381     1                       ! -----------------------------------------------------------------------
            2382     1               
            2383     2                       if (qpz > qrmin) then
            2384     2                           ! partial cloudiness by pdf:
            2385     2                           dq = max (qcmin, h_var * qpz)
            2386     2                           q_plus = qpz + dq ! cloud free if qstar > q_plus
            2387     2                           q_minus = qpz - dq
            2388     3                           if (qstar < q_minus) then
            2389     3                               qa (k) = qa (k) + 1. ! air fully saturated; 100 % cloud cover
            2390     3                           elseif (qstar < q_plus .and. q_cond (k) > qc_crt) then
            2391     3                               qa (k) = qa (k) + (q_plus - qstar) / (dq + dq) ! partial cloud cover
            2392     3                               ! qa (k) = sqrt (qa (k) + (q_plus - qstar) / (dq + dq))
            2393     3                           endif
            2394     2                       endif
            2395     1               
            2396     1                   enddo
            2397                     
            2398                     end subroutine subgrid_z_proc
            2399                     
            2400                     ! =======================================================================
            2401                     !> rain evaporation
            2402                     ! =======================================================================
            2403                     
            2404                     subroutine revap_rac1 (hydrostatic, is, ie, dt, tz, qv, ql, qr, qi, qs, qg, den, hvar)
            2405                     
            2406                         implicit none
            2407                     
            2408                         logical, intent (in) :: hydrostatic
            2409                     
            2410                         integer, intent (in) :: is, ie
            2411                     
            2412                         real, intent (in) :: dt ! time step (s)
            2413                     
            2414                         real, intent (in), dimension (is:ie) :: den, hvar, qi, qs, qg
            2415                     
            2416                         real, intent (inout), dimension (is:ie) :: tz, qv, qr, ql
            2417                     
            2418                         real, dimension (is:ie) :: lcp2, denfac, q_liq, q_sol, cvm, lhl
            2419                     
            2420                         real :: dqv, qsat, dqsdt, evap, qden, q_plus, q_minus, sink
            2421                         real :: tin, t2, qpz, dq, dqh
            2422                     
            2423                         integer :: i
            2424                     
            2425                         ! -----------------------------------------------------------------------
            2426                         ! define latend heat coefficient
            2427                         ! -----------------------------------------------------------------------
            2428                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 281
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ql, qv, qg, tz, qs, q_sol, cvm, q_liq
                                   <<<      qi, qr, lcp2, lhl
                                   <<< Loop-information  End >>>
            2429     1  pp    v          do i = is, ie
            2430     1   p    v              lhl (i) = lv00 + d0_vap * tz (i)
            2431     1   p    v              q_liq (i) = ql (i) + qr (i)
            2432     1   p    v              q_sol (i) = qi (i) + qs (i) + qg (i)
            2433     1   p    v              cvm (i) = c_air + qv (i) * c_vap + q_liq (i) * c_liq + q_sol (i) * c_ice
            2434     1   p    v              lcp2 (i) = lhl (i) / cvm (i)
            2435     1                       ! denfac (i) = sqrt (sfcrho / den (i))
            2436     1   p    v          enddo
            2437                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qr
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 5
                                   <<<      SIMD&FP   : SPILL 1  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2438     1                   do i = is, ie
            2439     2                       if (qr (i) > qrmin .and. tz (i) > t_wfr) then
            2440     2                           qpz = qv (i) + ql (i)
            2441     2                           tin = tz (i) - lcp2 (i) * ql (i) ! presence of clouds suppresses the rain evap
            2442     2    i                      qsat = wqs2 (tin, den (i), dqsdt)
            2443     2                           dqh = max (ql (i), hvar (i) * max (qpz, qcmin))
            2444     2                           dqv = qsat - qv (i)
            2445     2                           q_minus = qpz - dqh
            2446     2                           q_plus = qpz + dqh
            2447     2               
            2448     2                           ! -----------------------------------------------------------------------
            2449     2                           ! qsat must be > q_minus to activate evaporation
            2450     2                           ! qsat must be < q_plus to activate accretion
            2451     2                           ! -----------------------------------------------------------------------
            2452     2               
            2453     2                           ! -----------------------------------------------------------------------
            2454     2                           ! rain evaporation
            2455     2                           ! -----------------------------------------------------------------------
            2456     2               
            2457     3                           if (dqv > qvmin .and. qsat > q_minus) then
            2458     4                               if (qsat > q_plus) then
            2459     4                                   dq = qsat - qpz
            2460     4                               else
            2461     4                                   ! q_minus < qsat < q_plus
            2462     4                                   ! dq == dqh if qsat == q_minus
            2463     4                                   dq = 0.25 * (q_minus - qsat) ** 2 / dqh
            2464     4                               endif
            2465     3                               qden = qr (i) * den (i)
            2466     3                               t2 = tin * tin
            2467     3                               evap = crevp (1) * t2 * dq * (crevp (2) * sqrt (qden) + crevp (3) * exp (0.725 * log (qden))) &
            2468     3                                    / (crevp (4) * t2 + crevp (5) * qsat * den (i))
            2469     3                               evap = min (qr (i), dt * evap, dqv / (1. + lcp2 (i) * dqsdt))
            2470     3                               qr (i) = qr (i) - evap
            2471     3                               qv (i) = qv (i) + evap
            2472     3                               q_liq (i) = q_liq (i) - evap
            2473     3                               cvm (i) = c_air + qv (i) * c_vap + q_liq (i) * c_liq + q_sol (i) * c_ice
            2474     3                               tz (i) = tz (i) - evap * lhl (i) / cvm (i)
            2475     3                           endif
            2476     2               
            2477     2                           ! -----------------------------------------------------------------------
            2478     2                           ! accretion: pracc
            2479     2                           ! -----------------------------------------------------------------------
            2480     2               
            2481     3                           if (qr (i) > qrmin .and. ql (i) > 1.e-8 .and. qsat < q_plus) then
            2482     3                               denfac (i) = sqrt (sfcrho / den (i))
            2483     3                               sink = dt * denfac (i) * cracw * exp (0.95 * log (qr (i) * den (i)))
            2484     3                               sink = sink / (1. + sink) * ql (i)
            2485     3                               ql (i) = ql (i) - sink
            2486     3                               qr (i) = qr (i) + sink
            2487     3                           endif
            2488     2                       endif
            2489     1                   enddo
            2490                     
            2491                     end subroutine revap_rac1
            2492                     
            2493                     ! =======================================================================
            2494                     !>@brief The subroutine 'terminal_fall' computes terminal fall speed.
            2495                     !>@details It considers cloud ice, snow, and graupel's melting during fall.
            2496                     ! =======================================================================
            2497                     
            2498                     subroutine terminal_fall (dtm, ktop, kbot, tz, qv, ql, qr, qg, qs, qi, dz, dp, &
            2499                             den, vtg, vts, vti, r1, g1, s1, i1, m1_sol, w1)
            2500                     
            2501                         implicit none
            2502                     
            2503                         integer, intent (in) :: ktop, kbot
            2504                     
            2505                         real, intent (in) :: dtm ! time step (s)
            2506                     
            2507                         real, intent (in), dimension (ktop:kbot) :: vtg, vts, vti, den, dp, dz
            2508                     
            2509                         real, intent (inout), dimension (ktop:kbot) :: qv, ql, qr, qg, qs, qi, tz, m1_sol, w1
            2510                     
            2511                         real, intent (out) :: r1, g1, s1, i1
            2512                     
            2513                         real, dimension (ktop:kbot + 1) :: ze, zt
            2514                     
            2515                         real :: qsat, dqsdt, dt5, evap, dtime
            2516                         real :: factor, frac
            2517                         real :: tmp, precip, tc, sink
            2518                     
            2519                         real, dimension (ktop:kbot) :: lcpk, icpk, cvm, q_liq, q_sol, lhl, lhi
            2520                         real, dimension (ktop:kbot) :: m1, dm
            2521                     
            2522                         real :: zs = 0.
            2523                         real :: fac_imlt
            2524                     
            2525                         integer :: k, k0, m
            2526                     
            2527                         logical :: no_fall
            2528                     
            2529                         dt5 = 0.5 * dtm
            2530                         fac_imlt = 1. - exp (- dt5 / tau_imlt)
            2531                     
            2532                         ! -----------------------------------------------------------------------
            2533                         ! define heat capacity and latend heat coefficient
            2534                         ! -----------------------------------------------------------------------
            2535                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 229
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.68, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, qs, qi, qr, ql, qv, qg, q_sol, cvm
                                   <<<      q_liq, icpk, lhi, lcpk, lhl, m1_sol
                                   <<< Loop-information  End >>>
            2536     1  pp    v          do k = ktop, kbot
            2537     1   p    v              m1_sol (k) = 0.
            2538     1   p    v              lhl (k) = lv00 + d0_vap * tz (k)
            2539     1   p    v              lhi (k) = li00 + dc_ice * tz (k)
            2540     1   p    v              q_liq (k) = ql (k) + qr (k)
            2541     1   p    v              q_sol (k) = qi (k) + qs (k) + qg (k)
            2542     1   p    v              cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2543     1   p    v              lcpk (k) = lhl (k) / cvm (k)
            2544     1   p    v              icpk (k) = lhi (k) / cvm (k)
            2545     1   p    v          enddo
            2546                     
            2547                         ! -----------------------------------------------------------------------
            2548                         ! find significant melting level

            4117                     ! =======================================================================
            4118                     !>@brief The subroutine 'esw_table1d' computes the saturated water vapor
            4119                     !! pressure for table ii.
            4120                     ! =======================================================================
            4121                     
            4122                     subroutine esw_table1d (ta, es, n)
            4123                     
            4124                         implicit none
            4125                     
            4126                         integer, intent (in) :: n
            4127                     
            4128                         real, intent (in) :: ta (n)
            4129                     
            4130                         real, intent (out) :: es (n)
            4131                     
            4132                         real :: ap1, tmin
            4133                     
            4134                         integer :: i, it
            4135                     
            4136                         tmin = table_ice - 160.
            4137                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 281
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.71, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ta, es
                                   <<< Loop-information  End >>>
            4138     1  pp   2v          do i = 1, n
            4139     1   p   2v              ap1 = 10. * dim (ta (i), tmin) + 1.
            4140     1   p   2v              ap1 = min (2621., ap1)
            4141     1   p   2v              it = ap1
            4142     1   p   2v              es (i) = tablew (it) + (ap1 - it) * desw (it)
            4143     1   p   2v          enddo
            4144                     
            4145                     end subroutine esw_table1d
            4146                     
            4147                     ! =======================================================================
            4148                     !>@brief The subroutine 'es3_table1d' computes the saturated water vapor
            4149                     !! pressure for table iii.
            4150                     ! =======================================================================
            4151                     
            4152                     subroutine es2_table1d (ta, es, n)
            4153                     
            4154                         implicit none
            4155                     
            4156                         integer, intent (in) :: n
            4157                     
            4158                         real, intent (in) :: ta (n)
            4159                     
            4160                         real, intent (out) :: es (n)
            4161                     
            4162                         real :: ap1, tmin
            4163                     
            4164                         integer :: i, it
            4165                     
            4166                         tmin = table_ice - 160.
            4167                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 281
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.71, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ta, es
                                   <<< Loop-information  End >>>
            4168     1  pp   2v          do i = 1, n
            4169     1   p   2v              ap1 = 10. * dim (ta (i), tmin) + 1.
            4170     1   p   2v              ap1 = min (2621., ap1)
            4171     1   p   2v              it = ap1
            4172     1   p   2v              es (i) = table2 (it) + (ap1 - it) * des2 (it)
            4173     1   p   2v          enddo
            4174                     
            4175                     end subroutine es2_table1d
            4176                     
            4177                     ! =======================================================================
            4178                     !>@brief The subroutine 'es3_table1d' computes the saturated water vapor
            4179                     !! pressure for table iv.
            4180                     ! =======================================================================
            4181                     
            4182                     subroutine es3_table1d (ta, es, n)
            4183                     
            4184                         implicit none
            4185                     
            4186                         integer, intent (in) :: n
            4187                     
            4188                         real, intent (in) :: ta (n)
            4189                     
            4190                         real, intent (out) :: es (n)
            4191                     
            4192                         real :: ap1, tmin
            4193                     
            4194                         integer :: i, it
            4195                     
            4196                         tmin = table_ice - 160.
            4197                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 281
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.71, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ta, es
                                   <<< Loop-information  End >>>
            4198     1  pp   2v          do i = 1, n
            4199     1   p   2v              ap1 = 10. * dim (ta (i), tmin) + 1.
            4200     1   p   2v              ap1 = min (2621., ap1)
            4201     1   p   2v              it = ap1
            4202     1   p   2v              es (i) = table3 (it) + (ap1 - it) * des3 (it)
            4203     1   p   2v          enddo
            4204                     
            4205                     end subroutine es3_table1d
            4206                     
            4207                     ! =======================================================================
            4208                     !>@brief saturation water vapor pressure table ii
            4209                     ! 1 - phase table
            4210                     ! =======================================================================
            4211                     
            4212                     subroutine qs_tablew (n)
            4213                     
            4214                         implicit none
            4215                     
            4216                         integer, intent (in) :: n
            4217                     
            4218                         real :: delt = 0.1
            4219                         real :: tmin, tem, fac0, fac1, fac2
            4220                     
            4221                         integer :: i
            4222                     
            4223                         tmin = table_ice - 160.
            4224                     
            4225                         ! -----------------------------------------------------------------------
            4226                         ! compute es over water
            4227                         ! -----------------------------------------------------------------------
            4228                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tablew
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 96
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4229     1  pp    v          do i = 1, n
            4230     1   p    v              tem = tmin + delt * real (i - 1)
            4231     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4232     1   p    v              fac1 = fac0 * lv0
            4233     1   p    v              fac2 = (dc_vap * log (tem / t_ice) + fac1) / rvgas
            4234     1   p    v              tablew (i) = e00 * exp (fac2)
            4235     1   p    v          enddo
            4236                     
            4237                     end subroutine qs_tablew
            4238                     
            4239                     ! =======================================================================
            4240                     !>@brief saturation water vapor pressure table iii
            4241                     ! 2 - phase table
            4242                     ! =======================================================================
            4243                     
            4244                     subroutine qs_table2 (n)
            4245                     
            4246                         implicit none
            4247                     
            4248                         integer, intent (in) :: n
            4249                     
            4250                         real :: delt = 0.1
            4251                         real :: tmin, tem0, tem1, fac0, fac1, fac2
            4252                     
            4253                         integer :: i, i0, i1
            4254                     
            4255                         tmin = table_ice - 160.
            4256                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4257     1  pp    v          do i = 1, n
            4258     1   p    v              tem0 = tmin + delt * real (i - 1)
            4259     1   p    v              fac0 = (tem0 - t_ice) / (tem0 * t_ice)
            4260     2   p    v              if (i <= 1600) then
            4261     2                           ! -----------------------------------------------------------------------
            4262     2                           ! compute es over ice between - 160 deg c and 0 deg c.
            4263     2                           ! -----------------------------------------------------------------------
            4264     2   p    v                  fac1 = fac0 * li2
            4265     2   p    v                  fac2 = (d2ice * log (tem0 / t_ice) + fac1) / rvgas
            4266     2   p    v              else
            4267     2                           ! -----------------------------------------------------------------------
            4268     2                           ! compute es over water between 0 deg c and 102 deg c.
            4269     2                           ! -----------------------------------------------------------------------
            4270     2   p    v                  fac1 = fac0 * lv0
            4271     2   p    v                  fac2 = (dc_vap * log (tem0 / t_ice) + fac1) / rvgas
            4272     2   p    v              endif
            4273     1   p    v              table2 (i) = e00 * exp (fac2)
            4274     1   p    v          enddo
            4275                     
            4276                         ! -----------------------------------------------------------------------
            4277                         ! smoother around 0 deg c
            4278                         ! -----------------------------------------------------------------------
            4279                     
            4280                         i0 = 1600
            4281                         i1 = 1601
            4282                         tem0 = 0.25 * (table2 (i0 - 1) + 2. * table (i0) + table2 (i0 + 1))
            4283                         tem1 = 0.25 * (table2 (i1 - 1) + 2. * table (i1) + table2 (i1 + 1))
            4284                         table2 (i0) = tem0
            4285                         table2 (i1) = tem1
            4286                     
            4287                     end subroutine qs_table2
            4288                     
            4289                     ! =======================================================================
            4290                     !>@brief saturation water vapor pressure table iv
            4291                     ! 2 - phase table with " - 2 c" as the transition point
            4292                     ! =======================================================================
            4293                     
            4294                     subroutine qs_table3 (n)
            4295                     
            4296                         implicit none
            4297                     
            4298                         integer, intent (in) :: n
            4299                     
            4300                         real :: delt = 0.1
            4301                         real :: esbasw, tbasw, esbasi, tmin, tem, aa, b, c, d, e
            4302                         real :: tem0, tem1
            4303                     
            4304                         integer :: i, i0, i1
            4305                     
            4306                         esbasw = 1013246.0
            4307                         tbasw = table_ice + 100.
            4308                         esbasi = 6107.1
            4309                         tmin = table_ice - 160.
            4310                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 8
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table3
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 23  FILL 42
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4311     1  pp    v          do i = 1, n
            4312     1   p    v              tem = tmin + delt * real (i - 1)
            4313     1                       ! if (i <= 1600) then
            4314     2   p    v              if (i <= 1580) then ! change to - 2 c
            4315     2                           ! -----------------------------------------------------------------------
            4316     2                           ! compute es over ice between - 160 deg c and 0 deg c.
            4317     2                           ! see smithsonian meteorological tables page 350.
            4318     2                           ! -----------------------------------------------------------------------
            4319     2   p    v                  aa = - 9.09718 * (table_ice / tem - 1.)
            4320     2   p    v                  b = - 3.56654 * alog10 (table_ice / tem)
            4321     2   p    v                  c = 0.876793 * (1. - tem / table_ice)
            4322     2   p    v                  e = alog10 (esbasi)
            4323     2   p    v                  table3 (i) = 0.1 * 10 ** (aa + b + c + e)
            4324     2   p    v              else
            4325     2                           ! -----------------------------------------------------------------------
            4326     2                           ! compute es over water between - 2 deg c and 102 deg c.
            4327     2                           ! see smithsonian meteorological tables page 350.
            4328     2                           ! -----------------------------------------------------------------------
            4329     2   p    v                  aa = - 7.90298 * (tbasw / tem - 1.)
            4330     2   p    v                  b = 5.02808 * alog10 (tbasw / tem)
            4331     2   p    v                  c = - 1.3816e-7 * (10 ** ((1. - tem / tbasw) * 11.344) - 1.)
            4332     2   p    v                  d = 8.1328e-3 * (10 ** ((tbasw / tem - 1.) * (- 3.49149)) - 1.)
            4333     2   p    v                  e = alog10 (esbasw)
            4334     2   p    v                  table3 (i) = 0.1 * 10 ** (aa + b + c + d + e)
            4335     2   p    v              endif
            4336     1   p    v          enddo
            4337                     
            4338                         ! -----------------------------------------------------------------------
            4339                         ! smoother around - 2 deg c
            4340                         ! -----------------------------------------------------------------------
            4341                     
            4342                         i0 = 1580
            4343                         i1 = 1581
            4344                         tem0 = 0.25 * (table3 (i0 - 1) + 2. * table (i0) + table3 (i0 + 1))
            4345                         tem1 = 0.25 * (table3 (i1 - 1) + 2. * table (i1) + table3 (i1 + 1))
            4346                         table3 (i0) = tem0
            4347                         table3 (i1) = tem1
            4348                     
            4349                     end subroutine qs_table3
            4350                     
            4351                     ! =======================================================================
            4352                     ! compute the saturated specific humidity for table
            4353                     ! note: this routine is based on "moist" mixing ratio
            4354                     !>@brief The function 'qs_blend' computes the saturated specific humidity
            4355                     !! with a blend of water and ice depending on the temperature.
            4356                     ! =======================================================================
            4357                     
            4358                     real function qs_blend (t, p, q)
            4359                     
            4360                         implicit none
            4361                     
            4362                         real, intent (in) :: t, p, q
            4363                     
            4364                         real :: es, ap1, tmin
            4365                     
            4366                         integer :: it
            4367                     
            4368                         tmin = table_ice - 160.
            4369                         ap1 = 10. * dim (t, tmin) + 1.
            4370                         ap1 = min (2621., ap1)
            4371                         it = ap1
            4372                         es = table (it) + (ap1 - it) * des (it)
            4373                         qs_blend = eps * es * (1. + zvir * q) / p
            4374                     
            4375                     end function qs_blend
            4376                     
            4377                     ! =======================================================================
            4378                     !>@brief saturation water vapor pressure table i
            4379                     ! 3 - phase table
            4380                     ! =======================================================================
            4381                     
            4382                     subroutine qs_table (n)
            4383                     
            4384                         implicit none
            4385                     
            4386                         integer, intent (in) :: n
            4387                     
            4388                         real :: delt = 0.1
            4389                         real :: tmin, tem, esh20
            4390                         real :: wice, wh2o, fac0, fac1, fac2
            4391                         real :: esupc (200)
            4392                     
            4393                         integer :: i
            4394                     
            4395                         tmin = table_ice - 160.
            4396                     
            4397                         ! -----------------------------------------------------------------------
            4398                         ! compute es over ice between - 160 deg c and 0 deg c.
            4399                         ! -----------------------------------------------------------------------
            4400                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.46, ITR: 80, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 48
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4401     1  pp    v          do i = 1, 1600
            4402     1   p    v              tem = tmin + delt * real (i - 1)
            4403     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4404     1   p    v              fac1 = fac0 * li2
            4405     1   p    v              fac2 = (d2ice * log (tem / t_ice) + fac1) / rvgas
            4406     1   p    v              table (i) = e00 * exp (fac2)
            4407     1   p    v          enddo
            4408                     
            4409                         ! -----------------------------------------------------------------------
            4410                         ! compute es over water between - 20 deg c and 102 deg c.
            4411                         ! -----------------------------------------------------------------------
            4412                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      esupc, table
                                   <<< Loop-information  End >>>
            4413     1  pp    v          do i = 1, 1221
            4414     1   p    v              tem = 253.16 + delt * real (i - 1)
            4415     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4416     1   p    v              fac1 = fac0 * lv0
            4417     1   p    v              fac2 = (dc_vap * log (tem / t_ice) + fac1) / rvgas
            4418     1   p    v              esh20 = e00 * exp (fac2)
            4419     2   p    v              if (i <= 200) then
            4420     2   p    v                  esupc (i) = esh20
            4421     2   p    v              else
            4422     2   p    v                  table (i + 1400) = esh20
            4423     2   p    v              endif
            4424     1   p    v          enddo
            4425                     
            4426                         ! -----------------------------------------------------------------------
            4427                         ! derive blended es over ice and supercooled water between - 20 deg c and 0 deg c
            4428                         ! -----------------------------------------------------------------------
            4429                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table, (unknown)
                                   <<< Loop-information  End >>>
            4430     1   s   2v          do i = 1, 200
            4431     1   p   2v              tem = 253.16 + delt * real (i - 1)
            4432     1   p   2v              wice = 0.05 * (table_ice - tem)
            4433     1   p   2v              wh2o = 0.05 * (tem - 253.16)
            4434     1   p   2v              table (i + 1400) = wice * table (i + 1400) + wh2o * esupc (i)
            4435     1   p   2v          enddo
            4436                     
            4437                     end subroutine qs_table
            4438                     
            4439                     ! =======================================================================
            4440                     ! compute the saturated specific humidity and the gradient of saturated specific humidity
            4441                     ! input t in deg k, p in pa; p = rho rdry tv, moist pressure
            4442                     !>@brief The function 'qsmith' computes the saturated specific humidity
            4443                     !! with a blend of water and ice depending on the temperature in 3D.
            4444                     !@details It als oincludes the option for computing des/dT.
            4445                     ! =======================================================================
            4446                     
            4447                     subroutine qsmith (im, km, ks, t, p, q, qs, dqdt)
            4448                     
            4449                         implicit none
            4450                     
            4451                         integer, intent (in) :: im, km, ks
            4452                     
            4453                         real, intent (in), dimension (im, km) :: t, p, q
            4454                     
            4455                         real, intent (out), dimension (im, km) :: qs
            4456                     
            4457                         real, intent (out), dimension (im, km), optional :: dqdt
            4458                     
            4459                         real :: eps10, ap1, tmin
            4460                     
            4461                         real, dimension (im, km) :: es
            4462                     
            4463                         integer :: i, k, it
            4464                     
            4465                         tmin = table_ice - 160.
            4466                         eps10 = 10. * eps
            4467                     
            4468     1                   if (.not. tables_are_initialized) then
            4469     1                       call qsmith_init
            4470     1                   endif
            4471                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, p, q, es, qs
                                   <<< Loop-information  End >>>
            4472     1  pp               do k = ks, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.70, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, p, t, qs, es
                                   <<< Loop-information  End >>>
            4473     2   p    v              do i = 1, im
            4474     2   p    v                  ap1 = 10. * dim (t (i, k), tmin) + 1.
            4475     2   p    v                  ap1 = min (2621., ap1)
            4476     2   p    v                  it = ap1
            4477     2   p    v                  es (i, k) = table (it) + (ap1 - it) * des (it)
            4478     2   p    v                  qs (i, k) = eps * es (i, k) * (1. + zvir * q (i, k)) / p (i, k)
            4479     2   p    v              enddo
            4480     1   p               enddo
            4481                     
            4482     1                   if (present (dqdt)) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, p, q, dqdt
                                   <<< Loop-information  End >>>
            4483     2  pp                   do k = ks, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.68, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, t, p, dqdt
                                   <<< Loop-information  End >>>
            4484     3   p    v                  do i = 1, im
            4485     3   p    v                      ap1 = 10. * dim (t (i, k), tmin) + 1.
            4486     3   p    v                      ap1 = min (2621., ap1) - 0.5
            4487     3   p    v                      it = ap1
            4488     3   p    v                      dqdt (i, k) = eps10 * (des (it) + (ap1 - it) * (des (it + 1) - des (it))) * (1. + zvir * q (i, k)) / p (i, k)
            4489     3   p    v                  enddo
            4490     2   p                   enddo
            4491     1                   endif
            4492                     
            4493                     end subroutine qsmith
            4494                     
            4495                     ! =======================================================================
            4496                     !>@brief The subroutine 'neg_adj' fixes negative water species.
            4497                     !>@details This is designed for 6-class micro-physics schemes.
            4498                     ! =======================================================================
            4499                     
            4500                     subroutine neg_adj (ktop, kbot, pt, dp, qv, ql, qr, qi, qs, qg)
            4501                     
            4502                         implicit none
            4503                     
            4504                         integer, intent (in) :: ktop, kbot
            4505                     
            4506                         real, intent (in), dimension (ktop:kbot) :: dp
            4507                     
            4508                         real, intent (inout), dimension (ktop:kbot) :: pt, qv, ql, qr, qi, qs, qg
            4509                     
            4510                         real, dimension (ktop:kbot) :: lcpk, icpk
            4511                     
            4512                         real :: dq, cvm
            4513                     
            4514                         integer :: k
            4515                     
            4516                         ! -----------------------------------------------------------------------
            4517                         ! define heat capacity and latent heat coefficient
            4518                         ! -----------------------------------------------------------------------
            4519                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 142
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 4520,4526)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.19, ITR: 64, MVE: 4, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv, pt, qg, lcpk, qs, ql, qr, qi, icpk
                                   <<< Loop-information  End >>>
            4520     1  pp    v          do k = ktop, kbot
            4521     1   p    v              cvm = c_air + qv (k) * c_vap + (qr (k) + ql (k)) * c_liq + (qi (k) + qs (k) + qg (k)) * c_ice
            4522     1   p    v              lcpk (k) = (lv00 + d0_vap * pt (k)) / cvm
            4523     1   p    v              icpk (k) = (li00 + dc_ice * pt (k)) / cvm
            4524     1   p    v          enddo
            4525                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            4526     1                   do k = ktop, kbot
            4527     1               
            4528     1                       ! -----------------------------------------------------------------------
            4529     1                       ! ice phase:
            4530     1                       ! -----------------------------------------------------------------------
            4531     1               
            4532     1                       ! if cloud ice < 0, borrow from snow
            4533     2                       if (qi (k) < 0.) then
            4534     2                           qs (k) = qs (k) + qi (k)
            4535     2                           qi (k) = 0.
            4536     2                       endif
            4537     1                       ! if snow < 0, borrow from graupel
            4538     2                       if (qs (k) < 0.) then
            4539     2                           qg (k) = qg (k) + qs (k)
            4540     2                           qs (k) = 0.
            4541     2                       endif
            4542     1                       ! if graupel < 0, borrow from rain
            4543     2                       if (qg (k) < 0.) then
            4544     2                           qr (k) = qr (k) + qg (k)
            4545     2                           pt (k) = pt (k) - qg (k) * icpk (k) ! heating
            4546     2                           qg (k) = 0.
            4547     2                       endif
            4548     1               
            4549     1                       ! -----------------------------------------------------------------------
            4550     1                       ! liquid phase:
            4551     1                       ! -----------------------------------------------------------------------
            4552     1               
            4553     1                       ! if rain < 0, borrow from cloud water
            4554     2                       if (qr (k) < 0.) then
            4555     2                           ql (k) = ql (k) + qr (k)
            4556     2                           qr (k) = 0.
            4557     2                       endif
            4558     1                       ! if cloud water < 0, borrow from water vapor
            4559     2                       if (ql (k) < 0.) then
            4560     2                           qv (k) = qv (k) + ql (k)
            4561     2                           pt (k) = pt (k) - ql (k) * lcpk (k) ! heating
            4562     2                           ql (k) = 0.
            4563     2                       endif
            4564     1               
            4565     1                   enddo
            4566                     
            4567                         ! -----------------------------------------------------------------------
            4568                         ! fix water vapor; borrow from below
            4569                         ! -----------------------------------------------------------------------
            4570                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv
                                   <<< Loop-information  End >>>
            4571     1   s   2s          do k = ktop, kbot - 1
            4572     2   s   2m              if (qv (k) < 0.) then
            4573     2   s   2s                  qv (k + 1) = qv (k + 1) + qv (k) * dp (k) / dp (k + 1)
            4574     2   s   2v                  qv (k) = 0.
            4575     2   s   2v              endif
            4576     1   s   2v          enddo
            4577                     
            4578                         ! -----------------------------------------------------------------------
            4579                         ! bottom layer; borrow from above
            4580                         ! -----------------------------------------------------------------------
            4581                     
            4582     1                   if (qv (kbot) < 0. .and. qv (kbot - 1) > 0.) then
            4583     1                       dq = min (- qv (kbot) * dp (kbot), qv (kbot - 1) * dp (kbot - 1))
            4584     1                       qv (kbot - 1) = qv (kbot - 1) - dq / dp (kbot - 1)
            4585     1                       qv (kbot) = qv (kbot) + dq / dp (kbot)
            4586     1                   endif
            4587                     
            4588                     end subroutine neg_adj
            4589                     
            4590                     ! =======================================================================
            4591                     ! compute global sum
            4592                     !>@brief quick local sum algorithm
            4593                     ! =======================================================================
            4594                     
            4595                     !real function g_sum (p, ifirst, ilast, jfirst, jlast, area, mode)
            4596                     !
            4597                     ! use mpp_mod, only: mpp_sum
            4598                     !
            4599                     ! implicit none
            4600                     !
            4601                     ! integer, intent (in) :: ifirst, ilast, jfirst, jlast
            4602                     ! integer, intent (in) :: mode ! if == 1 divided by area
            4603                     !
            4604                     ! real, intent (in), dimension (ifirst:ilast, jfirst:jlast) :: p, area
            4605                     !
            4606                     ! integer :: i, j
            4607                     !
            4608                     ! real :: gsum
            4609                     !
            4610                     ! if (global_area < 0.) then
            4611                     ! global_area = 0.
            4612                     ! do j = jfirst, jlast
            4613                     ! do i = ifirst, ilast
            4614                     ! global_area = global_area + area (i, j)
            4615                     ! enddo
            4616                     ! enddo
            4617                     ! call mpp_sum (global_area)
            4618                     ! endif
            4619                     !
            4620                     ! gsum = 0.
            4621                     ! do j = jfirst, jlast
            4622                     ! do i = ifirst, ilast
            4623                     ! gsum = gsum + p (i, j) * area (i, j)
            4624                     ! enddo
            4625                     ! enddo
            4626                     ! call mpp_sum (gsum)
            4627                     !
            4628                     ! if (mode == 1) then
            4629                     ! g_sum = gsum / global_area
            4630                     ! else
            4631                     ! g_sum = gsum
            4632                     ! endif
            4633                     !
            4634                     !end function g_sum

            4046                     ! =======================================================================
            4047                     !>@brief The function 'd_sat' computes the difference in saturation
            4048                     !! vapor * density * between water and ice
            4049                     ! =======================================================================
            4050                     
            4051                     real function d_sat (ta, den)
            4052                     
            4053                         implicit none
            4054                     
            4055                         real, intent (in) :: ta, den
            4056                     
            4057                         real :: es_w, es_i, ap1, tmin
            4058                     
            4059                         integer :: it
            4060                     
            4061                         tmin = table_ice - 160.
            4062                         ap1 = 10. * dim (ta, tmin) + 1.
            4063                         ap1 = min (2621., ap1)
            4064                         it = ap1
            4065                         es_w = tablew (it) + (ap1 - it) * desw (it)
            4066                         es_i = table2 (it) + (ap1 - it) * des2 (it)
            4067                         d_sat = dim (es_w, es_i) / (rvgas * ta * den) ! take positive difference
            4068                     
            4069                     end function d_sat

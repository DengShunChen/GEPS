            1170     1  pp   4v              vtr (:) = vf_min
            1171     1                       r1 = 0.
            1172     1                   else
            1173     1               
            1174     1                       ! -----------------------------------------------------------------------
            1175     1                       ! fall speed of rain
            1176     1                       ! -----------------------------------------------------------------------
            1177     1               
            1178     2                       if (const_vr) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vtr
                                   <<< Loop-information  End >>>
            1179     2  pp   4v                  vtr (:) = vr_fac ! ifs_2016: 4.0
            1180     2                       else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.01, ITR: 64, MVE: 4, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vtr, qr, den
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 32
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1181     3  pp    v                  do k = ktop, kbot
            1182     3   p    v                      qden = qr (k) * den (k)
            1183     4   p    v                      if (qr (k) < thr) then
            1184     4   p    v                          vtr (k) = vr_min
            1185     4   p    v                      else
            1186     4   p    v                          vtr (k) = vr_fac * vconr * sqrt (min (10., sfcrho / den (k))) * &
            1187     4                                       exp (0.2 * log (qden / normr))
            1188     4   p    v                          vtr (k) = min (vr_max, max (vr_min, vtr (k)))
            1189     4   p    v                      endif
            1190     3   p    v                  enddo
            1191     2                       endif
            1192     1               
            1193     1                       ze (kbot + 1) = zs
                                   <<< Loop-information Start >>>

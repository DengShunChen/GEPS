            3657                     
            3658                     end subroutine setup_con
            3659                     
            3660                     ! =======================================================================
            3661                     !>@brief The function 'acr3d' is an accretion function (lin et al. 1983)
            3662                     ! =======================================================================
            3663                     
            3664                     real function acr3d (v1, v2, q1, q2, c, cac, rho)
            3665                     
            3666                         implicit none
            3667                     
            3668                         real, intent (in) :: v1, v2, c, rho
            3669                         real, intent (in) :: q1, q2 ! mixing ratio!!!
            3670                         real, intent (in) :: cac (3)
            3671                     
            3672                         real :: t1, s1, s2
            3673                     
            3674                         ! integer :: k
            3675                         !
            3676                         ! real :: a
            3677                         !
            3678                         ! a = 0.0
            3679                         ! do k = 1, 3
            3680                         ! a = a + cac (k) * ((q1 * rho) ** ((7 - k) * 0.25) * (q2 * rho) ** (k * 0.25))
            3681                         ! enddo
            3682                         ! acr3d = c * abs (v1 - v2) * a / rho
            3683                     
            3684                         ! optimized
            3685                     
            3686                         t1 = sqrt (q1 * rho)
            3687                         s1 = sqrt (q2 * rho)
            3688                         s2 = sqrt (s1) ! s1 = s2 ** 2
            3689                         acr3d = c * abs (v1 - v2) * q1 * s2 * (cac (1) * t1 + cac (2) * sqrt (t1) * s2 + cac (3) * s1)
            3690                     
            3691                     end function acr3d
            3692                     
            3693                     ! =======================================================================
            3694                     !> melting of snow function (lin et al. 1983)
            3695                     !  note: psacw and psacr must be calc before smlt is called
            3696                     ! =======================================================================
            3697                     
            3698                     real function smlt (tc, dqs, qsrho, psacw, psacr, c, rho, rhofac)
            3699                     
            3700                         implicit none
            3701                     
            3702                         real, intent (in) :: tc, dqs, qsrho, psacw, psacr, c (5), rho, rhofac
            3703                     
            3704                         smlt = (c (1) * tc / rho - c (2) * dqs) * (c (3) * sqrt (qsrho) + &
            3705                             c (4) * qsrho ** 0.65625 * sqrt (rhofac)) + c (5) * tc * (psacw + psacr)
            3706                     
            3707                     end function smlt
            3708                     
            3709                     ! =======================================================================
            3710                     !> melting of graupel function (lin et al. 1983)
            3711                     !  note: pgacw and pgacr must be calc before gmlt is called
            3712                     ! =======================================================================
            3713                     
            3714                     real function gmlt (tc, dqs, qgrho, pgacw, pgacr, c, rho)
            3715                     
            3716                         implicit none
            3717                     
            3718                         real, intent (in) :: tc, dqs, qgrho, pgacw, pgacr, c (5), rho
            3719                     
            3720                         gmlt = (c (1) * tc / rho - c (2) * dqs) * (c (3) * sqrt (qgrho) + &
            3721                             c (4) * qgrho ** 0.6875 / rho ** 0.25) + c (5) * tc * (pgacw + pgacr)
            3722                     
            3723                     end function gmlt
            3724                     
            3725                     ! =======================================================================
            3726                     ! initialization
            3727                     ! prepare saturation water vapor pressure tables
            3728                     ! =======================================================================
            3729                     !>@brief The subroutine 'qsmith_init' initializes lookup tables for saturation
            3730                     !! water vapor pressure for the following utility routines that are designed
            3731                     !! to return qs consistent with the assumptions in FV3.
            3732                     !>@details The calculations are highly accurate values based on the Clausius-Clapeyron
            3733                     !! equation.
            3734                     ! =======================================================================
            3735                     subroutine qsmith_init
            3736                     
            3737                         implicit none
            3738                     
            3739                         integer, parameter :: length = 2621
            3740                     
            3741                         integer :: i
            3742                     
            3743     1                   if (.not. tables_are_initialized) then
            3744     1               
            3745     1                       ! master = (mpp_pe () .eq. mpp_root_pe ())
            3746     1                       ! if (master) print *, ' gfdl mp: initializing qs tables'
            3747     1               
            3748     1                       ! debug code
            3749     1                       ! print *, mpp_pe (), allocated (table), allocated (table2), &
            3750     1                       ! allocated (table3), allocated (tablew), allocated (des), &
            3751     1                       ! allocated (des2), allocated (des3), allocated (desw)
            3752     1                       ! end debug code
            3753     1               
            3754     1                       ! generate es table (dt = 0.1 deg. c)
            3755     1               
            3756     1                       allocate (table (length))
            3757     1                       allocate (table2 (length))
            3758     1                       allocate (table3 (length))
            3759     1                       allocate (tablew (length))
            3760     1                       allocate (des (length))
            3761     1                       allocate (des2 (length))
            3762     1                       allocate (des3 (length))
            3763     1                       allocate (desw (length))
            3764     1               
            3765     1                       call qs_table (length)
            3766     1                       call qs_table2 (length)
            3767     1                       call qs_table3 (length)
            3768     1    i                  call qs_tablew (length)
            3769     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 189
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.62, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table3, table2, table, tablew, des, des3
                                   <<<      desw, des2
                                   <<< Loop-information  End >>>
            3770     2  pp    v              do i = 1, length - 1
            3771     2   p    v                  des (i) = max (0., table (i + 1) - table (i))
            3772     2   p    v                  des2 (i) = max (0., table2 (i + 1) - table2 (i))
            3773     2   p    v                  des3 (i) = max (0., table3 (i + 1) - table3 (i))
            3774     2   p    v                  desw (i) = max (0., tablew (i + 1) - tablew (i))
            3775     2   p    v              enddo
            3776     1                       des (length) = des (length - 1)
            3777     1                       des2 (length) = des2 (length - 1)
            3778     1                       des3 (length) = des3 (length - 1)
            3779     1                       desw (length) = desw (length - 1)
            3780     1               
            3781     1                       tables_are_initialized = .true.
            3782     1               
            3783     1                   endif
            3784                     
            3785                     end subroutine qsmith_init
            3786                     
            3787                     ! =======================================================================
            3788                     ! compute the saturated specific humidity for table ii
            3789                     !>@brief The function 'wqs1' returns the saturation vapor pressure over pure
            3790                     !! liquid water for a given temperature and air density.
            3791                     ! =======================================================================
            3792                     
            3793                     real function wqs1 (ta, den)
            3794                     
            3795                         implicit none
            3796                     
            3797                         !> pure water phase; universal dry / moist formular using air density
            3798                         !> input "den" can be either dry or moist air density
            3799                     
            3800                         real, intent (in) :: ta, den
            3801                     
            3802                         real :: es, ap1, tmin
            3803                     
            3804                         integer :: it
            3805                     
            3806                         tmin = table_ice - 160.
            3807                         ap1 = 10. * dim (ta, tmin) + 1.
            3808                         ap1 = min (2621., ap1)
            3809                         it = ap1
            3810                         es = tablew (it) + (ap1 - it) * desw (it)
            3811                         wqs1 = es / (rvgas * ta * den)
            3812                     
            3813                     end function wqs1
            3814                     
            3815                     ! =======================================================================
            3816                     ! compute the gradient of saturated specific humidity for table ii
            3817                     !>@brief The function 'wqs2' returns the saturation vapor pressure over pure
            3818                     !! liquid water for a given temperature and air density, as well as the
            3819                     !! analytic dqs/dT: rate of change of saturation vapor pressure WRT temperature.
            3820                     ! =======================================================================
            3821                     
            3822                     real function wqs2 (ta, den, dqdt)
            3823                     
            3824                         implicit none
            3825                     
            3826                         !> pure water phase; universal dry / moist formular using air density
            3827                         !> input "den" can be either dry or moist air density
            3828                     
            3829                         real, intent (in) :: ta, den
            3830                     
            3831                         real, intent (out) :: dqdt
            3832                     
            3833                         real :: es, ap1, tmin
            3834                     
            3835                         integer :: it
            3836                     
            3837                         tmin = table_ice - 160.
            3838                     
            3839                         if (.not. tables_are_initialized) call qsmith_init
            3840                     
            3841                         ap1 = 10. * dim (ta, tmin) + 1.
            3842                         ap1 = min (2621., ap1)
            3843                         it = ap1
            3844                         es = tablew (it) + (ap1 - it) * desw (it)
            3845                         wqs2 = es / (rvgas * ta * den)
            3846                         it = ap1 - 0.5
            3847                         ! finite diff, del_t = 0.1:
            3848                         dqdt = 10. * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) / (rvgas * ta * den)
            3849                     
            3850                     end function wqs2
            3851                     
            3852                     ! =======================================================================
            3853                     ! compute wet buld temperature
            3854                     !>@brief The function 'wet_bulb' uses 'wqs2' to compute the wet-bulb temperature
            3855                     !! from the mixing ratio and the temperature.
            3856                     ! =======================================================================
            3857                     
            3858                     real function wet_bulb (q, t, den)
            3859                     
            3860                         implicit none
            3861                     
            3862                         real, intent (in) :: t, q, den
            3863                     
            3864                         real :: qs, tp, dqdt
            3865                     
            3866                         wet_bulb = t
            3867          i              qs = wqs2 (wet_bulb, den, dqdt)
            3868                         tp = 0.5 * (qs - q) / (1. + lcp * dqdt) * lcp
            3869                         wet_bulb = wet_bulb - tp
            3870                     
            3871                         ! tp is negative if super - saturated
            3872     1                   if (tp > 0.01) then
            3873     1    i                  qs = wqs2 (wet_bulb, den, dqdt)
            3874     1                       tp = (qs - q) / (1. + lcp * dqdt) * lcp
            3875     1                       wet_bulb = wet_bulb - tp
            3876     1                   endif
            3877                     
            3878                     end function wet_bulb
            3879                     
            3880                     ! =======================================================================
            3881                     !>@brief The function 'iqs1' computes the saturated specific humidity
            3882                     !! for table iii
            3883                     ! =======================================================================
            3884                     
            3885                     real function iqs1 (ta, den)
            3886                     
            3887                         implicit none
            3888                     
            3889                         !> water - ice phase; universal dry / moist formular using air density
            3890                         !> input "den" can be either dry or moist air density
            3891                     
            3892                         real, intent (in) :: ta, den
            3893                     
            3894                         real :: es, ap1, tmin
            3895                     
            3896                         integer :: it
            3897                     
            3898                         tmin = table_ice - 160.
            3899                         ap1 = 10. * dim (ta, tmin) + 1.
            3900                         ap1 = min (2621., ap1)
            3901                         it = ap1
            3902                         es = table2 (it) + (ap1 - it) * des2 (it)
            3903                         iqs1 = es / (rvgas * ta * den)
            3904                     
            3905                     end function iqs1
            3906                     
            3907                     ! =======================================================================
            3908                     !>@brief The function 'iqs2' computes the gradient of saturated specific
            3909                     !! humidity for table iii
            3910                     ! =======================================================================
            3911                     
            3912                     real function iqs2 (ta, den, dqdt)
            3913                     
            3914                         implicit none
            3915                     
            3916                         !> water - ice phase; universal dry / moist formular using air density
            3917                         !> input "den" can be either dry or moist air density
            3918                     
            3919                         real, intent (in) :: ta, den
            3920                     
            3921                         real, intent (out) :: dqdt
            3922                     
            3923                         real :: es, ap1, tmin
            3924                     
            3925                         integer :: it
            3926                     
            3927                         tmin = table_ice - 160.
            3928                         ap1 = 10. * dim (ta, tmin) + 1.
            3929                         ap1 = min (2621., ap1)
            3930                         it = ap1
            3931                         es = table2 (it) + (ap1 - it) * des2 (it)
            3932                         iqs2 = es / (rvgas * ta * den)
            3933                         it = ap1 - 0.5
            3934                         dqdt = 10. * (des2 (it) + (ap1 - it) * (des2 (it + 1) - des2 (it))) / (rvgas * ta * den)
            3935                     
            3936                     end function iqs2
            3937                     
            3938                     ! =======================================================================
            3939                     !>@brief The function 'qs1d_moist' computes the gradient of saturated
            3940                     !! specific humidity for table iii.
            3941                     ! =======================================================================
            3942                     
            3943                     real function qs1d_moist (ta, qv, pa, dqdt)
            3944                     
            3945                         implicit none
            3946                     
            3947                         real, intent (in) :: ta, pa, qv
            3948                     
            3949                         real, intent (out) :: dqdt
            3950                     
            3951                         real :: es, ap1, tmin, eps10
            3952                     
            3953                         integer :: it
            3954                     
            3955                         tmin = table_ice - 160.
            3956                         eps10 = 10. * eps
            3957                         ap1 = 10. * dim (ta, tmin) + 1.
            3958                         ap1 = min (2621., ap1)
            3959                         it = ap1
            3960                         es = table2 (it) + (ap1 - it) * des2 (it)
            3961                         qs1d_moist = eps * es * (1. + zvir * qv) / pa
            3962                         it = ap1 - 0.5
            3963                         dqdt = eps10 * (des2 (it) + (ap1 - it) * (des2 (it + 1) - des2 (it))) * (1. + zvir * qv) / pa
            3964                     
            3965                     end function qs1d_moist
            3966                     
            3967                     ! =======================================================================
            3968                     ! compute the gradient of saturated specific humidity for table ii
            3969                     !>@brief The function 'wqsat2_moist' computes the saturated specific humidity
            3970                     !! for pure liquid water , as well as des/dT.
            3971                     ! =======================================================================
            3972                     
            3973                     real function wqsat2_moist (ta, qv, pa, dqdt)
            3974                     
            3975                         implicit none
            3976                     
            3977                         real, intent (in) :: ta, pa, qv
            3978                     
            3979                         real, intent (out) :: dqdt
            3980                     
            3981                         real :: es, ap1, tmin, eps10
            3982                     
            3983                         integer :: it
            3984                     
            3985                         tmin = table_ice - 160.
            3986                         eps10 = 10. * eps
            3987                         ap1 = 10. * dim (ta, tmin) + 1.
            3988                         ap1 = min (2621., ap1)
            3989                         it = ap1
            3990                         es = tablew (it) + (ap1 - it) * desw (it)
            3991                         wqsat2_moist = eps * es * (1. + zvir * qv) / pa
            3992                         it = ap1 - 0.5
            3993                         dqdt = eps10 * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) * (1. + zvir * qv) / pa
            3994                     
            3995                     end function wqsat2_moist
            3996                     
            3997                     ! =======================================================================
            3998                     ! compute the saturated specific humidity for table ii
            3999                     !>@brief The function 'wqsat_moist' computes the saturated specific humidity
            4000                     !! for pure liquid water.
            4001                     ! =======================================================================
            4002                     
            4003                     real function wqsat_moist (ta, qv, pa)
            4004                     
            4005                         implicit none
            4006                     
            4007                         real, intent (in) :: ta, pa, qv
            4008                     
            4009                         real :: es, ap1, tmin
            4010                     
            4011                         integer :: it
            4012                     
            4013                         tmin = table_ice - 160.
            4014                         ap1 = 10. * dim (ta, tmin) + 1.
            4015                         ap1 = min (2621., ap1)
            4016                         it = ap1
            4017                         es = tablew (it) + (ap1 - it) * desw (it)
            4018                         wqsat_moist = eps * es * (1. + zvir * qv) / pa
            4019                     
            4020                     end function wqsat_moist
            4021                     
            4022                     ! =======================================================================
            4023                     !>@brief The function 'qs1d_m' computes the saturated specific humidity
            4024                     !! for table iii

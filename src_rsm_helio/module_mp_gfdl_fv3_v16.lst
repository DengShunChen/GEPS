            1129                     
            1130                         real, intent (in), dimension (ktop:kbot) :: dp, dz, den
            1131                         real, intent (in), dimension (ktop:kbot) :: denfac, ccn, c_praut
            1132                     
            1133                         real, intent (inout), dimension (ktop:kbot) :: tz, vtr
            1134                         real, intent (inout), dimension (ktop:kbot) :: qv, ql, qr, qi, qs, qg
            1135                         real, intent (inout), dimension (ktop:kbot) :: m1_rain, w1
            1136                     
            1137                         real, intent (out) :: r1
            1138                     

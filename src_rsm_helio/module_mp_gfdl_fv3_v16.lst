            1153                         real, parameter :: vconr = 2503.23638966667
            1154                         real, parameter :: normr = 25132741228.7183
            1155                         real, parameter :: thr = 1.e-8
            1156                     
            1157                         logical :: no_fall
            1158                     
            1159                         dt5 = 0.5 * dt

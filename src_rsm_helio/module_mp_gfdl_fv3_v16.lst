            1330                     
            1331                     ! -----------------------------------------------------------------------
            1332                     !> evaporation of rain
            1333                     ! -----------------------------------------------------------------------
            1334                     
            1335                     subroutine revap_racc (ktop, kbot, dt, tz, qv, ql, qr, qi, qs, qg, den, denfac, rh_rain, h_var)
            1336                     
            1337                         implicit none
            1338                     
            1339                         integer, intent (in) :: ktop, kbot
            1340                     
            1341                         real, intent (in) :: dt ! time step (s)
            1342                         real, intent (in) :: rh_rain, h_var
            1343                     
            1344                         real, intent (in), dimension (ktop:kbot) :: den, denfac
            1345                     
            1346                         real, intent (inout), dimension (ktop:kbot) :: tz, qv, qr, ql, qi, qs, qg
            1347                     
            1348                         real, dimension (ktop:kbot) :: lhl, cvm, q_liq, q_sol, lcpk
            1349                     
            1350                         real :: dqv, qsat, dqsdt, evap, t2, qden, q_plus, q_minus, sink
            1351                         real :: qpz, dq, dqh, tin
            1352                     
            1353                         integer :: k
            1354                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 10
                                   <<<      SIMD&FP   : SPILL 2  FILL 5
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1355     1                   do k = ktop, kbot
            1356     1               
            1357     2                       if (tz (k) > t_wfr .and. qr (k) > qrmin) then
            1358     2               
            1359     2                           ! -----------------------------------------------------------------------
            1360     2                           ! define heat capacity and latent heat coefficient
            1361     2                           ! -----------------------------------------------------------------------
            1362     2               
            1363     2                           lhl (k) = lv00 + d0_vap * tz (k)
            1364     2                           q_liq (k) = ql (k) + qr (k)
            1365     2                           q_sol (k) = qi (k) + qs (k) + qg (k)
            1366     2                           cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1367     2                           lcpk (k) = lhl (k) / cvm (k)
            1368     2               
            1369     2                           tin = tz (k) - lcpk (k) * ql (k) ! presence of clouds suppresses the rain evap
            1370     2                           qpz = qv (k) + ql (k)
            1371     2    i                      qsat = wqs2 (tin, den (k), dqsdt)
            1372     2                           dqh = max (ql (k), h_var * max (qpz, qcmin))
            1373     2                           dqh = min (dqh, 0.2 * qpz) ! new limiter
            1374     2                           dqv = qsat - qv (k) ! use this to prevent super - sat the gird box
            1375     2                           q_minus = qpz - dqh
            1376     2                           q_plus = qpz + dqh
            1377     2               
            1378     2                           ! -----------------------------------------------------------------------
            1379     2                           ! qsat must be > q_minus to activate evaporation
            1380     2                           ! qsat must be < q_plus to activate accretion
            1381     2                           ! -----------------------------------------------------------------------
            1382     2               
            1383     2                           ! -----------------------------------------------------------------------
            1384     2                           ! rain evaporation
            1385     2                           ! -----------------------------------------------------------------------
            1386     2               
            1387     3                           if (dqv > qvmin .and. qsat > q_minus) then
            1388     4                               if (qsat > q_plus) then
            1389     4                                   dq = qsat - qpz
            1390     4                               else
            1391     4                                   ! -----------------------------------------------------------------------
            1392     4                                   ! q_minus < qsat < q_plus
            1393     4                                   ! dq == dqh if qsat == q_minus
            1394     4                                   ! -----------------------------------------------------------------------
            1395     4                                   dq = 0.25 * (q_minus - qsat) ** 2 / dqh
            1396     4                               endif
            1397     3                               qden = qr (k) * den (k)
            1398     3                               t2 = tin * tin
            1399     3                               evap = crevp (1) * t2 * dq * (crevp (2) * sqrt (qden) + crevp (3) * &
            1400     3                                   exp (0.725 * log (qden))) / (crevp (4) * t2 + crevp (5) * qsat * den (k))
            1401     3                               evap = min (qr (k), dt * evap, dqv / (1. + lcpk (k) * dqsdt))
            1402     3                               ! -----------------------------------------------------------------------
            1403     3                               ! alternative minimum evap in dry environmental air
            1404     3                               ! sink = min (qr (k), dim (rh_rain * qsat, qv (k)) / (1. + lcpk (k) * dqsdt))
            1405     3                               ! evap = max (evap, sink)
            1406     3                               ! -----------------------------------------------------------------------
            1407     3                               qr (k) = qr (k) - evap
            1408     3                               qv (k) = qv (k) + evap
            1409     3                               q_liq (k) = q_liq (k) - evap
            1410     3                               cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1411     3                               tz (k) = tz (k) - evap * lhl (k) / cvm (k)
            1412     3                           endif
            1413     2               
            1414     2                           ! -----------------------------------------------------------------------
            1415     2                           ! accretion: pracc
            1416     2                           ! -----------------------------------------------------------------------
            1417     2               
            1418     2                           ! if (qr (k) > qrmin .and. ql (k) > 1.e-7 .and. qsat < q_plus) then
            1419     3                           if (qr (k) > qrmin .and. ql (k) > 1.e-6 .and. qsat < q_minus) then
            1420     3                               sink = dt * denfac (k) * cracw * exp (0.95 * log (qr (k) * den (k)))
            1421     3                               sink = sink / (1. + sink) * ql (k)
            1422     3                               ql (k) = ql (k) - sink
            1423     3                               qr (k) = qr (k) + sink
            1424     3                           endif
            1425     2               
            1426     2                       endif ! warm - rain
            1427     1                   enddo
            1428                     
            1429                     end subroutine revap_racc
            1430                     
            1431                     ! -----------------------------------------------------------------------
            1432                     !> definition of vertical subgrid variability
            1433                     !! used for cloud ice and cloud water autoconversion
            1434                     !! qi -- > ql & ql -- > qr
            1435                     !! edges: qe == qbar + / - dm
            1436                     ! -----------------------------------------------------------------------
            1437                     
            1438                     subroutine linear_prof (km, q, dm, z_var, h_var)
            1439                     
            1440                         implicit none
            1441                     
            1442                         integer, intent (in) :: km
            1443                     
            1444                         real, intent (in) :: q (km), h_var
            1445                     
            1446                         real, intent (out) :: dm (km)
            1447                     
            1448                         logical, intent (in) :: z_var
            1449                     
            1450                         real :: dq (km)
            1451                     
            1452                         integer :: k
            1453                     
            1454     1                   if (z_var) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, dq
                                   <<< Loop-information  End >>>
            1455     2  pp   2v              do k = 2, km
            1456     2   p   2v                  dq (k) = 0.5 * (q (k) - q (k - 1))
            1457     2   p   2v              enddo
            1458     1                       dm (1) = 0.
            1459     1               
            1460     1                       ! -----------------------------------------------------------------------
            1461     1                       ! use twice the strength of the positive definiteness limiter (lin et al 1994)
            1462     1                       ! -----------------------------------------------------------------------
            1463     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 88, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dq, dm, q
                                   <<< Loop-information  End >>>
            1464     2  pp    v              do k = 2, km - 1
            1465     2   p    v                  dm (k) = 0.5 * min (abs (dq (k) + dq (k + 1)), 0.5 * q (k))
            1466     3   p    v                  if (dq (k) * dq (k + 1) <= 0.) then
            1467     4   p    v                      if (dq (k) > 0.) then ! local max
            1468     4   p    v                          dm (k) = min (dm (k), dq (k), - dq (k + 1))
            1469     4   p    v                      else
            1470     4   p    v                          dm (k) = 0.
            1471     4   p    v                      endif
            1472     3   p    v                  endif
            1473     2   p    v              enddo
            1474     1                       dm (km) = 0.
            1475     1               
            1476     1                       ! -----------------------------------------------------------------------
            1477     1                       ! impose a presumed background horizontal variability that is proportional to the value itself
            1478     1                       ! -----------------------------------------------------------------------
            1479     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.20, ITR: 160, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dm, q
                                   <<< Loop-information  End >>>
            1480     2  pp   2v              do k = 1, km
            1481     2   p   2v                  dm (k) = max (dm (k), qvmin, h_var * q (k))
            1482     2   p   2v              enddo
            1483     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 4.00, ITR: 208, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, dm
                                   <<< Loop-information  End >>>
            1484     2  pp   2v              do k = 1, km
            1485     2   p   2v                  dm (k) = max (qvmin, h_var * q (k))
            1486     2   p   2v              enddo
            1487     1                   endif
            1488                     
            1489                     end subroutine linear_prof
            1490                     
            1491                     ! =======================================================================
            1492                     !> ice cloud microphysics processes
            1493                     !! bulk cloud micro - physics; processes splitting
            1494                     !! with some un - split sub - grouping
            1495                     !! time implicit (when possible) accretion and autoconversion
            1496                     !>@author: Shian-Jiann lin, gfdl
            1497                     ! =======================================================================
            1498                     
            1499                     subroutine icloud (ktop, kbot, tzk, p1, qvk, qlk, qrk, qik, qsk, qgk, dp1, &
            1500                             den, denfac, vts, vtg, vtr, qak, rh_adj, rh_rain, dts, h_var)
            1501                     
            1502                         implicit none
            1503                     
            1504                         integer, intent (in) :: ktop, kbot
            1505                     
            1506                         real, intent (in), dimension (ktop:kbot) :: p1, dp1, den, denfac, vts, vtg, vtr
            1507                     
            1508                         real, intent (inout), dimension (ktop:kbot) :: tzk, qvk, qlk, qrk, qik, qsk, qgk, qak
            1509                     
            1510                         real, intent (in) :: rh_adj, rh_rain, dts, h_var
            1511                     
            1512                         real, dimension (ktop:kbot) :: lcpk, icpk, tcpk, di, lhl, lhi
            1513                         real, dimension (ktop:kbot) :: cvm, q_liq, q_sol
            1514                     
            1515                         real :: rdts, fac_g2v, fac_v2g, fac_i2s, fac_imlt
            1516                         real :: tz, qv, ql, qr, qi, qs, qg, melt
            1517                         real :: pracs, psacw, pgacw, psacr, pgacr, pgaci, praci, psaci
            1518                         real :: pgmlt, psmlt, pgfr, pgaut, psaut, pgsub
            1519                         real :: tc, tsq, dqs0, qden, qim, qsm
            1520                         real :: dt5, factor, sink, qi_crt
            1521                         real :: tmp, qsw, qsi, dqsdt, dq
            1522                         real :: dtmp, qc, q_plus, q_minus
            1523                     
            1524                         integer :: k
            1525                     
            1526                         dt5 = 0.5 * dts
            1527                     
            1528                         rdts = 1. / dts
            1529                     
            1530                         ! -----------------------------------------------------------------------
            1531                         ! define conversion scalar / factor
            1532                         ! -----------------------------------------------------------------------
            1533                     
            1534                         fac_i2s = 1. - exp (- dts / tau_i2s)
            1535                         fac_g2v = 1. - exp (- dts / tau_g2v)
            1536                         fac_v2g = 1. - exp (- dts / tau_v2g)
            1537                     
            1538                         fac_imlt = 1. - exp (- dt5 / tau_imlt)
            1539                     
            1540                         ! -----------------------------------------------------------------------
            1541                         ! define heat capacity and latend heat coefficient
            1542                         ! -----------------------------------------------------------------------
            1543                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 72
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1544,1559)
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qlk, qrk, qvk, qik, qsk, qgk, tzk, q_liq
                                   <<<      lhi, q_sol, cvm, icpk, den
                                   <<< Loop-information  End >>>
            1544     1  pp    v          do k = ktop, kbot
            1545     1   p    v              lhi (k) = li00 + dc_ice * tzk (k)
            1546     1   p    v              q_liq (k) = qlk (k) + qrk (k)
            1547     1   p    v              q_sol (k) = qik (k) + qsk (k) + qgk (k)
            1548     1   p    v              cvm (k) = c_air + qvk (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1549     1   p    v              icpk (k) = lhi (k) / cvm (k)
            1550     1   p    v          enddo
            1551                     
            1552                         ! -----------------------------------------------------------------------
            1553                         ! sources of cloud ice: pihom, cold rain, and the sat_adj
            1554                         ! (initiation plus deposition)
            1555                         ! sources of snow: cold rain, auto conversion + accretion (from cloud ice)
            1556                         ! sat_adj (deposition; requires pre - existing snow) ; initial snow comes from auto conversion
            1557                         ! -----------------------------------------------------------------------
            1558                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1559     1                   do k = ktop, kbot
            1560     2                       if (tzk (k) > tice .and. qik (k) > qcmin) then
            1561     2               
            1562     2                           ! -----------------------------------------------------------------------
            1563     2                           ! pimlt: instant melting of cloud ice
            1564     2                           ! -----------------------------------------------------------------------
            1565     2               
            1566     2                           melt = min (qik (k), fac_imlt * (tzk (k) - tice) / icpk (k))
            1567     2                           tmp = min (melt, dim (ql_mlt, qlk (k))) ! max ql amount
            1568     2                           qlk (k) = qlk (k) + tmp
            1569     2                           qrk (k) = qrk (k) + melt - tmp
            1570     2                           qik (k) = qik (k) - melt
            1571     2                           q_liq (k) = q_liq (k) + melt
            1572     2                           q_sol (k) = q_sol (k) - melt
            1573     2                           cvm (k) = c_air + qvk (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1574     2                           tzk (k) = tzk (k) - melt * lhi (k) / cvm (k)
            1575     2               
            1576     2                       elseif (tzk (k) < t_wfr .and. qlk (k) > qcmin) then
            1577     2               
            1578     2                           ! -----------------------------------------------------------------------
            1579     2                           ! pihom: homogeneous freezing of cloud water into cloud ice
            1580     2                           ! this is the 1st occurance of liquid water freezing in the split mp process
            1581     2                           ! -----------------------------------------------------------------------
            1582     2               
            1583     2                           dtmp = t_wfr - tzk (k)
            1584     2                           factor = min (1., dtmp / dt_fr)
            1585     2                           sink = min (qlk (k) * factor, dtmp / icpk (k))
            1586     2                           qi_crt = qi_gen * min (qi_lim, 0.1 * (tice - tzk (k))) / den (k)
            1587     2                           tmp = min (sink, dim (qi_crt, qik (k)))
            1588     2                           qlk (k) = qlk (k) - sink
            1589     2                           qsk (k) = qsk (k) + sink - tmp
            1590     2                           qik (k) = qik (k) + tmp
            1591     2                           q_liq (k) = q_liq (k) - sink
            1592     2                           q_sol (k) = q_sol (k) + sink
            1593     2                           cvm (k) = c_air + qvk (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1594     2                           tzk (k) = tzk (k) + sink * lhi (k) / cvm (k)
            1595     2               
            1596     2                       endif
            1597     1                   enddo
            1598                     
            1599                         ! -----------------------------------------------------------------------
            1600                         ! vertical subgrid variability
            1601                         ! -----------------------------------------------------------------------
            1602                     
            1603                         call linear_prof (kbot - ktop + 1, qik (ktop), di (ktop), z_slope_ice, h_var)
            1604                     
            1605                         ! -----------------------------------------------------------------------
            1606                         ! update capacity heat and latend heat coefficient
            1607                         ! -----------------------------------------------------------------------
            1608                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 422
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tzk, cvm, icpk, lhi, tcpk, lcpk, lhl
                                   <<< Loop-information  End >>>
            1609     1  pp    v          do k = ktop, kbot
            1610     1   p    v              lhl (k) = lv00 + d0_vap * tzk (k)
            1611     1   p    v              lhi (k) = li00 + dc_ice * tzk (k)
            1612     1   p    v              lcpk (k) = lhl (k) / cvm (k)
            1613     1   p    v              icpk (k) = lhi (k) / cvm (k)
            1614     1   p    v              tcpk (k) = lcpk (k) + icpk (k)
            1615     1   p    v          enddo
            1616                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

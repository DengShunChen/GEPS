            1269     2  pp    v              do k = ktop, kbot
            1270     2   p    v                  qc0 = fac_rc * ccn (k)
            1271     3   p    v                  if (tz (k) > t_wfr) then
            1272     4   p    v                      if (use_ccn) then
            1273     4                                   ! -----------------------------------------------------------------------
            1274     4                                   ! ccn is formulted as ccn = ccn_surface * (den / den_surface)
            1275     4                                   ! -----------------------------------------------------------------------
            1276     4                                   qc = qc0
            1277     4   p    v                      else
            1278     4   p    v                          qc = qc0 / den (k)
            1279     4   p    v                      endif
            1280     3   p    v                      dq = ql (k) - qc
            1281     4   p    v                      if (dq > 0.) then
            1282     4   p    v                          sink = min (dq, dt * c_praut (k) * den (k) * exp (so3 * log (ql (k))))
            1283     4   p    v                          ql (k) = ql (k) - sink
            1284     4   p    v                          qr (k) = qr (k) + sink
            1285     4   p    v                      endif
            1286     3   p    v                  endif
            1287     2   p    v              enddo
            1288     1               
            1289     1                   else
            1290     1               

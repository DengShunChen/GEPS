 External subroutine subprogram "setupv"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine setupv (yr,yin,mn,nx,lmaxp,pjy,ipt,tp1)
               2                     !
               3                     !  setup routine for bicubv parameters.  see bicubv prolog for
               4                     !  parameter descriptions
               5                     !
               6                           use const, only: RTYPE
               7                     !
               8                           implicit  none
               9                           integer   mn,nx,lmaxp,ipt(mn)
              10                           real(kind=RTYPE) yin(mn),yr(nx,lmaxp),pjy(mn,4),tp1(mn,4)
              11                     
              12                           integer   n,i,j,k,ii,ix
              13                           real      eps
              14                     !
              15                           n= mn/nx
              16                     !
              17                     !  check out of bounds to ensure interpolation
              18                     !
              19                           eps = 1.0e-5
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.54, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      yin
                                   <<< Loop-information  End >>>
              20     1  pp    v            do 100 i = 1, mn
              21     1   p    v            ix = i - ((i-1)/nx)*nx
              22     1   p    v            if ( yin(i).le.yr(ix,1) )      yin(i) = yr(ix,1) + eps
              23     1   p    v            if ( yin(i).ge.yr(ix,lmaxp) )  yin(i) = yr(ix,lmaxp) - eps
              24     1   p    v        100 continue
              25                     !
              26     1                     do 10 i=1,nx
              27     1                     k=1
              28     2                     do 5 j=1,n
              29     2                     ii= nx*(j-1)
              30     2                   6 k= k+1
              31     2                     if(yin(i+ii).gt.yr(i,k)) go to 6
              32     2                     ipt(i+ii)= i+nx*(k-1)
              33     2                     tp1(i+ii,1)= yin(i+ii)-yr(i,k-1)
              34     2                     tp1(i+ii,2)= yr(i,k)-yr(i,k-1)
              35     2                     k= k-1
              36     2                   5 continue
              37     1                  10 continue
              38                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 400
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.56, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tp1, pjy
                                   <<< Loop-information  End >>>
              39     1  pp    v            do 90 i=1,mn
              40     1   p    v            pjy(i,3)= tp1(i,1)/tp1(i,2)
              41     1   p    v            pjy(i,4)= 1.0-pjy(i,3)
              42     1   p    v            pjy(i,1)= pjy(i,3)*pjy(i,3)-1.0
              43     1   p    v            pjy(i,2)= pjy(i,4)*pjy(i,4)-1.0
              44     1   p    v            pjy(i,1)= pjy(i,1)*tp1(i,1)*tp1(i,2)
              45     1   p    v            tp1(i,1)= tp1(i,2)-tp1(i,1)
              46     1   p    v            pjy(i,2)= pjy(i,2)*tp1(i,1)*tp1(i,2)
              47     1   p    v         90 continue
              48                     !
              49                           return
              50                           end


               1                         subroutine cududv_n(nxj,klon,klev,ktopm2,ktype,kcbot,kctop,ldcum,  &
               2                                         ztmst,paph,puen,pven,pmfu,pmfd,puu,pud,pvu,pvd,ptenu, &
               3                                         ptenv,jin)
               4                     !---------------------------------------------------------------------------
               5                       USE shr_kind_mod, only: r8 => shr_kind_r8
               6                       USE mo_constants, ONLY: g ! gravity acceleration
               7                     !---------------------------------------------------------------------------
               8                         implicit none
               9                         integer  klon,klev,ktopm2,nxj,jin
              10                         integer  ktype(klon), kcbot(klon), kctop(klon)
              11                         logical  ldcum(klon)
              12                         real     ztmst
              13                         real     paph(klon,klev+1)
              14                         real     puen(klon,klev),  pven(klon,klev),&
              15                                  pmfu(klon,klev),  pmfd(klon,klev),&
              16                                  puu(klon,klev),   pud(klon,klev),&
              17                                  pvu(klon,klev),   pvd(klon,klev)
              18                         real     ptenu(klon,klev), ptenv(klon,klev)
              19                     
              20                     !local variables
              21                         real     zuen(klon,klev) , zven(klon,klev) , zmfuu(klon,klev), &
              22                                  zmfdu(klon,klev), zmfuv(klon,klev), zmfdv(klon,klev)
              23                     
              24                         integer  ik , ikb , jk , jl
              25                         real     zzp, zdtdt
              26                     
              27                         real     zdudt(klon,klev), zdvdt(klon,klev), zdp(klon,klev)
              28                     !
              29                     !xb110>
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.22, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zdudt, zmfdv, zmfdu, zmfuv, zmfuu, zdvdt
                                   <<<      zdp, zven, zuen
                                   <<< Loop-information  End >>>
              30        pp    v          zuen = 0.
              31         p    v          zven = 0.
              32         p    v          zdp  = 0.
              33         p    v          zmfuu = 0.
              34         p    v          zmfuv = 0.
              35         p    v          zmfdu = 0.
              36         p    v          zmfdv = 0.
              37         p    v          zdudt = 0.
              38         p    v          zdvdt = 0.
              39                     !xb110<
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum, paph, puen, pven, zdp, zuen, zven
                                   <<< Loop-information  End >>>
              40     1  pp               do jk = 1 , klev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum, paph, puen, pven, zuen, zven, zdp
                                   <<< Loop-information  End >>>
              41     2   p    v             do jl = 1, nxj
              42     3   p    v              if ( ldcum(jl) ) then
              43     3   p    v                zuen(jl,jk) = puen(jl,jk)
              44     3   p    v                zven(jl,jk) = pven(jl,jk)
              45     3   p    v                zdp(jl,jk) = g/(paph(jl,jk+1)-paph(jl,jk))
              46     3   p    v              end if
              47     2   p    v            end do
              48     1   p               end do
              49                     !----------------------------------------------------------------------
              50                     !*    1.0          CALCULATE FLUXES AND UPDATE U AND V TENDENCIES
              51                     ! ----------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum, puu, zuen, pvu, pud, zven, pvd
                                   <<<      pmfu, pmfd, zmfuv, zmfdu, zmfuu, zmfdv
                                   <<< Loop-information  End >>>
              52     1  pp               do jk = ktopm2 , klev
              53     1   p                 ik = jk - 1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.80, ITR: 80, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pvd, puu, ldcum, zuen, pmfu, pvu, zven
                                   <<<      zmfuu, zmfuv, pud, pmfd, zmfdu, zmfdv
                                   <<< Loop-information  End >>>
              54     2   p    v             do jl = 1, nxj
              55     3   p    v              if ( ldcum(jl) ) then
              56     3   p    v                zmfuu(jl,jk) = pmfu(jl,jk)*(puu(jl,jk)-zuen(jl,ik))
              57     3   p    v                zmfuv(jl,jk) = pmfu(jl,jk)*(pvu(jl,jk)-zven(jl,ik))
              58     3   p    v                zmfdu(jl,jk) = pmfd(jl,jk)*(pud(jl,jk)-zuen(jl,ik))
              59     3   p    v                zmfdv(jl,jk) = pmfd(jl,jk)*(pvd(jl,jk)-zven(jl,ik))
              60     3   p    v              end if
              61     2   p    v            end do
              62     1   p               end do
              63                         ! linear fluxes below cloud
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum, kcbot, paph, ktype, zmfuu, zmfuv
                                   <<<      zmfdu, zmfdv
                                   <<< Loop-information  End >>>
              64     1                     do jk = ktopm2 , klev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 223
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.02, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ktype, ldcum, paph, kcbot, zmfuu, zmfuv
                                   <<<      zmfdu, zmfdv
                                   <<< Loop-information  End >>>
              65     2  pp    v             do jl = 1, nxj
              66     3   p    v                if ( ldcum(jl) .and. jk > kcbot(jl) ) then
              67     3   p    v                  ikb = kcbot(jl)
              68     3   p    v                  zzp = ((paph(jl,klev+1)-paph(jl,jk))/(paph(jl,klev+1)-paph(jl,ikb)))
              69     3   p    v                  if ( ktype(jl) == 3 ) zzp = zzp*zzp
              70     3   p    v                  zmfuu(jl,jk) = zmfuu(jl,ikb)*zzp
              71     3   p    v                  zmfuv(jl,jk) = zmfuv(jl,ikb)*zzp
              72     3   p    v                  zmfdu(jl,jk) = zmfdu(jl,ikb)*zzp
              73     3   p    v                  zmfdv(jl,jk) = zmfdv(jl,ikb)*zzp
              74     3   p    v                end if
              75     2   p    v              end do
              76     1                     end do
              77                     !----------------------------------------------------------------------
              78                     !*    2.0          COMPUTE TENDENCIES
              79                     ! ------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum, zmfdv, zmfuv, zmfdu, zmfuu, zdp
                                   <<<      zdudt, zdvdt
                                   <<< Loop-information  End >>>
              80     1  pp               do jk = ktopm2 , klev
              81     2   p                 if ( jk < klev ) then
              82     2   p                   ik = jk + 1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 96, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zmfdv, zmfuv, ldcum, zmfdu, zmfuu, zdp
                                   <<<      zdudt, zdvdt
                                   <<< Loop-information  End >>>
              83     3   p    v             do jl = 1, nxj
              84     4   p    v                if ( ldcum(jl) ) then
              85     4   p    v                  zdudt(jl,jk) = zdp(jl,jk) * &
              86     4                       &                  (zmfuu(jl,ik)-zmfuu(jl,jk)+zmfdu(jl,ik)-zmfdu(jl,jk))
              87     4   p    v                  zdvdt(jl,jk) = zdp(jl,jk) * &
              88     4                       &                  (zmfuv(jl,ik)-zmfuv(jl,jk)+zmfdv(jl,ik)-zmfdv(jl,jk))
              89     4   p    v                end if
              90     3   p    v              end do
              91     2   p                 else
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 96, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zmfdu, zdp, zmfuv, zmfdv, ldcum, zmfuu
                                   <<<      zdudt, zdvdt
                                   <<< Loop-information  End >>>
              92     3   p    v             do jl = 1, nxj
              93     4   p    v                if ( ldcum(jl) ) then
              94     4   p    v                  zdudt(jl,jk) = -zdp(jl,jk)*(zmfuu(jl,jk)+zmfdu(jl,jk))
              95     4   p    v                  zdvdt(jl,jk) = -zdp(jl,jk)*(zmfuv(jl,jk)+zmfdv(jl,jk))
              96     4   p    v                end if
              97     3   p    v              end do
              98     2   p                 end if
              99     1   p               end do
             100                     !---------------------------------------------------------------------
             101                     !*  3.0        UPDATE TENDENCIES
             102                     !   -----------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum, ptenu, zdudt, ptenv, zdvdt
                                   <<< Loop-information  End >>>
             103     1  pp               do jk = ktopm2 , klev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 88, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum, ptenu, zdudt, ptenv, zdvdt
                                   <<< Loop-information  End >>>
             104     2   p    v             do jl = 1, nxj
             105     3   p    v              if ( ldcum(jl) ) then
             106     3   p    v                ptenu(jl,jk) = ptenu(jl,jk) + zdudt(jl,jk)
             107     3   p    v                ptenv(jl,jk) = ptenv(jl,jk) + zdvdt(jl,jk)
             108     3   p    v              end if
             109     2   p    v            end do
             110     1   p               end do
             111                     !----------------------------------------------------------------------
             112                         return
             113                         end subroutine cududv_n


  (inc)(line-no.)(nest)(optimize)
               1                           subroutine splin1 ( y,f,n,im,il,cof,tension )
               2                     !
               3                     !     1-d cubic spline interpolation assuming periodic b.c.
               4                     !
               5                     !     y(n)    : input array to be interpolated from
               6                     !     f(im)   : output array to be interpolated to
               7                     !     n       : dimension of input array
               8                     !     im      : dimension of output array
               9                     !     il(im)  : address index of output points by input grid units
              10                     !     cof(n*3): grid-related coef. for gaussain elimination
              11                     !     tension : =1.0 for full cubic,  =0.0 for linear
              12                     !   * note    : arrays il, and cof are generated in splinc
              13                     !
              14                           implicit  none
              15                           integer   n,im,i,ii,iip,il(im)
              16                     
              17                           real      y(n),f(im),cof(n*3),tension
              18                     !
              19                     !     local work arrays:
              20                           real      d2ydx2(2000), yp1(2000),dx,dm,tem
              21                           real      tem1,tem2,tem13,tem23
              22                     !
              23                           dx = 1.0/float(n)
              24                           dm = 1.0/float(im)
              25                     !
              26                           tem = tension / (dx*dx)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 112, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      y, f
                                   <<< Loop-information  End >>>
              27     1  pp   2v            do 95 i = 1, n-2
              28     1   p   2v            f(i+1) = ( y(i) - 2.0*y(i+1) + y(i+2) ) * tem
              29     1   p   2v        95  continue
              30                           f(1) = ( y(n) - 2.0*y(1) + y(2) ) * tem
              31                           f(n) = ( y(n-1) - 2.0*y(n) + y(1) ) * tem
              32                     !
              33                           call gauslv ( n,f,d2ydx2,cof )
              34                     !
              35                           d2ydx2(n+1) = d2ydx2(1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      y, yp1
                                   <<< Loop-information  End >>>
              36     1  pp   4v            do 97 i =1, n
              37     1   p   4v            yp1(i) = y(i)
              38     1   p   4v        97  continue
              39                           yp1(n+1) = y(1)
              40                     !
              41                     !cc   if (derv )  go to 40
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 223
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      il, f
                                   <<< Loop-information  End >>>
              42     1  pp    v            do 30 i = 1, im
              43     1   p    v            ii = il(i)
              44     1   p    v            iip = ii + 1
              45     1   p    v            tem1 = dx*ii - dm*(i-1.0)
              46     1   p    v            tem2 = dm*(i-1.0) - dx*(ii-1.0)
              47     1   p    v            tem13 = tem1**3/dx
              48     1   p    v            tem23 = tem2**3/dx
              49     1   p    v            f(i) = d2ydx2(ii)*tem13 + d2ydx2(iip)*tem23  &
              50     1                          + tem1*(yp1(ii)/dx - dx*d2ydx2(ii))     &
              51     1                          + tem2*(yp1(iip)/dx- dx*d2ydx2(iip))
              52     1   p    v        30  continue
              53                     !c
              54                     !cc   return
              55                     !c40  continue
              56                     !
              57                     !cc   to output first derivative of the input array
              58                     !cc
              59                     !cc   do 50 i = 1, im
              60                     !cc   ii = il(i)
              61                     !cc   iip = ii + 1
              62                     !cc   tem1 = dx*ii - dm*(i-1.0)
              63                     !cc   tem2 = dm*(i-1.0) - dx*(ii-1.0)
              64                     !cc   tem12 = tem1*tem1/dx * 3.0
              65                     !cc   tem22 = tem2*tem2/dx * 3.0
              66                     !cc   f(i) = d2ydx2(iip)*tem22 - d2ydx2(ii)*tem12
              67                     !cc  1     + (yp1(iip)-yp1(ii))/dx - (d2ydx2(iip)-d2ydx2(ii))*dx
              68                     !c50  continue
              69                     !
              70                           return
              71                           end


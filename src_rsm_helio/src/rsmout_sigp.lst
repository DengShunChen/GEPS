             307                             print*,'gfs ksfcp itag=',itag
             308                           endif
             309                     #endif
             310                     !
             311                     !  convert virture potential temperature to temperature
             312                     !
             313     1                     do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk, qt, wrk1
                                   <<< Loop-information  End >>>
             314     2  pp                   do 20 jj = 1, jlistnum
             315     2   p                     j=jlist1(jj)
             316     2   p                     nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, tt, qt, wrk1
                                   <<< Loop-information  End >>>
             317     3   p   2v              do 20 i = 1,nxj
             318     3   p   2v                wrk1(i,jj)=tt(i,k,jj)*pk(i,k,jj)/(1.0+0.608*qt(i,k,jj))
             319     2   p   2v       20     continue
             320     1                       call unify_reduceintp(nx,my,my_max,wrk1,work)
             321     1               !
             322     1               #ifdef write_RSM
             323     2                     if(myrank.eq.0) then
             324     2                       krec=ktt-1+(lev-k+1)
             325     2                       write(nsig,rec=krec) ((work(i,j),i=x1,x2),j=y1,y2)
             326     2                     endif
             327     1               #endif
             328     1               #ifdef send_RSM
             329     1                     if(myrank.eq.0) then
             330     1                       g3send(:,:,lev-k+1)=work(x1:x2,y1:y2)
             331     1                     endif
             332     1               #endif
             333     1                     enddo
             334                     #ifdef send_RSM
             335                           if(myrank.eq.0) then
             336                           do k=1,lev
             337                             itag=itag0+ktt-1+k
             338                             call mpmd_send(g3send(:,:,k),len2,root_rsm,itag,'R')
             339                           enddo
             340                           endif
             341                     #endif
             342                     
             343                     !
             344                     !  convert gaussain u,v component to normal u,v component
             345                     !
             346                     !
             347                     ! u
             348                     !
             349     1                     do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3

                                   <<< Loop-information  End >>>
             410     1  pp    v            do 100 i = 1, nxj
             411     2   p    v            if ( ocean(i) )  then
             412     2   p    v               z0(i) = 0.032 *ustar(i)*ustar(i)/g
             413     2               !       if(ncepsfc)z0(i) = 0.014 *ustar(i)*ustar(i)/g
             414     2   p    v               z0(i)= max(1.5e-5,min(z0(i),0.01))
             415     2   p    v            endif
             416     1               !
             417     1               !
             418     1               !           compute surface wind
             419     1               !
             420     1   p    v            sfcw(i)= max( 1.0e-2,sqrt( ut(i,kk)*ut(i,kk)+vt(i,kk)*vt(i,kk)))
             421     1   p    v        100 continue
             422                     !
             423                     !           compute surface wind
             424                     !
             425     1                     if(.not.ncepsfc)then
             426     1               !------------------------------------------------------------
             427     1               ! for ocean
             428     1               !
             429     1               !           iterate 3 times to match u*, t*, q*, and z/l
             430     1               !
             431     1               !
             432     2                     do  it1 = 1, 3
             433     2               !
             434     2               !           charnock's relation for surface roughness over oceans
             435     2               !
             436     3                     do  i = 1, nxj
             437     4                     if ( ocean(i) )  then
             438     4               !
             439     4                        z0(i) = 0.032 *ustar(i)*ustar(i)/g
             440     4                        z0(i)= max(1.5e-5,min(z0(i),0.01))
             441     4                     endif
             442     3               !
             443     3               !
             444     3               !
             445     3               !           compute z/l
             446     3               !
             447     3               !           limit minimum depth of surface layer
             448     3               !           (saved in zsz0) for surface flux calculation
             449     3               !
             450     3               !
             451     3                     g04 = g*0.4
             452     3                     zsz0(i) = max(10.0,hgt(i,kk))
             453     3                     zl(i) = g04*zsz0(i)*tstar(i)*(1.+0.61*qstar(i)) /  &
             454     3                             (tt(i,kk)*ustar(i)*ustar(i))
             455     3                     zl(i)= max(-2.0,min(zl(i),2.0))
             456     3               !
             457     3               !
             458     3               !           compute phi functions  (see businger 1973, or paulson 1970)
             459     3               !
             460     3                     pihalf = 3.141592654 * 0.5
             461     3               !
             462     4                     if(zl(i) .lt. 0.0) then
             463     4               !ibm        xx1 = exp(0.25*log(1.0 - 15.0*zl(i)))
             464     4               !ibm        phim(i) = 2.0*log(0.5*(1.0+xx1)) + log(0.5*(1.0+xx1*xx1))
             465     4               !ibm    1                    - 2.0*atan(xx1) + pihalf
             466     4                        xx1 = sqrt(sqrt(1.0 - 15.0*zl(i)))
             467     4                        phim(i) = log(((0.5*(1.0+xx1))**2)*(0.5*(1.0+xx1*xx1))) &
             468     4                                         - 2.0*atan(xx1) + pihalf
             469     4                        phih(i) = 2.0*log(0.5*(1.0 +sqrt(1.0 -9.0*zl(i))))
             470     4                     else
             471     4                        phim(i) = -4.7  * zl(i)
             472     4                        phih(i) = -6.35 * zl(i)
             473     4                     endif
             474     3               !
             475     3                     zsz0(i) = log(zsz0(i)/z0(i))
             476     3                     phim(i) = zsz0(i) - phim(i)
             477     3                     phih(i) = zsz0(i) - phih(i)
             478     3                     phim(i)= max(phim(i),1.0e-3)
             479     3                     phih(i)= max(phih(i),1.0e-3)
             480     3               !
             481     3               !     compute new ut, vt, tt, and qt for ustar, tstar, qstar updates
             482     3               !     using crank-nicolson (bl=0.5) time scheme for weak forcing or
             483     3               !        or backward (bl=1.) time scheme for strong forcing
             484     3               !
             485     3                     yy1   = dt*ustar(i) * ustar(i) / (2.0*hgt(i,kk)*sfcw(i))
             486     3                     btest = 0.5 + (yy1-1.0)*0.5
             487     3                     bl    = max (0.5, min (1.0, btest) )
             488     3                     al    = 1.0 - bl
             489     3                     wu(i) = ut(i,kk) * (1.0-al*yy1) / (1.0+bl*yy1)
             490     3                     wv(i) = vt(i,kk) * (1.0-al*yy1) / (1.0+bl*yy1)
             491     3                     xx1    = 0.4*dt*ustar(i) / (0.74*2.0*hgt(i,kk)*phih(i))
             492     3                     wt(i) = ( tt(i,kk)*(1.0-al*xx1)+xx1*tg(i)/pk2(i,kk) )/(1.0+bl*xx1)
             493     3                     wq(i) = ( qt(i,kk)*(1.0-al*xx1) + xx1*qsfc(i) ) / (1.0+bl*xx1)
             494     3               !
             495     3               !     update ustar, tstar and qstar
             496     3               !
             497     3               ! phon-ju
             498     3               ! add blending for stability
             499     3               !
             500     3                     wu(i)=0.5*(ut(i,kk)+wu(i))
             501     3                     wv(i)=0.5*(vt(i,kk)+wv(i))
             502     3                     wt(i)=0.5*(tt(i,kk)+wt(i))
             503     3                     wq(i)=0.5*(qt(i,kk)+wq(i))
             504     3               ! add over
             505     3                     sfcw(i) = max (1.0e-2, sqrt( wu(i)*wu(i) + wv(i)*wv(i) ))
             506     3                     ustar(i) = 0.4*sfcw(i) / phim(i)
             507     3                     tstar(i) = 0.4*        (wt(i)-tg(i)/pk2(i,kk))  /(0.74*phih(i))
             508     3                     qstar(i) = 0.4*        (wq(i)-qsfc(i))/(0.74*phih(i))
             509     3                     ustar(i)= max(ustar(i),1.0e-7)
             510     3                     ustar(i)= min(ustar(i),10.000)
             511     3                     tstar(i)= min(tstar(i),50.00)
             512     3                     qstar(i)= min(qstar(i),5.000)
             513     3               !
             514     3                     enddo
             515     2                     enddo
             516     1               !---- iteration end
             517     1               !
             518     1               !ccc for output of t2, u10 and v10
             519     1               !
             520     2                     do i=1,nxj
             521     2               !
             522     2                     zl2=zl(i)*2./hgt(i,kk)
             523     2                     zl10=zl(i)*10./hgt(i,kk)
             524     3                     if(zl(i) .lt. 0.0) then
             525     3               !ibm        xx10 = exp(0.25*log(1.0 - 15.0*zl10))
             526     3               !ibm        phim10 = 2.0*log(0.5*(1.0+xx10)) + log(0.5*(1.0+xx10*xx10))
             527     3               !ibm    1                    - 2.0*atan(xx10) + pihalf
             528     3                        xx10 = sqrt(sqrt(1.0 - 15.0*zl10))
             529     3                        phim10 = log(((0.5*(1.0+xx10))**2)*(0.5*(1.0+xx10*xx10)))  &
             530     3                                         - 2.0*atan(xx10) + pihalf
             531     3                        phih2 = 2.0*log(0.5*(1.0 +sqrt(1.0 -9.0*zl2)))
             532     3                     else
             533     3                        phim10 = -4.7  * zl10
             534     3                        phih2 = -6.35 * zl2
             535     3                     endif
             536     2                     phim10 =log( 10./z0(i)) - phim10
             537     2                     phih2 =log( 2./z0(i)) - phih2
             538     2                     phim10= max(phim10,1.0e-3)
             539     2                     phih2= max(phih2,1.0e-3)
             540     2               !
             541     2                     v10(i)=wv(i)*phim10/phim(i)
             542     2                     u10(i)=wu(i)*phim10/phim(i)
             543     2               !
             544     2                     q2(i)=qsfc(i)*(1.-phih2/phih(i))+wq(i)*phih2/phih(i)
             545     2                     t2(i)=tg(i)/pk2(i,kk)*(1.-phih2/phih(i))+wt(i)*phih2/phih(i)
             546     2               !
             547     2               ! convert t2 from potential temp. to temp
             548     2                     p2(i)=(ps(i)*100.-rosfc(i)*g*2.)/100.
             549     2                     t2(i)=t2(i)*(p2(i)/1000.)**xkapa
             550     2               !     t2(i)=t2(i)*exp(xkapa*log(p2/1000.))
             551     2               
             552     2               ! do transfer from cwb-sfc to match ncep-sfc
             553     2                     phih(i)=0.4*0.4/0.74/phim(i)/phih(i)
             554     2                     phim(i)=0.4*0.4/phim(i)/phim(i)
             555     2               !
             556     2                     enddo
             557     1               !
             558     1                     call qsatq( nxj, t2, p2, wk2)
             559     1               !
             560     2                     do i=1,nxj
             561     2                      q2(i)=min(wk2(i),q2(i))
             562     2                      rh2(i)=q2(i)/wk2(i)
             563     2                     enddo
             564     1               !
             565     1                     endif   !end (.not.ncepsfc)
             566                     !
             567                     !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
             568                     !
             569                     ! surface layer for land or ice
             570                     !
             571                     !     refer to ncep

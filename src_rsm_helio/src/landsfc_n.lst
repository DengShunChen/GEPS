                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             908     1  pp    v             do i=1,nxj
             909     2   p    v              if(flag(i))then
             910     2               !
             911     2   p    v              rcs = 1.
             912     2   p    v              rct = 1.
             913     2   p    v              rcq = 1.
             914     2               !
             915     2               !  resistance due to solar effect
             916     2               !
             917     2   p    v              ff  = .55* 2.* ss(i)/rgl(ivegtyp(i))
             918     2   p    v              rcs = (ff + rs(i)/rsmax(ivegtyp(i)))/(1.+ff)
             919     2   p    v              rcs = max(rcs, 0.0001)
             920     2               !
             921     2               !  resistance due to thermal effect
             922     2               !
             923     2               !         rct = 1. - .0016 * (topt - ta(i)) ** 2
             924     2               !         rct = max(rct,.0001)
             925     2               !
             926     2               !  resistance due to humidity
             927     2               !
             928     2               !         rcq = 1. / (1. + hs(ivegtyp(i)) * (qs1(i) - qt(i,kk)))
             929     2               !         rcq = max(rcq,.0001)
             930     2               !

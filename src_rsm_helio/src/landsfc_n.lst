             877     1   s    s            do i=1,nxj
             878     2   p    m              if(flag(i))then
             879     2   m    s              df1(i)=funcdf(smc(i,1),istyp(i),tsat,dfk)
             880     2   s    s              xkt1(i)=funckt(smc(i,1),istyp(i),tsat,xktk)
             881     2   p    v              endif
             882     2   p    s              if(flag(i).and.stc(i,1).lt.t0c)then
             883     2   p    s              df1(i)=0.

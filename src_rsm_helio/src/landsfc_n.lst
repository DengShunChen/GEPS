                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             840     1  pp    v            do i=1,nxj
             841     2   p    v            if(.not.ocean(i))then
             842     2   p    v            t12(i)=twork(i)*twork(i)
             843     2   p    v            t14(i)=t12(i)*t12(i)
             844     2               !
             845     2   p    v            ta(i)=tt(i,kk)*pk2(i,kk)
             846     2               !
             847     2   p    v            rch(i)=rosfc(i)*cp*phih(i)*sfcw(i)
             848     2               !
             849     2               ! rnet=ss+ld-stbo*t14-gfx-rho*cp*ch*v*(t1-ta)
             850     2               !
             851     2               !     gfx(i)=-rosfc(i)*cp*ustar(i)*tstar(i)*0.1
             852     2   p    v            rnet(i)=ss(i)+rld(i)-stbo*t14(i)+gfx(i)-rch(i)*(twork(i)-ta(i))
             853     2               !
             854     2               ! rsmall=4*sigma*t1**3/rch +1
             855     2               !
             856     2   p    v            rsmall(i)=4.*stbo*twork(i)*t12(i)/rch(i) +1.
             857     2               !
             858     2               ! delta= hltm/cp *dqs/dt
             859     2               !
             860     2   p    v            delta(i)=hltm/cp*(0.622* 2.5e+6 *qs1(i))/(r*t12(i))
             861     2               !
             862     2   p    v            terma(i)=rnet(i)*delta(i)
             863     2   p    v            termb(i)=rsmall(i)*hltm*(rch(i)/cp)*(qs1(i)-qt(i,kk))
             864     2               !
             865     2   p    v            ep(i)=termb(i)+terma(i)
             866     2   p    v            ep(i)=ep(i)/(rsmall(i)+delta(i))
             867     2   p    v            endif
             868     1   p    v            enddo
             869                     !
             870                     ! actual evaporation over land in three parts: edir, et, and ec
             871                     !
             872                     ! edir :direct evaporation from soil

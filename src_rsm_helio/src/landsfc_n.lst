 External subroutine subprogram "landsfc_n"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine landsfc_n ( nxj,mn,kk,dt,g,r,cp,hltm,tg,z0,ocean,ps,ts,hgt &
               2                                             , u,v,t,q,ut,vt,tt,qt,sfcw,ustar,tstar,qstar        &
               3                                             , e,eps,hflux,qflux,zl,itypbl                       &
               4                                             , as,ss,rld,stbo,pk,pk2,gfx                         &
               5                                             ,km,snr,smc,stc,canopy,sigmaf,istyp,ice,land        &
               6                                             ,tg3,rhscnpy,rhsmc,aim,bim,cim                      &
               7                                             ,drain,snomt,zsoil,dth,ivegtyp,t2,rh2,u10,v10       &
               8                                             ,smwlt,smref,tsat,dfkt,xktk,dfk                     &
               9                                             ,fm,fh,rb)
              10                     !
              11                     !##################################################################
              12                     !                     subroutine description
              13                     !
              14                     ! 1. function description
              15                     !
              16                     !       this subroutine calculated surface fluxes of momentum,
              17                     !       heat and moisture.
              18                     !       the effects of surface fluxes are added to the bottom
              19                     !       levels.
              20                     !
              21                     ! 2. parameter specification
              22                     !
              23                     !     mn : dimension of horizontal-direction
              24                     !     kk : dimension of z-direction
              25                     !     dt : time step for ut, vt, tt, qt updates               (s)
              26                     !      g : gravity                                            (m/s2)
              27                     !      r : air gas constant                                   (j/kg)
              28                     !     cp : air specific heat constant                         (j/kg)
              29                     !   hltm : water vapor latent heat constant                   (j/kg)
              30                     !     tg : ground potential temp. (sea or land)    (mn)      (k)
              31                     !     z0 : surface roughness length                (mn)      (m)
              32                     !  ocean : logical array for ocean  (mn)      (true = open water)
              33                     !     ps : surface pressure     (mn)     at current time lvl (mb)
              34                     !     ts : surface air temp
              35                     !    hgt : height above ground  (mn,kk)  at current time lvl (m)
              36                     !      u : x-direction velocity (mn,kk) at current time lvl (m/s)
              37                     !      v : y-direction velocity (mn,kk) at current time lvl (m/s)
              38                     !      t : potent temp on odd lvl(mn,kk) at current time lvl (k)
              39                     !      q : moisture    on odd lvl(mn,kk) at current time lvl (kg/kg)
              40                     !     ut : x-direction velocity (mn,kk) at past/future  lvl (m/s)
              41                     !     vt : y-direction velocity (mn,kk) at past/future  lvl (m/s)
              42                     !     tt : potent temp on odd lvl(mn,kk) at past/future  lvl (k)
              43                     !     qt : moisture    on odd lvl(mn,kk) at past/future  lvl (kg/kg)
              44                     !   sfcw : surface wind speed                       (mn)     (m/s)
              45                     !   ustar: surface friction velocity                (mn)     (m/s)
              46                     !   tstar: surface potential temp scale             (mn)     (k)
              47                     !   qstar: surface moisture scale                   (mn)     (kg/kg)
              48                     !     e  : turbulence kinetic energy                (mn,kk)  (m2/s2)
              49                     !    eps : tke dissipation                          (mn)     (m2/s2)
              50                     !   hflux: upward surface heat flux, =-ro*cp*ustar*tstar   (mn)  (w/m2)
              51                     !   qflux: upward surface moist flux,=-ro*hltm*ustar*qstar (mn)  (w/m2)
              52                     !    qsfc: surface satuated specific humidity       (mn)     (kg/kg)
              53                     !     zl : height(kk) over monin-obukhov scale height.
              54                     !          a stability indicator.                   (mn)
              55                     ! itypbl : index for surface layer update, =0 stress b,c., =1 direct
              56                     !
              57                     ! soil variables
              58                     !     km : dimension of soil layer
              59                     !    snr : snow depth                              (mn)     (mm)
              60                     !    smc : volumetric soil moisture content        (mn,km)
              61                     !    stc : soil temperature                        (mn,km)  (k)
              62                     ! canopy : canopy moisture content                 (mn)     (mm)
              63                     ! sigmaf : vegetation fraction                     (mn)
              64                     ! istyp  : soil type(1-9)                          (mn)
              65                     !  ice   : logical array for sea ice  (mn)      (true = sea ice)
              66                     ! land   : logical array for land     (mn)      (true = land  )
              67                     !  tg3   : deep layer soil temperature of annual mean (mn)
              68                     !rhscnpy : r.h.s. terms for canopy prediction (mn)   (mm/s)
              69                     ! rhsmc  : r.h.s. terms for soil moisture prediction (mn,km)(s)
              70                     ! aim    ; first column of tri-diagnal matrix for solving smc (mn,km)
              71                     ! bim    ; second column of tri-diagonal matrix for solving smc (mn,km)
              72                     ! cim    ; third column of tri-diagonal matrix for solving smc (mn,km)
              73                     ! drain  : drainage from bottom soil layer  (mn)     (mm/s)
              74                     ! snomt  : snow meltin rate (mn)   (mm/s)
              75                     ! zsoil  : soil layer depth(mn,km)        (m)
              76                     ! dth    : time step for snr updates      (s)
              77                     ! ivegtyp: vegetation type(1-13)
              78                     ! smwlt  : wiltling point of 9 soil types  (9)
              79                     ! smref  : field capacity of 9 soil types  (9)
              80                     ! tsat   : satuation point of 9 soil types (9)
              81                     ! dfkt   : soil thermal diffusivity    (22,9)    m2/s
              82                     ! xktk   : soil hydraulic conductivity (22,9)    m/s
              83                     !  dfk   : soil hydraulic diffusivity  (22,9)    m2/s
              84                     !
              85                     ! 4. local work arrays
              86                     !
              87                     !    phim: non-dimensional vertically integrated wind shear function
              88                     !          (businger , 1973)                        (mn)
              89                     !    phih: non-dimensional vertically integrated temperature/moisture
              90                     !          gradient function (businger , 1973)      (mn)
              91                     !    sfcw: wind speed on mass point                 (mn)     (m/s)
              92                     !    zsz0: log(zs/z0)                               (mn)     (m/m)
              93                     !
              94                     ! 5. calling modules
              95                     !
              96                     !    pbltke
              97                     !
              98                     ! 6. usage
              99                     !
             100                     !     call landsfc ( mn,kk,dt,g,r,cp,hltm,tg,z0,ocean,ps,ts,hgt
             101                     !    1                  , u,v,t,q,ut,vt,tt,qt,sfcw,ustar,tstar,qstar
             102                     !    2                  , e,eps,hflux,qflux,zl,itypbl
             103                     !    3                  ,as,ss,rld,stbo,pk,pk2,gfx
             104                     !    4                  ,km,snr,smc,stc,canopy,sigmaf,istyp,ice,land
             105                     !    5                  ,tg3,rhscnpy,rhsmc,aim,bim,cim
             106                     !    6                  ,drain,snomt,zsoil,dth,ivegtyp,t2,u10,v10
             107                     !    7                  ,smwlt,smref,tsat,dfkt,xktk,dfk)
             108                     !
             109                     ! 7. modules called
             110                     !
             111                     !
             112                     ! 8. limitation
             113                     !
             114                     !   ** 1.5e-5 <= z0 (sea) <= 0.01
             115                     !   **   -2.0 <=    zl    <= 2.0
             116                     !   **            ustar   >= 1.e-7,  <= 1.e+1
             117                     !   **            tatrt              <= 5.e+1
             118                     !   **            qatrt              <= 5.e+0
             119                     !   **              zs    >= 10.0
             120                     !   **             sfcw   >= 0.01
             121                     !
             122                     ! 9. date
             123                     !
             124                     !     created            10/1/1989
             125                     !     modified           7/23/1990
             126                     !     rewritten          nov. 1991
             127                     !     modified           jan. 2005
             128                     !
             129                     ! 10. author
             130                     !      c. liou / f. wang / s. chang
             131                     !      jan. 2005 by f. wang
             132                     !      modify to f90 by C-H Lee and sort by River Chen in 2015
             133                     !
             134                     ! 11. reference
             135                     ! surface layer:
             136                     !
             137                     !       businger j.a.,1973: turbulent transfer in the atmospheric
             138                     !            surface layer.  workshop in meteorology, d. a. haugen,
             139                     !            ed., american meteorology socity, 67-98.
             140                     !
             141                     ! land process:
             142                     !
             143                     !       Mahrt, L., and H. -L. Pan,1984: Atwo-layer model of soil hydrology.
             144                     !             Boundary Layer Meteorol., 29, 1-20.
             145                     !       Pan, H.-L., and L.Mahrt, 1987: Interaction between soil hydrology
             146                     !             and boundary-layer development. Boundary Layer Meteorol.,
             147                     !             38,185-202.
             148                     !#####################################################################
             149                     !
             150                           use const, only : RTYPE
             151                     !
             152                           implicit  none
             153                     !
             154                     ! input & output variable
             155                     !
             156                           integer   nxj,mn,kk,itypbl,km
             157                           real      dt,g,r,cp,hltm,stbo,dth
             158                     
             159                           real      tg(mn),z0(mn),ps(mn),hgt(mn,kk),                   &
             160                                     u(mn,kk),v(mn,kk),t(mn,kk),                        &
             161                                     sfcw(mn),ustar(mn),                                &
             162                                     tstar(mn),qstar(mn),e(mn,kk),eps(mn,kk),hflux(mn), &
             163                                     qflux(mn),qsfc(mn),zl(mn),ts(mn),                  &
             164                     ! for pm-evap.
             165                                     ss(mn),rld(mn),gfx(mn),                            &
             166                                     as(mn)
             167                           real(kind=RTYPE) q(mn,kk),qt(mn,kk),ut(mn,kk),vt(mn,kk),     &
             168                                            tt(mn,kk),pk(mn,kk),pk2(mn,kk)
             169                           logical   ocean(mn)
             170                     !
             171                           real      phim(mn),phih(mn),zsz0(mn),rosfc(mn),              &
             172                                     wu(mn),wv(mn),wt(mn),wq(mn),                       &
             173                                     wt1(mn),wt2(mn)
             174                     ! for landsfc-layer
             175                           real      z0max(mn),ztmax(mn),dtv(mn),adtv(mn),rb(mn)
             176                           real      fm(mn),fh(mn),hlinf(mn),olinf(mn),fm10(mn),fh2(mn)
             177                           real      hl1(mn),pm(mn),ph(mn)
             178                           real      restar(mn),rat(mn),pm10(mn),ph2(mn),               &
             179                     ! for pm-evap.
             180                                     p1(mn),qs1(mn),t12(mn),t14(mn),ta(mn),             &
             181                                     rch(mn),rnet(mn),rsmall(mn),delta(mn),             &
             182                                     terma(mn),termb(mn),termc(mn),rs(mn),              &
             183                                     twork(mn),rsi(mn),qs0(mn)
             184                     ! for soil input and output
             185                            real     zsoil(mn,km),sigmaf(mn),tg3(mn)
             186                            real     snr(mn),smc(mn,km)
             187                            real     canopy(mn),rhscnpy(mn),rhsmc(mn,km),               &
             188                                     aim(mn,km),bim(mn,km),cim(mn,km)
             189                            real     drain(mn),stc(mn,km),snomt(mn)
             190                            logical  land(mn),ice(mn),flagsnw(mn),flag(mn)
             191                     ! local
             192                            real     stsoil(mn,km),tsurf(mn),smcz(mn)
             193                            real     partlnd(mn),factsnw(mn)
             194                            real     evap(mn),ep(mn),etp(mn),edir(mn),ec(mn),           &
             195                                     et(mn,km),snoevp(mn)
             196                            real     tref(mn),twilt(mn),dft0(mn),                       &
             197                                     canfac(mn),etpfac(mn),dft1(mn),dft2(mn)
             198                            real     gx(mn),fx(mn),rhstc(mn,km)
             199                            real     dew(mn)
             200                            real     dmdz(mn),ddz(mn),dmdz2(mn),ddz2(mn),               &
             201                                     df1(mn),df2(mn)
             202                            real     xx(mn),yy(mn),zz(mn)
             203                            real     dtdz1(mn),dtdz2(mn),hcpct(mn)
             204                            real     ai(mn,km),bi(mn,km),ci(mn,km)
             205                            integer  istyp(mn),ivegtyp(mn)
             206                            real     xkt1(mn),xkt2(mn),smcdry(mn),beta(mn)
             207                     ! landpack
             208                     !--------------------------------------------
             209                     ! soil function
             210                     !  the 9 soil types are:
             211                     !    1  ... loamy sand (coarse)
             212                     !    2  ... silty clay loam (medium)
             213                     !    3  ... light clay (fine)
             214                     !    4  ... sandy loam (coarse-medium)
             215                     !    5  ... sandy clay (coarse-fine)
             216                     !    6  ... clay loam  (medium-fine)
             217                     !    7  ... sandy clay loam (coarse-med-fine)
             218                     !    8  ... loam  (organic)
             219                     !    9  ... ice (use loamy sand property)
             220                     !
             221                           integer,  parameter :: ntype=9,ngrid=22
             222                           real      tsat(ntype),dfkt(ngrid,ntype),           &
             223                                     xktk(ngrid,ntype),dfk(ngrid,ntype)
             224                           real      smref(ntype),smwlt(ntype)
             225                     !
             226                     !     data smref/.283,.387,.412,.312,.338,.382,.315,.329,.283/
             227                     !     data smwlt/.029,.119,.139,.047,.010,.103,.069,.066,.029/
             228                     !
             229                           real      smmax(ntype),smdry(ntype)
             230                     !
             231                           data smmax/.421,.464,.468,.434,.406,.465,.404,.439,.421/
             232                           data smdry/.07,.14,.22,.08,.18,.16,.12,.10,.07/
             233                     !------------------------------------------------------------
             234                     ! vegtype(13)
             235                     !
             236                     !  the 13 vegetation types are:
             237                     !
             238                     !  1  ...  broadleave-evergreen trees (tropical forest)
             239                     !  2  ...  broadleave-deciduous trees
             240                     !  3  ...  broadleave and needle leave trees (mixed forest)
             241                     !  4  ...  needleleave-evergreen trees
             242                     !  5  ...  needleleave-deciduous trees (larch)
             243                     !  6  ...  broadleave trees with groundcover (savanna)
             244                     !  7  ...  groundcover only (perenial)
             245                     !  8  ...  broadleave shrubs with perenial groundcover
             246                     !  9  ...  broadleave shrubs with bare soil
             247                     ! 10  ...  dwarf trees and shrubs with ground cover (trunda)
             248                     ! 11  ...  bare soil
             249                     ! 12  ...  cultivations (use parameters from type 7)
             250                     ! 13  ...  glacial
             251                     !
             252                           integer,  parameter :: nvtype=13
             253                           real      rsmax(nvtype),rgl(nvtype),rsmin(nvtype),hs(nvtype)
             254                           data rsmax/13*5000./
             255                           data rsmin/150.,100.,125.,150.,100.,70.,40.,                  &
             256                                      300.,400.,150.,999.,40.,999./
             257                           data rgl/5*30.,65.,4*100.,999.,100.,999./
             258                           data hs/41.69,54.53,51.93,47.35,47.35,54.53,36.35,            &
             259                                   3*42.00,999.,36.35,999./
             260                     !
             261                           logical   ncepsfc
             262                           data      ncepsfc/.true./
             263                     !-----------------------------------------------------------------
             264                     ! landsfc parameter
             265                           real, parameter :: alpha=5.,a0=-3.975,a1=12.32,b1=-7.755,b2=6.041
             266                           real, parameter :: a0p=-7.941,a1p=24.75,b1p=-8.705,b2p=7.899,vis=1.4e-5
             267                           real, parameter :: aa1=-1.076,bb1=.7045,cc1=-.05808
             268                           real, parameter :: bb2=-.1954,cc2=.009999
             269                           real, parameter :: ca=.4,topt=298.
             270                     !
             271                           real, parameter :: cice=1880.*917.
             272                           real, parameter :: dfsnow=0.31
             273                           real, parameter :: scanop=0.5
             274                           real, parameter :: rhoh2o=1000.
             275                           real, parameter :: hfus=3.3358e+5
             276                           real, parameter :: ch2o=4.2e6,csoil=1.26e6
             277                           real, parameter :: zbot=-3.
             278                           real, parameter :: tgice=271.2
             279                           real, parameter :: ctfil1=0.5,ctfil2=0.5
             280                           real, parameter :: cfactr=0.5
             281                           real, parameter :: t0c=273.16
             282                     !
             283                     !cc for output of t2, u10 and v10 ( 2003/01/20 )
             284                           real  u10(mn),v10(mn),t2(mn),q2(mn),rh2(mn),p2(mn),wk2(mn)
             285                           real  hl12x,hl110x,hl12,hl110
             286                     
             287                           integer i, k, it1
             288                           real    g04,  xkapa, pihalf, xx1,   yy1,    btest,  bl,     al,   zl2,  &
             289                                   zl10, xx10,  phim10, phih2, hl0inf, hltinf, aa,     aa0,  bb,   &
             290                                   bb0,  fms,   fhs,    hl0,   hlt,    hl1x,   xtsoil, tflx,       &
             291                                   rcs,  rct,   rcq,    ff,    rss,    bfact,  cc,     hpbl, ghpbl,&
             292                                   zlx, wstar,  funcdf, funckt
             293                     
             294                     !
             295                     !          cccccccccccccccccccccccccccccccccccccccccccccc
             296                     !          c                                            c
             297                     !          c         similarity surface layer           c
             298                     !          c         paulson 1970, businger 1973        c
             299                     !          c                                            c
             300                     !          cccccccccccccccccccccccccccccccccccccccccccccc
             301                     !
             302                           g04 = g*0.4
             303                           xkapa = r/cp
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 232
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ps, ts, hgt, ivegtyp, rosfc, p1, ice, tg
                                   <<<      tsurf, factsnw
                                   <<< Loop-information  End >>>
             304     1  pp    s            do 10 i = 1, nxj
             305     1   p    v            rosfc(i) = 100.0*ps(i)/( r*ts(i))
             306     1   p    v            p1(i)=ps(i)-rosfc(i)*g*hgt(i,kk)/100.
             307     1               ! define stamotal resistance 60 s/m
             308     1               !cc   sigmaf(i)=0.7
             309     1               !cc   rs(i)=60.
             310     1   p    m            if(ivegtyp(i).gt.0.)rs(i)=rsmin(ivegtyp(i))
             311     1               !
             312     1   p    v            factsnw(i)=10.
             313     1   p    m            if(ice(i))factsnw(i)=3.
             314     1               !
             315     1   p    v            tsurf(i)=tg(i)
             316     1   p    v        10  continue
             317                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 471
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.60, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ice, snr, rs, as, partlnd, flagsnw
                                   <<< Loop-information  End >>>
             318     1  pp    v            do i=1,nxj
             319     1               !
             320     1               ! snr(snow depth) in unit mm
             321     1               !
             322     1   p    v            flagsnw(i)=.false.
             323     1   p    v            if(snr(i).gt.1. .or.ice(i))rs(i)=0.
             324     2   p    v            if(snr(i).gt.1.)then

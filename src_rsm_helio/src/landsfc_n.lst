                                   <<< Loop-information  End >>>
             578     2  pp    v            do  i=1,nxj
             579     2               !
             580     3   p    v            if(ocean(i))then
             581     3               !      z0(i) = 0.014 *ustar(i)*ustar(i)/g
             582     3   p    v             z0(i) = 0.032 *ustar(i)*ustar(i)/g
             583     3   p    v             z0(i)= max(1.5e-5,min(z0(i),0.01))
             584     3   p    v            endif
             585     2               !
             586     2               !     if(.not. ocean(i))then
             587     2   p    v            zsz0(i) = max(10.0,hgt(i,kk))
             588     2   p    v            wt1(i)=tt(i,kk)*pk2(i,kk)*(1.+0.61*qt(i,kk))
             589     2   p    v            wt2(i)=tg(i)*(1.+0.61*qsfc(i))
             590     2   p    v            rb(i) = g*zsz0(i)*( wt1(i)-wt2(i))/(0.5*(wt1(i)+wt2(i))) &
             591     2                             /(sfcw(i)*sfcw(i))
             592     2               !
             593     2               !
             594     2               !  compute stability indices (rb and hlinf)
             595     2               !
             596     2   p    v              z0max(i) = min(z0(i),hgt(i,kk))
             597     2   p    v              ztmax(i) = z0max(i)
             598     3   p    v              if(ocean(i)) then
             599     3   p    v                restar(i) = ustar(i) * z0max(i) / vis
             600     3   p    v                restar(i) = max(restar(i),.000001)
             601     3               !         restar(i) = alog(restar(i))
             602     3               !         restar(i) = min(restar(i),5.)
             603     3               !         restar(i) = max(restar(i),-5.)
             604     3               !         rat(i) = aa1 + bb1 * restar(i) + cc1 * restar(i) ** 2
             605     3               !         rat(i) = rat(i) / (1. + bb2 * restar(i)
             606     3               !                            + cc2 * restar(i) ** 2)
             607     3               ! rat taken from zeng,zhao and dickinson 1997
             608     3               !ibm      rat(i) = 2.67*restar(i)**.25-2.57
             609     3   p    v                rat(i) = 2.67*sqrt(sqrt(restar(i)))-2.57
             610     3   p    v                rat(i) = min(rat(i),7.)
             611     3   p    v                ztmax(i) = z0max(i) * exp(-rat(i))
             612     3   p    v              endif
             613     2               !
             614     2   p    v              dtv(i) = wt1(i) - wt2(i)
             615     2   p    v              adtv(i) = abs(dtv(i))
             616     2   p    v              adtv(i) = max(adtv(i),.001)
             617     2   p    v              dtv(i) = sign(1.,dtv(i)) * adtv(i)
             618     2   p    v              rb(i) = g * dtv(i) * hgt(i,kk)/ (.5 * (wt1(i) + wt2(i)) &
             619     2                               * sfcw(i) * sfcw(i))
             620     2   p    v              rb(i) = max(rb(i),-5000.)
             621     2   p    v              fm(i) = log((z0max(i)+hgt(i,kk)) / z0max(i))
             622     2   p    v              fh(i) = log((ztmax(i)+hgt(i,kk)) / ztmax(i))
             623     2   p    v              hlinf(i) = rb(i) * fm(i) * fm(i) / fh(i)
             624     2               !
             625     2   p    v              FM10(I) = LOG((Z0MAX(I)+10.) / Z0MAX(I))
             626     2   p    v              FH2(I) = LOG((ZTMAX(I)+2.) / ZTMAX(I))
             627     2               !
             628     2               !  stable case
             629     2               !
             630     2               !
             631     3   p    v              if(dtv(i).ge.0.) then
             632     3   p    v                hl1(i) = hlinf(i)
             633     3   p    v              endif
             634     3   p    v              if(dtv(i).ge.0..and.hlinf(i).gt..25) then
             635     3   p    v                hl0inf = z0max(i) * hlinf(i) / hgt(i,kk)
             636     3   p    v                hltinf = ztmax(i) * hlinf(i) / hgt(i,kk)
             637     3   p    v                aa = sqrt(1. + 4. * alpha * hlinf(i))
             638     3   p    v                aa0 = sqrt(1. + 4. * alpha * hl0inf)
             639     3   p    v                bb = aa
             640     3   p    v                bb0 = sqrt(1. + 4. * alpha * hltinf)
             641     3   p    v                pm(i) = aa0 - aa + log((aa + 1.) / (aa0 + 1.))
             642     3   p    v                ph(i) = bb0 - bb + log((bb + 1.) / (bb0 + 1.))
             643     3   p    v                fms = fm(i) - pm(i)
             644     3   p    v                fhs = fh(i) - ph(i)
             645     3   p    v                hl1(i) = fms * fms * rb(i) / fhs
             646     3   p    v              endif
             647     2               !
             648     2               !  second iteration
             649     2               !
             650     2               !
             651     3   p    v              if(dtv(i).ge.0.) then
             652     3   p    v                hl0 = z0max(i) * hl1(i) /hgt(i,kk)
             653     3   p    v                hlt = ztmax(i) * hl1(i) /hgt(i,kk)
             654     3   p    v                aa = sqrt(1. + 4. * alpha * hl1(i))
             655     3   p    v                aa0 = sqrt(1. + 4. * alpha * hl0)
             656     3   p    v                bb = aa
             657     3   p    v                bb0 = sqrt(1. + 4. * alpha * hlt)
             658     3   p    v                pm(i) = aa0 - aa + log((aa + 1.) / (aa0 + 1.))
             659     3   p    v                ph(i) = bb0 - bb + log((bb + 1.) / (bb0 + 1.))
             660     3               !
             661     3   p    v                hl110 = hl1(i) * 10. /hgt(i,kk)
             662     3   p    v                aa = sqrt(1. + 4. * alpha * hl110)
             663     3   p    v                pm10(i) = aa0 - aa + log((aa + 1.) / (aa0 + 1.))
             664     3   p    v                hl12 = hl1(i) * 2. /hgt(i,kk)
             665     3   p    v                aa = sqrt(1. + 4. * alpha * hl12)
             666     3   p    v                bb = sqrt(1. + 4. * alpha * hl12)
             667     3   p    v                ph2(i) = bb0 - bb + log((bb + 1.) / (bb0 + 1.))
             668     3   p    v              endif
             669     2               !
             670     2               !  unstable case
             671     2               !
             672     2               !
             673     2               !  check for unphysical obukhov length
             674     2               !
             675     2               !
             676     3   p    v              if(dtv(i).lt.0.) then
             677     3   p    v                olinf(i) = hgt(i,kk) / hlinf(i)
             678     4   p    v                if(abs(olinf(i)).le.50. * z0max(i)) then
             679     4   p    v                  hlinf(i) = -hgt(i,kk) / (50. * z0max(i))
             680     4   p    v                endif
             681     3   p    v              endif
             682     2               !
             683     2               !
             684     2               !  get pm and ph
             685     2               !
             686     2               !
             687     3   p    v              if(dtv(i).lt.0..and.hlinf(i).ge.-.5) then
             688     3   p    v                hl1(i) = hlinf(i)
             689     3   p    v                pm(i) = (a0 + a1 * hl1(i)) * hl1(i) &
             690     3                                 / (1. + b1 * hl1(i) + b2 * hl1(i) * hl1(i))
             691     3   p    v                ph(i) = (a0p + a1p * hl1(i)) * hl1(i) &
             692     3                                 / (1. + b1p * hl1(i) + b2p * hl1(i) * hl1(i))
             693     3               !
             694     3   p    v                HL110 = HL1(I) * 10. / HGT(I,KK)
             695     3   p    v                PM10(I) = (A0 + A1 * HL110) * HL110 &
             696     3                                 / (1. + B1 * HL110 + B2 * HL110 * HL110)
             697     3   p    v                HL12 = HL1(I) * 2. / HGT(I,KK)
             698     3   p    v                PH2(I) = (A0P + A1P * HL12) * HL12 &
             699     3                                 / (1. + B1P * HL12 + B2P * HL12 * HL12)
             700     3   p    v              endif
             701     3   p    v              if(dtv(i).lt.0.and.hlinf(i).lt.-.5) then
             702     3   p    v                hl1(i) = -hlinf(i)
             703     3               !ibm         pm(i) = log(hl1(i)) + 2. * hl1(i) ** (-.25) - .8776
             704     3               !ibm         ph(i) = log(hl1(i)) + .5 * hl1(i) ** (-.5) + 1.386
             705     3   p    v                hl1x=sqrt(hl1(i))
             706     3   p    v                pm(i) = log(hl1(i)) + 2./(sqrt(hl1x)) - .8776
             707     3   p    v                ph(i) = log(hl1(i)) + .5/hl1x + 1.386
             708     3               !
             709     3   p    v                HL110 = HL1(I) * 10. / HGT(I,KK)
             710     3   p    v                hl110x=sqrt(hl110)
             711     3               !         PM10(I) = LOG(HL110) + 2. * HL110 ** (-.25) - .8776
             712     3   p    v                PM10(I) = LOG(HL110) + 2. / (sqrt(hl110x)) - .8776
             713     3               !
             714     3   p    v                HL12 = HL1(I) * 2. / HGT(I,KK)
             715     3   p    v                hl12x=sqrt(hl12)
             716     3               !         PH2(I) = LOG(HL12(I)) + .5 * HL12(I) ** (-.5) + 1.386
             717     3   p    v                ph2(i) = log(hl12) + .5/hl12x + 1.386
             718     3               
             719     3   p    v              endif
             720     2               !
             721     2               !  finish the exchange coefficient computation to provide fm and fh
             722     2               !
             723     2               !
             724     2   p    v              fm(i) = fm(i) - pm(i)
             725     2   p    v              fh(i) = fh(i) - ph(i)
             726     2   p    v              fm10(i) = fm10(i) - pm10(i)
             727     2   p    v              fh2(i) = fh2(i) - ph2(i)
             728     2               !
             729     2   p    v              phim(i) = ca * ca / (fm(i) * fm(i))
             730     2   p    v              phih(i) = ca * ca / (fm(i) * fh(i))
             731     2   p    v              ustar(i) = sqrt(phim(i) * sfcw(i) * sfcw(i))
             732     2               !
             733     2               !      endif
             734     2   p    v            enddo
             735     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 135
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ustar, tg, hgt, sfcw, phih, qt, qsfc, tt
                                   <<<      pk2, vt, ut, wq, wt, wv, wu
                                   <<< Loop-information  End >>>
             736     2  pp    v            do i=1,nxj
             737     2               !     if(.not. ocean(i))then
             738     2   p    v            yy1   =dt*ustar(i)*ustar(i) / (2.0*hgt(i,kk)*sfcw(i))
             739     2   p    v            btest = 0.5 + (yy1-1.0)*0.5
             740     2   p    v            bl    = max (0.5, min (1.0, btest) )
             741     2   p    v            al    = 1.0 - bl
             742     2               
             743     2   p    v            wu(i)=ut(i,kk) * (1.-al*yy1) / (1.+bl*yy1)
             744     2   p    v            wv(i)=vt(i,kk) * (1.-al*yy1) / (1.+bl*yy1)
             745     2   p    v            xx1    = phih(i)*dt*sfcw(i) / (2.0*hgt(i,kk))
             746     2   p    v            wt(i) = ( tt(i,kk)*(1.0-al*xx1)+xx1*tg(i)/pk2(i,kk) )/(1.0+bl*xx1)
             747     2   p    v            wq(i) = ( qt(i,kk)*(1.0-al*xx1) + xx1*qsfc(i) ) / (1.0+bl*xx1)
             748     2               !     endif
             749     2   p    v            enddo
             750     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 153
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qt, vt, ut, wq, tt, wt, wv, wu, phim
                                   <<<      phih, qsfc, pk2, qstar, tg, tstar, ustar
                                   <<<    PREFETCH(SOFT) : 2
                                   <<<     SEQUENTIAL : 2
                                   <<<      sfcw: 2
                                   <<< Loop-information  End >>>
             751     2  pp    v            do i=1,nxj
             752     2               !     if(.not. ocean(i))then
             753     2   p    v            wu(i) = 0.5*(wu(i)+ut(i,kk))
             754     2   p    v            wv(i) = 0.5*(wv(i)+vt(i,kk))
             755     2   p    v            wt(i) = 0.5*(wt(i)+tt(i,kk))
             756     2   p    v            wq(i) = 0.5*(wq(i)+qt(i,kk))
             757     2   p    v            sfcw(i) =max( 1.0e-2,sqrt( wu(i)*wu(i)+wv(i)*wv(i) ))
             758     2   p    v            ustar(i)=sqrt(phim(i)*sfcw(i)*sfcw(i))
             759     2   p    v            tstar(i)=phih(i)*sfcw(i)*(wt(i)*pk2(i,kk)-tg(i))/ustar(i)
             760     2   p    v            qstar(i)=phih(i)*sfcw(i)*(wq(i)-qsfc(i))/ustar(i)
             761     2               !     endif
             762     2   p    v            enddo
             763     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 35
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ps, fh2, rosfc, p2, fh, tg, pk2, wt, t2
                                   <<<      qsfc, wq, fm10, q2, wu, fm, u10
                                   <<<    PREFETCH(SOFT) : 4
                                   <<<     SEQUENTIAL : 4
                                   <<<      wv: 2, v10: 2
                                   <<< Loop-information  End >>>
             764     2  pp    v            do i=1,nxj
             765     2   p    v            fm10(i)= max(fm10(i),1.0e-3)
             766     2   p    v            fh2(i)= max(fh2(i),1.0e-3)
             767     2               !
             768     2   p    v            v10(i)=wv(i)*fm10(i)/fh(i)
             769     2   p    v            u10(i)=wu(i)*fm10(i)/fm(i)
             770     2               !
             771     2   p    v            q2(i)=qsfc(i)*(1.-fh2(i)/fh(i))+wq(i)*fh2(i)/fh(i)
             772     2   p    v            t2(i)=tg(i)/pk2(i,kk)*(1.-fh2(i)/fh(i))+wt(i)*fh2(i)/fh(i)
             773     2               !
             774     2               ! convert t2 from potential temp. to temp
             775     2   p    v            p2(i)=(ps(i)*100.-rosfc(i)*g*2.)/100.
             776     2   p    v            t2(i)=t2(i)*(p2(i)/1000.)**xkapa
             777     2               !f    t2(i)=t2(i)*exp(xkapa*log(p2/1000.))
             778     2   p    v            enddo
             779     1               !
             780     1                     call qsatq( nxj, t2, p2, wk2)
             781     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 552
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q2, wk2, rh2
                                   <<< Loop-information  End >>>
             782     2  pp   2v            do i=1,nxj
             783     2   p   2v             q2(i)=min(wk2(i),q2(i))
             784     2   p   2v             rh2(i)=q2(i)/wk2(i)
             785     2   p   2v            enddo
             786     1               !
             787     1                     endif
             788                     !
             789                     !---- ncepsfc end
             790                     !
             791                     !---------------------------------------------------------
             792                     !  define roughness and evaporation  over ocean
             793                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 263
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.73, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ustar, sfcw, wq, phih, qsfc, ocean
                                   <<<      rosfc, z0, evap
                                   <<< Loop-information  End >>>
             794     1  pp    v            do i=1,nxj
             795     2   p    v            if(ocean(i))then
             796     2   p    v             z0(i) = 0.032 *ustar(i)*ustar(i)/g
             797     2   p    v             if(ncepsfc)z0(i) = 0.014 *ustar(i)*ustar(i)/g
             798     2   p    v             z0(i)= max(1.5e-5,min(z0(i),0.01))
             799     2               !
             800     2   p    v             evap(i)=rosfc(i)*hltm*phih(i)*sfcw(i)*(qsfc(i)-wq(i))
             801     2   p    v            endif
             802     1               
             803     1   p    v            enddo
             804                     !
             805                     ! ...................................
             806                     ! prepare for penman-monteith method. to calculate potential evaporation
             807                     ! ...................................
             808                     ! change wt from potential tmp. to temperature
             809                     !
             810                     !
             811                     ! compute soil/snow/ice heat flux(gfx)
             812                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gfx, land
                                   <<< Loop-information  End >>>
             813     1   s    s            do i=1,nxj
             814     1   p    v            gfx(i)=0.
             815     2   p    m            if(land(i))then
             816     2   m    s             smcz(i)=0.5*(smc(i,1)+0.2)
             817     2   m    m             dft0(i)=xtsoil(smcz(i),istyp(i),tsat,dfkt)
             818     2   p    s            elseif(ice(i))then
             819     2   p    s             dft0(i)=2.2
             820     2   p    v            endif
             821     1   p    m            enddo
             822                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 154
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 40, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gfx, flagsnw, zsoil, dft0, stsoil, tsurf
                                   <<<      snr, factsnw, twork, ocean
                                   <<< Loop-information  End >>>
             823     1  pp    v             do i=1,nxj
             824     2   p    v             if(.not. ocean(i))then
             825     3   p    v              if(flagsnw(i))then
             826     3   p    v               tflx=min(twork(i),tsurf(i))
             827     3   p    v               gfx(i)=-dfsnow*(tflx-stsoil(i,1))/  &
             828     3                               (factsnw(i)*max(snr(i)/1000.,0.001))
             829     3   p    v              else
             830     3   p    v               gfx(i)=-dft0(i)*(tsurf(i)-stsoil(i,1))/ &
             831     3                               (-0.5*zsoil(i,1))
             832     3   p    v              endif
             833     2   p    v             gfx(i)=max(gfx(i),-200.)
             834     2   p    v             gfx(i)=min(gfx(i),200.)
             835     2   p    v             endif
             836     1   p    v             enddo
             837                     !
             838                     ! calculate potential evaporation: ep(w/m2)
             839                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 137
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ocean, twork, t12, t14, tt, pk2, ta
                                   <<<      phih, sfcw, rosfc, rch, rld, gfx, ss
                                   <<<      rnet, rsmall
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      qt: 2, qs1: 2, delta: 2, termb: 2
                                   <<<      terma: 2, ep: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1

             885     2   p    v              endif
             886     1               !
             887     2   p    s              if(flag(i))then
             888     2               !       tref(i)=0.75*tsat(istyp(i))
             889     2               !       twilt(i)=twlt(istyp(i))
             890     2               !       fx(i)=-2.*df1(i)*(smc(i,1)-0.23)/zsoil(i,1)-xkt1(i)
             891     2   m    s              tref(i)=smref(istyp(i))
             892     2   p    s              twilt(i)=smwlt(istyp(i))
             893     2   p    s              smcdry(i)=smdry(istyp(i))
             894     2   m    s              fx(i)=-2.*df1(i)*(smc(i,1)-smcdry(i))/zsoil(i,1)-xkt1(i)
             895     2   p    s              fx(i)=min(fx(i),ep(i)/hltm)
             896     2   p    s              fx(i)=max(fx(i),0.)
             897     2               !
             898     2               !       edir(i)=fx(i)*(1-sigmaf(i))*partlnd(i)
             899     2               !---another dir evap =(1-sigmaf)*ep*beta (mahfouf and noilhan 1991)
             900     2               !

             573                     !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
             574                     !
             575                     !---- ncepsfc
             576     1                     if(ncepsfc)then
             577     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qsfc, tg, wt2, pk2, tt, hgt, qt, adtv
                                   <<<      dtv, wt1, zsz0, sfcw, rb, ocean, ustar
                                   <<<      z0
                                   <<<    PREFETCH(SOFT) : 34
                                   <<<     SEQUENTIAL : 34
                                   <<<      pm10: 2, z0max: 2, restar: 2, rat: 2
                                   <<<      ztmax: 2, olinf: 2, hl1: 2, hlinf: 2
                                   <<<      fm10: 2, phim: 2, pm: 2, fm: 2, ph2: 2
                                   <<<      fh2: 2, ph: 2, phih: 2, fh: 2

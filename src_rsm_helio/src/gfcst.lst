 Main program "gfcst"
  (inc)(line-no.)(nest)(optimize)
               1                           program gfcst
               2                     !
               3                     ! main program of CWBGFS
               4                     ! modify to f90 bt C-H Lee and sort by River Chen in 2015
               5                     !
               6                           use param
               7                           use const
               8                     !
               9                           implicit none
              10                     
              11                           integer  no
              12                     !
              13                     !  logical io units:
              14                     !
              15                     !  input namelist file = 'namlsts'
              16                     !  date-time-group file = 'crdate'
              17                     !  output directives file = 'ocards'
              18                     !  model history file = 'cwbout'
              19                     !  output model history for diabatic variables='phyout'
              20                     !  input file of path/file names='filist'
              21                     !
              22                     
              23                           call mpe_init
              24                     !
              25                     !     get model constants
              26                     !
              27                           call cons
              28                     !
              29                     !  read in initial data and prepare for initialization/forecast
              30                     !
              31                           call getrdy
              32                     !
              33                     !  initialization would be done here, taking initial spectral fields
              34                     !  out of 'getrdy' and preparing them for 'intgrt'.  for identification
              35                     !  purposes only, initialization history file data is assigned
              36                     !  "tau"=1.0.
              37                     !
              38     1                     if (donnmi.and.taui.lt.1.0) then
              39     1                        no=2*((jtrun+1)/2)+(jtrun/2)+10
              40     1                        call initial(no,jtrun,jtmax,lev,nx,my,my_max,mlmax)
              41     1                     endif
              42                     !
              43                     !  recompute eigen value for semi-implicit scheme
              44                     !
              45                           call matrix_hybrid_cwb ( cp,sigma,dsigma,ptop,ptmeans,tmeans,spalm   &
              46                                       , eigval,evecin,evectr,arrhyd,arsddt,pmcor,tmcor )
              47                     !
              48                     !  time integration
              49                     !
              50                           call intgrt
              51                     !
              52                           call mpe_finalize
              53                           call dmsexit(0)
              54                     !
              55                           stop
              56                           end


            2465                     !  REAL, PARAMETER:: zepcor=7.3e-05           ! minimum corilol force, 7.3 e-05 at 30 deg
            2466                       real, PARAMETER:: zepcor=0.                 ! minimum corilol force, 7.3 e-05 at 30 deg
            2467                       real:: fr=7.E-5                             ! = friction factor for current (1/s). It is due to that one-column model neglect horizontal diffusion.

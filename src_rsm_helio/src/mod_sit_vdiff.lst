            4453     3                      if(GDCHK2) print*,"ps: 10.1.0 pfluxw2=",pfluxw2
            4454     3               #endif
            4455     3                           pfluxw2=pfluxw2+pfluxi2+(  pzsi(jl,0)*&
            4456     3               &                ( alf+csn*(tmelt-tsim(1))+clw*(wtm(nls+1)-tmelt) )&
            4457     3               &             +pzsi(jl,1)*&
            4458     3               &                ( alf+cice*(tmelt-tsim(3))+clw*(wtm(nls+1)-tmelt) )&
            4459     3               &             +psilw(jl,0)*clw*(wtm(nls+1)-tmelt)&

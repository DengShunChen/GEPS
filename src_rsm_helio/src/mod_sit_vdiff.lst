            4253     2                       if(GDCHK2) print *,"ps: 900 9.4 LU, RHS=",RHS(:)
            4254     2                       if(GDCHK2) print *,"ps: 900 9.4 LU, SOL=",SOL(:)
            4255     2               #endif
            4256     2               
            4257     2               !         calculate FCE of snow surface (snow melt positive)
            4258     2                         fces=rhosn*csn*hesn*&
            4259     2               &           ( -tmelt+tsim(0)-beta*Y(0)*(tmelt-SOL(1))&
            4260     2               &                       -(1.-beta)*Y(0)*(tsim(0)-tsim(1)) )&
            4261     2               &           +zdtime*( -pfluxi2 )
            4262     2                       ELSE
            4263     2                         lsm=.FALSE.
            4264     2                         fces=0.
            4265     2                       ENDIF
            4266     1                     ENDIF
            4267                     !
            4268                     !     9.5 Determine Phase Change Energy in the ice/water interface
            4269                     !
            4270     1                     IF ((mas.LT.4).AND.(.NOT.lsoil)) THEN
            4271     1                       lwf=.TRUE.
            4272     2                       IF ( ((mas.EQ.2).AND.(heice.LE.xicri)).OR.&
            4273     2               &            ((mas.EQ.0).AND.(heice.LE.xicri).AND.&
            4274     2               &             (hesn.LE.csncri)) ) THEN

            4465     3                      if(GDCHK2) print*,"ps: 10.1.1 tmp=",tmp,",ptemp2(jl)=",ptemp2(jl),",clw=",clw
            4466     3                      if(GDCHK2) print*,"ps: 10.1.1 alf=",alf,",csn=",csn,",tmelt=",tmelt,",rhoh2o/zdtime=",rhoh2o/zdtime
            4467     3                      if(GDCHK2) print*,"ps: 10.1.1 psilw(jl,0)=",psilw(jl,0),",psilw(jl,1)=",psilw(jl,1)
            4468     3                      if(GDCHK2) print*,"ps: 10.1.1 pzsi(jl,0)=",pzsi(jl,0),",pzsi(jl,1)=",pzsi(jl,1),",cice=",cice
            4469     3                      if(GDCHK2) print*,"ps: 10.1.1 tsim(1)=",tsim(1),",tsim(3)=",tsim(3)
            4470     3                      if(GDCHK2) print*,"ps: 10.1.1 pfluxw2=",pfluxw2
            4471     3               #endif

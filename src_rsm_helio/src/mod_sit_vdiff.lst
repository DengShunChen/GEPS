            7167     3                          restore_u2=(pobswu(jl,jk)-pwu(jl,jk))*(1.-fratio)+restore_u2*fratio
            7168     3                        ENDIF
            7169     2                     ELSEIF ((pobswu(jl,jk).NE.xmissing).AND.(suv_restore_time_all.EQ.0.)) THEN
            7170     2                        restore_u2=(pobswu(jl,jk)-pwu(jl,jk))
            7171     2                     ELSEIF ((suv_restore_time_all.LT.0.)) THEN

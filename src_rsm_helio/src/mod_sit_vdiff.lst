            4339     2  pp   4v              DO jk = 0, nle,1
            4340     2   p   4v                pwt(jl,jk) = pwt(jl,nle+1)
            4341     2   p   4v              END DO
            4342     1               !       Set temp of the missing water to be the temp underneath, soil
            4343     1               !       temp at this case.
            4344     1                     ENDIF
            4345                     !
            4346                     !     9.6.2 Ice, Snow & Skin Temp
            4347                     !!!      IF (mas.LE.2) THEN

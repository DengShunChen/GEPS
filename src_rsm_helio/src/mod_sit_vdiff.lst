            7916                         CONTAINS
            7917                         !#######################################################################
            7918                         ! <SUBROUTINE NAME="sit_vdiff_restart">
            7919                         ! <DESCRIPTION>
            7920                         !  Write out restart files registered through register_restart_file
            7921                         ! </DESCRIPTION>
            7922                         !SUBROUTINE sit_vdiff_restart(Sit, time_stamp)
            7923                         SUBROUTINE sit_vdiff_restart( time_stamp)
            7924                           IMPLICIT NONE
            7925                           !!! type (sit_vdiff_data_type), intent(inout), optional :: Sit
            7926                           character(len=*),         intent(in), optional :: time_stamp
            7927                     
            7928                           !!! CALL save_restart(Sit_restart, time_stamp)
            7929                          !CALL icebergs_save_restart(Ice%icebergs)

             510                     CONTAINS
             511                     !------------------------------------------------------------------------------
             512                     SUBROUTINE sit_vdiff_init ( kproma, kbdim, jrow, istep,               &
             513                            !
             514                            ! 1-input only, original ATM/SIT variabels
             515                            !
             516                                       plat,       plon,                                   &
             517                                       psitmask,   pbathy,     pwlvl,          &
             518                                       pocnmask,   obox_mask,                              &
             519                                       psni,       psiced,     ptsi,                       &
             520                                       pobsseaice, pobswtb,    pobswsb,                    &
             521                                       pctfreez2,                                          &
             522                            ! 2-d SIT vars
             523                                       pwtb,       pwub,       pwvb,                       &
             524                                       pwsb,                                               &
             525                                       psubfluxw,  pwsubsal,                               &
             526                                       pcc,        phc,        pengwac,                    &
             527                                       psc,        psaltwac,                               &
             528                                       pwtfns,     pwsfns,                                 &
             529                            ! 3-d SIT vars: snow/ice
             530                                       pzsi,       psilw,      ptsnic,                     &
             531                            ! 3-d SIT vars: water column
             532                                       pobswt,     pobsws,     pobswu,    pobswv,          &
             533                                       pwt,        pwu,        pwv,       pww,             &
             534                                       pws,        pwtke,      pwlmx,                      &
             535                                       pwldisp,    pwkm,       pwkh,                       &
             536                                       pwrho1000,                                          &
             537                                       pwtfn,      pwsfn,      pwtfn0,    pwsfn0,          &
             538                                       pawufl,     pawvfl,     pawtfl,                     &
             539                                       pawsfl,     pawtfl0,    pawsfl0,                    &
             540                                       pawtkefl,                                           &
             541                            ! 4-output only, original ATM variabels
             542                                       pseaice,                                            &
             543                                       pgrndcapc,  pgrndhflx,  pgrndflux,psftobswt )
             544                     !  ---------------------------------------------------------------------
             545                     !
             546                     !                           SUBROUTINE DESCRIPTION
             547                     !
             548                     ! 1. FUNCTION DESCRIPTION
             549                     !
             550                     !     THIS SUBROUTINE initialize the sit_vdiff variables including T,S,u,v profiles
             551                     !
             552                     ! 2. CALLING MODULES
             553                     !
             554                     !          *sit_vdiff_init* is called from *initemp.
             555                     !
             556                     ! 3. PARAMETER SPECIFICATION
             557                     !
             558                     !      Arguments.
             559                     !      ----------
             560                     ! local dimensions
             561                     !  kproma   : IF(jrow==ldc%ngpblks, ldc%npromz,ldc% nproma),
             562                     !             number of local longitudes
             563                     !  kbdim    : ldc% nproma, gauss grid description
             564                     !  jrow     : sequential index for output message
             565                     !  istep    : # of time steps
             566                     !  pcoriol : coriol factor = 2*omega*sin(latitudes)  (1/s)                         I
             567                     !  plat    : latitide (geg)                                                        I
             568                     !  plon    : longitude (deg)                                                       I
             569                     ! 2-d SIT vars
             570                     !  pobsseaice  : observed sea ice fraction (fraction)                              I
             571                     !  pobswtb     : observed bulk sea surface temperature (K)                         I
             572                     !  pobswsb    : observed salinity (PSU, 0/00)                                      I
             573                     !  psitmask : mask for sit(1=.TRUE., 0=.FALSE.)                                    I
             574                     !  pbathy  : bathymeter (topography or orography) of ocean (m)                     I
             575                     !  pctfreez2 : ref water freezing temperature (K)                                  I
             576                     !  pwlvl  : current water level (ice/water interface) a water body grid            I/O
             577                     !  pocnmask : fractional mask for 3-D ocean grid (0-1)                             I
             578                     !  obox_mask : 3-D ocean nudging mask, =0: nudging, = 1 (>0): nudging              I
             579                     !  pwtb: bulk water temperature (K)                                                O
             580                     !  pwub: bulk water u current (m/s)                                                O
             581                     !  pwvb: bulk water v current (m/s)                                                O
             582                     !  pwsb: bulk water salinity (PSU)                                                 O
             583                     !  psubfluxw: subsurface ocean heat flux (W/m2, + upward)                          O
             584                     !  pwsubsal: subsurface ocean salinity flux (m*PSU/s, + upward)                    O
             585                     !  pcc: cold content per water fraction (ice sheet+openwater) (J/m2)
             586                     !    (energy need to melt snow and ice, i.e., energy below liquid water at tmelt)  I/O
             587                     !  phc: heat content per water fraction (ice sheet+openwater) (J/m2)
             588                     !    (energy of a water column above tmelt)                                        I/O
             589                     !  pengwac: accumulated energy per water fraction (ice sheet+openwater) (+ downward, J/m2)
             590                     !    (pfluxw+pfluxi+rain/snow advected energy in respect to liquid water at
             591                     !     tmelt)*dt                                                                    I/O
             592                     !  psaltwac: accumulated salt into water fraction (+ downward, PSU*m)              I/O
             593                     !
             594                     !  pgrndcapc: areal heat capacity of the uppermost sit layer (snow/ice/water)
             595                     !    (J/m**2/K)                                                                    I/O
             596                     !  pgrndhflx: ground heat flux below the surface (W/m**2)
             597                     !    (+ upward, into the skin layer)                                               I/O
             598                     !  pgrndflx:  acc. ground heat flux below the surface (W/m**2*s)
             599                     !    (+ upward, into the skin layer)                                               I/O
             600                     ! 3-d SIT vars: snow/ice
             601                     !  pzsi   :
             602                     !        pzsi(jl,0): dry snow water equivalent (m)                                 I/O
             603                     !        pzsi(jl,1): dry ice water equivalent (m)                                  I/O
             604                     !  psilw  :
             605                     !        psilw(jl,0): snow liquid water storage (m)                                I/O
             606                     !        psilw(jl,1): ice liquid water storage (m)                                 I/O
             607                     !  ptsnic   :
             608                     !        ptsnic(jl,0): snow skin temperatrue (jk)                                  I/O
             609                     !        ptsnic(jl,1): mean snow temperatrue (jk)                                  I/O
             610                     !        ptsnic(jl,2): ice skin temperatrue (jk)                                   I/O
             611                     !        ptsnic(jl,3): mean ice temperatrue (jk)                                   I/O
             612                     ! 3-d SIT vars: water column
             613                     !  pobswt: observed potentail water temperature (K)                                I/O
             614                     !  pobsws: observed salinity (PSU, 0/00)                                           I/O
             615                     !  pobswu: observed u-current (m/s)                                                I/O
             616                     !  pobswv: observed v-current (m/s)                                                I/O
             617                     !  pwt      : potential water temperature (K)                                      I/O
             618                     !  pwu      : u current (m/s)                                                      I/O
             619                     !  pwv      : v current (m/s)                                                      I/O
             620                     !  pww      : w current (m/s)                                                      I/O
             621                     !  pws      : practical salinity (0/00)                                            I/O
             622                     !  pwtke    : turbulent kinetic energy (M2/S2)                                     I/O
             623                     !  pwlmx    : mixing length (m)                                                    O
             624                     !  pwldisp  : dissipation length (m)                                               O
             625                     !  pwkm     : eddy diffusivity for momentum (m2/s)                                 O
             626                     !  pwkh     : eddy diffusivity for heat (m2/s)                                     O
             627                     !  pwrho1000: potential temperature at 1000 m (PSU)                                O
             628                     !  pwtfn  : nudging flux into sit-ocean at each level (K, accum. var.)             I/O
             629                     !  pwsfn  : nudging salinity flux into sit-ocean at each level (PSU, accum. var.)  I/O
             630                     !  pwtfns : nudging flux into sit-ocean for an entire column (J/m**2, accum.var.), i.e.
             631                     !     pwtfns=SUM(pwtfn(jl,:))                                                      I/O
             632                     !  pwsfn  : nudging salinity flux into sit-ocean for an entire column (PSU*m,accum. var.,)
             633                     !     i.e., pwsfns=SUM(pwsfn(jl,:)                                                 I/O
             634                     !  pwtfn0  : nudging flux into sit-ocean at each level (K, accum. var.)             I/O
             635                     !  pwsfn0  : nudging salinity flux into sit-ocean at each level (PSU, accum. var.)  I/O
             636                     !  pawufl : advected u flux at each level (positive into ocean) (m/s/s)            I
             637                     !  pawvfl : advected v flux at each level (positive into ocean) (m/s/s)            I
             638                     !  pawtfl : advected temperature flux at each level (positive into ocean) (K/s)(12 mons)    I
             639                     !  pawsfl : advected salinity flux at each level (positive into ocean) (PSU/s)(12 mons)     I
             640                     !  pawtfl0 : advected temperature flux at each level (positive into ocean) (K/s)(1 record)    I
             641                     !  pawsfl0 : advected salinity flux at each level (positive into ocean) (PSU/s)(1 record)     I
             642                     !  pawtkefl : advected tke at each level (positive into ocean) (m3/s3)             I
             643                     ! - variables internal to physics
             644                     ! - water body or ml_ocean variables
             645                     !  pseaice   : ice cover (fraction of 1-SLM) (0-1)                                 I/O
             646                     !  psni      : snow thickness over ice (m in water equivalent)                     I/O
             647                     !  psiced    : ice thickness (m in water equivalent)                               I/O
             648                     !  ptsl      : calcuated Earth's skin temperature from vdiff/tsurf at t+dt (K)     I/O
             649                     !  ptslm     : calcuated Earth's skin temperature from vdiff/tsurf at t (K)        I/O
             650                     !  ptslm1    : calcuated Earth's skin temperature from vdiff/tsurf at t-dt (K)     I/O
             651                     !  psftobswt : the shift swt in mixed layer based on difference of obswtb and obswt10m I/O
             652                     ! 2-d SIT vars
             653                     
             654                       IMPLICIT NONE
             655                     
             656                       ! local dimensions
             657                       INTEGER, INTENT(in)                      :: kproma ! number of local longitudes
             658                       INTEGER, INTENT(in)                      :: kbdim  ! number of local longitudes
             659                     
             660                       ! gauss grid description
             661                       INTEGER, INTENT(in)                      :: jrow   ! sequential index
             662                       INTEGER, INTENT(in)                      :: istep  ! # of time steps
             663                       real, INTENT(in)::                                                      &
             664                            plat(kbdim), plon(kbdim)
             665                            ! pcoriol(kbdim),   plat(kbdim), plon(kbdim)
             666                     
             667                       real, INTENT(in out):: pseaice(kbdim), psni(kbdim), psiced(kbdim),     &
             668                          ptsi(kbdim)
             669                     ! 2-d SIT vars
             670                       real, INTENT(in out) ::                                                &
             671                            pwtfn(kbdim,0:lkvl+1),  pwsfn(kbdim,0:lkvl+1)
             672                       real, INTENT(in out) ::                                                &
             673                            pwtfn0(kbdim,0:lkvl+1),  pwsfn0(kbdim,0:lkvl+1)
             674                       real, INTENT(in out) ::                                                &
             675                            pwtfns(kbdim),  pwsfns(kbdim)
             676                       real, INTENT(in):: pobsseaice(kbdim)
             677                       real, INTENT(in out):: pobswtb(kbdim),      pobswsb(kbdim)
             678                     ! 2-d SIT vars
             679                       real, INTENT(in)::   psitmask(kbdim)         ! grid mask for lsit (1 or 0)

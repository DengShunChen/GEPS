            4276     2                         fcew=rhowcw*hew*( -SOL(4)+wtm(0)&
            4277     2               &             -beta*Y(4)*(SOL(4)-SOL(5+nls))&
            4278     2               &             -(1.-beta)*Y(4)*(wtm(0)-wtm(nls+1))  )&
            4279     2               &           +zdtime*(  zsoflw* ( FFN(0.)-FFN(-hw(0)) )&
            4280     2               &             -(pfluxi2+pfluxw2+zsoflw) )
            4281     2               
            4282     2               !!!          fcew=rhowcw*hew*( -tmelt+wtm(0)&
            4283     2               !!!&             -beta*Y(4)*(tmelt-SOL(5+nls))&
            4284     2               !!!&             -(1.-beta)*Y(4)*(wtm(0)-wtm(nls+1))  )&

            4397     3                           pzsim=pzsi(jl,1)
            4398     3                           tmp=ptsnic(jl,3)
            4399     3               !
            4400     3                           hw(nls+1)=hw1m-dz
            4401     3                           fcewf=fcewf+dz*rhoh2o*&
            4402     3               &             (alf+clw*(pwt(jl,nls+1)-pctfreez2(jl)))
            4403     3                           zsf=zsf-dz*salti*wsm(nls+1)
            4404     3                           pzsi(jl,1)=pzsi(jl,1)+dz
            4405     3               !           modify ice mean temp due to adding in new freezed
            4406     3               !           ice with temp = pctfreez2(jl)
            4407     3                           ptsnic(jl,3)=ptsnic(jl,3)+dz*(pctfreez2(jl)-ptsnic(jl,3))/pzsi(jl,1)
            4408     3                           nls=nls+1
            4409     3                         ENDDO
            4410     2               !         roll back one layer to point correct index
            4411     2                         nls=nls-1
            4412     2               
            4413     3                         IF(fcewf.GT.0.) THEN
            4414     3                           dz=-fcewm/rhoh2o/(alf+clw*(pwt(jl,nls+1)-pctfreez2(jl)))
            4415     3                           hw(nls+1)=hw1m-dz
            4416     3                           zsf=sfm-dz*salti*wsm(nls+1)
            4417     3                           pzsi(jl,1)=pzsim+dz

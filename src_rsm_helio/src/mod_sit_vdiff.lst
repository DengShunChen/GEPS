            2441                       real,PARAMETER::xlkmin=0.        ! minimum pwlmx (0.5,0.8) produced unreasoable high SST near Equator bjt 2013/9, v0.984
            2442                       real,PARAMETER::xldispmin=0.3 ! minimum pwldisp

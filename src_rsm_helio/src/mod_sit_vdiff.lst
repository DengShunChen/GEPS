            4658     3               !           The model is unable to judge melt or freeze, just arbitraily
            4659     3               !           pick one.
            4660     3                           CONTINUE
            4661     3                         ENDIF
            4662     2                       ELSE
            4663     2                         pzsi(jl,0)=pzsi(jl,0)-tmp
            4664     2                         psilw(jl,0)=psilw(jl,0)+tmp
            4665     2    i                    CALL update_snow_ice_property(pzsi(jl,0),pzsi(jl,1),hsn,hesn,hice,heice,pseaice(jl))
            4666     2               
            4667     2                         !!! hsn=HSNFN(pzsi(jl,0))
            4668     2                         !!! hesn=HEFN(hsn/4.,xksn,omegas)
            4669     2                       ENDIF
            4670     1                     ENDIF
            4671                     
            4672                     ! ----------------------------------------------------------------------
            4673     1                     IF ((.NOT.lsoil).AND.(lsit_salt)) THEN
            4674     1               ! ----------------------------------------------------------------------
            4675     1               !
            4676     1               !*   11. UPDATE SALINITY DUE TO VERTICAL MIXING
            4677     1               !        BY SOLVING A TRI-DIAGONAL MATRIX:
            4678     1               !
            4679     1               ! ----------------------------------------------------------------------
            4680     1                1100 CONTINUE
            4681     1               !      PRINT *, ", I am in 11) UPDATE Salinity."
            4682     1                       CALL LKDIFKH(hew,X,Y)
            4683     1               !
            4684     1               !
            4685     1               !* 11.0 Calc. the salinity flux
            4686     1               !
            4687     1               !
            4688     1               !*   pwlvl(jl)=pbathy(jl)+SUM(hw(nls+1:nle))
            4689     1               !*   Total Fresh Water Inflow = (pwlvl(jl)-wlvlm)/zdtime
            4690     1               !
            4691     1               !!!     ppme2_int(jl)=(pbathy(jl)+SUM(hw(nls+1:nle))-wlvlm)/zdtime
            4692     1               !!! bjt 2010/2/22
            4693     1               !!!     IF(.NOT.lwaterlevel) THEN
            4694     1               !!!       zsf=-ppme2_int(jl)*wsm(nls+1)
            4695     1               !!!     ENDIF
            4696     1               !
            4697     1                    psaltwac(jl)=psaltwac(jl)-zsf
            4698     1               !
            4699     1               !* 11.1 SKIN LAYER
            4700     1               !
            4701     1                       jk = 0
            4702     2                       IF (.FALSE.) THEN
            4703     2                       !!! v7.5 for including runoff salt flux. (2010/5/8) (bjt)
            4704     2                       !!! Since runoff from river usually enters a water column in the top few meters,
            4705     2                       !!! not only in the skin layer
            4706     2               !!!        IF (lssst) THEN
            4707     2                         RHS(4)= wsm(0)-(1.-beta)*Y(4)*(wsm(0)-wsm(nls+1))-zsf/hew
            4708     2               !         Total Fresh Water Inflow = (pwlvl(jl)-wlvlm)/zdtime
            4709     2                         AA(4,1)=0.
            4710     2                         AA(4,3)=-beta*Y(4)
            4711     2                         AA(4,2)= 1. - AA(4,1) - AA(4,3)
            4712     2                       ELSE
            4713     2                         RHS(4)=0.
            4714     2                         AA(4,1)=0.
            4715     2                         AA(4,3)=-1.
            4716     2                         AA(4,2)= 1.
            4717     2                       ENDIF
            4718     1               !
            4719     1               !* 11.2 FIRST LAYER
            4720     1               !
            4721     1                       jk=1
            4722     2                       IF (.FALSE.) THEN
            4723     2                       !!! v7.5 for including runoff salt flux. (2010/5/8) (bjt)
            4724     2                       !!! Since runoff from river usually enters a water column in the top few meters,
            4725     2                       !!! not only in the skin layer
            4726     2               !!!        IF (lssst) THEN
            4727     2                         RHS(4+jk)= wsm(nls+jk)-hew/hw(nls+jk)*wsm(0)+ &
            4728     2               &          (1.-beta)*&
            4729     2               &          ( X(4+jk)*(wsm(0)-wsm(nls+jk))-&
            4730     2               &            Y(4+jk)*(wsm(nls+jk)-wsm(nls+jk+1)) )+ &
            4731     2               &          zdtime*pawsfl(jl,nls+jk)+zdtime*pawsfl0(jl,nls+jk)
            4732     2                         AA(4+jk,1)=-beta*X(4+jk)-hew/hw(nls+jk)
            4733     2                         AA(4+jk,3)=-beta*Y(4+jk)
            4734     2                         AA(4+jk,2)= 1. +beta*X(4+jk)+beta*Y(4+jk)
            4735     2                       ELSE
            4736     2                         RHS(4+jk)= wsm(nls+jk)-(1.-beta)*Y(4+jk)*(wsm(0)-wsm(nls+jk)) &
            4737     2               &          -zsf/hw(nls+jk)+zdtime*pawsfl(jl,nls+jk)+zdtime*pawsfl0(jl,nls+jk)
            4738     2                         AA(4+jk,1)=0.
            4739     2                         AA(4+jk,3)=-beta*Y(4+jk)
            4740     2                         AA(4+jk,2)= 1. - AA(4+jk,1) - AA(4+jk,3)
            4741     2                       ENDIF
            4742     1               !
            4743     1               !       Note AA Matrix from jk=5 to nle is the same as pwt matrix
            4744     1               !
            4745     1               !* 11.3 MIDDLE LAYERS (jk=2,nle)
            4746     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 364
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.85, ITR: 88, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      AA, X, Y, wsm, RHS
                                   <<< Loop-information  End >>>
            4747     2  pp    v              DO jk=2,nle-nls
            4748     2               !         If nle less than nls+2, do-loop won't do anything.
            4749     2   p    v                RHS(jk+4)= wsm(nls+jk)+(1.-beta)*(X(jk+4)*(wsm(nls+jk-1)-wsm(nls+jk))-&
            4750     2               &           Y(jk+4)*(wsm(nls+jk)-wsm(nls+jk+1)))+ &
            4751     2               &           zdtime*pawsfl(jl,nls+jk)+zdtime*pawsfl0(jl,nls+jk)
            4752     2   p    v                AA(4+jk,1)=-beta*X(4+jk)
            4753     2   p    v                AA(4+jk,3)=-beta*Y(4+jk)
            4754     2   p    v                AA(4+jk,2)= 1. - AA(4+jk,1) - AA(4+jk,3)
            4755     2               #ifdef DEBUG
            4756     2   p    v              if(GDCHK2) print *,"ps: 11.3, nle=",nle,",nls=",nls
            4757     2                       if(GDCHK2) print *,"ps: 11.3, wsm(nls+jk)=",wsm(nls+jk),",X(jk+4)=",X(jk+4)
            4758     2                       if(GDCHK2) print *,"ps: 11.3, wsm(nls+jk-1)=",wsm(nls+jk-1),", Y(jk+4)=",Y(jk+4)
            4759     2                       if(GDCHK2) print *,"ps: 11.3, zdtime=",zdtime,", pawsfl(jl,nls+jk)=",pawsfl(jl,nls+jk)
            4760     2                       if(GDCHK2) print *,"ps: 11.3, zdtime=",zdtime,", pawsfl0(jl,nls+jk)=",pawsfl0(jl,nls+jk)
            4761     2               #endif
            4762     2   p    v              END DO
            4763     1               !
            4764     1               !* 11.4 SOIL LAYER (jk=nle+1=G)
            4765     1               !
            4766     1               !       assume equal to the salinity of previous layer, LVL nle
            4767     1                       RHS(5+nle-nls)=0.
            4768     1                       AA(5+nle-nls,1)=-1.
            4769     1                       AA(5+nle-nls,3)=0.
            4770     1                       AA(5+nle-nls,2)=1.
            4771     1               !
            4772     1               !* 11.5 SOLVE THE TRIDIAGONAL MXTRIX
            4773     1               !
            4774     1               #ifdef DEBUG
            4775     1                       if(GDCHK2) print *,"ps: 11.5, RHS=", RHS(:)
            4776     1                       if(GDCHK2) print *,"ps: 11.5, AA(:,1)=", AA(:,1)
            4777     1                       if(GDCHK2) print *,"ps: 11.5, AA(:,2)=", AA(:,2)
            4778     1                       if(GDCHK2) print *,"ps: 11.5, AA(:,3)=", AA(:,3)
            4779     1               #endif
            4780     1                       CALL LU(4,5+nle-nls,AA,RHS,SOL)
            4781     1               !
            4782     1               !* 11.6 Restore salinity profile
            4783     1               !
            4784     1               #if defined DEBUG
            4785     1                       if(GDCHK2) print *,"ps: 11.6, SOL=", SOL(:)
            4786     1               #endif
            4787     1               
            4788     1                       pws(jl,0) = MIN(MAX(SOL(4),0.),SALT_MAX)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      SOL
                                   <<< Loop-information  End >>>
            4789     2  pp   2v              DO jk = 1, nle+1-nls
            4790     2   p   2v                pws(jl,nls+jk) = MIN(MAX(SOL(jk+4),0.),SALT_MAX)
            4791     2   p   2v              END DO
            4792     1               !       Assume the missing layer salinity to be the first
            4793     1               !       available salinity, i.e., =pws(nls+1).
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4794     2  pp   4v              DO jk = 1, nls, 1
            4795     2   p   4v                pws(jl,jk) = pws(jl,nls+1)
            4796     2   p   4v              END DO
            4797     1               !
            4798     1                     ENDIF
            4799                     !
            4800                     !* 11.7 Update seawater density for new salinity and temperature
            4801                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      z, pwrho
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 4  FILL 8
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4802     1   s    s           DO jk=0,nle+1
            4803     1                      !! pwrho(jk)=rho_from_theta(pws(jl,jk),pwt(jl,jk)-tmelt,0.)     ! density at surface (0 m depth)
            4804     1   m    m             pwrho(jk)=rho_from_theta(pws(jl,jk),pwt(jl,jk)-tmelt,pwlvl(jl)-z(jk))     ! in situ density
            4805     1   s    s             pwrho1000(jl,jk)=rho_from_theta(pws(jl,jk),pwt(jl,jk)-tmelt,1000.)     ! potential temperature at 1000 m depth
            4806     1   p    v             IF (jk.GE.1) pwrhoh(jk)=rho_from_theta(pws(jl,jk-1),pwt(jl,jk-1)-tmelt,pwlvl(jl)-z(jk))     ! in situ density
            4807     1   p    v           ENDDO
            4808                     
            4809                     !
            4810                     !*   12. UPDATE U, V DUE TO VERTICAL MIXING
            4811                     ! ----------------------------------------------------------------------
            4812                     !      IF (.NOT.(lsoil.OR.(locn.AND.(pocnmask(jl).GT.0.).AND.(ocn_couple_option.NE.11)))) THEN
            4813     1                     IF ( .NOT.lsoil.AND.(.NOT.locn.OR.(pocnmask(jl).LE.0.).OR.(ocn_couple_option.EQ.11)) ) THEN
            4814     1               ! ----------------------------------------------------------------------
            4815     1               !
            4816     1               !*   12. UPDATE U, V DUE TO VERTICAL MIXING
            4817     1               !          BY SOLVING A COMPLEX(dp) :: TRI-DIAGONAL MATRIX:
            4818     1               !
            4819     1               ! ----------------------------------------------------------------------
            4820     1               !      PRINT *, ", I am in 12) UPDATE U,V."
            4821     1               !
            4822     1               !*   12.1 Update Outflow Velocity & Water Level of Ocean
            4823     1               !
            4824     1               !      OUTFLW(jl)=OUTFLM(jl)+MAX(pwlvl(jl)-z(0),0.)
            4825     1               !      pwlvl(jl)=MIN(pwlvl(jl),z(0))
            4826     1               !
            4827     1                       CALL LKDIFKM(hew,X,Y)
            4828     1               !
            4829     1               !*    this line is moved to Ocean Sub
            4830     1               !
            4831     1               !!!        IF (lsit_ice.AND.mas.LT.4) THEN
            4832     2                       IF (mas.LT.4) THEN
            4833     2               !         set tauwx and tauwy to zero if snow/ice on top
            4834     2                         tauwx=0.
            4835     2                         tauwy=0.
            4836     2                       ELSE
            4837     2                         tauwx=taucx(jl)
            4838     2                         tauwy=taucy(jl)
            4839     2                       ENDIF
            4840     1                       tauc=tauwx*(1.,0.)+tauwy*(0.,1.)
            4841     2                       IF(GDCHK2) THEN
            4842     2                        print *,"12.1, tauwx=",tauwx
            4843     2                       ENDIF
            4844     1               !!
            4845     1               !
            4846     1               !*   12.2 PREPARE CURRENT VECTOR
            4847     1               !
            4848     1                1220   CONTINUE
            4849     2                       IF(locn.AND.(ocn_couple_option.EQ.11).AND.(pocnmask(jl).GT.0.)) THEN
            4850     2                       ! ocean grids: taking care in mo_ocean
            4851     2                         fr=0.
            4852     2                         zcor=0.
            4853     2                       ELSE
            4854     2               !          zcor=pcoriol(jl)
            4855     2               !          zcor=MAX(ABS(pcoriol(jl)),zepcor)  ! v9.8b: 20130822
            4856     2                         ! determining coriol, same as vdiff, but strange.
            4857     2                         ! It should have different in different hemisphere
            4858     2                         zcor=SIGN(MAX(ABS(pcoriol(jl)),zepcor),pcoriol(jl))  ! v9.8b: 20130822
            4859     2                         fr=7.E-5                                     ! = friction factor for current (1/s).
            4860     2                                                                      ! It is due to that one-column model neglect horizontal diffusion.
            4861     2                       ENDIF
            4862     1               !        PRINT *, "istep=",istep,"pe=",mpp_pe(),"jrow=",jrow,", I am in UPDATE U,V., 12.2."
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 191
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.85, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pawuflc, wum, wvm, wumc
                                   <<< Loop-information  End >>>
            4863     2  pp    v              DO jk=0,nle+1
            4864     2   p    v                wumc(jk)=wum(jk)*(1.,0.)+wvm(jk)*(0.,1.)
            4865     2   p    v                pawuflc(jk)=pawufl(jl,jk)*(1.,0.)+pawvfl(jl,jk)*(0.,1.)
            4866     2   p    v              ENDDO
            4867     1                       fr_corc=fr*(1.,0.)+zcor*(0.,1.)
            4868     1               !
            4869     1               !*   12.3 SKIN LAYER
            4870     1               !
            4871     1               !      PRINT *, "istep=",istep,"pe=",mpp_pe(),"jrow=",jrow,", I am in UPDATE U,V., 12.3."
            4872     1                       jk=0
            4873     2                       IF (lssst) THEN
            4874     3                         IF (lv81) THEN
            4875     3                           RHSC(4)= wumc(0)&
            4876     3               &                   -(1.-beta2)*zdtime*fr_corc*wumc(0)&
            4877     3               &                   +zdtime*tauc/rhoh2o/hew&
            4878     3               &                   -(1.-beta)*Y(4)*(wumc(0)-wumc(nls+1))
            4879     3                           AAC(4,1)=(0.,0.)
            4880     3                           AAC(4,3)=-beta*Y(4)*(1.,0.)
            4881     3                           AAC(4,2)= (1.,0.) - AAC(4,1) - AAC(4,3)&
            4882     3               &                   +beta2*zdtime*fr_corc
            4883     3                         ELSE
            4884     3                           RHSC(4)= wumc(0)&
            4885     3               &                   +zdtime*tauc/rhoh2o/hew&
            4886     3               &                   -(1.-beta)*Y(4)*(wumc(0)-wumc(nls+1))
            4887     3                           AAC(4,1)=(0.,0.)
            4888     3                           AAC(4,3)=-beta*Y(4)*(1.,0.)
            4889     3                           AAC(4,2)= (1.,0.) - AAC(4,1) - AAC(4,3)
            4890     3                         ENDIF
            4891     2                       ELSE
            4892     2                         RHSC(4)=(0.,0.)
            4893     2                         AAC(4,1)=(0.,0.)
            4894     2                         AAC(4,3)=(-1.,0.)
            4895     2                         AAC(4,2)= (1.,0.)
            4896     2                       ENDIF
            4897     1               !
            4898     1               !     Note: In the equator, gl_coriol is too small to balance the wind
            4899     1               !     shear. Extra friction might be needed.
            4900     1               !
            4901     1               !*   12.5 FIRST LAYER
            4902     1               !
            4903     1               !      PRINT *, "istep=",istep,"pe=",mpp_pe(),"jrow=",jrow,", I am in UPDATE U,V., 12.4."
            4904     1                       jk=1
            4905     2                       IF (lssst) THEN
            4906     3                         IF(lv81) THEN
            4907     3                           RHSC(4+jk)= wumc(nls+jk)-hew/hw(nls+jk)*wumc(0)&
            4908     3               &             -(1.-beta2)*zdtime*fr_corc*wumc(nls+jk)*0.75&
            4909     3               &             +(1.-beta)*(X(4+jk)*(wumc(0)-wumc(nls+jk))&
            4910     3               &             -Y(4+jk)*(wumc(nls+jk)-wumc(nls+jk+1)))&
            4911     3               &             +zdtime*pawuflc(nls+jk)
            4912     3                           AAC(4+jk,1)=(-beta*X(4+jk)-hew/hw(nls+jk))*(1.,0.)
            4913     3                           AAC(4+jk,3)=(-beta*Y(4+jk))*(1.,0.)
            4914     3                           AAC(4+jk,2)= (1.,0.) + (beta*X(4+jk)+beta*Y(4+jk))*(1.,0.)&
            4915     3               &             +beta2*zdtime*fr_corc*0.75
            4916     3                         ELSE
            4917     3                           RHSC(4+jk)= wumc(nls+jk)-hew/hw(nls+jk)*wumc(0)&
            4918     3               &             -(1.-beta2)*zdtime*fr_corc*wumc(nls+jk) &
            4919     3               &             +(1.-beta)*(X(4+jk)*(wumc(0)-wumc(nls+jk))&
            4920     3               &             -Y(4+jk)*(wumc(nls+jk)-wumc(nls+jk+1)))&
            4921     3               &             +zdtime*pawuflc(nls+jk)
            4922     3                           AAC(4+jk,1)=(-beta*X(4+jk)-hew/hw(nls+jk))*(1.,0.)
            4923     3                           AAC(4+jk,3)=(-beta*Y(4+jk))*(1.,0.)
            4924     3                           AAC(4+jk,2)= (1.,0.) + (beta*X(4+jk)+beta*Y(4+jk))*(1.,0.)&
            4925     3               &             +beta2*zdtime*fr_corc
            4926     3                         ENDIF
            4927     2                       ELSE
            4928     3                         IF(lv81) THEN
            4929     3                           RHSC(4+jk)= wumc(nls+jk)-(1.-beta2)*zdtime*fr_corc*wumc(nls+jk)&
            4930     3               &             -(1.-beta)*Y(4+jk)*(wumc(0)-wumc(nls+jk))&
            4931     3               &             +zdtime*pawuflc(nls+jk)
            4932     3                           AAC(4+jk,1)=(0.,0.)
            4933     3                           AAC(4+jk,3)=(-beta*Y(4+jk))*(1.,0.)
            4934     3                           AAC(4+jk,2)= (1.,0.) - AAC(4+jk,1) - AAC(4+jk,3)&
            4935     3               &             +beta2*zdtime*fr_corc
            4936     3                         ELSE
            4937     3                           RHSC(4+jk)= wumc(nls+jk)-(1.-beta2)*zdtime*fr_corc*wumc(nls+jk)&
            4938     3               &             +zdtime*tauc/rhoh2o/hw(nls+jk)&
            4939     3               &             -(1.-beta)*Y(4+jk)*(wumc(0)-wumc(nls+jk))&
            4940     3               &             +zdtime*pawuflc(nls+jk)
            4941     3                           AAC(4+jk,1)=(0.,0.)
            4942     3                           AAC(4+jk,3)=(-beta*Y(4+jk))*(1.,0.)
            4943     3                           AAC(4+jk,2)= (1.,0.) - AAC(4+jk,1) - AAC(4+jk,3)&
            4944     3               &             +beta2*zdtime*fr_corc
            4945     3                         ENDIF
            4946     2                       ENDIF
            4947     1               !
            4948     1               !       or
            4949     1               ! ----------------------------------------------------------------------
            4950     1               !         RHSC(5)= wumc(1)
            4951     1               !     1    -(1.-beta2)*zdtime*fr_corc*wumc(1)
            4952     1               !     2    +zdtime*tauc/rhoh2o/hw(1)
            4953     1               !     3    -(1.-beta)*Y(5)*(wumc(1)-wumc(2))
            4954     1               !
            4955     1               !        AAC(5,1)=(0.,0.)
            4956     1               !        AAC(5,3)=-beta*Y(5)*(1.,0.)
            4957     1               !        AAC(5,2)= (1.,0.) - AAC(5,1) - AAC(5,3)
            4958     1               !     1    +beta2*zdtime*fr_corc
            4959     1               ! ----------------------------------------------------------------------
            4960     1               !
            4961     1               !       Note both of the above two equations are identical. The one we
            4962     1               !       choose is still a tridigonal matrix while coupled with ATM PBL
            4963     1               !       directly. i.e. tauc can be implicitly determined by a coupled ATM
            4964     1               !       and ocean momentum matrix by solving a tri-diagonal matrix only. A
            4965     1               !       value of 0.75 to adjust coriolis force due to the physical thickness
            4966     1               !       of skin layer is 0.25 hw(1). Therefore only 75% remained to be
            4967     1               !       counted here.
            4968     1               !
            4969     1               !*   12.6 MIDDLE LAYERS (jk=2,nle)
            4970     1               !
            4971     1               !      PRINT *, "istep=",istep,"pe=",mpp_pe(),"jrow=",jrow,", I am in UPDATE U,V., 12.5."
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 18
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.06, ITR: 40, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      AAC, X, Y, pawuflc, wumc, RHSC
                                   <<< Loop-information  End >>>
            4972     2  pp    v              DO jk=2,nle-nls
            4973     2   p    v                RHSC(4+jk)= wumc(nls+jk)&
            4974     2               &           -(1.-beta2)*zdtime*fr_corc*wumc(nls+jk)&
            4975     2               &           +(1.-beta)*(X(4+jk)*(wumc(nls+jk-1)-wumc(nls+jk))&
            4976     2               &           -Y(4+jk)*(wumc(nls+jk)-wumc(nls+jk+1)))&
            4977     2               &           +zdtime*pawuflc(nls+jk)
            4978     2   p    v                AAC(4+jk,1)=-beta*X(4+jk)*(1.,0.)
            4979     2   p    v                AAC(4+jk,3)=-beta*Y(4+jk)*(1.,0.)
            4980     2   p    v                AAC(4+jk,2)= (1.,0.) -AAC(4+jk,1) - AAC(4+jk,3)&
            4981     2               &           +beta2*zdtime*fr_corc
            4982     2               !         X,Y is the same as temperature's
            4983     2   p    v              END DO
            4984     1               !
            4985     1               !*   12.7 SOIL LAYER (jk=nle+1=G)
            4986     1               !
            4987     1               !     zero velocity is assumed.
            4988     1                       jk=nle+1-nls
            4989     1                       RHSC(4+jk)= (0.,0.)
            4990     1                       AAC(4+jk,1)=(0.,0.)
            4991     1                       AAC(4+jk,3)=(0.,0.)
            4992     1                       AAC(4+jk,2)= (1.,0.) - AAC(4+jk,1) - AAC(4+jk,3)
            4993     1               !
            4994     1               !*   12.8 SOLVE THE TRIDIAGONAL MATRIX
            4995     1               !
            4996     1               !      PRINT *, "I am going to LU2."
            4997     1                       CALL LU2(4,5+nle-nls,AAC,RHSC,SOLCMPLX)
            4998     1               !      PRINT *, "I left LU2."
            4999     1               !
            5000     1               !*   12.9 Restore velocity profile
            5001     1               !
            5002     1               !        IF(GDCHK3) THEN
            5003     1               !          WRITE(nerr,*) "I am in 12.9, 1:"
            5004     1               !          WRITE(nerr,*) "pwu=",pwu(jl,:)
            5005     1               !          WRITE(nerr,*) "pwv=",pwv(jl,:)
            5006     1               !        ENDIF
            5007     1                       pwu(jl,0) = REAL(SOLCMPLX(4))
            5008     1                       pwv(jl,0) = AIMAG(SOLCMPLX(4))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      SOLCMPLX
                                   <<< Loop-information  End >>>
            5009     2  pp   2v              DO jk = 1, nle+1-nls
            5010     2   p   2v                pwu(jl,nls+jk) = REAL(SOLCMPLX(jk+4))
            5011     2   p   2v                pwv(jl,nls+jk) = AIMAG(SOLCMPLX(jk+4))
            5012     2   p   2v              END DO
            5013     1               !        IF(GDCHK3) THEN
            5014     1               !          WRITE(nerr,*) "I am in 12.9, 2:"
            5015     1               !          WRITE(nerr,*) "pwu=",pwu(jl,:)
            5016     1               !          WRITE(nerr,*) "pwv=",pwv(jl,:)
            5017     1               !        ENDIF
            5018     1               !         Assume the missing layer current to be the first
            5019     1               !         available current, i.e., =pwu(nls+1), pwv(nls+1).
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 48, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            5020     2  pp   2v              DO jk = 1, nls, 1
            5021     2   p   2v                pwu(jl,jk) = pwu(jl,nls+1)
            5022     2   p   2v                pwv(jl,jk) = pwv(jl,nls+1)
            5023     2   p   2v              END DO
            5024     1               ! ----------------------------------------------------------------------
            5025     1                     ENDIF
            5026                     ! ----------------------------------------------------------------------
            5027                     !
            5028                     !*   13. UPDATE TKE DUE TO VERTICAL MIXING
            5029                     !            BY SOLVING A TRI-DIAGONAL MATRIX:
            5030                     !
            5031                     ! ----------------------------------------------------------------------
            5032     1                     IF (.NOT.lsoil) THEN
            5033     1               ! ----------------------------------------------------------------------
            5034     1                1300   CONTINUE
            5035     1               !      PRINT *, "istep=",istep,"pe=",mpp_pe(),"jrow=",jrow,", I am in UPDATE TKE"
            5036     2                       IF (lsteady_TKE) THEN
            5037     2                         CALL calc_steady_tke
            5038     2                       ELSE
            5039     2                         CALL calc_unsteady_tke
            5040     2                       ENDIF
            5041     1               ! ----------------------------------------------------------------------
            5042     1                     ENDIF
            5043                     ! ----------------------------------------------------------------------
            5044                     !*   14. This is needed unless resolution is better than about 10 km; otherwise
            5045                     !        rotation does not allow proper and full convective adjustment. Should
            5046                     !        be applied stochastically, as the strong events leading to
            5047                     ! ----------------------------------------------------------------------
            5048     1                     IF (lpenetrative_convection) THEN !!v9.83 (MINOR=3), bjt, 20130824
            5049     1                       CALL penetrative_convection(jl)
            5050     1                     ENDIF
            5051                     ! ----------------------------------------------------------------------
            5052                     !
            5053                     !*   15. FINAL: PRINT DIAGNOSTIC VARIABLES
            5054                     !
            5055                     ! ----------------------------------------------------------------------
            5056                     !
            5057                     !*   15.1 Fluxes
            5058                     !
            5059                           CALL calc_flux
            5060                     !
            5061                     !*   15.2 Water Level
            5062                     !
            5063                     !!!      IF(.NOT.lsoil) THEN
            5064                     !!!        IF (lwaterlevel) THEN
            5065                     !!!          pwlvl(jl)=pbathy(jl)+SUM(hw(nls+1:nle))
            5066                     !!!        ENDIF
            5067                     !!!      ENDIF
            5068                     !!!
            5069                     !!!  do not change the progonastic variable hw, lsoil during the iteration
            5070                     !!!      IF (lwaterlevel) THEN
            5071                     !!!      ! for both water and soil grid
            5072                     !!!          CALL pzcord(jl,jrow)                    ! bjt 2010/2/21
            5073                     !!!      ENDIF
            5074                       RETURN
            5075                      2100 FORMAT(1X,2(I4,1X),1(I8,1X),(I4,1X),5F8.3,2E9.2)
            5076                     !
            5077                     END SUBROUTINE thermocline
            5078                     ! **********************************************************************
            5079                     ! **********************************************************************
            5080                       real FUNCTION calc_tkewave(utauw,depth)
            5081                       !  utauw   : friction velocity of the water side (m/s)              I
            5082                       !  depth: depth (m), 0 at the surface and plus downward (+, always)
            5083                       !  calc_tkewave: tke due to wave (m2/s2)
            5084                       !  Mellor and Blumberg (2004)
            5085                       !
            5086                         IMPLICIT NONE
            5087                         real, INTENT(in):: utauw
            5088                         real, INTENT(in):: depth
            5089                         real,PARAMETER:: ccb=100.      ! constant for wave breaking proposed by Craig and Banner (1994) in Mellor and Blumberg (2004)
            5090                                                               ! Mellor and Blumberg (2004), 150 in Stacey (1999)
            5091                         real:: lambda
            5092     1                   IF (.NOT.lwave_breaking) THEN
            5093     1                     calc_tkewave=0.
            5094     1                   ELSE
            5095     1                     lambda=1.15925e-5*G/utauw**2.
            5096     1                     calc_tkewave=0.5*(15.8*ccb)**(2./3.)*utauw**2.*EXP(-lambda*depth)
            5097     1                   ENDIF
            5098     1                   IF(GDCHK2) THEN
            5099     1                     print *,"ccb=",ccb,",utauw=",utauw
            5100     1                     print *,"lambda=",lambda,",depth=",depth
            5101     1                   ENDIF
            5102                     
            5103                       END FUNCTION calc_tkewave
            5104                     ! **********************************************************************
            5105                       SUBROUTINE calc_steady_tke
            5106                       ! ----------------------------------------------------------------------
            5107                       !*   calc TKE at steady state
            5108                       ! ----------------------------------------------------------------------
            5109                         IMPLICIT NONE
            5110                         INTEGER:: jk,levelm,level
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      z, pwrhoh, pwrho, zlk
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            5111     1                   DO jk=1,nle+1-nls
            5112     1                     levelm=nls+jk-1
            5113     1                     IF (levelm.EQ.nls) levelm=0
            5114     1                     level=nls+jk
            5115     1                     pwtke(jl,level) = ck*pwlmx(jl,level)*pwldisp(jl,level)/ce*                            &
            5116     1                    &        (  ( (pwu(jl,levelm)-pwu(jl,level))/(z(levelm)-z(level)) )**2.+               &
            5117     1                    &           ( (pwv(jl,levelm)-pwv(jl,level))/(z(levelm)-z(level)) )**2.+               &
            5118     1                    &           G/rhoh2o/Prw*( pwrhoh(level)-pwrho(level) )/(z(levelm)-z(level))  )
            5119     1               #ifdef DEBUG
            5120     2                     IF (GDCHK2) THEN
            5121     2                       print *, "ck=",ck,"pwlmx=",pwlmx(jl,level),"pwldisp=",pwldisp(jl,level)
            5122     2                       print *, "ce=",ce,"pwu(jl,levelm)=",pwu(jl,levelm),"pwu(jl,level)=",pwu(jl,level)
            5123     2                       print *, "z(levelm)=",z(levelm),"z(level)=",z(level)
            5124     2                       print *, "G=",G,"rhoh2o=",rhoh2o,"Prw=",Prw
            5125     2                       print *, "pwrhoh(level)=",pwrhoh(level),"pwrho(level)=",pwrho(level)
            5126     2                       print *, "pwtke(",jl,",",level,")=", pwtke(jl,level)
            5127     2                       print *, "tkewave=",calc_tkewave(utauw,pwlvl(jl)-zlk(level))
            5128     2                       print *, "utauw=",utauw
            5129     2                       print *, "depth=",pwlvl(jl)-zlk(level)
            5130     2                     ENDIF
            5131     1               #endif
            5132     1                     pwtke(jl,level) = MAX(  pwtke(jl,level), emin )+ calc_tkewave(utauw,pwlvl(jl)-zlk(level))
            5133     1                   END DO
            5134                         !     Assume the skin layer and the missing layer TKE to be the first
            5135                         !     available TKE, i.e., =pwtke(nls+1).
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            5136     1  pp   4v          DO jk = 0, nls, 1
            5137     1   p   4v            pwtke(jl,jk) = pwtke(jl,nls+1)
            5138     2   p   4v            IF(GDCHK2) THEN
            5139     2       4               print *, "pwtke(",jl,",",level,")=", pwtke(jl,level)
            5140     2   p   4v            ENDIF
            5141     1   p   4v          END DO
            5142                       END SUBROUTINE calc_steady_tke
            5143                     !***********************************************************************
            5144                       SUBROUTINE calc_unsteady_tke
            5145                       ! ----------------------------------------------------------------------
            5146                       !*   calc TKE at unsteady state
            5147                       ! ----------------------------------------------------------------------
            5148                         IMPLICIT NONE
            5149                         INTEGER:: jk,levelm,level,levelp
            5150                         real, DIMENSION(0:lkvl+5):: X,Y,RHS,SOL
            5151                         real, DIMENSION(0:lkvl+5,3):: AA
            5152                     !
            5153                     !*   13.1 Skin layer (jk = 0)
            5154                     !
            5155                             jk = 0
            5156     1                       IF (lwave_breaking) THEN
            5157     1                       ! set pwtke(0) to be those in Mellor and Blumberg (2004)
            5158     1                         RHS(4)= calc_tkewave(utauw,0.)
            5159     1                         AA(4,1)=0.
            5160     1                         AA(4,3)=0.
            5161     1                         AA(4,2)=1.
            5162     1                       ELSE
            5163     1                       ! assume to equal to the value of the first layer
            5164     1                         RHS(4)=0.
            5165     1                         AA(4,1)=0.
            5166     1                         AA(4,3)=-1.
            5167     1                         AA(4,2)= 1.
            5168     1                       ENDIF
            5169                     #ifdef DEBUG
            5170                               IF (GDCHK2) print *, "calc_tkewave=",RHS(4)
            5171                     #endif
            5172                     !
            5173                     !*   13.2 For first to bottom layers (jk = 1 - nle+1)
            5174                     !
            5175                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      z, zlk, wtkem, X, Y, AA, RHS
                                   <<< Loop-information  End >>>
            5176     1  pp    s              DO jk=1,nle+1-nls
            5177     1   p    v                levelm=nls+jk-1
            5178     1   p    s                IF (levelm.EQ.nls) levelm=0
            5179     1   p    v                level=nls+jk
            5180     1   p    s                levelp=nls+jk+1
            5181     1               !!!          IF (levelm.EQ.nls) THEN
            5182     1               !!!          !! first layer
            5183     1               !!!            X(4+jk)= 0.
            5184     1               !!!            Y(4+jk)= zdtime*pwkm(jl,level)/&
            5185     1               !!!&             ( (z(levelm)-z(level))*(zlk(level)-zlk(levelp)) )
            5186     1               !!!            RHS(4+jk)= wtkem(level)&
            5187     1               !!!&             +(1.-beta)*(                                       &
            5188     1               !!!&                         -Y(4+jk)*(wtkem(level)-wtkem(levelp)) )&
            5189     1               !!!&             +beta2* (&
            5190     1               !!!&             +pwkm(jl,level)*zdtime*((wvm(levelm)-wvm(level))/(z(levelm)-z(level)))**2.   &
            5191     1               !!!&             +pwkh(jl,level)*zdtime*G/rhoh2o*( rhomh(level)-            &
            5192     1               !!!&               rhom(level) )/(z(levelm)-z(level)) )                      &
            5193     1               !!!&             +(1-beta2)*(                                                                    &
            5194     1               !!!&             +pwkm(jl,level)*zdtime*((pwu(jl,levelm)-pwu(jl,level))                          &
            5195     1               !!!&                            /(z(levelm)-z(level)))**2.                                    &
            5196     1               !!!&             +pwkm(jl,level)*zdtime*((pwv(jl,levelm)-pwv(jl,level))                          &
            5197     1               !!!&                            /(z(levelm)-z(level)))**2.                                    &
            5198     1               !!!&             +pwkh(jl,level)*zdtime*G/rhoh2o*( pwrhoh(level)-      &
            5199     1               !!!&               pwrho(level) )/(z(levelm)-z(level))    )             &
            5200     1               !!!&             -0.5_dp*ce*zdtime*wtkem(level)**(1.5_dp)/pwldisp(jl,level)                   &   ! bug, v0.9879
            5201     1               !!!&             +zdtime*pawtkefl(jl,level)
            5202     1               !!!
            5203     1               !!!          ELSE IF (levelp.EQ.(nle+2)) THEN
            5204     2   p    s                IF (levelp.EQ.(nle+2)) THEN
            5205     2                         !! bottom layer
            5206     2   p    s                  X(4+jk)= zdtime*pwkm(jl,level)/&
            5207     2               &             ( (z(levelm)-z(level))*(zlk(levelm)-zlk(level)) )
            5208     2   p    s                  Y(4+jk)= 0.
            5209     2   p    s                  RHS(4+jk)= wtkem(level)&
            5210     2               &             +(1.-beta)*( X(4+jk)*(wtkem(levelm)-wtkem(level))&
            5211     2               &                                                               )&
            5212     2               &             +beta2* (&
            5213     2               &             +pwkm(jl,level)*zdtime*((wum(levelm)-wum(level))/(z(levelm)-z(level)))**2.   &
            5214     2               &             +pwkm(jl,level)*zdtime*((wvm(levelm)-wvm(level))/(z(levelm)-z(level)))**2.   &
            5215     2               &             +pwkh(jl,level)*zdtime*G/rhoh2o*( rhomh(level)-            &
            5216     2               &               rhom(level) )/(z(levelm)-z(level)) )                      &
            5217     2               &             +(1-beta2)*(                                                                    &
            5218     2               &             +pwkm(jl,level)*zdtime*((pwu(jl,levelm)-pwu(jl,level))                          &
            5219     2               &                            /(z(levelm)-z(level)))**2.                                    &
            5220     2               &             +pwkm(jl,level)*zdtime*((pwv(jl,levelm)-pwv(jl,level))                          &
            5221     2               &                            /(z(levelm)-z(level)))**2.                                    &
            5222     2               &             +pwkh(jl,level)*zdtime*G/rhoh2o*( pwrhoh(level)-      &
            5223     2               &               pwrho(level) )/(z(levelm)-z(level))    )             &
            5224     2               &             -0.5*ce*zdtime*wtkem(level)**(1.5)/pwldisp(jl,level)                   &             ! bug, v0.9879
            5225     2               &             +zdtime*pawtkefl(jl,level)
            5226     2   p    s                ELSE
            5227     2                         !! middle layers
            5228     2   p    s                  X(4+jk)= zdtime*pwkm(jl,level)/                                                   &
            5229     2               &             ( (z(levelm)-z(level))*(zlk(levelm)-zlk(level)) )
            5230     2   p    s                  Y(4+jk)= zdtime*pwkm(jl,level)/&
            5231     2               &             ( (z(levelm)-z(level))*(zlk(level)-zlk(levelp)) )
            5232     2   p    s                  RHS(4+jk)= wtkem(level)&
            5233     2               &             +(1.-beta)*( X(4+jk)*(wtkem(levelm)-wtkem(level))                            &
            5234     2               &                         -Y(4+jk)*(wtkem(level)-wtkem(levelp)) )                             &
            5235     2               &             +beta2* (&
            5236     2               &             +pwkm(jl,level)*zdtime*((wum(levelm)-wum(level))/(z(levelm)-z(level)))**2.   &
            5237     2               &             +pwkm(jl,level)*zdtime*((wvm(levelm)-wvm(level))/(z(levelm)-z(level)))**2.   &
            5238     2               &             +pwkh(jl,level)*zdtime*G/rhoh2o*( rhomh(level)-            &
            5239     2               &               rhom(level) )/(z(levelm)-z(level)) )                      &
            5240     2               &             +(1-beta2)*(                                                                    &
            5241     2               &             +pwkm(jl,level)*zdtime*((pwu(jl,levelm)-pwu(jl,level))                          &
            5242     2               &                            /(z(levelm)-z(level)))**2.                                    &
            5243     2               &             +pwkm(jl,level)*zdtime*((pwv(jl,levelm)-pwv(jl,level))                          &
            5244     2               &                            /(z(levelm)-z(level)))**2.                                    &
            5245     2               &             +pwkh(jl,level)*zdtime*G/rhoh2o*( pwrhoh(level)-      &
            5246     2               &               pwrho(level) )/(z(levelm)-z(level))    )             &
            5247     2               &             -0.5*ce*zdtime*wtkem(level)**(1.5)/pwldisp(jl,level)                   &               ! bug, v0.9879
            5248     2               &             +zdtime*pawtkefl(jl,level)
            5249     2               
            5250     2               !            IF(GDCHK3)  then
            5251     2               !              print *,'jk=',jk,',level=',level,',levelm=',levelm
            5252     2               !              print *,'wtkem(levelm)=',wtkem(levelm),',wtkem(level)=',wtkem(level)
            5253     2               !              print *,'wtkem(levelp)=',wtkem(levelp),',pwkm(jl,level)=',pwkm(jl,level)
            5254     2               !              print *,'wum(levelm)=',wum(levelm),',wum(level)=',wum(level)
            5255     2               !              print *,'wvm(levelm)=',wvm(levelm),',wvm(level)=',wvm(level)
            5256     2               !              print *,'pwkh(jl,level)=',pwkh(jl,level),',rhomh(level)=',rhomh(level)
            5257     2               !              print *,'rhom(level)=',rhom(level),',z(levelm)=',z(levelm),',z(level)=',z(level)
            5258     2               !              print *,'pwu(jl,levelm)=',pwu(jl,levelm),',pwu(jl,level)=',pwu(jl,level)
            5259     2               !              print *,'pwv(jl,levelm)=',pwv(jl,levelm),',pwv(jl,level)=',pwv(jl,level)
            5260     2               !              print *,'pwrhoh(level)=',pwrhoh(level),',pwrho(level)=',pwrho(level)
            5261     2               !              print *,'pawtkefl(jl,level)=',pawtkefl(jl,level),',pwldisp(jl,level)=',pwldisp(jl,level)
            5262     2               !              print *,'zdtime=',zdtime,',ce=',ce,',beta=',beta,',beta2=',beta2
            5263     2               !              print *,'pstmp1=',(1.-beta)*( X(4+jk)*(wtkem(levelm)-wtkem(level))                            &
            5264     2               !&                         -Y(4+jk)*(wtkem(level)-wtkem(levelp)) )
            5265     2               !              print *,'pstmp2=',beta2* (&
            5266     2               !&                         +pwkm(jl,level)*zdtime*((wum(levelm)-wum(level))/(z(levelm)-z(level)))**2.   &
            5267     2               !&                         +pwkm(jl,level)*zdtime*((wvm(levelm)-wvm(level))/(z(levelm)-z(level)))**2.   &
            5268     2               !&                         +pwkh(jl,level)*zdtime*G/rhoh2o*( rhomh(level)-            &
            5269     2               !&                           rhom(level) )/(z(levelm)-z(level)) )
            5270     2               !             print *,'pstmp3=',(1-beta2)*(&
            5271     2               !&                         +pwkm(jl,level)*zdtime*((pwu(jl,levelm)-pwu(jl,level))&
            5272     2               !&                            /(z(levelm)-z(level)))**2.&
            5273     2               !&                         +pwkm(jl,level)*zdtime*((pwv(jl,levelm)-pwv(jl,level))&
            5274     2               !&                            /(z(levelm)-z(level)))**2.&
            5275     2               !&                         +pwkh(jl,level)*zdtime*G/rhoh2o*( pwrhoh(level)-      &
            5276     2               !&                           pwrho(level) )/(z(levelm)-z(level))    )
            5277     2               !              print *,'pstmp4=',0.5*ce*zdtime*wtkem(level)**(1.5)/pwldisp(jl,level)
            5278     2               !              print *,'RHS(4+jk)=',RHS(4+jk)
            5279     2               !            ENDIF
            5280     2   p    v                ENDIF
            5281     1               !
            5282     1               !
            5283     1               !     -- DO NOT ALLOW   zdtime*(TOTAL DAMPING) > pwtke   --
            5284     1               !
            5285     1   p    v                RHS(4+jk)=MAX(RHS(4+jk),0.)
            5286     1               !
            5287     1   p    v                AA(4+jk,1)=-beta*X(4+jk)
            5288     1   p    v                AA(4+jk,3)=-beta*Y(4+jk)
            5289     1   p    v                AA(4+jk,2)= 1.+1.5*ce*zdtime*SQRT(wtkem(level))/pwldisp(jl,level)&
            5290     1               &          -AA(4+jk,1)- AA(4+jk,3)
            5291     1   p    v              ENDDO
            5292                     !
            5293                     !*   13.4 SOLVE THE TRIDIAGONAL MATRIX
            5294                     !
            5295                     !        IF(GDCHK3) then
            5296                     !          print *,'before LU, RHS(:)=',RHS(:)
            5297                     !          print *,'AA(:,1)=',AA(:,1)
            5298                     !          print *,'AA(:,2)=',AA(:,2)
            5299                     !          print *,'AA(:,3)=',AA(:,3)
            5300                     !          print *,'SOL(:)=',SOL(:)
            5301                     !        ENDIF
            5302                             CALL LU(4,5+nle-nls,AA,RHS,SOL)
            5303                     !        IF(GDCHK3) then
            5304                     !          print *,'after LU, RHS(:)=',RHS(:)
            5305                     !          print *,'AA(:,1)=',AA(:,1)
            5306                     !          print *,'AA(:,2)=',AA(:,2)
            5307                     !          print *,'AA(:,3)=',AA(:,3)
            5308                     !          print *,'SOL(:)=',SOL(:)
            5309                     !        ENDIF
            5310                     !
            5311                     !*   13.5 Restore TKE profile
            5312                     !     limit tom emin (=1.0E-6) (GASPAR ET AL., 1990)
            5313                     !
            5314                             pwtke(jl,0) = MAX(SOL(4)+emin, tol)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      SOL
                                   <<< Loop-information  End >>>
            5315     1  pp   2v              DO jk = 1, nle+1-nls
            5316     1   p   2v                pwtke(jl,nls+jk) = SOL(jk+4)
            5317     1               #ifdef DEBUG
            5318     1   p   2v                IF (GDCHK2) print *, "pwtke(",jl,",",nls+jk,")=", pwtke(jl,nls+jk)
            5319     1               #endif
            5320     1   p   2v                pwtke(jl,nls+jk) = MAX(pwtke(jl,nls+jk),emin)
            5321     1               !          IF (GDCHK3) print *, "pwtke(",jl,",",nls+jk,")=", pwtke(jl,nls+jk)
            5322     1   p   2v              END DO
            5323                     
            5324                     !        IF(GDCHK3) print *,'nls=',nls,',nle=',nle
            5325                     !         Assume the skin layer and the missing layer TKE to be the first
            5326                     !         available TKE, i.e., =pwtke(nls+1).
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            5327     1  pp   4v              DO jk = 0, nls, 1
            5328     1   p   4v                pwtke(jl,jk) = pwtke(jl,nls+1)
            5329     1   p   4v              END DO
            5330                       END SUBROUTINE calc_unsteady_tke
            5331                     !***********************************************************************
            5332                       SUBROUTINE calc_flux
            5333                       ! ----------------------------------------------------------------------
            5334                       !*   calc fluxes
            5335                       ! ----------------------------------------------------------------------
            5336                     !*   14.2 pgrndcapc, pgrndhflx_int, current, tsw
            5337                     !
            5338     1                  IF (hesn.GT.csncri) THEN
            5339     1               !  snow on top
            5340     1                    pgrndhflx_int(jl)=-rhosn*csn*xksn*                               &
            5341     1                      (  beta*(ptsnic(jl,0)-ptsnic(jl,1))                            &
            5342     1                        +(1.-beta)*(tsim(0)-tsim(1))                              &
            5343     1                        )/(0.5*hsn/pseaice(jl))
            5344     1                  ELSEIF (heice.GT.xicri) THEN
            5345     1               !  ice on top
            5346     1                    pgrndhflx_int(jl)=-rhoice*cice*xkice*                            &
            5347     1                      (  beta*(ptsnic(jl,2)-ptsnic(jl,3))                            &
            5348     1                        +(1.-beta)*(tsim(2)-tsim(3))                              &
            5349     1                        )/(0.5*hice/pseaice(jl))
            5350     1                  ELSEIF(.NOT.lsoil) THEN
            5351     1               !  water on top
            5352     1                    pgrndhflx_int(jl)=-rhowcw*pwkh(jl,nls+1)*                        &
            5353     1                      (  beta*(pwt(jl,0)-pwt(jl,nls+1))                              &
            5354     1                        +(1.-beta)*(wtm(0)-wtm(nls+1))                            &
            5355     1                        )/(z(0)-z(nls+1))-psoflw(jl)*FFN(-hw(0))
            5356     1                  ELSE
            5357     1               !  soil on top
            5358     1                    pgrndhflx_int(jl)=0.
            5359     1                    ! the flux below a soil layer of the infinity thickness is zero
            5360     1                  ENDIF
            5361                     !
            5362                     !    14.4 Calc cold content ccm (J/m2): the energy to melt snow + ice
            5363                     !         energy below liquid water at tmelt
            5364                     !
            5365                        pcc(jl)=pzsi(jl,0)*rhoh2o*( alf+csn*(tmelt-tsim(1)) )          &
            5366                          +pzsi(jl,1)*rhoh2o*( alf+cice*(tmelt-tsim(3)) )
            5367                     !
            5368                     !*   14.5 Calc net surface heat/fresh water flux into ocean
            5369                     !
            5370                     !!!     pfluxiw_int: net surface heat flux into ocean (W/m2, + downward)
            5371                     !!!     pfluxiw_int(jl)=-pfluxi2-pfluxw2+(cc-ccm)/zdtime
            5372                     !
            5373                     !    pfluxiw_int: net surface heat flux from ocean (W/m2, + upward)
            5374                     !    ppme2_int: net fresh water into ocean (m/s, + downward)
            5375                          pfluxiw_int(jl)=pfluxi2+pfluxw2-(pcc(jl)-ccm)/zdtime
            5376                     
            5377                     !!!     IF (pzsi(jl,1) .GT. 0.) THEN
            5378                     !!!       pfluxiw_int(jl)=-pfluxi2-pfluxw2+(cc-ccm)/zdtime
            5379                     !!!!!!       pfluxiw_int(jl)= rhowcw*hw(nls+1)*(pwt(jl,nls+1)-wtm(nls+1))/zdtime           &
            5380                     !!!!!!         +rhowcw*pwkh(jl,nls+2)*( beta*(pwt(jl,nls+1)-pwt(jl,nls+2))                  &
            5381                     !!!!!!            +(1.-beta)*(wtm(nls+1)-wtm(nls+2)) )/(z(nls+1)-z(nls+2))
            5382                     !!!!!!
            5383                     !!!!!!    Although the below Eq. is correcnt, it is numerically unstable. The above Eq is also correct.
            5384                     !!!!!!
            5385                     !!!!!!    pfluxiw_int(jl)= rhowcw*hew*(pwt(jl,0)-wtm(0))/zdtime          &
            5386                     !!!!!!      rhowcw*pwkh(jl,nls+1)*( beta*(pctfreez2(jl)-pwt(jl,nls+1))    &
            5387                     !!!!!!         +(1.-beta)*(wtm(0)-wtm(nls+1)) )/(z(0)-z(nls+1))
            5388                     !!!!!!
            5389                     !!!!!!    After second thought, the above Eq. is correct
            5390                     !!!!!!
            5391                     !!!!!!    the above Eq. is used for freeze/melt seaice
            5392                     !!!!!!     Since wt(jl,0) is fixed at pctfreez2, pfluxiw_int(jl)=0.
            5393                     !!!!!!
            5394                     !!!!!!       pfluxiw_int(jl)=0.
            5395                     !!!!!!
            5396                     !!!     ELSE
            5397                     !!!       pfluxiw_int(jl)=-pfluxi2-pfluxw2
            5398                     !!!     ENDIF
            5399                     !!!     IF (abs(pfluxiw_int(jl)).GT.2000.)  CALL output("fluxw > 2000 W/m2. ",hesn,hew,heice,pfluxwm,wtm,wsm,tsim)
            5400                     !!!     ppme2_int(jl)=-zsf/wsm(nls+1)/zdtime
            5401                     !
            5402                     !*   pwlvl(jl)=pbathy(jl)+SUM(hw(nls+1:nle))
            5403                     !*   Total Fresh Water Inflow = (pwlvl(jl)-wlvlm)/zdtime
            5404                     !
            5405                     !!!     ppme2_int(jl)=(pbathy(jl)+SUM(hw(nls+1:nle))-wlvlm)/zdtime
            5406                     
            5407                     !
            5408                     !*   14.6 Calc the uppermost bulk layer properties for coupling with 3-D ocean
            5409                     !
            5410                     !
            5411     1                  IF (locn) THEN
            5412     1                    ! Not valid for lwaterlevel=.TRUE.
            5413     1                    lstfn=MIN(nls+nfnlvl-1,nle)  ! index of last fine level
            5414     1               !
            5415     1               !
            5416     1               !    14.7 Calc net subsurface flux
            5417     1               !
            5418     1               !     pwsubflux_int: subsurface heat flux (W/m2, + upward)
            5419     1               !     pwsubsal_int: subsurface salinity flux (m*PSU/s, + upward)
            5420     1               !
            5421     1                    pwsubflux_int(jl)=-rhowcw*pwkh(jl,lstfn+1)*           &
            5422     1                        (  beta*(pwt(jl,lstfn)-pwt(jl,lstfn+1))      &
            5423     1                          +(1.-beta)*(wtm(lstfn)-wtm(lstfn+1))    &
            5424     1                          )/(z(lstfn)-z(lstfn+1))                    &
            5425     1                        -psoflw(jl)*FFN(zlk(nls+lstfn+1)-pwlvl(jl))
            5426     1                    pwsubsal_int(jl)=-pwkh(jl,lstfn+1)*                  &    ! unit:
            5427     1                        ( beta*(pws(jl,lstfn)-pws(jl,lstfn+1))       &
            5428     1                          +(1.-beta)*(wsm(lstfn)-wsm(lstfn+1))    &
            5429     1                          )/(z(lstfn)-z(lstfn+1))
            5430     1                  ENDIF
            5431                       END SUBROUTINE calc_flux
            5432                       !----------------------------------------------------------
            5433                       SUBROUTINE eddy(hcoolskin,utauw,wtkem,wtm,wsm)
            5434                       ! ----------------------------------------------------------------------
            5435                        real, DIMENSION(0:lkvl+1), INTENT(in):: wtm,wsm
            5436                        real, DIMENSION(0:lkvl+1), INTENT(in):: wtkem
            5437                        real, INTENT(out):: utauw,hcoolskin
            5438                        real:: XLD    ! downward mixing length   (m)
            5439                        real:: XLU    ! upward mixing length (m)
            5440                        real:: TKESTR ! =TKE*rho/G in (rho*z) (m2/s2*kg/m3/(m/s2))=(kg/m3*m)
            5441                        real:: POT    ! rho*z (potential energy difference) (kg/m3 *m)
            5442                        real:: wse,wte,RHOE   ! salinity, potential temp, density at TKE level (kg/m3)
            5443                        real:: dz     ! distance between two density levels/thickness for freeze (m)
            5444                        INTEGER  :: kk, jk
            5445                     
            5446     1                  IF (.NOT.lsoil) THEN
            5447     1                  !
            5448     1                  !   1.0 calc friction velocity of water side and thickness of cool skin (hcoolskin)
            5449     1                  !           = lamda * nu / uf
            5450     2                    IF(GDCHK2) THEN
            5451     2                      print *,"before frictionvelocity, tauwx=",tauwx
            5452     2                    ENDIF
            5453     1    i               utauw=frictionvelocity(tauwx,tauwy)
            5454     2                    IF (lcool_skin) THEN
            5455     2                      hcoolskin=cool_skin(pwind10w(jl),utauw)
            5456     2                    ELSE
            5457     2                      hcoolskin=0.
            5458     2                    ENDIF
            5459     1                  !
            5460     1                  !   2.0 For the skin layer and the missing layers
            5461     1                  !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.31, ITR: 48, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            5462     1  pp   2v           pwldisp(jl,0:nls)=xldispmin
            5463     1   p   2v           pwlmx(jl,0:nls)=xlkmin
            5464     1   p   2v           pwkm(jl,0:nls)=xkmmin
            5465     1   p   2v           pwkh(jl,0:nls)=xkhmin
            5466     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wtm, z, rhom
                                   <<< Loop-information  End >>>
            5467     2   s   2s           DO jk=0,nle+1
            5468     2               !!!      rhom(jk)=rhofn2(wtm(jk),wsm(jk),pwlvl(jl)-z(jk))
            5469     2               !!!       rhom(jk)=rho_from_theta(wsm(jk),wtm(jk)-tmelt,0.)
            5470     2   m   2m             rhom(jk)=rho_from_theta(wsm(jk),wtm(jk)-tmelt,pwlvl(jl)-z(jk))
            5471     2                      ! potential water density of one level higher (denoted as "h") at level jk
            5472     2   p   2v             IF (jk.GE.1) rhomh(jk)=rho_from_theta(wsm(jk-1),wtm(jk-1)-tmelt,pwlvl(jl)-z(jk))
            5473     3   p   2v             IF(GDCHK2) THEN
            5474     3       2                print *,"jk=",jk,",rhom=",rhom(jk),",rhomh=",rhomh(jk)
            5475     3   p   2v             ENDIF
            5476     2   p   2v           ENDDO
            5477     1                  !
            5478     1                  !   3.0 For layere nls+1 to nle+1
            5479     1                  !
            5480     2                    DO jk=nls+1,nle+1,1
            5481     2                      TKESTR         = wtkem(jk)*rhoh2o/G
            5482     2               !      density at TKE level
            5483     3                      IF (jk.EQ.(nls+1)) THEN
            5484     3                        wse     = (wsm(0)+wsm(jk))*.5
            5485     3                        wte     = (wtm(0)+wtm(jk))*.5
            5486     3                      ELSE
            5487     3                        wse     = (wsm(jk-1)+wsm(jk))*.5
            5488     3                        wte     = (wtm(jk-1)+wtm(jk))*.5
            5489     3                      ENDIF
            5490     3                      IF (GDCHK2) THEN
            5491     3                        print *,"jk=",jk,",TKESTR=",TKESTR,",wtkem=",wtkem(jk)
            5492     3                        print *,"rhoh2o=",rhoh2o,",G=",G,",wse=",wse,",wte=",wte
            5493     3                      ENDIF
            5494     2               !       Calc LD
            5495     2                      XLD        = 0.
            5496     2                      POT        = 0.
            5497     2                      kk         = jk
            5498     3                      DO WHILE ((POT.LT.TKESTR).AND.(kk.LE.nle+1))
            5499     4                       IF ((kk.LE.nls).AND.(kk.NE.0)) THEN
            5500     4               !         Do nothing & skip the layer!
            5501     4                         kk=kk+1
            5502     4                       ELSE
            5503     5                         IF (kk.EQ.nle+1) THEN
            5504     5                           dz=zlk(kk)-z(nle+1)     ! +, always
            5505     5                         ELSE
            5506     5                           dz=zlk(kk)-zlk(kk+1)    ! +, always
            5507     5                         ENDIF
            5508     4                         RHOE=rho_from_theta(wse,wte-tmelt,pwlvl(jl)-z(kk))
            5509     4                         XLD=XLD+dz
            5510     4                         POT=POT+dz*(rhom(kk)-RHOE)  ! increase along the depth
            5511     4                         kk=kk+1
            5512     4                       ENDIF
            5513     4                       IF(GDCHK2) THEN
            5514     4                         print *,"kk-1=",kk-1,",RHOE=",RHOE,",XLD=",XLD,",POT=",POT
            5515     4                       ENDIF
            5516     3                      ENDDO
            5517     3                      IF (POT.GT.TKESTR) THEN
            5518     3                      !! restore back slightlty
            5519     4                        IF(kk.EQ.0) THEN
            5520     4                          XLD  = MAX(XLD-(POT-TKESTR)/&
            5521     4               &            (rhom(0)-RHOE),tol)
            5522     4                        ELSE
            5523     4                          XLD  = MAX(XLD-(POT-TKESTR)/&
            5524     4               &            (rhom(kk-1)-RHOE),tol)
            5525     4                          IF(GDCHK2) print *,"1: XLD=",XLD
            5526     4                        ENDIF
            5527     3                      ELSE
            5528     3                        XLD  = MAX(XLD,tol)
            5529     3                        IF(GDCHK2) print *,"2: XLD=",XLD
            5530     3                      ENDIF
            5531     2                      IF(GDCHK2) print *,"3: XLD=",XLD
            5532     2               !
            5533     2                      ! add zero-dosplacement for reaching the bottom
            5534     2                      XLD  = MAX(XLD,d0)
            5535     2               !
            5536     2               !      Calc LU
            5537     2                      XLU        = 0.
            5538     2                      POT        = 0.
            5539     2                      kk         = jk
            5540     3                      DO WHILE ((POT.LT.TKESTR).AND.(kk.GE.nls+1))
            5541     4                        IF ((kk.LE.nls).AND.(kk.NE.0)) THEN
            5542     4               !          Do nothing & skip the layer!
            5543     4                          kk=kk-1
            5544     4                        ELSE
            5545     4                          RHOE=rho_from_theta(wse,wte-tmelt,pwlvl(jl)-z(kk-1))
            5546     4                          dz=zlk(kk-1)-zlk(kk)
            5547     4               !           dz=zlk(kk)-zlk(kk+1)
            5548     4                          XLU=XLU+dz
            5549     4                          POT=POT+dz*(RHOE-rhom(kk-1))
            5550     4                          kk=kk-1
            5551     4                        ENDIF
            5552     4                       IF(GDCHK2) THEN
            5553     4                         print *,"kk+1=",kk+1,",RHOE=",RHOE,",XLU=",XLU,",POT=",POT
            5554     4                       ENDIF
            5555     3                      ENDDO
            5556     3                      IF (POT.GT.TKESTR) THEN
            5557     3                      !! restore back slightlty
            5558     3                        XLU  = MAX(XLU-(POT-TKESTR)/&
            5559     3               &            (RHOE-rhom(kk+1)),tol)
            5560     3                        IF(GDCHK2) print *,"1: XLU=",XLU
            5561     3                      ELSE
            5562     3                        XLU  = MAX(XLU,tol)
            5563     3                        IF(GDCHK2) print *,"2: XLU=",XLU
            5564     3                      ENDIF
            5565     2                      IF(GDCHK2) print *,"3: XLU=",XLU
            5566     2                      ! add zero-dosplacement for reaching the top
            5567     2                      XLU  = MAX(XLU,d0)    ! add zero-dosplacement
            5568     2                      pwldisp(jl,jk)  = MAX(SQRT(XLD*XLU),xldispmin)        ! v.76, v76p
            5569     2                      pwlmx(jl,jk)    = MIN(XLD,XLU)
            5570     2               !      pwlmx(jl,jk)    = 2./(1./XLD+1./XLU)
            5571     2                     pwlmx(jl,jk)    = MAX(pwlmx(jl,jk),xlkmin)            !v.76p
            5572     2               !
            5573     2               !      4.0 Calc Momentum Diffusivity
            5574     2               !
            5575     2               !      Assunimg no skin layer for momentm since wind shear can enforce on the side. Note that the surface heat flux is from the top. (2011/8/29 bjt)
            5576     2               !!!       pwkm(jl,jk) = MIN(ck*pwlmx(jl,jk)*SQRT(wtkem(jk)),0.1_dp)*Prw+xkmmin                 !v9.7 or v.77
            5577     2               !!!       pwkm(jl,jk) = ck*pwlmx(jl,jk)*SQRT(wtkem(jk))*Prw+xkmmin                             !v9.8: bjt, 2013/5/2, crash
            5578     2                      pwkm(jl,jk) = MIN(ck*pwlmx(jl,jk)*SQRT(wtkem(jk)),100.)             !v9.8: Note that Lee JCL, 2001 set maximum pwkh to be 100 m^2/s
            5579     2               !!!       IF ( (z(0)-zlk(jk)).LE. (2.*hcoolskin) ) THEN                       ! v.91, 2004.10.18, (pwu, 1971)
            5580     2               !!!         ! momentum within viscous layer(1mm)
            5581     2               !!!         pwkm(jl,jk)  = xkmmin
            5582     2               !!!       ELSE
            5583     2               !!!         pwkm(jl,jk) = MIN(ck*pwlmx(jl,jk)*SQRT(wtkem(jk)),0.1_dp)*Prw+xkmmin                 ! v.77
            5584     2               !!!       ENDIF
            5585     2               !!       PRINT *,"pwlmx=",pwlmx(jl,jk),"TKE=",wtkem(jk),"pwkm=",pwkm(jl,jk)
            5586     2               !      A maximum value of 10 m2/s is imposed on KM to prevent
            5587     2               !      numerical error.
            5588     2               !      1.4e-6 is the molecular momentum diffusivity of water
            5589     2               !       (Pond & Pickard, 1983).
            5590     2               !      1.34e-6 is the molecular momentum diffusivity of water (Chia and pwu, 1998; Mellor and Durbin, 1975)
            5591     2               !      1.34e-7 is the molecular heat diffusivity of water (Chia and pwu, 1998; Mellor and Durbin, 1975)
            5592     2               !
            5593     2               !      5.0 Calc Heat Diffusivity
            5594     2               !
            5595     3                      IF ( (z(0)-zlk(jk)).LT.hcoolskin) THEN                              !v.77
            5596     3                        ! heat within conduction sublayer (0.4mm)
            5597     3                        pwkh(jl,jk)   = xkhmin
            5598     3                      ELSE
            5599     4                        IF (.TRUE.) THEN
            5600     4                        !! KE due to molecular diffusion has been considered in TKESTR
            5601     4               !ps           pwkh(jl,jk)   = MIN(pwkm(jl,jk)/Prw,100.)                             !v9.8: Note that Lee JCL, 2001 set maximum pwkh to be 100 m^2/s
            5602     5                          IF( (z(0)-zlk(jk)).LE. mixing_depth) THEN
            5603     5                            pwkh(jl,jk)   = MIN(MAX(pwkm(jl,jk)/Prw,xkhmin),100.)                             !v9.8: Note that Lee JCL, 2001 set maximum pwkh to be 100 m^2/s
            5604     5                          ELSE
            5605     5                            pwkh(jl,jk)   = MIN(pwkm(jl,jk)/Prw,100.)
            5606     5                          ENDIF
            5607     4                        ELSEIF ( (z(0)-zlk(jk)).LE.10.) THEN                              !v.77
            5608     4                        ! heat within conduction sublayer (0.4mm)
            5609     4                          pwkh(jl,jk)   = MIN(pwkm(jl,jk)/Prw,100.)+xkhmin                      ! otherwise it will crash
            5610     4                        ELSEIF (.TRUE.) THEN
            5611     4                        !! KE due to molecular diffusion has been considered in TKESTR
            5612     4                          pwkh(jl,jk)   = MIN(pwkm(jl,jk)/Prw,100.)                             !v9.8: Note that Lee JCL, 2001 set maximum pwkh to be 100 m^2/s
            5613     4                        ELSEIF (.TRUE.) THEN
            5614     5                          IF (jk.GE.nle) THEN
            5615     5                            pwkh(jl,jk)   = pwkm(jl,jk)/Prw                                        !v9.8994: last 2 levels remain the same
            5616     5                          ELSE
            5617     5                            pwkh(jl,jk)   = SQRT(pwkm(jl,jk)*pwkm(jl,jk+1))/Prw                    !v9.8994: Artifically using diffusivity one-level below (usually very small)
            5618     5                                                                                                       !         (or geometric mean) to preventing heat cross thermocline
            5619     5                          ENDIF
            5620     4                        ELSEIF (.TRUE.) THEN                                                           !v9.83 (MINOR=3), bjt, 20130824
            5621     5                          IF (jk.EQ.nle+1) THEN
            5622     5                            pwkh(jl,jk)   = pwkm(jl,jk)/Prw+xkhmin                                 !v9.8994: last level remain the same
            5623     5                          ELSE
            5624     5                            pwkh(jl,jk)   = SQRT(pwkm(jl,jk)*pwkm(jl,jk+1))/Prw+xkhmin             !v9.8994: Artifically using diffusivity one-level below (usually very small)
            5625     5                                                                                                       !         (or geometric mean) to preventing heat cross thermocline
            5626     5                          ENDIF
            5627     4                        ELSEIF (.TRUE.) THEN                                                               !v9.83, v9.98998 (MINOR=3), bjt, 20130824
            5628     4                          pwkh(jl,jk)   = pwkm(jl,jk)/Prw+xkhmin                                   !v9.8: bjt, 2013/5/2, crash
            5629     4                        ELSEIF (.TRUE.) THEN                                                           !v9.83 (MINOR=3), bjt, 20130824
            5630     4                          pwkh(jl,jk)   = MIN(pwkm(jl,jk)/Prw,100.)+xkhmin                       !v9.8: Note that Lee JCL, 2001 set maximum pwkh to be 100 m^2/s
            5631     4                        ELSEIF (lv81) THEN
            5632     4                          pwkh(jl,jk)   = MIN(pwkm(jl,jk)/Prw,0.1)+xkhmin                       !v9.7 or v.77
            5633     4                        ELSE
            5634     4                          pwkh(jl,jk)   = MIN(pwkm(jl,jk)/Prw,100.)+xkhmin                       !v9.8: Note that Lee JCL, 2001 set maximum pwkh to be 100 m^2/s
            5635     4                        ENDIF
            5636     3                      ENDIF
            5637     2                    END DO
            5638     1                  ENDIF
            5639                       END SUBROUTINE eddy
            5640                       ! **********************************************************************
            5641                       SUBROUTINE REGRID(  pbathy,     pctfreez2,  pwlvl,                      &
            5642                                           pzsi,       psilw,      ptsnic,                     &
            5643                                           pwt,        pwu,        pwv,                        &
            5644                                           pws,     pwtke,      pwlmx,                      &
            5645                                           pwldisp,    pwkm,       pwkh)
            5646                       ! ----------------------------------------------------------------------
            5647                     !!!    USE mo_sst,            ONLY: csn,rhosn,xksn,cice,rhoice,xkice,xkw,                   &
            5648                     !!!                                 omegas,wcri,tol,wlvlref,dpthmx
            5649                         IMPLICIT NONE
            5650                         real, INTENT(in):: pbathy(kbdim),   pctfreez2(kbdim)
            5651                       ! 3-d SIT vars: water column
            5652                         real, INTENT(in out) :: pwlvl(kbdim),                                   &
            5653                              pzsi(kbdim,0:1),   psilw(kbdim,0:1), ptsnic(kbdim,0:3),                &
            5654                              pwt(kbdim,0:lkvl+1), pwu(kbdim,0:lkvl+1), pwv(kbdim,0:lkvl+1),         &
            5655                              pws(kbdim,0:lkvl+1), pwtke(kbdim,0:lkvl+1), pwlmx(kbdim,0:lkvl+1),  &
            5656                              pwldisp(kbdim,0:lkvl+1), pwkm(kbdim,0:lkvl+1), pwkh(kbdim,0:lkvl+1)
            5657                     
            5658                       END SUBROUTINE REGRID
            5659                       ! ----------------------------------------------------------------------
            5660                       real FUNCTION frictionvelocity(taucx,taucy)
            5661                         !  taucx    : u-stress (Pa) over water                              I
            5662                         !  taucy    : v-stress (Pa) over water                              I
            5663                         !  frictionvelocity: friction velocity of water side (m/s)          O
            5664                         !   Tau/rho=N/m^2/(kg/m3)=(kg*m/s^2/m^2)/(kg/m3)=m^2/s^2
            5665                         !   frictionvelocity=sqrt(abs(taucx/rhoh2o)+abs(taucy/rhoh2o))
            5666                         !   or, frictionvelocity=sqrt((ustrw**2 + vstrw**2))
            5667                         !
            5668                         IMPLICIT NONE
            5669                         real, INTENT(in):: taucx,taucy
            5670                         frictionvelocity=sqrt(abs(taucx/rhoh2o)+abs(taucy/rhoh2o))
            5671     1                   IF(GDCHK2) THEN
            5672     1                    print *,"taucx=",taucx,",taucy=",taucy,",rhoh2o=",rhoh2o
            5673     1                   ENDIF
            5674                       END FUNCTION frictionvelocity
            5675                       ! ----------------------------------------------------------------------
            5676                       real FUNCTION cool_skin(wind10w,utauw)
            5677                         ! Description:
            5678                         !
            5679                         ! Calculates the thickness of cool skin by Saunders (1967) and Artale (2002)
            5680                         !
            5681                         !  wind10w  : 10m wind speed (m/s) over water                I
            5682                         !  utauw    : friction velocity of water side (m/s)          I
            5683                         !  cool_skin: thickness of cool skin (m)                     O
            5684                         !
            5685                         ! Method:
            5686                         !
            5687                         !   A. Gamma
            5688                         !      = 0.2u + 0.5  ; u <= 7.5m/s
            5689                         !      = 1.6u - 10   ; 7.5m/s < u < 10m/s
            5690                         !      = 6           ; 10 <= u
            5691                         !   Where u is the 10m wind speed
            5692                         !
            5693                         !   B. lamda
            5694                         !       = ( uf * k * C )/(gamma * rhoh2o * cw * h * nu )
            5695                         !
            5696                         !  Where ( for sea water of 20 degree Celsius at salinity 35 [g/kg] )
            5697                         !     uf = frictionl velocity of water (or stress)
            5698                         !     k = thermal conductivity = 0.596 [W/m K]
            5699                         !     C = 86400 s in a day
            5700                         !     rhoh2o = density of water = 1024.75 [kg/m**3]
            5701                         !     cw = specific heat of water = 3993  [kj/kg]
            5702                         !     h = reference depth = 10m
            5703                         !     nu = kinematic viscosity = 1.05*10**-6 [m**2/s]
            5704                         !
            5705                         !   C. hcoolskin  (Cool skin thickness)
            5706                         !       = lamda * nu / uf
            5707                         !
            5708                         !   D. Temperature difference across cool skin
            5709                         !       = Qn * hcoolskin / k
            5710                         !   Where
            5711                         !       Qn = net surface heat flux [W/m**2]
            5712                         !
            5713                         ! *skinsst* is called from *physc*.
            5714                         !
            5715                         ! Authors:
            5716                         !
            5717                         ! N. Keenlyside & Chia-Ying Tu, IFM-GEOMAR, June 2006, original source
            5718                     
            5719                         IMPLICIT NONE
            5720                         real, INTENT(in):: wind10w,utauw
            5721                     
            5722                         ! Local Physical Parameters
            5723                         real, PARAMETER:: k = 0.596      ! thermal conductivity  [W/m K]
            5724                         INTEGER, PARAMETER  :: C = 86400      ! s in a day
            5725                       !!!  real, PARAMETER:: rhoh2o = 1024.75 ! density of water [kg/m**3]
            5726                       !!!  real, PARAMETER:: cw = 3993      ! specific heat of water [kj/kg]
            5727                         real, PARAMETER:: refh = 10
            5728                         ! reference depth [m] in Artale's formula of lamda_d (Artale, 2002)
            5729                         real, PARAMETER:: nu = 1.05E-6   ! kinematic viscosity of water [m**2/s]
            5730                       !  real:: Qb                       !CYTu, v91
            5731                       !  real:: gamma            !CYTu, v91
            5732                       !  real:: lamda_d          ! nodimensional constant in determing cool skin depth (Sauners, 1967)
            5733                       !                                                       ! lamda_d = 5.8 (Jin sitwu, 1971)
            5734                       !  real:: lamda_h
            5735                       !  real:: nuw !/1.14E-6/           ! kinematic viscosity of seawater (m2 s-1) (Pauson and Simpson, 1981)
            5736                       !
            5737                         INTEGER, PARAMETER::  lsaunders=1     ! Artale et al.,2002 scheme
            5738                     
            5739                         ! Local variables
            5740                         real:: gamma, lamda, frictionvelocity, Qnet, Tdiff
            5741                         !
            5742                         !   A. Gamma
            5743                         !      = 0.2u + 0.5  ; u <= 7.5m/s
            5744                         !      = 1.6u - 10   ; 7.5m/s < u < 10m/s
            5745                         !      = 6           ; 10 <= u
            5746                         !   Where u is the 10m wind speed
            5747     1                   IF (lsaunders .EQ. 1) THEN !   Saunders Constant (Artale et al.,2002)
            5748     2                      IF ( wind10w <= 7.5 ) THEN
            5749     2                         gamma = 0.2 * wind10w  + 0.5
            5750     2                      ELSEIF (( 7.5 < wind10w).and.(wind10w < 10 )) THEN
            5751     2                         gamma = 1.6 * wind10w - 10
            5752     2                      ELSE
            5753     2                         gamma=6
            5754     2                      ENDIF
            5755     1                 !   B. lamda
            5756     1                 !           =( uf * k * C )/(gamma * rhoh2o * cw * h * nu )
            5757     1                 !                tauc/rhoh2o
            5758     1                      lamda=(utauw*0.596*86400)/(gamma*rhoh2o*clw*refh*nu)
            5759     1                 !
            5760     1                 !!!!      wsstrw=wsstra*SQRT(1.26/1020.)        ! density ratio of air/seawater (Paulson and Simpson, 1981)
            5761     1                   ELSE IF (lsaunders .EQ. 2)THEN !      Saunders Constant (pwu,1971)
            5762     1                      lamda=5.8
            5763     1                   ELSE IF (lsaunders .EQ. 3)THEN !      Saunders Constant (Paulson and Simpson,1981)
            5764     1                      lamda=6.5
            5765     1                   ELSE IF (lsaunders .EQ. 4)THEN !      Saunders Constant (pwu,1985)
            5766     2                      IF (wind10w.LE.7.)THEN
            5767     2                         lamda=2.+5.*wind10w/7.
            5768     2                      ELSE
            5769     2                         lamda=7.
            5770     2                      ENDIF
            5771     1                 !  ELSE IF (lsaunders .EQ. 5)THEN !     Saunders Constant (Fairall,1996)
            5772     1                 !     Qb=(-Rld+LE+H+Rlu)+((0.026*4.19E-3)/(alv*3.E-4))*H
            5773     1                 !     lamda=6.*(1.+((Qb*16.*g*3.E-4*rhowcw*(nuw**3.))/((wsstrw**4.)*(0.59**2.)))**(3./4.))**(-1./3.)
            5774     1                   ENDIF
            5775                       !
            5776                       ! Thickness of Thermal Sublayer (Saunders, 1967)
            5777                       !
            5778                       !   C. hcoolskin  (Cool skin thickness)
            5779                       !           = lamda * nu / uf
            5780                         cool_skin=lamda*nu/utauw
            5781                       !  !   D. Temperature difference across cool skin
            5782                       !  !           = Qn * hcoolskin / k
            5783                       !  Tdiff=-pfluxw2*hcoolskin/0.596
            5784                       !  !
            5785                       !  ptsw(jl)=pobswtb(jl)+Tdiff
            5786                         RETURN
            5787                       END FUNCTION cool_skin
            5788                       ! **********************************************************************
            5789                       SUBROUTINE LKDIFKH(hew,X,Y)
            5790                       !
            5791                       ! Calculate X, Y coefficient matrix for tmeperature and salinity with kh
            5792                       !
            5793                       ! Output: X,Y,hew
            5794                       !
            5795                       !*    0. Locate Space
            5796                       !
            5797                         IMPLICIT NONE
            5798                       !
            5799                         real, INTENT(out):: hew    ! effective skin thickness of water (m)
            5800                         real, DIMENSION(0:lkvl+5), INTENT(out):: X,Y
            5801                     
            5802                         INTEGER :: jk,levelm,level,levelp
            5803                     
            5804                       ! For the skin layer
            5805                     
            5806                         xkhskin=SQRT(pwkh(jl,0)*pwkh(jl,nls+1))         ! calc the heat diffusivity for skin layer
            5807          i              hew=HEFN(hw(0),xkhskin,omegas)
            5808                       !
            5809                       ! For skin layer, middle layers and bottom soil layers
            5810                       !
            5811     1   s    s          DO jk=0,nle+1-nls
            5812     1   p    v            levelm=nls+jk-1
            5813     1   p    s            IF (levelm.EQ.nls) levelm=0
            5814     1   p    v            level=nls+jk
            5815     1   p    s            IF (level.EQ.nls) level=0
            5816     1   p    v            levelp=nls+jk+1
            5817     1               
            5818     2   p    s            IF (level.EQ.0) THEN
            5819     2                     !! Skin layer
            5820     2   p    s              X(4+jk)=0.
            5821     2   m    s              Y(4) = zdtime/hew*pwkh(jl,levelp)/(z(level)-z(levelp))
            5822     2   p    s            ELSE IF (level.EQ.nle+1) THEN
            5823     2                     !! Soil layer
            5824     2   p    s              X(4+jk)= zdtime/(rhogcg*SQRT(xkg/omegas))*  &
            5825     2                         rhoh2o*clw*pwkh(jl,level)/(z(levelm)-z(level))
            5826     2   m    m              Y(4+jk)=0.
            5827     2   p    s            ELSE
            5828     2                     !! Middle water layers
            5829     2   p    s              X(4+jk)= zdtime/hw(level)*pwkh(jl,level)/(z(levelm)-z(level))
            5830     2   m    s              Y(4+jk)= zdtime/hw(level)*pwkh(jl,levelp)/(z(level)-z(levelp))
            5831     2   p    v            ENDIF
            5832     1   p    v          ENDDO
            5833                       END SUBROUTINE LKDIFKH
            5834                       ! ----------------------------------------------------------------------
            5835                       SUBROUTINE LKDIFKM(hew,X,Y)
            5836                       !
            5837                       ! Calculate X, Y coefficient (dimensionless) matrix for TKE with Km
            5838                       !
            5839                       ! Output: X,Y,hew
            5840                       !
            5841                       !*    0. Locate Space
            5842                       !
            5843                         IMPLICIT NONE
            5844                         real, INTENT(out):: hew    ! effective skin thickness of water (m)
            5845                         real, DIMENSION(0:lkvl+5), INTENT(out):: X,Y
            5846                       !
            5847                         INTEGER :: jk,levelm,level,levelp
            5848                         real:: xkmskin   ! skin layer momentum diffusivity (m2/s)
            5849                     
            5850                       ! For the skin layer
            5851                     
            5852                         xkmskin=SQRT(xkmmin*pwkm(jl,0))         ! calc the momentum diffusivity for skin layer
            5853          i              hew=HEFN(hw(0),xkmskin,omegas)
            5854                       !
            5855                       ! For skin layer, middle layers and bottom soil layers
            5856                       !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      z
                                   <<< Loop-information  End >>>
            5857     1   s    s          DO jk=0,nle-nls
            5858     1   p    v            levelm=nls+jk-1
            5859     1   p    s            IF (levelm.EQ.nls) levelm=0
            5860     1   p    v            level=nls+jk
            5861     1   p    s            IF (level.EQ.nls) level=0
            5862     1   p    v            levelp=nls+jk+1
            5863     1               
            5864     2   p    s            IF (level.EQ.0) THEN
            5865     2                     !! Skin layer
            5866     2   p    s              X(4+jk)=0.
            5867     2   m    s              Y(4) = zdtime/hew*pwkm(jl,levelp)/(z(level)-z(levelp))
            5868     2   p    s            ELSE
            5869     2                     !! Middle water layers
            5870     2   p    s              X(4+jk)= zdtime/hw(level)*pwkm(jl,level)/(z(levelm)-z(level))
            5871     2   m    s              Y(4+jk)= zdtime/hw(level)*pwkm(jl,levelp)/(z(level)-z(levelp))
            5872     2   p    v            ENDIF
            5873     1   p    v          ENDDO
            5874                       END SUBROUTINE LKDIFKM
            5875                       ! ----------------------------------------------------------------------
            5876                       SUBROUTINE LU(mas,mae,AA,RHS,SOL)
            5877                       ! ----------------------------------------------------------------------
            5878                       !  AA : MATRIX OF COEFFICIENTS A  (MN,kk,3)           I
            5879                       !       1ST COLUMN = ELEMENTS LEFT TO THE DIAGONAL,
            5880                       !       2ND COLUMN = DIAGONAL ELEMENTS,
            5881                       !       3RD COLUMN = ELEMENTS RIGHT TO THE DIAGONAL,
            5882                       !  RHS: RIGHT HAND SIDE OF THE MATRIX (FORCING)
            5883                       !  SOL: SOLUTION OF THE MATRIX
            5884                       !  WKK : WORKING ARRAY               (MN,kk,4)
            5885                       ! ----------------------------------------------------------------------
            5886                       !
            5887                     !!!    USE mo_kind
            5888                         IMPLICIT NONE
            5889                         real:: RHS(0:lkvl+5),AA(0:lkvl+5,3),SOL(0:lkvl+5)
            5890                         real:: WKK(0:lkvl+5,4)
            5891                         INTEGER jk,mas,mae
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 552
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.66, ITR: 48, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      RHS, AA, WKK
                                   <<< Loop-information  End >>>
            5892     1  pp    v          DO jk=mas,mae
            5893     1   p    v            WKK(jk,1)=DBLE(AA(jk,1))
            5894     1   p    v            WKK(jk,2)=DBLE(AA(jk,2))
            5895     1   p    v            WKK(jk,3)=DBLE(AA(jk,3))
            5896     1   p    v            WKK(jk,4)=DBLE(RHS(jk))
            5897     1   p    v          ENDDO
            5898                       !
            5899                       ! ----------------------------------------------------------------------
            5900                       !
            5901                       !*   SOLVE THE TRIDIAGONAL MXTRIX
            5902                       !
            5903                       !   [ 1  ]       [DR   ] [23  ]
            5904                       !   [ L1 ] * [ DR  ]=[123 ]
            5905                       !   [ L1 ]       [      DR ] [ 123]
            5906                       !-----------------------------------------------------------------
            5907                       !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.12, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      WKK
                                   <<< Loop-information  End >>>
            5908     1   s   2s          DO jk = mas+1, mae
            5909     1   s   2s            WKK(jk,1) = WKK(jk,1) / WKK(jk-1,2)
            5910     1   s   2s            WKK(jk,2) = WKK(jk,2) - WKK(jk,1)*WKK(jk-1,3)
            5911     1   s   2s            WKK(jk,4) = WKK(jk,4) - WKK(jk,1)*WKK(jk-1,4)
            5912     1   s   2s          ENDDO
            5913                       !
            5914                       !     BACK SUBSTITUTION
            5915                       !
            5916                         WKK(mae,4) = WKK(mae,4) /WKK(mae,2)
            5917                       !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.16, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      WKK
                                   <<< Loop-information  End >>>
            5918     1   s   2s          DO jk = mae-1, mas,-1
            5919     1   s   2s            WKK(jk,4) = (WKK(jk,4)-WKK(jk,3)*WKK(jk+1,4)) /WKK(jk,2)
            5920     1   s   2s          ENDDO
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      WKK, SOL
                                   <<< Loop-information  End >>>
            5921     1  pp   4v          DO jk=mas,mae
            5922     1   p   4v            SOL(jk)=REAL(WKK(jk,4))
            5923     1   p   4v          ENDDO
            5924                       END     SUBROUTINE LU
            5925                       ! ----------------------------------------------------------------------
            5926                       ! ----------------------------------------------------------------------
            5927                       SUBROUTINE LU2(mas,mae,AA,RHS,SOL)
            5928                       ! ----------------------------------------------------------------------
            5929                       !     same as LU, except for complex matrix
            5930                       ! ----------------------------------------------------------------------
            5931                       !
            5932                         IMPLICIT NONE
            5933                         INTEGER mas,mae
            5934                         COMPLEX :: RHS(0:lkvl+5),AA(0:lkvl+5,3),SOL(0:lkvl+5),WKK(0:lkvl+5,4)
            5935                         INTEGER jk
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 297
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.08, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      RHS, AA, WKK
                                   <<< Loop-information  End >>>
            5936     1  pp    v          DO jk=mas,mae
            5937     1   p    v                WKK(jk,1)=AA(jk,1)
            5938     1   p    v            WKK(jk,2)=AA(jk,2)
            5939     1   p    v            WKK(jk,3)=AA(jk,3)
            5940     1   p    v            WKK(jk,4)=RHS(jk)
            5941     1   p    v          ENDDO
            5942                       !
            5943                       !-----------------------------------------------------------------
            5944                       !*   SOLVE THE TRIDIAGONAL MXTRIX
            5945                       !
            5946                       !       [ 1      ]       [DR   ] [23  ]
            5947                       !    [ L1        ] * [ DR  ]=[123 ]
            5948                       !    [  L1 ]     [      DR ] [ 123]
            5949                       !-----------------------------------------------------------------
            5950                       !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      WKK
                                   <<< Loop-information  End >>>
            5951     1   s    s          DO jk = mas+1, mae
            5952     1   m    s            WKK(jk,1) = WKK(jk,1) / WKK(jk-1,2)
            5953     1   m    s            WKK(jk,2) = WKK(jk,2) - WKK(jk,1)*WKK(jk-1,3)
            5954     1   m    s            WKK(jk,4) = WKK(jk,4) - WKK(jk,1)*WKK(jk-1,4)
            5955     1   p    s          ENDDO
            5956                       !
            5957                       !     BACK SUBSTITUTION
            5958                       !
            5959                           WKK(mae,4) = WKK(mae,4) /WKK(mae,2)
            5960                       !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      WKK
                                   <<< Loop-information  End >>>
            5961     1   s   2s          DO jk = mae-1, mas,-1
            5962     1   m   2s            WKK(jk,4) = (WKK(jk,4)-WKK(jk,3)*WKK(jk+1,4)) /WKK(jk,2)
            5963     1   p   2s          ENDDO
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      WKK, SOL
                                   <<< Loop-information  End >>>
            5964     1  pp   2v          DO jk=mas,mae
            5965     1   p   2v            SOL(jk)=WKK(jk,4)
            5966     1   p   2v          ENDDO
            5967                       END SUBROUTINE LU2
            5968                       ! ----------------------------------------------------------------------
            5969                       real FUNCTION levitus_t(tb,z)
            5970                       !  z=0. m at the surface (+ upward)
            5971                       !  tb: bulk sea temperature (K)
            5972                       !-----------------------------------------------------------------------
            5973                         IMPLICIT NONE
            5974                         real, INTENT(in)::  z, tb
            5975                         levitus_t   = tmelt+4+(tb-tmelt-4)*EXP(z/100.)  ! set initial profile to be expontential decay to tmelt+4 K
            5976                       END FUNCTION levitus_t
            5977                       ! ----------------------------------------------------------------------
            5978                       real FUNCTION levitus_s(obswsb,z)
            5979                       !  z=0. m at the surface (+ upward)
            5980                       !  obswsb: bulk sea salinity (PSU)
            5981                       !-----------------------------------------------------------------------
            5982                         IMPLICIT NONE
            5983                         real, INTENT(in)::  z, obswsb
            5984                         levitus_s   = obswsb
            5985                       END FUNCTION levitus_s
            5986                       ! ----------------------------------------------------------------------
            5987                       real FUNCTION FFN(z)
            5988                       !*** 2 components ***
            5989                       !*****************************************************************************
            5990                       ! CALC PENETRATION COEFFICIENT OF SOLAR RADIATION PAULSON AND SIMPSON 1977
            5991                       ! J. OF PHYSICAL OCEANOGRAPHY, VOL. 7, PP. 952- 956
            5992                       !*****************************************************************************
            5993                       ! CONSTANT (JERLOV's (1976) OPTICAL WATER TYPE I)
            5994                       !  z=0. M at the surface (+ upward)
            5995                       !-----------------------------------------------------------------------
            5996                       !  IMPLICIT NONE
            5997                       !  real:: z,R,D1,D2
            5998                       !  R    = 0.58
            5999                       !  D1   = 0.35
            6000                       !  D2   = 23.
            6001                       !  FFN   = R*EXP(+z/D1)+(1-R)*EXP(+z/D2)
            6002                       !END FUNCTION FFN
            6003                       !
            6004                       !*** 9 components ***
            6005                       !*****************************************************************************
            6006                       ! THE TEMPERATURE DIFFERENCE ACROSS COOL SKIN : PAULSON AND SIMPSON 1981
            6007                       ! J. OF GEOPHYSICAL RESEARCH, VOL. 86, PP. 11,044- 11,054
            6008                       !*****************************************************************************
            6009                       ! EVOLUTION OF COOL SKIN AND DIRECT SEA-AIR GAS TRANSFER COEFFICEINT DURING
            6010                       ! DAYTIME : SOLOVIEV AND SCHLUESSEL 1996
            6011                       ! BOUNDARY LAYER METEOROLOGY, VOL. 77, PP. 45- 68
            6012                       !*****************************************************************************
            6013                       ! SOLOVIEV AND SCHLUESSEL (1996) MODIFIED THE PAULSON AND SIMPSON (1981) EQUATION
            6014                       ! OF CLEAR WATER FRO VARIOUS TYPES OF WATER DEFINED BY JERLOV (1976)
            6015                       !*****************************************************************************
            6016                         IMPLICIT NONE
            6017                         real:: z ! depth (m), plus upward
            6018                         real:: F(9)      ! spectral distribution (ratio)
            6019                         real:: D(9)      ! absorption length (m)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            6020         s    v          D(1:9)=(/34.795,2.27,3.15E-2,5.48E-3,8.32E-4,1.26E-4,3.13E-4,7.82E-5,1.44E-5/)
            6021         p    v          F(1:9)=(/0.237,0.36,0.179,0.087,0.08,0.0246,0.025,0.007,0.0004/)
            6022                     
            6023     1                   IF(wtype .EQ. 10)THEN
            6024     1                         D(1)    = 15.152                ! SOLOVIEV AND SCHLUESSEL (1996,type I)
            6025     1                   ELSE IF(wtype .EQ. 11)THEN
            6026     1                         D(1)    = 13.158                ! SOLOVIEV AND SCHLUESSEL (1996,type IA)
            6027     1                   ELSE IF(wtype .EQ. 12)THEN
            6028     1                         D(1)    = 11.364                ! SOLOVIEV AND SCHLUESSEL (1996,type IB)
            6029     1                   ELSE IF(wtype .EQ. 20)THEN
            6030     1                         D(1)    = 7.576                 ! SOLOVIEV AND SCHLUESSEL (1996,type II)
            6031     1                   ELSE IF(wtype .EQ. 30)THEN
            6032     1                         D(1)    = 2.618                 ! SOLOVIEV AND SCHLUESSEL (1996,type III)
            6033     1                   ELSE IF(wtype .EQ. 1)THEN
            6034     1                         D(1)    = 2.041                 ! SOLOVIEV AND SCHLUESSEL (1996,type 1)
            6035     1                   ELSE IF(wtype .EQ. 3)THEN
            6036     1                         D(1)    = 1.429                 ! SOLOVIEV AND SCHLUESSEL (1996,type 3)
            6037     1                   ELSE IF(wtype .EQ. 5)THEN
            6038     1                         D(1)    = 1.                   ! SOLOVIEV AND SCHLUESSEL (1996,type 5)
            6039     1                   ELSE IF(wtype .EQ. 7)THEN
            6040     1                         D(1)    = 0.917                 ! SOLOVIEV AND SCHLUESSEL (1996,type 7)
            6041     1                   ELSE IF(wtype .EQ. 9)THEN
            6042     1                         D(1)    = 0.625                 ! SOLOVIEV AND SCHLUESSEL (1996,type 9)
            6043     1                   ELSE
            6044     1                         D(1)    = 34.795                ! PAULSON AND SIMPSON (1981)
            6045     1                   ENDIF
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            6046         s    v          FFN   = SUM(F*EXP(z/D))
            6047                       !  dFFN   = (F1/D1)+(F2/D2)+(F3/D3)+(F4/D4)+(F5/D5)+(F6/D6) &
            6048                       !                       +(F7/D7)+(F8/D8)+(F9/D9)
            6049                     
            6050                       END FUNCTION FFN
            6051                       ! ----------------------------------------------------------------------
            6052                       ! ----------------------------------------------------------------------
            6053                       real FUNCTION DFFN(z)
            6054                       !*** 2 components ***
            6055                       !*****************************************************************************
            6056                       ! CALC Derivative of PENETRATION COEFFICIENT OF SOLAR RADIATION PAULSON AND SIMPSON 1977
            6057                       ! J. OF PHYSICAL OCEANOGRAPHY, VOL. 7, PP. 952- 956
            6058                       !*****************************************************************************
            6059                       ! CONSTANT (JERLOV's (1976) OPTICAL WATER TYPE I)
            6060                       !  z=0. M at the surface (+ upward)
            6061                       !-----------------------------------------------------------------------
            6062                       !  IMPLICIT NONE
            6063                       !  real:: z,R,D1,D2
            6064                       !  R    = 0.58
            6065                       !  D1   = 0.35
            6066                       !  D2   = 23.
            6067                       !  FFN   = R*EXP(+z/D1)+(1-R)*EXP(+z/D2)
            6068                       !END FUNCTION FFN
            6069                       !
            6070                       !*** 9 components ***
            6071                       !*****************************************************************************
            6072                       ! THE TEMPERATURE DIFFERENCE ACROSS COOL SKIN : PAULSON AND SIMPSON 1981
            6073                       ! J. OF GEOPHYSICAL RESEARCH, VOL. 86, PP. 11,044- 11,054
            6074                       !*****************************************************************************
            6075                       ! EVOLUTION OF COOL SKIN AND DIRECT SEA-AIR GAS TRANSFER COEFFICEINT DURING
            6076                       ! DAYTIME : SOLOVIEV AND SCHLUESSEL 1996
            6077                       ! BOUNDARY LAYER METEOROLOGY, VOL. 77, PP. 45- 68
            6078                       !*****************************************************************************
            6079                       ! SOLOVIEV AND SCHLUESSEL (1996) MODIFIED THE PAULSON AND SIMPSON (1981) EQUATION
            6080                       ! OF CLEAR WATER FRO VARIOUS TYPES OF WATER DEFINED BY JERLOV (1976)
            6081                       !*****************************************************************************
            6082                         IMPLICIT NONE
            6083                         real:: z ! depth (m), plus upward
            6084                         real:: F(9)      ! spectral distribution (ratio)
            6085                         real:: D(9)      ! absorption length (m)
            6086                         D(1:9)=(/34.795,2.27,3.15E-2,5.48E-3,8.32E-4,1.26E-4,3.13E-4,7.82E-5,1.44E-5/)
            6087                         F(1:9)=(/0.237,0.36,0.179,0.087,0.08,0.0246,0.025,0.007,0.0004/)
            6088                     
            6089     1                   IF(wtype .EQ. 10)THEN
            6090     1                         D(1)    = 15.152                ! SOLOVIEV AND SCHLUESSEL (1996,type I)
            6091     1                   ELSE IF(wtype .EQ. 11)THEN
            6092     1                         D(1)    = 13.158                ! SOLOVIEV AND SCHLUESSEL (1996,type IA)
            6093     1                   ELSE IF(wtype .EQ. 12)THEN
            6094     1                         D(1)    = 11.364                ! SOLOVIEV AND SCHLUESSEL (1996,type IB)
            6095     1                   ELSE IF(wtype .EQ. 20)THEN
            6096     1                         D(1)    = 7.576                 ! SOLOVIEV AND SCHLUESSEL (1996,type II)
            6097     1                   ELSE IF(wtype .EQ. 30)THEN
            6098     1                         D(1)    = 2.618                 ! SOLOVIEV AND SCHLUESSEL (1996,type III)
            6099     1                   ELSE IF(wtype .EQ. 1)THEN
            6100     1                         D(1)    = 2.041                 ! SOLOVIEV AND SCHLUESSEL (1996,type 1)
            6101     1                   ELSE IF(wtype .EQ. 3)THEN
            6102     1                         D(1)    = 1.429                 ! SOLOVIEV AND SCHLUESSEL (1996,type 3)
            6103     1                   ELSE IF(wtype .EQ. 5)THEN
            6104     1                         D(1)    = 1.                   ! SOLOVIEV AND SCHLUESSEL (1996,type 5)
            6105     1                   ELSE IF(wtype .EQ. 7)THEN
            6106     1                         D(1)    = 0.917                 ! SOLOVIEV AND SCHLUESSEL (1996,type 7)
            6107     1                   ELSE IF(wtype .EQ. 9)THEN
            6108     1                         D(1)    = 0.625                 ! SOLOVIEV AND SCHLUESSEL (1996,type 9)
            6109     1                   ELSE
            6110     1                         D(1)    = 34.795                ! PAULSON AND SIMPSON (1981)
            6111     1                   ENDIF
            6112                         DFFN=SUM(F/D*EXP(z/D))
            6113                       !  DFFN   = (F1/D1)+(F2/D2)+(F3/D3)+(F4/D4)+(F5/D5)+(F6/D6) &
            6114                       !                       +(F7/D7)+(F8/D8)+(F9/D9)
            6115                     
            6116                       END FUNCTION DFFN
            6117                       !!! bjt >> too cold
            6118                       !!!  real, PARAMETER:: csiced=0.8     ! threshold sea ice depth, (= 0.8 m)
            6119                       !!!                                           ! seaice[siced]=1-Exp[-siced/csiced]
            6120                       !!!                                           ! seaice[2.]=0.91795
            6121                       !!! 1)
            6122                       !!!    ! Assuming sea ice fraction increases with siced
            6123                       !!!    ! sea ice fraction = 100% if siced > csiced (=1 m)
            6124                       !!!    ! Otherwise increase linearly with siced/csiced
            6125                       !!!    IF (pzsi(jl,1) .GT. csiced) THEN
            6126                       !!!      pseaice(jl)=1.
            6127                       !!!    ELSE
            6128                       !!!      pseaice(jl)=psiced(jl)/csiced
            6129                       !!!    ENDIF
            6130                       !!! 2)
            6131                       !!!    pseaice(jl)=1.-EXP(-psiced(jl)/csiced)
            6132                       !!!    seaice2[siced_, m_, c_] := N[Erf[c*(siced - m)]/2 - Erf[-c*m]/2]
            6133                       !!!    c=2
            6134                       !!!    m=1
            6135                       !!! cold bias is found for the above Eq.
            6136                       ! ----------------------------------------------------------------------
            6137                       SUBROUTINE lkerr(err_message,hesn,hew,heice,fcew,pfluxwm,wtm,wsm,tsim,ctfreeze,mas,mae,SOL)
            6138                       !   USE mo_memory_g3b,    ONLY: obswt,obsws
            6139                         IMPLICIT NONE
            6140                         real, INTENT(in):: hesn,heice,hew,fcew,pfluxwm,ctfreeze
            6141                         real, DIMENSION(0:3), INTENT(in):: tsim
            6142                         real, DIMENSION(0:lkvl+1), INTENT(in):: wtm,wsm
            6143                         real, DIMENSION(0:lkvl+5), INTENT(in):: SOL
            6144                         INTEGER, INTENT(in)  :: mas,mae
            6145                         CHARACTER(len = *) :: err_message
            6146                       !  CHARACTER(len = 80) :: err_message(12)={"Water freezes but phase change energy > 0.",         &  !  1
            6147                       !                                       "Ice melts but phase change energy < 0.",             &  !  2
            6148                       !                                       "Snow melts but phase change energy <0.",             &  !  3
            6149                       !                                       "Water freezes completely.",                           &  !  4
            6150                       !                                       "Recursive more than 4 times.",                       &  !  5
            6151                       !                                       "Depth is less than 0.2 M. Soil only is assumed.",    &  !  6
            6152                       !                                       "Ice melts completely due to level 4 forcing.",       &  !  7
            6153                       !                                       "Ice melts completely due to level 3 forcing.",       &  !  8
            6154                       !                                       "Recursive goto 830 skin water layer setup.",         &  !  9
            6155                       !                                       "Recursive goto 840 ice layer setup.",                &  ! 10
            6156                       !                                       "Water starts to freeze.",                             &  ! 11
            6157                       !                                       "Snow melts completely." }                               ! 12
            6158                     #ifdef DEBUG
            6159     1                   IF (GDCHK2) THEN
            6160     1               #else
            6161     1                   IF (lwarning_msg.GE.3) THEN
            6162     1               #endif
            6163     1                      WRITE(nerr,*) "sit_vdiff: ","jl=",jl,"jrow=",jrow,"istep=",istep,                        &
            6164     1                          "sit_step=",i_sit_step,                                                                &
            6165     1                          "lat=",plat(jl),"lon=",plon(jl), err_message,                      &
            6166     1                          "hew=",hew,"hesn=",hesn,                          &
            6167     1                          "rhoh2o=",rhoh2o,"rhosn=",rhosn,"xksn=",xksn,"omegas=",omegas,                         &
            6168     1                          "heice=",heice,"fcew=",fcew,"ctfreeze=",ctfreeze,                     &
            6169     1                          "pfluxw=",pfluxw2,"sn=",pzsi(jl,0),"ice=",pzsi(jl,1),"tsw=",pwt(jl,0),              &
            6170     1                          "pfluxwm=",pfluxwm,"pdfluxs=",pdfluxs(jl),"soflw=",psoflw(jl),                         &
            6171     1                          "evapw=",pevapw(jl),"rsf=",prsf(jl),"ssf=",pssf(jl),             &
            6172     1                          "silw(0)=",psilw(jl,0),"silw(1)=",psilw(jl,1),                       &
            6173     1                          "rainfall heat flux=",( prsf(jl) )*clw*(wtm(nls+1)-ptemp2(jl)),             &
            6174     1                          "snowfall heat flux=",( pssf(jl) )*( alf+csn*(tmelt-ptemp2(jl))+clw*(wtm(nls+1)-tmelt) ), &
            6175     1                          "snow heat flux=",pzsi(jl,0)*rhoh2o/zdtime*( alf+csn*(tmelt-tsim(1))+clw*(wtm(nls+1)-tmelt) ) &
            6176     1                            +psilw(jl,0)*rhoh2o/zdtime*clw*(wtm(nls+1)-tmelt),                                   &
            6177     1                          "ice flux=", pzsi(jl,1)*rhoh2o/zdtime*( alf+cice*(tmelt-tsim(3))+clw*(wtm(nls+1)-tmelt) )     &
            6178     1                            +psilw(jl,1)*rhoh2o/zdtime*clw*(wtm(nls+1)-tmelt),                                   &
            6179     1                          "temp2=",ptemp2(jl),"nls=",nls,"nle=",nle,                                             &
            6180     1                          "tsim(:)=",tsim(:),"tsi=",ptsi(jl),                                                    &
            6181     1                          "sittsi(:)=",ptsnic(jl,:),                                                             &
            6182     1                          "wtm(:)=",wtm(:),"sitwt(:)=",pwt(jl,:),                                                &
            6183     1                          "mas=",mas,"mae=",mae,"SOL=",SOL
            6184     1                 !!!         "mas=",mas,"mae=",mae,"AA(0)=",AA(0,:),"RHS=",RHS,"SQL=",SOL
            6185     1               
            6186     1                   ELSE
            6187     1                      RETURN
            6188     1                   ENDIF
            6189                     
            6190                       !  CALL write_date(current_date,' sit_vdiff Current date: ')
            6191                       !  WRITE(nerr,*) "sit_vdiff Pt. (jl,jrow,istep)=(",jl,jrow, istep,")"
            6192                       !  IF (iderr.EQ.1) THEN
            6193                       !    WRITE(nerr,*) "Water freezes but phase change energy > 0."
            6194                       !  ELSEIF (iderr.EQ.2) THEN
            6195                       !    WRITE(nerr,*) "Ice melts but phase change energy < 0."
            6196                       !  ELSEIF (iderr.EQ.3) THEN
            6197                       !    WRITE(nerr,*) "Snow melts but phase change energy <0."
            6198                       !  ELSEIF (iderr.EQ.4) THEN
            6199                       !    WRITE(nerr,*) "Water freezes completely."
            6200                       !  ELSEIF (iderr.EQ.5) THEN
            6201                       !    WRITE(nerr,*) "Recursive more than 4 times."
            6202                       !  ELSEIF (iderr.EQ.6) THEN
            6203                       !    WRITE(nerr,*) "Depth is less than 0.2 M. Soil only is assumed."
            6204                       !  ELSEIF (iderr.EQ.7) THEN
            6205                       !    WRITE(nerr,*) "Ice melts completely due to level 4 forcing."
            6206                       !  ELSEIF (iderr.EQ.8) THEN
            6207                       !    WRITE(nerr,*) "Ice melts completely due to level 3 forcing."
            6208                       !  ELSEIF (iderr.EQ.9) THEN
            6209                       !    WRITE(nerr,*) "Recursive goto 830 skin water layer setup."
            6210                       !  ELSEIF (iderr.EQ.10) THEN
            6211                       !    WRITE(nerr,*) "Recursive goto 840 ice layer setup."
            6212                       !  ELSEIF (iderr.EQ.11) THEN
            6213                       !    WRITE(nerr,*) "Water starts to freeze."
            6214                       !  ELSEIF (iderr.EQ.12) THEN
            6215                       !    WRITE(nerr,*) "Snow melts completely."
            6216                       !  ENDIF
            6217                       END SUBROUTINE lkerr
            6218                       ! ----------------------------------------------------------------------
            6219                       !!!SUBROUTINE OUTPUT(hesn,hew,heice,fcew,pfluxwm,wtm,wum,wvm,wsm,wtkem,tsim,mas,mae)
            6220                       SUBROUTINE output(err_message,hesn,hew,heice,pfluxwm,wtm,wsm,tsim)
            6221                       !
            6222                       !-----------------------------------------------------------------
            6223                       !
            6224                       !*    OUTPUT: WRITE DIAGNOSTIC VARIABLES
            6225                       !
            6226                       !-----------------------------------------------------------------
            6227                         !!! USE mo_mpi,           ONLY: mpp_pe()
            6228                         IMPLICIT NONE
            6229                         real, INTENT(in):: hesn,heice,hew,pfluxwm
            6230                         real, DIMENSION(0:3), INTENT(in):: tsim
            6231                         real, DIMENSION(0:lkvl+1), INTENT(in):: wtm,wsm
            6232                         CHARACTER(len = *) :: err_message
            6233                       !!!  real, INTENT(in):: hesn,heice,hew,fcew,pfluxwm
            6234                       !!!  real, DIMENSION(0:3), INTENT(in):: tsim
            6235                       !!!  real, DIMENSION(0:lkvl+1), INTENT(in):: wtm,wum,wvm,wsm,wtkem
            6236                       !!!  INTEGER, INTENT(in)  :: mas,mae
            6237                         INTEGER jk
            6238                         real:: tmp
            6239                     
            6240                       !!!  WRITE(nerr,*) "sit_vdiff: ","pe=",mpp_pe(),"jl=,",jl,"jrow=,",jrow,"istep=",istep,   &
            6241                       !!!     "lat=",plat(jl),"lon=",plon(jl), "SST overflow"
            6242                     !!!    CALL write_date(current_date,' sit_vdiff Current date: ')
            6243                       !  WRITE(nerr,*) "sit_vdiff Current date: ",current_date
            6244                         WRITE(nerr,*) "sit_vdiff: ","it=",istep,"pe=",mpp_pe(),"jl=",jl,"jrow=",jrow,                  &
            6245                             "sit_step=",i_sit_step,                                                                &
            6246                             "lat=",plat(jl),"lon=",plon(jl), err_message,                      &
            6247                             "fluxiw=",pfluxiw_int(jl),                                                              &
            6248                             "pfluxw=",pfluxw2,"pfluxwm=",pfluxwm,"pdfluxs=",pdfluxs(jl),"soflw=",psoflw(jl),       &
            6249                             "temp2=",ptemp2(jl),"tsw=",pwt(jl,0),"tsi=",ptsi(jl),                                  &
            6250                             "sn=",pzsi(jl,0),"ice=",pzsi(jl,1),"hew=",hew,"hesn=",hesn,                            &
            6251                             "rhoh2o=",rhoh2o,"rhosn=",rhosn,"xksn=",xksn,"omegas=",omegas,                         &
            6252                             "heice=",heice,                                                                        &
            6253                             "evapw=",pevapw(jl),"rsf=",prsf(jl),"ssf=",pssf(jl),                                   &
            6254                             "silw(0)=",psilw(jl,0),"silw(1)=",psilw(jl,1),                                         &
            6255                             "rainfall heat flux=",( prsf(jl) )*clw*(wtm(nls+1)-ptemp2(jl)),             &
            6256                             "snowfall heat flux=",( pssf(jl) )*( alf+csn*(tmelt-ptemp2(jl))+clw*(wtm(nls+1)-tmelt) ), &
            6257                             "snow heat flux=",pzsi(jl,0)*rhoh2o/zdtime*( alf+csn*(tmelt-tsim(1))+clw*(wtm(nls+1)-tmelt) ) &
            6258                               +psilw(jl,0)*rhoh2o/zdtime*clw*(wtm(nls+1)-tmelt),                                   &
            6259                             "ice flux=", pzsi(jl,1)*rhoh2o/zdtime*( alf+cice*(tmelt-tsim(3))+clw*(wtm(nls+1)-tmelt) )     &
            6260                               +psilw(jl,1)*rhoh2o/zdtime*clw*(wtm(nls+1)-tmelt)
            6261                     
            6262                         WRITE(nerr,*) "sitmask=",psitmask(jl).EQ.1.
            6263                         WRITE(nerr,*) "lclass=",plclass(jl)
            6264                         WRITE(nerr,*) "slm=",pslm(jl)
            6265                         WRITE(nerr,*) "seaice=",pseaice(jl)
            6266                         WRITE(nerr,*) "siced=",psiced(jl)
            6267                         WRITE(nerr,*) "lsoil=",lsoil
            6268                         WRITE(nerr,*) "temp2=",ptemp2(jl)
            6269                         WRITE(nerr,*) "tsi=",ptsi(jl)
            6270                         WRITE(nerr,*) "tsw=",ptsw(jl)
            6271                         WRITE(nerr,*) "obstsw=",pobswtb(jl)
            6272                         WRITE(nerr,*) "tmelt=",pctfreez2(jl)
            6273                         WRITE(nerr,*) "fluxw=",pfluxw(jl)
            6274                         WRITE(nerr,*) "fluxw2=",pfluxw2
            6275                         WRITE(nerr,*) "fluxi=",pfluxi(jl)
            6276                         WRITE(nerr,*) "fluxi=",pfluxi2
            6277                         WRITE(nerr,*) "dfluxs=",pdfluxs(jl)
            6278                         WRITE(nerr,*) "soflw=",psoflw(jl)
            6279                         WRITE(nerr,*) "wtfn(10)=",pwtfn(jl,10)
            6280                         WRITE(nerr,*) "wsfn(10)=",pwsfn(jl,10)
            6281                         WRITE(nerr,*) "wtfn0(10)=",pwtfn0(jl,10)
            6282                         WRITE(nerr,*) "wsfn0(10)=",pwsfn0(jl,10)
            6283                         WRITE(nerr,*) "runtoc=",pdisch(jl)
            6284                         WRITE(nerr,*) "wind10w=",pwind10w(jl)
            6285                         WRITE(nerr,*) "wlvl=",pwlvl(jl)
            6286                         WRITE(nerr,*) "evapw=",pevapw(jl)
            6287                         WRITE(nerr,*) "rsf=",prsf(jl)
            6288                         WRITE(nerr,*) "ssf=",pssf(jl)
            6289                         WRITE(nerr,*) "nls=",nls,"nle=",nle,                                                       &
            6290                             "tsim(:)=",tsim(:),                                                                    &
            6291                             "sittsi(:)=",ptsnic(jl,:),                                                             &
            6292                             "wtm(:)=",wtm(:),"sitwt(:)=",pwt(jl,:)
            6293                       !
            6294                         CALL output2
            6295                       !
            6296                         WRITE(nerr,*) "Data in previous time step"
            6297     1                   DO jk = 0, nle+1
            6298     1                     WRITE(nerr,2301) mpp_pe(),jl,jrow,plat(jl),plon(jl),istep,jk,z(jk),&
            6299     1                 &     wtm(jk),wum(jk),wvm(jk),wsm(jk),&
            6300     1                 &     wtkem(jk)
            6301     1                   END DO
            6302                       !
            6303                       !     calc. column mean temp
            6304     1                   IF (nle.GE.1)THEN
            6305     1                 !     water exists
            6306     1                     tmp=DOT_PRODUCT(pwt(jl,nls+1:nle),MAX(hw(nls+1:nle),0.))/SUM(MAX(hw(nls+1:nle),0.))
            6307     1                   ELSE
            6308     1                 !     soil only
            6309     1                     tmp=pwt(jl,0)
            6310     1                   ENDIF
            6311                         WRITE(nerr,*) "depth=",(z(0)-z(nle+1))
            6312                         WRITE(nerr,*) "mean column temp=",tmp
            6313                       !
            6314                       !ps 2301 FORMAT(1X,4(I3,","),1(I9,","),1(I3,","),1(F10.4,","),1(F8.3,","),2(F8.4,","),&
            6315                        2301 FORMAT(1X,3(I3,","),2(F8.2,","),2(I3,","),1(F10.0,","),1(F8.3,","),2(F8.4,","),&
            6316                       &       1(F8.3,","),2(E9.2,","),10(F8.3,","))
            6317                     
            6318                       !
            6319                         RETURN
            6320                       !
            6321                       !
            6322                       END SUBROUTINE output
            6323                       !
            6324                       ! ----------------------------------------------------------------------
            6325                       !
            6326                       SUBROUTINE penetrative_convection(jl)
            6327                       !
            6328                       !
            6329                       !-----------------------------------------------------------------
            6330                       ! Parameterize penetrative convection by mixing unstable surface
            6331                       ! layer regions directly with deep water layer where density starts
            6332                       ! increasing with depth.
            6333                       ! This is needed unless resolution is better than about 10 km; otherwise
            6334                       ! rotation does not allow proper and full convective adjustment. Should
            6335                       ! be applied stochastically, as the strong events leading to
            6336                       ! vigorous convection are short lived and infrequent.
            6337                       ! This is especially designed for 18 deg water formation in Sargasso Sea.
            6338                       !
            6339                       !-----------------------------------------------------------------
            6340                       ! Corresponding variables:
            6341                       !  TIMCOM: SIT
            6342                       !  KB(I,J): nle
            6343                       !  K=1: K=nls+1
            6344                       ! original code:
            6345                       !  u40bjt00@alps6:/work/j07tyh00/PRODUCTION_RUNS/GLOBAL_1DEG_Z61_NOCN_HNUDGa/global.F
            6346                       !  line 759-774
            6347                       !
            6348                         IMPLICIT NONE
            6349                       ! 0.0 Calling Variables
            6350                         INTEGER, INTENT(IN):: jl    ! lonitude and latitude index
            6351                       ! 0.1 Local Variables
            6352                         real:: eps               ! exchange ratio for each zdtime time_step
            6353                         real:: sdif,tdif
            6354                         INTEGER  :: jk
            6355                       !!!      hw(nls+1)=Z(3)-Z(1)    ! calculated somewhere else
            6356                       ! one-day by half exchange time scale may be too fast for NUMERICAL stability
            6357                       ! Set one-day to desired vertical exchange time scale (such as six_hour, one_hour, ...)
            6358                         eps=(1.-0.5**(zdtime/one_day))
            6359                       ! find unstable top layer points
            6360     1                   IF (pwrho(nls+1).GT.pwrho(nls+2)) THEN
            6361     1                     jk=nls+1
            6362     1                     jk=jk+1
            6363     1                 ! find first layer below top layer having density more than top layer
            6364     2                     DO WHILE (pwrho(nls+1).GT.pwrho(jk).AND.jk.LT.nle)
            6365     2                       jk=jk+1
            6366     2                     END DO
            6367     1                 ! Vertically exchange heat and salt.
            6368     1                 ! This will usually destabilize next layer down, but that is more easily
            6369     1                 ! convectively adjusted by model due to deep layers being thicker than
            6370     1                 ! those near surface.
            6371     1                     sdif=pws(jl,jk)-pws(jl,nls+1)
            6372     1                     pws(jl,nls+1)=pws(jl,nls+1)+eps*sdif
            6373     1                     pws(jl,jk)=pws(jl,jk)-eps*sdif*hw(nls+1)/hw(nls+jk)
            6374     1                     tdif=pwt(jl,jk)-pwt(jl,nls+1)
            6375     1                     pwt(jl,nls+1)=pwt(jl,nls+1)+eps*tdif
            6376     1                     pwt(jl,jk)=pwt(jl,jk)-eps*tdif*hw(nls+1)/hw(nls+jk)
            6377     1                   ENDIF
            6378                       END SUBROUTINE penetrative_convection
            6379                       ! ----------------------------------------------------------------------
            6380                     
            6381                       SUBROUTINE interpolation_godas(jl,jrow,l_no_expolation_wt,l_no_expolation_ws,l_no_expolation_wu,l_no_expolation_wv)
            6382                     !
            6383                     !     input
            6384                     !      real:: obstsw, ot12, os12, ou12, ov12
            6385                     !     output
            6386                     !      real:: obswt(0:lkvl+1),obsws(0:lkvl+1),obswu(0:lkvl+1),obswv(0:lkvl+1)
            6387                     
            6388                       !!! USE mo_interpo,       ONLY: nmw1, nmw2, wgt1, wgt2, ndw1, ndw2, wgtd1, wgtd2
            6389                     !!!  USE mo_control,       ONLY: lgodas
            6390                     !!!  USE sit_constants_mod,     ONLY: tmelt
            6391                     !!!  USE mo_physc2,        ONLY: ctfreez
            6392                       !!! USE mo_mpi,           ONLY: p_parallel_io, p_bcast, p_io, mpp_pe()
            6393                       USE mod_sst,           ONLY: nodepth, odepths, ot12, os12, ou12, ov12
            6394                       USE mod_eos_ocean,     ONLY: tmaxden
            6395                     !ps
            6396                       USE mod_sst,        ONLY:now1,now2,wgto1,wgto2,obswtbnmw1,obswtbnmw2,obswtbwgt1,obswtbwgt2
            6397                     !ps
            6398                     
            6399                       IMPLICIT NONE
            6400                       LOGICAL, INTENT(IN):: l_no_expolation_wt   ! logical for missing data
            6401                       LOGICAL, INTENT(IN):: l_no_expolation_ws   ! logical for missing data
            6402                       LOGICAL, INTENT(IN):: l_no_expolation_wu   ! logical for missing data
            6403                       LOGICAL, INTENT(IN):: l_no_expolation_wv   ! logical for missing data
            6404                         ! .TRUE. no expolation, missing value returned
            6405                         ! .FALSE. expolation enforced, non-missing value returned
            6406                       INTEGER, INTENT(IN):: jl,jrow    ! lonitude index
            6407                       LOGICAL  :: l_upperdata            ! =TRUE, if data of an upper level is available
            6408                       INTEGER  :: jk,kkk
            6409                       real:: ttt,ttt1,sss,sss1,uuu,uuu1,vvv,vvv1,depth
            6410                     !ps
            6411                     !  real:: ttt0,sss0
            6412                       real:: t10m,t10m1,pobswt10m,rr,rf_obs
            6413                       INTEGER:: k10m,kmixdepth
            6414                     !ps
            6415     1                 IF (GDCHK2) then
            6416     1                   WRITE(nerr,*) "I am in interpolation_godas2"
            6417     1                   WRITE(nerr,*) "lwarning_msg=",lwarning_msg
            6418     1                 ENDIF
            6419                       IF ((.NOT.lgodas).AND.(pobswtb(jl).EQ.xmissing)) RETURN
            6420                     !!!  CALL pzcord(jl,jrow)  ! bjt 2010/2/21
            6421                     !!
            6422                     !! Note that the vertical index of g3b starts from 1 although the index in the sit_vdiff
            6423                     !!   routine starts from 1,
            6424     1                 IF (GDCHK2) then
            6425     1                   WRITE(nerr,*) "I am in interpolation_godas2, line 6441"
            6426     1                   WRITE(nerr,*) "l_no_expolation_wt=",l_no_expolation_wt
            6427     1                   WRITE(nerr,*) "l_no_expolation_ws=",l_no_expolation_ws
            6428     1                   WRITE(nerr,*) "l_no_expolation_wu=",l_no_expolation_wu
            6429     1                   WRITE(nerr,*) "l_no_expolation_wv=",l_no_expolation_wv
            6430     1                   WRITE(nerr,*) "godas2: nmw1=",nmw1,",nmw2=",nmw2,",wgt1=",wgt1,",wgt2=",wgt2 &
            6431     1                                         ,",now1=",now1,",now2=",now2,",wgto1=",wgto1,",wgto2=",wgto2
            6432     1                   WRITE(nerr,2300) "pe,","jl,","row,","lat,","lon,","step,","k,","z,", "ot1,", "ot2", "os1,", "os2"
            6433     1                   WRITE(nerr,2300) "pe,","jl,","row,","lat,","lon,","step,","k,","z,", "obswt,", "obsws", "obswu", "obswv"
            6434     2                   DO jk = 0, nle+1
            6435     2                     WRITE(nerr,2301) mpp_pe(),jl,jrow,plat(jl),plon(jl),istep,jk,z(jk),pobswt(jl,jk),pobsws(jl,jk),pobswu(jl,jk),pobswv(jl,jk)
            6436     2                   END DO
            6437     1                 ENDIF
            6438                     
            6439                     !find mixing_depth
            6440     1                 IF ( lgodas .AND. lmixedlayer .AND.              &
            6441     1                    (mixedlayer12(jl,jrow,now1).NE.xmissing) .AND. &
            6442     1                    (mixedlayer12(jl,jrow,now2).NE.xmissing)) THEN
            6443     1                   mixedlayer(jl)=max(wgto1*mixedlayer12(jl,jrow,now1)+wgto2*mixedlayer12(jl,jrow,now2),nudge_depth_10)
            6444     1                 ENDIF
            6445                     !find mixing_depth abs(t-t10m)<= (0.8) degree  (A.B. Kara et al., 2000)
            6446     1                 IF (lgodas) then
            6447     1                   k10m=1
            6448     2                   DO WHILE ( (odepths(k10m).LE. 10.) .AND. (k10m.LT.nodepth) )
            6449     2                     k10m=k10m+1
            6450     2                   END DO
            6451     1                   IF (k10m.GT.1) k10m=k10m-1              ! restore back one layer
            6452     1                 ENDIF
            6453     1                 IF ( lgodas .AND. (.not.lmixedlayer) .AND.              &
            6454     1                      (ot12(jl,k10m,jrow,now1).NE.xmissing)      .AND. &
            6455     1                      (ot12(jl,k10m,jrow,now2).NE.xmissing)      .AND. &
            6456     1                      (ot12(jl,k10m+1,jrow,now1).NE.xmissing)    .AND. &
            6457     1                      (ot12(jl,k10m+1,jrow,now2).NE.xmissing)    .AND. &
            6458     1                      (10. .LE.odepths(nodepth)) ) THEN
            6459     1                   t10m=wgto1*ot12(jl,k10m,jrow,now1)+wgto2*ot12(jl,k10m,jrow,now2)
            6460     1                   t10m1=wgto1*ot12(jl,k10m+1,jrow,now1)+wgto2*ot12(jl,k10m+1,jrow,now2)
            6461     1                   pobswt10m=t10m+ &                                    ! pobswt at 10 m
            6462     1                         (10.-odepths(k10m))/(odepths(k10m+1)-odepths(k10m))* (t10m1-t10m)
            6463     1               
            6464     1                   kmixdepth=k10m+1
            6465     2                   DO WHILE ( (ot12(jl,kmixdepth,jrow,now1).NE.xmissing) .AND. &
            6466     2                              (ot12(jl,kmixdepth,jrow,now2).NE.xmissing) .AND. &
            6467     2                              (kmixdepth.LT.nodepth) )
            6468     2                     tmixdown=wgto1*ot12(jl,kmixdepth,jrow,now1)+wgto2*ot12(jl,kmixdepth,jrow,now2)
            6469     3                     IF (abs(tmixdown-pobswt10m).LE. 0.8) THEN
            6470     3                       kmixdepth=kmixdepth+1
            6471     3                     ELSE
            6472     3                       exit
            6473     3                     ENDIF
            6474     2                   END DO
            6475     1                   IF(kmixdepth.GT.1) kmixdepth=kmixdepth-1
            6476     1                     tmixup=wgto1*ot12(jl,kmixdepth,jrow,now1)+wgto2*ot12(jl,kmixdepth,jrow,now2)
            6477     1                     mixlayer=((pobswt10m-0.8)-tmixup)/(tmixdown-tmixup)*(odepths(kmixdepth+1)-odepths(kmixdepth))&
            6478     1                               +odepths(kmixdepth)
            6479     1                     mixedlayer(jl)=max(mixlayer,nudge_depth_10)
            6480     1                   IF(GDCHK3) print *,"1. kmixdepth=",kmixdepth,",mixedlayer=",mixedlayer(jl) &
            6481     1                                     ,",obswt10m=",pobswt10m
            6482     1                 ENDIF
            6483                     
            6484                     
            6485     1                 DO jk=0,nle+1
            6486     1                   depth=(pwlvl(jl)-z(jk))
            6487     2                   IF (lgodas) THEN
            6488     2                     !! initialized the water profile according to world ocean altas data (woa) data
            6489     2                     kkk=1
            6490     3                     DO WHILE ( (odepths(kkk).LE.depth) .AND. (kkk.LT.nodepth) )
            6491     3                        kkk=kkk+1
            6492     3                     END DO
            6493     2                     IF (kkk.GT.1) kkk=kkk-1              ! restore back one layer
            6494     2                   ENDIF
            6495     1               !
            6496     1               ! 1.0 water salinity
            6497     1               !
            6498     1                   l_upperdata=.FALSE.
            6499     1                   sss=pobswsb(jl)
            6500     1                   sss1=pobswsb(jl)
            6501     2                   IF ( lgodas .AND.                                    &
            6502     2                        (os12(jl,kkk,jrow,now1).NE.xmissing)      .AND. &
            6503     2                        (os12(jl,kkk,jrow,now2).NE.xmissing)      .AND. &
            6504     2                        (os12(jl,kkk+1,jrow,now1).NE.xmissing)    .AND. &
            6505     2                        (os12(jl,kkk+1,jrow,now2).NE.xmissing)    .AND. &
            6506     2                        (depth.LE.odepths(nodepth)) ) THEN
            6507     2                     ! depth < max. obs. depth
            6508     2                     ! linearly interpolation (no extrapolation)
            6509     2                     l_upperdata=.TRUE.
            6510     2               !      sss0=obswtbwgt1*os12(jl,1,jrow,obswtbnmw1)+obswtbwgt2*os12(jl,1,jrow,obswtbnmw2)
            6511     2                     sss=wgto1*os12(jl,kkk,jrow,now1)+wgto2*os12(jl,kkk,jrow,now2)
            6512     2                     sss1=wgto1*os12(jl,kkk+1,jrow,now1)+wgto2*os12(jl,kkk+1,jrow,now2)
            6513     2                     pobsws(jl,jk)=sss+ &
            6514     2                       (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (sss1-sss)
            6515     2                   ELSE
            6516     2                     ! depth > max obs. depth or missing observed data
            6517     2                     ! water salinity
            6518     3                     IF (l_no_expolation_ws) THEN
            6519     3                     ! no extrapolation
            6520     3                       pobsws(jl,jk)=xmissing
            6521     3                     ELSE
            6522     3                     ! assume to be sss1
            6523     3                       pobsws(jl,jk)=sss1
            6524     3               !!!      ! extrapolation
            6525     3               !!!        pobsws(jl,jk)=sss+ &
            6526     3               !!!           (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (sss1-sss)
            6527     3                     ENDIF
            6528     2                   ENDIF
            6529     1               !
            6530     1               ! 1.1 modify pobswsb/freezing temp again according to initial ocean T/S profile.
            6531     1               !     Note that pobswsb/freezing temp were firstly setup in ioinitial.f90
            6532     1               !
            6533     2                   IF (lsitstart.AND.jk.EQ.0) THEN
            6534     2                     pobswsb(jl)=MERGE(pobsws(jl,jk),pobswsb(jl),pobsws(jl,jk).NE.xmissing)
            6535     2               #if defined (V9897)
            6536     2                       pctfreez2(jl)=tmelt+3.
            6537     2               #elif defined (TMELTS0)
            6538     2                       pctfreez2(jl)=MERGE(tmelts(pobswsb(jl)),tmelt,pobswsb(jl).NE.xmissing)
            6539     2               #elif defined (TMELTS1)
            6540     2                       pctfreez2(jl)=MERGE(tmelts(pobswsb(jl))+1.,tmelt+1.,pobswsb(jl).NE.xmissing)
            6541     2               #elif defined (TMELTS15)
            6542     2                       pctfreez2(jl)=MERGE(tmelts(pobswsb(jl))+1.5_dp,tmelt+1.5_dp,pobswsb(jl).NE.xmissing)
            6543     2               #elif defined (TMELTS2)
            6544     2                       pctfreez2(jl)=MERGE(tmelts(pobswsb(jl))+2.,tmelt+2.,pobswsb(jl).NE.xmissing)  ! v9.9003, there is 7600 ice grids, while the observation is 760 ice grid.
            6545     2               #elif defined (TMELTS25)
            6546     2                       pctfreez2(jl)=MERGE(tmelts(pobswsb(jl))+2.,tmelt+2.,pobswsb(jl).NE.xmissing)  ! v9.9007.
            6547     2               #elif defined (TMELTS3)
            6548     2                       pctfreez2(jl)=MERGE(tmelts(pobswsb(jl))+3.,tmelt+3.,pobswsb(jl).NE.xmissing)  ! v9.898 (too hot and too salty in S.H.)
            6549     2               #else
            6550     2                       pctfreez2(jl)=MERGE(tmelts(pobswsb(jl)),tmelt,pobswsb(jl).NE.xmissing)
            6551     2               #endif
            6552     2                   ENDIF
            6553     1               !
            6554     1               ! 2.0 water temperature
            6555     1               !
            6556     1               !
            6557     1               !
            6558     1                   l_upperdata=.FALSE.
            6559     1                   ttt=pobswtb(jl)
            6560     1                   ttt1=pobswtb(jl)
            6561     2                   IF(GDCHK2) then
            6562     2                     print *,"lgodas=",lgodas,",ttt=",ttt,",kkk=",kkk          &
            6563     2                            ,",ot12(jl,kkk,jrow,now1)=",ot12(jl,kkk,jrow,now1) &
            6564     2                            ,",ot12(jl,kkk,jrow,now2)=",ot12(jl,kkk,jrow,now2) &
            6565     2                            ,",ot12(jl,kkk+1,jrow,now1)=",ot12(jl,kkk+1,jrow,now1) &
            6566     2                            ,",ot12(jl,kkk+1,jrow,now2)=",ot12(jl,kkk+1,jrow,now2) &
            6567     2                            ,",depth=",depth,",nodepth=",nodepth                   &
            6568     2                            ,",odepths(nodepth)=",odepths(nodepth)
            6569     2               
            6570     2                   ENDIF
            6571     2                   IF ( lgodas .AND.                                    &
            6572     2                        (ot12(jl,kkk,jrow,now1).NE.xmissing)      .AND. &
            6573     2                        (ot12(jl,kkk,jrow,now2).NE.xmissing)      .AND. &
            6574     2                        (ot12(jl,kkk+1,jrow,now1).NE.xmissing)    .AND. &
            6575     2                        (ot12(jl,kkk+1,jrow,now2).NE.xmissing)    .AND. &
            6576     2                        (depth.LE.odepths(nodepth)) ) THEN
            6577     2                     ! depth < max. obs. depth
            6578     2                     l_upperdata=.TRUE.
            6579     2               !      ttt0=obswtbwgt1*ot12(jl,1,jrow,obswtbnmw1)+obswtbwgt2*ot12(jl,1,jrow,obswtbnmw2)
            6580     2                     ttt=wgto1*ot12(jl,kkk,jrow,now1)+wgto2*ot12(jl,kkk,jrow,now2)
            6581     2                     ttt1=wgto1*ot12(jl,kkk+1,jrow,now1)+wgto2*ot12(jl,kkk+1,jrow,now2)
            6582     2               
            6583     3                     IF(mixedlayer(jl) .ge. nudge_depth_10 .AND. pobswtb(jl) .NE. xmissing   &
            6584     3                        .AND. pobswt10m .NE. xmissing)then
            6585     4                       IF(depth .LE. nudge_depth_10)THEN
            6586     4                         rf_obs=1.
            6587     4                       ELSEIF(depth .GT. mixedlayer(jl) .AND. depth .LT. nudge_depth_100) THEN
            6588     4                         rr=(depth-mixedlayer(jl))/(nudge_depth_100-mixedlayer(jl))
            6589     4                         rf_obs=1.-exp(-0.5/rr*exp(0.5/(rr-1.)))
            6590     4                       ELSE
            6591     4                         rf_obs=0.
            6592     4                       ENDIF
            6593     3               
            6594     4                       if(jk .le. 0)then
            6595     4                          pobswt(jl,jk)=MAX(pctfreez2(jl), ttt+ &
            6596     4                           (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (ttt1-ttt) )
            6597     5                         if(lsftobswt) then
            6598     5                           psftobswt(jl,0)=(pobswtb(jl)-pobswt(jl,0))
            6599     5                         endif
            6600     5                         if(GDCHK3)then
            6601     5                           print*,"int_godas: jk=",jk,",pobswtb=",pobswtb(jl),",pobswt_jk=",pobswt(jl,jk)
            6602     5                         endif
            6603     4                       endif
            6604     4                       if(lsftobswt) then
            6605     4                         psftobswt(jl,jk)=psftobswt(jl,0)
            6606     4                       endif
            6607     3               
            6608     4                       IF(depth .LE. mixedlayer(jl) ) THEN
            6609     4                         pobswt(jl,jk)=MAX(pctfreez2(jl), psftobswt(jl,jk)+ttt+ &
            6610     4                           (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (ttt1-ttt) )
            6611     4                       ELSEIF(depth .GT. mixedlayer(jl) .AND. depth .LT. nudge_depth_100) THEN
            6612     4                         rr=(depth-mixedlayer(jl))/(nudge_depth_100-mixedlayer(jl))
            6613     4                         rf_obs=1.-exp(-0.5/rr*exp(0.5/(rr-1.)))
            6614     4                         psftobswt(jl,jk)=rf_obs*psftobswt(jl,jk)
            6615     4                         pobswt(jl,jk)=MAX(pctfreez2(jl), psftobswt(jl,jk)+ttt+ &
            6616     4                           (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (ttt1-ttt) )
            6617     4                       ELSE
            6618     4                         psftobswt(jl,jk)=0.
            6619     4                         pobswt(jl,jk)=MAX(pctfreez2(jl), ttt+ &
            6620     4                           (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (ttt1-ttt) )
            6621     4                       ENDIF
            6622     3                     ELSE
            6623     4                       IF ( depth.LE. nudge_depth_10 ) THEN
            6624     4                     ! depth < 10 m, note daily SST is avaiable from satellite
            6625     5                         IF (pobswtb(jl).NE.xmissing) THEN
            6626     5                           pobswt(jl,jk)=MAX(pctfreez2(jl),pobswtb(jl))
            6627     5                         ELSE
            6628     5                          pobswt(jl,jk)=xmissing
            6629     5                        ENDIF
            6630     4                       ELSE
            6631     4                     ! depth < max. obs. depth
            6632     4                     ! linearly interpolation (no extrapolation)
            6633     4                       pobswt(jl,jk)=MAX(pctfreez2(jl), ttt+ &
            6634     4                         (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (ttt1-ttt) )
            6635     4               !ps        pobswt(jl,jk)=MAX(pctfreez2(jl), ttt &
            6636     4               !ps            +(depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (ttt1-ttt) &
            6637     4               !ps            +rf_obs*(pobswtb(jl)-ttt0) )
            6638     4               
            6639     4               !          IF (GDCHK3) then
            6640     4               !            print *,'now1=',now1,',now2=',now2,'wgto1=',wgto1,',wgto2=',wgto2
            6641     4               !            print *,'kkk=',kkk,',ttt0=',ttt0,',ttt=',ttt,',ttt1=',ttt1
            6642     4               !            print *,'pobsws(',jl,',',jk,')=',pobsws(jl,jk)
            6643     4               !            print *,'pobswt(',jl,',',jk,')=',pobswt(jl,jk)
            6644     4               !            print *,'pobswtb(',jl,')=',pobswtb(jl)
            6645     4               !            print *,'obswtbwgt1=',obswtbwgt1,'obswtbwgt2=',obswtbwgt2
            6646     4               !            print *,'obswtbnmw1=',obswtbnmw1,'obswtbnmw2=',obswtbnmw2
            6647     4               !          ENDIF
            6648     4                       ENDIF
            6649     3                     ENDIF
            6650     3                     IF (GDCHK2) then
            6651     3                       WRITE(nerr,*) "godas2.1, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6652     3                     ENDIF
            6653     2                   ELSE
            6654     2                     ! depth > max obs. depth or on observation
            6655     2                     ! water temperature
            6656     3                     IF (l_no_expolation_wt) THEN
            6657     3                     ! no extrapolation
            6658     3                       pobswt(jl,jk)=xmissing
            6659     4                       IF (GDCHK2) then
            6660     4                         WRITE(nerr,*) "godas2.2, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6661     4                       ENDIF
            6662     3                     ELSE
            6663     3                     ! extrapolation
            6664     4                       IF (l_upperdata) THEN
            6665     4                         pobswt(jl,jk)=MAX(pctfreez2(jl),ttt+ &
            6666     4                            (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (ttt1-ttt) )
            6667     5                         IF (GDCHK2) then
            6668     5                           WRITE(nerr,*) "godas2.3, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6669     5                         ENDIF
            6670     5                         IF ((tmaxden(pobswsb(jl)).GT.ttt1).AND.(tmaxden(pobswsb(jl)).GT.ttt)) THEN
            6671     5                           pobswt(jl,jk)=MIN(tmaxden(pobsws(jl,jk)),pobswt(jl,jk))
            6672     6                           IF (GDCHK2) then
            6673     6                             WRITE(nerr,*) "godas2.4, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6674     6                           ENDIF
            6675     5                         ELSEIF ((tmaxden(pobswsb(jl)).LT.ttt1).AND.(tmaxden(pobswsb(jl)).LT.ttt)) THEN
            6676     5                           pobswt(jl,jk)=MAX(tmaxden(pobsws(jl,jk)),pobswt(jl,jk))
            6677     6                           IF (GDCHK2) then
            6678     6                             WRITE(nerr,*) "godas2.5, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6679     6                           ENDIF
            6680     5                         ELSE
            6681     5                           pobswt(jl,jk)=tmaxden(pobsws(jl,jk))
            6682     6                           IF (GDCHK2) then
            6683     6                             WRITE(nerr,*) "godas2.6, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6684     6                           ENDIF
            6685     5                         ENDIF
            6686     4                       ELSE
            6687     4                         ! set initial profile to be expontential decay to tmaxden
            6688     4    i                    pobswt(jl,jk)=wt_maxden(depth,pobswtb(jl),pobswsb(jl),mixing_depth)
            6689     5                         IF (GDCHK2) then
            6690     5                           WRITE(nerr,*) "godas2.7, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6691     5                         ENDIF
            6692     4                       ENDIF
            6693     3                       ! range check
            6694     3                       pobswt(jl,jk)=MAX(pctfreez2(jl),pobswt(jl,jk))
            6695     4                       IF (GDCHK2) then
            6696     4                         WRITE(nerr,*) "godas2.8, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6697     4                       ENDIF
            6698     3                     ENDIF
            6699     2                   ENDIF
            6700     1               !=================================================
            6701     1               !
            6702     1               ! 3.0 water u current
            6703     1               !
            6704     1                   l_upperdata=.FALSE.
            6705     1                   uuu=0.
            6706     1                   uuu1=0.
            6707     2                   IF ( lgodas .AND.                                    &
            6708     2                        (ou12(jl,kkk,jrow,now1).NE.xmissing)      .AND. &
            6709     2                        (ou12(jl,kkk,jrow,now2).NE.xmissing)      .AND. &
            6710     2                        (ou12(jl,kkk+1,jrow,now1).NE.xmissing)    .AND. &
            6711     2                        (ou12(jl,kkk+1,jrow,now2).NE.xmissing)    .AND. &
            6712     2                        (depth.LE.odepths(nodepth)) ) THEN
            6713     2                     ! depth < max. obs. depth
            6714     2                     l_upperdata=.TRUE.
            6715     2                     uuu=wgto1*ou12(jl,kkk,jrow,now1)+wgto2*ou12(jl,kkk,jrow,now2)
            6716     2                     uuu1=wgto1*ou12(jl,kkk+1,jrow,now1)+wgto2*ou12(jl,kkk+1,jrow,now2)
            6717     2                     ! linearly interpolation (no extrapolation)
            6718     2                     pobswu(jl,jk)=uuu+ &
            6719     2                       (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (uuu1-uuu)
            6720     2                   ELSE
            6721     3                     IF (l_no_expolation_wu) THEN
            6722     3                       ! no extrapolation
            6723     3                       pobswu(jl,jk)=xmissing
            6724     3                     ELSE
            6725     3                       pobswu(jl,jk)=0.
            6726     3               !!!     ! extrapolation
            6727     3               !!!       pobswu(jl,jk)=uuu+ &
            6728     3               !!!          (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (uuu1-uuu)
            6729     3                     ENDIF
            6730     2                   ENDIF
            6731     1               !
            6732     1               ! 4.0 water v current
            6733     1               !
            6734     1                   l_upperdata=.FALSE.
            6735     1                   vvv=0.
            6736     1                   vvv1=0.
            6737     2                   IF ( lgodas .AND.                                    &
            6738     2                        (ov12(jl,kkk,jrow,now1).NE.xmissing)      .AND. &
            6739     2                        (ov12(jl,kkk,jrow,now2).NE.xmissing)      .AND. &
            6740     2                        (ov12(jl,kkk+1,jrow,now1).NE.xmissing)    .AND. &
            6741     2                        (ov12(jl,kkk+1,jrow,now2).NE.xmissing)    .AND. &
            6742     2                        (depth.LE.odepths(nodepth)) ) THEN
            6743     2                     ! depth < max. obs. depth
            6744     2                     l_upperdata=.TRUE.
            6745     2                     vvv=wgto1*ov12(jl,kkk,jrow,now1)+wgto2*ov12(jl,kkk,jrow,now2)
            6746     2                     vvv1=wgto1*ov12(jl,kkk+1,jrow,now1)+wgto2*ov12(jl,kkk+1,jrow,now2)
            6747     2                     ! linearly interpolation (no extrapolation)
            6748     2                     pobswv(jl,jk)=vvv+ &
            6749     2                       (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (vvv1-vvv)
            6750     2                   ELSE
            6751     3                     IF (l_no_expolation_wu) THEN
            6752     3                       ! no extrapolation
            6753     3                       pobswv(jl,jk)=xmissing
            6754     3                     ELSE
            6755     3                       pobswv(jl,jk)=0.
            6756     3               !!!     ! extrapolation
            6757     3               !!!       pobswv(jl,jk)=vvv+ &
            6758     3               !!!          (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (vvv1-vvv)
            6759     3                     ENDIF
            6760     2                   ENDIF
            6761     1                 ENDDO
            6762                     !
            6763                     ! 5.0 Adjust pwt for accounting the ice grid for depth <= 10 m and the limit of pctfreez2
            6764                     !
            6765                     !  IF (.NOT.lsoil) pobswt(jl,0:nle+1)=MERGE(MAX(pctfreez2(jl),pobswt(jl,0:nle+1)),xmissing,pobswt(jl,0:nle+1).NE.xmissing)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<< Loop-information  End >>>
            6766     1  pp   2s        DO jk=0,nle+1
            6767     2   p   2m          IF (pobsseaice(jl).GT.0.) THEN
            6768     2   p   2s            depth=(pwlvl(jl)-z(jk))
            6769     2   p   2s            IF ((depth.LE.10.).AND.(pobswt(jl,jk).NE.xmissing)) pobswt(jl,jk)=pctfreez2(jl)
            6770     2   p   2v          ENDIF
            6771     1   p   2v        END DO
            6772                     
            6773     1                 IF (GDCHK2) then
            6774     1                   WRITE(nerr,*) "tmaxden=",tmaxden(pobswsb(jl))
            6775     1                   WRITE(nerr,2300) "pe,","jl,","row,","lat,","lon,","step,","k,","z,", "obswt,", "obsws", "obswu", "obswv"
            6776     2                   DO jk = 0, nle+1
            6777     2                     WRITE(nerr,2301) mpp_pe(),jl,jrow,plat(jl),plon(jl),istep,jk,z(jk),pobswt(jl,jk),pobsws(jl,jk),pobswu(jl,jk),pobswv(jl,jk)
            6778     2                   END DO
            6779     1                   WRITE(nerr,*) "I am leaving interpolation_godas"
            6780     1                 ENDIF
            6781                      2300 FORMAT(1X,3A4,2A9,2A4,1A11,4A9,2A10,10A9)
            6782                      2301 FORMAT(1X,3(I3,","),2(F8.2,","),2(I3,","),1(F10.0,","),10(F8.3,","),2(E10.2,","),&
            6783                     &       1(F8.3,","),2(E9.2,","),10(F8.3,","))
            6784                       END SUBROUTINE interpolation_godas
            6785                     ! **********************************************************************
            6786                       SUBROUTINE interpolation_ocaf(jl,jrow,l_no_expolation_wt,l_no_expolation_ws)
            6787                     !
            6788                     !     input
            6789                     !      real:: wtfn12, wsfn12
            6790                     !     output
            6791                     !      real:: awtfl(0:lkvl+1),awsfl(0:lkvl+1)
            6792                     
            6793                       USE mod_sst,       ONLY: nmw1, nmw2, wgt1, wgt2
            6794                       USE mod_sit_control,       ONLY: locaf
            6795                     !!!  USE mo_mpi,           ONLY: p_parallel_io, p_bcast, p_io, p_pe
            6796                       USE mod_sst,           ONLY: nwdepth, wdepths, wtfn12, wsfn12
            6797                     
            6798                     
            6799                       IMPLICIT NONE
            6800                       LOGICAL, INTENT(IN):: l_no_expolation_wt   ! logical for missing data
            6801                       LOGICAL, INTENT(IN):: l_no_expolation_ws   ! logical for missing data
            6802                         ! .TRUE. no expolation, missing value returned
            6803                         ! .FALSE. expolation enforced, non-missing value returned
            6804                       INTEGER, INTENT(IN):: jl,jrow    ! lonitude index
            6805                       INTEGER  :: jk,kkk
            6806                       real:: ttt,ttt1,sss,sss1,depth
            6807                     
            6808     1                 IF(lwarning_msg.GE.4) then
            6809     1                   WRITE(nerr,*) ", I am in interpolation_ocaf"
            6810     1                 ENDIF
            6811                       IF (.NOT.locaf) RETURN
            6812                     !!!  CALL pzcord(jl,jrow)  ! bjt 2010/2/21
            6813                     !!
            6814                     !! Note that the vertical index of g3b starts from 1 although the index in the sit_vdiff
            6815                     !!   routine starts from 1,
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
            6816     1  pp             DO jk=0,nle+1
            6817     1   p               depth=(pwlvl(jl)-z(jk))
            6818     1                   !! initialized the water profile according to world ocean altas data (woa) data
            6819     1   p               kkk=1
            6820     2   p               DO WHILE ( (wdepths(kkk).LE.depth) .AND. (kkk.LT.nwdepth) )
            6821     2   p                  kkk=kkk+1
            6822     2   p               END DO
            6823     1   p               IF (kkk.GT.1) kkk=kkk-1  ! restore back one layer
            6824     2   p               IF (  &
            6825     2                        (wtfn12(jl,kkk,jrow,nmw1).NE.xmissing) .AND. &
            6826     2                        (wtfn12(jl,kkk,jrow,nmw2).NE.xmissing) .AND. &
            6827     2                        (wtfn12(jl,kkk+1,jrow,nmw1).NE.xmissing) .AND. &
            6828     2                        (wtfn12(jl,kkk+1,jrow,nmw2).NE.xmissing) .AND. &
            6829     2                        (wsfn12(jl,kkk,jrow,nmw1).NE.xmissing) .AND. &
            6830     2                        (wsfn12(jl,kkk,jrow,nmw2).NE.xmissing) .AND. &
            6831     2                        (wsfn12(jl,kkk+1,jrow,nmw1).NE.xmissing) .AND. &
            6832     2                        (wsfn12(jl,kkk+1,jrow,nmw2).NE.xmissing) ) THEN
            6833     2   p                 ttt=wgt1*wtfn12(jl,kkk,jrow,nmw1)+wgt2*wtfn12(jl,kkk,jrow,nmw2)
            6834     2   p                 ttt1=wgt1*wtfn12(jl,kkk+1,jrow,nmw1)+wgt2*wtfn12(jl,kkk+1,jrow,nmw2)
            6835     2   p                 sss=wgt1*wsfn12(jl,kkk,jrow,nmw1)+wgt2*wsfn12(jl,kkk,jrow,nmw2)
            6836     2   p                 sss1=wgt1*wsfn12(jl,kkk+1,jrow,nmw1)+wgt2*wsfn12(jl,kkk+1,jrow,nmw2)
            6837     3   p                 IF ( (depth.LE.wdepths(nwdepth)) ) THEN
            6838     3                     ! depth < max. obs. depth
            6839     3                     ! linearly interpolation (no extrapolation)
            6840     3   p                   pawtfl(jl,jk)=ttt+ &
            6841     3                         (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))* (ttt1-ttt)
            6842     3   p                   pawsfl(jl,jk)=sss+ &
            6843     3                         (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))* (sss1-sss)
            6844     3   p                 ELSE
            6845     3                     ! depth > max obs. depth
            6846     3                     ! water temperature flux
            6847     4   p                   IF (l_no_expolation_wt) THEN
            6848     4                       ! no extrapolation
            6849     4   p                     pawtfl(jl,jk)=0.
            6850     4   p                   ELSE
            6851     4                       ! extrapolation
            6852     4   p                     pawtfl(jl,jk)=ttt+ &
            6853     4                            (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))* (ttt1-ttt)
            6854     4   p                   ENDIF
            6855     3                     ! water salinity flux
            6856     4   p                   IF (l_no_expolation_ws) THEN
            6857     4                       ! no extrapolation
            6858     4   p                     pawsfl(jl,jk)=0.
            6859     4   p                   ELSE
            6860     4                       ! extrapolation
            6861     4   p                     pawsfl(jl,jk)=sss+ &
            6862     4                            (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))* (sss1-sss)
            6863     4   p                   ENDIF
            6864     3   p                 ENDIF
            6865     2   p               ELSE
            6866     3   p                 IF (l_no_expolation_wt) THEN
            6867     3                       ! no extrapolation
            6868     3   p                   pawtfl(jl,jk)=0.
            6869     3   p                 ELSE
            6870     3   p                   pawtfl(jl,jk)=0.
            6871     3   p                 ENDIF
            6872     3   p                 IF (l_no_expolation_ws) THEN
            6873     3                       ! no extrapolation
            6874     3   p                   pawsfl(jl,jk)=0.
            6875     3   p                 ELSE
            6876     3   p                   pawsfl(jl,jk)=0.
            6877     3   p                 ENDIF
            6878     2   p               ENDIF
            6879     1   p             ENDDO
            6880     1                 IF (GDCHK2) then
            6881     2                   DO jk=1,nle
            6882     2                     WRITE(nerr,*) 'pe=',mpp_pe(),',jl=',jl,',z=',z(jk),',pawtfl=',pawtfl(jl,jk),',pawsfl=',pawsfl(jl,jk)
            6883     2                   ENDDO
            6884     1                   WRITE(nerr,*) "I am leaving interpolation_ocaf"
            6885     1                 ENDIF
            6886                       END SUBROUTINE interpolation_ocaf
            6887                     
            6888                     ! **********************************************************************
            6889                       SUBROUTINE interpolation_ocaf0(jl,jrow,l_no_expolation_wt,l_no_expolation_ws)
            6890                     !
            6891                     !     input
            6892                     !      real:: wtfn12, wsfn12
            6893                     !     output
            6894                     !      real:: awtfl0(0:lkvl+1),awsfl(0:lkvl+1)
            6895                     
            6896                       USE mod_sst,       ONLY: nmw1, nmw2, wgt1, wgt2
            6897                       USE mod_sit_control,       ONLY: locaf0
            6898                     !!!  USE mo_mpi,           ONLY: p_parallel_io, p_bcast, p_io, p_pe
            6899                       USE mod_sst,           ONLY: nwdepth, wdepths, wtfn1st, mask1st
            6900                     
            6901                     
            6902                       IMPLICIT NONE
            6903                       LOGICAL, INTENT(IN):: l_no_expolation_wt   ! logical for missing data
            6904                       LOGICAL, INTENT(IN):: l_no_expolation_ws   ! logical for missing data
            6905                         ! .TRUE. no expolation, missing value returned
            6906                         ! .FALSE. expolation enforced, non-missing value returned
            6907                       INTEGER, INTENT(IN):: jl,jrow    ! lonitude index
            6908                       INTEGER  :: jk,kkk
            6909                       real:: ttt,ttt1,sss,sss1,depth
            6910                     
            6911     1                 IF(lwarning_msg.GE.4) then
            6912     1                   WRITE(nerr,*) ", I am in interpolation_ocaf"
            6913     1                 ENDIF
            6914                       IF (.NOT.locaf0) RETURN
            6915                     !!   routine starts from 1,
            6916                     !ps  DO jk=0,nle+1
            6917                     !ps    depth=(pwlvl(jl)-z(jk))
            6918                     !ps    !! initialized the water profile according to world ocean altas data (woa)
            6919                     !ps    !data
            6920                     !ps    kkk=1
            6921                     !ps    DO WHILE ( (wdepths(kkk).LE.depth) .AND. (kkk.LT.nwdepth) )
            6922                     !ps       kkk=kkk+1
            6923                     !ps    END DO
            6924                     !ps    IF (kkk.GT.1) kkk=kkk-1  ! restore back one layer
            6925                     !ps    IF (  &
            6926                     !ps         (wtfn0(jl,kkk,jrow).NE.xmissing) .AND. &
            6927                     !ps         (wtfn0(jl,kkk+1,jrow).NE.xmissing) .AND. &
            6928                     !ps         (wsfn0(jl,kkk,jrow).NE.xmissing) .AND. &
            6929                     !ps         (wsfn0(jl,kkk+1,jrow).NE.xmissing) ) THEN
            6930                     !ps      ttt=wtfn0(jl,kkk,jrow)
            6931                     !ps      ttt1=wtfn0(jl,kkk+1,jrow)
            6932                     !ps      sss=wsfn0(jl,kkk,jrow)
            6933                     !ps      sss1=wsfn0(jl,kkk+1,jrow)
            6934                     !ps      IF ( (depth.LE.wdepths(nwdepth)) ) THEN
            6935                     !ps      ! depth < max. obs. depth
            6936                     !ps      ! linearly interpolation (no extrapolation)
            6937                     !ps        pawtfl0(jl,jk)=ttt+ &
            6938                     !ps          (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))* (ttt1-ttt)
            6939                     !ps        pawsfl0(jl,jk)=sss+ &
            6940                     !ps          (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))* (sss1-sss)
            6941                     !ps      ELSE
            6942                     !ps      ! depth > max obs. depth
            6943                     !ps      ! water temperature flux
            6944                     !ps        IF (l_no_expolation_wt) THEN
            6945                     !ps        ! no extrapolation
            6946                     !ps          pawtfl0(jl,jk)=0.
            6947                     !ps        ELSE
            6948                     !ps        ! extrapolation
            6949                     !ps          pawtfl0(jl,jk)=ttt+ &
            6950                     !ps             (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))*(ttt1-ttt)
            6951                     !ps        ENDIF
            6952                     !ps      ! water salinity flux
            6953                     !ps        IF (l_no_expolation_ws) THEN
            6954                     !ps        ! no extrapolation
            6955                     !ps          pawsfl0(jl,jk)=0.
            6956                     !ps        ELSE
            6957                     !ps        ! extrapolation
            6958                     !ps          pawsfl0(jl,jk)=sss+ &
            6959                     !ps             (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))* (sss1-sss)
            6960                     !ps        ENDIF
            6961                     !ps      ENDIF
            6962                     !ps    ELSE
            6963                     !ps      IF (l_no_expolation_wt) THEN
            6964                     !ps        ! no extrapolation
            6965                     !ps        pawtfl0(jl,jk)=0.
            6966                     !ps      ELSE
            6967                     !ps        pawtfl0(jl,jk)=0.
            6968                     !ps      ENDIF
            6969                     !ps      IF (l_no_expolation_ws) THEN
            6970                     !ps        ! no extrapolation
            6971                     !ps        pawsfl0(jl,jk)=0.
            6972                     !ps      ELSE
            6973                     !ps        pawsfl0(jl,jk)=0.
            6974                     !ps      ENDIF
            6975                     !ps    ENDIF
            6976                     !ps  ENDDO
            6977                       pawtfl0(jl,0)=wtfn1st(jl,1,jrow)
            6978     1                 IF (GDCHK3) then
            6979     2   s               DO jk=0,0
            6980     2   m                 WRITE(nerr,*)'pe=',mpp_pe(),',jl=',jl,',z=',z(jk),',pawtfl0=',pawtfl0(jl,jk),',pawsfl0=',pawsfl0(jl,jk)
            6981     2   p               ENDDO
            6982     1                   WRITE(nerr,*) "I am leaving interpolation_ocaf0"
            6983     1                 ENDIF
            6984                     
            6985                       END SUBROUTINE interpolation_ocaf0
            6986                     
            6987                     

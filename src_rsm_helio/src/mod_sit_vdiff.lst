            7025     1                   ELSE
            7026     1                     ! no pobswtb data
            7027     2                     IF (.NOT.ldeep_water_nudg) THEN
            7028     2                     ! no nudging
            7029     2                       restore_temp=0.
            7030     2                     ELSE
            7031     2                     ! assuming restore_temp to that of previous level

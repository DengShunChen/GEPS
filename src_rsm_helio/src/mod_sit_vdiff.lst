             465                     !     2.1 OCEAN PARAMETERS
             466                     !
             467                       real,PARAMETER:: rhowcw = rhoh2o*clw
             468                       INTEGER :: wtype = 0
             469                     ! wtype: water type of the ocean
             470                     ! wtype = 0, PAULSON AND SIMPSON (1981),  Fairall et al., (1996)
             471                     !
             472                      ! WTYPE = 22, two-components, JERLOV'S (1976)
             473                       ! WTYPE = 0, PAULSON AND SIMPSON (1981),  Fairall et al., (1996)
             474                       ! WTYPE = 10, SOLOVIEV AND SCHLUESSEL (1996,type I)
             475                       ! WTYPE = 11, SOLOVIEV AND SCHLUESSEL (1996,type IA)
             476                       ! WTYPE = 12, SOLOVIEV AND SCHLUESSEL (1996,type IB)
             477                       ! WTYPE = 20, SOLOVIEV AND SCHLUESSEL (1996,type II)
             478                       ! WTYPE = 30, SOLOVIEV AND SCHLUESSEL (1996,type III)
             479                       ! WTYPE = 1, SOLOVIEV AND SCHLUESSEL (1996,type 1)
             480                       ! WTYPE = 3, SOLOVIEV AND SCHLUESSEL (1996,type 3)
             481                       ! WTYPE = 5, SOLOVIEV AND SCHLUESSEL (1996,type 5)
             482                       ! WTYPE = 7, SOLOVIEV AND SCHLUESSEL (1996,type 7)
             483                       ! WTYPE = 9, SOLOVIEV AND SCHLUESSEL (1996,type 9)
             484                     
             485                       real:: mixing_depth=100.          ! mixing depth of ocean, set at 100 m, should be changed as a function of time and location
             486                     !**************************************************
             487                     !    2) SOIL PARAMETERS
             488                     !
             489                       real,PARAMETER::xkg = 0.4835E-6
             490                     !     heat capacity of soil
             491                     !       =(0.5675E-6-0.175E-6*porosity)*soil type factor (de Vries, 1975)
             492                     !       =0.4835E-6 ,
             493                     !     sandy clay loam at water content , porosity(48%), factor =1
             494                     !     CGSOIL=248672.
             495                       real,PARAMETER::rhogcg=1.04E6+0.48*4.19E6
             496                     !     area heat capacity of the above soil (Tsuang and Wang, 1994)
             497                     !       =rhog*cg*Sqrt(Kg/omega)
             498                     !       =(1.04E6+0.48*4.19E6)*0.0815
             499                     !     ALBG = 0.3
             500                     !     ALBG: ALBEDO OF UNDERNEATH SOIL
             501                     !
             502                       real,PARAMETER::hspg=0.         ! HOT SPRING FROM THE BOTTOM (W/M2)                                I
             503                     !
             504                     !!!  real, PARAMETER:: nudge_depth_10=0.   ! (v8.3 - v9.1)
             505                       real, PARAMETER:: nudge_depth_10=10.     ! (- v8.3 and v9.2 -)
             506                       real, PARAMETER:: nudge_depth_100=100.

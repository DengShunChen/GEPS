            4371                     !
            4372                     !-----------------------------------------------------------------
            4373                      1000 CONTINUE
            4374                     !      PRINT *, ", I am in 10). PAHSE Change Energy ."
            4375                     !
            4376                     !*    10.1 Calc Net Freezing Rate of Water
            4377                     !
            4378     1                     IF (lwf)THEN
            4379     1               !     water freeze/ice melt in the water-ice interface
            4380     1                       lwf=.FALSE.
            4381     1               !
            4382     2                       IF (fcew.LT.0.) THEN
            4383     2               !       freeze
            4384     2               !-----------------------------------------------------------------------
            4385     2                         fcewf=fcew
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]

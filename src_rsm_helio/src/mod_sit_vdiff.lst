            7162     1               
            7163     2                     IF ((pobswu(jl,jk).NE.xmissing).AND.(suv_restore_time_all.GT.0.)) THEN
            7164     2                        restore_u2=(pobswu(jl,jk)-pwu(jl,jk))*(1.-0.5**(zdtime/suv_restore_time_all))
            7165     3                        IF(ltimeblending .AND. timebl_option .EQ. 1) THEN

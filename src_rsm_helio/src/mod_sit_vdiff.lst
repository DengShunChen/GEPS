             332                     
             333                       real :: tlucua(jptlucu1:jptlucu2)        ! table - e_s*Rd/Rv
             334                       real :: tlucub(jptlucu1:jptlucu2)        ! table - for derivative calculation
             335                       real :: tlucuc(jptlucu1:jptlucu2)        ! table - l/cp

            7108     4                             ( (plon(jl) .GE. sitbox_nudg_e(isit_nudg)-1.) .AND. &
            7109     4                               (plon(jl) .LT. sitbox_nudg_e(isit_nudg)) ) ) THEN
            7110     4   p    m                  lrestore_mix=.true.
            7111     4   p                     ENDIF
            7112     4   p    m                IF( ( (plat(jl) .GE. sitbox_nudg_s(isit_nudg)) .AND. &
            7113     4                                   (plat(jl) .LT. sitbox_nudg_s(isit_nudg)+1.) ) .OR. &

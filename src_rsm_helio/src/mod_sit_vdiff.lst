             459                       real,PARAMETER:: xkm_mixing=1.0E-1    ! default ini km within mixing depth (1E-3 m2/s=still some spikes)
             460                       real,PARAMETER:: xkh_mixing=1.0E-1    ! default ini kh within mixing depth  (1E-3 m2/s=still some spikes)

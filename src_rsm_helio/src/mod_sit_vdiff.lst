            8020                     SUBROUTINE update_snow_ice_property(swe,iwe,hsn,hesn,hice,heice,seaice)
            8021                       IMPLICIT NONE
            8022                       real, INTENT(IN):: swe    ! snow water equivalent of the grid (m)
            8023                       real, INTENT(IN):: iwe    ! iwe water equivalent of the grid (m)
            8024                       real, INTENT(OUT):: hsn,    & ! physical snow thickness of the grid (m)
            8025                                               hesn,   & ! effictive snow thickness of the grid (m)
            8026                                               hice,   & ! physical ice thickness of the grid (m)
            8027                                               heice,  & ! effective ice thickness of the grid (m)
            8028                                               seaice    ! sea ice fraction of the grid [0-1]
            8029          i            hsn=HSNFN(swe)
            8030          i            hesn=HEFN(hsn/4.,xksn,omegas)
            8031          i            hice=HICEFN(iwe)
            8032          i            heice=HEFN(hice/4.,xkice,omegas)
            8033                       seaice=SEAICEFN(iwe)
            8034                     END SUBROUTINE update_snow_ice_property
            8035                     
            8036                     ! ----------------------------------------------------------------------
            8037                     real FUNCTION HASTRFN(hstr)
            8038                     !*********************
            8039                     ! CALCUL Effective thickness
            8040                     ! h0: physical thickness of the skin layer (m)
            8041                     ! kh: heat diffusivity (m2/s)
            8042                     ! omegas: Earth's angular velocity respect to Sun (2*pi/86400 s-1)
            8043                     ! HEFN: effective thickness of the skin layer (m)
            8044                     !*********************
            8045                       IMPLICIT NONE
            8046                       real:: hstr
            8047                       hastrfn=SQRT( 1.-2.*COS(hstr)*EXP(-hstr)+EXP(-hstr)**2. )/SQRT(2.)
            8048                     END FUNCTION HASTRFN
            8049                     ! ----------------------------------------------------------------------
            8050                     real FUNCTION HEFN(h0,kh,omegas)
            8051                     !*********************
            8052                     ! CALCUL Effective thickness
            8053                     ! h0: physical thickness of the skin layer (m)
            8054                     ! kh: heat diffusivity (m2/s)
            8055                     ! omegas: Earth's angular velocity respect to Sun (2*pi/86400 s-1)
            8056                     ! HEFN: effective thickness of the skin layer (m)
            8057                     !*********************
            8058                       IMPLICIT NONE
            8059                       real:: kh,omegas,h0
            8060                       real:: h_ref,hstr,hastr
            8061                       h_ref=SQRT(2.*kh/omegas)
            8062                       hstr=h0/h_ref
            8063          i            hastr=HASTRFN(hstr)
            8064                       HEFN=h_ref*hastr
            8065                     END FUNCTION HEFN
            8066                     ! ----------------------------------------------------------------------
            8067                     real FUNCTION TASTRFN(hstr)
            8068                     !*********************
            8069                     ! CALCUL Effective thickness
            8070                     ! h0: physical thickness of the skin layer (m)
            8071                     ! kh: heat diffusivity (m2/s)
            8072                     ! omegas: Earth's angular velocity respect to Sun (2*pi/86400 s-1)
            8073                     ! HEFN: effective thickness of the skin layer (m)
            8074                     !*********************
            8075                       USE mod_eos_ocean,    ONLY: api
            8076                       IMPLICIT NONE
            8077                       real:: hstr
            8078                     !!!  TASTRFN=api/4.-ARCTAN( SIN(hstr)*EXP(-hstr)/(1.-Cos(hstr)*EXP(-hstr)) )
            8079                       TASTRFN=api/4.-ATAN( SIN(hstr)/(EXP(hstr)-Cos(hstr)) )
            8080                     END FUNCTION TASTRFN
            8081                     ! ----------------------------------------------------------------------
            8082                     real FUNCTION SSTRFN(zkm1str,zkstr,zkp1str)
            8083                     !*********************
            8084                     ! CALCUL dimensionless elasticity of numerical layer k
            8085                     ! zkm1,zk,zkp1: vertical coordinates of k-1, k, k+1 (m) (positive upward)
            8086                     ! s: elasticity (dGk/dTk-dGk+1/dTk)
            8087                     ! sstr: dimensionless elasticity
            8088                     ! sstr=s/rhogcg/SQRT(kh*omegas)
            8089                     ! kh: heat diffusivity (m2/s)
            8090                     ! omegas: Earth's angular velocity respect to Sun (2*pi/86400 s-1)
            8091                     !*********************
            8092                       IMPLICIT NONE
            8093                       real, INTENT(in):: zkm1str,zkstr,zkp1str
            8094                       SSTRFN=(1./(zkm1str-zkstr)+1./(zkstr-zkp1str))/SQRT(2.)
            8095                     END FUNCTION SSTRFN
            8096                     ! ----------------------------------------------------------------------
            8097                     real FUNCTION dGdTFN(em,ra,rc,T0,ps,rhoa)
            8098                     !*********************
            8099                     ! CALCUL dG/dT of land surface (W/m2/K)
            8100                     ! em: emissivity of land surface
            8101                     ! ra: aerodynamic resistsnce (s/m)
            8102                     ! rc: canopy resistance (s/m)
            8103                     ! T0: land skin temperature (K)
            8104                     ! ps: surface pressure (Pa)
            8105                     ! rhoa: air density (kg/m3)
            8106                     ! dGdT:
            8107                     !*********************
            8108                       USE mod_eos_ocean,      ONLY: stbo,cpd,alv
            8109                     !!!  USE convect_tables_mod,   ONLY: jptlucu1,jptlucu2,tlucub
            8110                     !!!  USE convect_tables_mod, ONLY : lookuperror, lookupoverflow, jptlucu1    &
            8111                     !!!                              , jptlucu2, tlucua, tlucub, tlucuaw
            8112                       IMPLICIT NONE
            8113                       real, INTENT(in):: em,ra,rc,T0,ps,rhoa
            8114                       INTEGER  :: it
            8115                       real:: dqsatdT
            8116                       it = MAX(MIN(NINT(T0*1000.),jptlucu2),jptlucu1)
            8117                       dqsatdT=0.622*tlucub(it)/ps
            8118                       dGdTFN=4.*em*stbo*T0**3+rhoa*cpd/ra+rhoa*alv/(ra+rc)*dqsatdT
            8119                     END FUNCTION dGdTFN
            8120                     ! ----------------------------------------------------------------------
            8121                     real FUNCTION SSTR0FN(rhogcg,kh,omegas,dGdT,z0str,z1str)
            8122                     !*********************
            8123                     ! CALCUL dimensionless elasticity of numerical layer k
            8124                     ! rhogcg: volume heat capacity (kg/m3*J/kg/K)=(J/m3/K)
            8125                     ! kh: heat diffusivity (m2/s)
            8126                     ! omegas: Earth's angular velocity respect to Sun (2*pi/86400 s-1)
            8127                     ! dGdT:
            8128                     ! z0str,z1str: dimensionless vertical coordinates of k=0, k=1 (positive upward)
            8129                     ! s: elasticity (dGk/dTk-dGk+1/dTk)
            8130                     ! sstr: dimensionless elasticity
            8131                     ! sstr=s/rhogcg/SQRT(kh*omegas)
            8132                     !*********************
            8133                       IMPLICIT NONE
            8134                       real, INTENT(in):: rhogcg,kh,omegas,dGdT,z0str,z1str
            8135                       SSTR0FN=dGdT/rhogcg/SQRT(kh*omegas)+1./(z0str-z1str)/SQRT(2.)
            8136                     END FUNCTION SSTR0FN
            8137                     ! ----------------------------------------------------------------------
            8138                     real FUNCTION HEPSTRFN(ha,ht,s,ta)
            8139                       IMPLICIT NONE
            8140                       real:: ha,ht,s,ta
            8141                       HEPSTRFN=( 2.*ha**2-EXP(-ht)**2*s**2                                                  &
            8142                           +SQRT(4.*ha**4+4.*Cos(2.*(ta-ht))*EXP(-ht)**2*s**2+EXP(-ht)**4*s**4)        &
            8143                         )/(4.*Cos(ta-ht)*EXP(-ht)*ha)
            8144                     END FUNCTION HEPSTRFN
            8145                     ! ----------------------------------------------------------------------
            8146                     real FUNCTION HEPFN(h,ht,s,kh,omegas,rhogcg)
            8147                     !*********************
            8148                     ! CALCUL Effective thickness
            8149                     ! h: physical thickness of the numerial layer (m)
            8150                     ! ht: center of temperature below upper interface (m)
            8151                     ! s: elasticity (dGk/dTk-dGk+1/dTk)
            8152                     ! kh: heat diffusivity (m2/s)
            8153                     ! omegas: Earth's angular velocity respect to Sun (2*pi/86400 s-1)
            8154                     ! rhogcg: volume heat capacity (kg/m3*J/kg/K)=(J/m3/K)
            8155                     ! HEPFN: effective thickness of the numerical layer (m)
            8156                     !*********************
            8157                       IMPLICIT NONE
            8158                       real, INTENT(in):: h,ht,s,kh,omegas,rhogcg
            8159                       real:: h_ref,hstr,htstr,hastr,tastr,sstr,hepstr
            8160                       h_ref=SQRT(2.*kh/omegas)
            8161                       hstr=h/h_ref
            8162                       htstr=ht/h_ref
            8163          i            hastr=HASTRFN(hstr)
            8164          i            tastr=TASTRFN(hstr)
            8165                       sstr=s/rhogcg/SQRT(kh*omegas)
            8166          i            hepstr=HEPSTRFN(hastr,htstr,sstr,tastr)
            8167                       HEPFN=h_ref*hepstr
            8168                     END FUNCTION HEPFN
            8169                     ! ----------------------------------------------------------------------
            8170                     real FUNCTION HE0PFN(h,s,kh,omegas,rhogcg)
            8171                     !*********************
            8172                     ! CALCUL Effective thickness of the surface numerical layer
            8173                     ! h: physical thickness of the numerial layer (m)
            8174                     ! s: elasticity (dGk/dTk-dGk+1/dTk)
            8175                     ! kh: heat diffusivity (m2/s)
            8176                     ! omegas: Earth's angular velocity respect to Sun (2*pi/86400 s-1)
            8177                     ! rhogcg: volume heat capacity (kg/m3*J/kg/K)=(J/m3/K)
            8178                     ! HE0PFN: optimal effective thickness of the skin layer (m)
            8179                     !*********************
            8180                       IMPLICIT NONE
            8181                       real, INTENT(in):: h,s,kh,omegas,rhogcg
            8182                       HE0PFN=HEPFN(h,0.,s,kh,omegas,rhogcg)
            8183                     END FUNCTION HE0PFN
            8184                     ! ----------------------------------------------------------------------
            8185                     real FUNCTION SEAICEFN(siced)
            8186                     !*********************
            8187                     ! CALCUL sea ice cover fraction of a grid basen on mean sea ice depth
            8188                     ! siced: mean sea ice depth of a grid (m, swe)
            8189                     ! SEAICEFN: sea ice cover fraction [0-1] (dimensionless)
            8190                     ! assume to be lognormal distribution
            8191                     ! seaice[0.]=0.
            8192                     ! seaice[csiced]=0.5
            8193                     ! seaice[2*csiced]=0.84
            8194                     !*********************
            8195                       IMPLICIT NONE
            8196                     ! threshold sea ice depth, (= 2 m)
            8197                     ! this value should be resolution dependent
            8198                     ! 0 to be infinity fine resolution
            8199                     ! seaice[csiced]=50%
            8200                     !  real:: csiced      ! seaice[csiced]=0.5
            8201                     
            8202                       real, INTENT(in):: siced
            8203     1                 IF (csiced.GT.TOL) THEN
            8204     1               #ifdef __ibm__
            8205     1                   SEAICEFN=0.5*(ERF(LOG(siced/csiced))+1.)
            8206     1               #else
            8207     1                   SEAICEFN=0.5*(ERF(LOG(siced/csiced))+1.)
            8208     1                   !!! SEAICEFN=0.5_dp*(DERF(LOG(siced/csiced))+1.)
            8209     1               #endif
            8210     1                 ELSEIF (.FALSE.) THEN
            8211     1                   ! csiced=3.      !
            8212     1                   ! csiced=2.      ! seaice fraction is estimated to be 2.8%, while the observation 3.7% (T31)
            8213     1                   ! csiced=0.5_dp     ! seaice fraction is estimated to be 6.8%, while the observation 3.7% m (v9.9003, T31)
            8214     1                   ! csiced=1.0_dp     ! seaice fraction is estimated to be still as high as 6.8%, while the observation 3.7% m (v9.9004, T31, T63)
            8215     1                     csiced=2.0
            8216     1                   !!!   IF (GDCHK2) then
            8217     1                   !!!     WRITE(nerr,*) "csiced: Truncation is not tested in T',nn,' runs."
            8218     1                   !!!   ENDIF
            8219     1               #ifdef __ibm__
            8220     1                   SEAICEFN=0.5*(ERF(LOG(siced/csiced))+1.)
            8221     1               #else
            8222     1                   !!! SEAICEFN=0.5_dp*(DERF(LOG(siced/csiced))+1.)
            8223     1                   SEAICEFN=0.5*(ERF(LOG(siced/csiced))+1.)
            8224     1               #endif
            8225     1                 ELSE
            8226     2                   IF (siced.GT.0.) THEN
            8227     2                   ! seaice mask: Winner wins!
            8228     2                   ! seaice fraction is estimated to be 5.6%, while the observation 3.7% (T31)(cob10dnnnn, cob10d10dnn, cob10d10d10d)
            8229     2                   ! there is 660 ice grids, while the observation is 760 ice grid.
            8230     2                     SEAICEFN=1.
            8231     2                   ELSE
            8232     2                     SEAICEFN=0.
            8233     2                   ENDIF
            8234     1                 ENDIF
            8235                     END FUNCTION SEAICEFN
            8236                     ! ----------------------------------------------------------------------
            8237                     real FUNCTION SICEDFN(seaice)
            8238                     !*********************
            8239                     ! CALCUL sea ice cover fraction of a grid basen on mean sea ice depth
            8240                     ! siced: mean sea ice depth of a grid (m, swe)
            8241                     ! SEAICEFN: sea ice cover fraction [0-1] (dimensionless)
            8242                     ! assume to be lognormal distribution
            8243                     ! seaice[0.]=0.
            8244                     ! seaice[csiced]=0.5
            8245                     ! seaice[2*csiced]=0.84
            8246                     !*********************
            8247                       IMPLICIT NONE
            8248                     ! threshold sea ice depth, (= 2 m)
            8249                     ! this value should be resolution dependent
            8250                     ! 0 to be infinity fine resolution
            8251                     ! seaice[csiced]=50%
            8252                     !!!  real:: csiced      ! seaice[csiced]=0.5
            8253                     
            8254                       real, INTENT(in):: seaice
            8255                     !!!  IF (csiced.GT.TOL) THEN
            8256                     !!!#ifdef __ibm__
            8257                     !!!    !!! SICEDFN=csiced*EXP(ERFINV(2.*seaice-1.))
            8258                     !!!    SICEDFN=csiced*EXP(ERFINV(2.*seaice-1.))
            8259                     !!!#else
            8260                     !!!    !!! SICEDFN=csiced*EXP(DERFINV(2.*seaice-1.))
            8261                     !!!    SICEDFN=csiced*EXP(ERFINV(2.*seaice-1.))
            8262                     !!!#endif
            8263                     !!!  ELSE
            8264     1                   IF (seaice.GT.0.5) THEN
            8265     1                   !!! IF (seaice.GT.TOL) THEN
            8266     1                   ! seaice mask: Winner wins!
            8267     1                   ! seaice fraction is estimated to be 5.6%, while the observation 3.7% (T31)(cob10dnnnn, cob10d10dnn, cob10d10d10d)
            8268     1                   ! there is 660 ice grids, while the observation is 760 ice grid.
            8269     1                     SICEDFN=1.
            8270     1                   ELSE
            8271     1                     SICEDFN=0.
            8272     1                   ENDIF
            8273                     !!!  ENDIF
            8274                     END FUNCTION SICEDFN
            8275                     ! ----------------------------------------------------------------------
            8276                       real FUNCTION HSNFN(sni)
            8277                       !*********************
            8278                       ! CALCU snow thickness of the grid (m), based on grid mean snow depth in swe (sni)
            8279                       !*********************
            8280                         IMPLICIT NONE
            8281                         real, INTENT(in):: sni
            8282                         HSNFN=sni*rhoh2o/rhosn
            8283                       END FUNCTION HSNFN
            8284                       !---------------------
            8285                       real FUNCTION HICEFN(siced)
            8286                       !*********************
            8287                       ! CALCUL mean ice thickness of the grid (m), based on grid mean sea ice depth in swe (siced)
            8288                       !*********************
            8289                         IMPLICIT NONE
            8290                         real, INTENT(in):: siced
            8291                         HICEFN=siced*rhoh2o/rhoice
            8292                       END FUNCTION HICEFN
            8293                     ! ----------------------------------------------------------------------
            8294                       real FUNCTION wt_maxden(depth,obswtb,obswsb,mixing_depth)
            8295                       !*********************
            8296                       ! CALCUL water temperature based on max density water temperature approach
            8297                       ! set initial profile to be expontential decay to tmaxden
            8298                       !   =  3.73 C for fresh water s=0
            8299                       !   = -4.35 C for ocena water s=36.3 0/00.
            8300                       !*********************
            8301                         IMPLICIT NONE
            8302                         real, INTENT(in):: depth           ! depth (m, positive downward)
            8303                         real, INTENT(in):: obswtb          ! observed bulk water temperature (K)
            8304                         real, INTENT(in):: obswsb          ! observed bulk salinity (PSU)
            8305                         real, INTENT(in):: mixing_depth    ! mixing depth
            8306                     !ps    IF ( depth.LE.mixing_depth) then
            8307                     !ps      wt_maxden=obswtb
            8308                     !ps    ELSE
            8309                     !ps      wt_maxden=tmaxden(obswsb)+(obswtb-tmaxden(obswsb))*EXP(-(depth-mixing_depth)/100.)
            8310                     !ps      wt_maxden=tmaxden(obswsb)+(obswtb-tmaxden(obswsb))*EXP(-(depth-mixing_depth)/mixing_depth)
            8311                           wt_maxden=tmaxden(obswsb)+(obswtb-tmaxden(obswsb))*EXP(-depth/mixing_depth)
            8312                     !ps    ENDIF
            8313                       END FUNCTION wt_maxden
            8314                     ! ----------------------------------------------------------------------
            8315                       SUBROUTINE pzcord(zwlvl,bathy,nls,nle,z,zlk,hw,lsoil,lshlw)
            8316                     !
            8317                     !     WATER BODY POINT VERTICAL LEVELS
            8318                     !     zlk: coordinates of a water body flux (m ASL).
            8319                     !     z: z coordinates of the water body temperature (m ASL).
            8320                     !     nls: starting water level of the water body point.
            8321                     !       z(k)=zwlvl, IF k is <= nls.
            8322                     !     nle: maximum water levels of the water body point.
            8323                     !        Note nle=-1 IF water level is below point water body bed.
            8324                     !        Soil layer always is sitwt(nle+1). If there is no water,
            8325                     !        sitwt(nle+1)=sitwt(0,jrow). In addition, z(k)=bathy IF k >= nle.
            8326                     !     hw: thickness of each layer
            8327                     !     lshlw = shallow water mode (due to evaportion or freezing)
            8328                     !       (one layer water body)
            8329                     !     lsoil = soil grid
            8330                     !     zwlvl  : current water level (ice/water interface) a water body grid            I
            8331                     !----------------------------------------------------------
            8332                     !*    0 Locate Space
            8333                           IMPLICIT NONE
            8334                     !     0.1 Calling Variables
            8335                           real, INTENT(IN):: zwlvl,bathy
            8336                     
            8337                     !     input
            8338                     !v77      INTEGER oceanid,jl
            8339                     !     output
            8340                           INTEGER, INTENT(OUT):: nls,nle
            8341                           real, INTENT(OUT):: z(0:lkvl+1),zlk(0:lkvl+1),hw(0:lkvl)
            8342                           LOGICAL, INTENT(OUT):: lsoil, lshlw
            8343                     !     0.2 local variables
            8344                           INTEGER k
            8345                           REAL :: tmp
            8346                           real:: zdepth(0:lkvl)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zdepth
                                   <<< Loop-information  End >>>
            8347        pp   4v            zdepth(0:lkvl)=sit_zdepth(0:lkvl)
            8348                     !     0.3 Initial	(default)
            8349                           nls=-999
            8350                           nle=-999
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zlk, z
                                   <<< Loop-information  End >>>
            8351        pp   2v            z=xmissing
            8352         p   2v            zlk=xmissing
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hw
                                   <<< Loop-information  End >>>
            8353        pp   4v            hw=xmissing
            8354                           lshlw = .FALSE.
            8355                           lsoil = .FALSE.
            8356                     !
            8357                     !*    1.0 Determine Ocean Coordinate
            8358                     !
            8359                     !
            8360     1                     IF ( (zwlvl.GE.bathy+wcri) )  THEN
            8361     1               !
            8362     1               !     2. Water
            8363     1               !
            8364     1                       nls=0
            8365     1                       nle=lkvl
            8366     1                       z(lkvl+1)=bathy
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            8367     2  pp    v              DO k = 0,lkvl
            8368     2   p    v                tmp=zwlvl-zdepth(k)
            8369     3   p    v                IF ( tmp.GT.(bathy+wcri) ) THEN
            8370     3   p    v                  z(k)=tmp
            8371     3   p    v                  nle=k
            8372     3   p                     ELSE
            8373     3   p    v                  z(k)=bathy
            8374     3   p    v                ENDIF
            8375     2   p    v              ENDDO
            8376     1               !
            8377     1               !*    3. Determine Thickness (hw) and zlk of Each Layer
            8378     1               !
            8379     1                       zlk(0)=zwlvl
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            8380     2   s    v              DO k = 1,nls
            8381     2                         !! vanisih top layers when waterlevel is lower than the reference level
            8382     2   p    v                zlk(k)=zwlvl
            8383     2   p    v              ENDDO
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 224, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zlk
                                   <<< Loop-information  End >>>
            8384     2  pp   2v              DO k = nls+1,lkvl+1
            8385     2               !!!          zlk(k)=(z(k-1)+z(k))/2.
            8386     2   p   2v                zlk(k)=zwlvl-sit_fluxdepth(k)
            8387     2   p   2v              ENDDO
            8388     1               
            8389     1                       hw(0)=zlk(0)-zlk(nls+1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            8390     2   s    v              DO k = 1,nls
            8391     2   p    v                hw(k)=0.
            8392     2   p    v              ENDDO
            8393     1                       hw(nls+1)=zlk(0)-zlk(nls+2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zlk, hw
                                   <<< Loop-information  End >>>
            8394     2  pp   2v              DO k = nls+2,nle-1
            8395     2   p   2v                hw(k)=zlk(k)-zlk(k+1)
            8396     2   p   2v              ENDDO
            8397     1                       hw(nle)=zlk(nle)-z(nle+1)
            8398     1               
            8399     1               !
            8400     1               !*    4. Determine Current Existence of Water
            8401     1               !
            8402     2                       IF ((nle-nls).EQ.1) THEN
            8403     2                         lshlw = .TRUE.
            8404     2               !         shallow water body
            8405     2                       ENDIF
            8406     1               !
            8407     1                     ELSE
            8408     1               !
            8409     1               !     5.0 Not a Ocean Grid (Soil)
            8410     1               !
            8411     1                       nle=-1
            8412     1                       z(nle+1)=bathy
            8413     1                       lsoil = .TRUE.
            8414     1                     ENDIF
            8415     1                  IF(lwarning_msg.GE.4) then
            8416     1                     WRITE(nerr,*) "lshlw=",lshlw,"lsoil=",lsoil,"nls=",nls,"nle=",nle
            8417     1                  ENDIF
            8418                     
            8419                       END SUBROUTINE pzcord
            8420                     ! **********************************************************************
            8421                     
            8422                       SUBROUTINE cal_ratioBlending(pmyrank,pii,pjj,plat,inlon,outratio)
            8423                     
            8424                           use mod_sit_control,  only: sit_domain_w,sit_domain_e &
            8425                                                    ,sit_domain_s,sit_domain_n &
            8426                                                    ,sit_domain_extgrd
            8427                     ! location blending
            8428                           real:: plat,inlon
            8429                           real:: plon
            8430                           real:: outratio
            8431                           real:: rrn,rrs,rre,rrw,rr_sn,rr_we,rrtmp
            8432                     !    real, PARAMETER:: rf=10._dp
            8433                           real, PARAMETER:: rf=5.
            8434                           integer:: pmyrank,pii,pjj
            8435                     
            8436                     
            8437     1                     IF(inlon .LT. 0.) THEN
            8438     1                       plon=inlon + 360.
            8439     1                     else
            8440     1                       plon=inlon
            8441     1                     ENDIF
            8442                     
            8443     1                     IF((plon .GE. sit_domain_w) .AND. &
            8444     1                        (plon .LE. sit_domain_e) ) then
            8445     1                       rre=1.
            8446     1                       rrw=1.
            8447     1                     ELSEIF( (plon .GT. sit_domain_e) .AND. &
            8448     1                             (plon .LE. sit_domain_e+sit_domain_extgrd) ) THEN
            8449     1                       rre=min(sit_domain_e+sit_domain_extgrd,360.)
            8450     1                       rrw=sit_domain_e
            8451     1                     ELSEIF( (plon .GT. sit_domain_w-sit_domain_extgrd) .AND. &
            8452     1                             (plon .LE. sit_domain_w) ) THEN
            8453     1                       rre=max(sit_domain_w-sit_domain_extgrd,0.)
            8454     1                       rrw=sit_domain_w
            8455     1                     ELSE
            8456     1                       rre=0.
            8457     1                       rrw=0.
            8458     1                     ENDIF
            8459                     
            8460     1                     IF((plat .GE. sit_domain_s) .AND. &
            8461     1                        (plat .LE. sit_domain_n) ) then
            8462     1                       rrn=1.
            8463     1                       rrs=1.
            8464     1                     ELSEIF( (plat .GT. sit_domain_n) .AND. &
            8465     1                             (plat .LE. sit_domain_n+sit_domain_extgrd)  ) THEN
            8466     1                       rrn=min(sit_domain_n+sit_domain_extgrd,90.)
            8467     1                       rrs=sit_domain_n
            8468     1                     ELSEIF( (plat .GE. sit_domain_s-sit_domain_extgrd) .AND. &
            8469     1                             (plat .LT. sit_domain_s) ) THEN
            8470     1                       rrn=max(sit_domain_s-sit_domain_extgrd,-90.)
            8471     1                       rrs=sit_domain_s
            8472     1                     ELSE
            8473     1                       rrn=0.
            8474     1                       rrs=0.
            8475     1                     ENDIF
            8476                     
            8477     1                     IF(rrw .EQ. 1.) THEN
            8478     1                       rr_we=1.
            8479     1                     ELSEIF(rrw .EQ. 0.) THEN
            8480     1                       rr_we=0.
            8481     1                     ELSE
            8482     1                       rr_we=1.-ABS((plon-rrw)/(rre-rrw))
            8483     1                     ENDIF
            8484                     
            8485     1                     IF(rrs .EQ. 1.) THEN
            8486     1                       rr_sn=1.
            8487     1                     ELSEIF(rrs .EQ. 0.) THEN
            8488     1                       rr_sn=0.
            8489     1                     ELSE
            8490     1                       rr_sn=1.-ABS((plat-rrs)/(rrn-rrs))
            8491     1                     ENDIF
            8492                     
            8493     1                     if(rr_sn .eq. 1.) then
            8494     1                       rrtmp=rr_we
            8495     1                     elseif(rr_we .eq. 1.)then
            8496     1                       rrtmp=rr_sn
            8497     1                     else
            8498     1                       rrtmp=0.5*(rr_sn+rr_we)
            8499     1                     endif
            8500                     
            8501     1                     IF(rrtmp .EQ. 1.) THEN
            8502     1                       outratio=1.
            8503     1                     ELSE if(rrtmp .eq. 0.) then
            8504     1                       outratio=0.
            8505     1                     ELSE
            8506     1                       outratio=exp(-rf/rrtmp*exp(1./(rrtmp-1.)))
            8507     1                     ENDIF
            8508                     
            8509     1                     if(pmyrank.eq.6 .AND. pii.eq.1 .AND. pjj.eq.12) then
            8510     1                       print *,'in ratio: myrank=',pmyrank,',ii=',pii &
            8511     1                              ,',jj=',pjj,',rre=',rre,',rrw=',rrw    &
            8512     1                              ,',rr_we=',rr_we,',rrn=',rrn,',rrs=',rrs &
            8513     1                              ,',rr_sn=',rr_sn,',rrtmp=',rrtmp      &
            8514     1                              ,',outratio=',outratio
            8515     1                     endif
            8516                     
            8517                     
            8518                       END SUBROUTINE cal_ratioBlending
            8519                     
            8520                     END MODULE mod_sit_vdiff

            2845     2                       WRITE(nerr,*) "rsf=",prsf(1:kproma)
            2846     2                       WRITE(nerr,*) "ssf=",pssf(1:kproma)
            2847     2               !!!        CALL mp_barrier()
            2848     2               #if defined (LCWBGFS)
            2849     2                       WRITE(nerr,*), "sit_vdiff, unreasonable ptsw, myrank=", myrank
            2850     2                       call mpe_finalize
            2851     2               #else
            2852     2                       call mpp_error ('sit_vdiff', 'unreasonable ptsw', FATAL)
            2853     2               #endif
            2854     2               !
            2855     2                    ENDIF
            2856     1                 ENDIF
            2857                       RETURN
            2858                     ! **********************************************************************
            2859                     CONTAINS
            2860                       !----------------------------------------------------------
            2861                       !*    5.0  SUBROUTINES
            2862                       ! **********************************************************************
            2863                       SUBROUTINE final
            2864                       !
            2865                         !!! USE mo_semi_impl,        ONLY: eps
            2866                       !!!   USE convect_tables_mod,   ONLY: jptlucu1, jptlucu2
            2867                       !   INTEGER, PARAMETER:: jptlucu1 =  50000  ! lookup table lower bound (50K)
            2868                       !   INTEGER, PARAMETER:: jptlucu2 = 400000  ! lookup table upper bound (400K)
            2869                         IMPLICIT NONE
            2870                         real:: sumxxz,sumxxt,sumxxu,sumxxv,sumxxs
            2871                         real, PARAMETER:: tmin_table=jptlucu1/1000.
            2872                         real, PARAMETER:: tmax_table=jptlucu2/1000.
            2873                       !!!  real, PARAMETER:: eps=0.001_dp
            2874                         INTEGER:: jk
            2875                     ! location blending
            2876                         real:: rrn,rrs,rre,rrw,rr_sn,rr_we,rrtmp,wtr
            2877                     !    real, PARAMETER:: rf=10._dp
            2878                         real, PARAMETER:: rf=5.
            2879                     !ps
            2880                     
            2881                     #if defined(LCWBGFS)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 147
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            2882     1  pp    v          Do jk=nls,nle+1
            2883     1   p    v             pwt(jl,jk)=0.2*pwt(jl,jk)+0.3*poldsitwt(jl,jk,1)+0.5*poldsitwt(jl,jk,0)
            2884     1   p    v             pwu(jl,jk)=0.2*pwu(jl,jk)+0.3*poldsitwu(jl,jk,1)+0.5*poldsitwu(jl,jk,0)
            2885     1   p    v             pwv(jl,jk)=0.2*pwv(jl,jk)+0.3*poldsitwv(jl,jk,1)+0.5*poldsitwv(jl,jk,0)
            2886     1   p    v             pww(jl,jk)=0.2*pww(jl,jk)+0.3*poldsitww(jl,jk,1)+0.5*poldsitww(jl,jk,0)
            2887     1   p    v             pws(jl,jk)=0.2*pws(jl,jk)+0.3*poldsitws(jl,jk,1)+0.5*poldsitws(jl,jk,0)
            2888     1   p    v             pwtke(jl,jk)=0.2*pwtke(jl,jk)+0.3*poldwtke(jl,jk,1)+0.5*poldwtke(jl,jk,0)
            2889     1               !       pwt(jl,jk)=1.*pwt(jl,jk)+0.*poldsitwt(jl,jk,1)+0.*poldsitwt(jl,jk,0)
            2890     1               !       pwu(jl,jk)=1.*pwu(jl,jk)+0.*poldsitwu(jl,jk,1)+0.*poldsitwu(jl,jk,0)
            2891     1               !       pwv(jl,jk)=1.*pwv(jl,jk)+0.*poldsitwv(jl,jk,1)+0.*poldsitwv(jl,jk,0)
            2892     1               !       pww(jl,jk)=1.*pww(jl,jk)+0.*poldsitww(jl,jk,1)+0.*poldsitww(jl,jk,0)
            2893     1               !       pws(jl,jk)=1.*pws(jl,jk)+0.*poldsitws(jl,jk,1)+0.*poldsitws(jl,jk,0)
            2894     1               !       pwtke(jl,jk)=1.*pwtke(jl,jk)+0.*poldwtke(jl,jk,1)+0.*poldwtke(jl,jk,0)
            2895     1   p    v          ENDDO
            2896                           if(GDCHK3) print *,"final,jk=0,oldwt(0)=",poldsitwt(jl,0,0),",oldwt(1)=",poldsitwt(jl,0,1)
            2897                           if(GDCHK3) print *,"final,jk=1,oldwt(0)=",poldsitwt(jl,1,0),",oldwt(1)=",poldsitwt(jl,1,1)
            2898                     #endif
            2899                     
            2900                     
            2901                     
            2902     1                 IF (ltrigsit) THEN
            2903     1                 !!! couple with SIT: return SIT sst and ice to atmosphere model
            2904     1                 !
            2905     1                 !*     5.1 pgrndcapc, pgrndhflx, current, tsw
            2906     1                 !
            2907     2                     IF (hesn.GT.csncri) THEN
            2908     2                 !   snow on top
            2909     2                       pgrndcapc(jl)=rhosn*csn*hesn
            2910     2                       ptsl(jl)=MAX(MIN(ptsl(jl),tmelt),tmin_table)
            2911     2                       ptslm(jl)=MAX(MIN(ptslm(jl),tmelt),tmin_table)
            2912     2                       ptslm1(jl)=MAX(MIN(ptslm1(jl),tmelt),tmin_table)
            2913     2                     ELSEIF (heice.GT.xicri) THEN
            2914     2                 !   ice on top
            2915     2                       pgrndcapc(jl)=rhoice*cice*heice
            2916     2                       ptsl(jl)=MAX(MIN(ptsl(jl),tmelt),tmin_table)
            2917     2                       ptslm(jl)=MAX(MIN(ptslm(jl),tmelt),tmin_table)
            2918     2                       ptslm1(jl)=MAX(MIN(ptslm1(jl),tmelt),tmin_table)
            2919     2                     ELSEIF(.NOT.lsoil) THEN
            2920     2                 !   water on top
            2921     2                       pgrndcapc(jl)=rhowcw*hew
            2922     2                       ptsl(jl)=MIN(MAX(ptsl(jl),pctfreez2(jl)),tmelt+100.)
            2923     2                       ptslm(jl)=MIN(MAX(ptslm(jl),pctfreez2(jl)),tmelt+100.)
            2924     2                       ptslm1(jl)=MIN(MAX(ptslm1(jl),pctfreez2(jl)),tmelt+100.)
            2925     2                     ELSE
            2926     2                 !   soil on top
            2927     2                       pgrndcapc(jl)=rhogcg*SQRT(xkg/omegas)
            2928     2                     ENDIF
            2929     1                     pocu(jl)=pwu(jl,0)
            2930     1                     pocv(jl)=pwv(jl,0)
            2931     1                 !*       5.3     Time filter for surface temperature
            2932     2                     IF (.NOT.lsitstart) THEN
            2933     2                       ptslm1(jl)=ptslm(jl)+eps*(ptslm1(jl)-2.*ptslm(jl)+ptsl(jl))
            2934     2                       ptslm(jl)=ptsl(jl)
            2935     2                     ELSE
            2936     2                       ptslm1(jl)=ptslm(jl)
            2937     2                     ENDIF
            2938     1                 !
            2939     1                 !*    5.2 snow/ice properties
            2940     1                 !
            2941     2                     IF(lsit_ice) THEN
            2942     2                       psni(jl)=pzsi(jl,0)
            2943     2                       !! an extra varible for snow is needed for partial water/partial land,
            2944     2                       !! and modification is need for subroutine albedo for distinquish snow on ice
            2945     2                       !! or snow on land
            2946     2                       psiced(jl)=pzsi(jl,1)
            2947     2                 !!  !
            2948     2                 !!
            2949     2                 !!  ! change to lognormal distribution:
            2950     2                 !!  !
            2951     2                       pseaice(jl)=SEAICEFN(psiced(jl))
            2952     2                       !
            2953     3                       IF (hesn.GT.csncri) THEN
            2954     3                 !     snow on top
            2955     4                         IF(sit_ice_option.EQ.0) THEN
            2956     4                           ptsnic(jl,0)=ptslm1(jl)
            2957     4                         ELSE IF (sit_ice_option.EQ.1) THEN
            2958     4                           ptsnic(jl,0)=MAX(ptsnic(jl,0),tmelt-10.)
            2959     4                           ! tmelt-10.: security number
            2960     4                           ! for preventing ocillation
            2961     4                           ! It should be modified with implicit coupling
            2962     4                           ! with the atmospehre.
            2963     4                         ELSE IF (sit_ice_option.EQ.2) THEN
            2964     4                           ptsnic(jl,0)=ptsnic(jl,0)
            2965     4                           ! This also crash after few time steps.
            2966     4                         ELSE IF (sit_ice_option.EQ.3) THEN
            2967     4                           ptsnic(jl,0)=ptsnic(jl,1)
            2968     4                           ! This also crash after few time steps.
            2969     4                         ELSE IF (sit_ice_option.EQ.4) THEN
            2970     4                           ptsnic(jl,0)=MAX(QFLTI*ptsnic(jl,0)+QFLTA*ptemp2(jl)+(1.-QFLTI-QFLTA)*tsim(0),tmelt-50.)
            2971     4                           ! This also crash after few time steps.
            2972     4                           ! QFLTI should be a value within 0-1., a security number
            2973     4                           ! for preventing ocillation. It should be modified with
            2974     4                           ! implicit coupling with the atmospehre for getting 1st order accuracy.
            2975     4                         ENDIF
            2976     3                         ptsi(jl)=ptsnic(jl,0)
            2977     3                         ptsw(jl)=pwt(jl,0)
            2978     3                       ELSEIF (heice.GT.xicri) THEN
            2979     3                 !     ice on top
            2980     4                         IF(sit_ice_option.EQ.0) THEN
            2981     4                           ptsnic(jl,2)=ptslm1(jl)
            2982     4                         ELSE IF (sit_ice_option.EQ.1) THEN
            2983     4                           ptsnic(jl,2)=MAX(ptsnic(jl,2),tmelt-10.)
            2984     4                            ! tmelt-10.: security number
            2985     4                            ! for preventing ocillation
            2986     4                            ! It should be modified with implicit coupling
            2987     4                            ! with the atmospehre.
            2988     4                         ELSE IF (sit_ice_option.EQ.2) THEN
            2989     4                           ptsnic(jl,2)=ptsnic(jl,2)
            2990     4                             ! This will creash in few time steps
            2991     4                         ELSE IF (sit_ice_option.EQ.3) THEN
            2992     4                           ptsnic(jl,2)=ptsnic(jl,3)
            2993     4                             ! This will creash in few time steps
            2994     4                         ELSE IF (sit_ice_option.EQ.4) THEN
            2995     4                           ptsnic(jl,2)=MAX(QFLTI*ptsnic(jl,2)+QFLTA*ptemp2(jl)+(1.-QFLTI-QFLTA)*tsim(2),tmelt-50.)
            2996     4                             ! QFLTI should be a value within 0-1., a security number
            2997     4                             ! for preventing ocillation. It should be modified with
            2998     4                             ! implicit coupling with the atmospehre for getting 1st order accuracy.
            2999     4                         ENDIF
            3000     3                         ptsi(jl)=ptsnic(jl,2)
            3001     3                         ptsw(jl)=pwt(jl,0)
            3002     3                       ELSEIF(.NOT.lsoil) THEN
            3003     3                 !     water on top
            3004     4                         IF(sit_ice_option.EQ.0) THEN
            3005     4                           !!! ptsw(jl)=ptslm1(jl)
            3006     4                           !!! rather using pwt than ptslm1 for ptsw
            3007     4                           ptsw(jl)=pwt(jl,0)
            3008     4                         ELSE
            3009     4                           ptsw(jl)=pwt(jl,0)
            3010     4                         ENDIF
            3011     3                         ptsi(jl)=tmelt
            3012     3                       ELSE
            3013     3                 !     soil on top
            3014     3                         ptsi(jl)=tmelt
            3015     3                         ptsw(jl)=pwt(jl,nle+1)
            3016     3                       ENDIF
            3017     2                     ELSE
            3018     3                       IF(.NOT.lsoil) THEN
            3019     3                         ptsw(jl)=pwt(jl,0)
            3020     3                       ELSE
            3021     3                 !     soil on top
            3022     3                         ptsw(jl)=pwt(jl,nle+1)
            3023     3                       ENDIF
            3024     2                     ENDIF
            3025     1                 !!!????    pobswsb(jl)=pws(jl,0)
            3026     1                 !
            3027     1                 !!!   IF ( (ptsw(jl).GE.400_dp).OR.(ptsw(jl).LT.50.) ) THEN
            3028     1                 !!!     CALL output(hesn,hew,heice,fcew,pfluxwm,wtm,wum,wvm,wsm,wtkem,tsim,mas,mae)
            3029     1                 !!!   ENDIF
            3030     1               !ps
            3031     1               #if defined(LCWBGFS)
            3032     1               !!! location blending
            3033     2                   IF(ptsw(jl) .lt. pctfreez2(jl) .or. ptsw(jl) .gt. 350.) then
            3034     2                     ptsw(jl)=pobswtb(jl)
            3035     2               !      pdtswdt(jl)=(ptsw(jl)-poldtsw(jl))/(n_sit_step*zdtime)
            3036     2               !      pdtswdt(jl)=(pwt(jl,0)-poldsitwt(jl,0,0))/(2.*n_sit_step*zdtime)
            3037     2                     pdtswdt(jl)=(pwt(jl,0)-poldsitwt(jl,0,1))/(n_sit_step*zdtime)
            3038     2                     psitmask(jl)=0.
            3039     2                   ELSE
            3040     3                     IF( plon(jl).GT.sit_domain_e) THEN
            3041     3                       rre=min(sit_domain_e+sit_domain_extgrd,360.)
            3042     3                       rrw=sit_domain_e
            3043     3                     ELSEIF ( plon(jl).LT.sit_domain_w) THEN
            3044     3                       rre=max(sit_domain_w-sit_domain_extgrd,0.)
            3045     3                       rrw=sit_domain_w
            3046     3                     ELSE
            3047     3                       rre=1.
            3048     3                       rrw=1.
            3049     3                     ENDIF
            3050     2               
            3051     3                     IF( plat(jl).GT.sit_domain_n) THEN
            3052     3                       rrn=min(sit_domain_n+sit_domain_extgrd,90.)
            3053     3                       rrs=sit_domain_n
            3054     3                     ELSEIF( plat(jl).LT.sit_domain_s) THEN
            3055     3                       rrn=max(sit_domain_s-sit_domain_extgrd,-90.)
            3056     3                       rrs=sit_domain_s
            3057     3                     ELSE
            3058     3                       rrn=1.
            3059     3                       rrs=1.
            3060     3                     ENDIF
            3061     2               
            3062     3                     IF(rrw .EQ. 1.) THEN
            3063     3                       rr_we=1.
            3064     3                     ELSE
            3065     3                       rr_we=1.-ABS((plon(jl)-rrw)/(rre-rrw))
            3066     3                     ENDIF
            3067     3                     IF(rrs .EQ. 1.) THEN
            3068     3                       rr_sn=1.
            3069     3                     ELSE
            3070     3                       rr_sn=1.-ABS((plat(jl)-rrs)/(rrn-rrs))
            3071     3                     ENDIF
            3072     2               
            3073     2               !      rrtmp=sqrt(rr_sn**2.0+rr_we**2.0)
            3074     2                     rrtmp=0.5*(rr_sn+rr_we)
            3075     2               
            3076     3                     IF(rrtmp .EQ. 1.) THEN
            3077     3                       wtr=1.
            3078     3                     ELSE if(rrtmp .eq. 0.) then
            3079     3                       wtr=0.
            3080     3                     ELSE
            3081     3                       wtr=exp(-rf/rrtmp*exp(1./(rrtmp-1.)))
            3082     3                     ENDIF
            3083     2               
            3084     2                     ptsw(jl)= wtr*ptsw(jl)+(1.-wtr)*pobswtb(jl)
            3085     2               !      pwt(jl,0)=ptsw(jl)
            3086     2               !      pdtswdt(jl)=(ptsw(jl)-poldtsw(jl))/(n_sit_step*zdtime)
            3087     2               !      pdtswdt(jl)=(pwt(jl,0)-poldsitwt(jl,0,0))/(2.*n_sit_step*zdtime)
            3088     2                     pdtswdt(jl)=(pwt(jl,0)-poldsitwt(jl,0,1))/(n_sit_step*zdtime)
            3089     2                   ENDIF
            3090     1               !!!end location blending
            3091     1               
            3092     1               #endif
            3093     1               !ps
            3094     1                 ELSE
            3095     1                   ptsw(jl)=pobswtb(jl)
            3096     1               !    pwt(jl,0)=ptsw(jl)
            3097     1               !    pdtswdt(jl)=(ptsw(jl)-poldtsw(jl))/(n_sit_step*zdtime)
            3098     1                   pdtswdt(jl)=(pwt(jl,0)-poldsitwt(jl,0,1))/(n_sit_step*zdtime)
            3099     1                 ENDIF   !ENDIF ltrigsit
            3100     1                   IF(GDCHK3) then
            3101     1                     print *,"sitvdiff:ltrigsit=",ltrigsit,",poldtsw(jl)="       &
            3102     1                            ,poldtsw(jl),",ptsw(jl)=",ptsw(jl) &
            3103     1                            ,",pdtswdt=",pdtswdt(jl),",ltrigsit=",ltrigsit       &
            3104     1                            ,",rrs=",rrs,",rrn=",rrn,",rrw=",rrw,",rre=",rre     &
            3105     1                            ,",rr_sn=",rr_sn,",rr_we=",rr_we,",wtr=",wtr
            3106     1               
            3107     1                3301 FORMAT(1X,9(A11,E13.5))
            3108     1               
            3109     1                     WRITE(nerr,3301)           &
            3110     1                       "2sitvdifftau,",tau,",ptsw,",ptsw(jl)                     &
            3111     1                      ,",pobswtb,",pobswtb(jl),",pobswsb,",pobswsb(jl)           &
            3112     1                      ,",ptsw,",ptsw(jl),",pdtswdt,",pdtswdt(jl)                 &
            3113     1                      ,",pwt0,",pwt(jl,0),",pws0,",pws(jl,0),",zsf,",zsf
            3114     1                     ENDIF
            3115                     
            3116                       !
            3117                       !*   14.4 Calc the uppermost bulk layer properties for coupling with 3-D ocean
            3118                       !
            3119                       !
            3120     1                   IF (locn) THEN
            3121     1                     ! Not valid for lwaterlevel=.TRUE.
            3122     1                     sumxxz=0.
            3123     1                     sumxxt=0.
            3124     1                     sumxxu=0.
            3125     1                     sumxxv=0.
            3126     1                     sumxxs=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 471
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    UNSWITCHING
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3127     2   m    v            DO jk=nls+1,lstfn
            3128     2                       ! excluidng skin layer
            3129     2   p    v              sumxxz=sumxxz+hw(jk)
            3130     2   p    v              sumxxt=sumxxt+pwt(jl,jk)*hw(jk)
            3131     2   p    v              sumxxu=sumxxu+pwu(jl,jk)*hw(jk)
            3132     2   p    v              sumxxv=sumxxv+pwv(jl,jk)*hw(jk)
            3133     2   p    v              sumxxs=sumxxs+pws(jl,jk)*hw(jk)
            3134     3   p    v              IF ( lwarning_msg.GE.3 ) THEN
            3135     3   m    m                WRITE(nerr,*) 'jk=',jk,'hw=',hw(jk)
            3136     3   p    v              ENDIF
            3137     2   p    v            ENDDO
            3138     1                     pwtb(jl)=sumxxt/sumxxz
            3139     1                     pwub(jl)=sumxxu/sumxxz
            3140     1                     pwvb(jl)=sumxxv/sumxxz
            3141     1                     pwsb(jl)=sumxxs/sumxxz
            3142     1               
            3143     2                     IF ( (sumxxz.LE.0.).OR.((pwtb(jl)+pwub(jl)+pwvb(jl)+pwsb(jl)+psubfluxw(jl)+pwsubsal(jl)).LT.-9.E20) ) THEN
            3144     2                       WRITE(nerr,*) ", I am in thermocline: sumxxz = (<=0)", sumxxz
            3145     2                       WRITE(nerr,*) 'nls+1=',nls+1,'lstfn=',lstfn,'sumxxz=',sumxxz,'sumxxt=',sumxxt,'sumxxu=',sumxxu,'sumxxv=',sumxxv,'sumxxs=',sumxxs
            3146     2                       WRITE(nerr,*) 'pwtb=',pwtb(jl),'pwub=',pwub(jl),'pwvb=',pwvb(jl),'pwsb=',pwsb(jl),'psubfluxw=',psubfluxw(jl),'pwsubsal=',pwsubsal(jl)
            3147     2                       WRITE(nerr,*) 'pobswtb=',pobswtb(jl)
            3148     2                       CALL output2
            3149     2                     ENDIF
            3150     1                   ENDIF
            3151                       !
            3152                       !*  14.5 Calc ground heat flux for coupling with vdiff/surftemp,
            3153                       !        net surface heat/fresh water flux into ocean, and
            3154                       !        subsurface heat/salinity fluxes
            3155                       !
            3156                         pgrndhflx(jl)=pgrndhflx(jl)/acc_time
            3157                         pfluxiw(jl)=pfluxiw(jl)/acc_time
            3158                         ppme2(jl)=ppme2(jl)/acc_time
            3159     1                   IF (locn) THEN
            3160     1                     psubfluxw(jl)=psubfluxw(jl)/acc_time
            3161     1                     pwsubsal(jl)=pwsubsal(jl)/acc_time
            3162     1                   ENDIF
            3163                       !
            3164                       !*  14.6 Calc heat content of a water column above tmelt
            3165                       !
            3166     1                   IF (nle.GE.1)THEN
            3167     1                 !     water exists
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3168     1  pp    v            phc(jl)=rhowcw*DOT_PRODUCT((pwt(jl,nls+1:nle)-tmelt),MAX(hw(nls+1:nle),0.))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3169     1  pp    v            psc(jl)=DOT_PRODUCT(pws(jl,nls+1:nle),MAX(hw(nls+1:nle),0.))
            3170     1                   ELSE
            3171     1                 !     soil only
            3172     1                     phc(jl)=0.
            3173     1                     psc(jl)=0.
            3174     1                   ENDIF
            3175     1                   IF (lwaterlevel) THEN
            3176     1                     pengwac(jl)=pengwac(jl)-delta_time*(  pfluxw(jl)+pfluxi(jl)        &
            3177     1                       +prsf(jl)*clw*(tmelt-ptemp2(jl))                    &
            3178     1                       +pssf(jl)*(alf+csn*(tmelt-ptemp2(jl)))  )
            3179     1                 !!!  ! Assuming that rain temp to be wtm(nls+1), that of snowfall to be tsim(1)
            3180     1                 !!!    pengwac(jl)=pengwac(jl)-delta_time*(  pfluxw(jl)+pfluxi(jl)        &
            3181     1                 !!!      +prsf(jl)*clw*(tmelt-wtm(nls+1))                    &
            3182     1                 !!!      +pssf(jl)*(alf+csn*(tmelt-tsim(1)))  )
            3183     1                   ELSE
            3184     1                   ! Neglected adveced heat flux
            3185     1                     pengwac(jl)=pengwac(jl)-delta_time*(  pfluxw(jl)+pfluxi(jl)        &
            3186     1                       +pssf(jl)*(alf)  )
            3187     1                   ENDIF
            3188                       !!!  pengw(jl)=pengw(jl)-delta_time*(  pfluxw(jl)+pfluxi(jl) )
            3189                       !!!  pengw2(jl)=pengw2(jl)-delta_time*(  pfluxw(jl)+pfluxi(jl)+pssf(jl)*(alf)  )
            3190                     
            3191     1                   IF (nle.GE.1)THEN
            3192     1                 !     water exists
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3193     1  pp    v            pwtfns(jl)=rhowcw*DOT_PRODUCT(pwtfn(jl,nls+1:nle),hw(nls+1:nle))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3194     1  pp    v            pwsfns(jl)=DOT_PRODUCT(pwsfn(jl,nls+1:nle),hw(nls+1:nle))
            3195     1               !ps
            3196     2                     IF (GDCHK3) then
            3197     2                       WRITE(nerr,*) ", water exist"
            3198     2                       WRITE(nerr,*) "wtfn(",jl,")=",pwtfn(jl,nls:nle)
            3199     2                       WRITE(nerr,*) "hw=",hw(nls+1:nle)
            3200     2                       WRITE(nerr,*) "wtfns(",jl,")=",pwtfns(jl),"wsfns(",jl,")=",pwsfns(jl)
            3201     2                     ENDIF
            3202     1               !ps
            3203     1                   ELSE
            3204     1                 !     soil only
            3205     1                     pwtfns(jl)=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3206     1  pp    v            pwsfns(jl)=DOT_PRODUCT(pwsfn(jl,nls+1:nle),hw(nls+1:nle))
            3207     1                   ENDIF
            3208                       END SUBROUTINE final
            3209                     !----------------------------------------------------------
            3210                       SUBROUTINE acc_flux
            3211                     ! ----------------------------------------------------------------------
            3212                     !
            3213                     !*   accumlate fluxes
            3214                     !
            3215                     ! ----------------------------------------------------------------------
            3216                     !     pfluxiw: net surface heat flux into ocean (W/m2, + upward)
            3217                     !     ppme2: net fresh water into ocean (m/s, + downward)
            3218                     !
            3219                     !
            3220                     !*   14.2 pgrndcapc, pgrndhflx, current, tsw
            3221                     !
            3222                        pgrndhflx(jl)=pgrndhflx(jl)+pgrndhflx_int(jl)*zdtime
            3223                        pgrndflux(jl)=pgrndflux(jl)+pgrndhflx_int(jl)*(1.-pslm(jl))*zdtime
            3224                        pfluxiw(jl)=pfluxiw(jl)+pfluxiw_int(jl)*zdtime
            3225                        ppme2(jl)=ppme2(jl)+ppme2_int(jl)*zdtime
            3226     1                  IF (locn) THEN
            3227     1                    psubfluxw(jl)=psubfluxw(jl)+pwsubflux_int(jl)*zdtime
            3228     1                    pwsubsal(jl)=pwsubsal(jl)+pwsubsal(jl)*zdtime
            3229     1                  ENDIF
            3230                       END SUBROUTINE acc_flux
            3231                     !----------------------------------------------------------
            3232                     SUBROUTINE thermocline(jl,jrow)
            3233                     !!    input from SURF or calling routine
            3234                     !v77  INTEGER LKID ! Ocean ID (Caspian Sea, Great Lake have their own ID)
            3235                     !v77  INTEGER jl  ! Ocean grid (point) ID (In land mask, each ocean grid
            3236                                    !   has its own ID)
            3237                     !v77  INTEGER JL   ! the corresponding longitude ID for jl
            3238                     !v77  INTEGER istep ! the corresponding latitude ID for jl
            3239                     !v77  real:: zdtime   ! time step in sec
            3240                     !v77  INTEGER istep ! (YYMMDDHH) or (MMDDHHMM) an I8 integer to be used in
            3241                     !                Subroutine OUTPUT to add the time stamp of the resut.
            3242                     !!
            3243                     !! INPUT & OUTPUT VARIABLE
            3244                     !!
            3245                     !! Note that, there are two extra variables from SURF
            3246                     !! pfluxw & pdfluxs. It is located in module mo_pgrads in this
            3247                     !! routine. While coupling with ECHAM4, pfluxw and pdfluxs should
            3248                     !! be included in the Calling variables.
            3249                     !
            3250                     !-----------------------------------------------------------------
            3251                     !
            3252                       USE mod_eos_ocean,      ONLY: tmelt, rhoh2o, alf, clw, g, alv, cpd, stbo
            3253                       IMPLICIT NONE
            3254                     !
            3255                     ! 0.0 Calling Variables
            3256                     
            3257                       INTEGER, INTENT(IN):: jl, jrow    ! lonitude and latitude index
            3258                     !-----------------------------------------------------------------
            3259                     ! 1.1 Local Integer
            3260                     
            3261                       INTEGER :: jk
            3262                       INTEGER mas ! mas: AA matrix staring level
            3263                       INTEGER mae ! mae: AA/AAC matrix last level
            3264                       INTEGER iderr ! iderr: error id. See Subroutine lkerr for details.
            3265                       INTEGER irsv  ! irsv: recursive number
            3266                       INTEGER :: levelm,level,levelp
            3267                     !
            3268                       LOGICAL lwf ! lwf: water freeze/ice melt logic at the interface
            3269                       LOGICAL lim ! lim: ice melt logic at the surface
            3270                       LOGICAL lsm ! lsm: snow melt logic at the surface
            3271                     
            3272                     !
            3273                       real, DIMENSION(0:lkvl+5):: X,Y,RHS,SOL
            3274                       real, DIMENSION(0:lkvl+5,3):: AA
            3275                       COMPLEX, DIMENSION(0:lkvl+1)::wumc,pawuflc
            3276                       COMPLEX, DIMENSION(0:lkvl+5)::RHSC,SOLCMPLX
            3277                       COMPLEX, DIMENSION(0:lkvl+5,3)::AAC
            3278                     !
            3279                     ! 1.3 LOCAL VARIABLES
            3280                     !
            3281                       real:: zsoflw ! net solar radiation flux over openwater per water fraction (w/m2) (positive downward)
            3282                       real:: zsofli ! net solar radiation flux over ice sheet per water fraction (w/m2) (positive downward)
            3283                     !v90  real:: emin  !limit min pwtke to 3.0E-5              v78
            3284                       real:: fcew   ! calculate FCE of ice/water interface (ice melt positive)
            3285                       real:: fcei,fces ! potential phase change energy of ice and snow
            3286                       real:: xife   ! ice freezing energy due to liquid water on ice freezed (j/m2)
            3287                       real:: sfe    ! snow freezing energy due to liquid water in snow freezed (j/m2)
            3288                       real:: fcewm,tmp ! temporary working variables. ??M means previous variable.
            3289                       real:: fcewf  ! final phase change energy for water.
            3290                     
            3291                       real:: sfm    ! temporary zsf
            3292                     !  real:: depth
            3293                       REAL::hw1m
            3294                     
            3295                       COMPLEX :: tauc ! tauc: shear stress at the surface (N/m2)
            3296                       COMPLEX :: fr_corc  ! friction and corilois factor (1/s)
            3297                     !
            3298                       real:: totice ! total ice above water (snow+snowfall+ice-sublimation) (m)
            3299                     !
            3300                       !
            3301                       real:: pzsim       !
            3302                       real:: s      ! effective water content
            3303                       real:: hair   ! porosity of snow
            3304                       real:: hi     ! hight of irreducible water content
            3305                     !
            3306                       real:: gzero  ! test of non-solar energy in Equation (12)
            3307                     !!!  real:: g0          ! test of non-solar energy in Equation (12)
            3308                     !
            3309                     !  real:: alphaffn  !Ratio of soalr absorbtion within skin layer, v92
            3310                     !
            3311                       real:: hcoolskin
            3312                     ! thickness of conductive sublayer (m), where only molecular transfer exists (m)
            3313                     !   (Khundzuha et al., 1977; Paulson and Simpson, 1981)
            3314                     !
            3315                     !
            3316                       real:: zcor          ! coriolis force
            3317                       real:: dz            ! distance between two density levels/thickness for freeze (m)
            3318                     
            3319                     
            3320                     !*    2. Initialization
            3321                     !
            3322                     !
            3323                     !
            3324                     !*    2.2 VERTICAL LEVELS (lkvl=11)
            3325                     !
            3326                     !v77      CALL pzcord(LKID,jl,nls,nle,z,zlk,hw,lsoil,lshlw)
            3327                     !!!  CALL pzcord(jl,jrow)  ! bjt 2010/2/21
            3328                     !
            3329                     !     2.3 Initialization
            3330                     !
            3331                     
            3332                     !      pfluxw(jl)=-(pahflw(jl)+pahfsw(jl)+ptrflw(jl)+psoflw(jl))   ! zfluw: positive upward, which is oppsitive to lake subroutine
            3333                           zsf=0.
            3334                     !
            3335                           lwf=.FALSE.
            3336                           lim=.FALSE.
            3337                           lsm=.FALSE.
            3338                     !     default all phase change logics are false
            3339                           irsv = 0   ! recursive number, this is beginning
            3340                     !
            3341                     !     2.4 Store Old Value (Note Soil always at nle+1 level)
            3342                     !
            3343                           pfluxwm=pfluxw(jl)
            3344     1                     if(locaf0) then
            3345     1               !ps        pfluxw2=pfluxw(jl)
            3346     1                       pfluxw2=pfluxw(jl)-(pawtfl0(jl,0)+ocaf0_add)
            3347     1                     else
            3348     1                       pfluxw2=pfluxw(jl)
            3349     1                     endif
            3350                           pfluxim=pfluxi(jl)
            3351                           pfluxi2=pfluxi(jl)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.58, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wtkem, wsm, wvm, wum, wtm
                                   <<< Loop-information  End >>>
            3352        pp    v            wtm(0:lkvl+1)=pwt(jl,0:lkvl+1)
            3353         p    v            wum(0:lkvl+1)=pwu(jl,0:lkvl+1)
            3354         p    v            wvm(0:lkvl+1)=pwv(jl,0:lkvl+1)
            3355         p    v            wsm(0:lkvl+1)=pws(jl,0:lkvl+1)
            3356         p    v            wtkem(0:lkvl+1)=pwtke(jl,0:lkvl+1)
            3357                     
            3358     1                     IF(lsice_nudg.AND.(i_sit_step.EQ.1)) THEN
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3359     1       f               IF(ptsi(jl).NE.xmissing) ptsnic(jl,0:3)=ptsi(jl)
            3360     1                       IF(psni(jl).NE.xmissing) pzsi(jl,0)=psni(jl)
            3361     1                       IF(psiced(jl).NE.xmissing) pzsi(jl,1)=psiced(jl)
            3362     1                     ENDIF
            3363                     !!!      IF(lsit_ice.AND.(i_sit_step.EQ.1)) THEN
            3364                     !!!        IF(ptsi(jl).NE.xmissing) ptsnic(jl,0:3)=ptsi(jl)
            3365                     !!!        IF(psni(jl).NE.xmissing) pzsi(jl,0)=psni(jl)
            3366                     !!!        IF(psiced(jl).NE.xmissing) pzsi(jl,1)=psiced(jl)
            3367                     !!!      ENDIF
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3368             f             tsim(0:3)=ptsnic(jl,0:3)
            3369                     
            3370                           wlvlm=pwlvl(jl)
            3371                           ppme2_int(jl)=0.
            3372     1                     IF (.NOT.lsoil) THEN
            3373     1                       hw1m=hw(nls+1)
            3374     2                       IF (lhd) THEN
            3375     2               !!!          hw(nls+1)=hw(nls+1)+pruntoc(jl)*zdtime/rhoh2o
            3376     2                         hw(nls+1)=hw(nls+1)+pdisch(jl)*zdtime
            3377     2                       ENDIF
            3378     1                     ENDIF
            3379                     !
            3380                     !     calc cold content ccm (J/m2): the energy to melt snow + ice
            3381                     !
            3382     1                     IF (lwaterlevel) THEN
            3383     1                     !! take advected heat flux from snow into account
            3384     1                       ccm=pcc(jl)+ zdtime*(                                           &
            3385     1               &         ( prsf(jl) )*clw*                                  &
            3386     1               &         ( tmelt-ptemp2(jl) ) +                                        &
            3387     1               &         ( pssf(jl) )*                                      &
            3388     1                         ( alf+csn*(tsim(1)-ptemp2(jl)) )                              &
            3389     1                        )
            3390     1               !       Since the advection energy of snowfall has been included in
            3391     1               !       pfluxi2, the calculated Tsn will equal to temp2 (temp of snowfall).
            3392     1                     ELSE
            3393     1                     !! assuming no advected heat flux from snowfall and rainfall
            3394     1                       ccm=( pssf(jl) )*zdtime*( alf ) &
            3395     1                         +pcc(jl)
            3396     1                     ENDIF
            3397                     !-----------------------------------------------------------------
            3398                     !
            3399                     !*    3. Precipitation & Evaporation (Sublimation) Events
            3400                     !
            3401                     !-----------------------------------------------------------------
            3402                       300 CONTINUE
            3403                     !      PRINT *, ", I am in Precipitation & Evaporation Events."
            3404                     !     3.1 Calc total ice above water (soil)
            3405                           totice=pzsi(jl,0)+pzsi(jl,1)&
            3406                     &       +( pssf(jl)+pevapw(jl))*zdtime/rhoh2o
            3407                     !
            3408     1                     IF ((totice-pzsi(jl,1).GT.0.).AND.&
            3409     1               &             ( (pzsi(jl,1).GT.0.).OR.lsoil)&
            3410     1               &                )  THEN
            3411     1               !
            3412     1               !*    3.2 snow over ice/ snow over land
            3413     1               !
            3414     1                       mas=0
            3415     2                       IF (lwaterlevel) THEN
            3416     2                       !! take advected heat flux from snow into account
            3417     2                         pfluxi2=pfluxi2+&
            3418     2               &           ( prsf(jl) )*clw*&
            3419     2               &           (tmelt-ptemp2(jl) ) +&
            3420     2               &           ( pssf(jl) )*csn*&
            3421     2               &           (tsim(1)-ptemp2(jl))
            3422     2               !         Since the advection energy of snowfall has been included in
            3423     2               !         pfluxi2, the calculated Tsn will equal to temp2 (temp of snowfall).
            3424     2                       ENDIF
            3425     1                       pzsi(jl,0)=totice-pzsi(jl,1)
            3426     1                       psilw(jl,0)=psilw(jl,0)+prsf(jl)*zdtime/rhoh2o
            3427     1                     ELSEIF ((totice .GT. 0.).AND.(pzsi(jl,1).GT.0.)) THEN
            3428     1               !
            3429     1               !*    3.3 Ice on top or snow sublimates in this time step completely
            3430     1               !
            3431     1                       mas=2
            3432     2                       IF (lwaterlevel) THEN
            3433     2                       !! take advected heat flux from snow into account
            3434     2                         pfluxi2=pfluxi2                                         &
            3435     2               &          +prsf(jl)*clw*(tmelt-ptemp2(jl))          &
            3436     2               &          +pssf(jl)*                                &
            3437     2               &           ( csn*(tmelt-ptemp2(jl))                              &
            3438     2               &               +cice*(tsim(3)-tmelt) )                           &
            3439     2               &          +pzsi(jl,0)*rhoh2o/zdtime*                             &
            3440     2               &           ( csn*(tmelt-tsim(1))+cice*(tsim(3)-tmelt) )
            3441     2                       ELSE
            3442     2                         pfluxi2=pfluxi2                                         &
            3443     2               &          +pzsi(jl,0)*rhoh2o/zdtime*                             &
            3444     2               &           ( csn*(tmelt-tsim(1))+cice*(tsim(3)-tmelt) )
            3445     2                       ENDIF
            3446     1                       pzsi(jl,1)=totice
            3447     1               !       merge snow, snowfall into ice & assume sublimation only
            3448     1                       psilw(jl,1)=psilw(jl,1)+psilw(jl,0)&
            3449     1               &         +prsf(jl)*zdtime/rhoh2o
            3450     1               !       If there was snow, reset snow progonastic variables & ptsw.
            3451     2                       IF (pzsi(jl,0).GT.0.) THEN
            3452     2                         pzsi(jl,0)=0.
            3453     2                         psilw(jl,0)=0.
            3454     2               !!!          ptsnic(jl,0)=tmelt
            3455     2               !!!          ptsnic(jl,1)=tmelt
            3456     2               !!! set to be undeneath temp instead (v7.7)
            3457     2                       ENDIF
            3458     1                     ELSE
            3459     1               !
            3460     1               !*    3.4 Water/Soil on top, snow & ice sublimate completely in this
            3461     1               !         time step, or snow on water
            3462     1               !         starting level
            3463     1                       mas=4
            3464     2                       IF (.NOT.lsoil) THEN
            3465     2               !       water on top (Normal & Shallow Water)
            3466     2               !         ref temp of water (1st layer water temp)
            3467     2                         tmp=wtm(nls+1)
            3468     2                       ELSE
            3469     2               !       soil on top
            3470     2               !         ref temp of soil (soil skin temp)
            3471     2                         tmp=wtm(nle+1)
            3472     2                       ENDIF
            3473     2                       IF (lwaterlevel) THEN
            3474     2                       !! take advected heat flux from snow into account
            3475     2               #ifdef DEBUG
            3476     2                       if(GDCHK2) print*,"ps: 3.4.0 pfluxw2=",pfluxw2
            3477     2               #endif
            3478     2                         pfluxw2=pfluxi2+pfluxw2                                      &
            3479     2               &           +( prsf(jl) )*clw*                              &
            3480     2               &              (tmp-ptemp2(jl))                                        &
            3481     2               &           +( pssf(jl) )*                                  &
            3482     2               &                ( alf+csn*(tmelt-ptemp2(jl))                          &
            3483     2               &                     +clw*(tmp-tmelt) )                               &
            3484     2               &           +pzsi(jl,0)*rhoh2o/zdtime*                                 &
            3485     2               &                ( alf+csn*(tmelt-tsim(1))+clw*(tmp-tmelt) )           &
            3486     2               &           +psilw(jl,0)*rhoh2o/zdtime* clw*(tmp-tmelt)                &
            3487     2               &           +pzsi(jl,1)*rhoh2o/zdtime*                                 &
            3488     2               &                ( alf+cice*(tmelt-tsim(3))+clw*(tmp-tmelt) )          &
            3489     2               &           +psilw(jl,1)*rhoh2o/zdtime*clw*(tmp-tmelt)
            3490     2               #ifdef DEBUG
            3491     2                      if(GDCHK2) print*,"ps: 3.4.1 pfluxi2=",pfluxi2,",prsf(jl)=",prsf(jl),",pssf(jl)=",pssf(jl)
            3492     2                      if(GDCHK2) print*,"ps: 3.4.1 tmp=",tmp,",ptemp2(jl)=",ptemp2(jl),",clw=",clw
            3493     2                      if(GDCHK2) print*,"ps: 3.4.1 alf=",alf,",csn=",csn,",tmelt=",tmelt,",rhoh2o/zdtime=",rhoh2o/zdtime
            3494     2                      if(GDCHK2) print*,"ps: 3.4.1 psilw(jl,0)=",psilw(jl,0),",psilw(jl,1)=",psilw(jl,1)
            3495     2                      if(GDCHK2) print*,"ps: 3.4.1 pzsi(jl,0)=",pzsi(jl,0),",pzsi(jl,1)=",pzsi(jl,1),",cice=",cice
            3496     2                      if(GDCHK2) print*,"ps: 3.4.1 tsim(1)=",tsim(1),",tsim(3)=",tsim(3)
            3497     2                      if(GDCHK2) print*,"ps: 3.4.1 pfluxw2=",pfluxw2
            3498     2               #endif
            3499     2                       ELSE
            3500     2               #ifdef DEBUG
            3501     2                       if(GDCHK2) print*,"ps: 3.4.2 pfluxw2=",pfluxw2
            3502     2               #endif
            3503     2                         pfluxw2=pfluxi2+pfluxw2                                      &
            3504     2               &           +( pssf(jl) )* alf                              &
            3505     2               &           +pzsi(jl,0)*rhoh2o/zdtime*                                 &
            3506     2               &                ( alf+csn*(tmelt-tsim(1))+clw*(tmp-tmelt) )           &
            3507     2               &           +psilw(jl,0)*rhoh2o/zdtime* clw*(tmp-tmelt)                &
            3508     2               &           +pzsi(jl,1)*rhoh2o/zdtime*                                 &
            3509     2               &                ( alf+cice*(tmelt-tsim(3))+clw*(tmp-tmelt) )          &
            3510     2               &           +psilw(jl,1)*rhoh2o/zdtime*clw*(tmp-tmelt)
            3511     2               #ifdef DEBUG
            3512     2                      if(GDCHK2) print*,"ps: 3.4.3 pfluxi2=",pfluxi2,",prsf(jl)=",prsf(jl),",pssf(jl)=",pssf(jl)
            3513     2                      if(GDCHK2) print*,"ps: 3.4.3 tmp=",tmp,",ptemp2(jl)=",ptemp2(jl),",clw=",clw
            3514     2                      if(GDCHK2) print*,"ps: 3.4.3 alf=",alf,",csn=",csn,",tmelt=",tmelt,",rhoh2o/zdtime=",rhoh2o/zdtime
            3515     2                      if(GDCHK2) print*,"ps: 3.4.3 psilw(jl,0)=",psilw(jl,0),",psilw(jl,1)=",psilw(jl,1)
            3516     2                      if(GDCHK2) print*,"ps: 3.4.3 pzsi(jl,0)=",pzsi(jl,0),",pzsi(jl,1)=",pzsi(jl,1),",cice=",cice
            3517     2                      if(GDCHK2) print*,"ps: 3.4.3 tsim(1)=",tsim(1),",tsim(3)=",tsim(3)
            3518     2                      if(GDCHK2) print*,"ps: 3.4.3 pfluxw2=",pfluxw2
            3519     2               #endif
            3520     2                       ENDIF
            3521     1                       pfluxi2=0.
            3522     1               !         includes advection flux (positive upward)
            3523     1               !         assume precipitation temperature is temp2 &
            3524     1               !         snowfall melted released latent heat
            3525     1               !         assume wtm(nls+1) is the temperature of outflow
            3526     1               !         merge snow/ice layers into water
            3527     1               !
            3528     2                       IF (.NOT.lsoil) THEN
            3529     2                         hw(nls+1)=hw(nls+1)+&
            3530     2               &           (prsf(jl)+pssf(jl)+pevapw(jl))*zdtime/rhoh2o&
            3531     2               &           +pzsi(jl,0)+psilw(jl,0)+pzsi(jl,1)+psilw(jl,1)
            3532     3                         IF (.FALSE.) THEN
            3533     3                           zsf=zsf+(MAX(hw(nls+1),0.)-hw1m)*wsm(nls+1)
            3534     3                         ELSE
            3535     3                           zsf=zsf+&
            3536     3               &             ((prsf(jl)+pssf(jl)+pevapw(jl))*zdtime/rhoh2o+pzsi(jl,0)+psilw(jl,0))*wsm(nls+1)&
            3537     3               &             +(pzsi(jl,1)+psilw(jl,1))*salti*wsm(nls+1)
            3538     3                         ENDIF
            3539     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 1  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3540     3                         DO WHILE (hw(nls+1).LE.0.AND.nle.GE.nls+2)
            3541     3                           hw1m=hw(nls+2)
            3542     4                           IF ((nle-nls).EQ.2) THEN
            3543     4                             hw(nls+2)=MAX(hw1m+hw(nls+1),wcri)
            3544     4               !             preserve wcri for shallow water mode
            3545     4               !             Although it is improper for water conservation,
            3546     4               !             it's important for salinity conservation.
            3547     4                           ELSE
            3548     4                             hw(nls+2)=hw1m+hw(nls+1)
            3549     4                           ENDIF
            3550     3                           zsf=zsf+(MAX(hw(nls+2),0.)-hw1m)*wsm(nls+2)
            3551     3                           hw(nls+1)=0.
            3552     3                           nls=nls+1
            3553     3                         ENDDO
            3554     3                         IF ((nle-nls).EQ.1) THEN
            3555     3                           lshlw = .TRUE.
            3556     3               !           shallow water body
            3557     3                         ENDIF
            3558     2               !       the minmum thickness of wcri is reserved to perserve
            3559     2               !       salinity conservation.
            3560     2                       ELSE
            3561     3                         IF (lwaterlevel) THEN
            3562     3                           pwlvl(jl)=pwlvl(jl)+&
            3563     3               &             (prsf(jl)+pssf(jl)+pevapw(jl))*zdtime/rhoh2o&
            3564     3               &             +pzsi(jl,0)+psilw(jl,0)+pzsi(jl,1)+psilw(jl,1)
            3565     3                         ENDIF
            3566     2                       ENDIF
            3567     1               !
            3568     1               !       If there was snow or ice, reset snow/ice progonastic
            3569     1               !       variables & ptsw.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3570     2       f               IF (SUM(pzsi(jl,0:1))+SUM(psilw(jl,0:1)).GT.0.) THEN
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3571     2       f                 pzsi(jl,:)=0.
            3572     2       f                 psilw(jl,:)=0.
            3573     2               !!!          ptsnic(jl,:)=tmelt
            3574     2               !!!          ptsnic(jl,:)=tmelt
            3575     2               !!! set to be undeneath temp instead (v7.7)
            3576     2                       ENDIF
            3577     1                     ENDIF
            3578                     
            3579                     !*    3.42 Calculate Effective thickness of snow and ice. Note the the effective thickness can
            3580                     !         be zero although its physcial thickness is not due to numerical error.
            3581                     
            3582          i                CALL update_snow_ice_property(pzsi(jl,0),pzsi(jl,1),hsn,hesn,hice,heice,pseaice(jl))
            3583                     
            3584                     
            3585                           !!! hsn=HSNFN(pzsi(jl,0))
            3586                           !!! hesn=HEFN(hsn/4.,xksn,omegas)
            3587                           !!! hice=HICEFN(pzsi(jl,1))
            3588                           !!! heice=HEFN(hice/4.,xkice,omegas)
            3589                           !!! pseaice(jl)=SEAICEFN(pzsi(jl,1))
            3590                     !
            3591                     !*    3.5 Determine Solar radaition on Water. This value is fixed at
            3592                     !         current stage to prevent recursive. The model might not be
            3593                     !         able to determine icemelt or water freeze IF it change
            3594                     !         accordingly.
            3595                     !
            3596                     !     surface net solar radiation flux over water
            3597                     !
            3598                     
            3599     1                     IF ( (heice.LE.xicri).AND.(hesn.LE.csncri) ) THEN
            3600     1               !     no/or only thin snow and ice on top
            3601     1                       zsoflw=psofli(jl)+psoflw(jl)
            3602     1                       zsofli=0.
            3603     1                     ELSE
            3604     1                       zsoflw=psoflw(jl)
            3605     1                       zsofli=psofli(jl)
            3606     1                     ENDIF
            3607                     
            3608     1                     IF (mas.EQ.0) THEN
            3609     1               ! ----------------------------------------------------------------------
            3610     1               !
            3611     1               !*    4. Snow & Ice Melt Runoff
            3612     1               !        Calc Liquid Water Balance in Snow
            3613     1               !        One-time step is assumed to allow liquid water becoming runoff
            3614     1               !        before it refreezes.
            3615     1               !
            3616     1               ! ----------------------------------------------------------------------
            3617     1                 400 CONTINUE
            3618     1               !      PRINT *, ", I am in PAHSE Change Energy."
            3619     1               !
            3620     1               !*    4.1 Chk consistency
            3621     1               !
            3622     2                       IF (hesn.LE.csncri) THEN
            3623     2               !       Small value of snow thickness. Assume all liquid water becoming
            3624     2               !       runoff to prevent numerical error.
            3625     2                         psilw(jl,1)=psilw(jl,1)+MAX(psilw(jl,0),0.)
            3626     2               !         reset snow progonastic variables
            3627     2                         psilw(jl,0)=0.
            3628     2                       ELSE
            3629     2               !
            3630     2               !     4.2 Calc porosity (hair), irreducible water content (hi),
            3631     2               !         effective water content (s)
            3632     2               !
            3633     2               !         Calc porosity
            3634     2                         hair=pzsi(jl,0)*(rhoh2o/rhosn-rhoh2o/rhoice)
            3635     2               !         irreducible water content
            3636     2               !         csi=0.03-0.07. A value of 0.05 is used
            3637     2               !         hi = hight of irreducible water content
            3638     2                         hi = 0.05*hair
            3639     2               !     4.3 Chk water content > irreducible water content?
            3640     3                         IF (psilw(jl,0).GE.hi) THEN
            3641     4                           IF( psilw(jl,0).LT.hair) THEN
            3642     4                             s=(psilw(jl,0)-hi)/(hair-hi)
            3643     4                           ELSE
            3644     4               !             more liquid water than porosity
            3645     4               !             assume it becomes runoff & store in ice layer
            3646     4                             psilw(jl,1)=psilw(jl,1)+(psilw(jl,0)-hair)
            3647     4                             psilw(jl,0)=hair
            3648     4                             s=1.
            3649     4                           ENDIF
            3650     3               !!
            3651     3               !!    4.4 Calc Runoff (tmp) according to Darcy's Law (Shimizu's Formula)
            3652     3               !!
            3653     3                           tmp=MIN(5.47E6*(0.077*0.9E-3**2)*&
            3654     3               &               Exp(-7.8*rhosn/rhoh2o)*s**3*rhoh2o*zdtime,&
            3655     3               &               psilw(jl,0)-hi)
            3656     3               !           where grain size of 0.9E-3 M is assumed.
            3657     3               !           DTY*G/MU=ALPHA=5.47E6
            3658     3                           psilw(jl,0)=psilw(jl,0)-tmp
            3659     3                           psilw(jl,1)=psilw(jl,1)+tmp
            3660     3                         ELSE
            3661     3               !           water content less than irreducible water content. No runoff.
            3662     3                         ENDIF
            3663     2                       ENDIF
            3664     1                     ENDIF
            3665                     !
            3666     1                     IF(mas.LE.2) THEN
            3667     1               ! ----------------------------------------------------------------------
            3668     1               !
            3669     1               !*    5. Calc Liquid Water Balance in Ice
            3670     1               !
            3671     1               ! ----------------------------------------------------------------------
            3672     1               !     5.1 Chk LAGER THAN MAX WATER ON THE TOP OF ICE LAYER
            3673     1               !
            3674     2                       IF (heice.GT.xicri) THEN
            3675     3                         IF (psilw(jl,1).GT.wicemx) THEN
            3676     3               !           ice melt runoff occurs
            3677     4                           IF(.NOT.lsoil) THEN
            3678     4                             hw(nls+1)=hw(nls+1)+psilw(jl,1)-wicemx
            3679     4                             zsf=zsf+(psilw(jl,1)-wicemx)*salti*wsm(nls+1)
            3680     4                           ELSE
            3681     5                             IF(lwaterlevel) THEN
            3682     5                               pwlvl(jl)=pwlvl(jl)+psilw(jl,1)-wicemx
            3683     5                             ENDIF
            3684     4                           ENDIF
            3685     3                           psilw(jl,1)=wicemx
            3686     3                         ENDIF
            3687     2                       ENDIF
            3688     1                     ENDIF
            3689                     !
            3690                     ! ----------------------------------------------------------------------
            3691                     !
            3692                     !*    6. Determine phase change energy of snow and ice & modify snow & ice
            3693                     !        thickness due to refreezing of liquid water. Assume the refreezing
            3694                     !        occurs at the center (not surface) of snow, and at the surface of
            3695                     !        ice. The refreezing will change temperature profiles, which will
            3696                     !        be evaluated in section 8. Note that, putting this routine after
            3697                     !        section 6 implies allowing one time step for snow and ice melt
            3698                     !        becoming runoff before it might refreeze in this section.
            3699                     !
            3700                     ! ----------------------------------------------------------------------
            3701                     !
            3702                       600 CONTINUE
            3703                     !      PRINT *, "I am update SN & ICE due to refreeze."
            3704                     !     6.1 Snow
            3705                     
            3706     1                     IF ( (tsim(1).LT.tmelt).AND.(psilw(jl,0).GT.0.) ) THEN
            3707     1                       sfe=MIN( (tmelt-tsim(1))*rhoh2o*pzsi(jl,0)*csn,&
            3708     1               &         psilw(jl,0)*rhoh2o*alf)
            3709     1               !       refreezing amount
            3710     1                       pzsi(jl,0)=pzsi(jl,0)+sfe/rhoh2o/alf
            3711     1                       !!! hsn=HSNFN(pzsi(jl,0))
            3712     1                       !!! hesn=HEFN(hsn/4.,xksn,omegas)
            3713     1                       psilw(jl,0)=MAX(psilw(jl,0)-sfe/rhoh2o/alf,0.)
            3714     1                     ELSE
            3715     1                       sfe=0.
            3716     1                     ENDIF
            3717                     !
            3718                     !     6.2 Ice
            3719                     !
            3720                      620  CONTINUE
            3721     1                     IF ((psilw(jl,1).GT.0.).AND.(heice.GT.xicri)) THEN
            3722     2                       IF (pzsi(jl,0).GT. csncri) THEN
            3723     2                         xife=&
            3724     2               &           +zdtime*rhosn*csn*xksn*(-(tsim(1)-tmelt) )&
            3725     2               &             /(0.5*hsn/pseaice(jl))&
            3726     2               &           +zdtime*rhoh2o*cice*xkice*(tmelt-tsim(3))&
            3727     2               &             /(pzsi(jl,1)*rhoh2o/rhoice/2.)
            3728     2                       ELSE
            3729     2                         xife=&
            3730     2               &           +zdtime*rhoh2o*cice*xkice*(tmelt-tsim(3))&
            3731     2               &             /(pzsi(jl,1)*rhoh2o/rhoice/2.)
            3732     2                       ENDIF
            3733     1                       xife=MIN( xife, psilw(jl,1)*rhoh2o*alf)
            3734     1               !       refreezing amount
            3735     1                       pzsi(jl,1)=pzsi(jl,1)+xife/rhoh2o/alf
            3736     1                       !!! hice=HICEFN(pzsi(jl,1))
            3737     1                       !!! heice=HEFN(hice/4.,xkice,omegas)
            3738     1                       psilw(jl,1)=MAX(psilw(jl,1)-xife/rhoh2o/alf,0.)
            3739     1                     ELSE
            3740     1                       xife=0.
            3741     1                     ENDIF
            3742          i                CALL update_snow_ice_property(pzsi(jl,0),pzsi(jl,1),hsn,hesn,hice,heice,pseaice(jl))
            3743                     
            3744                     
            3745                     !
            3746                     !-----------------------------------------------------------------
            3747                     !
            3748                     !*    7.  COMPUTE eddy mixing coeff. pwkm, pwlmx, pwldisp
            3749                     !
            3750                     !-----------------------------------------------------------------
            3751                       700 CONTINUE
            3752                     !      PRINT *, ", I am in computing eddy diffusivity."
            3753                     !
            3754                           CALL eddy(hcoolskin,utauw,wtkem,wtm,wsm)
            3755                     !
            3756                     !-----------------------------------------------------------------
            3757                     !
            3758                     !*    8. PREPARE T MATRIX
            3759                     !
            3760                     !-----------------------------------------------------------------
            3761                       800 CONTINUE
            3762                     !      PRINT *, ", I am in Prepare T matrix."
            3763                     !
            3764                     !       first level matrix updated by this routine
            3765                     !
            3766                     !*    8.1 SNOW LAYER
            3767                     !
            3768                     !!! (v7.7)
            3769                     !!!
            3770                       810 CONTINUE
            3771                     !!!
            3772                     !!!  810 IF ( mas.EQ.0) THEN
            3773                     !     snow exists
            3774     1                     IF (hesn.GT.csncri) THEN
            3775     1               !     thick snow
            3776     1                       Y(0) = zdtime/hesn*xksn/(0.5*hsn/pseaice(jl))
            3777     1                       RHS(0)= tsim(0)-(1.-beta)*Y(0)*(tsim(0)-tsim(1))&
            3778     1               &         +zdtime*( -pfluxi2+pdfluxs(jl)*tsim(0) )/rhosn/csn/hesn
            3779     1                       AA(0,1)=0.
            3780     1                       AA(0,3)=-beta*Y(0)
            3781     1                       AA(0,2)= 1.+zdtime*pdfluxs(jl)/rhosn/csn/hesn                        &
            3782     1               &          - AA(0,1) - AA(0,3)
            3783     1               !       First Layer
            3784     1                       Y(1) = zdtime/hsn*xksn/(0.5*hsn/pseaice(jl))
            3785     1                       X(1)= Y(1)
            3786     1                       RHS(1)= tsim(1)-hesn/hsn*tsim(0) &
            3787     1               &         +sfe/rhosn/csn/hsn+(1.-beta)*&
            3788     1               &         ( X(1)*(tsim(0)-tsim(1))-Y(1)*(tsim(1)-tsim(2)) )
            3789     1                       AA(1,1)=-beta*X(1)-hesn/hsn
            3790     1                       AA(1,3)=-beta*Y(1)
            3791     1                       AA(1,2)= 1. +beta*X(1)+beta*Y(1)
            3792     1               !
            3793     1               #ifdef DEBUG
            3794     1                       if(GDCHK2) print *,"ps: 810 thick, zdtime=",zdtime,", hesn=",hesn,", hsn=",hsn
            3795     1                       if(GDCHK2) print *,"ps: 810 thick, pseaice(jl)=", pseaice(jl),",tsim(0)=", tsim(0)
            3796     1                       if(GDCHK2) print *,"ps: 810 thick, beta=",beta,", tsim(1)=", tsim(1)
            3797     1                       if(GDCHK2) print *,"ps: 810 thick, pfluxi2=", pfluxi2, ",pdfluxi(jl)=",pfluxi(jl)
            3798     1                       if(GDCHK2) print *,"ps: 810 thick, rhosn=",rhosn,", csn=",csn,", xksn=",xksn,", sfe=",sfe
            3799     1               #endif
            3800     1                     ELSE
            3801     1               !     thin snow
            3802     1               !     assume snow temperature equals to the temperature underneath
            3803     1                       RHS(0)=0.
            3804     1                       AA(0,1)=0.
            3805     1                       AA(0,3)=-1.
            3806     1                       AA(0,2)=1.
            3807     1               !
            3808     1                       RHS(1)=0.
            3809     1                       AA(1,1)=0.
            3810     1                       AA(1,3)=-1.
            3811     1                       AA(1,2)=1.
            3812     1               #ifdef DEBUG
            3813     1                       if(GDCHK2) print *,"ps: 810 thin"
            3814     1               #endif
            3815     1                     ENDIF
            3816                     !!! (v7.7)
            3817                     !!!      ENDIF
            3818                     !
            3819                     !*    8.2 ICE LAYER
            3820                     !
            3821                       820 CONTINUE
            3822                     !!!
            3823                     !!!  820 IF (mas.LE.2) THEN
            3824     1                     IF (heice.GT.xicri) THEN
            3825     1               !     thick ice
            3826     2                       IF (hesn.GT.csncri) THEN
            3827     2               !       thick snow on top
            3828     2               !          hsn=HSNFN(pzsi(jl,0))
            3829     2                         X(2) = zdtime/(rhoice*cice*heice)*&
            3830     2               &           (rhosn*csn*xksn)/(0.5*hsn/pseaice(jl))
            3831     2                         Y(2) = zdtime/heice*xkice/(0.5*hice/pseaice(jl))
            3832     2                         RHS(2)= tsim(2)+(1.-beta)*&
            3833     2               &           ( X(2)*(tsim(1)-tsim(2))-Y(2)*(tsim(2)-tsim(3)) )&
            3834     2               &           +xife/rhoice/cice/heice
            3835     2                         AA(2,1)=-beta*X(2)
            3836     2                         AA(2,3)=-beta*Y(2)
            3837     2                         AA(2,2)= 1. - AA(2,1) - AA(2,3)
            3838     2               #ifdef DEBUG
            3839     2                       if(GDCHK2) print *,"ps: 820 thick, zdtime=",zdtime,", rhoice=",rhoice,", cice=",cice,", heice=",heice
            3840     2                       if(GDCHK2) print *,"ps: 820 thick, pseaice(jl)=", pseaice(jl),", beta=",beta
            3841     2                       if(GDCHK2) print *,"ps: 820 thick, tsim(1)=", tsim(1),", tsim(2)=", tsim(2),", tsim(3)=", tsim(3)
            3842     2                       if(GDCHK2) print *,"ps: 820 thick, hsn=",hsn
            3843     2                       if(GDCHK2) print *,"ps: 820 thick, rhosn=",rhosn,", csn=",csn,", xksn=",xksn,", xife=",xife
            3844     2               #endif
            3845     2                       ELSE
            3846     2               !       thin snow or no snow on top
            3847     2                         Y(2) = zdtime/heice*xkice/(0.5*hice/pseaice(jl))
            3848     2                         RHS(2)= tsim(2)-(1.-beta)*Y(2)*(tsim(2)-tsim(3))               &
            3849     2                           +(  rhosn*csn*hsn*tsim(1)                                      &
            3850     2                               +zdtime*(-pfluxi2+pdfluxs(jl)*tsim(2))+xife  )              &
            3851     2                            /rhoice/cice/heice
            3852     2                         AA(2,1)=0.
            3853     2                         AA(2,3)=-beta*Y(2)
            3854     2                         AA(2,2)=1.-AA(2,1)-AA(2,3)                                     &
            3855     2                           +(rhosn*csn*hsn+zdtime*pdfluxs(jl))/rhoice/cice/heice
            3856     2               #ifdef DEBUG
            3857     2                       if(GDCHK2) print *,"ps: 820 thin, zdtime=",zdtime,", heice=",heice,", xkice=",xkice,", hice=",hice
            3858     2                       if(GDCHK2) print *,"ps: 820 thin, pseaice(jl)=", pseaice(jl),", beta=",beta
            3859     2                       if(GDCHK2) print *,"ps: 820 thin, tsim(1)=", tsim(1),", tsim(2)=", tsim(2),", tsim(3)=", tsim(3)
            3860     2                       if(GDCHK2) print *,"ps: 820 thin, hsn=",hsn,", pfluxi2=", pfluxi2, ",pdfluxi(jl)=",pfluxi(jl)
            3861     2                       if(GDCHK2) print *,"ps: 820 thin, rhosn=",rhosn,", csn=",csn,", xksn=",xksn,", xife=",xife
            3862     2               #endif
            3863     2               !
            3864     2                       ENDIF
            3865     1               !       First Layer
            3866     1                       Y(3) = zdtime/hice*xkice/(0.5*hice/pseaice(jl))
            3867     1                       X(3)= Y(3)
            3868     1                       RHS(3)= tsim(3)-heice/hice*tsim(2)+(1.-beta)*&
            3869     1               &         ( X(3)*(tsim(2)-tsim(3))-Y(3)*(tsim(3)-wtm(0)) )
            3870     1                       AA(3,1)=-beta*X(3)-heice/hice
            3871     1                       AA(3,3)=-beta*Y(3)
            3872     1                       AA(3,2)= 1. +beta*X(3)+beta*Y(3)
            3873     1               #ifdef DEBUG
            3874     1                       if(GDCHK2) print *,"ps: 820 first, wtm(0)=", wtm(0)
            3875     1               #endif
            3876     1                     ELSE
            3877     1               !     thin ice
            3878     1               !     assume ice temperature equals to the temperature underneath
            3879     1                       RHS(2)=0.
            3880     1                       AA(2,1)=0.
            3881     1                       AA(2,3)=-1.
            3882     1                       AA(2,2)=1.
            3883     1               !
            3884     1                       RHS(3)=0.
            3885     1                       AA(3,1)=0.
            3886     1                       AA(3,3)=-1.
            3887     1                       AA(3,2)=1.
            3888     1               #ifdef DEBUG
            3889     1                       if(GDCHK2) print *,"ps: 820 else"
            3890     1               #endif
            3891     1                     ENDIF
            3892                     !!!      ENDIF
            3893                     !
            3894                     !*    8.3 WATER & SOIL LAYER
            3895                     !
            3896     1                 830 IF (.NOT.lsoil) THEN
            3897     1                 !
            3898     1                 !*   Total Fresh Water Inflow = (pwlvl(jl)-wlvlm)/zdtime
            3899     1                 !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3900     1  pp    v              ppme2_int(jl)=ppme2_int(jl)+(pbathy(jl)+SUM(hw(nls+1:nle))-wlvlm)/zdtime
            3901     2                       IF (lwaterlevel) THEN
            3902     2                         pwlvl(jl)=pbathy(jl)+SUM(hw(nls+1:nle))
            3903     2                       ELSE
            3904     2                       ! restore back to original water level, and associtaed hw
            3905     2                         pwlvl(jl)=wlvlm
            3906     2                       ENDIF
            3907     1                       CALL pzcord(pwlvl(jl),pbathy(jl),nls,nle,z,zlk,hw,lsoil,lshlw)  ! bjt 2010/2/21
            3908     1               !
            3909     1                       CALL LKDIFKH(hew,X,Y)
            3910     1               !       Skin layer
            3911     2                       IF (lssst) THEN
            3912     3                         IF ( (hesn.LE.csncri).AND.(heice.LE.xicri)) THEN
            3913     3               !           water on top or only thin snow/ice layer exists
            3914     3                           RHS(4)= wtm(0)-(1.-beta)*Y(4)*(wtm(0)-wtm(nls+1))              &
            3915     3                                   +(  rhosn*csn*hsn*tsim(1)+rhoice*cice*hice*tsim(3)        &
            3916     3                                   +zdtime*( zsoflw*(FFN(0.)-FFN(zlk(nls+1)-pwlvl(jl)))   &
            3917     3                                     -(pfluxw2+zsoflw)+pdfluxs(jl)*wtm(0) )                  &
            3918     3                                    )/rhoh2o/clw/hew+zdtime*pawtfl(jl,0)
            3919     3                           AA(4,1)=0.
            3920     3                           AA(4,3)=-beta*Y(4)
            3921     3                           AA(4,2)= 1.-AA(4,1)-AA(4,3)                                    &
            3922     3                                   +(  rhosn*csn*hsn+rhoice*cice*hice+zdtime*pdfluxs(jl)  )  &
            3923     3                                   /rhoh2o/clw/hew
            3924     3               #ifdef DEBUG
            3925     3                       if(GDCHK2) print *,"ps: 830 .1, Y(4)=",Y(4)
            3926     3                       if(GDCHK2) print *,"ps: 830 .1, nls=",nls,", wtm(0)=",wtm(0),", wtm(nls+1)=",wtm(nls+1)
            3927     3                       if(GDCHK2) print *,"ps: 830 .1, zdtime=",zdtime,", hice=",hice,", zsoflw=",zsoflw
            3928     3                       if(GDCHK2) print *,"ps: 830 .1, zlk(nls+1)=",zlk(nls+1),", pwlvl(jl)=", pwlvl(jl)
            3929     3                       if(GDCHK2) print *,"ps: 830 .1, beta=", beta,", tsim(3)=", tsim(3),", rhoice=",rhoice,", cice=",cice
            3930     3                       if(GDCHK2) print *,"ps: 830 .1, hsn=",hsn,", pfluxw2=", pfluxw2, ",pdfluxw(jl)=",pfluxw(jl)
            3931     3                       if(GDCHK2) print *,"ps: 830 .1, rhosn=",rhosn,", csn=",csn,", rhoh2o=",rhoh2o,", clw=",clw,", hew=",hew
            3932     3               #endif
            3933     3               !!!           IF (lsit_lw) THEN
            3934     3               !!!             AA(4,3)=AA(4,3)-4.*stbo*zdtime*wtm(nls+1)**3/rhoh2o/clw/hew
            3935     3               !!!             AA(4,2)=AA(4,2)+4.*stbo*zdtime*wtm(0)**3/rhoh2o/clw/hew
            3936     3               !!!           ENDIF
            3937     3                         ELSE
            3938     3               !         thick ice or thick snow on top
            3939     3               !           set pwt(0) =pctfreez2(jl)
            3940     3                           RHS(4)= pctfreez2(jl)
            3941     3                           AA(4,1)=0.
            3942     3                           AA(4,3)=0.
            3943     3                           AA(4,2)=1. - AA(4,1) - AA(4,3)
            3944     3               #ifdef DEBUG
            3945     3                           if(GDCHK2) print *,"ps: 830 .2"
            3946     3               #endif
            3947     3                         ENDIF
            3948     2               
            3949     2                       ELSE
            3950     2               !         Without skin layer, skin temperature = first layer temperature
            3951     2               !         so AA(4,3)=-1 & AA(4,2)= 1.
            3952     2                         RHS(4)=0.
            3953     2                         AA(4,1)=0.
            3954     2                         AA(4,3)=-1.
            3955     2                         AA(4,2)= 1.
            3956     2                       ENDIF
            3957     1               !       First Layer
            3958     1                       jk = 1
            3959     2                       IF (lssst) THEN
            3960     2                         RHS(4+jk)= wtm(nls+jk)-hew/hw(nls+jk)*wtm(0)+(1.-beta)*                &
            3961     2                             ( X(4+jk)*(wtm(0)-wtm(nls+jk))-Y(4+jk)*(wtm(nls+jk)-wtm(nls+jk+1)) )  &
            3962     2                           +zdtime*(                                                               &
            3963     2                             zsoflw*( FFN(zlk(nls+jk)-pwlvl(jl))-FFN(zlk(nls+jk+1)-pwlvl(jl)) )    &
            3964     2                               /rhoh2o/clw/hw(nls+jk)                                              &
            3965     2                             +pawtfl(jl,nls+jk)                     &
            3966     2                             )
            3967     2               
            3968     2                         AA(4+jk,1)=-beta*X(4+jk)-hew/hw(nls+jk)
            3969     2                         AA(4+jk,3)=-beta*Y(4+jk)
            3970     2                         AA(4+jk,2)= 1. +beta*X(4+jk)+beta*Y(4+jk)
            3971     3                         IF (lsit_lw) THEN
            3972     3                           AA(4+jk,3)=AA(4+jk,3)-4.*stbo*zdtime*wtm(nls+jk+1)**3/rhoh2o/clw/hw(nls+jk)
            3973     3                           AA(4+jk,2)=AA(4+jk,2)+4.*stbo*zdtime*wtm(nls+jk)**3/rhoh2o/clw/hw(nls+jk)
            3974     3                         ENDIF
            3975     2               #ifdef DEBUG
            3976     2                       if(GDCHK2) print *,"ps: 830 .3, jk=",jk
            3977     2                       if(GDCHK2) print *,"ps: 830 .3, X(4+jk)=",X(4+jk),", Y(4+jk)=",Y(4+jk)
            3978     2                       if(GDCHK2) print *,"ps: 830 .3, nls=",nls,", wtm(0)=",wtm(0),", wtm(nls+jk)=",wtm(nls+jk),", wtm(nls+jk+1)=",wtm(nls+jk+1)
            3979     2                       if(GDCHK2) print *,"ps: 830 .3, zdtime=",zdtime,", zsoflw=",zsoflw,", hew=",hew
            3980     2                       if(GDCHK2) print *,"ps: 830 .3, FFN(zlk(nls+jk)-pwlvl(jl))=",FFN(zlk(nls+jk)-pwlvl(jl)),", FFN(zlk(nls+jk+1)-pwlvl(jl))=",FFN(zlk(nls+jk+1)-pwlvl(jl))
            3981     2                       if(GDCHK2) print *,"ps: 830 .3, beta=", beta,", hw(nls+jk)=", hw(nls+jk)
            3982     2                       if(GDCHK2) print *,"ps: 830 .3, pawtfl(jl,nls+jk)=", pawtfl(jl,nls+jk)
            3983     2                       if(GDCHK2) print *,"ps: 830 .3, pawtfl0(jl,nls+jk)=", pawtfl0(jl,nls+jk)
            3984     2                       if(GDCHK2) print *,"ps: 830 .3, rhosn=",rhosn,", csn=",csn,", rhoh2o=",rhoh2o,", clw=",clw
            3985     2                       if(GDCHK2) print *,"ps: 830 .3, RHS(4+jk)=",RHS(4+jk)
            3986     2               #endif
            3987     2                       ELSE
            3988     3                         IF ( (hesn.LE.csncri).AND.(heice.LE.xicri)) THEN
            3989     3                           RHS(4+jk)= wtm(nls+jk)-(1.-beta)*Y(4+jk)*(wtm(nls+jk)-wtm(nls+jk+1))  &
            3990     3                                   +(  rhosn*csn*hsn*tsim(1)+rhoice*cice*hice*tsim(3)               &
            3991     3                                      +zdtime*( zsoflw*(FFN(0.)-FFN(zlk(nls+jk+1)-pwlvl(jl)))    &
            3992     3                                        -(pfluxw2+zsoflw)+pdfluxs(jl)*wtm(0)                        &
            3993     3                                       )                                                            &
            3994     3                                     )/rhoh2o/clw/hw(nls+jk)                                        &
            3995     3                                      +zdtime*pawtfl(jl,nls+jk)
            3996     3               
            3997     3                           AA(4+jk,1)=0.
            3998     3                           AA(4+jk,3)=-beta*Y(4+jk)
            3999     3                           AA(4+jk,2)= 1. - AA(4+jk,1) - AA(4+jk,3)                              &
            4000     3                                   +(  rhosn*csn*hsn+rhoice*cice*hice+zdtime*pdfluxs(jl)  )         &
            4001     3                                    /rhoh2o/clw/hw(nls+jk)
            4002     4                           IF (lsit_lw) THEN
            4003     4                             AA(4+jk,3)=AA(4+jk,3)-4.*stbo*zdtime*wtm(nls+jk+1)**3/rhoh2o/clw/hw(nls+jk)
            4004     4                             AA(4+jk,2)=AA(4+jk,2)+4.*stbo*zdtime*wtm(nls+jk)**3/rhoh2o/clw/hw(nls+jk)
            4005     4                           ENDIF
            4006     3               #ifdef DEBUG
            4007     3                       if(GDCHK2) print *,"ps: 830 .4, X(4+jk)=",X(4+jk),", Y(4+jk)=",Y(4+jk)
            4008     3                       if(GDCHK2) print *,"ps: 830 .4, nls=",nls,", wtm(0)=",wtm(0),", wtm(nls+jk)=",wtm(nls+jk),", wtm(nls+jk+1)=",wtm(nls+jk+1)
            4009     3                       IF(GDCHK2) print *,"ps: 830 .4, tsim(3)=", tsim(3),", rhoice=",rhoice,", cice=", cice,", hice=",hice
            4010     3                       if(GDCHK2) print *,"ps: 830 .4, zdtime=",zdtime,", zsoflw=",zsoflw,", hew=",hew,", hw=",hw
            4011     3                       if(GDCHK2) print *,"ps: 830 .4, FFN(0.)=",FFN(0.),", FFN(zlk(nls+jk+1)-pwlvl(jl))=",FFN(zlk(nls+jk+1)-pwlvl(jl))
            4012     3                       if(GDCHK2) print *,"ps: 830 .4, beta=", beta,", hw(nls+jk)=", hw(nls+jk)
            4013     3                       if(GDCHK2) print *,"ps: 830 .4, pfluxw2=",pfluxw2,", pdfluxs(jl)=",pdfluxs(jl)
            4014     3                       if(GDCHK2) print *,"ps: 830 .4, rhosn=",rhosn,", csn=",csn,", rhoh2o=",rhoh2o,", clw=",clw,", hsn=",hsn
            4015     3                       if(GDCHK2) print *,"ps: 830 .4, RHS(4+jk)=",RHS(4+jk)
            4016     3               #endif
            4017     3                         ELSE
            4018     3               !         thick ice or thick snow on top
            4019     3               !           set pwt(jk) =pctfreez2(jl)
            4020     3                           RHS(4+jk)= pctfreez2(jl)
            4021     3                           AA(4+jk,1)=0.
            4022     3                           AA(4+jk,3)=0.
            4023     3                           AA(4+jk,2)= 1. - AA(4+jk,1) - AA(4+jk,3)
            4024     3               #ifdef DEBUG
            4025     3                       if(GDCHK2) print *,"ps: 830 .5"
            4026     3               #endif
            4027     3                         ENDIF
            4028     2                       ENDIF
            4029     1               !       Middle & Bottom Layers
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Y, X, AA, RHS
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 3  FILL 10
                                   <<<      SIMD&FP   : SPILL 0  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4030     2                       DO jk =2,nle-nls
            4031     2                         RHS(4+jk)= wtm(nls+jk)+(1.-beta)*&
            4032     2               &             ( X(4+jk)*(wtm(nls+jk-1)-wtm(nls+jk))-&
            4033     2               &               Y(4+jk)*(wtm(nls+jk)-wtm(nls+jk+1)) )+&
            4034     2               &           zdtime*( zsoflw* &
            4035     2               &             ( FFN(zlk(nls+jk)-pwlvl(jl))-FFN(zlk(nls+jk+1)-pwlvl(jl)) )&
            4036     2               &               /rhoh2o/clw/hw(nls+jk)                                   &
            4037     2               &             +pawtfl(jl,nls+jk) )
            4038     2               
            4039     2               
            4040     2                         AA(4+jk,1)=-beta*X(4+jk)
            4041     2                         AA(4+jk,3)=-beta*Y(4+jk)
            4042     2                         AA(4+jk,2)= 1. - AA(4+jk,1) - AA(4+jk,3)
            4043     3                         IF (lsit_lw) THEN
            4044     3                           AA(4+jk,1)=AA(4+jk,1)-4.*stbo*zdtime*wtm(nls+jk-1)**3/rhoh2o/clw/hw(nls+jk)
            4045     3                           AA(4+jk,3)=AA(4+jk,3)-4.*stbo*zdtime*wtm(nls+jk+1)**3/rhoh2o/clw/hw(nls+jk)
            4046     3                           AA(4+jk,2)=AA(4+jk,2)+8.*stbo*zdtime*wtm(nls+jk)**3/rhoh2o/clw/hw(nls+jk)
            4047     3                         ENDIF
            4048     2               #ifdef DEBUG
            4049     2                       if(GDCHK2) print *,"ps: 830 .6, jk=",jk
            4050     2                       if(GDCHK2) print *,"ps: 830 .6, X(4+jk)=",X(4+jk),", Y(4+jk)=",Y(4+jk)
            4051     2                       if(GDCHK2) print *,"ps: 830 .6, nls=",nls,", nle=",nle,", wtm(nls+jk-1)=",wtm(nls+jk-1),", wtm(nls+jk)=",wtm(nls+jk),", wtm(nls+jk+1)=",wtm(nls+jk+1)
            4052     2                       if(GDCHK2) print *,"ps: 830 .6, tsim(3)=", tsim(3),", rhoice=",rhoice,", cice=", cice,", hice=",hice
            4053     2                       if(GDCHK2) print *,"ps: 830 .6, zdtime=",zdtime,", zsoflw=",zsoflw,", hew=",hew,", hw=",hw
            4054     2                       if(GDCHK2) print *,"ps: 830 .6, FFN(zlk(nls+jk)-pwlvl(jl))=",FFN(zlk(nls+jk)-pwlvl(jl)),", FFN(zlk(nls+jk+1)-pwlvl(jl))=",FFN(zlk(nls+jk+1)-pwlvl(jl))
            4055     2                       if(GDCHK2) print *,"ps: 830 .6, beta=", beta,", hw(nls+jk)=", hw(nls+jk)
            4056     2                       if(GDCHK2) print *,"ps: 830 .6, pfluxw2=",pfluxw2,", pdfluxs(jl)=",pdfluxs(jl),", pawtfl(jl,nls+jk)=",pawtfl(jl,nls+jk),", pawtfl0(jl,nls+jk)=",pawtfl0(jl,nls+jk)
            4057     2                       if(GDCHK2) print *,"ps: 830 .6, rhosn=",rhosn,", csn=",csn,", rhoh2o=",rhoh2o,", clw=",clw,", hsn=",hsn,", stbo=",stbo
            4058     2                       if(GDCHK2) print *,"ps: 830 .6, RHS(4+jk)=",RHS(4+jk)
            4059     2               #endif
            4060     2                       ENDDO
            4061     1               !       soil layer
            4062     1                       jk=nle+1-nls
            4063     1               !
            4064     1                       RHS(4+jk)= wtm(nls+jk)&
            4065     1               &         +(1.-beta)*X(4+jk)*(wtm(nls+jk-1)-wtm(nls+jk))&
            4066     1               &         +zdtime*(zsoflw*FFN(zlk(nls+jk)-pwlvl(jl))+hspg)&
            4067     1               &          /(rhogcg*SQRT(xkg/omegas))
            4068     1                       AA(4+jk,1)=-beta*X(4+jk)
            4069     1                       AA(4+jk,3)=0.
            4070     1                       AA(4+jk,2)=1. - AA(4+jk,1) - AA(4+jk,3)
            4071     2                       IF (lsit_lw) THEN
            4072     2                         AA(4+jk,1)=AA(4+jk,1)-4.*stbo*zdtime*wtm(nls+jk-1)**3/(rhogcg*SQRT(xkg/omegas))
            4073     2                         AA(4+jk,2)=AA(4+jk,2)+4.*stbo*zdtime*wtm(nls+jk)**3/(rhogcg*SQRT(xkg/omegas))
            4074     2                       ENDIF
            4075     1               !       last level matrix updated by this routine
            4076     1                       mae=5+nle-nls
            4077     1                     ELSE
            4078     1               !     Soil Mode
            4079     1               !
            4080     1               !       water completely frozen or evaporated
            4081     1               !       soil layer (note nle=-1)
            4082     2                       IF  ((hesn.LE.csncri).AND.(heice.LE.xicri)) THEN
            4083     2               !       soil on top
            4084     2                         RHS(4)= wtm(nle+1)&
            4085     2               &           +zdtime*(-pfluxw2+hspg+pdfluxs(jl)*wtm(nle+1))&
            4086     2               &            /(rhogcg*SQRT(xkg/omegas))
            4087     2                         AA(4,1)=0.
            4088     2                         AA(4,3)=0.
            4089     2                         AA(4,2)=1.+zdtime*pdfluxs(jl)/(rhogcg*SQRT(xkg/omegas))&
            4090     2               &           -AA(4,1)-AA(4,3)
            4091     2                       ELSEIF (heice.GT.xicri) THEN
            4092     2               !       water completely frozen, with ice above
            4093     2                         X(4) = zdtime/(rhogcg*SQRT(xkg/omegas))&
            4094     2               &           *rhoice*cice*xkice/(pzsi(jl,1)*rhoh2o/rhoice/2.)
            4095     2                         RHS(4)= wtm(nle+1)&
            4096     2               &           +(1.-beta)*X(4)*(tsim(3)-wtm(nle+1))&
            4097     2               &           +zdtime*hspg/(rhogcg*SQRT(xkg/omegas))
            4098     2                         AA(4,1)=-beta*X(4)
            4099     2                         AA(4,3)=0.
            4100     2                         AA(4,2)=1. - AA(4,1) - AA(4,3)
            4101     2                       ELSEIF (pzsi(jl,0).GT.csncri) THEN
            4102     2               !       snow on top
            4103     2                         X(4) = zdtime/(rhogcg*SQRT(xkg/omegas))&
            4104     2               &           *rhosn*csn*xksn/(0.5*hsn/pseaice(jl))
            4105     2                         RHS(4)= wtm(nle+1)&
            4106     2               &           +(1.-beta)*X(4)*(tsim(1)-wtm(nle+1))&
            4107     2               &           +zdtime*hspg/(rhogcg*SQRT(xkg/omegas))
            4108     2                         AA(4,1)=-beta*X(4)
            4109     2                         AA(4,3)=0.
            4110     2                         AA(4,2)=1. - AA(4,1) - AA(4,3)
            4111     2                       ENDIF
            4112     1                       mae=4
            4113     1                     ENDIF
            4114                     !
            4115                     !-----------------------------------------------------------------
            4116                     !
            4117                     !*    9. Update T by Solving a Tri-Diagonal Matrix.
            4118                     !         Determine Melting Rate in Snow & Ice, Freezing Rate in Water
            4119                     !         and adjust their water storage (not water equivalent)
            4120                     !
            4121                     !-----------------------------------------------------------------
            4122                       900 CONTINUE
            4123                     !      PRINT *, "I am update Temperature."
            4124                     !
            4125                     !*    9.1  SOLVE THE TRIDIAGONAL MXTRIX
            4126                     !
            4127                     #ifdef DEBUG
            4128                             if(GDCHK2) print *,"ps: 900 9.1 before LU, mae=",mae
            4129                             if(GDCHK2) print *,"ps: 900 9.1 before LU, AA(:,1)=",AA(:,1)
            4130                             if(GDCHK2) print *,"ps: 900 9.1 before LU, AA(:,2)=",AA(:,2)
            4131                             if(GDCHK2) print *,"ps: 900 9.1 before LU, AA(:,3)=",AA(:,3)
            4132                             if(GDCHK2) print *,"ps: 900 9.1 before LU, RHS=",RHS(:)
            4133                             if(GDCHK2) print *,"ps: 900 9.1 before LU, SOL=",SOL(:)
            4134                     #endif
            4135                     
            4136                           CALL LU(0,mae,AA,RHS,SOL)
            4137                     !!!      CALL LU(mas,mae,AA,RHS,SOL)
            4138                     #ifdef DEBUG
            4139                             if(GDCHK2) print *,"ps: 900 9.1 LU, mae=",mae
            4140                             if(GDCHK2) print *,"ps: 900 9.1 LU, AA(:,1)=",AA(:,1)
            4141                             if(GDCHK2) print *,"ps: 900 9.1 LU, AA(:,2)=",AA(:,2)
            4142                             if(GDCHK2) print *,"ps: 900 9.1 LU, AA(:,3)=",AA(:,3)
            4143                             if(GDCHK2) print *,"ps: 900 9.1 LU, RHS=",RHS(:)
            4144                             if(GDCHK2) print *,"ps: 900 9.1 LU, SOL=",SOL(:)
            4145                     #endif
            4146                     !
            4147     1                     IF (mas.GE.4.AND..NOT.lsoil) THEN
            4148     1               !     9.2 Water on top: CHK Water Skin Temperature pwt(jl,0) = SOL(4)
            4149     2                       IF ( SOL(4).LT.pctfreez2(jl)-tol) THEN
            4150     2               !       freeze
            4151     2                         lwf=.TRUE.
            4152     2               !         set pwt(0) =tmelt
            4153     2                         RHS(4)= pctfreez2(jl)
            4154     2                         AA(4,1)=0.
            4155     2                         AA(4,3)=0.
            4156     2                         AA(4,2)=1. - AA(4,1) - AA(4,3)
            4157     2               #ifdef DEBUG
            4158     2                       if(GDCHK2) print *,"ps: 900 9.2 before LU, mae=",mae
            4159     2                       if(GDCHK2) print *,"ps: 900 9.2 before LU, AA(:,1)=",AA(:,1)
            4160     2                       if(GDCHK2) print *,"ps: 900 9.2 before LU, AA(:,2)=",AA(:,2)
            4161     2                       if(GDCHK2) print *,"ps: 900 9.2 before LU, AA(:,3)=",AA(:,3)
            4162     2                       if(GDCHK2) print *,"ps: 900 9.2 before LU, RHS=",RHS(:)
            4163     2                       if(GDCHK2) print *,"ps: 900 9.2 before LU, SOL=",SOL(:)
            4164     2               #endif
            4165     2               
            4166     2                         CALL LU(0,mae,AA,RHS,SOL)
            4167     2               !!!          CALL LU(mas,mae,AA,RHS,SOL)
            4168     2               #ifdef DEBUG
            4169     2                       if(GDCHK2) print *,"ps: 900 9.2 LU, mae=",mae
            4170     2                       if(GDCHK2) print *,"ps: 900 9.2 LU, AA(:,1)=",AA(:,1)
            4171     2                       if(GDCHK2) print *,"ps: 900 9.2 LU, AA(:,2)=",AA(:,2)
            4172     2                       if(GDCHK2) print *,"ps: 900 9.2 LU, AA(:,3)=",AA(:,3)
            4173     2                       if(GDCHK2) print *,"ps: 900 9.2 LU, RHS=",RHS(:)
            4174     2                       if(GDCHK2) print *,"ps: 900 9.2 LU, SOL=",SOL(:)
            4175     2               #endif
            4176     2               
            4177     2               !         calculate FCE of ice/water interface (ice melt positive)
            4178     2               !v.76i
            4179     2                         fcew=rhowcw*hew*( -pctfreez2(jl)+wtm(0)&
            4180     2               &             -beta*Y(4)*(pctfreez2(jl)-SOL(5+nls))&
            4181     2               &             -(1.-beta)*Y(4)*(wtm(0)-wtm(nls+1))  )&
            4182     2               &           +zdtime*(  zsoflw* ( FFN(0.)-FFN(-hw(0)) )&
            4183     2               &             -(pfluxw2+zsoflw) )
            4184     2               !
            4185     2                         iderr=11
            4186     2    i                    CALL lkerr("Water starts to freeze.",hesn,hew,heice,fcew,pfluxwm,wtm,wsm,tsim,pctfreez2(jl),mas,mae,SOL)
            4187     2                       ELSE
            4188     2                         lwf=.FALSE.
            4189     2                         fcew=0.
            4190     2                       ENDIF
            4191     1               !
            4192     1                     ELSEIF ( ( (mas.GE.1) .OR.&
            4193     1               &        ((mas.EQ.0).AND.(hesn.LE.csncri))  )&
            4194     1               &      .AND.(heice.GT.xicri) )THEN
            4195     1               !
            4196     1               !     9.3 Ice on top: CHK Thick Ice Skin Temperature store in SOL(1)
            4197     1               !
            4198     2                       IF (SOL(2) .GT. (tmelt+tol)) THEN
            4199     2                         lim=.TRUE.
            4200     2               !         set ptsw(jl) =tmelt
            4201     2                         RHS(2)= tmelt
            4202     2                         AA(2,1)=0.
            4203     2                         AA(2,3)=0.
            4204     2                         AA(2,2)=1.
            4205     2               #ifdef DEBUG
            4206     2                       if(GDCHK2) print *,"ps: 900 9.3 before LU, mae=",mae
            4207     2                       if(GDCHK2) print *,"ps: 900 9.3 before LU, AA(:,1)=",AA(:,1)
            4208     2                       if(GDCHK2) print *,"ps: 900 9.3 before LU, AA(:,2)=",AA(:,2)
            4209     2                       if(GDCHK2) print *,"ps: 900 9.3 before LU, AA(:,3)=",AA(:,3)
            4210     2                       if(GDCHK2) print *,"ps: 900 9.3 before LU, RHS=",RHS(:)
            4211     2                       if(GDCHK2) print *,"ps: 900 9.3 before LU, SOL=",SOL(:)
            4212     2               #endif
            4213     2               
            4214     2                         CALL LU(0,mae,AA,RHS,SOL)
            4215     2               !!!          CALL LU(mas,mae,AA,RHS,SOL)
            4216     2               #ifdef DEBUG
            4217     2                       if(GDCHK2) print *,"ps: 900 9.3 LU, mae=",mae
            4218     2                       if(GDCHK2) print *,"ps: 900 9.3 LU, AA(:,1)=",AA(:,1)
            4219     2                       if(GDCHK2) print *,"ps: 900 9.3 LU, AA(:,2)=",AA(:,2)
            4220     2                       if(GDCHK2) print *,"ps: 900 9.3 LU, AA(:,3)=",AA(:,3)
            4221     2                       if(GDCHK2) print *,"ps: 900 9.3 LU, RHS=",RHS(:)
            4222     2                       if(GDCHK2) print *,"ps: 900 9.3 LU, SOL=",SOL(:)
            4223     2               #endif
            4224     2               
            4225     2               !         calculate FCE of ice surface (ice melt positive)
            4226     2                         fcei=rhoice*cice*heice*&
            4227     2               &           ( -tmelt+tsim(2)-beta*Y(2)*(tmelt-SOL(3))&
            4228     2               &                       -(1.-beta)*Y(2)*(tsim(2)-tsim(3)) )&
            4229     2               &           +zdtime*( -pfluxi2 )+xife
            4230     2                       ELSE
            4231     2                         lim=.FALSE.
            4232     2                         fcei=0.
            4233     2                       ENDIF
            4234     1                     ELSEIF (pzsi(jl,0).GT.csncri) THEN
            4235     1               !
            4236     1               !     9.4 Snow on top: CHK Thick Snow Skin Temperature store in SOL(0)
            4237     1               !
            4238     2                       IF (SOL(0) .GT. (tmelt+tol) ) THEN
            4239     2                         lsm=.TRUE.
            4240     2               !         set ptsw(jl) =tmelt
            4241     2                         RHS(0)= tmelt
            4242     2                         AA(0,1)=0.
            4243     2                         AA(0,3)=0.
            4244     2                         AA(0,2)= 1.
            4245     2               !         recalculate temp profile
            4246     2                         CALL LU(0,mae,AA,RHS,SOL)
            4247     2               !!!          CALL LU(mas,mae,AA,RHS,SOL)

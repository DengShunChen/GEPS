            7115     4                                   (plat(jl) .LT. sitbox_nudg_n(isit_nudg)) ) ) THEN
            7116     4   p    m                  lrestore_mix=.true.
            7117     4   p                     ENDIF
            7118     3   p    v              ENDIF
            7119     2   p    v            ENDDO
            7120     1                   ENDIF
            7121                     
            7122     1                   IF(lrestore_mix) then
            7123     2                     IF ((pobswtb(jl).NE.xmissing).AND.(st_restore_time_all.GT.0.)) THEN
            7124     2                        restore_temp2=(pobswtb(jl)-pwt(jl,jk))*(1.-0.5**(zdtime/st_restore_time_all))
            7125     3                        IF(ltimeblending .AND. timebl_option .EQ. 1) THEN

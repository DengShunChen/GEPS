            7228                     ! **********************************************************************
            7229                       SUBROUTINE nudging_sit_viff_gd(jl,jrow,obox_restore_time, &
            7230                         socn_restore_time,uocn_restore_time,docn_restore_time,   &
            7231                         ssit_restore_time,ssits_restore_time,ssituv_restore_time, &
            7232                         pssit_restore_time,pusit_restore_time,pdsit_restore_time,   &
            7233                         pssits_restore_time,pusits_restore_time,pdsits_restore_time, &
            7234                         pssituv_restore_time,pusituv_restore_time,pdsituv_restore_time, tau, tauhr)
            7235                     
            7236                         IMPLICIT NONE
            7237                         INTEGER, INTENT(IN):: jl,jrow    ! lonitude index, and latitude index
            7238                         real, INTENT(IN):: obox_restore_time  ! nudging restore time for obox_mask(jl).GT.0. grids
            7239                         real, INTENT(IN):: socn_restore_time ! surface [0m,10m) ocean restore time for pocnmask(jl).GT.0. grids
            7240                         real, INTENT(IN):: uocn_restore_time ! upper [10m,100m) ocean restore time for pocnmask(jl).GT.0. grids
            7241                         real, INTENT(IN):: docn_restore_time ! deep (>100 m) ocean restore time for pocnmask(jl).GT.0. grids
            7242                         real, INTENT(IN):: ssit_restore_time   ! surface [0m,10m) ocean temp/salt restore time for the rest SIT grids
            7243                         real, INTENT(IN):: ssits_restore_time   ! surface [0m,10m) ocean temp/salt restore time for the rest SIT grids for salinity
            7244                         real, INTENT(IN):: ssituv_restore_time   ! surface [0m,10m) ocean temp/salt restore time for the rest SIT grids for u, v
            7245                         real, INTENT(IN):: pssit_restore_time   ! surface [0m,10m) ocean temp/salt restore time for the rest SIT grids
            7246                         real, INTENT(IN):: pusit_restore_time   ! upper [10m,100m) ocean temp/salt restore time for the rest SIT grids
            7247                         real, INTENT(IN):: pdsit_restore_time   ! deep (>100 m) ocean temp/salt restore time for the rest SIT grids
            7248                         real, INTENT(IN):: pssits_restore_time   ! surface [0m,10m) ocean temp/salt restore time for the rest SIT grids for salinity
            7249                         real, INTENT(IN):: pusits_restore_time   ! upper [10m,100m) ocean temp/salt restore time for the rest SIT grids for salinity
            7250                         real, INTENT(IN):: pdsits_restore_time   ! deep (>100 m) ocean temp/salt restore time for the rest SIT grids for salinity
            7251                         real, INTENT(IN):: pssituv_restore_time   ! surface [0m,10m) ocean temp/salt restore time for the rest SIT grids for u, v
            7252                         real, INTENT(IN):: pusituv_restore_time   ! upper [10m,100m) ocean temp/salt restore time for the rest SIT grids for u, v
            7253                         real, INTENT(IN):: pdsituv_restore_time   ! deep (>100 m) ocean temp/salt restore time for the rest SIT grids for u, v
            7254                         INTEGER :: jk,jk10,jk100,jkmixing
            7255                         real:: restore_temp
            7256                         real:: restore_salt
            7257                         real:: restore_u
            7258                         real:: restore_v
            7259                         real:: st_restore_time, ss_restore_time, suv_restore_time
            7260                         real:: st_restore_time_all, ss_restore_time_all, suv_restore_time_all
            7261                     !ps
            7262                     ! time blending
            7263                         real:: tau,tauhr,tmpt0,tmpt1,tmpt2,xtau,gm,fratio
            7264                         real:: urand
            7265                         logical:: lbefore_bl
            7266                     
            7267                     !   nudging from surface to nudge_depth=100 m depth (default)
            7268     1                   IF (GDCHK2) then
            7269     1                      WRITE(nerr,*) ", I am in nudging_sit_viff_gd"
            7270     1               
            7271     1                      WRITE(nerr,*) "ssit_restore_time=",pssit_restore_time
            7272     1                      WRITE(nerr,*) "usit_restore_time=",pusit_restore_time
            7273     1                      WRITE(nerr,*) "dsit_restore_time=",pdsit_restore_time
            7274     1               
            7275     1                      WRITE(nerr,*) "socn_restore_time=",socn_restore_time
            7276     1                      WRITE(nerr,*) "uocn_restore_time=",uocn_restore_time
            7277     1                      WRITE(nerr,*) "docn_restore_time=",docn_restore_time
            7278     1                      WRITE(nerr,*) "pocnmask(",jl,",)=",pocnmask(jl)
            7279     1                   ENDIF
            7280                     !!!  CALL pzcord(jl,jrow)  ! bjt 2010/2/21
            7281                     !!!    IF (pobswtb(jl).NE.xmissing) pobswtb(jl)=MAX(pobswtb(jl),pctfreez2(jl))
            7282                         IF (lsoil) RETURN
            7283     1                   IF (lgodas) THEN
            7284     1                     CALL interpolation_godas(jl,jrow,.TRUE.,.TRUE.,.TRUE.,.TRUE.)
            7285     1                   ELSE
            7286     1                     CALL interpolation_godas(jl,jrow,.FALSE.,.FALSE.,.FALSE.,.FALSE.)
            7287     1                   ENDIF
            7288                           IF (pobsws(jl,1).NE.xmissing) pobswsb(jl)=pobsws(jl,1)
            7289                     
            7290                         IF ((obox_restore_time.LT.0.).AND.(socn_restore_time.LT.0.).AND.    &
            7291                             ( uocn_restore_time.LT.0.).AND.( docn_restore_time.LT.0.).AND. &
            7292                             ( pssit_restore_time.LT.0.).AND.( pusit_restore_time.LT.0.).AND. &
            7293                             ( pdsit_restore_time.LT.0.) ) RETURN                               ! no nudging
            7294                     !
            7295                     !   1.0 Find jk at 10 m depth and nudge_depth (=100 m)
            7296                         jk=nls+1
            7297     1                   DO WHILE ( ((pwlvl(jl)-z(jk)).LT.nudge_depth_10).AND.(jk.LT.nle) )
            7298     1               !      nudging at depth just >= 10 m or at level nle (last water level)
            7299     1                      jk=jk+1
            7300     1                   END DO
            7301                         jk10=jk
            7302     1                   DO WHILE ( ((pwlvl(jl)-z(jk)).LT.mixedlayer(jl)).AND.(jk.LT.nle) )
            7303     1               !      nudging at depth just>= mixedlayer (55 m)
            7304     1                      jk=jk+1
            7305     1                   END DO
            7306                         jkmixing=jk
            7307     1                   IF (GDCHK3) then
            7308     1                     WRITE(nerr,*) ",mixedlayer=",mixedlayer(jl),",jkmixing=",jkmixing
            7309     1                   ENDIF
            7310     1                   DO WHILE ( ((pwlvl(jl)-z(jk)).LT.nudge_depth_100).AND.(jk.LT.nle) )
            7311     1               !      nudging at depth >= nudge_depth (100 m)
            7312     1                      jk=jk+1
            7313     1                   END DO
            7314                         jk100=jk
            7315                     
            7316                     
            7317                     !!! time blending
            7318                         tmpt0=0.
            7319                         fratio=1.
            7320     1                   IF(ltimeblending)THEN
            7321     1               ! unit day
            7322     1                     tmpt1=timebl_start*24. !(convert from day to hour)
            7323     1               
            7324     2                     IF(tau .le. tmpt1)then
            7325     2                       fratio=0.
            7326     2                       gm=-1.
            7327     2                       lbefore_bl=.true.
            7328     2                     ELSE
            7329     2                       lbefore_bl=.false.
            7330     3                       IF(timebl_option .EQ. 0) THEN
            7331     3                         tmpt0=(timebl_start+timebl_allsit)/2.*24.
            7332     3                         tmpt2=tmpt0-tmpt1
            7333     3                         xtau=tau-tmpt1
            7334     3               
            7335     3                         gm=abs(0.5*xtau/tmpt2-1.)
            7336     3               
            7337     4                         if(xtau .ge. timebl_allsit*24.)then
            7338     4                           fratio=1.                           !! use st/ss/suv_restore_time
            7339     4                         else if(gm.gt.0. .and. gm.lt.1.)then
            7340     4                           fratio=1.-exp(-1./gm*exp(0.5/(gm-1.)))
            7341     4                         else
            7342     4                           fratio=0.
            7343     4                         endif
            7344     3                       ENDIF
            7345     2               
            7346     3                       IF(timebl_option .EQ. 1)then
            7347     3                         fratio=(sin((tauhr-6.)/12.*api)+1.)*0.5
            7348     3                       ENDIF
            7349     2                     ENDIF
            7350     2                     IF(fratio .eq. 0.) then
            7351     2                       ltrigsit=.false.
            7352     2                     else
            7353     2                       ltrigsit=.true.
            7354     2                     endif
            7355     2                     IF(GDCHK3) then
            7356     2                      WRITE(nerr,*) "ltimeblending=",ltimeblending  &
            7357     2                                 ,",timebl_start=",timebl_start,",timebl_allsit=",timebl_allsit  &
            7358     2                                 ,",tmpt1=",tmpt1,",tmpt0=",tmpt0,",nls=",nls,",fratio=",fratio
            7359     2                     ENDIF
            7360     1                   ENDIF
            7361                     
            7362                     !!! end time blending
            7363                     
            7364                     !    IF(GDCHK3) print *,'in nudge_gd: nudge_depth_10=',nudge_depth_10,',jk10=',jk10
            7365                     !   3.0 Start nudging from 10 m (at nle, 10 m and >=100 m)
            7366                         restore_temp=0.
            7367                         restore_salt=0.
            7368                         restore_u=0.
            7369                         restore_v=0.
            7370                     !ps    jk=nls+1
            7371                         jk=nls
            7372                     !ps    DO WHILE ( jk.LE.nle )
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 22
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            7373     1                   DO WHILE ( jk.LE.nle+1 )
            7374     1                     ! [0m, 10m (or waterbed) )
            7375     1                     ! .?: (first digit): T,S nudging. 0: no nudging, 1: nudging inside square boxes, 2: nudging outside the square boxes
            7376     1                     ! ?.: (decimal digit): high_damping coefficient for u,v currents in Sulu Sea, no nudging, 1: nudging inside square boxes, 2: nudging outside the square boxes
            7377     1                     ! obox_nudg_flag
            7378     1                     ! 0             |    0         |    0: no nudging
            7379     1                     ! 1:  0- 10 m   |    1: T,S    |    1: nudging inside
            7380     1                     ! 2: 10-100 m   |    2: U,V    |    2: nudging outside
            7381     1                     ! 4    >100 m   |              |
            7382     2                     IF(lmixedlayer .and. jk .LT. jkmixing) THEN
            7383     2                     ! [0m, mixing (or waterbed) )
            7384     3                       IF ((obox_mask(jl).GT.0.).AND.(MOD(INT(obox_nudg_flag/100),2).EQ.1)) THEN
            7385     3                       ! obox grids
            7386     3                       ! ie., obox_mask(jl).GT.0. .AND. obox_nudg_flag=1xx
            7387     3                       !
            7388     3                         st_restore_time=obox_restore_time
            7389     3                         ss_restore_time=obox_restore_time
            7390     3                         suv_restore_time=obox_restore_time
            7391     3                       ELSEIF (pocnmask(jl).GT.0.) THEN
            7392     3                       ! ocn grids
            7393     3                         st_restore_time=socn_restore_time
            7394     3                         ss_restore_time=socn_restore_time
            7395     3                         suv_restore_time=socn_restore_time
            7396     3                       ELSE
            7397     3                       ! other SIT grids
            7398     3               !ps          ss_restore_time=ssit_restore_time
            7399     3                         st_restore_time=pssit_restore_time
            7400     3                         ss_restore_time=pssits_restore_time
            7401     3                         suv_restore_time=pssituv_restore_time
            7402     3                         st_restore_time_all=ssit_restore_time
            7403     3                         ss_restore_time_all=ssits_restore_time
            7404     3                         suv_restore_time_all=ssituv_restore_time
            7405     3                       ENDIF
            7406     2                     ELSEIF ( jk.LT.jk10) THEN
            7407     2                     ! [0m, 10m (or waterbed) )
            7408     3                       IF ((obox_mask(jl).GT.0.).AND.(MOD(INT(obox_nudg_flag/100),2).EQ.1)) THEN
            7409     3                       ! obox grids
            7410     3                       ! ie., obox_mask(jl).GT.0. .AND. obox_nudg_flag=1xx
            7411     3                       !
            7412     3                         st_restore_time=obox_restore_time
            7413     3                         ss_restore_time=obox_restore_time
            7414     3                         suv_restore_time=obox_restore_time
            7415     3                       ELSEIF (pocnmask(jl).GT.0.) THEN
            7416     3                       ! ocn grids
            7417     3                         st_restore_time=socn_restore_time
            7418     3                         ss_restore_time=socn_restore_time
            7419     3                         suv_restore_time=socn_restore_time
            7420     3                       ELSE
            7421     3                       ! other SIT grids
            7422     3               !ps          ss_restore_time=ssit_restore_time
            7423     3                         st_restore_time=pssit_restore_time
            7424     3                         ss_restore_time=pssits_restore_time
            7425     3                         suv_restore_time=pssituv_restore_time
            7426     3                         st_restore_time_all=ssit_restore_time
            7427     3                         ss_restore_time_all=ssits_restore_time
            7428     3                         suv_restore_time_all=ssituv_restore_time
            7429     3                       ENDIF
            7430     2                     ELSEIF ( jk.LT.jk100) THEN
            7431     2                     ! [10m, 100m(waterbed) )
            7432     3                       IF ((obox_mask(jl).GT.0.).AND.(MOD(INT(INT(obox_nudg_flag/100)/2),2).EQ.1)) THEN
            7433     3                       ! ie., obox_mask(jl).GT.0. .AND. obox_nudg_flag=2xx
            7434     3                       !
            7435     3                         st_restore_time=obox_restore_time
            7436     3                         ss_restore_time=obox_restore_time
            7437     3                       ELSEIF (pocnmask(jl).GT.0.) THEN
            7438     3                       ! no nudging for depth < 100 m (default)
            7439     3                         st_restore_time=uocn_restore_time
            7440     3                         ss_restore_time=uocn_restore_time
            7441     3                       ELSE
            7442     3               !ps          ss_restore_time=usit_restore_time
            7443     3                         st_restore_time=pusit_restore_time
            7444     3                         ss_restore_time=pusits_restore_time
            7445     3                         suv_restore_time=pusituv_restore_time
            7446     3                       ENDIF
            7447     2                     ELSE
            7448     2                     ! >= 100 m or at nle
            7449     3                       IF ((obox_mask(jl).GT.0.).AND.(MOD(INT(INT(INT(obox_nudg_flag/100)/2)/2),2).EQ.1)) THEN
            7450     3                       ! ie., obox_mask(jl).GT.0. .AND. obox_nudg_flag=4xx
            7451     3                       !
            7452     3                         st_restore_time=obox_restore_time
            7453     3                         ss_restore_time=obox_restore_time
            7454     3                       ELSEIF (pocnmask(jl).GT.0.) THEN
            7455     3                       ! no nudging
            7456     3                         st_restore_time=docn_restore_time
            7457     3                         ss_restore_time=docn_restore_time
            7458     3                       ELSE
            7459     3               !ps          ss_restore_time=dsit_restore_time
            7460     3                         st_restore_time=pdsit_restore_time
            7461     3                         ss_restore_time=pdsits_restore_time
            7462     3                         suv_restore_time=pdsituv_restore_time
            7463     3                       ENDIF
            7464     2                     ENDIF
            7465     1               
            7466     2                     IF(ltimeblending) THEN
            7467     3                       IF(st_restore_time .GE. 0.) THEN
            7468     3                         st_restore_time=fratio*st_restore_time
            7469     3                       ELSE
            7470     4                         IF(timebl_option .EQ. 0 .AND. fratio .LT. 1) THEN
            7471     4                           st_restore_time=fratio*(2.*30.*24.*3600.) !2m
            7472     4                         ENDIF
            7473     4                         IF(timebl_option .EQ. 1 .AND. lbefore_bl ) THEN
            7474     4                           st_restore_time=0.
            7475     4                         ENDIF
            7476     3                       ENDIF
            7477     3                       IF(st_restore_time_all .GE. 0.) THEN
            7478     3                         st_restore_time_all=fratio*st_restore_time_all
            7479     3                       ELSE
            7480     4                         IF(timebl_option .EQ. 0 .AND. fratio .LT. 1) THEN
            7481     4                           st_restore_time_all=fratio*(2.*30.*24.*3600.) !2m
            7482     4                         ENDIF
            7483     4                         IF(timebl_option .EQ. 1 .AND. lbefore_bl ) THEN
            7484     4                           st_restore_time_all=0.
            7485     4                         ENDIF
            7486     3                       ENDIF
            7487     2               
            7488     2               
            7489     3                       IF(ss_restore_time .GE. 0.) THEN
            7490     3                         ss_restore_time=fratio*ss_restore_time
            7491     3                       ELSE
            7492     4                         IF(timebl_option .EQ. 0 .AND. fratio .LT. 1.) THEN
            7493     4                           ss_restore_time=fratio*(2.*30.*24.*3600.) !2m
            7494     4                         ENDIF
            7495     4                         IF(timebl_option .EQ. 1 .AND. lbefore_bl ) THEN
            7496     4                           ss_restore_time=0.
            7497     4                         ENDIF
            7498     3                       ENDIF
            7499     3                       IF(ss_restore_time_all .GE. 0.) THEN
            7500     3                         ss_restore_time_all=fratio*ss_restore_time_all
            7501     3                       ELSE
            7502     4                         IF(timebl_option .EQ. 0 .AND. fratio .LT. 1.) THEN
            7503     4                           ss_restore_time_all=fratio*(2.*30.*24.*3600.) !2m
            7504     4                         ENDIF
            7505     4                         IF(timebl_option .EQ. 1 .AND. lbefore_bl ) THEN
            7506     4                           ss_restore_time_all=0.
            7507     4                         ENDIF
            7508     3                       ENDIF
            7509     2               
            7510     2               
            7511     3                       IF(suv_restore_time .GE. 0.) THEN
            7512     3                         suv_restore_time=fratio*suv_restore_time
            7513     3                       ELSE
            7514     4                         IF(timebl_option .EQ. 0 .AND. fratio .LT. 1.) THEN
            7515     4                           suv_restore_time=fratio*(2.*30.*24.*3600.) !2m
            7516     4                         ENDIF
            7517     4                         IF(timebl_option .EQ. 1 .AND. lbefore_bl ) THEN
            7518     4                           suv_restore_time=0.
            7519     4                         ENDIF
            7520     3                       ENDIF
            7521     3                       IF(suv_restore_time_all .GE. 0.) THEN
            7522     3                         suv_restore_time_all=fratio*suv_restore_time_all
            7523     3                       ELSE
            7524     4                         IF(timebl_option .EQ. 0 .AND. fratio .LT. 1.) THEN
            7525     4                           suv_restore_time_all=fratio*(2.*30.*24.*3600.) !2m
            7526     4                         ENDIF
            7527     4                         IF(timebl_option .EQ. 1 .AND. lbefore_bl ) THEN
            7528     4                           suv_restore_time_all=0.
            7529     4                         ENDIF
            7530     3                       ENDIF
            7531     2               
            7532     2               
            7533     2               !        IF(GDCHK3 .AND. jk.EQ.1) print *,"ltimeblending=",ltimeblending, &
            7534     2               !                       ",fratio=",fratio,",jk=",jk, &
            7535     2               !                       ",st_restore_time=",st_restore_time, &
            7536     2               !                       ",ss_restore_time=",ss_restore_time, &
            7537     2               !                       ",suv_restore_time=",suv_restore_time, &
            7538     2               !                       ",st_restore_time_all=",st_restore_time_all, &
            7539     2               !                       ",ss_restore_time_all=",ss_restore_time_all, &
            7540     2               !                       ",suv_restore_time_all=",suv_restore_time_all
            7541     2                     ENDIF
            7542     1               
            7543     1               !
            7544     1               !     3.1 Determining restore temperature at each level
            7545     2                     IF(lmixedlayer .and. jk .LT. jkmixing) THEN
            7546     2                     ! nudging to obstsw at [0m, 10m] or at waterbed(=nle)
            7547     2                       CALL nudging_sit_viff_gd_sfc(jl,jk,st_restore_time,ss_restore_time,restore_temp,restore_salt,&
            7548     2                                                    suv_restore_time,restore_u,restore_v,fratio,                    &
            7549     2                                                    st_restore_time_all,ss_restore_time_all,suv_restore_time_all)
            7550     2               !ps      ELSEIF ( jk.LE.jk10) THEN
            7551     2                     ELSEIF ( jk.LT.jk10) THEN
            7552     2                     ! nudging to obstsw at [0m, 10m] or at waterbed(=nle)
            7553     2                       CALL nudging_sit_viff_gd_sfc(jl,jk,st_restore_time,ss_restore_time,restore_temp,restore_salt,&
            7554     2                                                    suv_restore_time,restore_u,restore_v,fratio,                    &
            7555     2                                                    st_restore_time_all,ss_restore_time_all,suv_restore_time_all)
            7556     2                     ELSE
            7557     2                     ! for depth > 10 m
            7558     3                       IF (lgodas .OR. lwoa0) THEN
            7559     4                         IF ((pobswt(jl,jk).NE.xmissing).AND.(st_restore_time.GT.0.)) THEN
            7560     4                           restore_temp=(pobswt(jl,jk)-pwt(jl,jk))*(1.-0.5**(zdtime/st_restore_time))
            7561     4                           ! obsws  vertical index start at 1
            7562     4                         ELSEIF ((pobswt(jl,jk).NE.xmissing).AND.(st_restore_time.EQ.0.)) THEN
            7563     4                           restore_temp=(pobswt(jl,jk)-pwt(jl,jk))
            7564     4                         ELSEIF (st_restore_time.LT.0.) THEN
            7565     4                         !! no nudging
            7566     4                           restore_temp=0.
            7567     4                         ELSE
            7568     5                           IF (.NOT.ldeep_water_nudg) THEN
            7569     5                             restore_temp=0.
            7570     5                           ELSE
            7571     5                           !! no pobswt data, assume restore_temp to be that of the previous level
            7572     5                           ENDIF
            7573     4                         ENDIF
            7574     4                         IF ((pobsws(jl,jk).NE.xmissing).AND.(ss_restore_time.GT.0.)) THEN
            7575     4                           restore_salt=(pobsws(jl,jk)-pws(jl,jk))*(1.-0.5**(zdtime/ss_restore_time))
            7576     4                           ! obsws  vertical index start at 1
            7577     4                         ELSEIF ((pobsws(jl,jk).NE.xmissing).AND.(ss_restore_time.EQ.0.)) THEN
            7578     4                           restore_salt=(pobsws(jl,jk)-pws(jl,jk))
            7579     4                         ELSEIF (ss_restore_time.LT.0.) THEN
            7580     4                           restore_salt=0.
            7581     4                         ELSE
            7582     5                           IF (.NOT.ldeep_water_nudg) THEN
            7583     5                             restore_salt=0.
            7584     5                           ELSE
            7585     5                           !! no pobsws data, assume restore_temp to be that of the previous level
            7586     5                           ENDIF
            7587     4                         ENDIF
            7588     4                         IF ((pobswu(jl,jk).NE.xmissing).AND.(suv_restore_time.GT.0.)) THEN
            7589     4                           restore_u=(pobswu(jl,jk)-pwu(jl,jk))*(1.-0.5**(zdtime/suv_restore_time))
            7590     4                           ! obsws  vertical index start at 1
            7591     4                         ELSEIF ((pobswu(jl,jk).NE.xmissing).AND.(suv_restore_time.EQ.0.)) THEN
            7592     4                           restore_u=(pobswu(jl,jk)-pwu(jl,jk))
            7593     4                         ELSEIF (suv_restore_time.LT.0.) THEN
            7594     4                           restore_u=0.
            7595     4                         ELSE
            7596     5                           IF (.NOT.ldeep_water_nudg) THEN
            7597     5                             restore_u=0.
            7598     5                           ELSE
            7599     5                           !! no pobsws data, assume restore_temp to be that of the previous
            7600     5                           !level
            7601     5                           ENDIF
            7602     4                         ENDIF
            7603     4                         IF ((pobswv(jl,jk).NE.xmissing).AND.(suv_restore_time.GT.0.)) THEN
            7604     4                           restore_v=(pobswv(jl,jk)-pwv(jl,jk))*(1.-0.5**(zdtime/suv_restore_time))
            7605     4                           ! obsws  vertical index start at 1
            7606     4                         ELSEIF ((pobswv(jl,jk).NE.xmissing).AND.(suv_restore_time.EQ.0.)) THEN
            7607     4                           restore_v=(pobswv(jl,jk)-pwv(jl,jk))
            7608     4                         ELSEIF (suv_restore_time.LT.0.) THEN
            7609     4                           restore_v=0.
            7610     4                         ELSE
            7611     5                           IF (.NOT.ldeep_water_nudg) THEN
            7612     5                             restore_v=0.
            7613     5                           ELSE
            7614     5                           !! no pobsws data, assume restore_temp to be that of the previous
            7615     5                           !level
            7616     5                           ENDIF
            7617     4                         ENDIF
            7618     3                       ELSE
            7619     3                        ! no woa data
            7620     4                          IF (st_restore_time.LT.0.) THEN
            7621     4                          !! no nudging
            7622     4                            restore_temp=0.
            7623     4                          ELSE
            7624     5                            IF (.NOT.ldeep_water_nudg) THEN
            7625     5                            !! no nudging
            7626     5                              restore_temp=0.
            7627     5                            ELSE
            7628     5                            !! no pobswt data, assume restore_temp to be that of the previous level
            7629     5                            ENDIF
            7630     4                          ENDIF
            7631     4                          IF (ss_restore_time.LT.0.) THEN
            7632     4                            restore_salt=0.
            7633     4                          ELSE
            7634     5                            IF (.NOT.ldeep_water_nudg) THEN
            7635     5                            !! no nudging
            7636     5                              restore_salt=0.
            7637     5                            ELSE
            7638     5                            !! no pobsws data, assume restore_temp to be that of the previous level
            7639     5                            ENDIF
            7640     4                          ENDIF
            7641     3                        ENDIF
            7642     2                     ENDIF
            7643     1               
            7644     1               !     3.2 Nudging at each level
            7645     1               !      IF(GDCHK3) print *,"before restore,jk=",jk,",pwt(jl,jk)=",pwt(jl,jk),",restore_temp=",restore_temp
            7646     1                     pwt(jl,jk)= pwt(jl,jk)+restore_temp
            7647     1               !      IF(GDCHK3) print *,"after restore,jk=",jk,",pwt(jl,jk)=",pwt(jl,jk),",restore_temp=",restore_temp
            7648     1                     pws(jl,jk)= pws(jl,jk)+restore_salt
            7649     1               
            7650     1                     pwu(jl,jk)= pwu(jl,jk)+restore_u
            7651     1                     pwv(jl,jk)= pwv(jl,jk)+restore_v
            7652     1               
            7653     1               !ps      IF(GDCHK3) WRITE(nerr,*) "before random:pwu(",jl,",",jk,")=",pwu(jl,jk),",pwv=",pwv(jl,jk)
            7654     1               !ps      call random_number(urand)
            7655     1               !ps      urand=0.01*(urand*2.-1.)      !-0.05<=urand<0.05
            7656     1               !ps      pwu(jl,jk)=pwu(jl,jk)*(1.+urand)
            7657     1               !ps      pwv(jl,jk)=pwv(jl,jk)*(1.+urand)
            7658     1               !ps      IF(GDCHK3) then
            7659     1               !ps        WRITE(nerr,*) "after random: urand=",urand,",pwu(",jl,",",jk,")=",pwu(jl,jk),",pwv=",pwv(jl,jk)
            7660     1               !ps      ENDIF
            7661     1               
            7662     1               !     calc acc. nudging flux (positive into the water column)
            7663     1               !     Note that energy in skin layer (jk=0) has been accounted in the first water layer (jk=1)
            7664     1               !ps      IF ((jk.NE.0).AND.(hw(jk).NE.xmissing)) THEN
            7665     1               !ps
            7666     1               !      IF(GDCHK3) then
            7667     1               !        WRITE(nerr,*) "before,myrank=",myrank,",pwtfn(",jl,",",jk,")=",pwtfn(jl,jk)&
            7668     1               !                ,",restore_temp=",restore_temp,"pawtfl(jl,jk)=",pawtfl(jl,jk)&
            7669     1               !                ,",zdtime=",zdtime,",pobswt(jl,jk)=",pobswt(jl,jk)&
            7670     1               !                ,"pwt(jl,jk)=",pwt(jl,jk),"st_restore_time=",st_restore_time
            7671     1               !      ENDIF
            7672     1               !ps
            7673     1                       pwtfn(jl,jk)=pwtfn(jl,jk)+restore_temp+pawtfl(jl,jk)*zdtime           ! v9.8 including added pawtfl
            7674     1                       pwsfn(jl,jk)=pwsfn(jl,jk)+restore_salt+pawsfl(jl,jk)*zdtime           ! v9.8 including added pawsfl
            7675     1                       pwtfn0(jl,jk)=pwtfn0(jl,jk)+restore_temp                              ! v9.8 including added pawtfl
            7676     1                       pwsfn0(jl,jk)=pwsfn0(jl,jk)+restore_salt                              ! v9.8 including added pawsfl
            7677     1               !ps      ENDIF
            7678     1               !ps
            7679     2                     IF(GDCHK2) then
            7680     2                       WRITE(nerr,*) "after,myrank=",myrank,",pwtfn(",jl,",",jk,")=",pwtfn(jl,jk) &
            7681     2                                    ,",pawtfl=",pawtfl(jl,jk)
            7682     2                       WRITE(nerr,*) "after,myrank=",myrank,",pwtfn0(",jl,",",jk,")=",pwtfn0(jl,jk)
            7683     2                     ENDIF
            7684     1               !ps
            7685     1                     jk=jk+1
            7686     1                   END DO
            7687                     
            7688     1                   IF (GDCHK2) then
            7689     1                      WRITE(nerr,*) "I am leaving nudging_sit_viff_gd"
            7690     1                   ENDIF
            7691                       END SUBROUTINE nudging_sit_viff_gd
            7692                       ! ----------------------------------------------------------------------
            7693                       SUBROUTINE output2
            7694                       !!!! A DUPLICATE VERSION of sit_vdiff_init
            7695                       !
            7696                       !-----------------------------------------------------------------
            7697                       !
            7698                       !*    OUTPUT: WRITE DIAGNOSTIC VARIABLES
            7699                       !
            7700                       !-----------------------------------------------------------------
            7701                         !!! USE mo_mpi,           ONLY: mpp_pe()
            7702                         IMPLICIT NONE
            7703                     
            7704                         INTEGER jk
            7705                         real:: tmp
            7706                     
            7707                       !
            7708                       !!!  CALL pzcord(jl,jrow)   ! bjt 2010/02/21
            7709                         WRITE(nerr,*) "kbdim=", kbdim, "kproma=",kproma
            7710     1                   IF (nle.GE.1) THEN
            7711     1                 !     water exists
            7712     1                     WRITE(nerr,*) "Water exist, nle=", nle
            7713     1                   ELSE
            7714     1                 !     soil only
            7715     1                     WRITE(nerr,*) "Soil only, nle=", nle
            7716     1                   ENDIF
            7717                         WRITE(nerr,2300) "pe,","jl,","row,","lat,","lon,","step,","","","we,","lw,","tsi0,","tsi1,","","","obswtb,","ptsw,"
            7718                         WRITE(nerr,2301) mpp_pe(),jl,jrow,plat(jl),plon(jl),istep,0,0.,pzsi(jl,0),psilw(jl,0),&
            7719                       &  ptsnic(jl,0),ptsnic(jl,1),0.,0.,pobswtb(jl),ptsw(jl)
            7720                     
            7721                         WRITE(nerr,2301) mpp_pe(),jl,jrow,plat(jl),plon(jl),istep,1,1.,pzsi(jl,1),psilw(jl,1),&
            7722                       &  ptsnic(jl,2),ptsnic(jl,3),0.,0.,pobswtb(jl),ptsw(jl)
            7723                       !
            7724                         WRITE(nerr,2300) "pe,","jl,","row,","lat,","lon,","step,","k,","z,", "wt,", "ws,", "wu,", "wv,",&
            7725                       &  "wtke,", "wkh,","wldisp,","wlmx,","awtfl,","awtfl0,","awufl,","awvfl,","awsfl,","awtkefl,","obswt,",",rhom,","sftobswt,"
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhom, z
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            7726     1   s    s          DO jk = 0, nle+1
            7727     1   m    m            WRITE(nerr,2301) mpp_pe(),jl,jrow,plat(jl),plon(jl),istep,jk,z(jk),&
            7728     1                 &     pwt(jl,jk),pws(jl,jk),pwu(jl,jk),pwv(jl,jk),&
            7729     1                 &     pwtke(jl,jk),pwkh(jl,jk),pwldisp(jl,jk),pwlmx(jl,jk), &
            7730     1                 &     pawtfl(jl,jk)*1000.,pawtfl0(jl,jk),pawufl(jl,jk)*1000.,pawvfl(jl,jk)*1000.,pawsfl(jl,jk)*1000.,pawtkefl(jl,jk), &
            7731     1                 &     pobswt(jl,jk),rhom(jk),psftobswt(jl,jk)
            7732     1   p    v          END DO
            7733                     
            7734                       !
            7735                         RETURN
            7736                       !
            7737                        2200 FORMAT(1X,3(A4),2(A9),1(A4),2(2(A10),2(A9)),1(A9), 1(A10))
            7738                       !ps 2201 FORMAT(1X,4(I3,","),1(I9,","),2(2(E9.2,","),2(F8.3,",")),&
            7739                        2201 FORMAT(1X,3(I3,","),2(F8.2,","),1(I3,","),4(F10.3,","),1(I9,","),2(2(E9.2,","),2(F8.3,",")),&
            7740                       &       1(F8.3,","), 1(E10.3,","))
            7741                       !
            7742                     !ps   2300 FORMAT(1X,4A4,     1A10,1A4,1A11,4A9,2A10,10A9)
            7743                           2300 FORMAT(1X, A4,A5,A4,2A8,A6,A4,1A11,4A9,2A10,11A9)
            7744                       !ps 2301 FORMAT(1X,4(I3,","),1(I9,","),1(I3,","),1(F10.4,","),1(F8.3,","),2(F8.4,","),&
            7745                       !!! 2301 FORMAT(1X,3(I3,","),2(F8.2,","),2(I3,","),1(F10.0,","),1(F8.3,","),1(F8.4,","),&
            7746                       !!!&       2(F8.3,","),2(E9.2,","),10(F8.3,","))
            7747                     !ps   2301 FORMAT(1X,3(I3,","),2(F8.2,","),2(I3,","),1(F10.0,","),1(F8.3,","),1(F8.3,","),&
            7748                     !ps  &       2(F8.2,","),2(E9.2,","),10(F8.3,","))
            7749                           2301 FORMAT(1X,(I3,","),(I4,","),(I3,","),2(F7.2,","),(I5,","),(I3,","),1(F10.4,","),1(F8.3,","),1(F8.4,","),&
            7750                       &       2(F8.4,","),2(E9.2,","),11(F8.3,","))
            7751                       !
            7752                       END SUBROUTINE output2
            7753                     END SUBROUTINE sit_vdiff
            7754                     ! **********************************************************************
            7755                     
            7756                     !!!  SUBROUTINE sit_vdiff_end (Sit)
            7757                       SUBROUTINE sit_vdiff_end ()
            7758                         IMPLICIT NONE
            7759                         !!! type (sit_vdiff_data_type), intent(inout) :: Sit
            7760                         integer           :: k
            7761                         integer           :: unit
            7762                         character(len=22) :: restart='RESTART/sit_vdiff.res'
            7763                     
            7764                         !!!if (conservation_check) then
            7765                         !!!   do k=1,4
            7766                         !!!      CALL mpp_sum(h2o(k))
            7767                         !!!      CALL mpp_sum(heat(k))
            7768                         !!!   end do
            7769                         !!!   if (mpp_pe()==mpp_root_pe()) then
            7770                         !!!      print *
            7771                         !!!      print '(a10,5a13)',   'ICE MODEL ','   AT START  ', &
            7772                         !!!           ' TOP FLUX DN.', &
            7773                         !!!           ' BOT FLUX DN.', &
            7774                         !!!           '   AT END    ', &
            7775                         !!!           '   ERROR     '
            7776                         !!!      print '(a10,5es13.5)','WATER     ', h2o , h2o (4)-(h2o (1)+h2o (2)-h2o (3))
            7777                         !!!      print '(a10,5es13.5)','HEAT      ', heat, heat(4)-(heat(1)+heat(2)-heat(3))
            7778                         !!!      print *
            7779                         !!!   end if
            7780                         !!!end if
            7781                     
            7782                         CALL sit_vdiff_restart()
            7783                     
            7784                         !--- release memory ------------------------------------------------
            7785                     
            7786                     
            7787                         !!!! Interpolation array
            7788                         !!!!nxj,                    !  nxj      : number of local longitudes (echam, =nproma=nbdim)
            7789                         !!!!!!  gauss grid description
            7790                         !!!!krow,                   !  krow     : sequential index (=1)
            7791                         !!!!!! - water body or ml_ocean variables
            7792                         !!!!echam, check GFS    DEALLOCATE (Sit%slm)             !  pslm      : sea land fraction (1. = land, 0. = sea/lakes)
            7793                         !!!!echam, check GFS    DEALLOCATE (Sit%seaice)          !  pseaice   : ice cover (fraction of 1-SLM) (0-1)                                                I/O
            7794                         !!!!echam, check GFS    DEALLOCATE (Sit%alake)           !  palake    : lake fraction of grid box
            7795                         !!!!echam, check GFS    DEALLOCATE (Sit%sni)             !  psni      : snow thickness over ice (m in water equivalent)                                    I/O
            7796                         !!!!echam, check GFS    DEALLOCATE (Sit%siced)           !  psiced    : ice thickness (m in water equivalent)                                              I/O
            7797                         !!!!echam, check GFS    DEALLOCATE (Sit%tsi)             !  ptsi      : surface temperature of ice (K)
            7798                         !!!!echam, check GFS    DEALLOCATE (Sit%tsw)             !  ptsw      : skin temperatrue (K) over water                                                    O
            7799                         !!!!echam, check GFS    DEALLOCATE (Sit%ssw)             !  pssw      : skin salinity (PSU) over water                                                    O
            7800                         !!!!echam, check GFS    DEALLOCATE (Sit%tsl)             !  ptsl      : calcuated Earth's skin temperature from vdiff/tsurf at t+dt (K)                    I/O
            7801                         !!!!echam, check GFS    DEALLOCATE (Sit%tslm)            !  ptslm     : calcuated Earth's skin temperature from vdiff/tsurf at t (K)                       I/O
            7802                         !!!!echam, check GFS    DEALLOCATE (Sit%tslm1)           !  ptslm1    : calcuated Earth's skin temperature from vdiff/tsurf at t-dt (K)                    I/O
            7803                         !!!!echam, check GFS    DEALLOCATE (Sit%fluxw)           !  pfluxw    : net surface energy flux over open water per water fraction                         I
            7804                         !!!!echam, check GFS                                 !              (icesheet+openwater) (w/m2) (positive upward)
            7805                         !!!!echam, check GFS                                 !              = -(net solar + net longwave - sensible heat - latent heat)
            7806                         !!!!echam, check GFS    DEALLOCATE (Sit%dfluxs)          !  pdfluxs   : dG/dT (W/m2/K) (positive upward)                                                   I
            7807                         !!!!echam, check GFS    DEALLOCATE (Sit%soflw)           !  psoflw    : net SW flux over open water per water fraction (w/m2) (positive downward)          I
            7808                         !!!!echam, check GFS    DEALLOCATE (Sit%fluxi)           !  pfluxi    : net surface energy flux over icesheet per water fraction                           I
            7809                         !!!!echam, check GFS                                 !              (icesheet+openwater) (w/m2) (positive upward)
            7810                         !!!!echam, check GFS                                 !              = -(net solar + net longwave - sensible heat - latent heat)
            7811                         !!!!echam, check GFS    DEALLOCATE (Sit%sofli)           !  psofli    : net SW flux over over icesheet per water fraction (w/m2) (positive downward)       I
            7812                         !!!!echam, check GFS
            7813                         !!!!echam, check GFS!!! 2-d SIT vars
            7814                         !!!!echam, check GFS    DEALLOCATE (Sit%disch)           !  pdisch   : surface runoff into ocean (m/s)                                                     I
            7815                         !!!!echam, check GFS    DEALLOCATE (Sit%ustrw)           !  taucx    : u-stress (Pa) over water at current time step                                       I/O
            7816                         !!!!echam, check GFS                                 !              (set to zero if snow/ice on top)
            7817                         !!!!echam, check GFS    DEALLOCATE (Sit%vstrw)           !  taucy    : v-stress (Pa) over water at current time step                                       I
            7818                         !!!!echam, check GFS                                 !              (set to zero if snow/ice on top)
            7819                         !!!!echam, check GFS    DEALLOCATE (Sit%temp2)           !  ptemp2    : 2 m temperature (K) at current time step                                           I
            7820                         !!!!echam, check GFS    DEALLOCATE (Sit%wind10w)         !  pwind10w     : 10m windspeed over water (m/s)                                                  I
            7821                         !!!!echam, check GFS    DEALLOCATE (Sit%ocu)             !  pocu      : ocean eastw. velocity (m/s)                                                        O
            7822                         !!!!echam, check GFS    DEALLOCATE (Sit%ocv)             !  pocv      : ocean northw. velocity (m/s)                                                       O
            7823                         !!!
            7824                         !!!!!! 2-d SIT vars (sit variable, allocate as 2D)
            7825                         !!!DEALLOCATE (Sit%obsseaice)       !  pobsseaice  : observed sea ice fraction (fraction)                                             I
            7826                         !!!DEALLOCATE (Sit%obstsw)          !  pobswtb     : observed bulk sea surface temperature (K)                                        I
            7827                         !!!DEALLOCATE (Sit%obswsb)          !  pobswsb    : observed salinity (PSU, 0/00)                                                     I
            7828                         !!!DEALLOCATE (Sit%sitmask)         !  psitmask : mask for sit(1=.TRUE., 0=.FALSE.                                                    I
            7829                         !!!DEALLOCATE (Sit%bathy)           !  pbathy  : bathymeter (topography or orography) of ocean (m)                                    I
            7830                         !!!DEALLOCATE (Sit%ctfreez2)        !  pctfreez2 : ref water freezing temperature (K)                                                 I
            7831                         !!!DEALLOCATE (Sit%wlvl)         !  pwlvl  : current water level (ice/water interface) a water body grid                           I/O
            7832                         !!!DEALLOCATE (Sit%ocnmask)         !  pocnmask : fractional mask for 3-D ocean grid (0-1)                                            I
            7833                         !!!DEALLOCATE (Sit%obox_mask)       !  obox_mask : 3-D ocean nudging mask, =0: nudging, = 1 (>0): nudging                             I
            7834                         !!!DEALLOCATE (Sit%wtb)          !  pwtb: bulk water temperature (K)                                                               O
            7835                         !!!DEALLOCATE (Sit%wub)          !  pwub: bulk water u current (m/s)                                                               O
            7836                         !!!DEALLOCATE (Sit%wvb)          !  pwvb: bulk water v current (m/s)                                                               O
            7837                         !!!DEALLOCATE (Sit%wsb)          !  pwsb: bulk water salinity (PSU)                                                                O
            7838                         !!!DEALLOCATE (Sit%fluxiw)          !  pfluxiw: over-water net surface heat flux (W/m2, + upward, i.e., from ocean))                  O
            7839                         !!!DEALLOCATE (Sit%pme2)            !  ppme2: net fresh water into ocean (P-E+ice_corr) (m/s, + downward)                             O
            7840                         !!!DEALLOCATE (Sit%subfluxw)        !  psubfluxw: subsurface ocean heat flux (W/m2, + upward)                                         O
            7841                         !!!DEALLOCATE (Sit%wsubsal)         !  pwsubsal: subsurface ocean salinity flux (m*PSU/s, + upward)                                   O
            7842                         !!!DEALLOCATE (Sit%cc)              !  pcc: cold content per water fraction (ice sheet+openwater) (J/m2)
            7843                         !!!                                !    (energy need to melt snow and ice, i.e., energy below liquid water at tmelt)                 I/O
            7844                         !!!DEALLOCATE (Sit%hc)              !  phc: heat content per water fraction (ice sheet+openwater) (J/m2)
            7845                         !!!                                !    (energy of a water column above tmelt)                                                       I/O
            7846                         !!!DEALLOCATE (Sit%engwac)          !  pengwac: accumulated energy per water fraction (ice sheet+openwater) (+ downward, J/m2)
            7847                         !!!                             !           (pfluxw+pfluxi+rain/snow advected energy in respect to liquid water at
            7848                         !!!                             !           tmelt)*dt                                                                             I/O
            7849                         !!!                             !!!  pengw: mean net surface heat flux per water fraction (ice sheet+openwater)
            7850                         !!!                             !!!    (+ downward, W/m2)                                                                         I/O
            7851                         !!!                             !!!  pengw2: mean snow corrected net surface heat flux per water fraction
            7852                         !!!                             !!!    (ice sheet+openwater) (+ downward, W/m2)
            7853                         !!!                             !!!    (pfluxw+pfluxi+rain/snow advected heat flux in respect to liquid water at
            7854                         !!!                             !!!     tmelt)                                                                                    I/O
            7855                         !!!!!!              engw(:,:)engw2(:,:)                              &
            7856                         !!!DEALLOCATE (Sit%sc)              !  psc: salinity content per water fraction (ice sheet+openwater) (PSU*m)                         I/O
            7857                         !!!DEALLOCATE (Sit%saltwac)         !  psaltwac: accumulated salt into water fraction (+ downward, PSU*m)                             I/O
            7858                         !!!
            7859                         !!!! implicit with vdiff
            7860                         !!!!echam, check GFS    DEALLOCATE (Sit%slm)             !  pslm: land fraction [0-1]                                                                      I
            7861                         !!!!echam, check GFS    DEALLOCATE (Sit%grndcapc)        !  pgrndcapc: areal heat capacity of the uppermost sit layer (snow/ice/water)
            7862                         !!!!echam, check GFS                                    !       (J/m**2/K)                                                                                I/O
            7863                         !!!!echam, check GFS    DEALLOCATE (Sit%grndhflx)        !  pgrndhflx: ground heat flux below the surface (W/m**2)
            7864                         !!!!echam, check GFS                                    !          (+ upward, into the skin layer)                                                        I/O
            7865                         !!!!echam, check GFS    DEALLOCATE (Sit%grndflux)        !  pgrndflx:  acc. ground heat flux below the surface (W/m**2*s)
            7866                         !!!                                    !          (+ upward, into the skin layer)                                                        I/O
            7867                         !!!
            7868                         !!!! - 2D from mo_memory_g3b (sit variables, allocate as 3D)
            7869                         !!!DEALLOCATE (Sit%obswt)         !  pobswt: observed potentail water temperature (K)                                          I/O
            7870                         !!!DEALLOCATE (Sit%obsws)         !  pobsws: observed salinity (PSU, 0/00)                                                     I/O
            7871                         !!!DEALLOCATE (Sit%obswu)         !  pobswu: observed u-current (m/s)                                                          I/O
            7872                         !!!DEALLOCATE (Sit%obswv)         !  pobswv: observed v-current (m/s)                                                          I/O
            7873                         !!!DEALLOCATE (Sit%zsi)        !  pzsi  :
            7874                         !!!                           !        pzsi(jl,0): dry snow water equivalent (m)                                           I/O
            7875                         !!!                           !        pzsi(jl,1): dry ice water equivalent (m)                                            I/O
            7876                         !!!DEALLOCATE (Sit%silw)       !  psilw  :
            7877                         !!!                           !        psilw(jl,0): snow liquid water storage (m)                                          I/O
            7878                         !!!                           !        psilw(jl,1): ice liquid water storage (m)                                           I/O
            7879                         !!!DEALLOCATE (Sit%tsi)        !  ptsnic   :
            7880                         !!!                           !        ptsnic(jl,0): snow skin temperatrue (jk)                                            I/O
            7881                         !!!                           !        ptsnic(jl,1): mean snow temperatrue (jk)                                            I/O
            7882                         !!!                           !        ptsnic(jl,2): ice skin temperatrue (jk)                                             I/O
            7883                         !!!                           !        ptsnic(jl,3): mean ice temperatrue (jk)                                             I/O
            7884                         !!!
            7885                         !!!DEALLOCATE (Sit%wt)         !  pwt      : potential water temperature (K)                                                I/O
            7886                         !!!DEALLOCATE (Sit%wu)         !  pwu      : u current (m/s)                                                                I/O
            7887                         !!!DEALLOCATE (Sit%wv)         !  pwv      : v current (m/s)                                                                I/O
            7888                         !!!DEALLOCATE (Sit%ww)         !  pww      : w current (m/s)                                                                I/O
            7889                         !!!DEALLOCATE (Sit%ws)         !  pws      : practical salinity (0/00)                                                      I/O
            7890                         !!!DEALLOCATE (Sit%wtke)       !  pwtke    : turbulent kinetic energy (M2/S2)                                               I/O
            7891                         !!!DEALLOCATE (Sit%wlmx)       !  pwlmx    : mixing length (m)                                                              O
            7892                         !!!DEALLOCATE (Sit%wldisp)     !  pwldisp  : dissipation length (m)                                                         O
            7893                         !!!DEALLOCATE (Sit%wkm)        !  pwkm     : eddy diffusivity for momentum (m2/s)                                           O
            7894                         !!!DEALLOCATE (Sit%wkh)        !  pwkh     : eddy diffusivity for heat (m2/s)                                               O
            7895                         !!!DEALLOCATE (Sit%wrho)          !  pwrho1000: potential temperature at 1000 m (PSU)                                          O
            7896                         !!!DEALLOCATE (Sit%wtfn)          !  pwtfn  : nudging flux into sit-ocean at each level (W/m**2)                               I/O
            7897                         !!!DEALLOCATE (Sit%wsfn)          !  pwsfn  : nudging salinity flux into sit-ocean at each level (PSU*m/s)                     I/O
            7898                         !!!DEALLOCATE (Sit%wtfns)         !  pwtfns : nudging flux into sit-ocean for an entire column (W/m**2), i.e.
            7899                         !!!                           !        pwtfns=SUM(pwtfn(jl,:))                                                             I/O
            7900                         !!!DEALLOCATE (Sit%wsfns)         !  pwsfn  : nudging salinity flux into sit-ocean for an entire column (PSU*m/s),
            7901                         !!!                           !        i.e., pwsfns=SUM(pwsfn(jl,:)                                                        I/O
            7902                         !!!DEALLOCATE (Sit%awufl)         !  pawufl : advected u flux at each level (positive into ocean) (m/s*m/s)                    I
            7903                         !!!DEALLOCATE (Sit%awvfl)         !  pawvfl : advected v flux at each level (positive into ocean) (m/s*m/s)                    I
            7904                         !!!DEALLOCATE (Sit%awtfl)         !  pawtfl : advected temperature flux at each level (positive into ocean) (W/m2)             I
            7905                         !!!DEALLOCATE (Sit%awsfl)         !  pawsfl : advected salinity flux at each level (positive into ocean) (PSU*m/s)             I
            7906                         !!!DEALLOCATE (Sit%awtkefl)       !  pawtkefl : advected tke at each level (positive into ocean) (m3/s3)                       I
            7907                         !!!
            7908                         !!!!!! - variables internal to physics
            7909                         !!!!!!echam, check GFS    DEALLOCATE (Sit%zevapw)        !  pevapw   : evaporation from water surface (kg/m2/s) (positive downward)                   I
            7910                         !!!!!!echam, check GFS    DEALLOCATE (Sit%rsfl)          !  prsfl    : large scale rain flux at the surface (kg/m2/s) (positive downward)             I
            7911                         !!!!!!echam, check GFS    DEALLOCATE (Sit%rsfc)          !  prsfc    : convective rain flux at the surface (kg/m2/s) (positive downward)              I
            7912                         !!!!!!echam, check GFS    DEALLOCATE (Sit%ssfl)          !  pssfl    : large scale snow flux at the surface (kg/m2/s) (positive downward)             I
            7913                         !!!!!!echam, check GFS    DEALLOCATE (Sit%ssfc)          !  pssfc    : convective snow flux at the surface (kg/m2/s) (positive downward)              I
            7914                         !!!!end sit_vdiff variable

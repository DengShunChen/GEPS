            7936                       END SUBROUTINE sit_vdiff_end
            7937                       !#######################################################################
            7938                     
            7939                       SUBROUTINE init_convect_tables
            7940                     
            7941                         !!! USE sit_constants_mod, ONLY: alv, als, cpd, rd, rv, tmelt, &
            7942                         !!!                         c3les, c3ies, c4les, c4ies, c5les, c5ies
            7943                     
            7944                         real, PARAMETER :: zavl1 = -6096.9385
            7945                         real, PARAMETER :: zavl2 =    21.2409642
            7946                         real, PARAMETER :: zavl3 =    -2.711193
            7947                         real, PARAMETER :: zavl4 =     1.673952
            7948                         real, PARAMETER :: zavl5 =     2.433502
            7949                     
            7950                         real, PARAMETER :: zavi1 = -6024.5282
            7951                         real, PARAMETER :: zavi2 =    29.32707
            7952                         real, PARAMETER :: zavi3 =     1.0613868
            7953                         real, PARAMETER :: zavi4 =    -1.3198825
            7954                         real, PARAMETER :: zavi5 =    -0.49382577
            7955                     
            7956                         real :: z5alvcp, z5alscp, zalvdcp, zalsdcp
            7957                         real :: ztt, zldcp
            7958                         real :: zcvm3, zcvm4, zcvm5
            7959                         real :: zavm1, zavm2, zavm3, zavm4, zavm5
            7960                     
            7961                         INTEGER :: it
            7962                     
            7963                         z5alvcp = c5les*alv/cpd
            7964                         z5alscp = c5ies*als/cpd
            7965                     
            7966                         zalvdcp = alv/cpd
            7967                         zalsdcp = als/cpd
            7968                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tlucuc, tlucua, tlucub, tlucuaw
                                   <<< Loop-information  End >>>
            7969     1  pp    v          DO it = jptlucu1, jptlucu2
            7970     1   p    v            ztt = 0.001*it
            7971     2   p    v            IF ((ztt-tmelt) > 0.0) THEN
            7972     2   p    v              zcvm3 = c3les
            7973     2   p    v              zcvm4 = c4les
            7974     2   p    v              zcvm5 = z5alvcp
            7975     2   p    v              zldcp = zalvdcp
            7976     2   p    v              zavm1 = zavl1
            7977     2   p    v              zavm2 = zavl2
            7978     2   p    v              zavm3 = zavl3
            7979     2   p    v              zavm4 = zavl4
            7980     2   p    v              zavm5 = zavl5
            7981     2   p    v            ELSE
            7982     2   p    v              zcvm3 = c3ies
            7983     2   p    v              zcvm4 = c4ies
            7984     2   p    v              zcvm5 = z5alscp
            7985     2   p    v              zldcp = zalsdcp
            7986     2   p    v              zavm1 = zavi1
            7987     2   p    v              zavm2 = zavi2
            7988     2   p    v              zavm3 = zavi3
            7989     2   p    v              zavm4 = zavi4
            7990     2   p    v              zavm5 = zavi5
            7991     2   p    v            END IF
            7992     1   p    v            tlucuc(it)  = zldcp
            7993     1   p    v            tlucua(it)  = EXP((zavm1/ztt+zavm2+zavm3*0.01*ztt+zavm4*ztt*ztt*1.e-5+zavm5*LOG(ztt)))*rd/rv
            7994     1   p    v            tlucub(it)  = zcvm5*(1.0/(ztt-zcvm4))**2
            7995     1   p    v            tlucuaw(it) = EXP((zavl1/ztt+zavl2+zavl3*0.01*ztt+zavl4*ztt*ztt*1.e-5+zavl5*LOG(ztt)))*rd/rv
            7996     1   p    v          END DO
            7997                     
            7998                       END SUBROUTINE init_convect_tables
            7999                     
            8000                       SUBROUTINE lookuperror (name)
            8001                     
            8002                         !!! USE mo_exception,  ONLY: message, finish
            8003                     
            8004                         CHARACTER(len=*), INTENT(in) :: name
            8005                     
            8006                         ! normal run informs only
            8007                         ! CALL message (name, ' lookup table overflow')
            8008                         ! debug run, so stop at problem
            8009                         !!! CALL finish (name, ' lookup table overflow')
            8010                         WRITE (nerr,*) name, ' lookup table overflow'
            8011                         ! reset lookupoverflow for next test
            8012                     
            8013                         lookupoverflow = .FALSE.
            8014                     
            8015                       END SUBROUTINE lookuperror
            8016                     

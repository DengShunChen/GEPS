            4357                     !v.76i
            4358                            gzero=rhoh2o*clw*hew*(pwt(jl,0)-wtm(0))/zdtime-&
            4359                     &                      zsoflw*( FFN(0.)-FFN(-hw(0)) )+&
            4360                     &                      rhoh2o*clw*pwkh(jl,nls+1)*(wtm(0)-wtm(1))/(z(0)-z(nls+1))

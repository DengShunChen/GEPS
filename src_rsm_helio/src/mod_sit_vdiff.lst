                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4386     3                         DO WHILE ((fcewf.LE.0.).AND.(nle.GE.nls+1))
            4387     4                           IF (nle.EQ.nls+1) THEN
            4388     4                             dz=hw(nle)-wcri
            4389     4               !             remain minimum water layer of thickness wcri
            4390     4               !             to perserve salinity properity
            4391     4                           ELSE
            4392     4                             dz=hw(nls+1)
            4393     4                           ENDIF
            4394     3                           hw1m=hw(nls+1)
            4395     3                           fcewm=fcewf

            7019     3                       ENDIF
            7020     2                     ENDIF
            7021     1                   ELSEIF ((pobswtb(jl).NE.xmissing).AND.(st_restore_time.EQ.0.)) THEN
            7022     1                     restore_temp=(pobswtb(jl)-pwt(jl,jk))
            7023     1                   ELSEIF ((st_restore_time.LT.0.)) THEN

            4286     2               !!!&             -(pfluxw2+zsoflw) )
            4287     2                       ELSEIF (heice.GT.xicri) THEN
            4288     2               !       thick ice layer
            4289     2                         fcew=+(                                                            &
            4290     2               &           (1.-beta)*( rhoice*cice*xkice*(tsim(3)-wtm(0))/(0.5*hice/pseaice(jl))     &
            4291     2               &            -rhowcw*pwkh(jl,nls+1)*(wtm(0)-wtm(nls+1))/(z(0)-z(nls+1))      &
            4292     2               &                     )                                                      &
            4293     2               &           +beta*( rhoice*cice*xkice*(SOL(3)-SOL(4))/(0.5*hice/pseaice(jl))             &
            4294     2               &             -rhowcw*pwkh(jl,nls+1)*(SOL(4)-SOL(5+nls))/(z(0)-z(nls+1))     &
            4295     2               &                 )                                                          &
            4296     2               &           )*zdtime                                                         &
            4297     2               &           +zdtime*(  zsoflw* ( FFN(0.)-FFN(-hw(0)) )                    &
            4298     2               &             -(pfluxw2+zsoflw) )
            4299     2               !         note pwt(jl,0)=wtm(0)=pctfreez2(jl).
            4300     2                       ELSE
            4301     2               !       thin ice layer & thick snow layer
            4302     2                         fcew=+(                                                            &
            4303     2               &           (1.-beta)*( rhosn*csn*xksn*(tsim(1)-tsim(2))/(0.5*hsn/pseaice(jl))        &
            4304     2               &            -rhowcw*pwkh(jl,nls+1)*(wtm(0)-wtm(nls+1))/(z(0)-z(nls+1)) )    &
            4305     2               &           +beta*( rhosn*csn*xksn*(SOL(1)-SOL(2))/(0.5*hsn/pseaice(jl))                 &
            4306     2               &            -rhowcw*pwkh(jl,nls+1)*(SOL(4)-SOL(5+nls))/(z(0)-z(nls+1)) )    &
            4307     2               &           )*zdtime                                                         &
            4308     2               &           +zdtime*(  zsoflw* ( FFN(0.)-FFN(-hw(0)) )                    &
            4309     2               &             -(pfluxw2+zsoflw) )
            4310     2                       ENDIF
            4311     2                       IF (lsit_lw) THEN
            4312     2                         fcew=fcew+zdtime*4.*stbo*(-wtm(nls+1)**3*SOL(4)+wtm(nls+2)**3*SOL(5+nls))
            4313     2                       ENDIF
            4314     1                     ENDIF

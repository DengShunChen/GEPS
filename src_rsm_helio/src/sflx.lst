                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             713     1       f             do k = 1, 4
             714     1       f               et(k) = et(k) * lsubc

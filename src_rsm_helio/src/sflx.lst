             687     1               !            cmcmax, dt, df1, sfcems, sfctmp, t24, th2, fdown, epsca,   !
             688     1               !            bexp, pc, rch, rr, cfactr, slope, kdt, frzx, psisat,       !
             689     1               !            zsoil, dwsat, dksat, zbot, shdfac, ice, rtdis, quartz,     !

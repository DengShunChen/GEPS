             761     1   p    v            enddo
             762                     
             763                           soilwm = -1.0 * (smcmax - smcwlt) * zsoil(1)
             764                           soilww = -1.0 * (smc(1) - smcwlt) * zsoil(1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             765     1  pp    v            do k = 2, nroot
             766     1   p    v              soilwm = soilwm + (smcmax - smcwlt) * (zsoil(k-1) - zsoil(k))
             767     1   p    v              soilww = soilww + (smc(k) - smcwlt) * (zsoil(k-1) - zsoil(k))
             768     1   p    v            enddo
             769                     
             770                           soilw = soilww / soilwm
             771                     !
             772                           return
             773                     
             774                     
             775                     ! =================
             776                           contains
             777                     ! =================
             778                     
             779                     !*************************************!
             780                     !  section-1  1st level subprograms   !
             781                     !*************************************!
             782                     
             783                     !-----------------------------------
             784                           subroutine alcalc
             785                     !...................................
             786                     !  ---  inputs:
             787                     !    &     ( alb, snoalb, shdfac, shdmin, sncovr, tsnow,                &
             788                     !  ---  outputs:
             789                     !    &       albedo                                                     &
             790                     !    &     )
             791                     
             792                     ! ===================================================================== !
             793                     !  description:                                                         !
             794                     !                                                                       !
             795                     !  subroutine alcalc calculates albedo including snow effect (0 -> 1)   !
             796                     !                                                                       !
             797                     !  subprogram called:  none                                             !
             798                     !                                                                       !
             799                     !                                                                       !
             800                     !  ====================  defination of variables  ====================  !
             801                     !                                                                       !
             802                     !  inputs from calling program:                                  size   !
             803                     !     alb      - real, snowfree albedo                             1    !
             804                     !     snoalb   - real, maximum (deep) snow albedo                  1    !
             805                     !     shdfac   - real, areal fractional coverage of green veg.     1    !
             806                     !     shdmin   - real, minimum areal coverage of green veg.        1    !
             807                     !     sncovr   - real, fractional snow cover                       1    !
             808                     !     tsnow    - real, snow surface temperature (k)                1    !
             809                     !                                                                       !
             810                     !  outputs to calling program:                                          !
             811                     !     albedo   - real, surface albedo including snow effect        1    !
             812                     !                                                                       !
             813                     !  ====================    end of description    =====================  !
             814                     !
             815                     !  ---  inputs:
             816                     !     real (kind=kind_phys), intent(in) :: alb, snoalb, shdfac,         &
             817                     !    &       shdmin, sncovr, tsnow
             818                     
             819                     !  ---  outputs:
             820                     !     real (kind=kind_phys), intent(out) :: albedo
             821                     
             822                     !  ---  locals: (none)
             823                     
             824                     !
             825                     !===> ...  begin here
             826                     !
             827                     !  --- ...  snoalb is argument representing maximum albedo over deep snow,
             828                     !           as passed into sflx, and adapted from the satellite-based
             829                     !           maximum snow albedo fields provided by d. robinson and g. kukla
             830                     !           (1985, jcam, vol 24, 402-411)
             831                     
             832                     !         albedo = alb + (1.0-(shdfac-shdmin))*sncovr*(snoalb-alb)
             833                               albedo = alb + sncovr*(snoalb - alb)
             834                     
             835                               if (albedo > snoalb) albedo = snoalb
             836                     
             837                     !  --- ...  base formulation (dickinson et al., 1986, cogley et al., 1990)
             838                     
             839                     !     if (tsnow <= 263.16) then
             840                     !       albedo = snoalb
             841                     !     else
             842                     !       if (tsnow < 273.16) then
             843                     !         tm = 0.1 * (tsnow - 263.16)
             844                     !         albedo = 0.5 * ((0.9 - 0.2*(tm**3)) + (0.8 - 0.16*(tm**3)))
             845                     !       else
             846                     !         albedo = 0.67
             847                     !       endif
             848                     !     endif
             849                     
             850                     !  --- ...  isba formulation (verseghy, 1991; baker et al., 1990)
             851                     
             852                     !     if (tsnow < 273.16) then
             853                     !       albedo = snoalb - 0.008*dt/86400
             854                     !     else
             855                     !       albedo = (snoalb - 0.5) * exp( -0.24*dt/86400 ) + 0.5
             856                     !     endif
             857                     
             858                     !
             859                           return
             860                     !...................................
             861                           end subroutine alcalc
             862                     !-----------------------------------
             863                     
             864                     
             865                     !-----------------------------------
             866                           subroutine canres
             867                     !...................................
             868                     !  ---  inputs:
             869                     !    &     ( nsoil, nroot, swdn, ch, q2, q2sat, dqsdt2, sfctmp,         &
             870                     !    &       sfcprs, sfcems, sh2o, smcwlt, smcref, zsoil, rsmin,        &
             871                     !    &       rsmax, topt, rgl, hs, xlai,                                &
             872                     !  ---  outputs:
             873                     !    &       rc, pc, rcs, rct, rcq, rcsoil                              &
             874                     !    &     )
             875                     
             876                     ! ===================================================================== !
             877                     !  description:                                                         !
             878                     !                                                                       !
             879                     !  subroutine canres calculates canopy resistance which depends on      !
             880                     !  incoming solar radiation, air temperature, atmospheric water vapor   !
             881                     !  pressure deficit at the lowest model level, and soil moisture        !
             882                     !  (preferably unfrozen soil moisture rather than total)                !
             883                     !                                                                       !
             884                     !  source:   jarvis (1976), noilhan and planton (1989, mwr), jacquemin  !
             885                     !            and noilhan (1990, blm)                                    !
             886                     !  see also: chen et al (1996, jgr, vol 101(d3), 7251-7268), eqns       !
             887                     !            12-14 and table 2 of sec. 3.1.2                            !
             888                     !                                                                       !
             889                     !  subprogram called:  none                                             !
             890                     !                                                                       !
             891                     !                                                                       !
             892                     !  ====================  defination of variables  ====================  !
             893                     !                                                                       !
             894                     !  inputs from calling program:                                  size   !
             895                     !     nsoil    - integer, no. of soil layers                       1    !
             896                     !     nroot    - integer, no. of soil layers in root zone (<nsoil) 1    !
             897                     !     swdn     - real, incoming solar radiation                    1    !
             898                     !     ch       - real, sfc exchange coeff for heat and moisture    1    !
             899                     !     q2       - real, air humidity at 1st level above ground      1    !
             900                     !     q2sat    - real, sat. air humidity at 1st level abv ground   1    !
             901                     !     dqsdt2   - real, slope of sat. humidity function wrt temp    1    !
             902                     !     sfctmp   - real, sfc temperature at 1st level above ground   1    !
             903                     !     sfcprs   - real, sfc pressure                                1    !
             904                     !     sfcems   - real, sfc emissivity for lw radiation             1    !
             905                     !     sh2o     - real, volumetric soil moisture                  nsoil  !
             906                     !     smcwlt   - real, wilting point                               1    !
             907                     !     smcref   - real, reference soil moisture                     1    !
             908                     !     zsoil    - real, soil depth (negative sign, as below grd)  nsoil  !
             909                     !     rsmin    - real, mimimum stomatal resistance                 1    !
             910                     !     rsmax    - real, maximum stomatal resistance                 1    !
             911                     !     topt     - real, optimum transpiration air temperature       1    !
             912                     !     rgl      - real, canopy resistance func (in solar rad term)  1    !
             913                     !     hs       - real, canopy resistance func (vapor deficit term) 1    !
             914                     !     xlai     - real, leaf area index                             1    !
             915                     !                                                                       !
             916                     !  outputs to calling program:                                          !
             917                     !     rc       - real, canopy resistance                           1    !
             918                     !     pc       - real, plant coefficient                           1    !
             919                     !     rcs      - real, incoming solar rc factor                    1    !
             920                     !     rct      - real, air temp rc factor                          1    !
             921                     !     rcq      - real, atoms vapor press deficit rc factor         1    !
             922                     !     rcsoil   - real, soil moisture rc factor                     1    !
             923                     !                                                                       !
             924                     !  ====================    end of description    =====================  !
             925                     !
             926                     !  ---  inputs:
             927                     !     integer, intent(in) :: nsoil, nroot
             928                     
             929                     !     real (kind=kind_phys), intent(in) :: swdn, ch, q2, q2sat,         &
             930                     !    &       dqsdt2, sfctmp, sfcprs, sfcems, smcwlt, smcref, rsmin,     &
             931                     !    &       rsmax, topt, rgl, hs, xlai, sh2o(nsoil), zsoil(nsoil)
             932                     
             933                     !  ---  outputs:
             934                     !     real (kind=kind_phys), intent(out) :: rc, pc, rcs, rct, rcq,      &
             935                     !    &       rcsoil
             936                     
             937                     !  ---  locals:
             938                           real (kind=kind_phys) :: delta, ff, gx, rr, part(nsold)
             939                     
             940                           integer :: k
             941                     
             942                     !
             943                     !===> ...  begin here
             944                     !
             945                     !  --- ...  initialize canopy resistance multiplier terms.
             946                     
             947                           rcs = 0.0
             948                           rct = 0.0
             949                           rcq = 0.0
             950                           rcsoil = 0.0
             951                           rc = 0.0
             952                     
             953                     !  --- ...  contribution due to incoming solar radiation
             954                     
             955                           ff = 0.55 * 2.0 * swdn / (rgl*xlai)
             956                           rcs = (ff + rsmin/rsmax) / (1.0 + ff)
             957                           rcs = max( rcs, 0.0001 )
             958                     
             959                     !  --- ...  contribution due to air temperature at first model level above ground
             960                     !           rct expression from noilhan and planton (1989, mwr).
             961                     
             962                           rct = 1.0 - 0.0016 * (topt - sfctmp)**2.0
             963                           rct = max( rct, 0.0001 )
             964                     
             965                     !  --- ...  contribution due to vapor pressure deficit at first model level.
             966                     !           rcq expression from ssib
             967                     
             968                           rcq = 1.0 / (1.0 + hs*(q2sat-q2))
             969                           rcq = max( rcq, 0.01 )
             970                     
             971                     !  --- ...  contribution due to soil moisture availability.
             972                     !           determine contribution from each soil layer, then add them up.
             973                     
             974                           gx = (sh2o(1) - smcwlt) / (smcref - smcwlt)
             975                           gx = max( 0.0, min( 1.0, gx ) )
             976                     
             977                     !  --- ...  use soil depth as weighting factor
             978                           part(1) = (zsoil(1)/zsoil(nroot)) * gx
             979                     
             980                     !  --- ...  use root distribution as weighting factor
             981                     !     part(1) = rtdis(1) * gx
             982                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 422
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sh2o, zsoil, (unknown)
                                   <<< Loop-information  End >>>
             983     1   s    v            do k = 2, nroot
             984     1               
             985     1   p    v              gx = (sh2o(k) - smcwlt) / (smcref - smcwlt)
             986     1   p    v              gx = max( 0.0, min( 1.0, gx ) )
             987     1               
             988     1               !  --- ...  use soil depth as weighting factor
             989     1   p    v              part(k) = ((zsoil(k) - zsoil(k-1)) / zsoil(nroot)) * gx
             990     1               
             991     1               !  --- ...  use root distribution as weighting factor
             992     1               !       part(k) = rtdis(k) * gx
             993     1               
             994     1   p    v            enddo
             995                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             996     1  pp    v            do k = 1, nroot
             997     1   p    v              rcsoil = rcsoil + part(k)
             998     1   p    v            enddo
             999                           rcsoil = max( rcsoil, 0.0001 )
            1000                     
            1001                     !  --- ...  determine canopy resistance due to all factors.  convert canopy
            1002                     !           resistance (rc) to plant coefficient (pc) to be used with
            1003                     !           potential evap in determining actual evap.  pc is determined by:
            1004                     !           pc * linerized penman potential evap = penman-monteith actual
            1005                     !           evaporation (containing rc term).
            1006                     
            1007                           rc = rsmin / (xlai*rcs*rct*rcq*rcsoil)
            1008                           rr = (4.0*sfcems*sigma1*rd1/cp1) * (sfctmp**4.0)/(sfcprs*ch) + 1.0
            1009                           delta = (lsubc/cp1) * dqsdt2
            1010                     
            1011                           pc = (rr + delta) / (rr*(1.0 + rc*ch) + delta)
            1012                     !
            1013                           return
            1014                     !...................................
            1015                           end subroutine canres
            1016                     !-----------------------------------
            1017                     
            1018                     
            1019                     !-----------------------------------
            1020                           subroutine csnow
            1021                     !...................................
            1022                     !  ---  inputs:
            1023                     !    &     ( sndens,                                                    &
            1024                     !  ---  outputs:
            1025                     !    &       sncond                                                     &
            1026                     !    &     )
            1027                     
            1028                     ! ===================================================================== !
            1029                     !  description:                                                         !
            1030                     !                                                                       !
            1031                     !  subroutine csnow calculates snow termal conductivity                 !
            1032                     !                                                                       !
            1033                     !  subprogram called:  none                                             !
            1034                     !                                                                       !
            1035                     !  ====================  defination of variables  ====================  !
            1036                     !                                                                       !
            1037                     !  inputs from the calling program:                              size   !
            1038                     !     sndens   - real, snow density                                1    !
            1039                     !                                                                       !
            1040                     !  outputs to the calling program:                                      !
            1041                     !     sncond   - real, snow termal conductivity                    1    !
            1042                     !                                                                       !
            1043                     !  ====================    end of description    =====================  !
            1044                     !
            1045                     !  ---  constant parameters:
            1046                           real (kind=kind_phys), parameter :: unit = 0.11631
            1047                     
            1048                     !  ---  inputs:
            1049                     !     real (kind=kind_phys), intent(in) :: sndens
            1050                     
            1051                     !  ---  outputs:
            1052                     !     real (kind=kind_phys), intent(out) :: sncond
            1053                     
            1054                     !  ---  locals:
            1055                           real (kind=kind_phys) :: c
            1056                     
            1057                     !
            1058                     !===> ...  begin here
            1059                     !
            1060                     !  --- ...  sncond in units of cal/(cm*hr*c), returned in w/(m*c)
            1061                     !           basic version is dyachkova equation (1960), for range 0.1-0.4
            1062                     
            1063                           c = 0.328 * 10**(2.25*sndens)
            1064                           sncond = unit * c
            1065                     
            1066                     !  --- ...  de vaux equation (1933), in range 0.1-0.6
            1067                     
            1068                     !      sncond = 0.0293 * (1.0 + 100.0*sndens**2)
            1069                     
            1070                     !  --- ...  e. andersen from flerchinger
            1071                     
            1072                     !      sncond = 0.021 + 2.51 * sndens**2
            1073                     !
            1074                           return
            1075                     !...................................
            1076                           end subroutine csnow
            1077                     !-----------------------------------
            1078                     
            1079                     
            1080                     !-----------------------------------
            1081                           subroutine nopac
            1082                     !...................................
            1083                     !  ---  inputs:
            1084                     !    &     ( nsoil, nroot, etp, prcp, smcmax, smcwlt, smcref,           &
            1085                     !    &       smcdry, cmcmax, dt, shdfac, sbeta, sfctmp, sfcems,         &
            1086                     !    &       t24, th2, fdown, epsca, bexp, pc, rch, rr, cfactr,         &
            1087                     !    &       slope, kdt, frzx, psisat, zsoil, dksat, dwsat,             &
            1088                     !    &       zbot, ice, rtdis, quartz, fxexp, csoil,                    &
            1089                     !  ---  input/outputs:
            1090                     !    &       cmc, t1, stc, sh2o, tbot,                                  &
            1091                     !  ---  outputs:
            1092                     !    &       eta, smc, ssoil, runoff1, runoff2, runoff3, edir,          &
            1093                     !    &       ec, et, ett, beta, drip, dew, flx1, flx3                   &
            1094                     !    &     )
            1095                     
            1096                     ! ===================================================================== !
            1097                     !  description:                                                         !
            1098                     !                                                                       !
            1099                     !  subroutine nopac calculates soil moisture and heat flux values and   !
            1100                     !  update soil moisture content and soil heat content values for the    !
            1101                     !  case when no snow pack is present.                                   !
            1102                     !                                                                       !
            1103                     !                                                                       !
            1104                     !  subprograms called:  evapo, smflx, tdfcnd, shflx                     !
            1105                     !                                                                       !
            1106                     !  ====================  defination of variables  ====================  !
            1107                     !                                                                       !
            1108                     !  inputs from calling program:                                  size   !
            1109                     !     nsoil    - integer, number of soil layers                    1    !
            1110                     !     nroot    - integer, number of root layers                    1    !
            1111                     !     etp      - real, potential evaporation                       1    !
            1112                     !     prcp     - real, precip rate                                 1    !
            1113                     !     smcmax   - real, porosity (sat val of soil mois)             1    !
            1114                     !     smcwlt   - real, wilting point                               1    !
            1115                     !     smcref   - real, soil mois threshold                         1    !
            1116                     !     smcdry   - real, dry soil mois threshold                     1    !
            1117                     !     cmcmax   - real, maximum canopy water parameters             1    !
            1118                     !     dt       - real, time step                                   1    !
            1119                     !     shdfac   - real, aeral coverage of green veg                 1    !
            1120                     !     sbeta    - real, param to cal veg effect on soil heat flux   1    !
            1121                     !     sfctmp   - real, air temp at height zlvl abv ground          1    !
            1122                     !     sfcems   - real, sfc lw emissivity                           1    !
            1123                     !     t24      - real, sfctmp**4                                   1    !
            1124                     !     th2      - real, air potential temp at zlvl abv grnd         1    !
            1125                     !     fdown    - real, net solar + downward lw flux at sfc         1    !
            1126                     !     epsca    - real,                                             1    !
            1127                     !     bexp     - real, soil type "b" parameter                     1    !
            1128                     !     pc       - real, plant coeff                                 1    !
            1129                     !     rch      - real, companion coefficient of ch                 1    !
            1130                     !     rr       - real,                                             1    !
            1131                     !     cfactr   - real, canopy water parameters                     1    !
            1132                     !     slope    - real, linear reservoir coefficient                1    !
            1133                     !     kdt      - real,                                             1    !
            1134                     !     frzx     - real, frozen ground parameter                     1    !
            1135                     !     psisat   - real, saturated soil potential                    1    !
            1136                     !     zsoil    - real, soil layer depth below ground (negative)  nsoil  !
            1137                     !     dksat    - real, saturated soil hydraulic conductivity       1    !
            1138                     !     dwsat    - real, saturated soil diffusivity                  1    !
            1139                     !     zbot     - real, specify depth of lower bd soil              1    !
            1140                     !     ice      - integer, sea-ice flag (=1: sea-ice, =0: land)     1    !
            1141                     !     rtdis    - real, root distribution                         nsoil  !
            1142                     !     quartz   - real, soil quartz content                         1    !
            1143                     !     fxexp    - real, bare soil evaporation exponent              1    !
            1144                     !     csoil    - real, soil heat capacity                          1    !
            1145                     !                                                                       !
            1146                     !  input/outputs from and to the calling program:                       !
            1147                     !     cmc      - real, canopy moisture content                     1    !
            1148                     !     t1       - real, ground/canopy/snowpack eff skin temp        1    !
            1149                     !     stc      - real, soil temp                                 nsoil  !
            1150                     !     sh2o     - real, unfrozen soil moisture                    nsoil  !
            1151                     !     tbot     - real, bottom soil temp                            1    !
            1152                     !                                                                       !
            1153                     !  outputs to the calling program:                                      !
            1154                     !     eta      - real, downward latent heat flux                   1    !
            1155                     !     smc      - real, total soil moisture                       nsoil  !
            1156                     !     ssoil    - real, upward soil heat flux                       1    !
            1157                     !     runoff1  - real, surface runoff not infiltrating sfc         1    !
            1158                     !     runoff2  - real, sub surface runoff (baseflow)               1    !
            1159                     !     runoff3  - real, excess of porosity                          1    !
            1160                     !     edir     - real, direct soil evaporation                     1    !
            1161                     !     ec       - real, canopy water evaporation                    1    !
            1162                     !     et       - real, plant transpiration                       nsoil  !
            1163                     !     ett      - real, total plant transpiration                   1    !
            1164                     !     beta     - real, ratio of actual/potential evap              1    !
            1165                     !     drip     - real, through-fall of precip and/or dew           1    !
            1166                     !     dew      - real, dewfall (or frostfall)                      1    !
            1167                     !     flx1     - real, precip-snow sfc flux                        1    !
            1168                     !     flx3     - real, phase-change heat flux from snowmelt        1    !
            1169                     !                                                                       !
            1170                     !  ====================    end of description    =====================  !
            1171                     !
            1172                     !  ---  inputs:
            1173                     !     integer, intent(in) :: nsoil, nroot, ice
            1174                     
            1175                     !     real (kind=kind_phys), intent(in) :: etp, prcp, smcmax,           &
            1176                     !    &       smcwlt, smcref, smcdry, cmcmax, dt, shdfac, sbeta,         &
            1177                     !    &       sfctmp, sfcems, t24, th2, fdown, epsca, bexp, pc,          &
            1178                     !    &       rch, rr, cfactr, slope, kdt, frzx, psisat,                 &
            1179                     !    &       zsoil(nsoil), dksat, dwsat, zbot, rtdis(nsoil),            &
            1180                     !    &       quartz, fxexp, csoil
            1181                     
            1182                     !  ---  input/outputs:
            1183                     !     real (kind=kind_phys), intent(inout) :: cmc, t1, stc(nsoil),      &
            1184                     !    &       sh2o(nsoil), tbot
            1185                     
            1186                     !  ---  outputs:
            1187                     !     real (kind=kind_phys), intent(out) :: eta, smc(nsoil), ssoil,     &
            1188                     !    &       runoff1, runoff2, runoff3, edir, ec, et(nsoil), ett,       &
            1189                     !    &       beta, drip, dew, flx1, flx3
            1190                     
            1191                     !  ---  locals:
            1192                           real (kind=kind_phys) :: df1, eta1, etp1, prcp1, yy, yynum,       &
            1193                                  zz1, ec1, edir1, et1(nsoil), ett1
            1194                     
            1195                           integer :: k
            1196                     
            1197                     !
            1198                     !===> ...  begin here
            1199                     !
            1200                     !  --- ...  convert etp from kg m-2 s-1 to ms-1 and initialize dew.
            1201                     
            1202                           prcp1= prcp * 0.001
            1203                           etp1 = etp  * 0.001
            1204                           dew  = 0.0
            1205                           edir = 0.0
            1206                           edir1= 0.0
            1207                           ec   = 0.0
            1208                           ec1  = 0.0
            1209                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      et1, et
                                   <<< Loop-information  End >>>
            1210     1  pp   2v            do k = 1, nsoil
            1211     1   p   2v              et (k) = 0.0
            1212     1   p   2v              et1(k) = 0.0
            1213     1   p   2v            enddo
            1214                     
            1215                           ett  = 0.0
            1216                           ett1 = 0.0
            1217                     
            1218     1                     if (etp > 0.0) then
            1219     1               
            1220     1               !  --- ...  convert prcp from 'kg m-2 s-1' to 'm s-1'.
            1221     1               
            1222     1                       call evapo                                                      &
            1223     1               !  ---  inputs: &
            1224     1                          ( nsoil, nroot, cmc, cmcmax, etp1, dt, zsoil,                &
            1225     1                            sh2o, smcmax, smcwlt, smcref, smcdry, pc,                  &
            1226     1                            shdfac, cfactr, rtdis, fxexp,                              &
            1227     1               !  ---  outputs: &
            1228     1                            eta1, edir1, ec1, et1, ett1                                &
            1229     1                          )
            1230     1               
            1231     1                       call smflx                                                      &
            1232     1               !  ---  inputs: &
            1233     1                          ( nsoil, dt, kdt, smcmax, smcwlt, cmcmax, prcp1,             &
            1234     1                            zsoil, slope, frzx, bexp, dksat, dwsat, shdfac,            &
            1235     1                            edir1, ec1, et1,                                           &
            1236     1               !  ---  input/outputs: &
            1237     1                            cmc, sh2o,                                                 &
            1238     1               !  ---  outputs: &
            1239     1                            smc, runoff1, runoff2, runoff3, drip                       &
            1240     1                          )
            1241     1               
            1242     1                     else
            1243     1               
            1244     1               !  --- ...  if etp < 0, assume dew forms (transform etp1 into dew and
            1245     1               !           reinitialize etp1 to zero).
            1246     1               
            1247     1                       eta1 = 0.0
            1248     1                       dew  = -etp1
            1249     1               
            1250     1               !  --- ...  convert prcp from 'kg m-2 s-1' to 'm s-1' and add dew amount.
            1251     1               
            1252     1                       prcp1 = prcp1 + dew
            1253     1               
            1254     1                       call smflx                                                      &
            1255     1               !  ---  inputs: &
            1256     1                          ( nsoil, dt, kdt, smcmax, smcwlt, cmcmax, prcp1,             &
            1257     1                            zsoil, slope, frzx, bexp, dksat, dwsat, shdfac,            &
            1258     1                            edir1, ec1, et1,                                           &
            1259     1               !  ---  input/outputs: &
            1260     1                            cmc, sh2o,                                                 &
            1261     1               !  ---  outputs: &
            1262     1                            smc, runoff1, runoff2, runoff3, drip                       &
            1263     1                          )
            1264     1               
            1265     1                     endif   ! end if_etp_block
            1266                     
            1267                     !  --- ...  convert modeled evapotranspiration fm  m s-1  to  kg m-2 s-1
            1268                     
            1269                           eta  = eta1 * 1000.0
            1270                           edir = edir1 * 1000.0
            1271                           ec   = ec1 * 1000.0
            1272                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      et1, et
                                   <<< Loop-information  End >>>
            1273     1  pp   2v            do k = 1, nsoil
            1274     1   p   2v              et(k) = et1(k) * 1000.0
            1275     1   p   2v            enddo
            1276                     
            1277                           ett = ett1 * 1000.0
            1278                     
            1279                     !  --- ...  based on etp and e values, determine beta
            1280                     
            1281     1                     if ( etp <= 0.0 ) then
            1282     1                       beta = 0.0
            1283     2                       if ( etp < 0.0 ) then
            1284     2                         beta = 1.0
            1285     2                       endif
            1286     1                     else
            1287     1                       beta = eta / etp
            1288     1                     endif
            1289                     
            1290                     !  --- ...  get soil thermal diffuxivity/conductivity for top soil lyr,
            1291                     !           calc. adjusted top lyr soil temp and adjusted soil flux, then
            1292                     !           call shflx to compute/update soil heat flux and soil temps.
            1293                     
            1294                           call tdfcnd                                                       &
            1295                     !  ---  inputs: &
            1296                                ( smc(1), quartz, smcmax, sh2o(1),                           &
            1297                     !  ---  outputs: &
            1298                                  df1                                                        &
            1299                                )
            1300     1                      if(ivegsrc .ge. 1) then
            1301     1               !urban
            1302     1                        if ( vegtyp == 13 ) df1=3.24
            1303     1                      endif
            1304                     
            1305                     !  --- ... vegetation greenness fraction reduction in subsurface heat
            1306                     !          flux via reduction factor, which is convenient to apply here
            1307                     !          to thermal diffusivity that is later used in hrt to compute
            1308                     !          sub sfc heat flux (see additional comments on veg effect
            1309                     !          sub-sfc heat flx in routine sflx)
            1310                     
            1311                           df1 = df1 * exp( sbeta*shdfac )
            1312                     
            1313                     !  --- ...  compute intermediate terms passed to routine hrt (via routine
            1314                     !           shflx below) for use in computing subsurface heat flux in hrt
            1315                     
            1316                           yynum = fdown - sfcems*sigma1*t24
            1317                           yy = sfctmp + (yynum/rch + th2 - sfctmp - beta*epsca)/rr
            1318                           zz1 = df1/(-0.5*zsoil(1)*rch*rr) + 1.0
            1319                     
            1320                           call shflx                                                        &
            1321                     !  ---  inputs: &
            1322                                ( nsoil, smc, smcmax, dt, yy, zz1, zsoil, zbot,              &
            1323                                  psisat, bexp, df1, ice, quartz, csoil, vegtyp,             &
            1324                     !  ---  input/outputs: &
            1325                                  stc, t1, tbot, sh2o,                                       &
            1326                     !  ---  outputs: &
            1327                                  ssoil                                                      &
            1328                                )
            1329                     
            1330                     !  --- ...  set flx1 and flx3 (snopack phase change heat fluxes) to zero since
            1331                     !           they are not used here in snopac.  flx2 (freezing rain heat flux)
            1332                     !           was similarly initialized in the penman routine.
            1333                     
            1334                           flx1 = 0.0
            1335                           flx3 = 0.0
            1336                     !
            1337                           return
            1338                     !...................................
            1339                           end subroutine nopac
            1340                     !-----------------------------------
            1341                     
            1342                     
            1343                     !-----------------------------------
            1344                           subroutine penman
            1345                     !...................................
            1346                     !  ---  inputs:
            1347                     !    &     ( sfctmp, sfcprs, sfcems, ch, t2v, th2, prcp, fdown,         &
            1348                     !    &       ssoil, q2, q2sat, dqsdt2, snowng, frzgra,                  &
            1349                     !  ---  outputs:
            1350                     !    &       t24, etp, rch, epsca, rr, flx2                             &
            1351                     !    &     )
            1352                     
            1353                     ! ===================================================================== !
            1354                     !  description:                                                         !
            1355                     !                                                                       !
            1356                     !  subroutine penman calculates potential evaporation for the current   !
            1357                     !  point.  various partial sums/products are also calculated and passed !
            1358                     !  back to the calling routine for later use.                           !
            1359                     !                                                                       !
            1360                     !                                                                       !
            1361                     !  subprogram called:  none                                             !
            1362                     !                                                                       !
            1363                     !  ====================  defination of variables  ====================  !
            1364                     !                                                                       !
            1365                     !  inputs:                                                       size   !
            1366                     !     sfctmp   - real, sfc temperature at 1st level above ground   1    !
            1367                     !     sfcprs   - real, sfc pressure                                1    !
            1368                     !     sfcems   - real, sfc emissivity for lw radiation             1    !
            1369                     !     ch       - real, sfc exchange coeff for heat & moisture      1    !
            1370                     !     t2v      - real, sfc virtual temperature                     1    !
            1371                     !     th2      - real, air potential temp at zlvl abv grnd         1    !
            1372                     !     prcp     - real, precip rate                                 1    !
            1373                     !     fdown    - real, net solar + downward lw flux at sfc         1    !
            1374                     !     ssoil    - real, upward soil heat flux                       1    !
            1375                     !     q2       - real, mixing ratio at hght zlvl abv ground        1    !
            1376                     !     q2sat    - real, sat mixing ratio at zlvl abv ground         1    !
            1377                     !     dqsdt2   - real, slope of sat specific humidity curve        1    !
            1378                     !     snowng   - logical, snow flag                                1    !
            1379                     !     frzgra   - logical, freezing rain flag                       1    !
            1380                     !                                                                       !
            1381                     !  outputs:                                                             !
            1382                     !     t24      - real, sfctmp**4                                   1    !
            1383                     !     etp      - real, potential evaporation                       1    !
            1384                     !     rch      - real, companion coefficient of ch                 1    !
            1385                     !     epsca    - real,                                             1    !
            1386                     !     rr       - real,                                             1    !
            1387                     !     flx2     - real, freezing rain latent heat flux              1    !
            1388                     !                                                                       !
            1389                     !  ====================    end of description    =====================  !
            1390                     !
            1391                     !  ---  inputs:
            1392                     !     real (kind=kind_phys), intent(in) :: sfctmp, sfcprs, sfcems,      &
            1393                     !    &       ch, t2v, th2, prcp, fdown, ssoil, q2, q2sat, dqsdt2
            1394                     
            1395                     !     logical, intent(in) :: snowng, frzgra
            1396                     
            1397                     !  ---  outputs:
            1398                     !     real (kind=kind_phys), intent(out) :: t24, etp, rch, epsca,       &
            1399                     !    &       rr, flx2
            1400                     
            1401                     !  ---  locals:
            1402                           real (kind=kind_phys) :: a, delta, fnet, rad, rho
            1403                     
            1404                     !
            1405                     !===> ...  begin here
            1406                     !
            1407                           flx2 = 0.0
            1408                     
            1409                     !  --- ...  prepare partial quantities for penman equation.
            1410                     
            1411                           delta = elcp * dqsdt2
            1412                           t24 = sfctmp * sfctmp * sfctmp * sfctmp
            1413                           rr  = t24 * 6.48e-8 / (sfcprs*ch) + 1.0
            1414                           rho = sfcprs / (rd1*t2v)
            1415                           rch = rho * cp * ch
            1416                     
            1417                     !  --- ...  adjust the partial sums / products with the latent heat
            1418                     !           effects caused by falling precipitation.
            1419                     
            1420     1                     if (.not. snowng) then
            1421     1                       if (prcp > 0.0)  rr = rr + cph2o1*prcp/rch
            1422     1                     else
            1423     1                       rr = rr + cpice*prcp/rch
            1424     1                     endif
            1425                     
            1426                           fnet = fdown - sfcems*sigma1*t24 - ssoil
            1427                     
            1428                     !  --- ...  include the latent heat effects of frzng rain converting to ice
            1429                     !           on impact in the calculation of flx2 and fnet.
            1430                     
            1431     1                     if (frzgra) then
            1432     1                       flx2 = -lsubf * prcp
            1433     1                       fnet = fnet - flx2
            1434     1                     endif
            1435                     
            1436                     !  --- ...  finish penman equation calculations.
            1437                     
            1438                           rad = fnet/rch + th2 - sfctmp
            1439                           a = elcp * (q2sat - q2)
            1440                           epsca = (a*rr + rad*delta) / (delta + rr)
            1441                           etp = epsca * rch / lsubc
            1442                     !
            1443                           return
            1444                     !...................................
            1445                           end subroutine penman
            1446                     !-----------------------------------
            1447                     
            1448                     
            1449                     !-----------------------------------
            1450                           subroutine redprm
            1451                     !...................................
            1452                     !  ---  inputs:
            1453                     !    &     ( nsoil, vegtyp, soiltyp, slopetyp, sldpth, zsoil,              &
            1454                     !  ---  outputs:
            1455                     !    &       cfactr, cmcmax, rsmin, rsmax, topt, refkdt, kdt,              &
            1456                     !    &       sbeta, shdfac, rgl, hs, zbot, frzx, psisat, slope,            &
            1457                     !    &       snup, salp, bexp, dksat, dwsat, smcmax, smcwlt,               &
            1458                     !    &       smcref, smcdry, f1, quartz, fxexp, rtdis, nroot,              &
            1459                     !    &       z0, czil, xlai, csoil                                         &
            1460                     !    &     )
            1461                     
            1462                     ! ===================================================================== !
            1463                     !  description:                                                         !
            1464                     !                                                                       !
            1465                     !  subroutine redprm internally sets(default valuess), or optionally    !
            1466                     !  read-in via namelist i/o, all soil and vegetation parameters         !
            1467                     !  required for the execusion of the noah lsm.                          !
            1468                     !                                                                       !
            1469                     !  optional non-default parameters can be read in, accommodating up to  !
            1470                     !  30 soil, veg, or slope classes, if the default max number of soil,   !
            1471                     !  veg, and/or slope types is reset.                                    !
            1472                     !                                                                       !
            1473                     !  future upgrades of routine redprm must expand to incorporate some    !
            1474                     !  of the empirical parameters of the frozen soil and snowpack physics  !
            1475                     !  (such as in routines frh2o, snowpack, and snow_new) not yet set in   !
            1476                     !  this redprm routine, but rather set in lower level subroutines.      !
            1477                     !                                                                       !
            1478                     !  all soil, veg, slope, and universal parameters values are defined    !
            1479                     !  externally (in subroutine "set_soilveg.f") and then accessed via     !
            1480                     !  "use namelist_soilveg" (below) and then set here.                    !
            1481                     !                                                                       !
            1482                     !  soil types   zobler (1986)      cosby et al (1984) (quartz cont.(1)) !
            1483                     !      1         coarse            loamy sand            (0.82)         !
            1484                     !      2         medium            silty clay loam       (0.10)         !
            1485                     !      3         fine              light clay            (0.25)         !
            1486                     !      4         coarse-medium     sandy loam            (0.60)         !
            1487                     !      5         coarse-fine       sandy clay            (0.52)         !
            1488                     !      6         medium-fine       clay loam             (0.35)         !
            1489                     !      7         coarse-med-fine   sandy clay loam       (0.60)         !
            1490                     !      8         organic           loam                  (0.40)         !
            1491                     !      9         glacial land ice  loamy sand            (na using 0.82)!
            1492                     !     13: <old>- glacial land ice -<old>                                !
            1493                     !     13:        glacial-ice (no longer use these parameters), now      !
            1494                     !                treated as ice-only surface and sub-surface            !
            1495                     !                (in subroutine hrtice)                                 !
            1496                     !  upgraded to statsgo (19-type)
            1497                     !     1: sand
            1498                     !     2: loamy sand
            1499                     !     3: sandy loam
            1500                     !     4: silt loam
            1501                     !     5: silt
            1502                     !     6:loam
            1503                     !     7:sandy clay loam
            1504                     !     8:silty clay loam
            1505                     !     9:clay loam
            1506                     !     10:sandy clay
            1507                     !     11: silty clay
            1508                     !     12: clay
            1509                     !     13: organic material
            1510                     !     14: water
            1511                     !     15: bedrock
            1512                     !     16: other (land-ice)
            1513                     !     17: playa
            1514                     !     18: lava
            1515                     !     19: white sand
            1516                     !                                                                       !
            1517                     !  ssib vegetation types (dorman and sellers, 1989; jam)                !
            1518                     !      1:  broadleaf-evergreen trees  (tropical forest)                 !
            1519                     !      2:  broadleaf-deciduous trees                                    !
            1520                     !      3:  broadleaf and needleleaf trees (mixed forest)                !
            1521                     !      4:  needleleaf-evergreen trees                                   !
            1522                     !      5:  needleleaf-deciduous trees (larch)                           !
            1523                     !      6:  broadleaf trees with groundcover (savanna)                   !
            1524                     !      7:  groundcover only (perennial)                                 !
            1525                     !      8:  broadleaf shrubs with perennial groundcover                  !
            1526                     !      9:  broadleaf shrubs with bare soil                              !
            1527                     !     10:  dwarf trees and shrubs with groundcover (tundra)             !
            1528                     !     11:  bare soil                                                    !
            1529                     !     12:  cultivations (the same parameters as for type 7)             !
            1530                     !     13: <old>- glacial (the same parameters as for type 11) -<old>    !
            1531                     !     13:  glacial-ice (no longer use these parameters), now treated as !
            1532                     !          ice-only surface and sub-surface (in subroutine hrtice)      !
            1533                     !  upgraded to IGBP (20-type)
            1534                     !      1:Evergreen Needleleaf Forest
            1535                     !      2:Evergreen Broadleaf Forest
            1536                     !      3:Deciduous Needleleaf Forest
            1537                     !      4:Deciduous Broadleaf Forest
            1538                     !      5:Mixed Forests
            1539                     !      6:Closed Shrublands
            1540                     !      7:Open Shrublands
            1541                     !      8:Woody Savannas
            1542                     !      9:Savannas
            1543                     !      10:Grasslands
            1544                     !      11:Permanent wetlands
            1545                     !      12:Croplands
            1546                     !      13:Urban and Built-Up
            1547                     !      14:Cropland/natural vegetation mosaic
            1548                     !      15:Snow and Ice
            1549                     !      16:Barren or Sparsely Vegetated
            1550                     !      17:Water
            1551                     !      18:Wooded Tundra
            1552                     !      19:Mixed Tundra
            1553                     !      20:Bare Ground Tundra
            1554                     !                                                                       !
            1555                     !  slopetyp is to estimate linear reservoir coefficient slope to the    !
            1556                     !  baseflow runoff out of the bottom layer. lowest class (slopetyp=0)   !
            1557                     !  means highest slope parameter = 1.                                   !
            1558                     !                                                                       !
            1559                     !  slope class       percent slope                                      !
            1560                     !      1                0-8                                             !
            1561                     !      2                8-30                                            !
            1562                     !      3                > 30                                            !
            1563                     !      4                0-30                                            !
            1564                     !      5                0-8 & > 30                                      !
            1565                     !      6                8-30 & > 30                                     !
            1566                     !      7                0-8, 8-30, > 30                                 !
            1567                     !      9                glacial ice                                     !
            1568                     !    blank              ocean/sea                                       !
            1569                     !                                                                       !
            1570                     !  note: class 9 from zobler file should be replaced by 8 and 'blank' 9 !
            1571                     !                                                                       !
            1572                     !                                                                       !
            1573                     !  subprogram called:  none                                             !
            1574                     !                                                                       !
            1575                     !  ====================  defination of variables  ====================  !
            1576                     !                                                                       !
            1577                     !  inputs from calling program:                                  size   !
            1578                     !     nsoil    - integer, number of soil layers                    1    !
            1579                     !     vegtyp   - integer, vegetation type (integer index)          1    !
            1580                     !     soiltyp  - integer, soil type (integer index)                1    !
            1581                     !     slopetyp - integer, class of sfc slope (integer index)       1    !
            1582                     !     sldpth   - integer, thickness of each soil layer (m)       nsoil  !
            1583                     !     zsoil    - integer, soil depth (negative sign) (m)         nsoil  !
            1584                     !                                                                       !
            1585                     !  outputs to the calling program:                                      !
            1586                     !     cfactr   - real, canopy water parameters                     1    !
            1587                     !     cmcmax   - real, maximum canopy water parameters             1    !
            1588                     !     rsmin    - real, mimimum stomatal resistance                 1    !
            1589                     !     rsmax    - real, maximum stomatal resistance                 1    !
            1590                     !     topt     - real, optimum transpiration air temperature       1    !
            1591                     !     refkdt   - real, =2.e-6 the sat. dk. val for soil type 2     1    !
            1592                     !     kdt      - real,                                             1    !
            1593                     !     sbeta    - real, param to cal veg effect on soil heat flux   1    !
            1594                     !     shdfac   - real, vegetation greenness fraction               1    !
            1595                     !     rgl      - real, canopy resistance func (in solar rad term)  1    !
            1596                     !     hs       - real, canopy resistance func (vapor deficit term) 1    !
            1597                     !     zbot     - real, specify depth of lower bd soil temp (m)     1    !
            1598                     !     frzx     - real, frozen ground parameter, ice content        1    !
            1599                     !                      threshold above which frozen soil is impermeable !
            1600                     !     psisat   - real, saturated soil potential                    1    !
            1601                     !     slope    - real, linear reservoir coefficient                1    !
            1602                     !     snup     - real, threshold snow depth (water equi m)         1    !
            1603                     !     salp     - real, snow cover shape parameter                  1    !
            1604                     !                      from anderson's hydro-17 best fit salp = 2.6     !
            1605                     !     bexp     - real, the 'b' parameter                           1    !
            1606                     !     dksat    - real, saturated soil hydraulic conductivity       1    !
            1607                     !     dwsat    - real, saturated soil diffusivity                  1    !
            1608                     !     smcmax   - real, max soil moisture content (porosity)        1    !
            1609                     !     smcwlt   - real, wilting pt soil moisture contents           1    !
            1610                     !     smcref   - real, reference soil moisture (onset stress)      1    !
            1611                     !     smcdry   - real, air dry soil moist content limits           1    !
            1612                     !     f1       - real, used to comp soil diffusivity/conductivity  1    !
            1613                     !     quartz   - real, soil quartz content                         1    !
            1614                     !     fxexp    - real, bare soil evaporation exponent              1    !
            1615                     !     rtdis    - real, root distribution                         nsoil  !
            1616                     !     nroot    - integer, number of root layers                    1    !
            1617                     !     z0       - real, roughness length (m)                        1    !
            1618                     !     czil     - real, param to cal roughness length of heat       1    !
            1619                     !     xlai     - real, leaf area index                             1    !
            1620                     !     csoil    - real, soil heat capacity (j m-3 k-1)              1    !
            1621                     !                                                                       !
            1622                     !  ====================    end of description    =====================  !
            1623                     !
            1624                           use namelist_soilveg
            1625                     
            1626                     !  ---  input:
            1627                     !     integer, intent(in) :: nsoil, vegtyp, soiltyp, slopetyp
            1628                     
            1629                     !     real (kind=kind_phys), intent(in) :: sldpth(nsoil), zsoil(nsoil)
            1630                     
            1631                     !  ---  outputs:
            1632                     !     real (kind=kind_phys), intent(out) :: cfactr, cmcmax, rsmin,      &
            1633                     !    &       rsmax, topt, refkdt, kdt, sbeta, shdfac, rgl, hs, zbot,    &
            1634                     !    &       frzx, psisat, slope, snup, salp, bexp, dksat, dwsat,       &
            1635                     !    &       smcmax, smcwlt, smcref, smcdry, f1, quartz, fxexp, z0,     &
            1636                     !    &       czil, xlai, csoil, rtdis(nsoil)
            1637                     
            1638                     !     integer, intent(out) :: nroot
            1639                     
            1640                     !  ---  locals:
            1641                           real (kind=kind_phys) :: frzfact, frzk, refdk
            1642                     
            1643                           integer :: i
            1644                     
            1645                     !
            1646                     !===> ...  begin here
            1647                     !
            1648     1                     if (soiltyp > defined_soil) then
            1649     1                       write(*,*) 'warning: too many soil types,soiltyp=',soiltyp,     &
            1650     1                        'defined_soil=',defined_soil
            1651     1                       stop 333
            1652     1                     endif
            1653                     
            1654     1                     if (vegtyp > defined_veg) then
            1655     1                       write(*,*) 'warning: too many veg types'
            1656     1                       stop 333
            1657     1                     endif
            1658                     
            1659     1                     if (slopetyp > defined_slope) then
            1660     1                       write(*,*) 'warning: too many slope types'
            1661     1                       stop 333
            1662     1                     endif
            1663                     
            1664                     !  --- ...  set-up universal parameters (not dependent on soiltyp, vegtyp
            1665                     !           or slopetyp)
            1666                     
            1667                           zbot   = zbot_data
            1668                           salp   = salp_data
            1669                           cfactr = cfactr_data
            1670                           cmcmax = cmcmax_data
            1671                           sbeta  = sbeta_data
            1672                           rsmax  = rsmax_data
            1673                           topt   = topt_data
            1674                           refdk  = refdk_data
            1675                           frzk   = frzk_data
            1676                           fxexp  = fxexp_data
            1677                           refkdt = refkdt_data
            1678                           czil   = czil_data
            1679                           csoil  = csoil_data
            1680                     
            1681                     !  --- ...  set-up soil parameters
            1682                     
            1683                           bexp  = bb   (soiltyp)
            1684                           dksat = satdk(soiltyp)
            1685                           dwsat = satdw(soiltyp)
            1686                           f1    = f11  (soiltyp)
            1687                           kdt   = refkdt * dksat / refdk
            1688                     
            1689                           psisat = satpsi(soiltyp)
            1690                           quartz = qtz   (soiltyp)
            1691                           smcdry = drysmc(soiltyp)
            1692                           smcmax = maxsmc(soiltyp)
            1693                           smcref = refsmc(soiltyp)
            1694                           smcwlt = wltsmc(soiltyp)
            1695                     
            1696                           frzfact = (smcmax / smcref) * (0.412 / 0.468)
            1697                     
            1698                     !  --- ...  to adjust frzk parameter to actual soil type: frzk * frzfact
            1699                     
            1700                           frzx = frzk * frzfact
            1701                     
            1702                     !  --- ...  set-up vegetation parameters
            1703                     
            1704                           nroot = nroot_data(vegtyp)
            1705                           snup  = snupx(vegtyp)
            1706                           rsmin = rsmtbl(vegtyp)
            1707                     
            1708                           rgl = rgltbl(vegtyp)
            1709                           hs  = hstbl(vegtyp)
            1710                     ! roughness lengthe is defined in sfcsub
            1711                     !     z0  = z0_data(vegtyp)
            1712                           xlai= lai_data(vegtyp)
            1713                     !
            1714                     !     sfcems= ems1_data(vegtyp)      !for summer season
            1715                     !     sfcems= ems2_data(vegtyp)      !for winter season
            1716                           if (vegtyp == bare) shdfac = 0.0
            1717                     
            1718     1                     if (nroot > nsoil) then
            1719     1                       write(*,*) 'warning: too many root layers'
            1720     1                       stop 333
            1721     1                     endif
            1722                     
            1723                     !  --- ...  calculate root distribution.  present version assumes uniform
            1724                     !           distribution based on soil layer depths.
            1725                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sldpth, rtdis
                                   <<< Loop-information  End >>>
            1726     1   s    v            do i = 1, nroot
            1727     1   p    v              rtdis(i) = -sldpth(i) / zsoil(nroot)
            1728     1   p    v            enddo
            1729                     
            1730                     !  --- ...  set-up slope parameter
            1731                     
            1732                           slope = slope_data(slopetyp)
            1733                     !
            1734                           return
            1735                     !...................................
            1736                           end subroutine redprm
            1737                     !-----------------------------------
            1738                     
            1739                     
            1740                     !-----------------------------------
            1741                           subroutine sfcdif
            1742                     !...................................
            1743                     !  ---  inputs:
            1744                     !    &     ( zlvl, z0, t1v, th2v, sfcspd, czil,                         &
            1745                     !  ---  input/outputs:
            1746                     !    &       cm, ch                                                     &
            1747                     !    &     )
            1748                     
            1749                     ! ===================================================================== !
            1750                     !  description:                                                         !
            1751                     !                                                                       !
            1752                     !  subroutine sfcdif calculates surface layer exchange coefficients     !
            1753                     !  via iterative process. see chen et al (1997, blm)                    !
            1754                     !                                                                       !
            1755                     !  subprogram called:  none                                             !
            1756                     !                                                                       !
            1757                     !                                                                       !
            1758                     !  ====================  defination of variables  ====================  !
            1759                     !                                                                       !
            1760                     !  inputs from the calling program:                              size   !
            1761                     !     zlvl     - real, height abv atmos ground forcing vars (m)    1    !
            1762                     !     z0       - real, roughness length (m)                        1    !
            1763                     !     t1v      - real, surface exchange coefficient                1    !
            1764                     !     th2v     - real, surface exchange coefficient                1    !
            1765                     !     sfcspd   - real, wind speed at height zlvl abv ground (m/s)  1    !
            1766                     !     czil     - real, param to cal roughness length of heat       1    !
            1767                     !                                                                       !
            1768                     !  input/outputs from and to the calling program:                       !
            1769                     !     cm       - real, sfc exchange coeff for momentum (m/s)       1    !
            1770                     !     ch       - real, sfc exchange coeff for heat & moisture (m/s)1    !
            1771                     !                                                                       !
            1772                     !  ====================    end of description    =====================  !
            1773                     !
            1774                     !  --- constant parameters:
            1775                           integer,               parameter :: itrmx  = 5
            1776                           real (kind=kind_phys), parameter :: wwst   = 1.2
            1777                           real (kind=kind_phys), parameter :: wwst2  = wwst*wwst
            1778                           real (kind=kind_phys), parameter :: vkrm   = 0.40
            1779                           real (kind=kind_phys), parameter :: excm   = 0.001
            1780                           real (kind=kind_phys), parameter :: beta   = 1.0/270.0
            1781                           real (kind=kind_phys), parameter :: btg    = beta*gs1
            1782                           real (kind=kind_phys), parameter :: elfc   = vkrm*btg
            1783                           real (kind=kind_phys), parameter :: wold   = 0.15
            1784                           real (kind=kind_phys), parameter :: wnew   = 1.0-wold
            1785                           real (kind=kind_phys), parameter :: pihf   = 3.14159265/2.0  ! con_pi/2.0
            1786                     
            1787                           real (kind=kind_phys), parameter :: epsu2  = 1.e-4
            1788                           real (kind=kind_phys), parameter :: epsust = 0.07
            1789                           real (kind=kind_phys), parameter :: ztmin  = -5.0
            1790                           real (kind=kind_phys), parameter :: ztmax  = 1.0
            1791                           real (kind=kind_phys), parameter :: hpbl   = 1000.0
            1792                           real (kind=kind_phys), parameter :: sqvisc = 258.2
            1793                     
            1794                           real (kind=kind_phys), parameter :: ric    = 0.183
            1795                           real (kind=kind_phys), parameter :: rric   = 1.0/ric
            1796                           real (kind=kind_phys), parameter :: fhneu  = 0.8
            1797                           real (kind=kind_phys), parameter :: rfc    = 0.191
            1798                           real (kind=kind_phys), parameter :: rfac   = ric/(fhneu*rfc*rfc)
            1799                     
            1800                     !  ---  inputs:
            1801                     !     real (kind=kind_phys),  intent(in) :: zlvl, z0, t1v, th2v,        &
            1802                     !    &       sfcspd, czil
            1803                     
            1804                     !  ---  input/outputs:
            1805                     !     real (kind=kind_phys),  intent(inout) :: cm, ch
            1806                     
            1807                     !  ---  locals:
            1808                           real (kind=kind_phys) :: zilfc, zu, zt, rdz, cxch, dthv, du2,     &
            1809                                  btgh, wstar2, ustar, zslu, zslt, rlogu, rlogt, rlmo,       &
            1810                                  zetalt, zetalu, zetau, zetat, xlu4, xlt4, xu4, xt4,        &
            1811                                  xlu, xlt, xu, xt, psmz, simm, pshz, simh, ustark,          &
            1812                                  rlmn, rlma
            1813                     
            1814                           integer :: ilech, itr
            1815                     
            1816                     !  ---  define local in-line functions:
            1817                     
            1818                           real (kind=kind_phys) :: pslmu, pslms, pslhu, pslhs, zz
            1819                           real (kind=kind_phys) :: pspmu, pspms, psphu, psphs, xx, yy
            1820                     
            1821                     !  ...  1) lech's surface functions
            1822                     
            1823                           pslmu( zz ) = -0.96 * log( 1.0-4.5*zz )
            1824                           pslms( zz ) = zz*rric - 2.076*(1.0 - 1.0/(zz + 1.0))
            1825                           pslhu( zz ) = -0.96 * log( 1.0-4.5*zz )
            1826                           pslhs( zz ) = zz*rfac - 2.076*(1.0 - 1.0/(zz + 1.0))
            1827                     
            1828                     !  ...  2) paulson's surface functions
            1829                     
            1830                           pspmu( xx ) = -2.0 * log( (xx + 1.0)*0.5 )                        &
            1831                                       - log( (xx*xx + 1.0)*0.5 ) + 2.0*atan(xx) - pihf
            1832                           pspms( yy ) = 5.0 * yy
            1833                           psphu( xx ) = -2.0 * log( (xx*xx + 1.0)*0.5 )
            1834                           psphs( yy ) = 5.0 * yy
            1835                     
            1836                     !
            1837                     !===> ...  begin here
            1838                     !
            1839                     !  --- ...  this routine sfcdif can handle both over open water (sea, ocean) and
            1840                     !           over solid surface (land, sea-ice).
            1841                     
            1842                           ilech = 0
            1843                     
            1844                     !   --- ...  ztfc: ratio of zoh/zom  less or equal than 1
            1845                     !            czil: constant c in zilitinkevich, s. s.1995,:note about zt
            1846                     
            1847                           zilfc = -czil * vkrm * sqvisc
            1848                     
            1849                           zu = z0
            1850                     
            1851                           rdz = 1.0 / zlvl
            1852                           cxch = excm * rdz
            1853                           dthv = th2v - t1v
            1854                           du2 = max( sfcspd*sfcspd, epsu2 )
            1855                     
            1856                     !  --- ...  beljars correction of ustar
            1857                     
            1858                           btgh = btg * hpbl
            1859                     
            1860                     !  --- ...  if statements to avoid tangent linear problems near zero
            1861     1                     if (btgh*ch*dthv /= 0.0) then
            1862     1                       wstar2 = wwst2 * abs( btgh*ch*dthv )**(2.0/3.0)
            1863     1                     else
            1864     1                       wstar2 = 0.0
            1865     1                     endif
            1866                     
            1867                           ustar = max( sqrt( cm*sqrt( du2+wstar2 ) ), epsust )
            1868                     
            1869                     !  --- ...  zilitinkevitch approach for zt
            1870                     
            1871                           zt = exp( zilfc*sqrt( ustar*z0 ) ) * z0
            1872                     
            1873                           zslu = zlvl + zu
            1874                           zslt = zlvl + zt
            1875                     
            1876                     !     print*,'zslt=',zslt
            1877                     !     print*,'zlvl=',zvll
            1878                     !     print*,'zt=',zt
            1879                     
            1880                           rlogu = log( zslu/zu )
            1881                           rlogt = log( zslt/zt )
            1882                     
            1883                           rlmo = elfc*ch*dthv / ustar**3
            1884                     
            1885                     !     print*,'rlmo=',rlmo
            1886                     !     print*,'elfc=',elfc
            1887                     !     print*,'ch=',ch
            1888                     !     print*,'dthv=',dthv
            1889                     !     print*,'ustar=',ustar
            1890                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 9  FILL 20
                                   <<<      SCALABLE  : SPILL 0  FILL 9
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1891     1   s    s            do itr = 1, itrmx
            1892     1               
            1893     1               !  --- ...  1./ monin-obukkhov length-scale
            1894     1               
            1895     1   m    m              zetalt = max( zslt*rlmo, ztmin )
            1896     1   s    s              rlmo   = zetalt / zslt
            1897     1   s    s              zetalu = zslu * rlmo
            1898     1   s    s              zetau  = zu * rlmo
            1899     1   s    s              zetat  = zt * rlmo
            1900     1               
            1901     2   s    s              if (ilech == 0) then
            1902     2               
            1903     3   s    s                if (rlmo < 0.0) then
            1904     3   s    s                  xlu4 = 1.0 - 16.0 * zetalu
            1905     3   s    s                  xlt4 = 1.0 - 16.0 * zetalt
            1906     3   s    s                  xu4  = 1.0 - 16.0 * zetau
            1907     3   s    s                  xt4  = 1.0 - 16.0* zetat
            1908     3               
            1909     3   s    s                  xlu = sqrt( sqrt( xlu4 ) )
            1910     3   s    s                  xlt = sqrt( sqrt( xlt4 ) )
            1911     3   s    s                  xu  = sqrt( sqrt( xu4  ) )
            1912     3   s    s                  xt  = sqrt( sqrt( xt4  ) )
            1913     3               
            1914     3   s    s                  psmz = pspmu(xu)
            1915     3               
            1916     3               !           print*,'-----------1------------'
            1917     3               !           print*,'psmz=',psmz
            1918     3               !           print*,'pspmu(zetau)=',pspmu( zetau )
            1919     3               !           print*,'xu=',xu
            1920     3               !           print*,'------------------------'
            1921     3               
            1922     3   s    s                  simm = pspmu( xlu ) - psmz + rlogu
            1923     3   s    s                  pshz = psphu( xt  )
            1924     3   m    m                  simh = psphu( xlt ) - pshz + rlogt
            1925     3   s    s                else
            1926     3   s    s                  zetalu = min( zetalu, ztmax )
            1927     3   s    s                  zetalt = min( zetalt, ztmax )
            1928     3   s    s                  psmz = pspms( zetau )
            1929     3               
            1930     3               !           print*,'-----------2------------'
            1931     3               !           print*,'psmz=',psmz
            1932     3               !           print*,'pspms(zetau)=',pspms( zetau )
            1933     3               !           print*,'zetau=',zetau
            1934     3               !           print*,'------------------------'
            1935     3               
            1936     3   s    s                  simm = pspms( zetalu ) - psmz + rlogu
            1937     3   s    s                  pshz = psphs( zetat  )
            1938     3   s    s                  simh = psphs( zetalt ) - pshz + rlogt
            1939     3   p    v                endif   ! end if_rlmo_block
            1940     2               
            1941     2                       else
            1942     2               
            1943     2               !  --- ...  lech's functions
            1944     2               
            1945     3                         if (rlmo < 0.0) then
            1946     3                           psmz = pslmu( zetau )
            1947     3               
            1948     3               !           print*,'-----------3------------'
            1949     3               !           print*,'psmz=',psmz
            1950     3               !           print*,'pslmu(zetau)=',pslmu( zetau )
            1951     3               !           print*,'zetau=',zetau
            1952     3               !           print*,'------------------------'
            1953     3               
            1954     3                           simm = pslmu( zetalu ) - psmz + rlogu
            1955     3                           pshz = pslhu( zetat  )
            1956     3                           simh = pslhu( zetalt ) - pshz + rlogt
            1957     3                         else
            1958     3                           zetalu = min( zetalu, ztmax )
            1959     3                           zetalt = min( zetalt, ztmax )
            1960     3               
            1961     3                           psmz = pslms( zetau  )
            1962     3               
            1963     3               !           print*,'-----------4------------'
            1964     3               !           print*,'psmz=',psmz
            1965     3               !           print*,'pslms(zetau)=',pslms( zetau )
            1966     3               !           print*,'zetau=',zetau
            1967     3               !           print*,'------------------------'
            1968     3               
            1969     3                           simm = pslms( zetalu ) - psmz + rlogu
            1970     3                           pshz = pslhs( zetat  )
            1971     3                           simh = pslhs( zetalt ) - pshz + rlogt
            1972     3                         endif   ! end if_rlmo_block
            1973     2               
            1974     2   p    v              endif   ! end if_ilech_block
            1975     1               
            1976     1               !  --- ...  beljaars correction for ustar
            1977     1               
            1978     1   s    s              ustar = max( sqrt( cm*sqrt( du2+wstar2 ) ), epsust )
            1979     1               
            1980     1               !  --- ...  zilitinkevitch fix for zt
            1981     1               
            1982     1   s    s              zt = exp( zilfc*sqrt( ustar*z0 ) ) * z0
            1983     1               
            1984     1   s    s              zslt = zlvl + zt
            1985     1   s    s              rlogt = log( zslt/zt )
            1986     1               
            1987     1   s    s              ustark = ustar * vkrm
            1988     1   s    s              cm = max( ustark/simm, cxch )
            1989     1   s    s              ch = max( ustark/simh, cxch )
            1990     1               
            1991     1               !  --- ...  if statements to avoid tangent linear problems near zero
            1992     1               
            1993     2   s    s              if (btgh*ch*dthv /= 0.0) then
            1994     2   m    m                wstar2 = wwst2 * abs(btgh*ch*dthv) ** (2.0/3.0)
            1995     2   s    s              else
            1996     2   m    s                wstar2 = 0.0
            1997     2   p    v              endif
            1998     1               
            1999     1   s    s              rlmn = elfc*ch*dthv / ustar**3
            2000     1   s    s              rlma = rlmo*wold + rlmn*wnew
            2001     1               
            2002     1   s    s              rlmo = rlma
            2003     1               
            2004     1   p    v            enddo   ! end do_itr_loop
            2005                     
            2006                     !     print*,'----------------------------'
            2007                     !     print*,'sfcdif output !  ! ! ! ! ! ! ! !  !   !    !'
            2008                     !
            2009                     !     print*,'zlvl=',zlvl
            2010                     !     print*,'z0=',z0
            2011                     !     print*,'t1v=',t1v
            2012                     !     print*,'th2v=',th2v
            2013                     !     print*,'sfcspd=',sfcspd
            2014                     !     print*,'czil=',czil
            2015                     !     print*,'cm=',cm
            2016                     !     print*,'ch=',ch
            2017                     !     print*,'----------------------------'
            2018                     !
            2019                           return
            2020                     !...................................
            2021                           end subroutine sfcdif
            2022                     !-----------------------------------
            2023                     
            2024                     
            2025                     !-----------------------------------
            2026                           subroutine snfrac
            2027                     !...................................
            2028                     !  ---  inputs:
            2029                     !    &     ( sneqv, snup, salp, snowh,                                  &
            2030                     !  ---  outputs:
            2031                     !    &       sncovr                                                     &
            2032                     !    &     )
            2033                     
            2034                     ! ===================================================================== !
            2035                     !  description:                                                         !
            2036                     !                                                                       !
            2037                     !  subroutine snfrac calculatexsnow fraction (0 -> 1)                   !
            2038                     !                                                                       !
            2039                     !  subprogram called:  none                                             !
            2040                     !                                                                       !
            2041                     !                                                                       !
            2042                     !  ====================  defination of variables  ====================  !
            2043                     !                                                                       !
            2044                     !  inputs from the calling program:                              size   !
            2045                     !     sneqv    - real, snow water equivalent (m)                   1    !
            2046                     !     snup     - real, threshold sneqv depth above which sncovr=1  1    !
            2047                     !     salp     - real, tuning parameter                            1    !
            2048                     !     snowh    - real, snow depth (m)                              1    !
            2049                     !                                                                       !
            2050                     !  outputs to the calling program:                                      !
            2051                     !     sncovr   - real, fractional snow cover                       1    !
            2052                     !                                                                       !
            2053                     !  ====================    end of description    =====================  !
            2054                     !
            2055                     !  ---  inputs:
            2056                     !     real (kind=kind_phys),  intent(in) :: sneqv, snup, salp, snowh
            2057                     
            2058                     !  ---  outputs:
            2059                     !     real (kind=kind_phys),  intent(out) :: sncovr
            2060                     
            2061                     !  ---  locals:
            2062                           real (kind=kind_phys) :: rsnow, z0n
            2063                     
            2064                     !
            2065                     !===> ...  begin here
            2066                     !
            2067                     !  --- ...  snup is veg-class dependent snowdepth threshhold (set in routine
            2068                     !           redprm) above which snocvr=1.
            2069                     
            2070     1                         if (sneqv < snup) then
            2071     1                           rsnow = sneqv / snup
            2072     1                           sncovr = 1.0 - (exp(-salp*rsnow) - rsnow*exp(-salp))
            2073     1                         else
            2074     1                           sncovr = 1.0
            2075     1                         endif
            2076                     
            2077                               z0n = 0.035
            2078                     
            2079                     !  --- ...  formulation of dickinson et al. 1986
            2080                     
            2081                     !       sncovr = snowh / (snowh + 5.0*z0n)
            2082                     
            2083                     !  --- ...  formulation of marshall et al. 1994
            2084                     
            2085                     !       sncovr = sneqv / (sneqv + 2.0*z0n)
            2086                     
            2087                     !
            2088                           return
            2089                     !...................................
            2090                           end subroutine snfrac
            2091                     !-----------------------------------
            2092                     
            2093                     
            2094                     !-----------------------------------
            2095                           subroutine snopac
            2096                     !...................................
            2097                     !  ---  inputs:
            2098                     !    &     ( nsoil, nroot, etp, prcp, smcmax, smcwlt, smcref, smcdry,   &
            2099                     !    &       cmcmax, dt, df1, sfcems, sfctmp, t24, th2, fdown, epsca,   &
            2100                     !    &       bexp, pc, rch, rr, cfactr, slope, kdt, frzx, psisat,       &
            2101                     !    &       zsoil, dwsat, dksat, zbot, shdfac, ice, rtdis, quartz,     &
            2102                     !    &       fxexp, csoil, flx2, snowng,                                &
            2103                     !  ---  input/outputs:
            2104                     !    &       prcp1, cmc, t1, stc, sncovr, sneqv, sndens, snowh,         &
            2105                     !    &       sh2o, tbot, beta,                                          &
            2106                     !  ---  outputs:
            2107                     !    &       smc, ssoil, runoff1, runoff2, runoff3, edir, ec, et,       &
            2108                     !    &       ett, snomlt, drip, dew, flx1, flx3, esnow                  &
            2109                     !    &     )
            2110                     
            2111                     ! ===================================================================== !
            2112                     !  description:                                                         !
            2113                     !                                                                       !
            2114                     !  subroutine snopac calculates soil moisture and heat flux values and  !
            2115                     !  update soil moisture content and soil heat content values for the    !
            2116                     !  case when a snow pack is present.                                    !
            2117                     !                                                                       !
            2118                     !                                                                       !
            2119                     !  subprograms called:  evapo, smflx, shflx, snowpack
            2120                     !                                                                       !
            2121                     !  ====================  defination of variables  ====================  !
            2122                     !                                                                       !
            2123                     !  inputs from the calling program:                              size   !
            2124                     !     nsoil    - integer, number of soil layers                    1    !
            2125                     !     nroot    - integer, number of root layers                    1    !
            2126                     !     etp      - real, potential evaporation                       1    !
            2127                     !     prcp     - real, precip rate                                 1    !
            2128                     !     smcmax   - real, porosity                                    1    !
            2129                     !     smcwlt   - real, wilting point                               1    !
            2130                     !     smcref   - real, soil mois threshold                         1    !
            2131                     !     smcdry   - real, dry soil mois threshold                     1    !
            2132                     !     cmcmax   - real, maximum canopy water parameters             1    !
            2133                     !     dt       - real, time step                                   1    !
            2134                     !     df1      - real, thermal diffusivity                         m    !
            2135                     !     sfcems   - real, lw surface emissivity                       1    !
            2136                     !     sfctmp   - real, sfc temperature                             1    !
            2137                     !     t24      - real, sfctmp**4                                   1    !
            2138                     !     th2      - real, sfc air potential temperature               1    !
            2139                     !     fdown    - real, net solar + downward lw flux at sfc         1    !
            2140                     !     epsca    - real,                                             1    !
            2141                     !     bexp     - real, soil type "b" parameter                     1    !
            2142                     !     pc       - real, plant coeff                                 1    !
            2143                     !     rch      - real, companion coefficient of ch                 1    !
            2144                     !     rr       - real,                                             1    !
            2145                     !     cfactr   - real, canopy water parameters                     1    !
            2146                     !     slope    - real, linear reservoir coefficient                1    !
            2147                     !     kdt      - real,                                             1    !
            2148                     !     frzx     - real, frozen ground parameter                     1    !
            2149                     !     psisat   - real, saturated soil potential                    1    !
            2150                     !     zsoil    - real, soil layer depth below ground (negative)  nsoil  !
            2151                     !     dwsat    - real, saturated soil diffusivity                  1    !
            2152                     !     dksat    - real, saturated soil hydraulic conductivity       1    !
            2153                     !     zbot     - real, specify depth of lower bd soil              1    !
            2154                     !     shdfac   - real, aeral coverage of green vegetation          1    !
            2155                     !     ice      - integer, sea-ice flag (=1: sea-ice, =0: land)     1    !
            2156                     !     rtdis    - real, root distribution                         nsoil  !
            2157                     !     quartz   - real, soil quartz content                         1    !
            2158                     !     fxexp    - real, bare soil evaporation exponent              1    !
            2159                     !     csoil    - real, soil heat capacity                          1    !
            2160                     !     flx2     - real, freezing rain latent heat flux              1    !
            2161                     !     snowng   - logical, snow flag                                1    !
            2162                     !                                                                       !
            2163                     !  input/outputs from and to the calling program:                       !
            2164                     !     prcp1    - real, effective precip                            1    !
            2165                     !     cmc      - real, canopy moisture content                     1    !
            2166                     !     t1       - real, ground/canopy/snowpack eff skin temp        1    !
            2167                     !     stc      - real, soil temperature                          nsoil  !
            2168                     !     sncovr   - real, snow cover                                  1    !
            2169                     !     sneqv    - real, water-equivalent snow depth                 1    !
            2170                     !     sndens   - real, snow density                                1    !
            2171                     !     snowh    - real, snow depth                                  1    !
            2172                     !     sh2o     - real, unfrozen soil moisture                    nsoil  !
            2173                     !     tbot     - real, bottom soil temperature                     1    !
            2174                     !     beta     - real, ratio of actual/potential evap              1    !
            2175                     !                                                                       !
            2176                     !  outputs to the calling program:                                      !
            2177                     !     smc      - real, total soil moisture                       nsoil  !
            2178                     !     ssoil    - real, upward soil heat flux                       1    !
            2179                     !     runoff1  - real, surface runoff not infiltrating sfc         1    !
            2180                     !     runoff2  - real, sub surface runoff                          1    !
            2181                     !     runoff3  - real, excess of porosity for a given soil layer   1    !
            2182                     !     edir     - real, direct soil evaporation                     1    !
            2183                     !     ec       - real, canopy water evaporation                    1    !
            2184                     !     et       - real, plant transpiration                       nsoil  !
            2185                     !     ett      - real, total plant transpiration                   1    !
            2186                     !     snomlt   - real, snow melt water equivalent                  1    !
            2187                     !     drip     - real, through-fall of precip                      1    !
            2188                     !     dew      - real, dewfall (or frostfall)                      1    !
            2189                     !     flx1     - real, precip-snow sfc flux                        1    !
            2190                     !     flx3     - real, phase-change heat flux from snowmelt        1    !
            2191                     !     esnow    - real, sublimation from snowpack                   1    !
            2192                     !                                                                       !
            2193                     !  ====================    end of description    =====================  !
            2194                     !
            2195                     !  ---  constant parameters:
            2196                           real, parameter :: esdmin = 1.e-6
            2197                     
            2198                     !  ---  inputs:
            2199                     !     integer, intent(in) :: nsoil, nroot, ice
            2200                     
            2201                     !     real (kind=kind_phys), intent(in) :: etp, prcp, smcmax, smcref,   &
            2202                     !    &       smcwlt, smcdry, cmcmax, dt, df1, sfcems, sfctmp, t24,      &
            2203                     !    &       th2, fdown, epsca, bexp, pc, rch, rr, cfactr, slope, kdt,  &
            2204                     !    &       frzx, psisat, dwsat, dksat, zbot, shdfac, quartz,          &
            2205                     !    &       csoil, fxexp, flx2, zsoil(nsoil), rtdis(nsoil)
            2206                     
            2207                     !     logical, intent(in) :: snowng
            2208                     
            2209                     !  ---  input/outputs:
            2210                     !     real (kind=kind_phys), intent(inout) :: prcp1, t1, sncovr, sneqv, &
            2211                     !    &       sndens, snowh, cmc, tbot, beta, sh2o(nsoil), stc(nsoil)
            2212                     
            2213                     !  ---  outputs:
            2214                     !     real (kind=kind_phys), intent(out) :: ssoil, runoff1, runoff2,    &
            2215                     !    &       runoff3, edir, ec, et(nsoil), ett, snomlt, drip, dew,      &
            2216                     !    &       flx1, flx3, esnow, smc(nsoil)
            2217                     
            2218                     !  ---  locals:
            2219                           real (kind=kind_phys):: denom, dsoil, dtot, etp1, ssoil1,         &
            2220                                  snoexp, ex, t11, t12, t12a, t12b, yy, zz1, seh, t14,       &
            2221                                  ec1, edir1, ett1, etns, etns1, esnow1, esnow2, etanrg,     &
            2222                                  et1(nsoil)
            2223                     
            2224                           integer k
            2225                     
            2226                     !     data snoexp /1.0/    !!! <----- for noah v2.7
            2227                           data snoexp /2.0/    !!! <----- for noah v2.7.1
            2228                     
            2229                     !  --- ...  convert potential evap (etp) from kg m-2 s-1 to m s-1 and then to an
            2230                     !           amount (m) given timestep (dt) and call it an effective snowpack
            2231                     !           reduction amount, esnow2 (m) for a snowcover fraction = 1.0.  this is
            2232                     !           the amount the snowpack would be reduced due to sublimation from the
            2233                     !           snow sfc during the timestep.  sublimation will proceed at the
            2234                     !           potential rate unless the snow depth is less than the expected
            2235                     !           snowpack reduction.  for snowcover fraction = 1.0, 0=edir=et=ec, and
            2236                     !           hence total evap = esnow = sublimation (potential evap rate)
            2237                     
            2238                     !  --- ...  if sea-ice (ice=1) or glacial-ice (ice=-1), snowcover fraction = 1.0,
            2239                     !           and sublimation is at the potential rate.
            2240                     !           for non-glacial land (ice=0), if snowcover fraction < 1.0, total
            2241                     !           evaporation < potential due to non-potential contribution from
            2242                     !           non-snow covered fraction.
            2243                     
            2244                           prcp1 = prcp1 * 0.001
            2245                     
            2246                           edir  = 0.0
            2247                           edir1 = 0.0
            2248                     
            2249                           ec  = 0.0
            2250                           ec1 = 0.0
            2251                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      et1, et
                                   <<< Loop-information  End >>>
            2252     1  pp   2v            do k = 1, nsoil
            2253     1   p   2v              et (k) = 0.0
            2254     1   p   2v              et1(k) = 0.0
            2255     1   p   2v            enddo
            2256                     
            2257                           ett   = 0.0
            2258                           ett1  = 0.0
            2259                           etns  = 0.0
            2260                           etns1 = 0.0
            2261                           esnow = 0.0
            2262                           esnow1= 0.0
            2263                           esnow2= 0.0
            2264                     
            2265                           dew = 0.0
            2266                           etp1 = etp * 0.001
            2267                     
            2268     1                     if (etp < 0.0) then
            2269     1               
            2270     1               !  --- ...  if etp<0 (downward) then dewfall (=frostfall in this case).
            2271     1               
            2272     1                       dew = -etp1
            2273     1                       esnow2 = etp1 * dt
            2274     1                       etanrg = etp * ((1.0-sncovr)*lsubc + sncovr*lsubs)
            2275     1               
            2276     1                     else
            2277     1               
            2278     1               !  --- ...  etp >= 0, upward moisture flux
            2279     1               
            2280     2                       if (ice /= 0) then           ! for sea-ice and glacial-ice case
            2281     2               
            2282     2                         esnow = etp
            2283     2                         esnow1 = esnow * 0.001
            2284     2                         esnow2 = esnow1 * dt
            2285     2                         etanrg = esnow * lsubs
            2286     2               
            2287     2                       else                         ! for non-glacial land case
            2288     2               
            2289     3                         if (sncovr < 1.0) then
            2290     3               
            2291     3                           call evapo                                                  &
            2292     3               !  ---  inputs: &
            2293     3                          ( nsoil, nroot, cmc, cmcmax, etp1, dt, zsoil,                &
            2294     3                            sh2o, smcmax, smcwlt, smcref, smcdry, pc,                  &
            2295     3                            shdfac, cfactr, rtdis, fxexp,                              &
            2296     3               !  ---  outputs: &
            2297     3                            etns1, edir1, ec1, et1, ett1                               &
            2298     3                          )
            2299     3               
            2300     3                           edir1 = edir1 * (1.0 - sncovr)
            2301     3                           ec1 = ec1 * (1.0 - sncovr)
            2302     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      et1
                                   <<< Loop-information  End >>>
            2303     4  pp   2v                  do k = 1, nsoil
            2304     4   p   2v                    et1(k) = et1(k) * (1.0 - sncovr)
            2305     4   p   2v                  enddo
            2306     3               
            2307     3                           ett1  = ett1  * (1.0 - sncovr)
            2308     3                           etns1 = etns1 * (1.0 - sncovr)
            2309     3               
            2310     3                           edir = edir1 * 1000.0
            2311     3                           ec = ec1 * 1000.0
            2312     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      et1, et
                                   <<< Loop-information  End >>>
            2313     4  pp   2v                  do k = 1, nsoil
            2314     4   p   2v                    et(k) = et1(k) * 1000.0
            2315     4   p   2v                  enddo
            2316     3               
            2317     3                           ett = ett1 * 1000.0
            2318     3                           etns = etns1 * 1000.0
            2319     3               
            2320     3                         endif   ! end if_sncovr_block
            2321     2               
            2322     2                         esnow = etp * sncovr
            2323     2               !         esnow1 = etp * 0.001
            2324     2                         esnow1 = esnow * 0.001
            2325     2                         esnow2 = esnow1 * dt
            2326     2                         etanrg = esnow*lsubs + etns*lsubc
            2327     2               
            2328     2                       endif   ! end if_ice_block
            2329     1               
            2330     1                     endif   ! end if_etp_block
            2331                     
            2332                     !  --- ...  if precip is falling, calculate heat flux from snow sfc to newly
            2333                     !           accumulating precip.  note that this reflects the flux appropriate for
            2334                     !           the not-yet-updated skin temperature (t1).  assumes temperature of the
            2335                     !           snowfall striking the gound is =sfctmp (lowest model level air temp).
            2336                     
            2337                           flx1 = 0.0
            2338     1                     if ( snowng ) then
            2339     1                       flx1 = cpice * prcp * (t1 - sfctmp)
            2340     1                     else
            2341     1                       if (prcp > 0.0) flx1 = cph2o1 * prcp * (t1 - sfctmp)
            2342     1                     endif
            2343                     
            2344                     !  --- ...  calculate an 'effective snow-grnd sfc temp' (t12) based on heat
            2345                     !           fluxes between the snow pack and the soil and on net radiation.
            2346                     !           include flx1 (precip-snow sfc) and flx2 (freezing rain latent
            2347                     !           heat) fluxes.
            2348                     !           flx2 reflects freezing rain latent heat flux using t1 calculated
            2349                     !           in penman.
            2350                     
            2351                           dsoil = -0.5 * zsoil(1)
            2352                           dtot = snowh + dsoil
            2353                           denom = 1.0 + df1 / (dtot * rr * rch)
            2354                     
            2355                     !     t12a = ( (fdown - flx1 - flx2 - sigma1*t24) / rch                 &
            2356                     !    &     + th2 - sfctmp - beta*epsca ) / rr
            2357                           t12a = ( (fdown - flx1 - flx2 - sfcems*sigma1*t24) / rch          &
            2358                                + th2 - sfctmp - etanrg/rch ) / rr
            2359                     
            2360                           t12b = df1 * stc(1) / (dtot * rr * rch)
            2361                           t12 = (sfctmp + t12a + t12b) / denom
            2362                     
            2363                     !  --- ...  if the 'effective snow-grnd sfc temp' is at or below freezing, no snow
            2364                     !           melt will occur.  set the skin temp to this effective temp.  reduce
            2365                     !           (by sublimination ) or increase (by frost) the depth of the snowpack,
            2366                     !           depending on sign of etp.
            2367                     !           update soil heat flux (ssoil) using new skin temperature (t1)
            2368                     !           since no snowmelt, set accumulated snowmelt to zero, set 'effective'
            2369                     !           precip from snowmelt to zero, set phase-change heat flux from snowmelt
            2370                     !           to zero.
            2371                     
            2372     1                     if (t12 <= tfreez) then
            2373     1               
            2374     1                       t1 = t12
            2375     1               !old
            2376     1               !       ssoil = df1 * (t1 - stc(1)) / dtot
            2377     1               !new_ssoil
            2378     1                       ssoil = (t1 - stc (1)) * max(7.0, df1/dtot)
            2379     1                       sneqv = max(0.0, sneqv-esnow2)
            2380     1                       flx3 = 0.0
            2381     1                       ex = 0.0
            2382     1                       snomlt = 0.0
            2383     1               
            2384     1                     else
            2385     1               
            2386     1               !  --- ...  if the 'effective snow-grnd sfc temp' is above freezing, snow melt
            2387     1               !           will occur.  call the snow melt rate,ex and amt, snomlt.  revise the
            2388     1               !           effective snow depth.  revise the skin temp because it would have chgd
            2389     1               !           due to the latent heat released by the melting. calc the latent heat
            2390     1               !           released, flx3. set the effective precip, prcp1 to the snow melt rate,
            2391     1               !           ex for use in smflx.  adjustment to t1 to account for snow patches.
            2392     1               !           calculate qsat valid at freezing point.  note that esat (saturation
            2393     1               !           vapor pressure) value of 6.11e+2 used here is that valid at frzzing
            2394     1               !           point.  note that etp from call penman in sflx is ignored here in
            2395     1               !           favor of bulk etp over 'open water' at freezing temp.
            2396     1               !           update soil heat flux (s) using new skin temperature (t1)
            2397     1               
            2398     1               !  --- ...  noah v2.7.1   mek feb2004
            2399     1               !           non-linear weighting of snow vs non-snow covered portions of gridbox
            2400     1               !           so with snoexp = 2.0 (>1), surface skin temperature is higher than
            2401     1               !           for the linear case (snoexp = 1).
            2402     1               
            2403     1                       t1 = tfreez * sncovr**snoexp + t12 * (1.0 - sncovr**snoexp)
            2404     1               
            2405     1                       beta = 1.0
            2406     1                       ssoil = df1 * (t1 - stc(1)) / dtot
            2407     1               
            2408     1               !  --- ...  if potential evap (sublimation) greater than depth of snowpack.
            2409     1               !           beta<1
            2410     1               !           snowpack has sublimated away, set depth to zero.
            2411     1               
            2412     2                       if (sneqv-esnow2 <= esdmin) then
            2413     2               
            2414     2                         sneqv = 0.0
            2415     2                         ex = 0.0
            2416     2                         snomlt = 0.0
            2417     2                         flx3 = 0.0
            2418     2               
            2419     2                       else
            2420     2               
            2421     2               !  --- ...  potential evap (sublimation) less than depth of snowpack, retain
            2422     2               !           beta=1.
            2423     2               
            2424     2                         sneqv = sneqv - esnow2
            2425     2                         seh = rch * (t1 - th2)
            2426     2               
            2427     2                         t14 = t1 * t1
            2428     2                         t14 = t14 * t14
            2429     2               
            2430     2                         flx3 = fdown - flx1 - flx2 - sfcems*sigma1*t14                &
            2431     2                              - ssoil - seh - etanrg
            2432     2                         if (flx3 <= 0.0) flx3 = 0.0
            2433     2               
            2434     2                         ex = flx3 * 0.001 / lsubf
            2435     2               
            2436     2               !  --- ...  snowmelt reduction depending on snow cover
            2437     2               !           if snow cover less than 5% no snowmelt reduction
            2438     2               !     note: does 'if' below fail to match the melt water with the melt
            2439     2               !           energy?
            2440     2               
            2441     2               !         if (sncovr > 0.05) ex = ex * sncovr
            2442     2                         snomlt = ex * dt
            2443     2               
            2444     2               !  --- ...  esdmin represents a snowpack depth threshold value below which we
            2445     2               !           choose not to retain any snowpack, and instead include it in snowmelt.
            2446     2               
            2447     3                         if (sneqv-snomlt >= esdmin) then
            2448     3               
            2449     3                           sneqv = sneqv - snomlt
            2450     3               
            2451     3                         else
            2452     3               
            2453     3               !  --- ...  snowmelt exceeds snow depth
            2454     3               
            2455     3                           ex = sneqv / dt
            2456     3                           flx3 = ex * 1000.0 * lsubf
            2457     3                           snomlt = sneqv
            2458     3                           sneqv = 0.0
            2459     3               
            2460     3                         endif   ! end if_sneqv-snomlt_block
            2461     2               
            2462     2                       endif   ! end if_sneqv-esnow2_block
            2463     1               
            2464     1               !       prcp1 = prcp1 + ex
            2465     1               
            2466     1               !  --- ...  if non-glacial land, add snowmelt rate (ex) to precip rate to be used
            2467     1               !           in subroutine smflx (soil moisture evolution) via infiltration.
            2468     1               
            2469     1               !  --- ...  for sea-ice and glacial-ice, the snowmelt will be added to subsurface
            2470     1               !           runoff/baseflow later near the end of sflx (after return from call to
            2471     1               !           subroutine snopac)
            2472     1               
            2473     1                       if (ice == 0) prcp1 = prcp1 + ex
            2474     1               
            2475     1                     endif   ! end if_t12<=tfreez_block
            2476                     
            2477                     !  --- ...  final beta now in hand, so compute evaporation.  evap equals etp
            2478                     !           unless beta<1.
            2479                     
            2480                     !      eta = beta * etp
            2481                     
            2482                     !  --- ...  smflx returns updated soil moisture values for non-glacial land.
            2483                     !           if sea-ice (ice=1) or glacial-ice (ice=-1), skip call to smflx, since
            2484                     !           no soil medium for sea-ice or glacial-ice
            2485                     
            2486     1                     if (ice == 0) then
            2487     1               
            2488     1                       call smflx                                                        &
            2489     1               !  ---  inputs: &
            2490     1                          ( nsoil, dt, kdt, smcmax, smcwlt, cmcmax, prcp1,               &
            2491     1                            zsoil, slope, frzx, bexp, dksat, dwsat, shdfac,              &
            2492     1                            edir1, ec1, et1,                                             &
            2493     1               !  ---  input/outputs: &
            2494     1                            cmc, sh2o,                                                   &
            2495     1               !  ---  outputs: &
            2496     1                            smc, runoff1, runoff2, runoff3, drip                         &
            2497     1                          )
            2498     1               
            2499     1                     endif
            2500                     
            2501                     !  --- ...  before call shflx in this snowpack case, set zz1 and yy arguments to
            2502                     !           special values that ensure that ground heat flux calculated in shflx
            2503                     !           matches that already computer for below the snowpack, thus the sfc
            2504                     !           heat flux to be computed in shflx will effectively be the flux at the
            2505                     !           snow top surface.  t11 is a dummy arguement so we will not use the
            2506                     !           skin temp value as revised by shflx.
            2507                     
            2508                           zz1 = 1.0
            2509                           yy = stc(1) - 0.5*ssoil*zsoil(1)*zz1 / df1
            2510                           t11 = t1
            2511                     
            2512                     !  --- ...  shflx will calc/update the soil temps.  note:  the sub-sfc heat flux
            2513                     !           (ssoil1) and the skin temp (t11) output from this shflx call are not
            2514                     !           used  in any subsequent calculations. rather, they are dummy variables
            2515                     !           here in the snopac case, since the skin temp and sub-sfc heat flux are
            2516                     !           updated instead near the beginning of the call to snopac.
            2517                     
            2518                           call shflx                                                        &
            2519                     !  ---  inputs: &
            2520                                ( nsoil, smc, smcmax, dt, yy, zz1, zsoil, zbot,              &
            2521                                  psisat, bexp, df1, ice, quartz, csoil, vegtyp,             &
            2522                     !  ---  input/outputs: &
            2523                                  stc, t11, tbot, sh2o,                                      &
            2524                     !  ---  outputs: &
            2525                                  ssoil1                                                     &
            2526                                )
            2527                     
            2528                     !  --- ...  snow depth and density adjustment based on snow compaction.  yy is
            2529                     !           assumed to be the soil temperture at the top of the soil column.
            2530                     
            2531     1                     if (ice == 0) then              ! for non-glacial land
            2532     1               
            2533     2                       if (sneqv > 0.0) then
            2534     2               
            2535     2                         call snowpack                                                 &
            2536     2               !  ---  inputs: &
            2537     2                          ( sneqv, dt, t1, yy,                                         &
            2538     2               !  ---  input/outputs: &
            2539     2                            snowh, sndens                                              &
            2540     2                          )
            2541     2               
            2542     2                       else
            2543     2               
            2544     2                         sneqv = 0.0
            2545     2                         snowh = 0.0
            2546     2                         sndens = 0.0
            2547     2               !         sncond = 1.0
            2548     2                         sncovr = 0.0
            2549     2               
            2550     2                       endif   ! end if_sneqv_block
            2551     1               
            2552     1               !  --- ...  over sea-ice or glacial-ice, if s.w.e. (sneqv) below threshold lower
            2553     1               !           bound (0.01 m for sea-ice, 0.10 m for glacial-ice), then set at
            2554     1               !           lower bound and store the source increment in subsurface runoff/
            2555     1               !           baseflow (runoff2).  note:  runoff2 is then a negative value (as
            2556     1               !           a flag) over sea-ice or glacial-ice, in order to achieve water balance.
            2557     1               
            2558     1                     elseif (ice == 1) then          ! for sea-ice
            2559     1               
            2560     2                       if (sneqv >= 0.01) then
            2561     2               
            2562     2                         call snowpack                                                 &
            2563     2               !  ---  inputs: &
            2564     2                          ( sneqv, dt, t1, yy,                                         &
            2565     2               !  ---  input/outputs: &
            2566     2                            snowh, sndens                                              &
            2567     2                          )
            2568     2               
            2569     2                       else
            2570     2               
            2571     2               !         sndens = sneqv / snowh
            2572     2               !         runoff2 = -(0.01 - sneqv) / dt
            2573     2                         sneqv = 0.01
            2574     2                         snowh = 0.05
            2575     2                         sncovr = 1.0
            2576     2               !         snowh = sneqv / sndens
            2577     2               
            2578     2                       endif   ! end if_sneqv_block
            2579     1               
            2580     1                     else                            ! for glacial-ice
            2581     1               
            2582     2                       if (sneqv >= 0.10) then
            2583     2               
            2584     2                         call snowpack                                                 &
            2585     2               !  ---  inputs: &
            2586     2                          ( sneqv, dt, t1, yy,                                         &
            2587     2               !  ---  input/outputs: &
            2588     2                            snowh, sndens                                              &
            2589     2                          )
            2590     2               
            2591     2                       else
            2592     2               
            2593     2               !         sndens = sneqv / snowh
            2594     2               !         runoff2 = -(0.10 - sneqv) / dt
            2595     2                         sneqv = 0.10
            2596     2                         snowh = 0.50
            2597     2                         sncovr = 1.0
            2598     2               !         snowh = sneqv / sndens
            2599     2               
            2600     2                       endif   ! end if_sneqv_block
            2601     1               
            2602     1                     endif   ! end if_ice_block
            2603                     
            2604                     !
            2605                           return
            2606                     !...................................
            2607                           end subroutine snopac
            2608                     !-----------------------------------
            2609                     
            2610                     
            2611                     !-----------------------------------
            2612                           subroutine snow_new
            2613                     !...................................
            2614                     !  ---  inputs:
            2615                     !    &     ( sfctmp, sn_new,                                            &
            2616                     !  ---  input/outputs:
            2617                     !    &       snowh, sndens                                              &
            2618                     !    &     )
            2619                     
            2620                     ! ===================================================================== !
            2621                     !  description:                                                         !
            2622                     !                                                                       !
            2623                     !    subroutine snow_new calculates snow depth and densitity to account !
            2624                     !    for the new snowfall. new values of snow depth & density returned. !
            2625                     !                                                                       !
            2626                     !  subprogram called:  none                                             !
            2627                     !                                                                       !
            2628                     !  ====================  defination of variables  ====================  !
            2629                     !                                                                       !
            2630                     !  inputs from the calling program:                              size   !
            2631                     !     sfctmp   - real, surface air temperature (k)                 1    !
            2632                     !     sn_new   - real, new snowfall (m)                            1    !
            2633                     !                                                                       !
            2634                     !  input/outputs from and to the calling program:                       !
            2635                     !     snowh    - real, snow depth (m)                              1    !
            2636                     !     sndens   - real, snow density                                1    !
            2637                     !                      (g/cm3=dimensionless fraction of h2o density)    !
            2638                     !                                                                       !
            2639                     !  ====================    end of description    =====================  !
            2640                     !
            2641                     !  ---  inputs:
            2642                     !     real(kind=kind_phys), intent(in) :: sfctmp, sn_new
            2643                     
            2644                     !  ---  input/outputs:
            2645                     !     real(kind=kind_phys), intent(inout) :: snowh, sndens
            2646                     
            2647                     !  ---  locals:
            2648                           real(kind=kind_phys) :: dsnew, snowhc, hnewc, newsnc, tempc
            2649                     
            2650                     !
            2651                     !===> ...  begin here
            2652                     !
            2653                     !  --- ...  conversion into simulation units
            2654                     
            2655                           snowhc = snowh * 100.0
            2656                           newsnc = sn_new * 100.0
            2657                           tempc  = sfctmp - tfreez
            2658                     
            2659                     !  --- ...  calculating new snowfall density depending on temperature
            2660                     !           equation from gottlib l. 'a general runoff model for
            2661                     !           snowcovered and glacierized basin', 6th nordic hydrological
            2662                     !           conference, vemadolen, sweden, 1980, 172-177pp.
            2663                     
            2664     1                     if (tempc <= -15.0) then
            2665     1                       dsnew = 0.05
            2666     1                     else
            2667     1                       dsnew = 0.05 + 0.0017*(tempc + 15.0)**1.5
            2668     1                     endif
            2669                     
            2670                     !  --- ...  adjustment of snow density depending on new snowfall
            2671                     
            2672                           hnewc  = newsnc / dsnew
            2673                           sndens = (snowhc*sndens + hnewc*dsnew) / (snowhc + hnewc)
            2674                           snowhc = snowhc + hnewc
            2675                           snowh  = snowhc * 0.01
            2676                     !
            2677                           return
            2678                     !...................................
            2679                           end subroutine snow_new
            2680                     !-----------------------------------
            2681                     
            2682                     
            2683                     !-----------------------------------
            2684                           subroutine snowz0
            2685                     !...................................
            2686                     !  ---  inputs:
            2687                     !    &     ( sncovr,                                                    &
            2688                     !  ---  input/outputs:
            2689                     !    &       z0                                                         &
            2690                     !    &     )
            2691                     
            2692                     ! ===================================================================== !
            2693                     !  description:                                                         !
            2694                     !                                                                       !
            2695                     !    subroutine snowz0 calculates total roughness length over snow      !
            2696                     !                                                                       !
            2697                     !  subprogram called:  none                                             !
            2698                     !                                                                       !
            2699                     !  ====================  defination of variables  ====================  !
            2700                     !                                                                       !
            2701                     !  inputs from the calling program:                              size   !
            2702                     !     sncovr   - real, fractional snow cover                       1    !
            2703                     !                                                                       !
            2704                     !  input/outputs from and to the calling program:                       !
            2705                     !     z0       - real, roughness length (m)                        1    !
            2706                     !                                                                       !
            2707                     !  ====================    end of description    =====================  !
            2708                     !
            2709                     !  ---  inputs:
            2710                     !     real(kind=kind_phys), intent(in) :: sncovr
            2711                     
            2712                     !  ---  input/outputs:
            2713                     !     real(kind=kind_phys), intent(inout) :: z0
            2714                     
            2715                     !  ---  locals:
            2716                           real(kind=kind_phys) :: z0s
            2717                     !
            2718                     !===> ...  begin here
            2719                     !
            2720                     !     z0s = 0.001                     ! snow roughness length:=0.001 (m)
            2721                     !  --- ...  current noah lsm condition - mbek, 09-oct-2001
            2722                           z0s = z0
            2723                     
            2724                           z0 = (1.0 - sncovr)*z0 + sncovr*z0s
            2725                     
            2726                     !
            2727                           return
            2728                     !...................................
            2729                           end subroutine snowz0
            2730                     !-----------------------------------
            2731                     
            2732                     
            2733                     !-----------------------------------
            2734                           subroutine tdfcnd                                                 &
            2735                     !...................................
            2736                     !  ---  inputs: &
            2737                                ( smc, qz, smcmax, sh2o,                                     &
            2738                     !  ---  outputs: &
            2739                                  df                                                         &
            2740                                )
            2741                     
            2742                     ! ===================================================================== !
            2743                     !  description:                                                         !
            2744                     !                                                                       !
            2745                     !    subroutine tdfcnd calculates thermal diffusivity and conductivity  !
            2746                     !    of the soil for a given point and time.                            !
            2747                     !                                                                       !
            2748                     !    peters-lidard approach (peters-lidard et al., 1998)                !
            2749                     !    june 2001 changes: frozen soil condition.                          !
            2750                     !                                                                       !
            2751                     !  subprogram called:  none                                             !
            2752                     !                                                                       !
            2753                     !  use as in peters-lidard, 1998 (modif. from johansen, 1975).          !
            2754                     !                                 pablo grunmann, 08/17/98              !
            2755                     !  refs.:                                                               !
            2756                     !    farouki, o.t.,1986: thermal properties of soils. series on rock    !
            2757                     !             and soil mechanics, vol. 11, trans tech, 136 pp.          !
            2758                     !    johansen, o., 1975: thermal conductivity of soils. ph.d. thesis,   !
            2759                     !             university of trondheim,                                  !
            2760                     !    peters-lidard, c. d., et al., 1998: the effect of soil thermal     !
            2761                     !             conductivity parameterization on surface energy fluxes    !
            2762                     !             and temperatures. journal of the atmospheric sciences,    !
            2763                     !             vol. 55, pp. 1209-1224.                                   !
            2764                     !                                                                       !
            2765                     !  ====================  defination of variables  ====================  !
            2766                     !                                                                       !
            2767                     !  inputs:                                                       size   !
            2768                     !     smc      - real, top layer total soil moisture               1    !
            2769                     !     qz       - real, quartz content (soil type dependent)        1    !
            2770                     !     smcmax   - real, porosity                                    1    !
            2771                     !     sh2o     - real, top layer unfrozen soil moisture            1    !
            2772                     !                                                                       !
            2773                     !  outputs:                                                             !
            2774                     !     df       - real, soil thermal diffusivity and conductivity   1    !
            2775                     !                                                                       !
            2776                     !  locals:                                                              !
            2777                     !     thkw     - water thermal conductivity                        1    !
            2778                     !     thkqtz   - thermal conductivity for quartz                   1    !
            2779                     !     thko     - thermal conductivity for other soil components    1    !
            2780                     !     thkqtz   - thermal conductivity for the solids combined      1    !
            2781                     !     thkice   - ice thermal conductivity                          1    !
            2782                     !                                                                       !
            2783                     !                                                                       !
            2784                     !  ====================    end of description    =====================  !
            2785                     !
            2786                     !  ---  input:
            2787                           real (kind=kind_phys), intent(in) :: smc, qz, smcmax, sh2o
            2788                     
            2789                     !  ---  output:
            2790                           real (kind=kind_phys), intent(out) :: df
            2791                     
            2792                     !  ---  locals:
            2793                           real (kind=kind_phys) :: gammd, thkdry, ake, thkice, thko,        &
            2794                                  thkqtz, thksat, thks, thkw, satratio, xu, xunfroz
            2795                     !
            2796                     !===> ...  begin here
            2797                     !
            2798                     !  --- ...  if the soil has any moisture content compute a partial sum/product
            2799                     !           otherwise use a constant value which works well with most soils
            2800                     
            2801                     !  --- ...  saturation ratio:
            2802                     
            2803                           satratio = smc / smcmax
            2804                     
            2805                     !  --- ...  parameters  w/(m.k)
            2806                           thkice = 2.2
            2807                           thkw   = 0.57
            2808                           thko   = 2.0
            2809                     !     if (qz <= 0.2) thko = 3.0
            2810                           thkqtz = 7.7
            2811                     
            2812                     !  --- ...  solids' conductivity
            2813                     
            2814                           thks = (thkqtz**qz) * (thko**(1.0-qz))
            2815                     
            2816                     !  --- ...  unfrozen fraction (from 1., i.e., 100%liquid, to 0. (100% frozen))
            2817                     
            2818                           xunfroz = (sh2o + 1.e-9) / (smc + 1.e-9)
            2819                     
            2820                     !  --- ...  unfrozen volume for saturation (porosity*xunfroz)
            2821                     
            2822                           xu=xunfroz*smcmax
            2823                     
            2824                     !  --- ...  saturated thermal conductivity
            2825                     
            2826                           thksat = thks**(1.-smcmax) * thkice**(smcmax-xu) * thkw**(xu)
            2827                     
            2828                     !  --- ...  dry density in kg/m3
            2829                     
            2830                           gammd = (1.0 - smcmax) * 2700.0
            2831                     
            2832                     !  --- ...  dry thermal conductivity in w.m-1.k-1
            2833                     
            2834                           thkdry = (0.135*gammd + 64.7) / (2700.0 - 0.947*gammd)
            2835                     
            2836     1                     if ( sh2o+0.0005 < smc ) then         ! frozen
            2837     1               
            2838     1                       ake = satratio
            2839     1               
            2840     1                     else                                  ! unfrozen
            2841     1               
            2842     1               !  --- ...  range of validity for the kersten number (ake)
            2843     2                       if ( satratio > 0.1 ) then
            2844     2               
            2845     2               !  --- ...  kersten number (using "fine" formula, valid for soils containing
            2846     2               !           at least 5% of particles with diameter less than 2.e-6 meters.)
            2847     2               !           (for "coarse" formula, see peters-lidard et al., 1998).
            2848     2               
            2849     2                         ake = log10( satratio ) + 1.0
            2850     2               
            2851     2                       else
            2852     2               
            2853     2               !  --- ...  use k = kdry
            2854     2                         ake = 0.0
            2855     2               
            2856     2                       endif   ! end if_satratio_block
            2857     1               
            2858     1                     endif   ! end if_sh2o+0.0005_block
            2859                     
            2860                     !  --- ...  thermal conductivity
            2861                     
            2862                           df = ake * (thksat - thkdry) + thkdry
            2863                     !
            2864                           return
            2865                     !...................................
            2866                           end subroutine tdfcnd
            2867                     !-----------------------------------
            2868                     
            2869                     
            2870                     !*********************************************!
            2871                     !  section-2  2nd level subprograms           !
            2872                     !*********************************************!
            2873                     
            2874                     
            2875                     !-----------------------------------
            2876                           subroutine evapo                                                  &
            2877                     !...................................
            2878                     !  ---  inputs: &
            2879                                ( nsoil, nroot, cmc, cmcmax, etp1, dt, zsoil,                &
            2880                                  sh2o, smcmax, smcwlt, smcref, smcdry, pc,                  &
            2881                                  shdfac, cfactr, rtdis, fxexp,                              &
            2882                     !  ---  outputs: &
            2883                                  eta1, edir1, ec1, et1, ett1                                &
            2884                                )
            2885                     
            2886                     ! ===================================================================== !
            2887                     !  description:                                                         !
            2888                     !                                                                       !
            2889                     !  subroutine evapo calculates soil moisture flux.  the soil moisture   !
            2890                     !  content (smc - a per unit volume measurement) is a dependent variable!
            2891                     !  that is updated with prognostic eqns. the canopy moisture content    !
            2892                     !  (cmc) is also updated. frozen ground version:  new states added:     !
            2893                     !  sh2o, and frozen ground correction factor, frzfact and parameter     !
            2894                     !  slope.                                                               !
            2895                     !                                                                       !
            2896                     !                                                                       !
            2897                     !  subprogram called:  devap, transp                                    !
            2898                     !                                                                       !
            2899                     !  ====================  defination of variables  ====================  !
            2900                     !                                                                       !
            2901                     !  inputs from calling program:                                  size   !
            2902                     !     nsoil    - integer, number of soil layers                    1    !
            2903                     !     nroot    - integer, number of root layers                    1    !
            2904                     !     cmc      - real, canopy moisture content                     1    !
            2905                     !     cmcmax   - real, maximum canopy water parameters             1    !
            2906                     !     etp1     - real, potential evaporation                       1    !
            2907                     !     dt       - real, time step                                   1    !
            2908                     !     zsoil    - real, soil layer depth below ground             nsoil  !
            2909                     !     sh2o     - real, unfrozen soil moisture                    nsoil  !
            2910                     !     smcmax   - real, porosity                                    1    !
            2911                     !     smcwlt   - real, wilting point                               1    !
            2912                     !     smcref   - real, soil mois threshold                         1    !
            2913                     !     smcdry   - real, dry soil mois threshold                     1    !
            2914                     !     pc       - real, plant coeff                                 1    !
            2915                     !     cfactr   - real, canopy water parameters                     1    !
            2916                     !     rtdis    - real, root distribution                         nsoil  !
            2917                     !     fxexp    - real, bare soil evaporation exponent              1    !
            2918                     !                                                                       !
            2919                     !  outputs to calling program:                                          !
            2920                     !     eta1     - real, latent heat flux                            1    !
            2921                     !     edir1    - real, direct soil evaporation                     1    !
            2922                     !     ec1      - real, canopy water evaporation                    1    !
            2923                     !     et1      - real, plant transpiration                       nsoil  !
            2924                     !     ett1     - real, total plant transpiration                   1    !
            2925                     !                                                                       !
            2926                     !  ====================    end of description    =====================  !
            2927                     !
            2928                     !  ---  inputs:
            2929                           integer, intent(in) :: nsoil, nroot
            2930                     
            2931                           real (kind=kind_phys),  intent(in) :: cmc, cmcmax, etp1, dt, pc,  &
            2932                                  smcmax, smcwlt, smcref, smcdry, shdfac, cfactr, fxexp,     &
            2933                                  zsoil(nsoil), sh2o(nsoil), rtdis(nsoil)
            2934                     
            2935                     !  ---  outputs:
            2936                           real (kind=kind_phys),  intent(out) :: eta1, edir1, ec1, ett1,    &
            2937                                  et1(nsoil)
            2938                     
            2939                     !  ---  locals:
            2940                           real (kind=kind_phys) :: cmc2ms
            2941                     
            2942                           integer :: i, k
            2943                     
            2944                     !
            2945                     !===> ...  begin here
            2946                     !
            2947                     !  --- ...  executable code begins here if the potential evapotranspiration
            2948                     !           is greater than zero.
            2949                     
            2950                           edir1 = 0.0
            2951                           ec1 = 0.0
            2952                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      et1
                                   <<< Loop-information  End >>>
            2953     1  pp   4v            do k = 1, nsoil
            2954     1   p   4v              et1(k) = 0.0
            2955     1   p   4v            enddo
            2956                           ett1 = 0.0
            2957                     
            2958     1                     if (etp1 > 0.0) then
            2959     1               
            2960     1               !  --- ...  retrieve direct evaporation from soil surface.  call this function
            2961     1               !           only if veg cover not complete.
            2962     1               !           frozen ground version:  sh2o states replace smc states.
            2963     1               
            2964     2                       if (shdfac < 1.0) then
            2965     2               
            2966     2    i                    call devap                                                    &
            2967     2               !  ---  inputs: &
            2968     2                          ( etp1, sh2o(1), shdfac, smcmax, smcdry, fxexp,              &
            2969     2               !  ---  outputs: &
            2970     2                            edir1                                                      &
            2971     2                          )
            2972     2               
            2973     2                       endif
            2974     1               
            2975     1               !  --- ...  initialize plant total transpiration, retrieve plant transpiration,
            2976     1               !           and accumulate it for all soil layers.
            2977     1               
            2978     2                       if (shdfac > 0.0) then
            2979     2               
            2980     2                         call transp                                                   &
            2981     2               !  ---  inputs: &
            2982     2                          ( nsoil, nroot, etp1, sh2o, smcwlt, smcref,                  &
            2983     2                            cmc, cmcmax, zsoil, shdfac, pc, cfactr, rtdis,             &
            2984     2               !  ---  outputs: &
            2985     2                            et1                                                        &
            2986     2                          )
            2987     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            2988     3  pp    v                do k = 1, nsoil
            2989     3   p    v                  ett1 = ett1 + et1(k)
            2990     3   p    v                enddo
            2991     2               
            2992     2               !  --- ...  calculate canopy evaporation.
            2993     2               !           if statements to avoid tangent linear problems near cmc=0.0.
            2994     2               
            2995     3                         if (cmc > 0.0) then
            2996     3                           ec1 = shdfac * ( (cmc/cmcmax)**cfactr ) * etp1
            2997     3                         else
            2998     3                           ec1 = 0.0
            2999     3                         endif
            3000     2               
            3001     2               !  --- ...  ec should be limited by the total amount of available water
            3002     2               !           on the canopy.  -f.chen, 18-oct-1994
            3003     2               
            3004     2                         cmc2ms = cmc / dt
            3005     2                         ec1 = min ( cmc2ms, ec1 )
            3006     2                       endif
            3007     1               
            3008     1                     endif   ! end if_etp1_block
            3009                     
            3010                     !  --- ...  total up evap and transp types to obtain actual evapotransp
            3011                     
            3012                           eta1 = edir1 + ett1 + ec1
            3013                     
            3014                     !
            3015                           return
            3016                     !...................................
            3017                           end subroutine evapo
            3018                     !-----------------------------------
            3019                     
            3020                     
            3021                     !-----------------------------------
            3022                           subroutine shflx                                                  &
            3023                     !...................................
            3024                     !  ---  inputs: &
            3025                                ( nsoil, smc, smcmax, dt, yy, zz1, zsoil, zbot,              &
            3026                                  psisat, bexp, df1, ice, quartz, csoil, vegtyp,             &
            3027                     !  ---  input/outputs: &
            3028                                  stc, t1, tbot, sh2o,                                       &
            3029                     !  ---  outputs: &
            3030                                  ssoil                                                      &
            3031                                )
            3032                     
            3033                     ! ===================================================================== !
            3034                     !  description:                                                         !
            3035                     !                                                                       !
            3036                     !  subroutine shflx updates the temperature state of the soil column    !
            3037                     !  based on the thermal diffusion equation and update the frozen soil   !
            3038                     !  moisture content based on the temperature.                           !
            3039                     !                                                                       !
            3040                     !  subprogram called:  hstep, hrtice, hrt                               !
            3041                     !                                                                       !
            3042                     !                                                                       !
            3043                     !  ====================  defination of variables  ====================  !
            3044                     !                                                                       !
            3045                     !  inputs:                                                       size   !
            3046                     !     nsoil    - integer, number of soil layers                    1    !
            3047                     !     smc      - real, total soil moisture                       nsoil  !
            3048                     !     smcmax   - real, porosity (sat val of soil mois)             1    !
            3049                     !     dt       - real, time step                                   1    !
            3050                     !     yy       - real, soil temperature at the top of column       1    !
            3051                     !     zz1      - real,                                             1    !
            3052                     !     zsoil    - real, soil layer depth below ground (negative)  nsoil  !
            3053                     !     zbot     - real, specify depth of lower bd soil              1    !
            3054                     !     psisat   - real, saturated soil potential                    1    !
            3055                     !     bexp     - real, soil type "b" parameter                     1    !
            3056                     !     df1      - real, thermal diffusivity and conductivity        1    !
            3057                     !     ice      - integer, sea-ice flag (=1: sea-ice, =0: land)     1    !
            3058                     !     quartz   - real, soil quartz content                         1    !
            3059                     !     csoil    - real, soil heat capacity                          1    !
            3060                     !     vegtyp   - integer, vegtation type                           1    !
            3061                     !                                                                       !
            3062                     !  input/outputs:                                                       !
            3063                     !     stc      - real, soil temp                                 nsoil  !
            3064                     !     t1       - real, ground/canopy/snowpack eff skin temp        1    !
            3065                     !     tbot     - real, bottom soil temp                            1    !
            3066                     !     sh2o     - real, unfrozen soil moisture                    nsoil  !
            3067                     !                                                                       !
            3068                     !  outputs:                                                             !
            3069                     !     ssoil    - real, upward soil heat flux                       1    !
            3070                     !                                                                       !
            3071                     !  ====================    end of description    =====================  !
            3072                     !
            3073                     !  ---  parameter constants:
            3074                           real (kind=kind_phys), parameter :: ctfil1 = 0.5
            3075                           real (kind=kind_phys), parameter :: ctfil2 = 1.0 - ctfil1
            3076                     
            3077                     !  ---  inputs:
            3078                           integer, intent(in) :: nsoil, ice, vegtyp
            3079                     
            3080                           real (kind=kind_phys), intent(in) :: smc(nsoil), smcmax, dt, yy,  &
            3081                                  zz1, zsoil(nsoil), zbot, psisat, bexp, df1, quartz, csoil
            3082                     
            3083                     !  ---  input/outputs:
            3084                           real (kind=kind_phys), intent(inout) :: stc(nsoil), t1, tbot,     &
            3085                                  sh2o(nsoil)
            3086                     
            3087                     !  ---  outputs:
            3088                           real (kind=kind_phys), intent(out) :: ssoil
            3089                     
            3090                     !  ---  locals:
            3091                           real (kind=kind_phys) :: ai(nsold), bi(nsold), ci(nsold), oldt1,  &
            3092                                  rhsts(nsold), stcf(nsold), stsoil(nsoil)
            3093                     
            3094                           integer :: i
            3095                     
            3096                     !
            3097                     !===> ...  begin here
            3098                     !
            3099                           oldt1 = t1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      stc, stsoil
                                   <<< Loop-information  End >>>
            3100     1  pp   4v            do i = 1, nsoil
            3101     1   p   4v               stsoil(i) = stc(i)
            3102     1   p   4v            enddo
            3103                     
            3104                     !  --- ...  hrt routine calcs the right hand side of the soil temp dif eqn
            3105                     
            3106     1                     if (ice /= 0) then
            3107     1               
            3108     1               !  --- ...  sea-ice case, glacial-ice case
            3109     1               
            3110     1                       call hrtice                                                     &
            3111     1               !  ---  inputs: &
            3112     1                          ( nsoil, stc, zsoil, yy, zz1, df1, ice,                      &
            3113     1               !  ---  input/outputs: &
            3114     1                            tbot,                                                      &
            3115     1               !  ---  outputs: &
            3116     1                            rhsts, ai, bi, ci                                          &
            3117     1                          )
            3118     1               
            3119     1                       call hstep                                                      &
            3120     1               !  ---  inputs: &
            3121     1                          ( nsoil, stc, dt,                                            &
            3122     1               !  ---  input/outputs: &
            3123     1                            rhsts, ai, bi, ci,                                         &
            3124     1               !  ---  outputs: &
            3125     1                            stcf                                                       &
            3126     1                          )
            3127     1               
            3128     1                     else
            3129     1               
            3130     1               !  --- ...  land-mass case
            3131     1               
            3132     1                       call hrt                                                        &
            3133     1               !  ---  inputs: &
            3134     1                          ( nsoil, stc, smc, smcmax, zsoil, yy, zz1, tbot,             &
            3135     1                            zbot, psisat, dt, bexp, df1, quartz, csoil,vegtyp,         &
            3136     1               !  ---  input/outputs: &
            3137     1                            sh2o,                                                      &
            3138     1               !  ---  outputs: &
            3139     1                            rhsts, ai, bi, ci                                          &
            3140     1                          )
            3141     1               
            3142     1                       call hstep                                                      &
            3143     1               !  ---  inputs: &
            3144     1                          ( nsoil, stc, dt,                                            &
            3145     1               !  ---  input/outputs: &
            3146     1                            rhsts, ai, bi, ci,                                         &
            3147     1               !  ---  outputs: &
            3148     1                            stcf                                                       &
            3149     1                          )
            3150     1               
            3151     1                     endif
            3152                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      stcf, stc
                                   <<< Loop-information  End >>>
            3153     1  pp    v            do i = 1, nsoil
            3154     1   p    v               stc(i) = stcf(i)
            3155     1   p    v            enddo
            3156                     
            3157                     !  --- ...  in the no snowpack case (via routine nopac branch,) update the grnd
            3158                     !           (skin) temperature here in response to the updated soil temperature
            3159                     !           profile above.  (note: inspection of routine snopac shows that t1
            3160                     !           below is a dummy variable only, as skin temperature is updated
            3161                     !           differently in routine snopac)
            3162                     
            3163                           t1 = (yy + (zz1 - 1.0)*stc(1)) / zz1
            3164                           t1 = ctfil1*t1 + ctfil2*oldt1
            3165                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 272, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      stc, stsoil
                                   <<< Loop-information  End >>>
            3166     1  pp   2v            do i = 1, nsoil
            3167     1   p   2v              stc(i) = ctfil1*stc(i) + ctfil2*stsoil(i)
            3168     1   p   2v            enddo
            3169                     
            3170                     !  --- ...  calculate surface soil heat flux
            3171                     
            3172                           ssoil = df1*(stc(1) - t1) / (0.5*zsoil(1))
            3173                     
            3174                     !
            3175                           return
            3176                     !...................................
            3177                           end subroutine shflx
            3178                     !-----------------------------------
            3179                     
            3180                     
            3181                     
            3182                     !-----------------------------------
            3183                           subroutine smflx                                                    &
            3184                     !...................................
            3185                     !  ---  inputs: &
            3186                                ( nsoil, dt, kdt, smcmax, smcwlt, cmcmax, prcp1,               &
            3187                                  zsoil, slope, frzx, bexp, dksat, dwsat, shdfac,              &
            3188                                  edir1, ec1, et1,                                             &
            3189                     !  ---  input/outputs: &
            3190                                  cmc, sh2o,                                                   &
            3191                     !  ---  outputs: &
            3192                                  smc, runoff1, runoff2, runoff3, drip                         &
            3193                                )
            3194                     
            3195                     ! ===================================================================== !
            3196                     !  description:                                                         !
            3197                     !                                                                       !
            3198                     !  subroutine smflx calculates soil moisture flux.  the soil moisture   !
            3199                     !  content (smc - a per unit volume measurement) is a dependent variable!
            3200                     !  that is updated with prognostic eqns. the canopy moisture content    !
            3201                     !  (cmc) is also updated. frozen ground version:  new states added: sh2o!
            3202                     !  and frozen ground correction factor, frzx and parameter slope.       !
            3203                     !                                                                       !
            3204                     !                                                                       !
            3205                     !  subprogram called:  srt, sstep                                       !
            3206                     !                                                                       !
            3207                     !  ====================  defination of variables  ====================  !
            3208                     !                                                                       !
            3209                     !  inputs:                                                       size   !
            3210                     !     nsoil    - integer, number of soil layers                    1    !
            3211                     !     dt       - real, time step                                   1    !
            3212                     !     kdt      - real,                                             1    !
            3213                     !     smcmax   - real, porosity                                    1    !
            3214                     !     smcwlt   - real, wilting point                               1    !
            3215                     !     cmcmax   - real, maximum canopy water parameters             1    !
            3216                     !     prcp1    - real, effective precip                            1    !
            3217                     !     zsoil    - real, soil layer depth below ground (negative)  nsoil  !
            3218                     !     slope    - real, linear reservoir coefficient                1    !
            3219                     !     frzx     - real, frozen ground parameter                     1    !
            3220                     !     bexp     - real, soil type "b" parameter                     1    !
            3221                     !     dksat    - real, saturated soil hydraulic conductivity       1    !
            3222                     !     dwsat    - real, saturated soil diffusivity                  1    !
            3223                     !     shdfac   - real, aeral coverage of green veg                 1    !
            3224                     !     edir1    - real, direct soil evaporation                     1    !
            3225                     !     ec1      - real, canopy water evaporation                    1    !
            3226                     !     et1      - real, plant transpiration                       nsoil  !
            3227                     !                                                                       !
            3228                     !  input/outputs:                                                       !
            3229                     !     cmc      - real, canopy moisture content                     1    !
            3230                     !     sh2o     - real, unfrozen soil moisture                    nsoil  !
            3231                     !                                                                       !
            3232                     !  outputs:                                                             !
            3233                     !     smc      - real, total soil moisture                       nsoil  !
            3234                     !     runoff1  - real, surface runoff not infiltrating sfc         1    !
            3235                     !     runoff2  - real, sub surface runoff (baseflow)               1    !
            3236                     !     runoff3  - real, excess of porosity                          1    !
            3237                     !     drip     - real, through-fall of precip and/or dew           1    !
            3238                     !                                                                       !
            3239                     !  ====================    end of description    =====================  !
            3240                     !
            3241                     !  ---  inputs:
            3242                           integer, intent(in) :: nsoil
            3243                     
            3244                           real (kind=kind_phys),  intent(in) :: dt, kdt, smcmax, smcwlt,    &
            3245                                  cmcmax, prcp1, slope, frzx, bexp, dksat, dwsat, shdfac,    &
            3246                                  edir1, ec1, et1(nsoil), zsoil(nsoil)
            3247                     
            3248                     !  ---  input/outputs:
            3249                           real (kind=kind_phys),  intent(inout) :: cmc, sh2o(nsoil)
            3250                     
            3251                     !  ---  outputs:
            3252                           real (kind=kind_phys),  intent(out) :: smc(nsoil), runoff1,       &
            3253                                  runoff2, runoff3, drip
            3254                     
            3255                     !  ---  locals:
            3256                           real (kind=kind_phys) :: dummy, excess, pcpdrp, rhsct, trhsct,    &
            3257                                  rhstt(nsold), sice(nsold), sh2oa(nsold), sh2ofg(nsold),    &
            3258                                  ai(nsold), bi(nsold), ci(nsold)
            3259                     
            3260                           integer :: i, k
            3261                     !
            3262                     !===> ...  begin here
            3263                     !
            3264                     !  --- ...  executable code begins here.
            3265                     
            3266                           dummy = 0.0
            3267                     
            3268                     !  --- ...  compute the right hand side of the canopy eqn term ( rhsct )
            3269                     
            3270                           rhsct = shdfac*prcp1 - ec1
            3271                     
            3272                     !  --- ...  convert rhsct (a rate) to trhsct (an amount) and add it to
            3273                     !           existing cmc.  if resulting amt exceeds max capacity, it becomes
            3274                     !           drip and will fall to the grnd.
            3275                     
            3276                           drip = 0.0
            3277                           trhsct = dt * rhsct
            3278                           excess = cmc + trhsct
            3279                     
            3280                           if (excess > cmcmax) drip = excess - cmcmax
            3281                     
            3282                     !  --- ...  pcpdrp is the combined prcp1 and drip (from cmc) that goes into
            3283                     !           the soil
            3284                     
            3285                           pcpdrp = (1.0 - shdfac)*prcp1 + drip/dt
            3286                     
            3287                     !  --- ...  store ice content at each soil layer before calling srt & sstep
            3288                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sh2o, smc, sice
                                   <<< Loop-information  End >>>
            3289     1   s    v            do i = 1, nsoil
            3290     1   p    v              sice(i) = smc(i) - sh2o(i)
            3291     1   p    v            enddo
            3292                     
            3293                     !  --- ...  call subroutines srt and sstep to solve the soil moisture
            3294                     !           tendency equations.
            3295                     
            3296                     !  ---  if the infiltrating precip rate is nontrivial,
            3297                     !         (we consider nontrivial to be a precip total over the time step
            3298                     !         exceeding one one-thousandth of the water holding capacity of
            3299                     !         the first soil layer)
            3300                     !       then call the srt/sstep subroutine pair twice in the manner of
            3301                     !         time scheme "f" (implicit state, averaged coefficient)
            3302                     !         of section 2 of kalnay and kanamitsu (1988, mwr, vol 116,
            3303                     !         pages 1945-1958)to minimize 2-delta-t oscillations in the
            3304                     !         soil moisture value of the top soil layer that can arise because
            3305                     !         of the extreme nonlinear dependence of the soil hydraulic
            3306                     !         diffusivity coefficient and the hydraulic conductivity on the
            3307                     !         soil moisture state
            3308                     !       otherwise call the srt/sstep subroutine pair once in the manner of
            3309                     !         time scheme "d" (implicit state, explicit coefficient)
            3310                     !         of section 2 of kalnay and kanamitsu
            3311                     !       pcpdrp is units of kg/m**2/s or mm/s, zsoil is negative depth in m
            3312                     
            3313                     !     if ( pcpdrp .gt. 0.0 ) then
            3314     1                     if ( (pcpdrp*dt) > (0.001*1000.0*(-zsoil(1))*smcmax) ) then
            3315     1               
            3316     1               !  --- ...  frozen ground version:
            3317     1               !           smc states replaced by sh2o states in srt subr.  sh2o & sice states
            3318     1               !           included in sstep subr.  frozen ground correction factor, frzx
            3319     1               !           added.  all water balance calculations using unfrozen water
            3320     1               
            3321     1                       call srt                                                        &
            3322     1               !  ---  inputs: &
            3323     1                          ( nsoil, edir1, et1, sh2o, sh2o, pcpdrp, zsoil, dwsat,       &
            3324     1                            dksat, smcmax, bexp, dt, smcwlt, slope, kdt, frzx, sice,   &
            3325     1               !  ---  outputs: &
            3326     1                            rhstt, runoff1, runoff2, ai, bi, ci                        &
            3327     1                          )
            3328     1               
            3329     1                       call sstep                                                      &
            3330     1               !  ---  inputs: &
            3331     1                          ( nsoil, sh2o, rhsct, dt, smcmax, cmcmax, zsoil, sice,       &
            3332     1               !  ---  input/outputs: &
            3333     1                            dummy, rhstt, ai, bi, ci,                                  &
            3334     1               !  ---  outputs: &
            3335     1                            sh2ofg, runoff3, smc                                       &
            3336     1                          )
            3337     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sh2ofg, sh2o, sh2oa
                                   <<< Loop-information  End >>>
            3338     2   s    v              do k = 1, nsoil
            3339     2   p    v                sh2oa(k) = (sh2o(k) + sh2ofg(k)) * 0.5
            3340     2   p    v              enddo
            3341     1               
            3342     1                       call srt                                                        &
            3343     1               !  ---  inputs: &
            3344     1                          ( nsoil, edir1, et1, sh2o, sh2oa, pcpdrp, zsoil, dwsat,      &
            3345     1                            dksat, smcmax, bexp, dt, smcwlt, slope, kdt, frzx, sice,   &
            3346     1               !  ---  outputs: &
            3347     1                            rhstt, runoff1, runoff2, ai, bi, ci                        &
            3348     1                          )
            3349     1               
            3350     1                       call sstep                                                      &
            3351     1               !  ---  inputs: &
            3352     1                          ( nsoil, sh2o, rhsct, dt, smcmax, cmcmax, zsoil, sice,       &
            3353     1               !  ---  input/outputs: &
            3354     1                            cmc, rhstt, ai, bi, ci,                                    &
            3355     1               !  ---  outputs: &
            3356     1                            sh2o, runoff3, smc                                         &
            3357     1                          )
            3358     1               
            3359     1                     else
            3360     1               
            3361     1                       call srt                                                        &
            3362     1               !  ---  inputs: &
            3363     1                          ( nsoil, edir1, et1, sh2o, sh2o, pcpdrp, zsoil, dwsat,       &
            3364     1                            dksat, smcmax, bexp, dt, smcwlt, slope, kdt, frzx, sice,   &
            3365     1               !  ---  outputs: &
            3366     1                            rhstt, runoff1, runoff2, ai, bi, ci                        &
            3367     1                          )
            3368     1               
            3369     1                       call sstep                                                      &
            3370     1               !  ---  inputs: &
            3371     1                          ( nsoil, sh2o, rhsct, dt, smcmax, cmcmax, zsoil, sice,       &
            3372     1               !  ---  input/outputs: &
            3373     1                            cmc, rhstt, ai, bi, ci,                                    &
            3374     1               !  ---  outputs: &
            3375     1                            sh2o, runoff3, smc                                         &
            3376     1                          )
            3377     1               
            3378     1                     endif
            3379                     
            3380                     !     runof = runoff
            3381                     !
            3382                           return
            3383                     !...................................
            3384                           end subroutine smflx
            3385                     !-----------------------------------
            3386                     
            3387                     
            3388                     !-----------------------------------
            3389                           subroutine snowpack                                               &
            3390                     !...................................
            3391                     !  ---  inputs: &
            3392                                ( esd, dtsec, tsnow, tsoil,                                  &
            3393                     !  ---  input/outputs: &
            3394                                  snowh, sndens                                              &
            3395                                )
            3396                     
            3397                     ! ===================================================================== !
            3398                     !  description:                                                         !
            3399                     !                                                                       !
            3400                     !    subroutine snowpack calculates compaction of snowpack under        !
            3401                     !    conditions of increasing snow density, as obtained from an         !
            3402                     !    approximate solution of e. anderson's differential equation (3.29),!
            3403                     !    noaa technical report nws 19, by victor koren, 03/25/95.           !
            3404                     !    subroutine will return new values of snowh and sndens              !
            3405                     !                                                                       !
            3406                     !                                                                       !
            3407                     !  subprogram called:  none                                             !
            3408                     !                                                                       !
            3409                     !                                                                       !
            3410                     !  ====================  defination of variables  ====================  !
            3411                     !                                                                       !
            3412                     !  inputs:                                                       size   !
            3413                     !     esd      - real, water equivalent of snow (m)                1    !
            3414                     !     dtsec    - real, time step (sec)                             1    !
            3415                     !     tsnow    - real, snow surface temperature (k)                1    !
            3416                     !     tsoil    - real, soil surface temperature (k)                1    !
            3417                     !                                                                       !
            3418                     !  input/outputs:                                                       !
            3419                     !     snowh    - real, snow depth (m)                              1    !
            3420                     !     sndens   - real, snow density                                1    !
            3421                     !                      (g/cm3=dimensionless fraction of h2o density)    !
            3422                     !                                                                       !
            3423                     !  ====================    end of description    =====================  !
            3424                     !
            3425                     !  ---  parameter constants:
            3426                           real (kind=kind_phys), parameter :: c1 = 0.01
            3427                           real (kind=kind_phys), parameter :: c2 = 21.0
            3428                     
            3429                     !  ---  inputs:
            3430                           real (kind=kind_phys), intent(in) :: esd, dtsec, tsnow, tsoil
            3431                     
            3432                     !  ---  input/outputs:
            3433                           real (kind=kind_phys), intent(inout) :: snowh, sndens
            3434                     
            3435                     !  ---  locals:
            3436                           real (kind=kind_phys) :: bfac, dsx, dthr, dw, snowhc, pexp,       &
            3437                                  tavgc, tsnowc, tsoilc, esdc, esdcx
            3438                     
            3439                           integer :: ipol, j
            3440                     !
            3441                     !===> ...  begin here
            3442                     !
            3443                     !  --- ...  conversion into simulation units
            3444                     
            3445                           snowhc = snowh * 100.0
            3446                           esdc   = esd * 100.0
            3447                           dthr   = dtsec / 3600.0
            3448                           tsnowc = tsnow - tfreez
            3449                           tsoilc = tsoil - tfreez
            3450                     
            3451                     !  --- ...  calculating of average temperature of snow pack
            3452                     
            3453                           tavgc = 0.5 * (tsnowc + tsoilc)
            3454                     
            3455                     !  --- ...  calculating of snow depth and density as a result of compaction
            3456                     !           sndens=ds0*(exp(bfac*esd)-1.)/(bfac*esd)
            3457                     !           bfac=dthr*c1*exp(0.08*tavgc-c2*ds0)
            3458                     !     note: bfac*esd in sndens eqn above has to be carefully treated
            3459                     !           numerically below:
            3460                     !        c1 is the fractional increase in density (1/(cm*hr))
            3461                     !        c2 is a constant (cm3/g) kojima estimated as 21 cms/g
            3462                     
            3463     1                     if (esdc > 1.e-2) then
            3464     1                       esdcx = esdc
            3465     1                     else
            3466     1                       esdcx = 1.e-2
            3467     1                     endif
            3468                     
            3469                           bfac = dthr*c1 * exp(0.08*tavgc - c2*sndens)
            3470                     
            3471                     !     dsx = sndens * ((dexp(bfac*esdc)-1.0) / (bfac*esdc))
            3472                     
            3473                     !  --- ...  the function of the form (e**x-1)/x imbedded in above expression
            3474                     !           for dsx was causing numerical difficulties when the denominator "x"
            3475                     !           (i.e. bfac*esdc) became zero or approached zero (despite the fact
            3476                     !           that the analytical function (e**x-1)/x has a well defined limit
            3477                     !           as "x" approaches zero), hence below we replace the (e**x-1)/x
            3478                     !           expression with an equivalent, numerically well-behaved
            3479                     !           polynomial expansion.
            3480                     
            3481                     !  --- ...  number of terms of polynomial expansion, and hence its accuracy,
            3482                     !           is governed by iteration limit "ipol".
            3483                     !           ipol greater than 9 only makes a difference on double
            3484                     !           precision (relative errors given in percent %).
            3485                     !       ipol=9, for rel.error <~ 1.6 e-6 % (8 significant digits)
            3486                     !       ipol=8, for rel.error <~ 1.8 e-5 % (7 significant digits)
            3487                     !       ipol=7, for rel.error <~ 1.8 e-4 % ...
            3488                     
            3489                           ipol = 4
            3490                           pexp = 0.0
            3491                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 4)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3492     1   s   fm            do j = ipol, 1, -1
            3493     1               !       pexp = (1.0 + pexp)*bfac*esdc /real(j+1)
            3494     1   m   fm              pexp = (1.0 + pexp)*bfac*esdcx/real(j+1)
            3495     1   p    v            enddo
            3496                           pexp = pexp + 1.
            3497                     
            3498                           dsx = sndens * pexp
            3499                     
            3500                     !  --- ...  above line ends polynomial substitution
            3501                     !           end of koren formulation
            3502                     
            3503                     !! --- ...  base formulation (cogley et al., 1990)
            3504                     !           convert density from g/cm3 to kg/m3
            3505                     
            3506                     !!      dsm = sndens * 1000.0
            3507                     
            3508                     !!      dsx = dsm + dtsec*0.5*dsm*gs2*esd /                             &
            3509                     !!   &        (1.e7*exp(-0.02*dsm + kn/(tavgc+273.16)-14.643))
            3510                     
            3511                     !! --- ...  convert density from kg/m3 to g/cm3
            3512                     
            3513                     !!      dsx = dsx / 1000.0
            3514                     
            3515                     !! --- ...  end of cogley et al. formulation
            3516                     
            3517                     !  --- ...  set upper/lower limit on snow density
            3518                     
            3519                           dsx = max( min( dsx, 0.40 ), 0.05 )
            3520                           sndens = dsx
            3521                     
            3522                     !  --- ...  update of snow depth and density depending on liquid water
            3523                     !           during snowmelt.  assumed that 13% of liquid water can be
            3524                     !           stored in snow per day during snowmelt till snow density 0.40.
            3525                     
            3526     1                     if (tsnowc >= 0.0) then
            3527     1                       dw = 0.13 * dthr / 24.0
            3528     1                       sndens = sndens*(1.0 - dw) + dw
            3529     1                       if (sndens > 0.40) sndens = 0.40
            3530     1                     endif
            3531                     
            3532                     !  --- ...  calculate snow depth (cm) from snow water equivalent and snow
            3533                     !           density. change snow depth units to meters
            3534                     
            3535                           snowhc = esdc / sndens
            3536                           snowh  = snowhc * 0.01
            3537                     
            3538                     !
            3539                           return
            3540                     !...................................
            3541                           end subroutine snowpack
            3542                     !-----------------------------------
            3543                     
            3544                     
            3545                     !*********************************************!
            3546                     !  section-3  3rd or lower level subprograms  !
            3547                     !*********************************************!
            3548                     
            3549                     
            3550                     !-----------------------------------
            3551                           subroutine devap                                                  &
            3552                     !...................................
            3553                     !  ---  inputs: &
            3554                                ( etp1, smc, shdfac, smcmax, smcdry, fxexp,                  &
            3555                     !  ---  outputs: &
            3556                                  edir1                                                      &
            3557                                )
            3558                     
            3559                     ! ===================================================================== !
            3560                     !  description:                                                         !
            3561                     !                                                                       !
            3562                     !  subroutine devap calculates direct soil evaporation                  !
            3563                     !                                                                       !
            3564                     !                                                                       !
            3565                     !  subprogram called:  none                                             !
            3566                     !                                                                       !
            3567                     !                                                                       !
            3568                     !  ====================  defination of variables  ====================  !
            3569                     !                                                                       !
            3570                     !  inputs:                                                       size   !
            3571                     !     etp1     - real, potential evaporation                       1    !
            3572                     !     smc      - real, unfrozen soil moisture                      1    !
            3573                     !     shdfac   - real, aeral coverage of green vegetation          1    !
            3574                     !     smcmax   - real, porosity (sat val of soil mois)             1    !
            3575                     !     smcdry   - real, dry soil mois threshold                     1    !
            3576                     !     fxexp    - real, bare soil evaporation exponent              1    !
            3577                     !                                                                       !
            3578                     !  outputs:                                                             !
            3579                     !     edir1    - real, direct soil evaporation                     1    !
            3580                     !                                                                       !
            3581                     !  ====================    end of description    =====================  !
            3582                     !
            3583                     !  ---  inputs:
            3584                           real (kind=kind_phys), intent(in) :: etp1, smc, shdfac, smcmax,   &
            3585                                  smcdry, fxexp
            3586                     
            3587                     !  ---  outputs:
            3588                           real (kind=kind_phys), intent(out) :: edir1
            3589                     
            3590                     !  ---  locals:
            3591                           real (kind=kind_phys) :: fx, sratio
            3592                     !
            3593                     !===> ...  begin here
            3594                     !
            3595                     !  --- ...  direct evap a function of relative soil moisture availability,
            3596                     !           linear when fxexp=1.
            3597                     !           fx > 1 represents demand control
            3598                     !           fx < 1 represents flux control
            3599                     
            3600                           sratio = (smc - smcdry) / (smcmax - smcdry)
            3601                     
            3602     1                     if (sratio > 0.0) then
            3603     1                       fx = sratio**fxexp
            3604     1                       fx = max ( min ( fx, 1.0 ), 0.0 )
            3605     1                     else
            3606     1                       fx = 0.0
            3607     1                     endif
            3608                     
            3609                     !  --- ...  allow for the direct-evap-reducing effect of shade
            3610                     
            3611                           edir1 = fx * ( 1.0 - shdfac ) * etp1
            3612                     !
            3613                           return
            3614                     !...................................
            3615                           end subroutine devap
            3616                     !-----------------------------------
            3617                     
            3618                     
            3619                     !-----------------------------------
            3620                           subroutine frh2o                                                  &
            3621                     !...................................
            3622                     !  ---  inputs: &
            3623                                ( tkelv, smc, sh2o, smcmax, bexp, psis,                      &
            3624                     !  ---  outputs: &
            3625                                  liqwat                                                     &
            3626                                )
            3627                     
            3628                     ! ===================================================================== !
            3629                     !  description:                                                         !
            3630                     !                                                                       !
            3631                     !  subroutine frh2o calculates amount of supercooled liquid soil water  !
            3632                     !  content if temperature is below 273.15k (t0).  requires newton-type  !
            3633                     !  iteration to solve the nonlinear implicit equation given in eqn 17   !
            3634                     !  of koren et al (1999, jgr, vol 104(d16), 19569-19585).               !
            3635                     !                                                                       !
            3636                     !  new version (june 2001): much faster and more accurate newton        !
            3637                     !  iteration achieved by first taking log of eqn cited above -- less    !
            3638                     !  than 4 (typically 1 or 2) iterations achieves convergence.  also,    !
            3639                     !  explicit 1-step solution option for special case of parameter ck=0,  !
            3640                     !  which reduces the original implicit equation to a simpler explicit   !
            3641                     !  form, known as the "flerchinger eqn". improved handling of solution  !
            3642                     !  in the limit of freezing point temperature t0.                       !
            3643                     !                                                                       !
            3644                     !  subprogram called:  none                                             !
            3645                     !                                                                       !
            3646                     !                                                                       !
            3647                     !  ====================  defination of variables  ====================  !
            3648                     !                                                                       !
            3649                     !  inputs:                                                       size   !
            3650                     !     tkelv    - real, temperature (k)                             1    !
            3651                     !     smc      - real, total soil moisture content (volumetric)    1    !
            3652                     !     sh2o     - real, liquid soil moisture content (volumetric)   1    !
            3653                     !     smcmax   - real, saturation soil moisture content            1    !
            3654                     !     bexp     - real, soil type "b" parameter                     1    !
            3655                     !     psis     - real, saturated soil matric potential             1    !
            3656                     !                                                                       !
            3657                     !  outputs:                                                             !
            3658                     !     liqwat   - real, supercooled liquid water content            1    !
            3659                     !                                                                       !
            3660                     !  ====================    end of description    =====================  !
            3661                     !
            3662                     !  ---  constant parameters:
            3663                           real (kind=kind_phys), parameter :: ck    = 8.0
            3664                     !     real (kind=kind_phys), parameter :: ck    = 0.0
            3665                           real (kind=kind_phys), parameter :: blim  = 5.5
            3666                           real (kind=kind_phys), parameter :: error = 0.005
            3667                     
            3668                     !  ---  inputs:
            3669                           real (kind=kind_phys), intent(in) :: tkelv, smc, sh2o, smcmax,    &
            3670                                  bexp, psis
            3671                     
            3672                     !  ---  outputs:
            3673                           real (kind=kind_phys), intent(out) :: liqwat
            3674                     
            3675                     !  ---  locals:
            3676                           real (kind=kind_phys) :: bx, denom, df, dswl, fk, swl, swlk
            3677                     
            3678                           integer :: nlog, kcount
            3679                     !
            3680                     !===> ...  begin here
            3681                     !
            3682                     !  --- ...  limits on parameter b: b < 5.5  (use parameter blim)
            3683                     !           simulations showed if b > 5.5 unfrozen water content is
            3684                     !           non-realistically high at very low temperatures.
            3685                     
            3686                           bx = bexp
            3687                           if (bexp > blim)  bx = blim
            3688                     
            3689                     !  --- ...  initializing iterations counter and iterative solution flag.
            3690                     
            3691                           nlog  = 0
            3692                           kcount= 0
            3693                     
            3694                     !  --- ...  if temperature not significantly below freezing (t0), sh2o = smc
            3695                     
            3696     1                     if (tkelv > (tfreez-1.e-3)) then
            3697     1               
            3698     1                       liqwat = smc
            3699     1               
            3700     1                     else
            3701     1               
            3702     2                       if (ck /= 0.0) then
            3703     2               
            3704     2               !  --- ...  option 1: iterated solution for nonzero ck
            3705     2               !                     in koren et al, jgr, 1999, eqn 17
            3706     2               
            3707     2               !  --- ...  initial guess for swl (frozen content)
            3708     2               
            3709     2                         swl = smc - sh2o
            3710     2               
            3711     2               !  --- ...  keep within bounds.
            3712     2               
            3713     2                         swl = max( min( swl, smc-0.02 ), 0.0 )
            3714     2               
            3715     2               !  --- ...  start of iterations
            3716     2               
            3717     3                         do while ( (nlog < 10) .and. (kcount == 0) )
            3718     3                           nlog = nlog + 1
            3719     3               
            3720     3                           df = dlog( (psis*gs2/lsubf) * ( (1.0 + ck*swl)**2.0 )       &
            3721     3                              * (smcmax/(smc-swl))**bx ) - dlog(-(tkelv-tfreez)/tkelv)
            3722     3               
            3723     3                           denom = 2.0*ck/(1.0 + ck*swl) + bx/(smc - swl)
            3724     3                           swlk  = swl - df/denom
            3725     3               
            3726     3               !  --- ...  bounds useful for mathematical solution.
            3727     3               
            3728     3                           swlk = max( min( swlk, smc-0.02 ), 0.0 )
            3729     3               
            3730     3               !  --- ...  mathematical solution bounds applied.
            3731     3               
            3732     3                           dswl = abs(swlk - swl)
            3733     3                           swl = swlk
            3734     3               
            3735     3               !  --- ...  if more than 10 iterations, use explicit method (ck=0 approx.)
            3736     3               !           when dswl less or eq. error, no more iterations required.
            3737     3               
            3738     4                           if ( dswl <= error )  then
            3739     4                             kcount = kcount + 1
            3740     4                           endif
            3741     3                         enddo   !  end do_while_loop
            3742     2               
            3743     2               !  --- ...  bounds applied within do-block are valid for physical solution.
            3744     2               
            3745     2                         liqwat = smc - swl
            3746     2               
            3747     2                       endif   ! end if_ck_block
            3748     1               
            3749     1               !  --- ...  option 2: explicit solution for flerchinger eq. i.e. ck=0
            3750     1               !                     in koren et al., jgr, 1999, eqn 17
            3751     1               !           apply physical bounds to flerchinger solution
            3752     1               
            3753     2                       if (kcount == 0) then
            3754     2                         fk = ( ( (lsubf/(gs2*(-psis)))                                &
            3755     2                            * ((tkelv-tfreez)/tkelv) )**(-1/bx) ) * smcmax
            3756     2               
            3757     2                         fk = max( fk, 0.02 )
            3758     2               
            3759     2                         liqwat = min( fk, smc )
            3760     2                       endif
            3761     1               
            3762     1                     endif   ! end if_tkelv_block
            3763                     !
            3764                           return
            3765                     !...................................
            3766                           end subroutine frh2o
            3767                     !-----------------------------------
            3768                     
            3769                     
            3770                     !-----------------------------------
            3771                           subroutine hrt                                                    &
            3772                     !...................................
            3773                     !  ---  inputs: &
            3774                                ( nsoil, stc, smc, smcmax, zsoil, yy, zz1, tbot,             &
            3775                                  zbot, psisat, dt, bexp, df1, quartz, csoil, vegtyp,        &
            3776                     !  ---  input/outputs: &
            3777                                  sh2o,                                                      &
            3778                     !  ---  outputs: &
            3779                                  rhsts, ai, bi, ci                                          &
            3780                                )
            3781                     
            3782                     ! ===================================================================== !
            3783                     !  description:                                                         !
            3784                     !                                                                       !
            3785                     !  subroutine hrt calculates the right hand side of the time tendency   !
            3786                     !  term of the soil thermal diffusion equation.  also to compute        !
            3787                     !  (prepare) the matrix coefficients for the tri-diagonal matrix of     !
            3788                     !  the implicit time scheme.                                            !
            3789                     !                                                                       !
            3790                     !  subprogram called:  tbnd, snksrc, tmpavg                             !
            3791                     !                                                                       !
            3792                     !                                                                       !
            3793                     !  ====================  defination of variables  ====================  !
            3794                     !                                                                       !
            3795                     !  inputs:                                                       size   !
            3796                     !     nsoil    - integer, number of soil layers                    1    !
            3797                     !     stc      - real, soil temperature                          nsoil  !
            3798                     !     smc      - real, total soil moisture                       nsoil  !
            3799                     !     smcmax   - real, porosity                                    1    !
            3800                     !     zsoil    - real, soil layer depth below ground (negative)  nsoil  !
            3801                     !     yy       - real,                                             1    !
            3802                     !     zz1      - real, soil temperture at the top soil column      1    !
            3803                     !     tbot     - real, bottom soil temp                            1    !
            3804                     !     zbot     - real, specify depth of lower bd soil              1    !
            3805                     !     psisat   - real, saturated soil potential                    1    !
            3806                     !     dt       - real, time step                                   1    !
            3807                     !     bexp     - real, soil type "b" parameter                     1    !
            3808                     !     df1      - real, thermal diffusivity                         1    !
            3809                     !     quartz   - real, soil quartz content                         1    !
            3810                     !     csoil    - real, soil heat capacity                          1    !
            3811                     !     vegtyp   - integer, vegetation type                          1    !
            3812                     !                                                                       !
            3813                     !  input/outputs:                                                       !
            3814                     !     sh2o     - real, unfrozen soil moisture                    nsoil  !
            3815                     !                                                                       !
            3816                     !  outputs:                                                             !
            3817                     !     rhsts    - real, time tendency of soil thermal diffusion   nsoil  !
            3818                     !     ai       - real, matrix coefficients                       nsold  !
            3819                     !     bi       - real, matrix coefficients                       nsold  !
            3820                     !     ci       - real, matrix coefficients                       nsold  !
            3821                     !                                                                       !
            3822                     !  ====================    end of description    =====================  !
            3823                     !
            3824                     !  ---  inputs:
            3825                           integer, intent(in) :: nsoil, vegtyp
            3826                     
            3827                           real (kind=kind_phys),  intent(in) :: stc(nsoil), smc(nsoil),     &
            3828                                  smcmax, zsoil(nsoil), yy, zz1, tbot, zbot, psisat, dt,     &
            3829                                  bexp, df1, quartz, csoil
            3830                     
            3831                     !  ---  input/outputs:
            3832                           real (kind=kind_phys),  intent(inout) :: sh2o(nsoil)
            3833                     
            3834                     !  ---  outputs:
            3835                           real (kind=kind_phys),  intent(out) :: rhsts(nsoil), ai(nsold),   &
            3836                                  bi(nsold), ci(nsold)
            3837                     
            3838                     !  ---  locals:
            3839                           real (kind=kind_phys) :: ddz, ddz2, denom, df1n, df1k, dtsdz,     &
            3840                                  dtsdz2, hcpct, qtot, ssoil, sice, tavg, tbk, tbk1,         &
            3841                                  tsnsr, tsurf, csoil_loc
            3842                     
            3843                           integer :: i, k
            3844                     
            3845                           logical :: itavg
            3846                     
            3847                     !
            3848                     !===> ...  begin here
            3849                     !
            3850                             csoil_loc=csoil
            3851                     
            3852     1                      if (ivegsrc .ge. 1)then
            3853     1               !urban
            3854     2                       if( vegtyp == 13 ) then
            3855     2                           csoil_loc=3.0e6
            3856     2                       endif
            3857     1                      endif
            3858                     
            3859                     !  --- ...  initialize logical for soil layer temperature averaging.
            3860                     
            3861                           itavg = .true.
            3862                     !     itavg = .false.
            3863                     
            3864                     !  ===  begin section for top soil layer
            3865                     
            3866                     !  --- ...  calc the heat capacity of the top soil layer
            3867                     
            3868                           hcpct = sh2o(1)*cph2o2 + (1.0 - smcmax)*csoil_loc                 &
            3869                                 + (smcmax - smc(1))*cp2 + (smc(1) - sh2o(1))*cpice1
            3870                     
            3871                     !  --- ...  calc the matrix coefficients ai, bi, and ci for the top layer
            3872                     
            3873                           ddz = 1.0 / ( -0.5*zsoil(2) )
            3874                           ai(1) = 0.0
            3875                           ci(1) = (df1*ddz) / ( zsoil(1)*hcpct )
            3876                           bi(1) = -ci(1) + df1 / ( 0.5*zsoil(1)*zsoil(1)*hcpct*zz1 )
            3877                     
            3878                     !  --- ...  calculate the vertical soil temp gradient btwn the 1st and 2nd soil
            3879                     !           layers.  then calculate the subsurface heat flux. use the temp
            3880                     !           gradient and subsfc heat flux to calc "right-hand side tendency
            3881                     !           terms", or "rhsts", for top soil layer.
            3882                     
            3883                           dtsdz = (stc(1) - stc(2)) / (-0.5*zsoil(2))
            3884                           ssoil = df1 * (stc(1) - yy) / (0.5*zsoil(1)*zz1)
            3885                           rhsts(1) = (df1*dtsdz - ssoil) / (zsoil(1)*hcpct)
            3886                     
            3887                     !  --- ...  next capture the vertical difference of the heat flux at top and
            3888                     !           bottom of first soil layer for use in heat flux constraint applied to
            3889                     !           potential soil freezing/thawing in routine snksrc.
            3890                     
            3891                           qtot = ssoil - df1*dtsdz
            3892                     
            3893                     !  --- ...  if temperature averaging invoked (itavg=true; else skip):
            3894                     !           set temp "tsurf" at top of soil column (for use in freezing soil
            3895                     !           physics later in subroutine snksrc).  if snowpack content is
            3896                     !           zero, then tsurf expression below gives tsurf = skin temp.  if
            3897                     !           snowpack is nonzero (hence argument zz1=1), then tsurf expression
            3898                     !           below yields soil column top temperature under snowpack.  then
            3899                     !           calculate temperature at bottom interface of 1st soil layer for use
            3900                     !           later in subroutine snksrc
            3901                     
            3902     1                     if (itavg) then
            3903     1               
            3904     1                       tsurf = (yy + (zz1-1)*stc(1)) / zz1
            3905     1               
            3906     1                       call tbnd                                                       &
            3907     1               !  ---  inputs: &
            3908     1                          ( stc(1), stc(2), zsoil, zbot, 1, nsoil,                     &
            3909     1               !  ---  outputs: &
            3910     1                            tbk                                                        &
            3911     1                          )
            3912     1               
            3913     1                     endif
            3914                     
            3915                     !  --- ...  calculate frozen water content in 1st soil layer.
            3916                     
            3917                           sice = smc(1) - sh2o(1)
            3918                     
            3919                     !  --- ...  if frozen water present or any of layer-1 mid-point or bounding
            3920                     !           interface temperatures below freezing, then call snksrc to
            3921                     !           compute heat source/sink (and change in frozen water content)
            3922                     !           due to possible soil water phase change
            3923                     
            3924     1                     if ( (sice > 0.0) .or. (tsurf < tfreez) .or.                      &
            3925     1                          (stc(1) < tfreez) .or. (tbk < tfreez) ) then
            3926     1               
            3927     2                       if (itavg) then
            3928     2               
            3929     2                         call tmpavg                                                   &
            3930     2               !  ---  inputs: &
            3931     2                          ( tsurf, stc(1), tbk, zsoil, nsoil, 1,                       &
            3932     2               !  ---  outputs: &
            3933     2                            tavg                                                       &
            3934     2                          )
            3935     2               
            3936     2                       else
            3937     2               
            3938     2                         tavg = stc(1)
            3939     2               
            3940     2                       endif   ! end if_itavg_block
            3941     1               
            3942     1                       call snksrc                                                     &
            3943     1               !  ---  inputs: &
            3944     1                          ( nsoil, 1, tavg, smc(1), smcmax, psisat, bexp, dt,          &
            3945     1                            qtot, zsoil,                                               &
            3946     1               !  ---  input/outputs: &
            3947     1                            sh2o(1),                                                   &
            3948     1               !  ---  outputs: &
            3949     1                            tsnsr                                                      &
            3950     1                          )
            3951     1               
            3952     1               
            3953     1                       rhsts(1) = rhsts(1) - tsnsr / ( zsoil(1)*hcpct )
            3954     1               
            3955     1                     endif   ! end if_sice_block
            3956                     
            3957                     !  ===  this ends section for top soil layer.
            3958                     
            3959                     !  --- ...  initialize ddz2
            3960                     
            3961                           ddz2 = 0.0
            3962                     
            3963                     !  --- ...  loop thru the remaining soil layers, repeating the above process
            3964                     !           (except subsfc or "ground" heat flux not repeated in lower layers)
            3965                     
            3966                           df1k = df1
            3967                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 22
                                   <<<      SIMD&FP   : SPILL 1  FILL 3
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3968     1                     do k = 2, nsoil
            3969     1               
            3970     1               !  --- ...  calculate heat capacity for this soil layer.
            3971     1               
            3972     1                       hcpct = sh2o(k)*cph2o2 + (1.0 - smcmax)*csoil_loc               &
            3973     1                             + (smcmax - smc(k))*cp2 + (smc(k) - sh2o(k))*cpice1
            3974     1               
            3975     2                       if (k /= nsoil) then
            3976     2               
            3977     2               !  --- ...  this section for layer 2 or greater, but not last layer.
            3978     2               !           calculate thermal diffusivity for this layer.
            3979     2               
            3980     2                         call tdfcnd                                                   &
            3981     2               !  ---  inputs: &
            3982     2                          ( smc(k), quartz, smcmax, sh2o(k),                           &
            3983     2               !  ---  outputs: &
            3984     2                            df1n                                                       &
            3985     2                          )
            3986     2               !urban
            3987     3                     if (ivegsrc .ge. 1)then
            3988     3                      if ( vegtyp == 13 ) df1n = 3.24
            3989     3                     endif
            3990     2               
            3991     2               !  --- ...  calc the vertical soil temp gradient thru this layer
            3992     2               
            3993     2                         denom = 0.5 * (zsoil(k-1) - zsoil(k+1))
            3994     2                         dtsdz2 = (stc(k) - stc(k+1)) / denom
            3995     2               
            3996     2               !  --- ...  calc the matrix coef, ci, after calc'ng its partial product
            3997     2               
            3998     2                         ddz2 = 2.0 / (zsoil(k-1) - zsoil(k+1))
            3999     2                         ci(k) = -df1n*ddz2 / ((zsoil(k-1) - zsoil(k)) * hcpct)
            4000     2               
            4001     2               !  --- ...  if temperature averaging invoked (itavg=true; else skip):
            4002     2               !           calculate temp at bottom of layer.
            4003     2               
            4004     3                         if (itavg) then
            4005     3               
            4006     3                           call tbnd                                                   &
            4007     3               !  ---  inputs: &
            4008     3                          ( stc(k), stc(k+1), zsoil, zbot, k, nsoil,                   &
            4009     3               !  ---  outputs: &
            4010     3                            tbk1                                                       &
            4011     3                          )
            4012     3               
            4013     3                         endif
            4014     2               
            4015     2                       else
            4016     2               
            4017     2               !  --- ...  special case of bottom soil layer:  calculate thermal diffusivity
            4018     2               !           for bottom layer.
            4019     2               
            4020     2                         call tdfcnd                                                   &
            4021     2               !  ---  inputs: &
            4022     2                          ( smc(k), quartz, smcmax, sh2o(k),                           &
            4023     2               !  ---  outputs: &
            4024     2                            df1n                                                       &
            4025     2                          )
            4026     2               !urban
            4027     3                     if (ivegsrc .ge. 1)then
            4028     3                      if ( vegtyp == 13 ) df1n = 3.24
            4029     3                     endif
            4030     2               
            4031     2               !  --- ...  calc the vertical soil temp gradient thru bottom layer.
            4032     2               
            4033     2                         denom = 0.5 * (zsoil(k-1) + zsoil(k)) - zbot
            4034     2                         dtsdz2 = (stc(k) - tbot) / denom
            4035     2               
            4036     2               !  --- ...  set matrix coef, ci to zero if bottom layer.
            4037     2               
            4038     2                         ci(k) = 0.0
            4039     2               
            4040     2               !  --- ...  if temperature averaging invoked (itavg=true; else skip):
            4041     2               !           calculate temp at bottom of last layer.
            4042     2               
            4043     3                         if (itavg) then
            4044     3               
            4045     3                           call tbnd                                                   &
            4046     3               !  ---  inputs: &
            4047     3                          ( stc(k), tbot, zsoil, zbot, k, nsoil,                       &
            4048     3               !  ---  outputs: &
            4049     3                            tbk1                                                       &
            4050     3                          )
            4051     3               
            4052     3                         endif
            4053     2               
            4054     2                       endif   ! end if_k_block
            4055     1               
            4056     1               !  --- ...  calculate rhsts for this layer after calc'ng a partial product.
            4057     1               
            4058     1                       denom = (zsoil(k) - zsoil(k-1)) * hcpct
            4059     1                       rhsts(k) = ( df1n*dtsdz2 - df1k*dtsdz ) / denom
            4060     1               
            4061     1                       qtot = -1.0 * denom * rhsts(k)
            4062     1                       sice = smc(k) - sh2o(k)
            4063     1               
            4064     2                       if ( (sice > 0.0) .or. (tbk < tfreez) .or.                      &
            4065     2                            (stc(k) < tfreez) .or. (tbk1 < tfreez) ) then
            4066     2               
            4067     3                         if (itavg) then
            4068     3               
            4069     3                           call tmpavg                                                 &
            4070     3               !  ---  inputs: &
            4071     3                          ( tbk, stc(k), tbk1, zsoil, nsoil, k,                        &
            4072     3               !  ---  outputs: &
            4073     3                            tavg                                                       &
            4074     3                          )
            4075     3               
            4076     3                         else
            4077     3                           tavg = stc(k)
            4078     3                         endif
            4079     2               
            4080     2                         call snksrc                                                   &
            4081     2               !  ---  inputs: &
            4082     2                          ( nsoil, k, tavg, smc(k), smcmax, psisat, bexp, dt,          &
            4083     2                            qtot, zsoil,                                               &
            4084     2               !  ---  input/outputs: &
            4085     2                            sh2o(k),                                                   &
            4086     2               !  ---  outputs: &
            4087     2                            tsnsr                                                      &
            4088     2                          )
            4089     2               
            4090     2                         rhsts(k) = rhsts(k) - tsnsr/denom
            4091     2                       endif
            4092     1               
            4093     1               !  --- ...  calc matrix coefs, ai, and bi for this layer.
            4094     1               
            4095     1                       ai(k) = - df1 * ddz / ((zsoil(k-1) - zsoil(k)) * hcpct)
            4096     1                       bi(k) = -(ai(k) + ci(k))
            4097     1               
            4098     1               !  --- ...  reset values of df1, dtsdz, ddz, and tbk for loop to next soil layer.
            4099     1               
            4100     1                       tbk   = tbk1
            4101     1                       df1k  = df1n
            4102     1                       dtsdz = dtsdz2
            4103     1                       ddz   = ddz2
            4104     1               
            4105     1                     enddo   ! end do_k_loop
            4106                     
            4107                     !
            4108                           return
            4109                     !...................................
            4110                           end subroutine hrt
            4111                     !-----------------------------------
            4112                     
            4113                     
            4114                     !-----------------------------------
            4115                           subroutine hrtice                                                 &
            4116                     !...................................
            4117                     !  ---  inputs: &
            4118                                ( nsoil, stc, zsoil, yy, zz1, df1, ice,                      &
            4119                     !  ---  input/outputs: &
            4120                                  tbot,                                                      &
            4121                     !  ---  outputs: &
            4122                                  rhsts, ai, bi, ci                                          &
            4123                                )
            4124                     
            4125                     ! ===================================================================== !
            4126                     !  description:                                                         !
            4127                     !                                                                       !
            4128                     !  subroutine hrtice calculates the right hand side of the time tendency!
            4129                     !  term of the soil thermal diffusion equation for sea-ice (ice = 1) or !
            4130                     !  glacial-ice (ice). compute (prepare) the matrix coefficients for the !
            4131                     !  tri-diagonal matrix of the implicit time scheme.                     !
            4132                     !  (note:  this subroutine only called for sea-ice or glacial ice, but  !
            4133                     !  not for non-glacial land (ice = 0).                                  !
            4134                     !                                                                       !
            4135                     !  subprogram called:  none                                             !
            4136                     !                                                                       !
            4137                     !                                                                       !
            4138                     !  ====================  defination of variables  ====================  !
            4139                     !                                                                       !
            4140                     !  inputs:                                                       size   !
            4141                     !     nsoil    - integer, number of soil layers                    1    !
            4142                     !     stc      - real, soil temperature                          nsoil  !
            4143                     !     zsoil    - real, soil depth (negative sign, as below grd)  nsoil  !
            4144                     !     yy       - real, soil temperature at the top of column       1    !
            4145                     !     zz1      - real,                                             1    !
            4146                     !     df1      - real, thermal diffusivity and conductivity        1    !
            4147                     !     ice      - integer, sea-ice flag (=1: sea-ice, =0: land)     1    !
            4148                     !                                                                       !
            4149                     !  input/outputs:                                                       !
            4150                     !     tbot     - real, bottom soil temperature                     1    !
            4151                     !                                                                       !
            4152                     !  outputs:                                                             !
            4153                     !     rhsts    - real, time tendency of soil thermal diffusion   nsoil  !
            4154                     !     ai       - real, matrix coefficients                       nsold  !
            4155                     !     bi       - real, matrix coefficients                       nsold  !
            4156                     !     ci       - real, matrix coefficients                       nsold  !
            4157                     !                                                                       !
            4158                     !  ====================    end of description    =====================  !
            4159                     !
            4160                     !  ---  inputs:
            4161                           integer, intent(in) :: nsoil, ice
            4162                     
            4163                           real (kind=kind_phys), intent(in) :: stc(nsoil), zsoil(nsoil),    &
            4164                                  yy, zz1, df1
            4165                     
            4166                     !  ---  input/outputs:
            4167                           real (kind=kind_phys), intent(inout) :: tbot
            4168                     
            4169                     !  ---  outputs:
            4170                           real (kind=kind_phys), intent(out) :: rhsts(nsoil), ai(nsold),    &
            4171                                  bi(nsold), ci(nsold)
            4172                     
            4173                     !  ---  locals:
            4174                           real (kind=kind_phys) :: ddz, ddz2, denom, dtsdz, dtsdz2,         &
            4175                                  hcpct, ssoil, zbot
            4176                     
            4177                           integer :: k
            4178                     
            4179                     !
            4180                     !===> ...  begin here
            4181                     !
            4182                     !  --- ...  set a nominal universal value of the sea-ice specific heat capacity,
            4183                     !           hcpct = 1880.0*917.0 = 1.72396e+6 (source:  fei chen, 1995)
            4184                     !           set bottom of sea-ice pack temperature: tbot = 271.16
            4185                     !           set a nominal universal value of glacial-ice specific heat capacity,
            4186                     !           hcpct = 2100.0*900.0 = 1.89000e+6 (source:  bob grumbine, 2005)
            4187                     !           tbot passed in as argument, value from global data set
            4188                     
            4189     1                     if (ice == 1) then
            4190     1               !  --- ...  sea-ice
            4191     1                       hcpct = 1.72396e+6
            4192     1                       tbot = 271.16
            4193     1                     else
            4194     1               !  --- ...  glacial-ice
            4195     1                       hcpct = 1.89000e+6
            4196     1                     endif
            4197                     
            4198                     !  --- ...  the input argument df1 is a universally constant value of sea-ice
            4199                     !           and glacial-ice thermal diffusivity, set in sflx as df1 = 2.2.
            4200                     
            4201                     !  --- ...  set ice pack depth.  use tbot as ice pack lower boundary temperature
            4202                     !           (that of unfrozen sea water at bottom of sea ice pack).  assume ice
            4203                     !           pack is of n=nsoil layers spanning a uniform constant ice pack
            4204                     !           thickness as defined by zsoil(nsoil) in routine sflx.
            4205                     !           if glacial-ice, set zbot = -25 meters
            4206                     
            4207     1                     if (ice == 1) then
            4208     1               !  --- ...  sea-ice
            4209     1                       zbot = zsoil(nsoil)
            4210     1                     else
            4211     1               !  --- ...  glacial-ice
            4212     1                       zbot = -25.0
            4213     1                     endif
            4214                     
            4215                     !  --- ...  calc the matrix coefficients ai, bi, and ci for the top layer
            4216                     
            4217                           ddz = 1.0 / (-0.5*zsoil(2))
            4218                           ai(1) = 0.0
            4219                           ci(1) = (df1*ddz) / (zsoil(1)*hcpct)
            4220                           bi(1) = -ci(1) + df1 / (0.5*zsoil(1)*zsoil(1)*hcpct*zz1)
            4221                     
            4222                     !  --- ...  calc the vertical soil temp gradient btwn the top and 2nd soil
            4223                     !           layers. recalc/adjust the soil heat flux.  use the gradient and
            4224                     !           flux to calc rhsts for the top soil layer.
            4225                     
            4226                           dtsdz = (stc(1) - stc(2)) / (-0.5*zsoil(2))
            4227                           ssoil = df1 * (stc(1) - yy) / (0.5*zsoil(1)*zz1)
            4228                           rhsts(1) = (df1*dtsdz - ssoil) / (zsoil(1)*hcpct)
            4229                     
            4230                     !  --- ...  initialize ddz2
            4231                     
            4232                           ddz2 = 0.0
            4233                     
            4234                     !  --- ...  loop thru the remaining soil layers, repeating the above process
            4235                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zsoil, stc, ci, rhsts, ai, bi
                                   <<< Loop-information  End >>>
            4236     1   s    s            do k = 2, nsoil
            4237     1               
            4238     2   p    v              if (k /= nsoil) then
            4239     2               
            4240     2               !  --- ...  calc the vertical soil temp gradient thru this layer.
            4241     2               
            4242     2   p    v                denom = 0.5 * (zsoil(k-1) - zsoil(k+1))
            4243     2   p    v                dtsdz2 = (stc(k) - stc(k+1)) / denom
            4244     2               
            4245     2               !  --- ...  calc the matrix coef, ci, after calc'ng its partial product.
            4246     2               
            4247     2   s    s                ddz2 = 2.0 / (zsoil(k-1) - zsoil(k+1))
            4248     2   p    v                ci(k) = -df1*ddz2 / ((zsoil(k-1) - zsoil(k))*hcpct)
            4249     2               
            4250     2   p    v              else
            4251     2               
            4252     2               !  --- ...  calc the vertical soil temp gradient thru the lowest layer.
            4253     2               
            4254     2   p    v                dtsdz2 = (stc(k) - tbot)                                      &
            4255     2                                / (0.5*(zsoil(k-1) + zsoil(k)) - zbot)
            4256     2               
            4257     2               !  --- ...  set matrix coef, ci to zero.
            4258     2               
            4259     2   p    v                ci(k) = 0.0
            4260     2               
            4261     2   p    v              endif   ! end if_k_block
            4262     1               
            4263     1               !  --- ...  calc rhsts for this layer after calc'ng a partial product.
            4264     1               
            4265     1   p    v              denom = (zsoil(k) - zsoil(k-1)) * hcpct
            4266     1   m    m              rhsts(k) = (df1*dtsdz2 - df1*dtsdz) / denom
            4267     1               
            4268     1               !  --- ...  calc matrix coefs, ai, and bi for this layer.
            4269     1               
            4270     1   m    m              ai(k) = - df1*ddz / ((zsoil(k-1) - zsoil(k)) * hcpct)
            4271     1   p    v              bi(k) = -(ai(k) + ci(k))
            4272     1               
            4273     1               !  --- ...  reset values of dtsdz and ddz for loop to next soil lyr.
            4274     1               
            4275     1   s    s              dtsdz = dtsdz2
            4276     1   s    s              ddz   = ddz2
            4277     1               
            4278     1   p    v            enddo   ! end do_k_loop
            4279                     !
            4280                           return
            4281                     !...................................
            4282                           end subroutine hrtice
            4283                     !-----------------------------------
            4284                     
            4285                     
            4286                     !-----------------------------------
            4287                           subroutine hstep                                                  &
            4288                     !...................................
            4289                     !  ---  inputs: &
            4290                                ( nsoil, stcin, dt,                                          &
            4291                     !  ---  input/outputs: &
            4292                                  rhsts, ai, bi, ci,                                         &
            4293                     !  ---  outputs: &
            4294                                  stcout                                                     &
            4295                                )
            4296                     
            4297                     ! ===================================================================== !
            4298                     !  description:                                                         !
            4299                     !                                                                       !
            4300                     !  subroutine hstep calculates/updates the soil temperature field.      !
            4301                     !                                                                       !
            4302                     !  subprogram called:  rosr12                                           !
            4303                     !                                                                       !
            4304                     !                                                                       !
            4305                     !  ====================  defination of variables  ====================  !
            4306                     !                                                                       !
            4307                     !  inputs:                                                       size   !
            4308                     !     nsoil    - integer, number of soil layers                    1    !
            4309                     !     stcin    - real, soil temperature                          nsoil  !
            4310                     !     dt       - real, time step                                   1    !
            4311                     !                                                                       !
            4312                     !  input/outputs:                                                       !
            4313                     !     rhsts    - real, time tendency of soil thermal diffusion   nsoil  !
            4314                     !     ai       - real, matrix coefficients                       nsold  !
            4315                     !     bi       - real, matrix coefficients                       nsold  !
            4316                     !     ci       - real, matrix coefficients                       nsold  !
            4317                     !                                                                       !
            4318                     !  outputs:                                                             !
            4319                     !     stcout   - real, updated soil temperature                  nsoil  !
            4320                     !                                                                       !
            4321                     !  ====================    end of description    =====================  !
            4322                     !
            4323                     !  ---  inputs:
            4324                           integer, intent(in) :: nsoil
            4325                     
            4326                           real (kind=kind_phys),  intent(in) :: stcin(nsoil), dt
            4327                     
            4328                     !  ---  input/outputs:
            4329                           real (kind=kind_phys),  intent(inout) :: rhsts(nsoil),            &
            4330                                 ai(nsold), bi(nsold), ci(nsold)
            4331                     
            4332                     !  ---  outputs:
            4333                           real (kind=kind_phys),  intent(out) :: stcout(nsoil)
            4334                     
            4335                     !  ---  locals:
            4336                           integer :: k
            4337                     
            4338                           real (kind=kind_phys) :: ciin(nsold), rhstsin(nsoil)
            4339                     
            4340                     !
            4341                     !===> ...  begin here
            4342                     !
            4343                     !  --- ...  create finite difference values for use in rosr12 routine
            4344                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 4345,4354)
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ci, bi, ai, rhsts, rhstsin
                                   <<< Loop-information  End >>>
            4345     1   s    v            do k = 1, nsoil
            4346     1   p    v              rhsts(k) = rhsts(k) * dt
            4347     1   p    v              ai(k) = ai(k) * dt
            4348     1   p    v              bi(k) = 1.0 + bi(k)*dt
            4349     1   p    v              ci(k) = ci(k) * dt
            4350     1   p    v            enddo
            4351                     
            4352                     !  --- ...  copy values for input variables before call to rosr12
            4353                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            4354     1                     do k = 1, nsoil
            4355     1                        rhstsin(k) = rhsts(k)
            4356     1                     enddo
            4357                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4358     1       f             do k = 1, nsold
            4359     1       f               ciin(k) = ci(k)
            4360     1       f             enddo
            4361                     
            4362                     !  --- ...  solve the tri-diagonal matrix equation
            4363                     
            4364                           call rosr12                                                       &
            4365                     !  ---  inputs: &
            4366                                ( nsoil, ai, bi, rhstsin,                                    &
            4367                     !  ---  input/outputs: &
            4368                                  ciin,                                                      &
            4369                     !  ---  outputs: &
            4370                                  ci, rhsts                                                  &
            4371                                )
            4372                     
            4373                     !  --- ...  calc/update the soil temps using matrix solution
            4374                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ci, stcin, stcout
                                   <<< Loop-information  End >>>
            4375     1  pp    v            do k = 1, nsoil
            4376     1   p    v              stcout(k) = stcin(k) + ci(k)
            4377     1   p    v            enddo
            4378                     !
            4379                           return
            4380                     !...................................
            4381                           end subroutine hstep
            4382                     !-----------------------------------
            4383                     
            4384                     
            4385                     !-----------------------------------
            4386                           subroutine rosr12                                                 &
            4387                     !...................................
            4388                     !  ---  inputs: &
            4389                                ( nsoil, a, b, d,                                            &
            4390                     !  ---  input/outputs: &
            4391                                  c,                                                         &
            4392                     !  ---  outputs: &
            4393                                  p, delta                                                   &
            4394                                )
            4395                     
            4396                     ! ===================================================================== !
            4397                     !  description:                                                         !
            4398                     !                                                                       !
            4399                     !  subroutine rosr12 inverts (solve) the tri-diagonal matrix problem    !
            4400                     !  shown below:                                                         !
            4401                     !                                                                       !
            4402                     ! ###                                            ### ###  ###   ###  ###!
            4403                     ! #b(1), c(1),  0  ,  0  ,  0  ,   . . .  ,    0   # #      #   #      #!
            4404                     ! #a(2), b(2), c(2),  0  ,  0  ,   . . .  ,    0   # #      #   #      #!
            4405                     ! # 0  , a(3), b(3), c(3),  0  ,   . . .  ,    0   # #      #   # d(3) #!
            4406                     ! # 0  ,  0  , a(4), b(4), c(4),   . . .  ,    0   # # p(4) #   # d(4) #!
            4407                     ! # 0  ,  0  ,  0  , a(5), b(5),   . . .  ,    0   # # p(5) #   # d(5) #!
            4408                     ! # .                                          .   # #  .   # = #   .  #!
            4409                     ! # .                                          .   # #  .   #   #   .  #!
            4410                     ! # .                                          .   # #  .   #   #   .  #!
            4411                     ! # 0  , . . . , 0 , a(m-2), b(m-2), c(m-2),   0   # #p(m-2)#   #d(m-2)#!
            4412                     ! # 0  , . . . , 0 ,   0   , a(m-1), b(m-1), c(m-1)# #p(m-1)#   #d(m-1)#!
            4413                     ! # 0  , . . . , 0 ,   0   ,   0   ,  a(m) ,  b(m) # # p(m) #   # d(m) #!
            4414                     ! ###                                            ### ###  ###   ###  ###!
            4415                     !                                                                       !
            4416                     !  subprogram called:  none                                             !
            4417                     !                                                                       !
            4418                     !                                                                       !
            4419                     !  ====================  defination of variables  ====================  !
            4420                     !                                                                       !
            4421                     !  inputs:                                                       size   !
            4422                     !     nsoil    - integer, number of soil layers                    1    !
            4423                     !     a        - real, matrix coefficients                       nsoil  !
            4424                     !     b        - real, matrix coefficients                       nsoil  !
            4425                     !     d        - real, soil water time tendency                  nsoil  !
            4426                     !                                                                       !
            4427                     !  input/outputs:                                                       !
            4428                     !     c        - real, matrix coefficients                       nsoil  !
            4429                     !                                                                       !
            4430                     !  outputs:                                                             !
            4431                     !     p        - real,                                           nsoil  !
            4432                     !     delta    - real,                                           nsoil  !
            4433                     !                                                                       !
            4434                     !  ====================    end of description    =====================  !
            4435                     !
            4436                     !  ---  inputs:
            4437                           integer, intent(in) :: nsoil
            4438                     
            4439                           real (kind=kind_phys),  dimension(nsoil), intent(in) :: a, b, d
            4440                     
            4441                     !  ---  input/outputs:
            4442                           real (kind=kind_phys),  dimension(nsoil), intent(inout) :: c
            4443                     
            4444                     !  ---  outputs:
            4445                           real (kind=kind_phys),  dimension(nsoil), intent(out) :: p, delta
            4446                     
            4447                     !  ---  locals:
            4448                           integer :: k, kk
            4449                     
            4450                     !
            4451                     !===> ...  begin here
            4452                     !
            4453                     !  --- ...  initialize eqn coef c for the lowest soil layer
            4454                     
            4455                           c(nsoil) = 0.0
            4456                     
            4457                     !  --- ...  solve the coefs for the 1st soil layer
            4458                     
            4459                           p(1) = -c(1) / b(1)
            4460                           delta(1) = d(1) / b(1)
            4461                     
            4462                     !  --- ...  solve the coefs for soil layers 2 thru nsoil
            4463                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.29, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      c, p, delta, b, a, d
                                   <<< Loop-information  End >>>
            4464     1   s   2s            do k = 2, nsoil
            4465     1   s   2s              p(k) = -c(k) * ( 1.0 / (b(k) + a (k)*p(k-1)) )
            4466     1   m   2m              delta(k) = (d(k) - a(k)*delta(k-1))                              &
            4467     1                                * ( 1.0 / (b(k) + a(k)*p(k-1)) )
            4468     1   p   2v            enddo
            4469                     
            4470                     !  --- ...  set p to delta for lowest soil layer
            4471                     
            4472                           p(nsoil) = delta(nsoil)
            4473                     
            4474                     !  --- ...  adjust p for soil layers 2 thru nsoil
            4475                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.66, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      p, delta
                                   <<< Loop-information  End >>>
            4476     1   s   2s            do k = 2, nsoil
            4477     1   s   2s               kk = nsoil - k + 1
            4478     1   s   2s               p(kk) = p(kk)*p(kk+1) + delta(kk)
            4479     1   s   2s            enddo
            4480                     !
            4481                           return
            4482                     !...................................
            4483                           end subroutine rosr12
            4484                     !-----------------------------------
            4485                     
            4486                     
            4487                     !-----------------------------------
            4488                           subroutine snksrc                                                 &
            4489                     !...................................
            4490                     !  ---  inputs: &
            4491                                ( nsoil, k, tavg, smc, smcmax, psisat, bexp, dt,             &
            4492                                  qtot, zsoil,                                               &
            4493                     !  ---  input/outputs: &
            4494                                  sh2o,                                                      &
            4495                     !  ---  outputs: &
            4496                                  tsrc                                                       &
            4497                                )
            4498                     
            4499                     ! ===================================================================== !
            4500                     !  description:                                                         !
            4501                     !                                                                       !
            4502                     !  subroutine snksrc calculates sink/source term of the termal          !
            4503                     !  diffusion equation.                                                  !
            4504                     !                                                                       !
            4505                     !  subprograms called: frh2o                                            !
            4506                     !                                                                       !
            4507                     !                                                                       !
            4508                     !  ====================  defination of variables  ====================  !
            4509                     !                                                                       !
            4510                     !  inputs:                                                       size   !
            4511                     !     nsoil    - integer, number of soil layers                    1    !
            4512                     !     k        - integer, index of soil layers                     1    !
            4513                     !     tavg     - real, soil layer average temperature              1    !
            4514                     !     smc      - real, total soil moisture                         1    !
            4515                     !     smcmax   - real, porosity                                    1    !
            4516                     !     psisat   - real, saturated soil potential                    1    !
            4517                     !     bexp     - real, soil type "b" parameter                     1    !
            4518                     !     dt       - real, time step                                   1    !
            4519                     !     qtot     - real, tot vertical diff of heat flux              1    !
            4520                     !     zsoil    - real, soil layer depth below ground (negative)  nsoil  !
            4521                     !                                                                       !
            4522                     !  input/outputs:                                                       !
            4523                     !     sh2o     - real, available liqued water                      1    !
            4524                     !                                                                       !
            4525                     !  outputs:                                                             !
            4526                     !     tsrc     - real, heat source/sink                            1    !
            4527                     !                                                                       !
            4528                     !  ====================    end of description    =====================  !
            4529                     !
            4530                     !  ---  parameter constants:
            4531                           real (kind=kind_phys), parameter :: dh2o = 1.0000e3
            4532                     
            4533                     !  ---  inputs:
            4534                           integer, intent(in) :: nsoil, k
            4535                     
            4536                           real (kind=kind_phys), intent(in) :: tavg, smc, smcmax, psisat,   &
            4537                                  bexp, dt, qtot, zsoil(nsoil)
            4538                     
            4539                     !  ---  input/outputs:
            4540                           real (kind=kind_phys), intent(inout) :: sh2o
            4541                     
            4542                     !  ---  outputs:
            4543                           real (kind=kind_phys), intent(out) :: tsrc
            4544                     
            4545                     !  ---  locals:
            4546                           real (kind=kind_phys) :: dz, free, xh2o
            4547                     
            4548                     !  ---  external functions:
            4549                     !     real (kind=kind_phys) :: frh2o
            4550                     
            4551                     !urban
            4552     1                      if (ivegsrc .ge. 1)then
            4553     1                           if ( vegtyp == 13 ) df1=3.24
            4554     1                      endif
            4555                     !
            4556                     !===> ...  begin here
            4557                     !
            4558     1                     if (k == 1) then
            4559     1                       dz = -zsoil(1)
            4560     1                     else
            4561     1                       dz = zsoil(k-1) - zsoil(k)
            4562     1                     endif
            4563                     
            4564                     !  --- ...  via function frh2o, compute potential or 'equilibrium' unfrozen
            4565                     !           supercooled free water for given soil type and soil layer temperature.
            4566                     !           function frh20 invokes eqn (17) from v. koren et al (1999, jgr, vol.
            4567                     !           104, pg 19573).  (aside:  latter eqn in journal in centigrade units.
            4568                     !           routine frh2o use form of eqn in kelvin units.)
            4569                     
            4570                     !     free = frh2o( tavg,smc,sh2o,smcmax,bexp,psisat )
            4571                     
            4572                           call frh2o                                                        &
            4573                     !  ---  inputs: &
            4574                                ( tavg, smc, sh2o, smcmax, bexp, psisat,                     &
            4575                     !  ---  outputs: &
            4576                                  free                                                       &
            4577                                )
            4578                     
            4579                     
            4580                     !  --- ...  in next block of code, invoke eqn 18 of v. koren et al (1999, jgr,
            4581                     !           vol. 104, pg 19573.)  that is, first estimate the new amountof liquid
            4582                     !           water, 'xh2o', implied by the sum of (1) the liquid water at the begin
            4583                     !           of current time step, and (2) the freeze of thaw change in liquid
            4584                     !           water implied by the heat flux 'qtot' passed in from routine hrt.
            4585                     !           second, determine if xh2o needs to be bounded by 'free' (equil amt) or
            4586                     !           if 'free' needs to be bounded by xh2o.
            4587                     
            4588                           xh2o = sh2o + qtot*dt / (dh2o*lsubf*dz)
            4589                     
            4590                     !  --- ...  first, if freezing and remaining liquid less than lower bound, then
            4591                     !           reduce extent of freezing, thereby letting some or all of heat flux
            4592                     !           qtot cool the soil temp later in routine hrt.
            4593                     
            4594     1                     if ( xh2o < sh2o .and. xh2o < free) then
            4595     2                       if ( free > sh2o ) then
            4596     2                         xh2o = sh2o
            4597     2                       else
            4598     2                         xh2o = free
            4599     2                       endif
            4600     1                     endif
            4601                     
            4602                     !  --- ...  second, if thawing and the increase in liquid water greater than
            4603                     !           upper bound, then reduce extent of thaw, thereby letting some or
            4604                     !           all of heat flux qtot warm the soil temp later in routine hrt.
            4605                     
            4606     1                     if ( xh2o > sh2o .and. xh2o > free )  then
            4607     2                       if ( free < sh2o ) then
            4608     2                         xh2o = sh2o
            4609     2                       else
            4610     2                         xh2o = free
            4611     2                       endif
            4612     1                     endif
            4613                     
            4614                           xh2o = max( min( xh2o, smc ), 0.0 )
            4615                     
            4616                     !  --- ...  calculate phase-change heat source/sink term for use in routine hrt
            4617                     !           and update liquid water to reflcet final freeze/thaw increment.
            4618                     
            4619                           tsrc = -dh2o * lsubf * dz * (xh2o - sh2o) / dt
            4620                           sh2o = xh2o
            4621                     !
            4622                           return
            4623                     !...................................
            4624                           end subroutine snksrc
            4625                     !-----------------------------------
            4626                     
            4627                     
            4628                     !-----------------------------------
            4629                           subroutine srt                                                    &
            4630                     !...................................
            4631                     !  ---  inputs: &
            4632                                ( nsoil, edir, et, sh2o, sh2oa, pcpdrp, zsoil, dwsat,        &
            4633                                  dksat, smcmax, bexp, dt, smcwlt, slope, kdt, frzx, sice,   &
            4634                     !  ---  outputs: &
            4635                                  rhstt, runoff1, runoff2, ai, bi, ci                        &
            4636                                )
            4637                     
            4638                     ! ===================================================================== !
            4639                     !  description:                                                         !
            4640                     !    subroutine srt calculates the right hand side of the time tendency !
            4641                     !    term of the soil water diffusion equation.  also to compute        !
            4642                     !    ( prepare ) the matrix coefficients for the tri-diagonal matrix    !
            4643                     !    of the implicit time scheme.                                       !
            4644                     !                                                                       !
            4645                     !  subprogram called:  wdfcnd                                           !
            4646                     !                                                                       !
            4647                     !                                                                       !
            4648                     !  ====================  defination of variables  ====================  !
            4649                     !                                                                       !
            4650                     !  inputs:                                                       size   !
            4651                     !     nsoil    - integer, number of soil layers                    1    !
            4652                     !     edir     - real, direct soil evaporation                     1    !
            4653                     !     et       - real, plant transpiration                       nsoil  !
            4654                     !     sh2o     - real, unfrozen soil moisture                    nsoil  !
            4655                     !     sh2oa    - real,                                           nsoil  !
            4656                     !     pcpdrp   - real, combined prcp and drip                      1    !
            4657                     !     zsoil    - real, soil layer depth below ground             nsoil  !
            4658                     !     dwsat    - real, saturated soil diffusivity                  1    !
            4659                     !     dksat    - real, saturated soil hydraulic conductivity       1    !
            4660                     !     smcmax   - real, porosity                                    1    !
            4661                     !     bexp     - real, soil type "b" parameter                     1    !
            4662                     !     dt       - real, time step                                   1    !
            4663                     !     smcwlt   - real, wilting point                               1    !
            4664                     !     slope    - real, linear reservoir coefficient                1    !
            4665                     !     kdt      - real,                                             1    !
            4666                     !     frzx     - real, frozen ground parameter                     1    !
            4667                     !     sice     - real, ice content at each soil layer            nsoil  !
            4668                     !                                                                       !
            4669                     !  outputs:                                                             !
            4670                     !     rhstt    - real, soil water time tendency                  nsoil  !
            4671                     !     runoff1  - real, surface runoff not infiltrating sfc         1    !
            4672                     !     runoff2  - real, sub surface runoff (baseflow)               1    !
            4673                     !     ai       - real, matrix coefficients                       nsold  !
            4674                     !     bi       - real, matrix coefficients                       nsold  !
            4675                     !     ci       - real, matrix coefficients                       nsold  !
            4676                     !                                                                       !
            4677                     !  ====================    end of description    =====================  !
            4678                     !
            4679                     !  ---  inputs:
            4680                           integer, intent(in) :: nsoil
            4681                     
            4682                           real (kind=kind_phys), dimension(nsoil), intent(in) :: et,        &
            4683                                  sh2o, sh2oa, zsoil, sice
            4684                     
            4685                           real (kind=kind_phys), intent(in) :: edir, pcpdrp, dwsat, dksat,  &
            4686                                  smcmax, smcwlt, bexp, dt, slope, kdt, frzx
            4687                     
            4688                     !  --- outputs:
            4689                           real (kind=kind_phys), intent(out) :: runoff1, runoff2,           &
            4690                                 rhstt(nsoil), ai(nsold), bi(nsold), ci(nsold)
            4691                     
            4692                     
            4693                     !  ---  locals:
            4694                           real (kind=kind_phys) :: acrt, dd, ddt, ddz, ddz2, denom, denom2, &
            4695                                  dice, dsmdz, dsmdz2, dt1, fcr, infmax, mxsmc, mxsmc2, px,  &
            4696                                  numer, pddum, sicemax, slopx, smcav, sstt, sum, val, wcnd, &
            4697                                  wcnd2, wdf, wdf2, dmax(nsold)
            4698                     
            4699                           integer :: cvfrz, ialp1, iohinf, j, jj, k, ks
            4700                     !
            4701                     !===> ...  begin here
            4702                     !
            4703                     !  --- ...  frozen ground version:
            4704                     !           reference frozen ground parameter, cvfrz, is a shape parameter
            4705                     !           of areal distribution function of soil ice content which equals
            4706                     !           1/cv. cv is a coefficient of spatial variation of soil ice content.
            4707                     !           based on field data cv depends on areal mean of frozen depth, and
            4708                     !           it close to constant = 0.6 if areal mean frozen depth is above 20 cm.
            4709                     !           that is why parameter cvfrz = 3 (int{1/0.6*0.6}). current logic
            4710                     !           doesn't allow cvfrz be bigger than 3
            4711                     
            4712                             parameter (cvfrz = 3)
            4713                     
            4714                     ! ----------------------------------------------------------------------
            4715                     !  --- ...  determine rainfall infiltration rate and runoff.  include
            4716                     !           the infiltration formule from schaake and koren model.
            4717                     !           modified by q duan
            4718                     
            4719                           iohinf = 1
            4720                     
            4721                     !  --- ... let sicemax be the greatest, if any, frozen water content within
            4722                     !          soil layers.
            4723                     
            4724                           sicemax = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<< Loop-information  End >>>
            4725     1  pp    s            do ks = 1, nsoil
            4726     1   p    s             if (sice(ks) > sicemax) sicemax = sice(ks)
            4727     1   p    s            enddo
            4728                     
            4729                     !  --- ...  determine rainfall infiltration rate and runoff
            4730                     
            4731                           pddum = pcpdrp
            4732                           runoff1 = 0.0
            4733                     
            4734     1                     if (pcpdrp /= 0.0) then
            4735     1               
            4736     1               !  --- ...  modified by q. duan, 5/16/94
            4737     1               
            4738     1                       dt1 = dt/86400.
            4739     1                       smcav = smcmax - smcwlt
            4740     1                       dmax(1) = -zsoil(1) * smcav
            4741     1               
            4742     1               !  --- ...  frozen ground version:
            4743     1               
            4744     1                       dice = -zsoil(1) * sice(1)
            4745     1               
            4746     1                       dmax(1) = dmax(1)*(1.0 - (sh2oa(1)+sice(1)-smcwlt)/smcav)
            4747     1                       dd = dmax(1)
            4748     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4749     2  pp    v              do ks = 2, nsoil
            4750     2               
            4751     2               !  --- ...  frozen ground version:
            4752     2               
            4753     2   p    v                dice = dice + ( zsoil(ks-1) - zsoil(ks) ) * sice(ks)
            4754     2               
            4755     2   p    v                dmax(ks) = (zsoil(ks-1)-zsoil(ks))*smcav
            4756     2   p    v                dmax(ks) = dmax(ks)*(1.0 - (sh2oa(ks)+sice(ks)-smcwlt)/smcav)
            4757     2   p    v                dd = dd + dmax(ks)
            4758     2   p    v              enddo
            4759     1               
            4760     1               !  --- ...  val = (1.-exp(-kdt*sqrt(dt1)))
            4761     1               !           in below, remove the sqrt in above
            4762     1               
            4763     1                       val = 1.0 - exp(-kdt*dt1)
            4764     1                       ddt = dd * val
            4765     1               
            4766     1                       px = pcpdrp * dt
            4767     1                       if (px < 0.0) px = 0.0
            4768     1               
            4769     1                       infmax = (px*(ddt/(px+ddt)))/dt
            4770     1               
            4771     1               !  --- ...  frozen ground version:
            4772     1               !           reduction of infiltration based on frozen ground parameters
            4773     1               
            4774     1                       fcr = 1.
            4775     1               
            4776     2                       if (dice > 1.e-2) then
            4777     2                         acrt = cvfrz * frzx / dice
            4778     2                         sum = 1.
            4779     2               
            4780     2                         ialp1 = cvfrz - 1
            4781     3                         do j = 1, ialp1
            4782     3                           k = 1
            4783     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<< Loop-information  End >>>
            4784     4  pp    v                  do jj = j+1,ialp1
            4785     4   p    v                    k = k * jj
            4786     4   p    v                  enddo
            4787     3               
            4788     3                           sum = sum + (acrt**( cvfrz-j)) / float (k)
            4789     3                         enddo
            4790     2               
            4791     2                         fcr = 1.0 - exp(-acrt) * sum
            4792     2                       endif
            4793     1               
            4794     1                       infmax = infmax * fcr
            4795     1               
            4796     1               !  --- ...  correction of infiltration limitation:
            4797     1               !           if infmax .le. hydrolic conductivity assign infmax the value
            4798     1               !           of hydrolic conductivity
            4799     1               
            4800     1               !       mxsmc = max ( sh2oa(1), sh2oa(2) )
            4801     1                       mxsmc = sh2oa(1)
            4802     1               
            4803     1                       call wdfcnd                                                     &
            4804     1               !  ---  inputs: &
            4805     1                          ( mxsmc, smcmax, bexp, dksat, dwsat, sicemax,                &
            4806     1               !  ---  outputs: &
            4807     1                            wdf, wcnd                                                  &
            4808     1                          )
            4809     1               
            4810     1                       infmax = max( infmax, wcnd )
            4811     1                       infmax = min( infmax, px )
            4812     1               
            4813     2                       if (pcpdrp > infmax) then
            4814     2                         runoff1 = pcpdrp - infmax
            4815     2                         pddum   = infmax
            4816     2                       endif
            4817     1               
            4818     1                     endif   ! end if_pcpdrp_block
            4819                     
            4820                     !  --- ... to avoid spurious drainage behavior, 'upstream differencing'
            4821                     !          in line below replaced with new approach in 2nd line:
            4822                     !          'mxsmc = max(sh2oa(1), sh2oa(2))'
            4823                     
            4824                           mxsmc = sh2oa(1)
            4825                     
            4826                           call wdfcnd                                                       &
            4827                     !  ---  inputs: &
            4828                                ( mxsmc, smcmax, bexp, dksat, dwsat, sicemax,                &
            4829                     !  ---  outputs: &
            4830                                  wdf, wcnd                                                  &
            4831                                )
            4832                     
            4833                     !  --- ...  calc the matrix coefficients ai, bi, and ci for the top layer
            4834                     
            4835                           ddz = 1.0 / ( -.5*zsoil(2) )
            4836                           ai(1) = 0.0
            4837                           bi(1) = wdf * ddz / ( -zsoil(1) )
            4838                           ci(1) = -bi(1)
            4839                     
            4840                     !  --- ...  calc rhstt for the top layer after calc'ng the vertical soil
            4841                     !           moisture gradient btwn the top and next to top layers.
            4842                     
            4843                           dsmdz = ( sh2o(1) - sh2o(2) ) / ( -.5*zsoil(2) )
            4844                           rhstt(1) = (wdf*dsmdz + wcnd - pddum + edir + et(1)) / zsoil(1)
            4845                           sstt = wdf * dsmdz + wcnd + edir + et(1)
            4846                     
            4847                     !  --- ...  initialize ddz2
            4848                     
            4849                           ddz2 = 0.0
            4850                     
            4851                     !  --- ...  loop thru the remaining soil layers, repeating the abv process
            4852                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zsoil, et, ci, ai, rhstt, bi
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 8  FILL 31
                                   <<<      SIMD&FP   : SPILL 1  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4853     1       2             do k = 2, nsoil
            4854     1       2               denom2 = (zsoil(k-1) - zsoil(k))
            4855     1               
            4856     2       2               if (k /= nsoil) then
            4857     2       2                 slopx = 1.0
            4858     2               
            4859     2               !  --- ...  again, to avoid spurious drainage behavior, 'upstream differencing'
            4860     2               !           in line below replaced with new approach in 2nd line:
            4861     2               !           'mxsmc2 = max (sh2oa(k), sh2oa(k+1))'
            4862     2               
            4863     2       2                 mxsmc2 = sh2oa(k)
            4864     2               
            4865     2       2                 call wdfcnd                                                   &
            4866     2               !  ---  inputs: &
            4867     2                          ( mxsmc2, smcmax, bexp, dksat, dwsat, sicemax,               &
            4868     2               !  ---  outputs: &
            4869     2                            wdf2, wcnd2                                                &
            4870     2                          )
            4871     2               
            4872     2               !  --- ...  calc some partial products for later use in calc'ng rhstt
            4873     2               
            4874     2       2                 denom = (zsoil(k-1) - zsoil(k+1))
            4875     2       2                 dsmdz2 = (sh2o(k) - sh2o(k+1)) / (denom * 0.5)
            4876     2               
            4877     2               !  --- ...  calc the matrix coef, ci, after calc'ng its partial product
            4878     2               
            4879     2       2                 ddz2 = 2.0 / denom
            4880     2       2                 ci(k) = -wdf2 * ddz2 / denom2
            4881     2               
            4882     2       2               else   ! if_k_block
            4883     2               
            4884     2               !  --- ...  slope of bottom layer is introduced
            4885     2               
            4886     2       2                 slopx = slope
            4887     2               
            4888     2               !  --- ...  retrieve the soil water diffusivity and hydraulic conductivity
            4889     2               !           for this layer
            4890     2               
            4891     2       2                 call wdfcnd                                                   &
            4892     2               !  ---  inputs: &
            4893     2                          ( sh2oa(nsoil), smcmax, bexp, dksat, dwsat, sicemax,         &
            4894     2               !  ---  outputs: &
            4895     2                            wdf2, wcnd2                                                &
            4896     2                          )
            4897     2               
            4898     2               !  --- ...  calc a partial product for later use in calc'ng rhstt
            4899     2       2                 dsmdz2 = 0.0
            4900     2               
            4901     2               !  --- ...  set matrix coef ci to zero
            4902     2               
            4903     2       2                 ci(k) = 0.0
            4904     2               
            4905     2       2               endif   ! end if_k_block
            4906     1               
            4907     1               !  --- ...  calc rhstt for this layer after calc'ng its numerator
            4908     1               
            4909     1       2               numer = wdf2*dsmdz2 + slopx*wcnd2 - wdf*dsmdz - wcnd + et(k)
            4910     1       2               rhstt(k) = numer / (-denom2)
            4911     1               
            4912     1               !  --- ...  calc matrix coefs, ai, and bi for this layer
            4913     1               
            4914     1       2               ai(k) = -wdf * ddz / denom2
            4915     1       2               bi(k) = -( ai(k) + ci(k) )
            4916     1               
            4917     1               !  --- ...  reset values of wdf, wcnd, dsmdz, and ddz for loop to next lyr
            4918     1               !      runoff2:  sub-surface or baseflow runoff
            4919     1               
            4920     2       2               if (k == nsoil) then
            4921     2       2                 runoff2 = slopx * wcnd2
            4922     2       2               endif
            4923     1               
            4924     2       2               if (k /= nsoil) then
            4925     2       2                 wdf  = wdf2
            4926     2       2                 wcnd = wcnd2
            4927     2       2                 dsmdz= dsmdz2
            4928     2       2                 ddz  = ddz2
            4929     2       2               endif
            4930     1       2             enddo   ! end do_k_loop
            4931                     !
            4932                           return
            4933                     !...................................
            4934                           end subroutine srt
            4935                     !-----------------------------------
            4936                     
            4937                     
            4938                     !-----------------------------------
            4939                           subroutine sstep                                                  &
            4940                     !...................................
            4941                     !  ---  inputs: &
            4942                                ( nsoil, sh2oin, rhsct, dt, smcmax, cmcmax, zsoil, sice,     &
            4943                     !  ---  input/outputs: &
            4944                                  cmc, rhstt, ai, bi, ci,                                    &
            4945                     !  ---  outputs: &
            4946                                  sh2oout, runoff3, smc                                      &
            4947                                )
            4948                     
            4949                     ! ===================================================================== !
            4950                     !  description:                                                         !
            4951                     !    subroutine sstep calculates/updates soil moisture content values   !
            4952                     !    and canopy moisture content values.                                !
            4953                     !                                                                       !
            4954                     !  subprogram called:  rosr12                                           !
            4955                     !                                                                       !
            4956                     !                                                                       !
            4957                     !  ====================  defination of variables  ====================  !
            4958                     !                                                                       !
            4959                     !  inputs:                                                       size   !
            4960                     !     nsoil    - integer, number of soil layers                    1    !
            4961                     !     sh2oin   - real, unfrozen soil moisture                    nsoil  !
            4962                     !     rhsct    - real,                                             1    !
            4963                     !     dt       - real, time step                                   1    !
            4964                     !     smcmax   - real, porosity                                    1    !
            4965                     !     cmcmax   - real, maximum canopy water parameters             1    !
            4966                     !     zsoil    - real, soil layer depth below ground             nsoil  !
            4967                     !     sice     - real, ice content at each soil layer            nsoil  !
            4968                     !                                                                       !
            4969                     !  input/outputs:                                                       !
            4970                     !     cmc      - real, canopy moisture content                     1    !
            4971                     !     rhstt    - real, soil water time tendency                  nsoil  !
            4972                     !     ai       - real, matrix coefficients                       nsold  !
            4973                     !     bi       - real, matrix coefficients                       nsold  !
            4974                     !     ci       - real, matrix coefficients                       nsold  !
            4975                     !                                                                       !
            4976                     !  outputs:                                                             !
            4977                     !     sh2oout  - real, updated soil moisture content             nsoil  !
            4978                     !     runoff3  - real, excess of porosity                          1    !
            4979                     !     smc      - real, total soil moisture                       nsoil  !
            4980                     !                                                                       !
            4981                     !  ====================    end of description    =====================  !
            4982                     !
            4983                     !  ---  input:
            4984                           integer, intent(in) :: nsoil
            4985                     
            4986                           real (kind=kind_phys), dimension(nsoil), intent(in) :: sh2oin,    &
            4987                                  zsoil, sice
            4988                     
            4989                           real (kind=kind_phys), intent(in) :: rhsct, dt, smcmax, cmcmax
            4990                     
            4991                     !  ---  inout/outputs:
            4992                           real (kind=kind_phys), intent(inout) :: cmc, rhstt(nsoil),        &
            4993                                  ai(nsold), bi(nsold), ci(nsold)
            4994                     
            4995                     !  ---  outputs:
            4996                           real (kind=kind_phys), intent(out) :: sh2oout(nsoil), runoff3,    &
            4997                                  smc(nsoil)
            4998                     
            4999                     !  ---  locals:
            5000                           real (kind=kind_phys) :: ciin(nsold), rhsttin(nsoil), ddz, stot,  &
            5001                                  wplus
            5002                     
            5003                           integer :: i, k, kk11
            5004                     !
            5005                     !===> ...  begin here
            5006                     !
            5007                     !  --- ...  create 'amount' values of variables to be input to the
            5008                     !           tri-diagonal matrix routine.
            5009                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 5010,5019)
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ci, bi, ai, rhstt, rhsttin
                                   <<< Loop-information  End >>>
            5010     1   s    v            do k = 1, nsoil
            5011     1   p    v              rhstt(k) = rhstt(k) * dt
            5012     1   p    v              ai(k) = ai(k) * dt
            5013     1   p    v              bi(k) = 1. + bi(k) * dt
            5014     1   p    v              ci(k) = ci(k) * dt
            5015     1   p    v            enddo
            5016                     
            5017                     !  --- ...  copy values for input variables before call to rosr12
            5018                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            5019     1                     do k = 1, nsoil
            5020     1                       rhsttin(k) = rhstt(k)
            5021     1                     enddo
            5022                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            5023     1       f             do k = 1, nsold
            5024     1       f               ciin(k) = ci(k)
            5025     1       f             enddo
            5026                     
            5027                     !  --- ...  call rosr12 to solve the tri-diagonal matrix
            5028                     
            5029                           call rosr12                                                       &
            5030                     !  ---  inputs: &
            5031                                ( nsoil, ai, bi, rhsttin,                                    &
            5032                     !  ---  input/outputs: &
            5033                                  ciin,                                                      &
            5034                     !  ---  outputs: &
            5035                                  ci, rhstt                                                  &
            5036                                )
            5037                     
            5038                     !  --- ...  sum the previous smc value and the matrix solution to get
            5039                     !           a new value.  min allowable value of smc will be 0.02.
            5040                     !      runoff3: runoff within soil layers
            5041                     
            5042                           wplus   = 0.0
            5043                           runoff3 = 0.0
            5044                           ddz     = -zsoil(1)
            5045                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sh2oin, ci, sice, sh2oout, smc
                                   <<< Loop-information  End >>>
            5046     1   s   2s            do k = 1, nsoil
            5047     1   p   2v              if (k /= 1) ddz = zsoil(k - 1) - zsoil(k)
            5048     1               
            5049     1   m   2m              sh2oout(k) = sh2oin(k) + ci(k) + wplus/ddz
            5050     1               
            5051     1   m   2m              stot = sh2oout(k) + sice(k)
            5052     2   s   2s              if (stot > smcmax) then
            5053     3   s   2m                if (k == 1) then
            5054     3   m   2m                  ddz = -zsoil(1)
            5055     3   s   2s                else
            5056     3   s   2s                  kk11 = k - 1
            5057     3   m   2s                  ddz = -zsoil(k) + zsoil(kk11)
            5058     3   s   2s                endif
            5059     2               
            5060     2   m   2m                wplus = (stot - smcmax) * ddz
            5061     2   s   2s              else
            5062     2   m   2s                wplus = 0.0
            5063     2   p   2v              endif
            5064     1               
            5065     1   p   2v              smc(k) = max( min( stot, smcmax ), 0.02 )
            5066     1   p   2v              sh2oout(k) = max( smc(k)-sice(k), 0.0 )
            5067     1   p   2v            enddo
            5068                     
            5069                           runoff3 = wplus
            5070                     
            5071                     !  --- ...  update canopy water content/interception (cmc).  convert rhsct to
            5072                     !           an 'amount' value and add to previous cmc value to get new cmc.
            5073                     
            5074                           cmc = cmc + dt*rhsct
            5075                           if (cmc < 1.e-20) cmc = 0.0
            5076                           cmc = min( cmc, cmcmax )
            5077                     !
            5078                           return
            5079                     !...................................
            5080                           end subroutine sstep
            5081                     !-----------------------------------
            5082                     
            5083                     
            5084                     !-----------------------------------
            5085                           subroutine tbnd                                                   &
            5086                     !...................................
            5087                     !  ---  inputs: &
            5088                                ( tu, tb, zsoil, zbot, k, nsoil,                             &
            5089                     !  ---  outputs: &
            5090                                  tbnd1                                                      &
            5091                                )
            5092                     
            5093                     ! ===================================================================== !
            5094                     !  description:                                                         !
            5095                     !                                                                       !
            5096                     !    subroutine tbnd calculates temperature on the boundary of the      !
            5097                     !    layer by interpolation of the middle layer temperatures            !
            5098                     !                                                                       !
            5099                     !  subprogram called:  none                                             !
            5100                     !                                                                       !
            5101                     !  ====================  defination of variables  ====================  !
            5102                     !                                                                       !
            5103                     !  inputs:                                                       size   !
            5104                     !     tu       - real, soil temperature                            1    !
            5105                     !     tb       - real, bottom soil temp                            1    !
            5106                     !     zsoil    - real, soil layer depth                          nsoil  !
            5107                     !     zbot     - real, specify depth of lower bd soil              1    !
            5108                     !     k        - integer, soil layer index                         1    !
            5109                     !     nsoil    - integer, number of soil layers                    1    !
            5110                     !                                                                       !
            5111                     !  outputs:                                                             !
            5112                     !     tbnd1    - real, temperature at bottom interface of the lyr  1    !
            5113                     !                                                                       !
            5114                     !  ====================    end of description    =====================  !
            5115                     !
            5116                     !  ---  input:
            5117                           integer, intent(in) :: k, nsoil
            5118                     
            5119                           real (kind=kind_phys), intent(in) :: tu, tb, zbot, zsoil(nsoil)
            5120                     
            5121                     !  ---  output:
            5122                           real (kind=kind_phys), intent(out) :: tbnd1
            5123                     
            5124                     !  ---  locals:
            5125                           real (kind=kind_phys) :: zb, zup
            5126                     
            5127                     !  --- ...  use surface temperature on the top of the first layer
            5128                     
            5129     1                     if (k == 1) then
            5130     1                       zup = 0.0
            5131     1                     else
            5132     1                       zup = zsoil(k-1)
            5133     1                     endif
            5134                     
            5135                     !  --- ...  use depth of the constant bottom temperature when interpolate
            5136                     !           temperature into the last layer boundary
            5137                     
            5138     1                     if (k == nsoil) then
            5139     1                       zb = 2.0*zbot - zsoil(k)
            5140     1                     else
            5141     1                       zb = zsoil(k+1)
            5142     1                     endif
            5143                     
            5144                     !  --- ...  linear interpolation between the average layer temperatures
            5145                     
            5146                           tbnd1 = tu + (tb-tu)*(zup-zsoil(k))/(zup-zb)
            5147                     !
            5148                           return
            5149                     !...................................
            5150                           end subroutine tbnd
            5151                     !-----------------------------------
            5152                     
            5153                     
            5154                     !-----------------------------------
            5155                           subroutine tmpavg                                                 &
            5156                     !...................................
            5157                     !  ---  inputs: &
            5158                                ( tup, tm, tdn, zsoil, nsoil, k,                             &
            5159                     !  ---  outputs: &
            5160                                  tavg                                                       &
            5161                                )
            5162                     
            5163                     ! ===================================================================== !
            5164                     !  description:                                                         !
            5165                     !    subroutine tmpavg calculates soil layer average temperature (tavg) !
            5166                     !    in freezing/thawing layer using up, down, and middle layer         !
            5167                     !    temperatures (tup, tdn, tm), where tup is at top boundary of       !
            5168                     !    layer, tdn is at bottom boundary of layer.  tm is layer prognostic !
            5169                     !    state temperature.                                                 !
            5170                     !                                                                       !
            5171                     !                                                                       !
            5172                     !  subprogram called:  none                                             !
            5173                     !                                                                       !
            5174                     !
            5175                     !  ====================  defination of variables  ====================  !
            5176                     !                                                                       !
            5177                     !  inputs:                                                       size   !
            5178                     !     tup      - real, temperature ar top boundary of layer        1    !
            5179                     !     tm       - real, layer prognostic state temperature          1    !
            5180                     !     tdn      - real, temperature ar bottom boundary of layer     1    !
            5181                     !     zsoil    - real, soil layer depth                          nsoil  !
            5182                     !     nsoil    - integer, number of soil layers                    1    !
            5183                     !     k        - integer, layer index                              1    !
            5184                     !  outputs:                                                             !
            5185                     !     tavg     - real, soil layer average temperature              1    !
            5186                     !                                                                       !
            5187                     !  ====================    end of description    =====================  !
            5188                     !
            5189                     !  ---  input:
            5190                           integer, intent(in) :: nsoil, k
            5191                     
            5192                           real (kind=kind_phys), intent(in) :: tup, tm, tdn, zsoil(nsoil)
            5193                     
            5194                     !  ---  output:
            5195                           real (kind=kind_phys), intent(out) :: tavg
            5196                     
            5197                     !  ---  locals:
            5198                           real (kind=kind_phys) :: dz, dzh, x0, xdn, xup
            5199                     !
            5200                     !===> ...  begin here
            5201                     !
            5202     1                     if (k == 1) then
            5203     1                       dz = -zsoil(1)
            5204     1                     else
            5205     1                       dz = zsoil(k-1) - zsoil(k)
            5206     1                     endif
            5207                     
            5208                           dzh = dz * 0.5
            5209                     
            5210     1                     if (tup < tfreez) then
            5211     1               
            5212     2                       if (tm < tfreez) then
            5213     3                         if (tdn < tfreez) then               ! tup, tm, tdn < t0
            5214     3                           tavg = (tup + 2.0*tm + tdn) / 4.0
            5215     3                         else                                 ! tup & tm < t0,  tdn >= t0
            5216     3                           x0 = (tfreez - tm) * dzh / (tdn - tm)
            5217     3                           tavg = 0.5*(tup*dzh + tm*(dzh+x0)+tfreez*(2.*dzh-x0)) / dz
            5218     3                         endif
            5219     2                       else
            5220     3                         if (tdn < tfreez) then               ! tup < t0, tm >= t0, tdn < t0
            5221     3                           xup  = (tfreez-tup) * dzh / (tm-tup)
            5222     3                           xdn  = dzh - (tfreez-tm) * dzh / (tdn-tm)
            5223     3                           tavg = 0.5*(tup*xup + tfreez*(2.*dz-xup-xdn)+tdn*xdn) / dz
            5224     3                         else                                 ! tup < t0, tm >= t0, tdn >= t0
            5225     3                           xup  = (tfreez-tup) * dzh / (tm-tup)
            5226     3                           tavg = 0.5*(tup*xup + tfreez*(2.*dz-xup)) / dz
            5227     3                         endif
            5228     2                       endif
            5229     1               
            5230     1                     else    ! if_tup_block
            5231     1               
            5232     2                       if (tm < tfreez) then
            5233     3                         if (tdn < tfreez) then               ! tup >= t0, tm < t0, tdn < t0
            5234     3                           xup  = dzh - (tfreez-tup) * dzh / (tm-tup)
            5235     3                           tavg = 0.5*(tfreez*(dz-xup) + tm*(dzh+xup)+tdn*dzh) / dz
            5236     3                         else                                 ! tup >= t0, tm < t0, tdn >= t0
            5237     3                           xup  = dzh - (tfreez-tup) * dzh / (tm-tup)
            5238     3                           xdn  = (tfreez-tm) * dzh / (tdn-tm)
            5239     3                           tavg = 0.5 * (tfreez*(2.*dz-xup-xdn) + tm*(xup+xdn)) / dz
            5240     3                         endif
            5241     2                       else
            5242     3                         if (tdn < tfreez) then               ! tup >= t0, tm >= t0, tdn < t0
            5243     3                           xdn  = dzh - (tfreez-tm) * dzh / (tdn-tm)
            5244     3                           tavg = (tfreez*(dz-xdn) + 0.5*(tfreez+tdn)*xdn) / dz
            5245     3                         else                                 ! tup >= t0, tm >= t0, tdn >= t0
            5246     3                           tavg = (tup + 2.0*tm + tdn) / 4.0
            5247     3                         endif
            5248     2                       endif
            5249     1               
            5250     1                     endif   ! end if_tup_block
            5251                     !
            5252                           return
            5253                     !...................................
            5254                           end subroutine tmpavg
            5255                     !-----------------------------------
            5256                     
            5257                     
            5258                     !-----------------------------------
            5259                           subroutine transp                                                    &
            5260                     !...................................
            5261                     !  ---  inputs: &
            5262                                ( nsoil, nroot, etp1, smc, smcwlt, smcref,                   &
            5263                                  cmc, cmcmax, zsoil, shdfac, pc, cfactr, rtdis,             &
            5264                     !  ---  outputs: &
            5265                                  et1                                                        &
            5266                                )
            5267                     
            5268                     ! ===================================================================== !
            5269                     !  description:                                                         !
            5270                     !     subroutine transp calculates transpiration for the veg class.     !
            5271                     !                                                                       !
            5272                     !  subprogram called:  none                                             !
            5273                     !                                                                       !
            5274                     !                                                                       !
            5275                     !  ====================  defination of variables  ====================  !
            5276                     !                                                                       !
            5277                     !  inputs:                                                       size   !
            5278                     !     nsoil    - integer, number of soil layers                    1    !
            5279                     !     nroot    - integer, number of root layers                    1    !
            5280                     !     etp1     - real, potential evaporation                       1    !
            5281                     !     smc      - real, unfrozen soil moisture                    nsoil  !
            5282                     !     smcwlt   - real, wilting point                               1    !
            5283                     !     smcref   - real, soil mois threshold                         1    !
            5284                     !     cmc      - real, canopy moisture content                     1    !
            5285                     !     cmcmax   - real, maximum canopy water parameters             1    !
            5286                     !     zsoil    - real, soil layer depth below ground             nsoil  !
            5287                     !     shdfac   - real, aeral coverage of green vegetation          1    !
            5288                     !     pc       - real, plant coeff                                 1    !
            5289                     !     cfactr   - real, canopy water parameters                     1    !
            5290                     !     rtdis    - real, root distribution                         nsoil  !
            5291                     !                                                                       !
            5292                     !  outputs:                                                             !
            5293                     !     et1      - real, plant transpiration                       nsoil  !
            5294                     !                                                                       !
            5295                     !  ====================    end of description    =====================  !
            5296                     !
            5297                     !  ---  input:
            5298                           integer, intent(in) :: nsoil, nroot
            5299                     
            5300                           real (kind=kind_phys), intent(in) :: etp1, smcwlt, smcref,        &
            5301                                  cmc, cmcmax, shdfac, pc, cfactr
            5302                     
            5303                           real (kind=kind_phys), dimension(nsoil), intent(in) :: smc,       &
            5304                                  zsoil, rtdis
            5305                     
            5306                     !  ---  output:
            5307                           real (kind=kind_phys), dimension(nsoil), intent(out) :: et1
            5308                     
            5309                     !  ---  locals:
            5310                           real (kind=kind_phys) :: denom, etp1a, rtx, sgx, gx(7)
            5311                     
            5312                           integer :: i, k
            5313                     !
            5314                     !===> ...  begin here
            5315                     !
            5316                     !  --- ...  initialize plant transp to zero for all soil layers.
            5317                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      et1
                                   <<< Loop-information  End >>>
            5318     1  pp   4v            do k = 1, nsoil
            5319     1   p   4v              et1(k) = 0.0
            5320     1   p   4v            enddo
            5321                     
            5322                     !  --- ...  calculate an 'adjusted' potential transpiration
            5323                     !           if statement below to avoid tangent linear problems near zero
            5324                     !           note: gx and other terms below redistribute transpiration by layer,
            5325                     !           et(k), as a function of soil moisture availability, while preserving
            5326                     !           total etp1a.
            5327                     
            5328     1                     if (cmc /= 0.0) then
            5329     1                       etp1a = shdfac * pc * etp1 * (1.0 - (cmc /cmcmax) ** cfactr)
            5330     1                     else
            5331     1                       etp1a = shdfac * pc * etp1
            5332     1                     endif
            5333                     
            5334                           sgx = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      smc, (unknown)
                                   <<< Loop-information  End >>>
            5335     1   s    v            do i = 1, nroot
            5336     1   p    v              gx(i) = ( smc(i) - smcwlt ) / ( smcref - smcwlt )
            5337     1   p    v              gx(i) = max ( min ( gx(i), 1.0 ), 0.0 )
            5338     1   p    v              sgx = sgx + gx(i)
            5339     1   p    v            enddo
            5340                           sgx = sgx / nroot
            5341                     
            5342                           denom = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rtdis, (unknown)
                                   <<< Loop-information  End >>>
            5343     1   s    v            do i = 1, nroot
            5344     1   p    v              rtx = rtdis(i) + gx(i) - sgx
            5345     1   p    v              gx(i) = gx(i) * max ( rtx, 0.0 )
            5346     1   p    v              denom = denom + gx(i)
            5347     1   p    v            enddo
            5348                           if (denom <= 0.0) denom = 1.0
            5349                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gx, et1
                                   <<< Loop-information  End >>>
            5350     1  pp    v            do i = 1, nroot
            5351     1   p    v              et1(i) = etp1a * gx(i) / denom
            5352     1   p    v            enddo
            5353                     
            5354                     !  --- ...  above code assumes a vertically uniform root distribution
            5355                     !           code below tests a variable root distribution
            5356                     
            5357                     !     et(1) = ( zsoil(1) / zsoil(nroot) ) * gx * etp1a
            5358                     !     et(1) = ( zsoil(1) / zsoil(nroot) ) * etp1a
            5359                     
            5360                     !  --- ...  using root distribution as weighting factor
            5361                     
            5362                     !     et(1) = rtdis(1) * etp1a
            5363                     !     et(1) = etp1a * part(1)
            5364                     
            5365                     !  --- ...  loop down thru the soil layers repeating the operation above,
            5366                     !           but using the thickness of the soil layer (rather than the
            5367                     !           absolute depth of each layer) in the final calculation.
            5368                     
            5369                     !     do k = 2, nroot
            5370                     !       gx = ( smc(k) - smcwlt ) / ( smcref - smcwlt )
            5371                     !       gx = max ( min ( gx, 1.0 ), 0.0 )
            5372                     !  --- ...  test canopy resistance
            5373                     !       gx = 1.0
            5374                     !       et(k) = ((zsoil(k)-zsoil(k-1))/zsoil(nroot))*gx*etp1a
            5375                     !       et(k) = ((zsoil(k)-zsoil(k-1))/zsoil(nroot))*etp1a
            5376                     
            5377                     !  --- ...  using root distribution as weighting factor
            5378                     
            5379                     !       et(k) = rtdis(k) * etp1a
            5380                     !       et(k) = etp1a*part(k)
            5381                     !     enddo
            5382                     
            5383                     !
            5384                           return
            5385                     !...................................
            5386                           end subroutine transp

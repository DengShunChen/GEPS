            5388                     
            5389                     
            5390                     !-----------------------------------
            5391                           subroutine wdfcnd                                                 &
            5392                     !...................................
            5393                     !  ---  inputs: &
            5394                                ( smc, smcmax, bexp, dksat, dwsat, sicemax,                  &
            5395                     !  ---  outputs: &
            5396                                  wdf, wcnd                                                  &
            5397                                )
            5398                     
            5399                     ! ===================================================================== !
            5400                     !  description:                                                         !
            5401                     !     subroutine wdfcnd calculates soil water diffusivity and soil      !
            5402                     !     hydraulic conductivity.                                           !
            5403                     !                                                                       !
            5404                     !  subprogram called:  none                                             !
            5405                     !                                                                       !
            5406                     !                                                                       !
            5407                     !  ====================  defination of variables  ====================  !
            5408                     !                                                                       !
            5409                     !  inputs:                                                       size   !
            5410                     !     smc      - real, layer total soil moisture                   1    !
            5411                     !     smcmax   - real, porosity                                    1    !
            5412                     !     bexp     - real, soil type "b" parameter                     1    !
            5413                     !     dksat    - real, saturated soil hydraulic conductivity       1    !
            5414                     !     dwsat    - real, saturated soil diffusivity                  1    !
            5415                     !     sicemax  - real, max frozen water content in soil layer      1    !
            5416                     !                                                                       !
            5417                     !  outputs:                                                             !
            5418                     !     wdf      - real, soil water diffusivity                      1    !
            5419                     !     wcnd     - real, soil hydraulic conductivity                 1    !
            5420                     !                                                                       !
            5421                     !  ====================    end of description    =====================  !
            5422                     !
            5423                     !  ---  input:
            5424                           real (kind=kind_phys), intent(in)  :: smc, smcmax, bexp, dksat,   &
            5425                                  dwsat, sicemax
            5426                     
            5427                     !  ---  output:
            5428                           real (kind=kind_phys), intent(out) :: wdf, wcnd
            5429                     
            5430                     !  ---  locals:
            5431                           real (kind=kind_phys) :: expon, factr1, factr2, vkwgt
            5432                     !
            5433                     !===> ...  begin here
            5434                     !
            5435                     !  --- ...  calc the ratio of the actual to the max psbl soil h2o content
            5436                     
            5437                           factr1 = 0.2 / smcmax
            5438                           factr2 = smc / smcmax
            5439                     
            5440                     !  --- ...  prep an expntl coef and calc the soil water diffusivity
            5441                     
            5442                           expon = bexp + 2.0
            5443                           wdf = dwsat * factr2 ** expon
            5444                     
            5445                     !  --- ...  frozen soil hydraulic diffusivity.  very sensitive to the vertical
            5446                     !           gradient of unfrozen water. the latter gradient can become very
            5447                     !           extreme in freezing/thawing situations, and given the relatively
            5448                     !           few and thick soil layers, this gradient sufferes serious
            5449                     !           trunction errors yielding erroneously high vertical transports of
            5450                     !           unfrozen water in both directions from huge hydraulic diffusivity.
            5451                     !           therefore, we found we had to arbitrarily constrain wdf
            5452                     !
            5453                     !           version d_10cm:  .......  factr1 = 0.2/smcmax
            5454                     !           weighted approach.......  pablo grunmann, 28_sep_1999.
            5455                     
            5456     1                     if (sicemax > 0.0) then
            5457     1                       vkwgt = 1.0 / (1.0 + (500.0*sicemax)**3.0)
            5458     1                       wdf = vkwgt*wdf + (1.0- vkwgt)*dwsat*factr1**expon
            5459     1                     endif
            5460                     
            5461                     !  --- ...  reset the expntl coef and calc the hydraulic conductivity
            5462                     
            5463                           expon = (2.0 * bexp) + 3.0
            5464                           wcnd = dksat * factr2 ** expon
            5465                     !
            5466                           return
            5467                     !...................................
            5468                           end subroutine wdfcnd
            5469                     !-----------------------------------
            5470                     
            5471                     ! =========================== !
            5472                     !     end contain programs    !
            5473                     ! =========================== !
            5474                     
            5475                     !...................................
            5476                           end subroutine sflx

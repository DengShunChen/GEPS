             464     2                       endif   ! end if_sneqv_block
             465     1               
             466     1                     endif   ! end if_ice_block
             467                     
             468                     !  --- ...  thermal conductivity for sea-ice case, glacial-ice case
             469                     
             470     1                     if (ice /= 0) then
             471     1               
             472     1                       df1 = 2.2
             473     1               
             474     1                     else
             475     1               
             476     1               !  --- ...  next calculate the subsurface heat flux, which first requires
             477     1               !           calculation of the thermal diffusivity.  treatment of the
             478     1               !           latter follows that on pages 148-149 from "heat transfer in
             479     1               !           cold climates", by v. j. lunardini (published in 1981
             480     1               !           by van nostrand reinhold co.) i.e. treatment of two contiguous
             481     1               !           "plane parallel" mediums (namely here the first soil layer
             482     1               !           and the snowpack layer, if any). this diffusivity treatment
             483     1               !           behaves well for both zero and nonzero snowpack, including the
             484     1               !           limit of very thin snowpack.  this treatment also eliminates
             485     1               !           the need to impose an arbitrary upper bound on subsurface
             486     1               !           heat flux when the snowpack becomes extremely thin.
             487     1               
             488     1               !  --- ...   first calculate thermal diffusivity of top soil layer, using
             489     1               !            both the frozen and liquid soil moisture, following the
             490     1               !            soil thermal diffusivity function of peters-lidard et al.
             491     1               !            (1998,jas, vol 55, 1209-1224), which requires the specifying
             492     1               !            the quartz content of the given soil class (see routine redprm)
             493     1               
             494     1                       call tdfcnd                                                     &
             495     1               !  ---  inputs: &
             496     1                          ( smc(1), quartz, smcmax, sh2o(1),                           &
             497     1               !  ---  outputs: &
             498     1                            df1                                                        &
             499     1                          )
             500     2                       if(ivegsrc .ge. 1) then
             501     2               !only igbp type has urban
             502     2               !urban
             503     2                           if ( vegtyp == 13 ) df1=3.24
             504     2                       endif
             505     1               
             506     1               !  --- ...  next add subsurface heat flux reduction effect from the
             507     1               !           overlying green canopy, adapted from section 2.1.2 of
             508     1               !           peters-lidard et al. (1997, jgr, vol 102(d4))
             509     1               
             510     1                       df1 = df1 * exp( sbeta*shdfac )
             511     1               
             512     1                     endif   ! end if_ice_block
             513                     
             514                     !  --- ...  finally "plane parallel" snowpack effect following
             515                     !           v.j. linardini reference cited above. note that dtot is
             516                     !           combined depth of snowdepth and thickness of first soil layer
             517                     
             518                           dsoil = -0.5 * zsoil(1)
             519                     
             520     1                     if (sneqv == 0.0) then
             521     1               
             522     1                       ssoil = df1 * (t1 - stc(1)) / dsoil
             523     1               
             524     1                     else
             525     1               
             526     1                       dtot = snowh + dsoil
             527     1                       frcsno = snowh / dtot
             528     1                       frcsoi = dsoil / dtot
             529     1               
             530     1               !  --- ...  1. harmonic mean (series flow)
             531     1               
             532     1               !       df1  = (sncond*df1) / (frcsoi*sncond + frcsno*df1)
             533     1               !       df1h = (sncond*df1) / (frcsoi*sncond + frcsno*df1)
             534     1               
             535     1               !  --- ...  2. arithmetic mean (parallel flow)
             536     1               
             537     1               !       df1  = frcsno*sncond + frcsoi*df1
             538     1                       df1a = frcsno*sncond + frcsoi*df1
             539     1               
             540     1               !  --- ...  3. geometric mean (intermediate between harmonic and arithmetic mean)
             541     1               
             542     1               !       df1 = (sncond**frcsno) * (df1**frcsoi)

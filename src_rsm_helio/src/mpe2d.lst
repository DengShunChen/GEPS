            1012                           subroutine mpe2d_unify_lev(ain,aout,lev,levp,jtrun,jtmax,mlistnum,proc,comm)
            1013                     
            1014                     ! unify lev of spectrum var
            1015                     
            1016                           use mpi
            1017                           use const,only : RTYPE,MPI_RTYPE
            1018                     
            1019                           implicit none
            1020                     
            1021                           integer lev,levp,jtrun,jtmax,mlistnum,proc,comm,ii,j,jj,k,kk,ierr
            1022                     
            1023                           real(kind=RTYPE) ain(levp,2,jtrun,jtmax)
            1024                           real(kind=RTYPE) aout(lev,2,jtrun,jtmax)
            1025                           real(kind=RTYPE) b1(levp,2,jtrun,jtmax)
            1026                           real(kind=RTYPE) b2(levp,2,jtrun,jtmax,proc)
            1027                     
            1028                           call MPI_ALLGATHER( ain, levp*2*jtrun*jtmax, MPI_RTYPE, &
            1029                                                b2, levp*2*jtrun*jtmax, MPI_RTYPE, &
            1030                                               comm,IERR )
            1031                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1032     1  pp                 do jj=1,mlistnum
            1033     2   p                 do j=1,jtrun
            1034     2   p                    kk=1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b2, aout
                                   <<< Loop-information  End >>>
            1035     3   p                 do ii=1,proc
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b2, aout
                                   <<< Loop-information  End >>>
            1036     3   p   2v               aout(kk:kk+levp-1,1,j,jj)=b2(1:levp,1,j,jj,ii)
            1037     3   p   2v               aout(kk:kk+levp-1,2,j,jj)=b2(1:levp,2,j,jj,ii)
            1038     3   p                    kk=kk+levp
            1039     3   p                 enddo
            1040     2   p                 enddo
            1041     1   p                 enddo

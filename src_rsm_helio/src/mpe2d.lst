            1427                     !----------------------------------------------------------------------------------------
            1428                           subroutine mpe2d_reshape_pl_back_sp(plin,plout)
            1429                     
            1430                     ! reshape spec coef back
            1431                     
            1432                           use mpi
            1433                           use param
            1434                           use index
            1435                     
            1436                           implicit none
            1437                     
            1438                           integer n,i,j,m,mf,ierr
            1439                     
            1440                           real*4 plin(jtp,2)
            1441                           real*4 plout(jtrun,jtmax,2)
            1442                           real*4 b2(jtp,2,nsizex)
            1443                     
            1444                           call MPI_ALLGATHER( plin, jtp*2, MPI_REAL4, &
            1445                                               b2,   jtp*2, MPI_REAL4, &
            1446                                               row_comm, IERR )
            1447                     
            1448                           i=1
            1449                           j=1
            1450                     
            1451     1                     do m=1,mlistnum
            1452     1                        mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jtlen_all, plout
                                   <<< Loop-information  End >>>
            1453     2       2s            do n=mf,jtrun
            1454     2       2m               plout(n,m,1)=b2(i,1,j)
            1455     2       2v               plout(n,m,2)=b2(i,2,j)
            1456     2       2s               i=i+1
            1457     3       2s               if(i.gt.jtlen_all(j))then
            1458     3       2s                  i=1
            1459     3       2m                  j=j+1
            1460     3       2v               endif
            1461     2       2v            enddo
            1462     1                     enddo
            1463                     
            1464                           return
            1465                           end


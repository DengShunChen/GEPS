             955                     !----------------------------------------------------------------------------------------
             956                           subroutine mpe2d_transpose_siimpl_back_multi(ain1,ain2,aout1,aout2,levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist,nsizex,row_comm)
             957                     
             958                     ! transpose siimpl spec back (2 arrays)
             959                     
             960                           use mpi
             961                           use index,only : jtlen_all
             962                           use const,only : RTYPE,MPI_RTYPE
             963                     
             964                           implicit none
             965                     
             966                           integer levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist(jtrun),nsizex,row_comm
             967                           integer m,n,mf,nl,i,nlen,ierr,j,k
             968                     
             969                           real(kind=RTYPE) ain1(lev,2,jtp),ain2(lev,2,jtp)
             970                           real(kind=RTYPE) aout1(levp,2,jtrun,jtmax),aout2(levp,2,jtrun,jtmax)
             971                     
             972                           real(kind=RTYPE) b1(jtp,4,lev)
             973                           real(kind=RTYPE) b2(jtp,4,levp,nsizex)
             974                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.12, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b1
                                   <<< Loop-information  End >>>
             975     1   p   2v            do j=1,jtp
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b1
                                   <<< Loop-information  End >>>
             976     2  pp   2             do k=1,lev
             977     2   p   2v               b1(j,1,k)=ain1(k,1,j)
             978     2   p   2v               b1(j,2,k)=ain1(k,2,j)
             979     2   p   2v               b1(j,3,k)=ain2(k,1,j)
             980     2   p   2v               b1(j,4,k)=ain2(k,2,j)
             981     2   p   2             enddo
             982     1   p                 enddo
             983                     
             984                           nlen=jtp*4*levp
             985                           call MPI_ALLTOALL( b1 ,nlen, MPI_RTYPE, &
             986                                              b2, nlen, MPI_RTYPE, &
             987                                              row_comm, IERR )
             988                     
             989                           i=1
             990                           j=1
             991                     
             992     1                     do m=1,mlistnum
             993     1                        mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      aout2, aout1
                                   <<< Loop-information  End >>>
             994     2                     do n=mf,jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.12, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      aout2, aout1
                                   <<< Loop-information  End >>>
             995     3  pp   2v            do k=1,levp
             996     3   p   2v               aout1(k,1,n,m)=b2(i,1,k,j)
             997     3   p   2v               aout1(k,2,n,m)=b2(i,2,k,j)
             998     3   p   2v               aout2(k,1,n,m)=b2(i,3,k,j)
             999     3   p   2v               aout2(k,2,n,m)=b2(i,4,k,j)
            1000     3   p   2v            enddo
            1001     2                        i=i+1
            1002     3                        if(i.gt.jtlen_all(j))then
            1003     3                           i=1
            1004     3                           j=j+1
            1005     3                        endif
            1006     2                     enddo
            1007     1                     enddo
            1008                     
            1009                           return
            1010                           end


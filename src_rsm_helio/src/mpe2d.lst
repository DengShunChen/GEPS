             857                     !----------------------------------------------------------------------------------------
             858                           subroutine mpe2d_transpose_siimpl(ain,aout, &
             859                                      levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist,nsizex,row_comm)
             860                     
             861                     ! transpose siimpl spec
             862                     
             863                           use mpi
             864                           use const, only: RTYPE,MPI_RTYPE
             865                     
             866                           implicit none
             867                     
             868                           integer levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist(jtrun),nsizex,row_comm
             869                           integer m,mf,nl,i,levp2,nlen,ierr,j,k
             870                     
             871                           real(kind=RTYPE) ain(levp,2,jtrun,jtmax)
             872                           real(kind=RTYPE) aout(lev,2,jtp)
             873                           real(kind=RTYPE) c1(levp,2,jtf)
             874                           real(kind=RTYPE) c2(levp,2,jtp,nsizex)
             875                     
             876                           levp2=levp*2
             877                           i=1
             878                     
             879     1                     do m=1,mlistnum
             880     1                        mf=mlist(m)
             881     1                        NL=jtrun-mf+1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ain, c1
                                   <<< Loop-information  End >>>
             882     1  pp   2v               c1(1:levp,1,i:i+nl-1)=ain(1:levp,1,mf:jtrun,m)
             883     1   p   2v               c1(1:levp,2,i:i+nl-1)=ain(1:levp,2,mf:jtrun,m)
             884     1                        i=i+NL
             885     1                     enddo
             886                     
             887                           nlen=levp2*jtp
             888                           call MPI_ALLTOALL( c1 ,nlen, MPI_RTYPE, &
             889                                              c2, nlen, MPI_RTYPE, &
             890                                              row_comm, IERR )
             891                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             892     1  pp                 do j=1,jtp
             893     1   p                    k=1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      c2, aout
                                   <<< Loop-information  End >>>
             894     2   p                 do i=1,nsizex
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      c2, aout
                                   <<< Loop-information  End >>>
             895     2   p   2v               aout(k:k+levp-1,1,j)=c2(1:levp,1,j,i)
             896     2   p   2v               aout(k:k+levp-1,2,j)=c2(1:levp,2,j,i)
             897     2   p                    k=k+levp
             898     2   p                 enddo
             899     1   p                 enddo
             900                     
             901                           return
             902                           end


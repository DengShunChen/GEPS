             291                           subroutine mpe2d_reshape_eps4(eps4in,eps4out)
             292                     
             293                     ! reshape eps4, used in siimpl
             294                     
             295                           use mpi
             296                           use param
             297                           use index
             298                           use const, only: RTYPE
             299                     
             300                           implicit none
             301                     
             302                           integer i,j,m,mf,nl
             303                     
             304                           real(kind=RTYPE) eps4in(jtrun,jtmax)
             305                           real(kind=RTYPE) eps4out(jtp)
             306                           real(kind=RTYPE) b1(jtf)
             307                     
             308                           i=1
             309                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4in, b1
                                   <<< Loop-information  End >>>
             310     1                     do m=1,mlistnum
             311     1                        mf=mlist(m)
             312     1                        NL=jtrun-mf+1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4in, b1
                                   <<< Loop-information  End >>>
             313     1  pp   2v               b1(i:i+nl-1)=eps4in(mf:jtrun,m)
             314     1                        i=i+NL
             315     1                     enddo
             316                     
             317                           i=0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b1, eps4out
                                   <<< Loop-information  End >>>
             318     1  pp   2v            do j=jtstart,jtend
             319     1   p   2v               i=i+1
             320     1   p   2v               eps4out(i)=b1(j)
             321     1   p   2v            enddo
             322                     
             323                           return
             324                           end


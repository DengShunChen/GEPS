     7        34                     !     a function pointer (to MPI_REGISTER_DATAREP) and therefore must be
     7        35                     !     the same size/type.  It is therefore external'ed here, and not
     7        36                     !     defined with an integer value in mpif-common.h.
     7        37                           external mpi_conversion_fn_null

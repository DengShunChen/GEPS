             553                           subroutine mpe2d_unify_uzmean(a,my,lev)
             554                     
             555                     ! unify uzmean for 2dMPI
             556                     
             557                           use param, only : my_max
             558                           use rank,  only : nsize, MPI_COMM_gfs
             559                           use index
             560                           use mpi
             561                     
             562                           implicit none
             563                     
             564                           real a(my,lev)
             565                           real b1(levp,my_max)
             566                           real b2(levp,my_max*nsize)
             567                           integer i,j,ii,jj,j1,jf,kk,my,lev,ierr

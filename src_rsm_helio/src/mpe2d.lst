             674                     !----------------------------------------------------------------------------------------
             675                           subroutine mpe2d_reshape_pl_back(plin,plout)
             676                     
             677                     ! reshape spec coef back
             678                     
             679                           use mpi
             680                           use param
             681                           use index
             682                           use const,only : RTYPE,MPI_RTYPE
             683                     
             684                           implicit none
             685                     
             686                           integer n,i,j,m,mf,ierr
             687                     
             688                           real(kind=RTYPE) plin(jtp,2)
             689                           real(kind=RTYPE) plout(jtrun,jtmax,2)
             690                           real(kind=RTYPE) b2(jtp,2,nsizex)
             691                     
             692                           call MPI_ALLGATHER( plin, jtp*2, MPI_RTYPE, &
             693                                               b2,   jtp*2, MPI_RTYPE, &
             694                                               row_comm, IERR )
             695                     
             696                           i=1
             697                           j=1
             698                     
             699     1                     do m=1,mlistnum
             700     1                        mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jtlen_all, plout
                                   <<< Loop-information  End >>>
             701     2       2s            do n=mf,jtrun
             702     2       2m               plout(n,m,1)=b2(i,1,j)
             703     2       2v               plout(n,m,2)=b2(i,2,j)
             704     2       2s               i=i+1
             705     3       2s               if(i.gt.jtlen_all(j))then
             706     3       2s                  i=1
             707     3       2m                  j=j+1
             708     3       2v               endif
             709     2       2v            enddo
             710     1                     enddo
             711                     
             712                           return
             713                           end


              61                           data mon/15,46,74,105,135,166,196,227,258,288,319,349/
              62                           data mondy/0,31,59,90,120,151,181,212,243,273,304,334,365/
              63                           data blnk/' '/
              64                     
              65                           integer   i,j,k,jul,nxj,mm,istat,monidex,lncrec,jj,ii

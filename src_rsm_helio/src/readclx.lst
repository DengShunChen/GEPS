              90                       22  format('S9Y100','gbck',a4,11x,a1)      ! for new soil
              91                     !soil
              92                       23  format('S000VX','gbck',a4,11x,a1)      ! for new soil
              93                       24  format('S000VN','gbck',a4,11x,a1)      ! for new soil
              94                       25  format('S00063','gbck',a4,11x,a1)      ! for new soil
              95                       26  format('S0003X','gbck',a4,11x,a1)      ! for new soil
              96                     !source 2(19-soil, 20-veg)
              97                       28  format('S00XST','gbck',a4,11x,a1)      ! for new soil
              98                       31  format('S00XVT','gbck',a4,11x,a1)      ! for new soil
              99                     !source 3(19-soil, 20-veg)
             100                       29  format('S00WST','gbck',a4,11x,a1)      ! for new soil from MODIS
             101                       32  format('S00WVT','gbck',a4,11x,a1)      ! for new soil from MODIS
             102                       33  format('S00WVF','gbck',a4,4x,i2.2,6x)      ! for new soil from MODIS
             103                     !
             104                     !  to interpolat linearly based on julian day

               1                           subroutine readclx(nx,my,my_max,julian,land,sea,ice,solt,wet,z0, &
               2                                              alb,sst,bckfile,sigmaf,istyp,ivegtyp,ls       &
               3                                             ,shdmax,shdmin,slopetyp,snoalb,ggdef,isot,ivegsrc)
               4                     !
               5                     !  read climt data from data base
               6                     !
               7                     !----------------------------------------------------------------
               8                     !  input :
               9                     !         nx     : dimension of e-w direction
              10                     !         my     : dimension of s-n direction
              11                     !         julian : julian day
              12                     !  output :
              13                     !         land   : index of bare soil or not (logical)
              14                     !         sea    : index of open water or not (logical)
              15                     !         ice    : index of ice cover or not (logical)
              16                     !         solt   : soil temperature ( i.e. ground temp.) (k)
              17                     !         wet    : ground wetness
              18                     !         z0     : surface roughness  (m)
              19                     !         alb    : surface albedo
              20                     !         sst    : sea surface temperature (k)
              21                     !         sigmaf : vegetation fraction
              22                     !         istyp  : soil type(1-9)
              23                     !         ivegtyp: vegetation type(1-13)
              24                     !-----------------------------------------------------------------
              25                     !
              26                           use index
              27                           use namelist_soilveg
              28                     !
              29                           implicit  none
              30                     
              31                           integer   nx,my,my_max,julian,isot,ivegsrc
              32                     
              33                           real      solt(nxp,my_max),wet(nxp,my_max),z0(nxp,my_max),alb(nxp,my_max),  &

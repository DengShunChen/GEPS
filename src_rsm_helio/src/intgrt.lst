 External subroutine subprogram "intgrt"
  (inc)(line-no.)(nest)(optimize)
               1                            subroutine intgrt
               2                     !
               3                     !***********************************************************************
               4                     !  this subroutine is the basic time stepping driver.  it does the
               5                     !  gaussian quadrature integrations to compute the adiabatic spectral
               6                     !  tendencies for the model variables. these tendencies are adjusted
               7                     !  with a semi-implicit method to make the model stable for long
               8                     !  time steps.  time steps are made with a time filter to remove
               9                     !  any computational modes.
              10                     !
              11                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
              12                     !
              13                     !***********************************************************************

            1067                           CONTAINS
            1068                           SUBROUTINE DIECAST_ZCORD(k0,k1,ocn_z)
            1069                     !   generate combined linear-exponential expanding coordinate Z(zz)
            1070                     !   Z=aa+b*exp(c*zz)+d*zz, 0 < zz < tlz
            1071                     !   where zz is the linear (unstretched) space coordinate
            1072                     !   NOTE: for expanding coordinate, 0 < d < 1
            1073                     !   at zz=0, Z=aa+b*exp(0)=0, so aa+b=0.
            1074                     !   at zz=tlz: Z=aa+b*exp(c*tlz)+d*tlz=tlz
            1075                     !   so aa*(1-exp(c*tlz))=tlz-d*tlz, aa=tlz*(1-d)/(1-exp(c*tlz))
            1076                     !  convert tlz to meters
            1077                           INTEGER, INTENT(IN):: k0,k1
            1078                           REAL, INTENT(out):: ocn_z(k0+k1)
            1079                           INTEGER:: k
            1080                           REAL:: tmp,dzz,b,c,d,aa,zz
            1081                           tmp=ocn_tlz
            1082                           dzz=tmp/(2.*k1)
            1083                     !   exponential part
            1084                           c=.001
            1085                     !   linear part
            1086                           d=0.03
            1087                           aa=tmp*(1.-d)/(1.-exp(c*tmp))
            1088                           b=-aa
            1089                           zz=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.04, ITR: 13, MVE: 6, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ocn_z
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 15  FILL 37
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1090     1   s    s            DO k=1,k0+k1
            1091     1               !   z(k) in m
            1092     1   m    m             ocn_z(k)=(aa+b*exp(c*zz)+d*zz)
            1093     1   s    s             zz=zz+dzz
            1094     1   p    v            ENDDO
            1095                           END SUBROUTINE DIECAST_ZCORD
            1096                     
            1097                           END SUBROUTINE set_ocndepth

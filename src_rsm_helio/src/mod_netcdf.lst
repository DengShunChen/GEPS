             108                       TYPE FILE_INFO
             109                     
             110                         LOGICAL :: opened                              ! open = .true. or closed = .FALSE.
             111                     
             112                         INTEGER :: file_id                             ! netCDF file id
             113                         INTEGER :: access_mode                         ! access mode for that file
             114                         INTEGER :: ncdims(NF_MAX_VAR_DIMS)
             115                         INTEGER :: format                              ! file format NETCDF
             116                     
             117                         CHARACTER (NF_MAX_NAME) :: creation_program    ! name of this program
             118                         CHARACTER (NF_MAX_NAME) :: creation_user       ! who has run this program
             119                         CHARACTER (NF_MAX_NAME) :: creation_date       ! date of creation of netCDF file
             120                         CHARACTER (NF_MAX_NAME) :: binary_source       ! binary data type of src (CRAY/IEEE)
             121                         CHARACTER (NF_MAX_NAME) :: file_type           ! initital or restart file ...
             122                         CHARACTER (NF_MAX_NAME) :: file_name           ! nc file name
             123                         CHARACTER (NF_MAX_NAME) :: title
             124                       END TYPE FILE_INFO
             125                     !------------------------------------------------------------------------------
             126                       INTEGER, PARAMETER :: max_dim_name = 32
             127                     !------------------------------------------------------------------------------
             128                       TYPE IO_dim
             129                         INTEGER                      :: dim_id   =   0      ! temporary NetCDF id
             130                         INTEGER                      :: var_id   =   0      ! temporary NetCDF id
             131                         INTEGER                      :: dim_len  =  -1
             132                         CHARACTER (len=max_dim_name) :: dim_name =  ''
             133                         CHARACTER (len=64)           :: longname =  ''
             134                         CHARACTER (len=32)           :: units    =  ''
             135                         INTEGER                      :: levtyp   =   0      ! GRIB level type
             136                         LOGICAL                      :: single   =  .FALSE. ! single level
             137                         REAL  ,POINTER           :: value(:) => NULL()
             138                       END TYPE IO_dim
             139                     !------------------------------------------------------------------------------
             140                       INTEGER       ,PARAMETER    :: max_dim_ids = 50
             141                       INTEGER                     :: IO_ndim_ids
             142                       TYPE (IO_dim) ,TARGET ,SAVE :: IO_dim_ids (max_dim_ids)
             143                     
             144                       INTEGER :: nfnlvl        ! =12, number of fine layers in sit for the uppermost ocean layer
             145                       INTEGER :: lkvl          ! =49, =ocn_k1+nfnlvl-3, i.e., lkvl=49, ocn_k1-2=lkvl+1-nfnlvl
             146                                                ! number of vertical levels of sit ocean model
             147                     !!!  INTEGER :: ocn_k1        != 40, number of ocean ocean levels
             148                       REAL, POINTER  :: ocn_z(:)
             149                       REAL, POINTER  :: diecast_zdepth(:),diecast_fluxdepth(:)     ! unit: m
             150                       REAL, POINTER  :: sit_zdepth(:),sit_fluxdepth(:)             ! unit: m
             151                       REAL, POINTER  :: sit_gribzdepth(:),sit_gribfluxdepth(:)     ! sit_gribzdepth (for grib format)! bjt

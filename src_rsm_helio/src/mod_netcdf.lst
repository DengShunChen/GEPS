             211                     !      IF (IO_dim_ids(indx)%dim_name(1:1) /= ' ') THEN
             212                     !        WRITE(nerr,*) 'IO_get_varindx', indx, IO_dim_ids(indx)%dim_name
             213                     !      END IF
             214                     !    END DO

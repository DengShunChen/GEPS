     1      1199                           parameter(ncbyte = 1)
     1      1200                           parameter(ncchar = 2)
     1      1201                           parameter(ncshort = 3)
     1      1202                           parameter(nclong = 4)
     1      1203                           parameter(ncfloat = 5)
     1      1204                           parameter(ncdouble = 6)
     1      1205                     
     1      1206                     !
     1      1207                     !     masks for the struct nc flag field; passed in as 'mode' arg to
     1      1208                     !     nccreate and ncopen.
     1      1209                     !
     1      1210                     
     1      1211                     !     read/write, 0 => readonly
     1      1212                           parameter(ncrdwr = 1)
     1      1213                     !     in create phase, cleared by ncendef
     1      1214                           parameter(nccreat = 2)
     1      1215                     !     on create destroy existing file
     1      1216                           parameter(ncexcl = 4)
     1      1217                     !     in define mode, cleared by ncendef
     1      1218                           parameter(ncindef = 8)
     1      1219                     !     synchronise numrecs on change (x'10')
     1      1220                           parameter(ncnsync = 16)
     1      1221                     !     synchronise whole header on change (x'20')
     1      1222                           parameter(nchsync = 32)
     1      1223                     !     numrecs has changed (x'40')
     1      1224                           parameter(ncndirty = 64)
     1      1225                     !     header info has changed (x'80')
     1      1226                           parameter(nchdirty = 128)
     1      1227                     !     prefill vars on endef and increase of record, the default behavior
     1      1228                           parameter(ncfill = 0)
     1      1229                     !     do not fill vars on endef and increase of record (x'100')
     1      1230                           parameter(ncnofill = 256)
     1      1231                     !     isa link (x'8000')
     1      1232                           parameter(nclink = 32768)
     1      1233                     
     1      1234                     !
     1      1235                     !     'mode' arguments for nccreate and ncopen
     1      1236                     !
     1      1237                           parameter(ncnowrit = 0)
     1      1238                           parameter(ncwrite = ncrdwr)
     1      1239                           parameter(ncclob = nf_clobber)
     1      1240                           parameter(ncnoclob = nf_noclobber)
     1      1241                     
     1      1242                     !
     1      1243                     !     'size' argument to ncdimdef for an unlimited dimension
     1      1244                     !
     1      1245                           integer ncunlim
     1      1246                           parameter(ncunlim = 0)
     1      1247                     
     1      1248                     !
     1      1249                     !     attribute id to put/get a global attribute
     1      1250                     !
     1      1251                           parameter(ncglobal  = 0)
     1      1252                     
     1      1253                     !
     1      1254                     !     advisory maximums:
     1      1255                     !
     1      1256                           parameter(maxncop = 64)
     1      1257                           parameter(maxncdim = 1024)
     1      1258                           parameter(maxncatt = 8192)
     1      1259                           parameter(maxncvar = 8192)
     1      1260                     !     not enforced
     1      1261                           parameter(maxncnam = 256)
     1      1262                           parameter(maxvdims = maxncdim)
     1      1263                     
     1      1264                     !
     1      1265                     !     global netcdf error status variable
     1      1266                     !     initialized in error.c
     1      1267                     !
     1      1268                     
     1      1269                     !     no error
     1      1270                           parameter(ncnoerr = nf_noerr)
     1      1271                     !     not a netcdf id
     1      1272                           parameter(ncebadid = nf_ebadid)
     1      1273                     !     too many netcdfs open
     1      1274                           parameter(ncenfile = -31)   ! nc_syserr
     1      1275                     !     netcdf file exists && ncnoclob
     1      1276                           parameter(nceexist = nf_eexist)
     1      1277                     !     invalid argument
     1      1278                           parameter(nceinval = nf_einval)
     1      1279                     !     write to read only
     1      1280                           parameter(nceperm = nf_eperm)
     1      1281                     !     operation not allowed in data mode
     1      1282                           parameter(ncenotin = nf_enotindefine )
     1      1283                     !     operation not allowed in define mode
     1      1284                           parameter(nceindef = nf_eindefine)
     1      1285                     !     coordinates out of domain
     1      1286                           parameter(ncecoord = nf_einvalcoords)
     1      1287                     !     maxncdims exceeded
     1      1288                           parameter(ncemaxds = nf_emaxdims)
     1      1289                     !     string match to name in use
     1      1290                           parameter(ncename = nf_enameinuse)
     1      1291                     !     attribute not found
     1      1292                           parameter(ncenoatt = nf_enotatt)
     1      1293                     !     maxncattrs exceeded
     1      1294                           parameter(ncemaxat = nf_emaxatts)
     1      1295                     !     not a netcdf data type
     1      1296                           parameter(ncebadty = nf_ebadtype)
     1      1297                     !     invalid dimension id
     1      1298                           parameter(ncebadd = nf_ebaddim)
     1      1299                     !     ncunlimited in the wrong index
     1      1300                           parameter(nceunlim = nf_eunlimpos)
     1      1301                     !     maxncvars exceeded
     1      1302                           parameter(ncemaxvs = nf_emaxvars)
     1      1303                     !     variable not found
     1      1304                           parameter(ncenotvr = nf_enotvar)
     1      1305                     !     action prohibited on ncglobal varid
     1      1306                           parameter(nceglob = nf_eglobal)
     1      1307                     !     not a netcdf file
     1      1308                           parameter(ncenotnc = nf_enotnc)
     1      1309                           parameter(ncests = nf_ests)
     1      1310                           parameter (ncentool = nf_emaxname)
     1      1311                           parameter(ncfoobar = 32)
     1      1312                           parameter(ncsyserr = -31)
     1      1313                     

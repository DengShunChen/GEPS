             163                     CONTAINS
             164                     !------------------------------------------------------------------------------
             165                       SUBROUTINE put_att (att, name, value)
             166                       TYPE (t_att_text) ,INTENT(inout) :: att(:)
             167                       CHARACTER (len=*) ,INTENT(in)    :: name
             168                       CHARACTER (len=*) ,INTENT(in)    :: value
             169                       !----------------------------------------------
             170                       ! store an attribute in the attribute data type
             171                       !----------------------------------------------
             172                         INTEGER :: i
             173     1                   DO i=1,SIZE(att)
             174     2                     IF (att(i)% name == '' .OR. att(i)% name == name) THEN
             175     2                       att(i)% name = name
             176     2                       att(i)% text = value
             177     2                       EXIT
             178     2                     ENDIF
             179     1                   END DO
             180                       END SUBROUTINE put_att

               1                           subroutine vterp (nx,my,lmaxp,lev,yr,f,yin,dout,tensy)
               2                     !
               3                     !          a bicubic spline interpolator to interpolate from a grid
               4                     !          with constant i (first dimension) grid spacing and variable
               5                     !          j (second dimension) grid spacing t0 a grid with
               6                     !          variable grid spacing. all grids are assumed to have point
               7                     !          (i,1) in the lower left corner with i increasing to the right
               8                     !          and j increasing upward.
               9                     !
              10                     ! **** input ****
              11                     !
              12                     !  nx: no. of points in e-w direction of input arrays
              13                     !  my: no. of points in n-s direction of input arrays
              14                     !  lmaxp: no. of levels in input arrays
              15                     !  lev: no. of levels in output arrays
              16                     !  yr: independent interpolation variable for input grid
              17                     !  f: dependent variable for input grid
              18                     !  yin: independent interpolation variable for output grid
              19                     !  tensy: cubic spline tension factor.
              20                     !
              21                     ! **** output ****
              22                     !
              23                     !  dout: dependent variable on output grid
              24                     !
              25                           use const, only: RTYPE
              26                     !
              27                           implicit  none
              28                     
              29                           integer   nx,my,lmaxp,lev
              30                     
              31                           real      f(nx,lmaxp,my),dout(nx*lev,my),yr(nx,lmaxp,my) &
              32                           , yin(nx*lev,my),tensy(lmaxp)
              33                     !
              34                     !sun  include '../include/paramt.h' .. change im,lm to nx,lev
              35                     !
              36                           real(kind=RTYPE) fxx(nx,lmaxp),fyy(nx,lmaxp),pjy(nx*lev*4),tp1(nx*lev*4)
              37                     
              38                           integer   ipt(nx*lev)
              39                     
              40                           integer   jym2,nxjym2,mn,j,ll,i,k,i1,i2,i3
              41                     !
              42                     !          compute ipt and pjy
              43                     !
              44                           jym2=lmaxp-2
              45                           nxjym2=nx*jym2
              46                           mn= nx*lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pjy, tp1, dout
                                   <<< Loop-information  End >>>
              47     1                     do 200 j=1,my
              48     1               !
              49     1                     call setupv(yr(1,1,j),yin(1,j),mn,nx,lmaxp,pjy,ipt,tp1)
              50     1               !
              51     1               !          compute fyy
              52     1               !
              53     1                     ll= nxjym2+nx
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      yr, fxx
                                   <<< Loop-information  End >>>
              54     2  pp   2v            do 110 i=1,ll
              55     2   p   2v            fxx(i,2)= yr(i,2,j)-yr(i,1,j)
              56     2   p   2v        110 continue
              57     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 373
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      f, fxx, fyy
                                   <<< Loop-information  End >>>
              58     2  pp    v            do 210 i=1,nxjym2
              59     2   p    v            fyy(i,2)= (fxx(i,3)*(f(i,1,j)-f(i,2,j))+fxx(i,2)*(f(i,3,j) &
              60     2                      -f(i,2,j)))/(fxx(i,3)*fxx(i,3)*fxx(i,2))
              61     2   p    v            fxx(i,2)= fxx(i,2)/fxx(i,3)
              62     2   p    v        210 continue
              63     1               !
              64     1               !      call trdivv(nx,jym2,fxx(1,2),tp1,fyy(1,2))
              65     1                     call trdivv(nx,jym2,fxx(1,2),fyy(1,2))
              66     1               !
                                   <<< Loop-information Start >>>

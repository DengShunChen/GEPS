                                   <<<      fyy
                                   <<< Loop-information  End >>>
              67     2  pp   2v            do 100 i=1,nx
              68     2   p   2v            fyy(i,1)= 0.0
              69     2   p   2v            fyy(i,lmaxp)=0.0
              70     2   p   2v        100 continue
              71     1               !
              72     1               !  apply tension
              73     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fyy
                                   <<< Loop-information  End >>>
              74     2  pp                 do 5 k=1,lmaxp
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fyy
                                   <<< Loop-information  End >>>
              75     3   p   2v            do 5 i=1,nx
              76     3   p   2v            fyy(i,k)= fyy(i,k)*tensy(k)
              77     2   p   2v          5 continue
              78     1               !
              79     1                     call gathv(mn,nx,lev,ipt,fyy,f(1,1,j),tp1)
              80     1               !
              81     1                     i1= mn
              82     1                     i2= mn*2
              83     1                     i3= mn*3
                                   <<< Loop-information Start >>>

                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tp1, pjy, dout
                                   <<< Loop-information  End >>>
              84     2  pp    v            do 130 i=1,mn
              85     2   p    v            dout(i,j)=tp1(i)*pjy(i)+tp1(i+i1)*pjy(i+i1)+tp1(i+i2)*pjy(i+i2) &
              86     2                      +tp1(i+i3)*pjy(i+i3)
              87     2   p    v        130 continue
              88     1                 200 continue
              89                           return
              90                           end


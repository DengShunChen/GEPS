               1                           subroutine rcmpsl2( ns,nx,lev,u0,as,ww1,ww2,ww,ttau,ffu,ffd )
               2                     !
               3                     ! **********************************************************************
               4                     ! The generalized two stream approximation for nonhomgeneous atmospheres
               5                     ! in  the  solar  wavelengths.
               6                     !
               7                     ! ++ input/output variables:
               8                     !    (1) input variables :
               9                     !        ns    : number of grid points to calculate sw flux
              10                     !        nx    : horizontal dimension of input array
              11                     !        lev   : number of vertical layers
              12                     !        u0    : cos(zenith angle)
              13                     !        as    : ground surface albedo
              14                     !        ww1~2 : first two coeff. of legendre polynomials for
              15                     !                the scattering phase function
              16                     !        ww    : single scattering albedo
              17                     !        ttau(lev+1) : total optical depth from top to reference level
              18                     !
              19                     !    (2) output variables :
              20                     !        ffu
              21                     !        ffd
              22                     !
              23                     ! ++ auther :
              24                     !    original : fu and liou (1992)
              25                     !    modified : c. t. fong (1996)
              26                     !
              27                     ! **********************************************************************
              28                     !
              29                           implicit  none
              30                           integer   ns,nx,lev
              31                           real      u0(nx),as(nx),ww1(nx*lev),ww2(nx*lev),ww(nx*lev), &
              32                                     ttau(nx*(lev+1))
              33                           real      ffu(nx*(lev+1)),ffd(nx*(lev+1))
              34                     !
              35                     !   local working arrays
              36                     !
              37                           real      w1(nx*lev),w(nx*lev),tau(nx*(lev+1))
              38                           real      lamdan(nx*lev),gamman(nx*lev),caddn(nx*lev)       &
              39                                    ,cminn(nx*lev),caddn0(nx*lev),cminn0(nx*lev)       &
              40                                    ,aa(nx*lev),bb(nx*lev),expn(nx*lev),g1g2n(nx*lev)  &
              41                                    ,ru0(nx*lev),u0t(nx*lev),sol(nx*(lev+1))
              42                           real      f(nx*lev),xn(nx*lev),yn(nx*lev),zn(nx*lev)
              43                           real      etri(nx,lev*2,4)
              44                           logical edding,quadra
              45                     
              46                           integer   nsn,nsn1,lev2,i,j,jk,jj
              47                           integer   j2n,j2n1,jje,jke,j2m1,j2m
              48                           real      sqrt3,rsqrt3,pi,f0,fw,x,y,z,gamma1,gamma2,gamma3,gamma4
              49                           real      ru0_mod,dtau,ssfc,wm1,wm2,xx
              50                     !
              51                           edding = .true.
              52                           quadra = .false.
              53                     !
              54                           nsn  = ns*lev
              55                           nsn1 = ns*(lev+1)
              56                           lev2 = lev*2
              57                           sqrt3= sqrt(3.)
              58                           rsqrt3= 1./sqrt3
              59                           pi   = 4.*atan(1.)
              60                           f0   = 1./pi
              61                     !
              62                     !fong01
              63                     ! incorporate a delta-function adjustment to account for the forward
              64                     ! diffraction  peak in the context of the two stream approximations.
              65                     ! w1(n),  w(n), and tau(n+1) are the adjusted parameters.
              66                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww2, f
                                   <<< Loop-information  End >>>
              67     1  pp   2v            do 6 i =1, nsn
              68     1   p   2v            f(i) = ww2(i) / 5.0
              69     1   p   2v          6 continue
              70                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.20, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sol, tau, u0
                                   <<< Loop-information  End >>>
              71     1  pp   2v            do 7 i = 1, ns
              72     1   p   2v            tau(i) = 0.
              73     1   p   2v            sol(i) = u0(i)
              74     1   p   2v          7 continue
              75                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 341
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.63, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      f, ww, ttau, ww1, w1, u0t, w
                                   <<< Loop-information  End >>>
              76     1  pp    v            do 10 i = 1, nsn
              77     1   p    v            fw = 1.0 - f(i) * ww(i)
              78     1   p    v            w1(i) = ( ww1(i) - 3.0 * f(i) ) / ( 1.0 - f(i) )
              79     1   p    v            w(i)  = ( 1.0 - f(i) ) * ww(i) / fw
              80     1   p    v            u0t(i) = (ttau(i+ns) - ttau(i)) * fw
              81     1   p    v         10 continue
              82                     !
              83     1                     do 12 j = 1, lev
              84     1                     jk = j*ns
              85     1                     jj = jk-ns
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      u0t, tau
                                   <<< Loop-information  End >>>
              86     2  pp   2v            do 12 i = 1, ns
              87     2   p   2v            tau(i+jk) = tau(i+jj) + u0t(i+jj)
              88     1   p   2v         12 continue
              89                     !fong01
              90                     !
              91                     !fong02
              92                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 208, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      w
                                   <<< Loop-information  End >>>
              93     1  pp   2v            do 20 i = 1, nsn
              94     1   p   2v            w(i) = min( w(i), 0.999999 )
              95     1   p   2v         20 continue
              96                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      u0, ru0, u0t
                                   <<< Loop-information  End >>>
              97     1                     do 22 j = 1, lev
              98     1                     jk = j*ns
              99     1                     jj = jk-ns
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.34, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      u0, ru0, u0t
                                   <<< Loop-information  End >>>
             100     2  pp   2v            do 22 i = 1, ns
             101     2   p   2v            u0t(i+jj) = u0(i)
             102     2   p   2v            ru0(i+jj) = 1./u0(i)
             103     1   p   2v         22 continue
             104                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.03, ITR: 72, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ru0, u0t, tau, sol
                                   <<< Loop-information  End >>>
             105     1  pp    v            do 25 i = 1, nsn
             106     1   p    v            sol(i+ns) = u0t(i) * exp( -tau(i+ns) * ru0(i) )
             107     1   p    v         25 continue
             108                     !
             109                     !
             110                     ! The following is used to calculate the Coefficients For Generalized
             111                     ! Two-Stream scheme.  We can make choices between Eddington, quadrature
             112                     ! and  hemispheric  mean  schemes  through  logical variables 'edding',
             113                     ! 'quadra', and 'hemisp'.  The  Eddington  and  quadrature  schemes are
             114                     ! discussed in detail by Liou (1992).  The  hemispheric  mean scheme is
             115                     ! derived by assuming that the phase function is equal to 1 + g in  the
             116                     ! forward scattering hemisphere and 1 - g  in  the  backward scattering
             117                     ! hemisphere where g is the asymmetry factor.   The hemispheric mean is
             118                     ! only used for infrared wavelengths (Toon et al. 1989).
             119                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 11
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      w1, w, tau, g1g2n, u0t, ru0, lamdan
                                   <<<      gamman, caddn0, cminn0, caddn, cminn
                                   <<< Loop-information  End >>>
             120     1  pp    v            do 40 i = 1, nsn
             121     1               !
             122     1               !fong02_1
             123     1               !cc   if ( edding ) then
             124     1   p    v      	   x = 0.25 * w1(i)     ! w1 = 3g
             125     1   p    v      	   y = w(i) * x
             126     1   p    v                 gamma1 = 1.75 - w(i) - y
             127     1   p    v      	   gamma2 = - 0.25 + w(i) - y
             128     1   p    v                 gamma3 = 0.5 - x * u0t(i)
             129     1   p    v                 gamma4 = 1.0 - gamma3
             130     1               !fong      ugts1 = 0.5
             131     1               !
             132     1               !cc   elseif ( quadra ) then
             133     1               !          x = 0.5*sqrt3 * w(i)
             134     1               !          y = 0.5*rsqrt3 * w1(i)  ! rsqrt3 = 1/sqrt3
             135     1               !          z = y * w(i)
             136     1               !          gamma1 = sqrt3 - x - z
             137     1               !          gamma2 = x - z
             138     1               !          gamma3 = 0.5 - y * u0t(i)
             139     1               !          gamma4 = 1.0 - gamma3
             140     1               !fong      ugts1 = rsqrt3
             141     1               !cc   endif
             142     1               !fong02_1
             143     1   p    v            lamdan(i) = exp( 0.5*log((gamma1 + gamma2)*(gamma1 - gamma2)) )
             144     1               !cc   lamdan(i) = sqrt((gamma1 + gamma2)*(gamma1 - gamma2))
             145     1   p    v            gamman(i) = gamma2 / ( gamma1 + lamdan(i) )
             146     1   p    v            g1g2n(i) = gamma1 + gamma2
             147     1   p    v            fw = pi * f0 * w(i) * exp ( - ru0(i) * tau(i) )
             148     1   p    v            x = exp ( - ru0(i) * ( tau(i+ns)-tau(i) ) )
             149     1   p    v            z = lamdan(i) * lamdan(i) - ru0(i) * ru0(i)
             150     2   p    v            if(abs(z).lt.0.000001)then
             151     2   p    v             ru0_mod=1./(u0t(i)+0.01*u0t(i))
             152     2   p    v             z = lamdan(i) * lamdan(i) - ru0_mod * ru0_mod
             153     2   p    v            end if
             154     1   p    v            caddn0(i) = fw * ( ( gamma1 - ru0(i) ) * gamma3 +  &
             155     1                                    gamma4 * gamma2 ) / z
             156     1   p    v            cminn0(i) = fw * ( ( gamma1 + ru0(i) ) * gamma4 +  &
             157     1                                    gamma3 * gamma2 ) / z
             158     1   p    v            caddn(i) = caddn0(i) * x
             159     1   p    v            cminn(i) = cminn0(i) * x
             160     1   p    v         40 continue
             161                     !fong02
             162                     !
             163                     !fong03
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 41
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.07, ITR: 64, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gamman, xn, lamdan, expn, yn, zn, tau
                                   <<< Loop-information  End >>>
             164     1  pp    v            do 50 i = 1, nsn
             165     1   p    v            dtau = tau(i+ns) - tau(i)
             166     1   p    v            expn(i) = exp ( - lamdan(i) * dtau )
             167     1   p    v            xn(i) = gamman(i) * expn(i)
             168     1   p    v            yn(i) = ( expn(i) - gamman(i) ) / ( xn(i) - 1.0 )
             169     1   p    v            zn(i) = ( expn(i) + gamman(i) ) / ( xn(i) + 1.0 )
             170     1   p    v         50 continue
             171                     !fong03
             172                     !
             173                     !fong04
             174                     !
             175                     !  etri : tridiagonal matrix for eq(39) in toon et al. (1989)
             176                     !  etri(i,k,m) : i=1,ns (horizontal grids), k=1,2*lev (vertical levels)
             177                     !                mm=1,4 (1:a, 2:b, 3:d, 4:e, a,b,d,e refer to eq(39))
             178                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cminn0, xn, etri
                                   <<< Loop-information  End >>>
             179     1  pp    v            do 110 i = 1, ns
             180     1   p    v            etri(i,1,1) = 0.0
             181     1   p    v            etri(i,1,2) = xn(i) + 1.0
             182     1   p    v            etri(i,1,3) = xn(i) - 1.0
             183     1   p    v            etri(i,1,4) = - cminn0(i)
             184     1   p    v        110 continue
             185                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      caddn, cminn, zn, caddn0, expn, gamman
                                   <<<      xn, cminn0, yn, etri
                                   <<<    PREFETCH(SOFT) : 16
                                   <<<     SEQUENTIAL : 16
                                   <<<      gamman: 4, etri: 12
                                   <<< Loop-information  End >>>
             186     1  pp                 do 150 j = 1, lev-1
             187     1   p                 jk = j*ns
             188     1   p                 jj = jk-ns
             189     1   p                 j2n = j+j
             190     1   p                 j2n1= j2n+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.79, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      caddn, caddn0, gamman, expn, cminn
                                   <<<      cminn0, xn, zn, etri, yn
                                   <<<    PREFETCH(SOFT) : 14
                                   <<<     SEQUENTIAL : 14
                                   <<<      etri: 12, gamman: 2
                                   <<< Loop-information  End >>>
             191     2   p    v            do 150 i = 1, ns
             192     2   p    v            etri(i,j2n,1) = 1.0+xn(i+jj)-yn(i+jk)*(gamman(i+jj)+expn(i+jj))
             193     2   p    v            etri(i,j2n,2) = 1.0-xn(i+jj)-yn(i+jk)*(gamman(i+jj)-expn(i+jj))
             194     2   p    v            etri(i,j2n,3) = yn(i+jk)*(1.0+xn(i+jk))-expn(i+jk)-gamman(i+jk)
             195     2   p    v            etri(i,j2n,4) = caddn0(i+jk)-caddn(i+jj)-yn(i+jk) *  &
             196     2                               ( cminn0(i+jk)-cminn(i+jj) )
             197     2   p    v            etri(i,j2n1,1) = gamman(i+jj)-expn(i+jj)-zn(i+jj)*(1.0-xn(i+jj))
             198     2   p    v            etri(i,j2n1,2) = -1.0-xn(i+jk)+zn(i+jj)*(expn(i+jk)+gamman(i+jk))
             199     2   p    v            etri(i,j2n1,3) = zn(i+jj)*(expn(i+jk)-gamman(i+jk))-xn(i+jk)+1.0
             200     2   p    v            etri(i,j2n1,4) = cminn0(i+jk)-cminn(i+jj)-zn(i+jj) *  &
             201     2                                ( caddn0(i+jk)-caddn(i+jj) )
             202     1   p    v        150 continue
             203                     !fong04
             204                     !
             205                     !fong05
             206                           jke = lev*ns
             207                           jje = jke-ns
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 39
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.38, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gamman, as, tau, u0, expn, xn, cminn
                                   <<<      caddn, etri
                                   <<< Loop-information  End >>>
             208     1  pp    v            do 170 i = 1, ns
             209     1   p    v            ssfc = pi * u0(i) * exp(-tau(i+jke)/u0(i)) * as(i) * f0
             210     1   p    v            wm1 = 1.0 - as(i) * gamman(i+jje)
             211     1   p    v            wm2 = xn(i+jje) - as(i) * expn(i+jje)
             212     1   p    v            etri(i,lev2,1) = wm1 + wm2
             213     1   p    v            etri(i,lev2,2) = wm1 - wm2
             214     1   p    v            etri(i,lev2,3) = 0.0
             215     1   p    v            etri(i,lev2,4) = as(i) * cminn(i+jje) - caddn(i+jje) + ssfc
             216     1   p    v        170 continue
             217                     !fong05
             218                     !
             219                     !fong06
             220                     !  solve a tridiagonal matrix using gaussian elimination
             221                     !

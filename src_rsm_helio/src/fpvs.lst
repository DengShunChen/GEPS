 External function subprogram "fpvs"
  (inc)(line-no.)(nest)(optimize)
               1                           function fpvs(t)
               2                     !
               3                     ! Abstract: Compute saturation vapor pressure from the temperature.
               4                     !   A linear interpolation is done between values in a lookup table
               5                     !   computed in gpvs. See documentation for fpvsx for details.
               6                     !   Input values outside table range are reset to table extrema.
               7                     !   The interpolation accuracy is almost 6 decimal places.
               8                     !   On the Cray, fpvs is about 4 times faster than exact calculation.
               9                     !   This function should be expanded inline in the calling routine.
              10                     !
              11                     !   Input argument list:
              12                     !       t              Real temperature in Kelvin
              13                     !
              14                     !   Output functio:
              15                     !       fpvs        Real saturation vapor pressure in Pascals
              16                     !
              17                           implicit none
              18                           real fpvs
              19                           real t
              20                           integer jx
              21                           real xj
              22                           integer nxpvs
              23                           real c1xpvs,c2xpvs,tbpvs
              24                           parameter(nxpvs=7501)
              25                           common/fpvscom/ c1xpvs,c2xpvs,tbpvs(nxpvs)
              26                     ! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
              27                           xj=min(max(c1xpvs+c2xpvs*t,1.),real(nxpvs))
              28                           jx=min(xj,nxpvs-1.)
              29                           fpvs=tbpvs(jx)+(xj-jx)*(tbpvs(jx+1)-tbpvs(jx))
              30                     ! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
              31                           end function


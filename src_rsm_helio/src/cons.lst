             746     3       f                   jytyp(ip,nc)=jytyp(1,nc)
             747     3       f                   tflat(0,ip,nc)=clattyp(nc)
             748     3       f                   tflon(0,ip,nc)=clontyp(nc)
             749     3       f                 enddo
             750     2                         if(myrank.eq.0)print*,' tflat = ',tflat(0,1:5,nc)
             751     2                         if(myrank.eq.0)print*,' tflon = ',tflon(0,1:5,nc)
             752     2                         if(myrank.eq.0)print*,' position at ix,jy= ',ix,jy
             753     2                         if(myrank.eq.0)print*,' position at tlat,tlon= ',tlat(jy) &
             754     2                                              ,  tlon(ix)

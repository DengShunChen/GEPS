             247     1                        print *,'******** aborting run, taui.ge.taue ******* '
             248     1                       stop
             249     1                     endif
             250                     
             251                     !
             252                     !  build pointer arrays for locating zonal and total wavenumber
             253                     !  values in the one-dimensional spherical harmonic arrays.
             254                     !
             255                     !  original allocation system only for spectral space
             256                     !
             257                           call sortml (jtrun,mlmax,msort,lsort,mlsort)
             258                     !
             259                     !  new allocation system in parallization for both spectral
             260                     !  and grid spaces
             261                     !
             262                     
             263                           call make_list
             264                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             265     1  pp                 do 150 m =1,mlistnum
             266     1   p                  mf=mlist(m)
             267     1               !
             268     1   p                  rm=mf-1
             269     1   p                  if (mf.eq.1)  rm= 0.0
             270     1   p                  cim(m) = rm
             271     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<< Loop-information  End >>>
             272     2   p    s            do 150 l=mf,jtrun
             273     2   p    v             rl = l
             274     2   p    v             rlm= rl-1.0
             275     2   p    v             if (mf.eq.1)  rm= 0.0
             276     2   p    v             eps4(l,m)= rl*rlm/radsq
             277     3   p    s             if ( l.eq.1 ) then
             278     3   p    m              wdfac(1,m) = 0. ; wcfac(1,m) = 0.
             279     3   p    s             else
             280     3   p    s              wdfac(l,m) = 1.0/(radsq*eps4(l,m))
             281     3   p    s              wcfac(l,m) = cim(m)*wdfac(l,m)
             282     3   p    v             endif
             283     1   p    v        150 continue
             284                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      aki, bki, sigma
                                   <<< Loop-information  End >>>
             285     1  pp   2v            do k=1,lev+1
             286     1   p   2v              sigma(k,1) = bki(k)
             287     1   p   2v              sigma(k,2) = aki(k)
             288     1   p   2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 72, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma, dsigma
                                   <<< Loop-information  End >>>
             289     1  pp    v            do k=1,lev
             290     1   p    v              dsigma(k,1) = sigma(k+1,1) - sigma(k,1)
             291     1   p    v              dsigma(k,2) = sigma(k+1,2) - sigma(k,2)
             292     1   p    v            enddo
             293                     !--------------------------------------------------------------------------
             294                     !   for rrtmg
             295                     !--------------------------------------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 176, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma, si
                                   <<< Loop-information  End >>>
             296     1  pp   2v            do k=1,lev+1
             297     1   p   2v               si(lev+2-k)=sigma(k,1)+sigma(k,2)/1000.
             298     1   p   2v            enddo
             299                     !--------------------------------------------------------------------------
             300                     !     build matrices for semi-implicit and normal mode initialization
             301                     !
             302                            call matrix_hybrid_cwb ( cp,sigma,dsigma,ptop,ptmean,tmean,spalm &
             303                                       , eigval,evecin,evectr,arrhyd,arsddt,pmcor,tmcor )
             304                     !
             305                     !  gaussian quadrature weights and latitudes
             306                     !
             307                           one = 1.0
             308                           onem= -one
             309                           call gausl3 (my,onem,one,weight,sinl)
             310                     !
             311                           my2= my/2
             312                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.33, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sinl, onocos, weight, cosl
                                   <<< Loop-information  End >>>
             313     1   s    s            do 180 j = 1, my2
             314     1   s    s            sinl(my+1-j)  = -sinl(j)
             315     1   s    s            weight(my+1-j)= weight(j)
             316     1   m    m            onocos(j)     = 1.0/(1.0-sinl(j)*sinl(j))
             317     1   s    s            onocos(my+1-j)= onocos(j)
             318     1   m    m            cosl(j)       = 1.0/sqrt(onocos(j))
             319     1   s    s            cosl(my+1-j)  = cosl(j)
             320     1   p    v        180 continue
             321                     !  define ndslfv
             322                     !
             323                           call ndslfv_init(nx,my,ncld,cosl,weight(1))
             324                     !
             325                     !  horizontal diffusion settings for sponge layer
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma
                                   <<< Loop-information  End >>>
             326     1   s    v            do k = 1, lev
             327     1   p    v              prslp=sigma(k,2)+sigma(k,1)*1000.+ptop
             328     1   p    v              if ( prslp .le. spl1  ) hdk1=k
             329     1   p    v              if ( prslp .le. spl2  ) hdk2(1)=k
             330     1   p    v              if ( prslp .le. 200.  ) hdk2(2)=k
             331     1   p    v              if ( prslp .le. 400.  ) hdk2(3)=k
             332     1   p    v            enddo
             333                     !
             334                     !
             335                     !  define coriolis parameter for each latitude
             336                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sinl, cor
                                   <<< Loop-information  End >>>
             337     1  pp   2v            do 190 j=1,my
             338     1   p   2v            cor(j)= 2.0*omega*sinl(j)
             339     1   p   2v        190 continue
             340                     !
             341                           r2d=180./pi
             342     1                     if( numreduce.gt.0 ) then
             343     1                       lreduce=1
             344     1                       pnm_max=0.0
             345     2                       do j=1,my2

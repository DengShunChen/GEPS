             196                                                        ,ii
             197                     !-----------------------------------------------------------------------
             198                     !
             199                           call days (cdtg,julian,hours)
             200                     !
             201                           flag =.false.
             202     1                     if(myrank .eq. 0)then
             203     1                       call recmsg('gfs',ifromtau,itotau,istat)

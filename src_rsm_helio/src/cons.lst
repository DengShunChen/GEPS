             216     1                     endif
             217                     !
             218                     !ch   call mpe_broadcast(ifromtau,1,flag,mpe_integer)
             219                     !ch   call mpe_broadcast(itotau,1,flag,mpe_integer)
             220                           call mpe_bcast(ifromtau,1,0,mpe_integer)
             221                           call mpe_bcast(itotau,1,0,mpe_integer)
             222                     !
             223                           taui=float(ifromtau)

             736     2                         jytyp(1,nc)=(clat-tlat(1))/(180./my)+1.005
             737     2               !          nxj=nxdef(jytyp(1,nc))
             738     2                         nxj=nx        ! findtrack do in full grid
             739     2                         ixtyp(1,nc)=clontyp(nc)/(360./nxj)+1.005
             740     2                         ix=ixtyp(1,nc)
             741     2                         jy=jytyp(1,nc)
             742     2                         tflat(0,1,nc)=clattyp(nc)
             743     2                         tflon(0,1,nc)=clontyp(nc)

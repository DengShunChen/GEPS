 External subroutine subprogram "nor_gwdp"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine nor_gwdp(j,nxj,nx,lev,u,v,t,q,plt,pk,pk2,hi,dt,grav,rgas,sinl &
               2                           ,                   cosl,avgdrag_u,avgdrag_v,cp,ptop)
               3                     !
               4                     ! reference : Scinocca(2002,2003) JAS and Andrew Orr(2010) J. of Climate
               5                     !
               6                     !---- input:
               7                     !---- nxj    : number of point in lontitude of reduced gauslian grid.
               8                     !---- nx     : dimension of lontitude.
               9                     !---- lev    : dimension of vertical.
              10                     !---- dt     : 2.*dt dt: time step of model integration
              11                     !---- grav   : gravity of earth
              12                     !     rgas   : dry gas constant (=287.)
              13                     !---- sinl   : sin of latitude
              14                     !     t     : temperature  (k)
              15                     !     q     : specific humidity (kg/kg)
              16                     !     plt   : pressure at odd-level (mb)
              17                     !     pk    : p**kcapa at odd-level ((=p/1000.)**0.286)
              18                     !     pk2   : p**kcapa at even-level ((=p/1000.)**0.286)
              19                     !     hi    : geopotential height (m2/s2)
              20                     !---- u      : velocity of x-component
              21                     !---- v      : velocity of y-component
              22                     !---- output:
              23                     !---  u,v
              24                     !-----------------------------------------
              25                     !---- den    : density of atmosphere
              26                     !---- sn2    : Brunt-Vasisla frequency
              27                     !---- p2     : pressure at even-level (mb)
              28                     !---- nc        : number of spectral elements of the gravity wave phase speed.
              29                     !---- nphi      : number of azimuths of the gravity waves.
              30                     !---- cmin      : minimun phase speed of the gravity waves(m/s).
              31                     !---- cmax      : the maximun phase speed of the gravity waves(m/s).
              32                     !---- taul      : constant=0.6 s/m
              33                     !---- cstar     : constant=1.
              34                     !---- pw        : constant=1.5 exponent power of gravity wave frequency
              35                     !---- s         : constant=1. low-m exponent
              36                     !---- lunch_lev     : lunch level of gravity wave
              37                     !---- wavelenth : characteric vertical wave-length
              38                     !---- fluxtoatl : total lunch E-P flux in each nc direction
              39                     !
              40                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
              41                     !
              42                     
              43                     !ch>
              44                           use index, only : nxdef
              45                           use const, only : RTYPE
              46                     !ch<
              47                     
              48                           implicit  none
              49                     
              50                           integer   j,nxj,nx,lev
              51                           real      dt,grav,rgas,sinl,cosl,cp
              52                     
              53                           real      plt(nx,lev),                                  &
              54                                     avgdrag_u(lev),avgdrag_v(lev)
              55                           real(kind=RTYPE) u(nx,lev),v(nx,lev),t(nx,lev),         &
              56                                            q(nx,lev),hi(nx,lev),pk(nx,lev),       &
              57                                            pk2(nx,lev)
              58                     
              59                     ! local array
              60                           integer,  parameter :: nc=20,nphi=4
              61                           real      p2(nx,lev),den(nx,lev),sn2(nx,lev),pt(nx,lev)
              62                           real      fluxsat(nc,nx,lev,nphi),flux(nc,nx,lev,nphi),dflux(nx,lev,nphi),&
              63                                     fluxsat_nc(nx,lev,nphi),flux_nc(nx,lev,nphi),           &
              64                                     dflux_u(nx,lev),dflux_v(nx,lev),                        &
              65                                     a(nx),cn(nc),uv_lunch(nx,nphi),uv(nx,lev,nphi),         &
              66                                     fxin(nc,nphi),fxout(nc),drag_u(nx,lev),drag_v(nx,lev)
              67                           real      mstar
              68                     !
              69                           integer   ilon,jlat,kk,lunch_lev,ltop,i,k,nc1,n,nn,ndir
              70                           real      cmin,cmax,taul,cstar,pw,s,wavelenth,fluxtotal,ptop
              71                           real      pi,omega,acor,cor,wtcosl,dz1,s1,s2,p,corp,xmin,xmax
              72                           real      b1,b2,dc,xbar,x,s3,uhat,fxtotal,chat,flux1,flux2,dflux1
              73                           real      uhat_z0,uhat_z1,dpk,wsold,wsnew
              74                     
              75                           data cmin/0.25/, cmax/2000./ taul/0.6/
              76                           data cstar/1./, pw/1./, s/1./, wavelenth/2000./
              77                           data fluxtotal/3.75e-4/, lunch_lev/44/, ltop/1/
              78                     !
              79                           ilon=1142
              80                           jlat=nx/4
              81                           kk=31
              82                     !
              83                           pi=4.*atan(1.)
              84                           omega=7.292e-5
              85                           cor=2.*omega*sinl
              86                           acor=abs(cor)
              87                     !
              88                     !ch   wtcosl=nxj*cosl
              89                           wtcosl=nxdef(j)*cosl
              90                     !
              91                     ! ... pressure at even-level (p2)
              92                     ! ... potential temperature (pt)
              93                     ! ... density (den)
              94                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, t, plt, pk, q, den, pt, p2
                                   <<< Loop-information  End >>>
              95     1  pp                 do k=1,lunch_lev+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.34, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, plt, pk, q, pk2, den, pt, p2
                                   <<< Loop-information  End >>>
              96     2   p    v            do i=1,nxj
              97     2   p    v              p2(i,k)=1000.0*pk2(i,k)*pk2(i,k)*pk2(i,k)*sqrt(pk2(i,k))
              98     2   p    v              pt(i,k)=t(i,k)*(1.0+0.608*q(i,k))/pk(i,k)
              99     2   p    v              den(i,k)=plt(i,k)*100./(rgas*t(i,k))
             100     2   p    v            enddo
             101     1   p                 enddo
             102                     !
             103                     ! ... brunt-vaisala frequency (sn2)
             104                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hi, pt, sn2
                                   <<< Loop-information  End >>>
             105     1  pp                 do k=1,lunch_lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hi, pt, sn2
                                   <<< Loop-information  End >>>
             106     2   p    v            do i=1,nxj
             107     2   p    v              dz1=(hi(i,k)-hi(i,k+1))/grav
             108     2   p    v              s1=pt(i,k)-pt(i,k+1)
             109     2   p    v              s2=(pt(i,k)+pt(i,k+1))/2.
             110     2   p    v              sn2(i,k)=grav*s1/(s2*dz1)
             111     2   p    v              if(sn2(i,k) .le. acor)sn2(i,k)=acor
             112     2   p    v            enddo
             113     1   p                 enddo
             114                     !      do i=1,nxj
             115                     !        sn2(i,lev)=sn2(i,lev-1)
             116                     !      enddo
             117                     !      if(j.eq.jlat)then
             118                     !          call findmaxf(nxj,nx,lev,sn2,vmax,iv,kv,vmin,ivm,kvm)
             119                     !          print *,' sn2=',vmax,iv,kv,' vmin=',vmin,ivm,kvm
             120                     !          call findmaxf(nxj,nx,lev,den,vmax,iv,kv,vmin,ivm,kvm)
             121                     !          print *,' den=',vmax,iv,kv,' vmin=',vmin,ivm,kvm
             122                     !      endif
             123                     !
             124                     !  coefficient of A(indepedent of height) in eq-(4) (Orr,2010)
             125                     !
             126                           mstar=2.*pi/wavelenth
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a
                                   <<< Loop-information  End >>>
             127        pp   4v            a=0.
             128                           p=2.-pw
             129                           corp=acor**p
             130                     !      if(j.eq.jlat)print *,'mstar,p,cor,corp=',mstar,p,cor,corp
             131                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a, sn2
                                   <<< Loop-information  End >>>
             132     1  pp   2v            do i=1,nxj
             133     1   p   2v              a(i)=cstar*mstar**3*(sn2(i,lunch_lev)**p-corp)/p
             134     1   p   2v              if(a(i).le.0.)a(i)=0.
             135     1   p   2v            enddo
             136                     !      if(j.eq.jlat)then
             137                     !          call findmaxf(nxj,nx,1,a,vmax,iv,kv,vmin,ivm,kvm)
             138                     !          print *,' a=',vmax,iv,kv,' vmin=',vmin,ivm,kvm
             139                     !      endif
             140                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uv_lunch
                                   <<< Loop-information  End >>>
             141        pp   4v            uv_lunch=0.
             142                           k=lunch_lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.33, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uv, uv_lunch, v, u
                                   <<< Loop-information  End >>>
             143     1  pp    v            do i=1,nxj
             144     1   p    v              uv_lunch(i,1)=u(i,k)
             145     1   p    v              uv_lunch(i,2)=u(i,k)
             146     1   p    v              uv_lunch(i,3)=v(i,k)
             147     1   p    v              uv_lunch(i,4)=v(i,k)
             148     1   p    v              uv(i,k,1)=uv_lunch(i,1)
             149     1   p    v              uv(i,k,2)=uv_lunch(i,2)
             150     1   p    v              uv(i,k,3)=uv_lunch(i,3)
             151     1   p    v              uv(i,k,4)=uv_lunch(i,4)
             152     1   p    v            enddo
             153                     !      if(j.eq.jlat)then
             154                     !        do nn=1,nphi
             155                     !          print *,' lunch nn,u,v=',nn,uv_lunch(ilon,nn)
             156                     !        enddo
             157                     !      endif
             158                     !
             159                     ! do coordinate stretch, eq-(28),(29),(30) (Scinocca,2003)
             160                     ! cn: transformed wave phase speed
             161                     !
             162                           xmin=1./cmin
             163                           xmax=1./cmax
             164                           b1=(xmax-xmin)/(exp((xmax-xmin)/taul)-1)
             165                           b2=xmin-b1
             166                     !
             167                           dc=xmax-xmin
             168                           nc1=nc-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 43
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             169     1   s   fv            do n=1,nc
             170     1   p   fv              xbar=xmin+dc*(n-1)/nc1
             171     1   p   fv              x=b1*exp((xbar-xmin)/taul)+b2
             172     1   p   fv              cn(n)=1./x
             173     1   p   fv            enddo
             174                     !
             175                     !      if(j.eq.jlat)then
             176                     !          print *,' b1,b2=',b1,b2
             177                     !          print *,' cn=',(cn(n),n=1,nc)
             178                     !      endif
             179                     !
             180                           s3=s+3
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 181,183)
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flux, dflux, fluxsat_nc, flux_nc
                                   <<<      fluxsat
                                   <<< Loop-information  End >>>
             181        pp   2v            fluxsat=0.
             182         p   2v            flux=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             183         p                 dflux=0.
             184         p                 fluxsat_nc=0.
             185         p                 flux_nc=0.
             186                     !
             187                     !  for lunch level, assign fluxtotal value to spectral flux density and
             188                     !  saturate flux density and assign u,v at lunch  level to variable 'uv'
             189                     !  for pw=1,p=2-pw=1 and uhat=0, the formula of flux density is simply rewriten.
             190                     !
             191                           k=lunch_lev
             192                           uhat=0.
             193     1                     do nn=1,nphi
             194     1                       ndir=1.
             195     1                       if(nn.eq.2 .or. nn.eq.4)ndir=-1.
             196     1                       fxtotal=fluxtotal*ndir
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sn2, den, a, fluxsat, flux_nc
                                   <<<      fluxsat_nc, flux
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 5
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             197     2                       do i=1,nxj
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             198     3   s   fv                do n=1,nc
             199     3   p   fv                  chat=cn(n)*ndir
             200     3   p   fv                  flux1=cstar*den(i,k)*a(i)*(chat-uhat)/sn2(i,k) &
             201     3               !    &           *abs((chat-uhat)/chat)**p
             202     3                                *abs((chat-uhat)/chat)
             203     3   p   fv                  flux2=1./(1.+(mstar*(chat-uhat)/sn2(i,k))**s3)
             204     3   p   fv                  fluxsat(n,i,k,nn)=flux1
             205     3   p   fv                  fxin(n,nn)=flux1*flux2
             206     3   p   fv                enddo
             207     2               !
             208     2               !          if(j.eq.jlat .and. i.eq.ilon)then
             209     2               !          if(nn.eq.1)then
             210     2               !            print *,'bef norm fxin at lunch=',(fxin(n,nn),n=1,nc)
             211     2               !          endif
             212     2               !          endif
             213     2               !
             214     2                         call normalize(fxtotal,nc,fxin(1,nn),flux(1,i,k,nn))
             215     2               !
             216     2               !          if(j.eq.jlat .and. i.eq.ilon)then
             217     2               !          if(nn.eq.1)then
             218     2               !            print *,'aft norm fxin at lunch=',(flux(n,i,k,nn),n=1,nc)
             219     2               !          endif
             220     2               !          endif
             221     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             222     3   s   fv                do n=1,nc
             223     3   p   fv                  fluxsat_nc(i,k,nn)=fluxsat_nc(i,k,nn)+fluxsat(n,i,k,nn)
             224     3   p   fv                  flux_nc(i,k,nn)=flux_nc(i,k,nn)+flux(n,i,k,nn)
             225     3   p   fv                enddo
             226     2                       enddo
             227     1                     enddo
             228                     !
             229                     !CWB2015 turn off for reproducible
             230                     !!$omp  parallel do default(none) &
             231                     !!$omp  private(nn,ndir,k,i,uv,uhat_z1,uhat_z0,n,chat,flux1,flux2,   &
             232                     !!$omp  fxout,dflux1,fxtotal) &
             233                     !!$omp  shared(ltop,lunch_lev,nxj,p,fxin, &
             234                     !!$omp  u,v,uv_lunch,cn,cstar,den,a,sn2,s3,mstar,fluxsat,flux,dflux, &
             235                     !!$omp  fluxsat_nc,flux_nc)
             236     1                     do nn=1,nphi
             237     1                       ndir=1.
             238     1                       if(nn.eq.2 .or. nn.eq.4)ndir=-1.
             239     2                       do k=lunch_lev-1,ltop,-1
             240     3                         do i=1,nxj
             241     3                           uv(i,k,1)=u(i,k)
             242     3                           uv(i,k,2)=u(i,k)
             243     3                           uv(i,k,3)=v(i,k)
             244     3                           uv(i,k,4)=v(i,k)
             245     3               !
             246     3               ! compute spectral flux(eq-4) and saturated spectral flux(eq-6) Orr(2010)
             247     3               ! uhat_z1: upper level, uhat_z0: below level.
             248     3               ! for pw=1,p=2-pw=1, the formula of flux density is simply rewriten.
             249     3               !
             250     3                           uhat_z1=uv(i,k,nn)-uv_lunch(i,nn)
             251     3                           uhat_z0=uv(i,k+1,nn)-uv_lunch(i,nn)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 458
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             252     4   s   fv                  do n=1,nc

 External subroutine subprogram "findmaxf"
  (inc)(line-no.)(nest)(optimize)
             395                     !
             396                           subroutine findmaxf(nxj,nx,lev,f,fmax,i1,k1,fmin,i1m,k1m)
             397                           implicit  none
             398                           integer   nxj,nx,lev,i1,k1,i1m,k1m
             399                           real      f(nx,lev),fmax,fmin
             400                           integer   k,i
             401                     
             402                           fmax=-99999.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
             403     1  pp                 do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      f
                                   <<< Loop-information  End >>>
             404     2   p   4s              do i=1,nxj
             405     3   p   4v                if(f(i,k).ge.fmax)then
             406     3   p   4s                  fmax=f(i,k)
             407     3   p   4m                  i1=i
             408     3   p   4v                  k1=k
             409     3   p   4m                endif
             410     2   p   4s              enddo
             411     1   p                 enddo
             412                           fmin=99999.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
             413     1  pp                 do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      f
                                   <<< Loop-information  End >>>
             414     2   p   4s              do i=1,nxj
             415     3   p   4v                if(f(i,k).le.fmin)then
             416     3   p   4s                  fmin=f(i,k)
             417     3   p   4m                  i1m=i
             418     3   p   4v                  k1m=k
             419     3   p   4m                endif
             420     2   p   4s              enddo
             421     1   p                 enddo
             422                           return
             423                           end


 External subroutine subprogram "W3FS26"
  (inc)(line-no.)(nest)(optimize)
               1                            SUBROUTINE W3FS26(JLDAYN,IYEAR,MONTH,IDAY,IDAYWK,IDAYYR)
               2                     !$$$   SUBPROGRAM  DOCUMENTATION  BLOCK
               3                     !
               4                     ! SUBPROGRAM: W3FS26         YEAR, MONTH, DAY FROM JULIAN DAY NUMBER
               5                     !   AUTHOR: JONES,R.E.       ORG: W342       DATE: 87-03-29
               6                     !
               7                     ! ABSTRACT: COMPUTES YEAR (4 DIGITS), MONTH, DAY, DAY OF WEEK, DAY
               8                     !   OF YEAR FROM JULIAN DAY NUMBER. THIS SUBROUTINE WILL WORK
               9                     !   FROM 1583 A.D. TO 3300 A.D.
              10                     !
              11                     ! PROGRAM HISTORY LOG:
              12                     !   87-03-29  R.E.JONES
              13                     !   89-10-25  R.E.JONES   CONVERT TO CRAY CFT77 FORTRAN
              14                     !
              15                     ! USAGE:  CALL W3FS26(JLDAYN,IYEAR,MONTH,IDAY,IDAYWK,IDAYYR)
              16                     !
              17                     !   INPUT VARIABLES:
              18                     !     NAMES  INTERFACE DESCRIPTION OF VARIABLES AND TYPES
              19                     !     ------ --------- -----------------------------------------------
              20                     !     JLDAYN ARG LIST  INTEGER   JULIAN DAY NUMBER
              21                     !
              22                     !   OUTPUT VARIABLES:
              23                     !     NAMES  INTERFACE DESCRIPTION OF VARIABLES AND TYPES
              24                     !     ------ --------- -----------------------------------------------
              25                     !     IYEAR  ARG LIST  INTEGER   YEAR  (4 DIGITS)
              26                     !     MONTH  ARG LIST  INTEGER   MONTH
              27                     !     IDAY   ARG LIST  INTEGER   DAY
              28                     !     IDAYWK ARG LIST  INTEGER   DAY OF WEEK (1 IS SUNDAY, 7 IS SAT)
              29                     !     IDAYYR ARG LIST  INTEGER   DAY OF YEAR (1 TO 366)
              30                     !
              31                     !   REMARKS: A JULIAN DAY NUMBER CAN BE COMPUTED BY USING ONE OF THE
              32                     !     FOLLOWING STATEMENT FUNCTIONS. A DAY OF WEEK CAN BE COMPUTED
              33                     !     FROM THE JULIAN DAY NUMBER. A DAY OF YEAR CAN BE COMPUTED FROM
              34                     !     A JULIAN DAY NUMBER AND YEAR.
              35                     !
              36                     !      IYEAR (4 DIGITS)
              37                     !
              38                     !      JDN(IYEAR,MONTH,IDAY) = IDAY - 32075
              39                     !    &            + 1461 * (IYEAR + 4800 + (MONTH - 14) / 12) / 4
              40                     !    &            + 367 * (MONTH - 2 - (MONTH -14) / 12 * 12) / 12
              41                     !    &            - 3 * ((IYEAR + 4900 + (MONTH - 14) / 12) / 100) / 4
              42                     !
              43                     !      IYR (4 DIGITS) , IDYR(1-366) DAY OF YEAR
              44                     !
              45                     !      JULIAN(IYR,IDYR) = -31739 + 1461 * (IYR + 4799) / 4
              46                     !    &                    -3 * ((IYR + 4899) / 100) / 4 + IDYR
              47                     !
              48                     !      DAY OF WEEK FROM JULIAN DAY NUMBER, 1 IS SUNDAY, 7 IS SATURDAY.
              49                     !
              50                     !      JDAYWK(JLDAYN) = MOD((JLDAYN + 1),7) + 1
              51                     !
              52                     !      DAY OF YEAR FROM JULIAN DAY NUMBER AND 4 DIGIT YEAR.
              53                     !
              54                     !      JDAYYR(JLDAYN,IYEAR) = JLDAYN -
              55                     !     &  (-31739+1461*(IYEAR+4799)/4-3*((IYEAR+4899)/100)/4)
              56                     !
              57                     !      THE FIRST FUNCTION WAS IN A LETTER TO THE EDITOR COMMUNICATIONS
              58                     !      OF THE ACM  VOLUME 11 / NUMBER 10 / OCTOBER, 1968. THE 2ND
              59                     !      FUNCTION WAS DERIVED FROM THE FIRST. THIS SUBROUTINE WAS ALSO
              60                     !      INCLUDED IN THE SAME LETTER. JULIAN DAY NUMBER 1 IS
              61                     !      JAN 1,4713 B.C. A JULIAN DAY NUMBER CAN BE USED TO REPLACE A
              62                     !      DAY OF CENTURY, THIS WILL TAKE CARE OF THE DATE PROBLEM IN
              63                     !      THE YEAR 2000, OR REDUCE PROGRAM CHANGES TO ONE LINE CHANGE
              64                     !      OF 1900 TO 2000. JULIAN DAY NUMBERS CAN BE USED FOR FINDING
              65                     !      RECORD NUMBERS IN AN ARCHIVE OR DAY OF WEEK, OR DAY OF YEAR.
              66                     !
              67                     ! ATTRIBUTES:
              68                     !   LANGUAGE: CRAY CFT77 FORTRAN
              69                     !   MACHINE:  CRAY Y-MP8/864
              70                     !
              71                     !$$$
              72                     !
              73                            implicit  none
              74                     
              75                            integer i,j,l,n,jldayn,iday,month,iyear,idaywk,idayyr
              76                     
              77                            L      = JLDAYN + 68569
              78                            N      = 4 * L / 146097
              79                            L      = L - (146097 * N + 3) / 4
              80                            I      = 4000 * (L + 1) / 1461001
              81                            L      = L - 1461 * I / 4 + 31
              82                            J      = 80 * L / 2447
              83                            IDAY   = L - 2447 * J / 80
              84                            L      = J / 11
              85                            MONTH  = J + 2 - 12 * L
              86                            IYEAR  = 100 * (N - 49) + I + L
              87                            IDAYWK = MOD((JLDAYN + 1),7) + 1
              88                            IDAYYR = JLDAYN -                                             &
              89                             (-31739 +1461 * (IYEAR+4799) / 4 - 3 * ((IYEAR+4899)/100)/4)
              90                            RETURN
              91                            END


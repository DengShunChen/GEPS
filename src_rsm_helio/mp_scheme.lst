                                   <<< Loop-information  End >>>
             474     4   p    v                  do i = 1, nxj
             475     4   p    v                    re_cloud(i,k)   = rew(i,kc)   !(micron)
             476     4   p    v                    re_ice(i,k)     = rei(i,kc)   !(micron)
             477     4   p    v                    re_rain(i,k)    = rer(i,kc)   !(micron)
             478     4   p    v                    re_snow(i,k)    = res(i,kc)   !(micron)
             479     4   p    v                    re_graupel(i,k) = reg(i,kc)   !(micron)

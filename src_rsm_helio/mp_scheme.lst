             447     3   p    v                  qt(i,(ntgl-1)*lev+k) = qg2(i,k)
             448     3   p    v                  tt(i,k)  = pt(i,1,k)  + pt_dt(i,1,k) * dta
             449     3   p    v                  ut(i,k)  = uin(i,1,k) + udt(i,1,k)   * dta
             450     3   p    v                  vt(i,k)  = vin(i,1,k) + vdt(i,1,k)   * dta
             451     3               
             452     4   p    v                  if ( sedi_w ) then
             453     4   p    v                    dot(i,k) = -w(i,1,k)*prsl(i,k)*con_g/con_rd               &
             454     4                                         /((1+con_fvirt*qt(i,k))*tt(i,k))
             455     4   p    v                    sd(i,k+1)= dot(i,k)/100./0.5-sd(i,k)
             456     4   p    v                  endif
             457     3               
             458     4   p    v                  if ( effr_in ) then
             459     4   p    v                    rho(i,k) = 0.622*prsl(i,k)                                &
             460     4                                        /( con_rd*tt(i,k)*(qt(i,k)+0.622) ) !air density (kg/m^3)
             461     4   p    v                  endif
             462     3   p    v                enddo
             463     2                       enddo

               1                     !--------------------------
               2                           subroutine mp_init                                               &
               3                     !--------------------------
               4                     !  ---  inputs:
               5                                ( nmmiph ,myrank)
               6                     !  ---  outputs: ( none )
               7                     
               8                     ! for WSM6
               9                           use module_mp_wsm6,     only : wsm6init
              10                     ! for Thompson
              11                           use module_mp_thompson, only : thompson_init
              12                     ! for GFDLMP
              13                     #if defined (GFDLMP_v2)
              14                           use module_mp_gfdl_v2,  only : gfdl_cld_mp_init
              15                     #else
              16                           use module_mp_gfdl,     only : gfdl_cloud_microphys_init
              17                     #endif
              18                     
              19                           implicit none
              20                     !  ---  input:
              21                           integer,  intent(in) :: nmmiph,myrank
              22                     !  ---  local:
              23                           integer   ntrac_req
              24                     !-----------------------------------------------------------------------
              25                     !  for cloud microphysics
              26                     !-----------------------------------------------------------------------
              27                     ! WSM6
              28     1                       if ( nmmiph .eq. 6 ) then
              29     1                         call wsm6init()
              30     1                         if ( myrank .eq. 0 )                                         &
              31     1                            print *,'WSM6 cloud microphysics initialized'

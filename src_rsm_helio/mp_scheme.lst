              37     1                            print *,'Thompson cloud microphysics initialized'
              38     1                       endif
              39                     ! GFDLMP
              40     1                       if ( nmmiph .eq. 11 ) then
              41     1               #if defined (GFDLMP_v2)
              42     1                         call gfdl_cld_mp_init()
              43     1               #else
              44     1                         call gfdl_cloud_microphys_init()
              45     1               #endif
              46     1                         if ( myrank .eq. 0 )                                         &
              47     1                            print *, 'GFDL cloud microphysics initialized'
              48     1                       endif
              49                     
              50                           return
              51                     !--------------------------
              52                           end subroutine mp_init


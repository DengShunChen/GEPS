#%Module####################################################
##                                   dschen@cwb.gov.tw
##                                   Fujitsu
## TCoGFS
##_____________________________________________________
proc ModulesHelp { } {
puts stderr "Set environment veriables for TCoGFS"
puts stderr "This module initializes the environment "
}
module-whatis " TCoGFS whatis description"

set ver v1.0.0
set machine fx10

set LANG_HOME /opt/FJSVfxlang/1.2.1
setenv COMP $LANG_HOME/bin/frtpx
setenv COMP_MP $LANG_HOME/bin/mpifrtpx
setenv COMP_MPI $LANG_HOME/bin/mpifrtpx

setenv C_COMP $LANG_HOME/bin/fccpx
setenv C_COMP_MP $LANG_HOME/bin/mpifccpx

setenv FFLAGS_COM "-c -X9 -Free -CcdRR8 -Cpp -Kfast,ocl,autoobjstack -x- -fw"
#setenv FFLAGS_COM "-c -X9 -Free -CcdRR8 -Cpp -x- -fw"

setenv DEFINE_FLAGS "-DTIMING -DUSE_FFTW -DW3TAG "
#setenv DEFINE_FLAGS "-DTIMING -DUSE_FFTW -DW3TAG -DVERBOSE"

setenv MSG_COM "-Ec -Qa,d,i,p,t,x -Koptmsg=2"
setenv LIBS_COM "-SSL2BLAMP"
setenv OMP_COM "-Kopenmp,parallel"
setenv CFLAGS_COM "-c -Xg"

#setenv FFLAGS_COM "-fp-model source"
#setenv LDFLAGS_COM "-mkl"

# Known conflicts

# Loading nceplibs modules
#module use  /nwpr/gfs/xb80/modulefiles/nceplibs/${machine}
#module load w3nco/v2.0.6
#module unuse  /nwpr/gfs/xb80/modulefiles/nceplibs/${machine}

#module use  /nwpr/gfs/xb80/modulefiles/${machine}
#module load netcdf/3.6.3
#module load fftw/3.3.7
#module load dms/v4
#module load operlib
#module unuse  /nwpr/gfs/xb80/modulefiles/${machine}

setenv W3NCO_INCd "/nwpr/gfs/xb80/lib/${machine}/include"
setenv W3NCO_LIBd "/nwpr/gfs/xb80/lib/${machine}/lib/libw3nco_v2.0.6_d.a"
setenv NETCDF_INC "/package/${machine}/netcdf-3.6.3/include"
setenv NETCDF_LIB "-L/package/${machine}/netcdf-3.6.3/lib -lnetcdf"
setenv FFTW_INC "/users/xa09/${machine}/fftw-3.3.7/include"
setenv FFTW_LIB "-L/users/xa09/${machine}/fftw-3.3.7/lib -lfftw3_threads -lfftw3"
setenv DMS_LIB "-L/package/${machine}/dms/lib -lrdms -lgdbm"
setenv OPERLIB_LIB "-L/package/${machine}/operlib/lib -lnwp"
####for write grb2 #add by hcwei
set G2_LIB     "-L/package/${machine}/g2lib-1.4.0/lib    -lg2     "
setenv G2_INC  "/package/${machine}/g2lib-1.4.0/include     "
set W3_LIB     "-L/package/${machine}/w3lib-2.0.2/lib    -lw3     "
set JASPER_LIB "-L/package/${machine}/jasper-1.900.1/lib -ljasper "
set PNG_LIB    "-L/package/${machine}/libpng-1.2.50/lib  -lpng    "
set Z_LIB      "-L/users/xa09/${machine}/zlib-1.2.8/lib  -lz      "
setenv GRB2_LIB "${G2_LIB} ${W3_LIB} ${JASPER_LIB} ${PNG_LIB} ${Z_LIB}"
#this library test the used compile flags -O3
#set G2_LIB     "-L/nwpr/gfs/xb119/data/fx10/g2lib-3.1.0/lib -lg2     "
#setenv G2_INC  "/nwpr/gfs/xb119/data/fx10/g2lib-3.1.0/include     "


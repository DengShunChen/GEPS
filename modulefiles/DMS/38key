# machine : Fujitsu machine fx100 or fx10
# lname   : libery name
# ver     : libery version
set machine x86_64
set lname dms38key

set bname  [string toupper $lname] 

prepend-path  PATH            "/users/xa09/${machine}/${lname}/bin"

setenv        ${bname}_LIB    "-L/users/xa09/${machine}/${lname}/lib -lrdms -lgdbm"
setenv        ${bname}        "/users/xa09/${machine}/${lname}"
prepend-path  LD_LIBRARY_PATH "/users/xa09/${machine}/${lname}/lib"

# Help
proc ModulesHelp { } {
  puts "Set environment variables for library ..."
}

module-whatis "${bname} Lib for Fujitsu $machine is not available"


puts stderr "$lname loaded/unloaded"

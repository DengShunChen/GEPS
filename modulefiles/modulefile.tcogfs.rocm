#%Module####################################################
## TCoGFS thin module for GEPS_COMPILER=rocm (AMD GPU)
## Expects GEPS_LIB geps/1.0 (or equivalent) already loaded.
##__________________________________________________________

module-whatis "TCoGFS build env aliases for AMD ROCm / HIP (via GEPS_LIB)"

setenv GEPS_COMPILER rocm

if {[info exists ::env(ROCM_PATH)] && $::env(ROCM_PATH) ne ""} {
  set rocm_root $::env(ROCM_PATH)
} else {
  set rocm_root /opt/rocm
}
prepend-path PATH $rocm_root/bin
prepend-path LD_LIBRARY_PATH $rocm_root/lib
prepend-path LIBRARY_PATH $rocm_root/lib
setenv ROCM_PATH $rocm_root
setenv HIP_PATH $rocm_root
if {![info exists ::env(AMD_GPU_ARCHS)] || $::env(AMD_GPU_ARCHS) eq ""} {
  setenv AMD_GPU_ARCHS gfx942
}

if {[info exists ::env(MPIFC)] && $::env(MPIFC) ne ""} {
  setenv COMP_MP $::env(MPIFC)
} else {
  setenv COMP_MP mpifort
}
if {[info exists ::env(MPICC)] && $::env(MPICC) ne ""} {
  setenv C_COMP_MP $::env(MPICC)
} else {
  setenv C_COMP_MP mpicc
}
if {[info exists ::env(MPICXX)] && $::env(MPICXX) ne ""} {
  setenv CXX_COMP_MP $::env(MPICXX)
} else {
  setenv CXX_COMP_MP mpicxx
}

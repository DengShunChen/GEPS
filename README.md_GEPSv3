# GFS TCO #

build.sh        
	*module load modulefile.tcogfs.${MACHINE}_AMIP  ->AMIP
	*module load modulefile.tcogfs.${MACHINE}_4cpl  ->4CPL

src/Makefile             
	*TIMCOMCPL = FALSE ->AMIP
	*TIMCOMCPL = TRUE  ->4CPL
	
### Build ###

./build.sh fx1000       , get AMIP exe or 4CPL lib

### Run ###
AMIP:
cd job
pjsub submit_job_fx1000.sh

